{
  "name": "shouhu-app",
  "version": "1.0.0",
  "private": true,
  "description": "守护 单页应用 + Capacitor Android 壳（GitHub Actions 自动打包 APK）",
  "scripts": {
    "www": "node scripts/prepare-www.mjs",
    "sync": "npm run www && cap sync android",
    "apk": "npm run www && cap copy android && cd android && gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.10",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.10",
    "@capacitor/device": "^7.0.5",
    "@capacitor/geolocation": "^7.1.8",
    "@capacitor/keyboard": "^7.0.6",
    "@capacitor/local-notifications": "^7.0.7",
    "@capacitor/preferences": "^7.0.4",
    "@capacitor-community/sqlite": "^7.0.3",
    "@capawesome/capacitor-file-picker": "^7.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.10",
    "html2canvas": "^1.4.1",
    "localforage": "^1.10.0",
    "mammoth": "^1.6.0",
    "marked": "^4.3.0",
    "mathjax": "^3.2.2",
    "papaparse": "^5.4.1"
  }
}
