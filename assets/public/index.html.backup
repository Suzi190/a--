            const weightHistory = await localforage.getItem('weight_history') || [];
            
            // 获取断食统计数据（空数据）
            const fastingStats = await localforage.getItem('fasting_stats') || {
                totalCount: 0,
                longestDuration: 0,
                consecutiveDays: 0,
                history: []
            };
            
            // 获取围度历史记录（空数组）
            const measurementsHistory = await localforage.getItem('measurements_history') || [];

            // 计算数据
            const hasData = bodyData.currentWeight && bodyData.initialWeight;
            const totalLoss = hasData ? (bodyData.initialWeight - bodyData.currentWeight).toFixed(1) : '--';
            const bmi = hasData ? calculateBMI(bodyData.currentWeight, bodyData.height || 170) : '--';
            const bodyFat = hasData ? calculateBodyFat(bmi, bodyData.age || 25, bodyData.gender || 'female') : '--';
            const bmr = hasData ? calculateBMR(bodyData.currentWeight, bodyData.height || 170, bodyData.age || 25, bodyData.gender || 'female') : '--';

            const page = document.createElement('div');
            page.id = 'dataPage';
            page.className = 'data-page';
            page.innerHTML = `
                <div class="data-page-header">
                    <h2>📊 身体数据</h2>
                    <button class="data-page-close" onclick="closeDataPage()">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M18 6L6 18M6 6l12 12"/>
                        </svg>
                    </button>
                </div>
                
                <div class="data-page-content">
                    <!-- 累计减重卡片 -->
                    <div class="weight-summary-card">
                        <div class="total-loss">
                            <span class="loss-number">${hasData && totalLoss > 0 ? '-' : ''}${totalLoss}</span>
                            <span class="loss-unit">${hasData ? 'kg' : ''}</span>
                        </div>
                        <div class="loss-label">累计减重</div>
                        <div class="weight-details">
                            <div class="weight-item" onclick="editBodyData('initialWeight', ${bodyData.initialWeight || 0})">
                                <span class="weight-label">初始</span>
                                <span class="weight-value" id="initialWeightDisplay">${bodyData.initialWeight || '--'}${bodyData.initialWeight ? 'kg' : ''}</span>
                            </div>
                            <div class="weight-arrow">→</div>
                            <div class="weight-item" onclick="editBodyData('currentWeight', ${bodyData.currentWeight || 0})">
                                <span class="weight-label">当前</span>
                                <span class="weight-value current" id="currentWeightDisplay">${bodyData.currentWeight || '--'}${bodyData.currentWeight ? 'kg' : ''}</span>
                            </div>
                            <div class="weight-arrow">→</div>
                            <div class="weight-item" onclick="editBodyData('targetWeight', ${bodyData.targetWeight || 0})">
                                <span class="weight-label">目标</span>
                                <span class="weight-value target" id="targetWeightDisplay">${bodyData.targetWeight || '--'}${bodyData.targetWeight ? 'kg' : ''}</span>
                            </div>
                            <div class="weight-arrow">|</div>
                            <div class="weight-item" onclick="editBodyData('height', ${bodyData.height || 170})">
                                <span class="weight-label">身高</span>
                                <span class="weight-value" id="heightDisplay">${bodyData.height || '--'}${bodyData.height ? 'cm' : ''}</span>
                            </div>
                        </div>
                    </div>

                    <!-- 身体指标卡片 -->
                    <div class="body-metrics-card">
                        <div class="metric-item">
                            <div class="metric-icon">📊</div>
                            <div class="metric-value">${bmi}</div>
                            <div class="metric-label">BMI</div>
                            <div class="metric-status">${hasData ? getBMIStatus(bmi) : '--'}</div>
                        </div>
                        <div class="metric-item">
                            <div class="metric-icon">🔥</div>
                            <div class="metric-value">${bodyFat}${hasData ? '%' : ''}</div>
                            <div class="metric-label">体脂率</div>
                            <div class="metric-status">预估</div>
                        </div>
                        <div class="metric-item">
                            <div class="metric-icon">⚡</div>
                            <div class="metric-value">${bmr}</div>
                            <div class="metric-label">基础代谢</div>
                            <div class="metric-status">kcal/天</div>
                        </div>
                    </div>

                    <!-- 体重统计图表 -->
                    <div class="chart-section">
                        <div class="chart-header">
                            <h3>📈 体重趋势</h3>
                            <span class="chart-subtitle">${weightHistory.length} 条记录</span>
                        </div>
                        <div class="chart-container">
                            <canvas id="weightChart"></canvas>
                        </div>
                    </div>

                    <!-- 断食统计 -->
                    <div class="chart-section">
                        <div class="chart-header">
                            <h3>⏰ 断食统计</h3>
                            <span class="chart-subtitle">累计 ${fastingStats.totalCount} 次</span>
                        </div>
                        <div class="fasting-stats-grid">
                            <div class="fasting-stat-item">
                                <span class="stat-value">${fastingStats.totalCount}</span>
                                <span class="stat-label">累计断食(次)</span>
                            </div>
                            <div class="fasting-stat-item">
                                <span class="stat-value">${fastingStats.longestDuration}h</span>
                                <span class="stat-label">最长断食</span>
                            </div>
                            <div class="fasting-stat-item">
                                <span class="stat-value">${fastingStats.consecutiveDays}天</span>
                                <span class="stat-label">连续断食</span>
