    <!-- 隐藏的文件输入框 -->
    <input type="file" id="avatarFileInput" accept="image/*" style="display: none;" onchange="handleAvatarSelect(event)">
    <input type="file" id="backgroundFileInput" accept="image/*" style="display: none;" onchange="handleBackgroundSelect(event)">
    <input type="file" id="wallBackgroundFileInput" accept="image/*" style="display: none;" onchange="handleWallBackgroundSelect(event)">

    <!-- 后台定位脚本 -->
    <script>
        // 后台定位全局变量
        let backgroundLocationWatcher = null;
        let isBackgroundLocationRunning = false;
        const LOCATION_STORAGE_KEY = 'footprint_locations';

        // 初始化后台定位
        async function initBackgroundLocation() {
            console.log('=== 开始初始化后台定位 ===');
            console.log('window.Capacitor:', typeof window.Capacitor);
            console.log('window.Capacitor?.isNativePlatform():', window.Capacitor?.isNativePlatform?.());
            
            // 检查是否在 Capacitor 环境中
            if (!window.Capacitor || !window.Capacitor.isNativePlatform()) {
                console.log('不在原生环境中，使用浏览器定位');
                initBrowserLocation();
                return;
            }

            console.log('在原生环境中，尝试访问插件...');
            console.log('window.Capacitor.Plugins:', typeof window.Capacitor.Plugins);
            console.log('可用插件:', window.Capacitor.Plugins ? Object.keys(window.Capacitor.Plugins) : '无');

            try {
                // 方法1: 尝试从 Capacitor.Plugins 直接获取插件
                let Geolocation = window.Capacitor.Plugins?.Geolocation;
                let BackgroundGeolocation = window.Capacitor.Plugins?.BackgroundGeolocation;
                
                console.log('从 Plugins 获取 Geolocation:', typeof Geolocation);
                console.log('从 Plugins 获取 BackgroundGeolocation:', typeof BackgroundGeolocation);
                
                // 方法2: 如果方法1失败，尝试动态导入
                if (!Geolocation) {
                    console.log('尝试动态导入 Geolocation...');
                    try {
                        const module = await import('@capacitor/geolocation');
                        Geolocation = module.Geolocation;
                        console.log('动态导入 Geolocation 成功:', typeof Geolocation);
                    } catch (e) {
                        console.error('动态导入 Geolocation 失败:', e);
                    }
                }
                
                if (!BackgroundGeolocation) {
                    console.log('尝试动态导入 BackgroundGeolocation...');
                    try {
                        const module = await import('@capacitor-community/background-geolocation');
                        BackgroundGeolocation = module.BackgroundGeolocation;
                        console.log('动态导入 BackgroundGeolocation 成功:', typeof BackgroundGeolocation);
                    } catch (e) {
                        console.error('动态导入 BackgroundGeolocation 失败:', e);
                    }
                }
                
                // 如果两个插件都不可用，尝试使用 AndroidShell
                if (!Geolocation && !BackgroundGeolocation) {
                    console.error('❌ 所有 Capacitor 插件都不可用');
                    console.log('尝试使用 AndroidShell...');
                    
                    if (window.AndroidShell && window.AndroidShell.getCurrentLocation) {
                        console.log('✅ AndroidShell 可用，使用原生定位');
                        window.AndroidShell.getCurrentLocation();
                        isBackgroundLocationRunning = true;
                        updateFootprintLocationDisplay();
                        
                        // AndroidShell 位置获取的临时存储（用于距离判断）
                        let androidShellLastLocation = null;
                        let androidShellLastTime = 0;
                        
                        // 设置定时器定期获取位置（延长至5分钟，并添加距离判断）
                        setInterval(() => {
                            if (window.AndroidShell && window.AndroidShell.getCurrentLocation) {
                                const now = Date.now();
                                
                                // 检查时间间隔（至少5分钟）
                                if (now - androidShellLastTime < 300000) { // 5分钟 = 300000毫秒
                                    console.log('⏭️ AndroidShell: 时间间隔太短，跳过本次获取');
                                    return;
                                }
                                
                                // 如果有上次位置，先检查距离
                                if (androidShellLastLocation) {
                                    // 注意：这里无法预先知道新位置，所以先获取再判断
                                    // 实际判断会在 handleLocationUpdate 中进行
                                    console.log('🔄 AndroidShell: 触发位置获取...');
                                    window.AndroidShell.getCurrentLocation();
                                } else {
                                    // 第一次获取
                                    console.log('🔄 AndroidShell: 首次触发位置获取...');
                                    window.AndroidShell.getCurrentLocation();
                                }
                                
                                androidShellLastTime = now;
                            }
                        }, 300000); // 每5分钟检查一次（而不是30秒）
                        return;
                    }
                    
                    console.log('降级到浏览器定位');
                    initBrowserLocation();
                    return;
                }
                
                // 使用 Geolocation 插件检查权限
                let permission = { location: 'granted' };
                if (Geolocation) {
                    console.log('使用 Geolocation 检查权限...');
                    try {
                        const permStatus = await Geolocation.checkPermissions();
                        console.log('权限状态:', JSON.stringify(permStatus));
                        
                        if (permStatus.location !== 'granted') {
                            console.log('权限未授予，请求权限...');
                            const requestResult = await Geolocation.requestPermissions();
                            console.log('权限请求结果:', JSON.stringify(requestResult));
                            permission = { location: requestResult.location };
                        }
                    } catch (permError) {
                        console.error('检查权限失败:', permError);
                    }
                }
                
                console.log('最终权限状态:', JSON.stringify(permission));
                
                if (permission.location !== 'granted') {
                    console.warn('❌ 定位权限未授予:', permission.location);
                    showLocationPermissionPrompt('权限检查-未授权');
                    return;
                }

                // 启动后台定位
                if (BackgroundGeolocation) {
                    await startBackgroundLocation(BackgroundGeolocation);
                } else if (Geolocation) {
                    // 如果没有后台定位插件，使用普通定位
                    console.log('使用普通 Geolocation 定位');
                    await startNormalLocation(Geolocation);
                }
                
            } catch (error) {
                console.error('❌ 初始化后台定位失败:', error);
                console.error('错误详情:', error.message, error.stack);
                // 降级到浏览器定位
                initBrowserLocation();
            }
        }
        
        // 使用普通 Geolocation 插件定位
        async function startNormalLocation(Geolocation) {
            console.log('=== 启动普通定位服务 ===');
            
            try {
                // 获取当前位置
                const position = await Geolocation.getCurrentPosition({
                    enableHighAccuracy: true,
                    timeout: 10000
                });
                console.log('✅ 获取位置成功:', JSON.stringify(position));
                handleLocationUpdate({
                    latitude: position.coords.latitude,
                    longitude: position.coords.longitude,
                    accuracy: position.coords.accuracy,
                    altitude: position.coords.altitude,
                    bearing: position.coords.heading,
                    speed: position.coords.speed,
                    time: Date.now()
                });
                
                isBackgroundLocationRunning = true;
                updateFootprintLocationDisplay();
                
                // 设置定时器定期获取位置
                setInterval(async () => {
                    try {
                        const pos = await Geolocation.getCurrentPosition({
                            enableHighAccuracy: true,
                            timeout: 10000
                        });
                        handleLocationUpdate({
                            latitude: pos.coords.latitude,
                            longitude: pos.coords.longitude,
                            accuracy: pos.coords.accuracy,
                            altitude: pos.coords.altitude,
                            bearing: pos.coords.heading,
                            speed: pos.coords.speed,
                            time: Date.now()
                        });
                    } catch (e) {
                        console.error('定时获取位置失败:', e);
                    }
                }, 30000); // 每30秒获取一次
                
            } catch (error) {
                console.error('启动普通定位失败:', error);
                initBrowserLocation();
            }
        }

        // 请求后台定位权限（Android 10+）
        async function requestBackgroundLocationPermission() {
            return new Promise((resolve) => {
                if (confirm('为了记录足迹，需要允许应用在后台获取位置信息。是否前往设置开启？')) {
                    // 尝试打开应用设置
                    if (window.Capacitor.Plugins && window.Capacitor.Plugins.App) {
                        window.Capacitor.Plugins.App.openUrl({ url: 'app-settings:' });
                    }
                    resolve(false);
                } else {
                    resolve(false);
                }
            });
        }

        // 启动后台定位
        async function startBackgroundLocation(BackgroundGeolocation) {
            try {
                console.log('=== 启动后台定位服务 ===');
                console.log('BackgroundGeolocation 对象:', typeof BackgroundGeolocation);
                console.log('addWatcher 方法:', typeof BackgroundGeolocation?.addWatcher);
                
                // 添加位置监听器
                const watcherOptions = {
                    backgroundMessage: "守护正在后台记录位置",
                    backgroundTitle: "足迹记录中",
                    requestPermissions: false, // 我们已经手动请求了权限
                    stale: false,
                    distanceFilter: 50 // 每移动50米更新一次
                };
                console.log('添加位置监听器，选项:', JSON.stringify(watcherOptions));
                
                backgroundLocationWatcher = await BackgroundGeolocation.addWatcher(watcherOptions, (location, error) => {
                    console.log('📍 addWatcher 回调被调用');
                    console.log('location:', location);
                    console.log('error:', error);
                    
                    if (error) {
                        console.error('❌ 定位错误:', error);
                        console.error('错误代码:', error.code);
                        console.error('错误消息:', error.message);
                        if (error.code === "NOT_AUTHORIZED") {
                            showLocationPermissionPrompt('后台定位插件-NOT_AUTHORIZED');
                        }
                        return;
                    }

                    // 处理位置更新
                    console.log('📍 收到位置更新:', JSON.stringify(location));
                    handleLocationUpdate(location);
                });

                isBackgroundLocationRunning = true;
                console.log('✅ 后台定位服务已启动，监听器ID:', backgroundLocationWatcher);
                
                // 更新足迹页面显示
                updateFootprintLocationDisplay();
                
                // 立即获取一次当前位置
                console.log('尝试立即获取当前位置...');
                try {
                    const { Geolocation } = await import('@capacitor/geolocation');
                    const position = await Geolocation.getCurrentPosition({
                        enableHighAccuracy: true,
                        timeout: 10000
                    });
                    console.log('✅ 立即获取位置成功:', JSON.stringify(position));
                    handleLocationUpdate({
                        latitude: position.coords.latitude,
                        longitude: position.coords.longitude,
                        accuracy: position.coords.accuracy,
                        altitude: position.coords.altitude,
                        bearing: position.coords.heading,
                        speed: position.coords.speed,
                        time: Date.now()
                    });
                } catch (immediateError) {
                    console.warn('使用 Capacitor Geolocation 获取位置失败:', immediateError);
                    // 降级到浏览器 API
                    try {
                        if (navigator.geolocation) {
                            navigator.geolocation.getCurrentPosition(
                                (position) => {
                                    console.log('✅ 浏览器 API 获取位置成功:', JSON.stringify(position));
                                    handleLocationUpdate({
                                        latitude: position.coords.latitude,
                                        longitude: position.coords.longitude,
                                        accuracy: position.coords.accuracy,
                                        altitude: position.coords.altitude,
                                        bearing: position.coords.heading,
                                        speed: position.coords.speed,
                                        time: Date.now()
                                    });
                                },
                                (error) => {
                                    console.warn('浏览器 API 获取位置失败:', error.message);
                                },
                                {
                                    enableHighAccuracy: true,
                                    timeout: 10000,
                                    maximumAge: 0
                                }
                            );
                        }
                    } catch (browserError) {
                        console.warn('浏览器 API 也失败了:', browserError);
                    }
                }
                
            } catch (error) {
                console.error('启动后台定位失败:', error);
                console.error('错误详情:', error.message);
                if (error.stack) console.error('错误堆栈:', error.stack);
                throw error;
            }
        }

        // 停止后台定位
        async function stopBackgroundLocation() {
            if (!backgroundLocationWatcher || !window.Capacitor) return;
            
            try {
                const { BackgroundGeolocation } = await import('@capacitor-community/background-geolocation');
                await BackgroundGeolocation.removeWatcher({
                    id: backgroundLocationWatcher
                });
                
                isBackgroundLocationRunning = false;
                backgroundLocationWatcher = null;
                console.log('✅ 后台定位服务已停止');
                
            } catch (error) {
                console.error('停止后台定位失败:', error);
            }
        }

        // 上次保存的位置和时间戳
        let lastSavedLocation = null;
        let lastSaveTime = 0;
        
        // 配置参数
        const LOCATION_CONFIG = {
            minDistance: 70, // 最小距离（米），移动超过这个距离才保存
            minTimeInterval: 300000, // 最小时间间隔（毫秒），30秒
            maxAccuracy: 100 // 最大精度（米），精度太差的位置不保存
        };
        
        // 计算两个坐标点之间的距离（米）- 使用 Haversine 公式
        function calculateDistance(lat1, lon1, lat2, lon2) {
            const R = 6371000; // 地球半径（米）
            const dLat = (lat2 - lat1) * Math.PI / 180;
            const dLon = (lon2 - lon1) * Math.PI / 180;
            const a = Math.sin(dLat / 2) * Math.sin(dLat / 2) +
                      Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
                      Math.sin(dLon / 2) * Math.sin(dLon / 2);
            const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
            return R * c;
        }

        // 处理位置更新
        function handleLocationUpdate(location) {
            console.log('📍 收到位置更新:', location);
            
            const locationData = {
                latitude: location.latitude,
                longitude: location.longitude,
                accuracy: location.accuracy || 0,
                altitude: location.altitude || 0,
                bearing: location.bearing || 0,
                speed: location.speed || 0,
                timestamp: Date.now(),
                timeString: new Date().toLocaleString('zh-CN')
            };
            
            // 检查精度，精度太差的位置不保存
            if (locationData.accuracy > LOCATION_CONFIG.maxAccuracy) {
                console.log(`⏭️ 位置精度太差 (${locationData.accuracy}m > ${LOCATION_CONFIG.maxAccuracy}m)，跳过保存`);
                return;
            }
            
            const now = Date.now();
            
            // 如果是第一次保存，直接保存
            if (!lastSavedLocation) {
                console.log('📝 首次保存位置');
                saveLocation(locationData);
                lastSavedLocation = locationData;
                lastSaveTime = now;
                updateFootprintLocationDisplay(locationData);
                return;
            }
            
            // 检查时间间隔
            const timeDiff = now - lastSaveTime;
            if (timeDiff < LOCATION_CONFIG.minTimeInterval) {
                console.log(`⏭️ 时间间隔太短 (${Math.round(timeDiff / 1000)}s < ${LOCATION_CONFIG.minTimeInterval / 1000}s)，跳过保存`);
                return;
            }
            
            // 计算与上次保存位置的距离
            const distance = calculateDistance(
                lastSavedLocation.latitude,
                lastSavedLocation.longitude,
                locationData.latitude,
                locationData.longitude
            );
            
            // 检查距离，移动距离太短不保存
            if (distance < LOCATION_CONFIG.minDistance) {
                console.log(`⏭️ 移动距离太短 (${Math.round(distance)}m < ${LOCATION_CONFIG.minDistance}m)，跳过保存`);
                return;
            }
            
            // 满足条件，保存位置
            console.log(`✅ 满足保存条件: 距离 ${Math.round(distance)}m, 间隔 ${Math.round(timeDiff / 1000)}s`);
            saveLocation(locationData);
            lastSavedLocation = locationData;
            lastSaveTime = now;
            updateFootprintLocationDisplay(locationData);
            
            // 可以在这里添加发送到服务器的逻辑
            // sendLocationToServer(locationData);
        }

        // 保存位置到 IndexedDB
        async function saveLocation(locationData) {
            try {
                // 获取已保存的位置列表
                let locations = await localforage.getItem(LOCATION_STORAGE_KEY) || [];
                
                // 添加新位置
                locations.push(locationData);
                
                // 限制存储数量，最多保留1000条记录
                if (locations.length > 1000) {
                    locations = locations.slice(-1000);
                }
                
                // 保存回 IndexedDB
                await localforage.setItem(LOCATION_STORAGE_KEY, locations);
                console.log('✅ 位置已保存，当前共有', locations.length, '条记录');
                
            } catch (error) {
                console.error('保存位置失败:', error);
            }
        }

        // 获取所有保存的位置
        async function getAllLocations() {
            try {
                const locations = await localforage.getItem(LOCATION_STORAGE_KEY) || [];
                return locations;
            } catch (error) {
                console.error('获取位置记录失败:', error);
                return [];
            }
        }

        // 清除所有位置记录
        async function clearAllLocations() {
            try {
                await localforage.removeItem(LOCATION_STORAGE_KEY);
                console.log('✅ 所有位置记录已清除');
            } catch (error) {
                console.error('清除位置记录失败:', error);
            }
        }

        // 更新足迹页面位置显示
        function updateFootprintLocationDisplay(locationData) {
            const locationText = document.getElementById('footprintLocationText');
            if (!locationText) return;
            
            if (locationData) {
                locationText.textContent = `${locationData.latitude.toFixed(6)}, ${locationData.longitude.toFixed(6)}`;
            } else if (isBackgroundLocationRunning) {
                locationText.textContent = '定位服务运行中...';
            } else {
                locationText.textContent = '定位服务未启动';
            }
        }

        // 显示权限提示
        function showLocationPermissionPrompt(errorSource = '未知') {
            console.warn(`需要定位权限才能记录足迹 (来源: ${errorSource})`);
            const locationText = document.getElementById('footprintLocationText');
            if (locationText) {
                locationText.textContent = '需要定位权限 - 请在系统设置中开启';
            }
            
            // 显示更详细的提示
            alert(`无法获取位置信息 (错误来源: ${errorSource})。请检查:\n\n1. 是否已允许定位权限\n2. 手机GPS是否已开启\n3. 是否允许后台定位（部分手机需要单独设置）\n\n如果权限已开启但仍无法使用，请尝试重启应用。`);
        }

        // 浏览器定位降级方案
        function initBrowserLocation() {
            console.log('=== 使用浏览器定位 ===');
            
            if (!navigator.geolocation) {
                console.error('浏览器不支持定位');
                return;
            }

            // 获取当前位置
            navigator.geolocation.getCurrentPosition(
                (position) => {
                    const locationData = {
                        latitude: position.coords.latitude,
                        longitude: position.coords.longitude,
                        accuracy: position.coords.accuracy,
                        altitude: position.coords.altitude || 0,
                        bearing: position.coords.heading || 0,
                        speed: position.coords.speed || 0,
                        timestamp: Date.now(),
                        timeString: new Date().toLocaleString('zh-CN')
                    };
                    
                    handleLocationUpdate(locationData);
                },
                (error) => {
                    console.error('浏览器定位失败:', error);
                    showLocationPermissionPrompt('浏览器定位失败');
                },
                {
                    enableHighAccuracy: true,
                    timeout: 10000,
                    maximumAge: 0
                }
            );

            // 持续监听位置变化
            navigator.geolocation.watchPosition(
                (position) => {
                    const locationData = {
                        latitude: position.coords.latitude,
                        longitude: position.coords.longitude,
                        accuracy: position.coords.accuracy,
                        altitude: position.coords.altitude || 0,
                        bearing: position.coords.heading || 0,
                        speed: position.coords.speed || 0,
                        timestamp: Date.now(),
                        timeString: new Date().toLocaleString('zh-CN')
                    };
                    
                    handleLocationUpdate(locationData);
                },
                (error) => {
                    console.error('浏览器定位监听失败:', error);
                },
                {
                    enableHighAccuracy: true,
                    timeout: 10000,
                    maximumAge: 0
                }
            );
            
            isBackgroundLocationRunning = true;
            updateFootprintLocationDisplay();
        }

        // 获取当前位置（用于足迹页面显示）
        async function getCurrentLocation() {
            // 获取最新的位置记录
            const locations = await getAllLocations();
            if (locations.length > 0) {
                return locations[locations.length - 1];
            }
            return null;
        }

        // 导出足迹数据为JSON
        async function exportFootprintData() {
            const locations = await getAllLocations();
            const data = {
                exportTime: new Date().toLocaleString('zh-CN'),
                totalRecords: locations.length,
                locations: locations
            };
            
            const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `footprint_data_${Date.now()}.json`;
            a.click();
            URL.revokeObjectURL(url);
            
            console.log('✅ 足迹数据已导出');
        }

        // 简单的定位测试函数（可以在控制台调用）
        window.testLocation = async function() {
            console.log('=== 手动测试定位 ===');
            console.log('window.Capacitor:', typeof window.Capacitor);
            console.log('isNativePlatform:', window.Capacitor?.isNativePlatform?.());
            console.log('window.Capacitor.Plugins:', typeof window.Capacitor?.Plugins);
            console.log('可用插件:', window.Capacitor?.Plugins ? Object.keys(window.Capacitor.Plugins) : '无');
            
            // 测试1: 从 Capacitor.Plugins 获取
            console.log('\n--- 测试1: 从 Capacitor.Plugins 获取 ---');
            const GeolocationPlugin = window.Capacitor?.Plugins?.Geolocation;
            console.log('Geolocation from Plugins:', typeof GeolocationPlugin);
            if (GeolocationPlugin) {
                try {
                    const permStatus = await GeolocationPlugin.checkPermissions();
                    console.log('权限状态:', JSON.stringify(permStatus));
                    const position = await GeolocationPlugin.getCurrentPosition({
                        enableHighAccuracy: true,
                        timeout: 10000
                    });
                    console.log('✅ 位置获取成功:', JSON.stringify(position));
                } catch (e) {
                    console.error('❌ 使用 Plugins.Geolocation 失败:', e);
                }
            }
            
            // 测试2: 使用动态导入
            console.log('\n--- 测试2: 动态导入 Capacitor Geolocation ---');
            try {
                const module = await import('@capacitor/geolocation');
                console.log('模块:', module);
                const Geolocation = module.Geolocation;
                console.log('Geolocation:', typeof Geolocation);
                
                if (Geolocation) {
                    const permStatus = await Geolocation.checkPermissions();
                    console.log('权限状态:', JSON.stringify(permStatus));
                    
                    if (permStatus.location !== 'granted') {
                        console.log('请求权限...');
                        const requestResult = await Geolocation.requestPermissions();
                        console.log('请求结果:', JSON.stringify(requestResult));
                    }
                    
                    console.log('获取当前位置...');
                    const position = await Geolocation.getCurrentPosition({
                        enableHighAccuracy: true,
                        timeout: 10000
                    });
                    console.log('✅ 位置获取成功:', JSON.stringify(position));
                }
            } catch (error) {
                console.error('❌ 测试2失败:', error);
            }
            
            // 测试3: 使用浏览器 API
            console.log('\n--- 测试3: 浏览器 Geolocation API ---');
            if (navigator.geolocation) {
                navigator.geolocation.getCurrentPosition(
                    (position) => {
                        console.log('✅ 浏览器API位置获取成功:', {
                            lat: position.coords.latitude,
                            lng: position.coords.longitude,
                            accuracy: position.coords.accuracy
                        });
                    },
                    (error) => {
                        console.error('❌ 浏览器API失败:', error.message, '代码:', error.code);
                    },
                    { enableHighAccuracy: true, timeout: 10000 }
                );
            } else {
                console.error('❌ 浏览器不支持 Geolocation');
            }
            
            // 测试4: 后台定位插件从 Plugins 获取
            console.log('\n--- 测试4: 后台定位插件从 Plugins 获取 ---');
            const BgGeoPlugin = window.Capacitor?.Plugins?.BackgroundGeolocation;
            console.log('BackgroundGeolocation from Plugins:', typeof BgGeoPlugin);
            if (BgGeoPlugin) {
                console.log('✅ 后台定位插件已注册');
                console.log('addWatcher 方法:', typeof BgGeoPlugin.addWatcher);
            }
            
            // 测试5: 后台定位插件动态导入
            console.log('\n--- 测试5: 后台定位插件动态导入 ---');
            try {
                const module = await import('@capacitor-community/background-geolocation');
                console.log('模块:', module);
                const BackgroundGeolocation = module.BackgroundGeolocation;
                console.log('✅ 后台定位插件加载成功');
                console.log('BackgroundGeolocation:', typeof BackgroundGeolocation);
                console.log('addWatcher 方法:', typeof BackgroundGeolocation?.addWatcher);
            } catch (error) {
                console.error('❌ 后台定位插件加载失败:', error);
            }
            
            // 测试6: AndroidShell
            console.log('\n--- 测试6: AndroidShell ---');
            console.log('window.AndroidShell:', typeof window.AndroidShell);
            console.log('window.AndroidShell?.getCurrentLocation:', typeof window.AndroidShell?.getCurrentLocation);
            if (window.AndroidShell && window.AndroidShell.getCurrentLocation) {
                console.log('✅ AndroidShell 可用，尝试获取位置...');
                window.AndroidShell.getCurrentLocation();
            } else {
                console.log('❌ AndroidShell 不可用');
            }
        };
        
        console.log('后台定位脚本已加载');
        console.log('提示: 在控制台运行 testLocation() 可以测试定位功能');

        // ==================== 约会功能 ====================
        
        // 当前约会的聊天ID
        let currentDateChatId = null;
        
        // 默认约会文风（极简版）
        const DEFAULT_DATE_STYLE = `自然流畅的线下长对话，像真人一样聊天，会主动接话、共情、延伸话题，合理进行场景、动作、心理、神态描写。动作描写用*斜体*，话语用「」框起来。`;

        // 打开约会页面
        async function openDatePage() {
            console.log('【约会】打开约会页面，当前聊天ID:', currentChatId);
            
            if (!currentChatId) {
                showToast('请先选择一个聊天对象', 'error');
                return;
            }
            
            currentDateChatId = currentChatId;
            console.log('【约会】设置 currentDateChatId:', currentDateChatId);
            
            const chatItem = relationshipData.wechatChatList.find(item => item.id == currentChatId);
            const datePageTitle = document.getElementById('datePageTitle');
            if (datePageTitle && chatItem) {
                datePageTitle.textContent = `与${chatItem.remark || chatItem.name}的约会`;
            }
            
            // 显示约会页面
            const datePage = document.getElementById('datePage');
            datePage.classList.add('show');
            
            // 加载约会背景
            await updateDatePageBackground();
            
            // 加载约会消息
            await loadDateMessages();
            
            // 滚动到底部
            const dateChatContent = document.getElementById('dateChatContent');
            dateChatContent.scrollTop = dateChatContent.scrollHeight;
        }
        
        // 关闭约会页面
        async function closeDatePage() {
            // 【关键】记录约会结束时间
            if (currentDateChatId) {
                await DateSessionManager.endSession(currentDateChatId);
                console.log('【约会】记录会话结束时间:', currentDateChatId);
            }
            
            const datePage = document.getElementById('datePage');
            datePage.classList.remove('show');
            currentDateChatId = null;
        }
        
        // 加载约会消息
        async function loadDateMessages() {
            const dateChatContent = document.getElementById('dateChatContent');
            dateChatContent.innerHTML = '';
            
            if (!currentDateChatId) return;
            
            // 从 IndexedDB 加载约会消息
            const dateMessages = await DateMessageManager.getMessagesByChatId(currentDateChatId);
            
            // 【关键】获取上次会话结束时间
            const lastSessionEnd = await DateSessionManager.getLastSessionEnd(currentDateChatId);
            console.log('【约会】上次会话结束时间:', lastSessionEnd ? new Date(lastSessionEnd).toLocaleString() : '无');
            console.log('【约会】消息总数:', dateMessages.length);
            
            // 使用 for...of 循环以支持异步渲染
            for (const msg of dateMessages) {
                await renderDateMessage(msg);
            }
            
            // 【关键】在历史消息全部渲染完后，如果有上次会话记录，显示分割线
            if (dateMessages.length > 0 && lastSessionEnd) {
                // 检查是否有消息在上次会话之前（说明有历史记录）
                const hasOldMessages = dateMessages.some(msg => msg.timestamp <= lastSessionEnd);
                console.log('【约会】是否有旧消息:', hasOldMessages);
                if (hasOldMessages) {
                    console.log('【约会】显示上次约会结束分割线');
                    renderDateDivider(lastSessionEnd, '上次约会结束');
                }
            }
            
            // 【关键】记录本次会话开始时间
            await DateSessionManager.startSession(currentDateChatId);
        }
        
        // 渲染时间分割线
        function renderDateDivider(timestamp, label = null) {
            const dateChatContent = document.getElementById('dateChatContent');
            if (!dateChatContent) return;
            
            const dividerContainer = document.createElement('div');
            dividerContainer.style.cssText = `
                display: flex;
                align-items: center;
                justify-content: center;
                margin: 30px 0;
                position: relative;
            `;
            
            const line = document.createElement('div');
            line.style.cssText = `
                flex: 1;
                height: 1px;
                background: linear-gradient(to right, transparent, rgba(255,255,255,0.5), transparent);
                margin: 0 15px;
            `;
            
            const timeText = document.createElement('span');
            const date = new Date(timestamp);
            const dateStr = `${date.getFullYear()}年${date.getMonth() + 1}月${date.getDate()}日`;
            const timeStr = `${date.getHours().toString().padStart(2, '0')}:${date.getMinutes().toString().padStart(2, '0')}`;
            
            if (label) {
                timeText.textContent = `${label} ${dateStr} ${timeStr}`;
            } else {
                timeText.textContent = `${dateStr} ${timeStr}`;
            }
            
            timeText.style.cssText = `
                font-size: 12px;
                color: rgba(255,255,255,0.9);
                background: rgba(0,0,0,0.25);
                padding: 5px 14px;
                border-radius: 15px;
                white-space: nowrap;
                font-weight: 500;
            `;
            
            const line2 = document.createElement('div');
            line2.style.cssText = line.style.cssText;
            
            dividerContainer.appendChild(line);
            dividerContainer.appendChild(timeText);
            dividerContainer.appendChild(line2);
            
            dateChatContent.appendChild(dividerContainer);
            console.log('【约会】分割线已渲染:', label || '时间', new Date(timestamp).toLocaleString());
        }
        
        // 渲染约会消息（居中气泡样式，类似教学模式）
        async function renderDateMessage(message) {
            console.log('【约会】渲染消息:', message);
            const dateChatContent = document.getElementById('dateChatContent');
            if (!dateChatContent) {
                console.error('【约会】找不到聊天内容区域 dateChatContent');
                return;
            }
            
            const chatItem = relationshipData.wechatChatList.find(item => item.id == currentDateChatId);
            console.log('【约会】找到聊天对象:', chatItem?.name);
            
            // 【新增】获取自定义颜色
            const colors = await DateColorManager.getColors(currentDateChatId);
            
            const messageContainer = document.createElement('div');
            messageContainer.style.cssText = `
                display: flex;
                flex-direction: column;
                align-items: center;
                margin-bottom: 20px;
                animation: fadeInUp 0.3s ease;
            `;
            
            // 头像
            const avatar = document.createElement('img');
            if (message.sender === 'user') {
                // 用户头像
                const personalProfile = await localforage.getItem('personalProfile') || {};
                avatar.src = personalProfile.avatar || 'https://img.58sb.cn/file/img/placeholder.png';
            } else {
                // AI头像
                avatar.src = chatItem?.avatar || 'https://img.58sb.cn/file/img/placeholder.png';
            }
            avatar.style.cssText = `
                width: 50px;
                height: 50px;
                border-radius: 50%;
                object-fit: cover;
                margin-bottom: 8px;
                box-shadow: 0 2px 8px rgba(0,0,0,0.1);
                border: 2px solid white;
            `;
            
            // 气泡
            const bubble = document.createElement('div');
            if (message.sender === 'user') {
                // 【修改】用户气泡：使用自定义颜色
                const userBg = colors.userBubble + '80'; // 添加50%透明度
                bubble.style.cssText = `
                    background: ${userBg};
                    backdrop-filter: blur(10px);
                    padding: 14px 20px;
                    border-radius: 20px;
                    max-width: 75%;
                    word-break: break-word;
                    color: ${colors.userText};
                    font-size: 15px;
                    line-height: 1.6;
                    box-shadow: 0 2px 12px rgba(0,0,0,0.08);
                    text-align: center;
                `;
                bubble.textContent = message.content;
            } else {
                // 【修改】AI气泡：使用自定义颜色
                const aiBg = colors.aiBubble + '99'; // 添加60%透明度
                bubble.style.cssText = `
                    background: ${aiBg};
                    backdrop-filter: blur(10px);
                    padding: 14px 20px;
                    border-radius: 20px;
                    max-width: 75%;
                    word-break: break-word;
                    color: ${colors.aiText};
                    font-size: 15px;
                    line-height: 1.6;
                    box-shadow: 0 2px 12px rgba(0,0,0,0.08);
                    text-align: left;
                `;
                // AI消息：处理动作描写和对话
                let content = message.content;
                
                // 【修复】将对话内容（「」框起来的部分）前后都换行并加粗显示
                content = content.replace(/「(.*?)」/g, '<br><br><strong class="dialogue-text">「$1」</strong><br><br>');
                
                // 【修复】将 *动作* 转换为带样式的动作文本（灰色斜体）
                // 注意：要先处理对话，再处理动作，避免冲突
                content = content.replace(/\*(.*?)\*/g, '<em class="action-text">$1</em>');
                
                // 【修复】移除开头和结尾多余的 <br> 标签
                content = content.replace(/^(<br>)+/, '');
                content = content.replace(/(<br>)+$/, '');
                
                bubble.innerHTML = content;
            }
            
            messageContainer.appendChild(avatar);
            messageContainer.appendChild(bubble);
            dateChatContent.appendChild(messageContainer);
        }
        
        // 发送约会消息
        async function sendDateMessage() {
            console.log('【约会】发送按钮被点击');
            
            const input = document.getElementById('dateChatInput');
            if (!input) {
                console.error('【约会】找不到输入框 dateChatInput');
                return;
            }
            const content = input.value.trim();
            console.log('【约会】输入内容:', content);
            
            if (!content) {
                console.log('【约会】内容为空');
                return;
            }
            
            if (!currentDateChatId) {
                console.log('【约会】没有当前聊天ID');
                return;
            }
            
            console.log('【约会】当前聊天ID:', currentDateChatId);
            
            const timestamp = Date.now();
            
            // 【关键】同时保存到约会消息数据库（用于约会页面显示）
            const dateMessage = {
                id: timestamp,
                chatId: currentDateChatId,
                sender: 'user',
                content: content,
                timestamp: timestamp
            };
            console.log('【约会】保存消息:', dateMessage);
            try {
                await DateMessageManager.addMessage(dateMessage);
                console.log('【约会】消息已保存到IndexedDB');
            } catch (e) {
                console.error('【约会】保存消息失败:', e);
            }
            
            // 【关键】同时保存到私聊消息中（标记为约会消息，用于记忆总结和AI上下文）
            const chatMessage = {
                sender: 'user',
                content: `[线下约会] ${content}`,
                timestamp: timestamp,
                chatId: currentDateChatId,
                isDateMessage: true,  // 标记为约会消息
                type: 'text'
            };
            relationshipData.chatMessages.push(chatMessage);
            try {
                await saveData();
                console.log('【约会】消息已保存到私聊');
            } catch (e) {
                console.error('【约会】保存到私聊失败:', e);
            }
            
            // 渲染消息
            console.log('【约会】开始渲染消息');
            try {
                await renderDateMessage(dateMessage);
                console.log('【约会】消息渲染完成');
            } catch (e) {
                console.error('【约会】渲染消息失败:', e);
            }
            
            // 清空输入框
            input.value = '';
            
            // 滚动到底部
            const dateChatContent = document.getElementById('dateChatContent');
            dateChatContent.scrollTop = dateChatContent.scrollHeight;
            
            // 调用AI回复
            await generateDateAIResponse(content);
        }
        
        // 【新增】保存最后一条用户消息，用于重试
        let lastDateUserMessage = null;
        let isDateAIThinking = false;
        
        // 生成AI约会回复
        async function generateDateAIResponse(userMessage, isRetry = false) {
            const chatItem = relationshipData.wechatChatList.find(item => item.id == currentDateChatId);
            if (!chatItem) return;
            
            // 保存用户消息用于重试
            if (!isRetry) {
                lastDateUserMessage = userMessage;
            }
            
            // 【新增】显示"正在思考"提示
            isDateAIThinking = true;
            updateDateThinkingStatus();
            
            // 获取自定义文风
            const customStyle = await DateStyleManager.getStyle(currentDateChatId);
            const stylePrompt = customStyle || DEFAULT_DATE_STYLE;

            // 【关键修复】获取聊天设置中的上下文条数
            const contextLength = chatItem.contextLength || 20;
            console.log('【约会】使用上下文条数:', contextLength);

            // 【关键修复】获取最近的对话历史（约会模式专用）
            const recentMessages = await DateMessageManager.getRecentMessages(currentDateChatId, contextLength);
            let conversationHistory = '';
            if (recentMessages && recentMessages.length > 0) {
                conversationHistory = '\n\n【本次约会对话历史】\n';
                recentMessages.forEach(msg => {
                    const sender = msg.sender === 'user' ? (chatItem.myNickname || '你') : (chatItem.name || 'AI');
                    conversationHistory += `${sender}：${msg.content}\n`;
                });
            }

            // 构建提示词
            const prompt = `${stylePrompt}

角色设定：
${chatItem.personality || '无特殊设定'}

长期记忆：
${await getDateMemoryContext(currentDateChatId)}

世界书：
${await getDateWorldbookContext(currentDateChatId)}${conversationHistory}

请根据以上设定、文风和对话历史，自然地回复用户的消息。用户说：「${userMessage}」`;

            // 调用API获取回复
            try {
                const response = await callDateAIAPI(prompt, chatItem);
                const aiTimestamp = Date.now();
                
                // 【关键】保存AI回复到约会消息数据库
                const aiDateMessage = {
                    id: aiTimestamp,
                    chatId: currentDateChatId,
                    sender: 'ai',
                    content: response,
                    timestamp: aiTimestamp
                };
                await DateMessageManager.addMessage(aiDateMessage);
                
                // 【关键】同时保存到私聊消息中（标记为约会消息）
                const aiChatMessage = {
                    sender: 'ai',
                    content: `[线下约会] ${response}`,
                    timestamp: aiTimestamp,
                    chatId: currentDateChatId,
                    isDateMessage: true,  // 标记为约会消息
                    type: 'text'
                };
                relationshipData.chatMessages.push(aiChatMessage);
                await saveData();
                
                // 渲染AI消息
                await renderDateMessage(aiDateMessage);
                
                // 滚动到底部
                const dateChatContent = document.getElementById('dateChatContent');
                dateChatContent.scrollTop = dateChatContent.scrollHeight;
                
            } catch (error) {
                console.error('【约会】生成回复失败:', error);
                // 【修复】显示详细的错误信息
                let errorMsg = '生成回复失败';
                if (error.message) {
                    errorMsg += ': ' + error.message;
                }
                if (error.message && error.message.includes('API设置不完整')) {
                    errorMsg = '请先在"呼叫爱人"设置中配置API地址和密钥';
                } else if (error.message && error.message.includes('API请求失败')) {
                    errorMsg = 'API请求失败，请检查网络或API配置';
                }
                showToast(errorMsg, 'error', 5000);
                
                // 显示错误消息在聊天中
                const errorDateMessage = {
                    id: Date.now(),
                    chatId: currentDateChatId,
                    sender: 'ai',
                    content: `*[系统提示：${errorMsg}]*`,
                    timestamp: Date.now()
                };
                await renderDateMessage(errorDateMessage);
            } finally {
                // 【新增】隐藏"正在思考"提示
                isDateAIThinking = false;
                updateDateThinkingStatus();
            }
        }
        
        // 【新增】更新"正在思考"状态显示
        function updateDateThinkingStatus() {
            const title = document.getElementById('datePageTitle');
            if (title) {
                if (isDateAIThinking) {
                    title.textContent = '约会 · 正在思考...';
                    title.style.color = '#ff6b9d';
                } else {
                    const chatItem = relationshipData.wechatChatList.find(item => item.id == currentDateChatId);
                    title.textContent = chatItem ? `与${chatItem.name}的约会` : '约会';
                    title.style.color = '';
                }
            }
        }
        
        // 【新增】重试AI回复
        async function retryDateAIResponse() {
            if (!lastDateUserMessage) {
                showToast('没有可重试的消息', 'error');
                return;
            }
            if (isDateAIThinking) {
                showToast('AI正在思考中，请稍候', 'warning');
                return;
            }
            
            // 删除最后一条AI消息
            const dateChatContent = document.getElementById('dateChatContent');
            const lastMessage = dateChatContent.lastElementChild;
            if (lastMessage) {
                // 检查是否是AI消息
                const bubble = lastMessage.querySelector('.date-message-bubble, [style*="background: linear-gradient"]');
                if (bubble) {
                    lastMessage.remove();
                }
            }
            
            // 重新生成回复
            showToast('正在重新生成回复...', 'info');
            await generateDateAIResponse(lastDateUserMessage, true);
        }
        
        // 调用AI API（约会专用）
        async function callDateAIAPI(prompt, chatItem) {
            // 获取API设置
            const savedSettings = await loadAppSettings({});
            const apiSettings = savedSettings.api || {};
            
            // 【修复】使用正确的字段名 baseUrl 而不是 apiUrl
            const apiUrl = apiSettings.baseUrl || '';
            const apiKey = apiSettings.apiKey || '';
            const model = apiSettings.model || 'gpt-3.5-turbo';
            const temperature = apiSettings.temperature || 0.8;
            const maxTokens = apiSettings.maxTokens || 2000;
            
            console.log('【约会】API配置:', { apiUrl: apiUrl ? '已设置' : '未设置', apiKey: apiKey ? '已设置' : '未设置', model });
            
            if (!apiUrl || !apiKey) {
                console.error('【约会】API设置不完整:', { apiUrl, apiKey: apiKey ? '***' : '' });
                throw new Error('API设置不完整，请检查"呼叫爱人"中的API地址和密钥');
            }
            
            // 【关键】约会模式使用极简的系统提示词，只包含基本人设和文风
            // 获取用户个人信息
            const personalProfile = await localforage.getItem('personalProfile') || {};
            const userNickname = chatItem.myNickname || personalProfile.nickname || '用户';
            const userBio = personalProfile.bio || '';
            const userInterests = personalProfile.interests || '';
            const userTags = personalProfile.tags || '';
            
            let dateSystemPrompt = `你是${chatItem.name || 'AI'}，正在和${userNickname}进行线下约会。

【回复风格】
- 自然流畅的长对话，像真人一样聊天
- 主动接话、共情、延伸话题
- 合理进行场景、动作、心理、神态描写
- 动作描写用*斜体*表示
- 话语用「」符号框起来

【对方信息】
- 名字：${userNickname}`;
            
            if (userBio) {
                dateSystemPrompt += `\n- 简介：${userBio}`;
            }
            if (userInterests) {
                dateSystemPrompt += `\n- 兴趣爱好：${userInterests}`;
            }
            if (userTags) {
                dateSystemPrompt += `\n- 个性标签：${userTags}`;
            }
            
            dateSystemPrompt += `\n\n当前时间：${new Date().toLocaleString('zh-CN')}`;

            // 【修复】添加超时处理
            const controller = new AbortController();
            const timeoutId = setTimeout(() => controller.abort(), 300000); // 【修改】300秒超时
            
            try {
                // 【修复】拼接完整的API路径
                const fullApiUrl = apiUrl.endsWith('/chat/completions') ? apiUrl : `${apiUrl}/chat/completions`;
                console.log('【约会】调用API:', fullApiUrl, '模型:', model);
                const response = await fetch(fullApiUrl, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${apiKey}`
                    },
                    body: JSON.stringify({
                        model: model,
                        messages: [
                            { role: 'system', content: dateSystemPrompt },
                            { role: 'user', content: prompt }
                        ],
                        temperature: temperature,
                        max_tokens: maxTokens,
                        stream: false
                    }),
                    signal: controller.signal
                });
                
                clearTimeout(timeoutId);
                
                if (!response.ok) {
                    const errorText = await response.text();
                    console.error('【约会】API请求失败:', response.status, errorText);
                    throw new Error(`API请求失败(${response.status}): ${errorText.substring(0, 100)}`);
                }
                
                const data = await response.json();
                console.log('【约会】API响应:', data);
                
                if (!data.choices || !data.choices[0] || !data.choices[0].message) {
                    throw new Error('API返回数据格式错误');
                }
                
                return data.choices[0].message.content;
            } catch (fetchError) {
                clearTimeout(timeoutId);
                if (fetchError.name === 'AbortError') {
                    throw new Error('API请求超时(30秒)');
                }
                throw fetchError;
            }
        }
        
        // 获取约会记忆上下文
        async function getDateMemoryContext(chatId) {
            // 获取该角色的长期记忆
            const memories = relationshipData.memories || [];
            const chatMemories = memories.filter(m => m.chatId == chatId).slice(-5);
            
            if (chatMemories.length === 0) return '暂无长期记忆';
            
            return chatMemories.map(m => m.description).join('\n');
        }
        
        // 获取约会世界书上下文
        async function getDateWorldbookContext(chatId) {
            const chatItem = relationshipData.wechatChatList.find(item => item.id == chatId);
            if (!chatItem || !chatItem.worldbookIds || chatItem.worldbookIds.length === 0) {
                return '未挂载世界书';
            }
            
            const worldbookContents = [];
            for (const wbId of chatItem.worldbookIds) {
                const wb = relationshipData.worldbooks?.find(w => w.id === wbId);
                if (wb) {
                    worldbookContents.push(`${wb.title}:\n${wb.content}`);
                }
            }
            
            return worldbookContents.join('\n\n') || '未挂载世界书';
        }
        
        // 处理输入框回车事件
        function handleDateInputKeyPress(event) {
            if (event.key === 'Enter') {
                sendDateMessage();
            }
        }
        
        // 打开约会设置
        async function openDateSettings() {
            const modal = document.getElementById('dateSettingsModal');
            const input = document.getElementById('dateStyleInput');
            const preview = document.getElementById('dateBackgroundPreview');
            
            // 加载当前文风设置
            const customStyle = await DateStyleManager.getStyle(currentDateChatId);
            input.value = customStyle || '';
            
            // 加载当前背景设置
            const background = await DateBackgroundManager.getBackground(currentDateChatId);
            if (background) {
                preview.style.backgroundImage = `url(${background})`;
                preview.innerHTML = '';
            } else {
                preview.style.backgroundImage = '';
                preview.style.background = 'linear-gradient(135deg, #ffecd2 0%, #fcb69f 100%)';
                preview.innerHTML = '<span style="color: #999;">点击选择背景图片</span>';
            }
            
            // 【新增】加载颜色设置
            const colors = await DateColorManager.getColors(currentDateChatId);
            document.getElementById('dateAiBubbleColor').value = colors.aiBubble;
            document.getElementById('dateUserBubbleColor').value = colors.userBubble;
            document.getElementById('dateAiTextColor').value = colors.aiText;
            document.getElementById('dateUserTextColor').value = colors.userText;
            
            modal.style.display = 'flex';
        }
        
        // 关闭约会设置
        function closeDateSettings() {
            const modal = document.getElementById('dateSettingsModal');
            modal.style.display = 'none';
        }
        
        // 保存约会设置
        async function saveDateSettings() {
            const input = document.getElementById('dateStyleInput');
            const style = input.value.trim();
            
            await DateStyleManager.setStyle(currentDateChatId, style);
            
            showToast('设置已保存', 'success');
            closeDateSettings();
        }
        
        // 选择约会背景
        function selectDateBackground() {
            const input = document.getElementById('dateBackgroundInput');
            input.click();
        }
        
        // 处理约会背景变更
        async function handleDateBackgroundChange(input) {
            const file = input.files[0];
            if (!file) return;
            
            const reader = new FileReader();
            reader.onload = async function(e) {
                const imageData = e.target.result;
                
                // 压缩图片
                compressImage(imageData, async function(compressedData) {
                    // 保存背景
                    await DateBackgroundManager.setBackground(currentDateChatId, compressedData);
                    
                    // 更新预览
                    const preview = document.getElementById('dateBackgroundPreview');
                    preview.style.backgroundImage = `url(${compressedData})`;
                    preview.style.background = `url(${compressedData}) center/cover no-repeat`;
                    preview.innerHTML = '';
                    
                    // 更新约会页面背景
                    updateDatePageBackground();
                    
                    showToast('背景已更新', 'success');
                });
            };
            reader.readAsDataURL(file);
            
            // 清空input，允许重复选择同一文件
            input.value = '';
        }
        
        // 恢复默认背景
        async function resetDateBackground() {
            await DateBackgroundManager.setBackground(currentDateChatId, null);
            
            // 更新预览
            const preview = document.getElementById('dateBackgroundPreview');
            preview.style.backgroundImage = '';
            preview.style.background = 'linear-gradient(135deg, #ffecd2 0%, #fcb69f 100%)';
            preview.innerHTML = '<span style="color: #999;">点击选择背景图片</span>';
            
            // 更新约会页面背景
            updateDatePageBackground();
            
            showToast('已恢复默认背景', 'success');
        }
        
        // 更新约会页面背景
        async function updateDatePageBackground() {
            const datePage = document.getElementById('datePage');
            if (!datePage) return;
            
            const background = await DateBackgroundManager.getBackground(currentDateChatId);
            if (background) {
                datePage.style.background = `url(${background}) center/cover no-repeat`;
            } else {
                datePage.style.background = 'linear-gradient(135deg, #ffecd2 0%, #fcb69f 100%)';
            }
        }
        
        // 约会背景管理器
        const DateBackgroundManager = {
            STORAGE_KEY: 'dateBackgrounds',
            
            async getBackground(chatId) {
                const backgrounds = await localforage.getItem(this.STORAGE_KEY) || {};
                return backgrounds[chatId] || null;
            },
            
            async setBackground(chatId, backgroundData) {
                const backgrounds = await localforage.getItem(this.STORAGE_KEY) || {};
                if (backgroundData) {
                    backgrounds[chatId] = backgroundData;
                } else {
                    delete backgrounds[chatId];
                }
                await localforage.setItem(this.STORAGE_KEY, backgrounds);
            }
        };
        
        // 【新增】约会颜色管理器
        const DateColorManager = {
            STORAGE_KEY: 'dateColors',
            DEFAULT_COLORS: {
                aiBubble: '#ffb6c1',
                userBubble: '#ffffff',
                aiText: '#333333',
                userText: '#333333'
            },
            
            async getColors(chatId) {
                const colors = await localforage.getItem(this.STORAGE_KEY) || {};
                return { ...this.DEFAULT_COLORS, ...(colors[chatId] || {}) };
            },
            
            async setColors(chatId, colorData) {
                const colors = await localforage.getItem(this.STORAGE_KEY) || {};
                colors[chatId] = { ...this.DEFAULT_COLORS, ...(colors[chatId] || {}), ...colorData };
                await localforage.setItem(this.STORAGE_KEY, colors);
            }
        };
        
        // 【新增】更新气泡颜色
        async function updateDateBubbleColor(type, color) {
            await DateColorManager.setColors(currentDateChatId, { [`${type}Bubble`]: color });
            // 刷新消息显示
            await refreshDateMessages();
        }
        
        // 【新增】更新字体颜色
        async function updateDateTextColor(type, color) {
            await DateColorManager.setColors(currentDateChatId, { [`${type}Text`]: color });
            // 刷新消息显示
            await refreshDateMessages();
        }
        
        // 【新增】刷新约会消息（应用新颜色）
        async function refreshDateMessages() {
            const dateChatContent = document.getElementById('dateChatContent');
            if (!dateChatContent || !currentDateChatId) return;
            
            // 清空当前显示
            dateChatContent.innerHTML = '';
            
            // 重新加载消息
            const messages = await DateMessageManager.getMessagesByChatId(currentDateChatId);
            for (const msg of messages) {
                await renderDateMessage(msg);
            }
        }
        
        // 约会消息管理器（IndexedDB）
        const DateMessageManager = {
            DB_NAME: 'DateMessagesDB',
            STORE_NAME: 'messages',
            DB_VERSION: 1,
            
            async initDB() {
                return new Promise((resolve, reject) => {
                    const request = indexedDB.open(this.DB_NAME, this.DB_VERSION);
                    
                    request.onerror = () => reject(request.error);
                    request.onsuccess = () => resolve(request.result);
                    
                    request.onupgradeneeded = (event) => {
                        const db = event.target.result;
                        if (!db.objectStoreNames.contains(this.STORE_NAME)) {
                            const store = db.createObjectStore(this.STORE_NAME, { keyPath: 'id' });
                            store.createIndex('chatId', 'chatId', { unique: false });
                            store.createIndex('timestamp', 'timestamp', { unique: false });
                        }
                    };
                });
            },
            
            async addMessage(message) {
                const db = await this.initDB();
                return new Promise((resolve, reject) => {
                    const transaction = db.transaction([this.STORE_NAME], 'readwrite');
                    const store = transaction.objectStore(this.STORE_NAME);
                    const request = store.add(message);
                    
                    request.onsuccess = () => resolve();
                    request.onerror = () => reject(request.error);
                });
            },
            
            async getMessagesByChatId(chatId) {
                const db = await this.initDB();
                return new Promise((resolve, reject) => {
                    const transaction = db.transaction([this.STORE_NAME], 'readonly');
                    const store = transaction.objectStore(this.STORE_NAME);
                    const index = store.index('chatId');
                    const request = index.getAll(chatId);

                    request.onsuccess = () => {
                        const messages = request.result;
                        messages.sort((a, b) => a.timestamp - b.timestamp);
                        resolve(messages);
                    };
                    request.onerror = () => reject(request.error);
                });
            },

            // 【新增】获取最近的N条消息（用于上下文）
            async getRecentMessages(chatId, limit = 10) {
                const db = await this.initDB();
                return new Promise((resolve, reject) => {
                    const transaction = db.transaction([this.STORE_NAME], 'readonly');
                    const store = transaction.objectStore(this.STORE_NAME);
                    const index = store.index('chatId');
                    const request = index.getAll(chatId);

                    request.onsuccess = () => {
                        const messages = request.result;
                        // 按时间戳排序
                        messages.sort((a, b) => a.timestamp - b.timestamp);
                        // 返回最近的N条
                        const recentMessages = messages.slice(-limit);
                        resolve(recentMessages);
                    };
                    request.onerror = () => reject(request.error);
                });
            },
            
            async deleteMessagesByChatId(chatId) {
                const db = await this.initDB();
                const messages = await this.getMessagesByChatId(chatId);
                
                return new Promise((resolve, reject) => {
                    const transaction = db.transaction([this.STORE_NAME], 'readwrite');
                    const store = transaction.objectStore(this.STORE_NAME);
                    
                    messages.forEach(msg => {
                        store.delete(msg.id);
                    });
                    
                    transaction.oncomplete = () => resolve();
                    transaction.onerror = () => reject(transaction.error);
                });
            }
        };
        
        // 约会会话管理器（记录会话开始和结束时间）
        const DateSessionManager = {
            STORAGE_KEY: 'dateSessions',
            
            // 获取当前会话信息
            async getSession(chatId) {
                const sessions = await localforage.getItem(this.STORAGE_KEY) || {};
                return sessions[chatId] || { lastEndTime: null, currentStartTime: null };
            },
            
            // 开始新会话
            async startSession(chatId) {
                const sessions = await localforage.getItem(this.STORAGE_KEY) || {};
                const session = sessions[chatId] || {};
                session.currentStartTime = Date.now();
                sessions[chatId] = session;
                await localforage.setItem(this.STORAGE_KEY, sessions);
                console.log('【约会】会话开始:', chatId, new Date().toLocaleString());
            },
            
            // 结束会话
            async endSession(chatId) {
                const sessions = await localforage.getItem(this.STORAGE_KEY) || {};
                const session = sessions[chatId] || {};
                session.lastEndTime = Date.now();
                session.currentStartTime = null;
                sessions[chatId] = session;
                await localforage.setItem(this.STORAGE_KEY, sessions);
                console.log('【约会】会话结束:', chatId, new Date().toLocaleString());
            },
            
            // 获取上次会话结束时间
            async getLastSessionEnd(chatId) {
                const session = await this.getSession(chatId);
                return session.lastEndTime;
            }
        };
        
        // 约会文风管理器
        const DateStyleManager = {
            STORAGE_KEY: 'dateStyles',
            
            async getStyle(chatId) {
                const styles = await localforage.getItem(this.STORAGE_KEY) || {};
                return styles[chatId] || '';
            },
            
            async setStyle(chatId, style) {
                const styles = await localforage.getItem(this.STORAGE_KEY) || {};
                styles[chatId] = style;
                await localforage.setItem(this.STORAGE_KEY, styles);
            }
        };
    </script>

    <!-- 小黑屋囚禁模式页面 -->
    <div id="blackRoomPage" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: url('https://img.58sb.cn/file/img/ISQhEXRN.jpg') center/cover no-repeat; z-index: 99999; flex-direction: column; touch-action: none; -webkit-touch-callout: none;">
        <!-- 背景遮罩层 - 阻止点击穿透 -->
