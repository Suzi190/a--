        // 渲染违规记录完整列表
        function renderViolationsFullList() {
            const container = document.getElementById('violationsFullList');
            if (violations.length === 0) {
                container.innerHTML = `
                    <div class="memo-detail-empty">
                        <div class="memo-detail-empty-icon">✅</div>
                        <div>暂无违规记录</div>
                        <div style="font-size: 12px; margin-top: 8px;">表现很棒，继续保持！</div>
