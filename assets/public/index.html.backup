                        <input type="text" id="writeLetterEvent" class="form-control" placeholder="如：情人节、生日、纪念日等">
                    </div>
                    <div class="form-group">
                        <label>信件内容：</label>
                        <textarea id="writeLetterContent" class="form-control write-letter-textarea" rows="12" placeholder="在此写下你想说的话..."></textarea>
                    </div>
                </div>
            </div>
            <div class="write-letter-footer">
                <button onclick="closeWriteLetterPage()" class="btn btn-cancel">取消</button>
                <button onclick="sendLetter()" class="btn btn-save">💌 发送信件</button>
            </div>
        </div>
    </div>

    <!-- 动态图片编辑弹窗 -->
    <div id="dynamicImageModal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h3>编辑动态图片</h3>
                <span class="close-btn" onclick="closeDynamicImageModal()">&times;</span>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label>选择动态图片（支持GIF）：</label>
                    <input type="file" id="dynamicImageInput" class="form-control" accept="image/*">
                </div>
