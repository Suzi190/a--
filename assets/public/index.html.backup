                    content: '教育部近日印发通知，要求各地严格控制中小学生作业总量，小学一、二年级不留书面家庭作业。'
                },
                { 
                    title: '全国铁路调图，新增多条高铁线路', 
                    source: '中国铁路', 
                    time: '6小时前', 
                    image: 'https://images.unsplash.com/photo-1474487548417-781cb71495f3?w=200&h=140&fit=crop',
                    content: '全国铁路将于下月实施新的列车运行图，新增高铁线路12条，新增动车组列车200余对。'
                }
            ];
            weiboRenderNews();
        };

        // 渲染新闻列表
        window.weiboRenderNews = async function() {
            const newsList = document.getElementById('weiboNewsList');
            
            // 只显示AI生成的新闻，不显示用户动态（用户动态只在"动态"页面显示）
            let html = '';
            
            // 添加AI生成的新闻
            html += weiboNewsData.map(item => `
                <div class="weibo-news-item" onclick="weiboOpenNewsDetail('${encodeURIComponent(item.title)}')">
                    <div class="weibo-news-content">
                        <div class="weibo-news-title">${item.title}</div>
                        <div class="weibo-news-meta">
                            <span class="weibo-news-source">${item.source || item.source?.name || '新闻来源'}</span>
                            <span>${item.time || item.publishedAt || '刚刚'}</span>
                        </div>
                    </div>
                </div>
            `).join('');
            
            newsList.innerHTML = html || '<div style="padding: 20px; text-align: center; color: #999;">暂无内容</div>';
        };

        // 打开自己发布的动态详情
        // 打开动态详情页（通用）
        // 处理动态点击
        window.weiboHandlePostClick = function(postId) {
            console.log('点击动态:', postId);
            weiboOpenPostDetail(postId);
        };

        window.weiboOpenPostDetail = async function(postId) {
            console.log('打开动态详情:', postId);
            
            // 先从我的动态中查找
            let myPosts = await localforage.getItem('weiboMyPosts') || [];
            let post = myPosts.find(p => p.id === postId);
            
            // 如果没找到，查找AI发的动态
            if (!post) {
                // 获取关注列表
                const followList = await localforage.getItem('weiboFollowList') || [];
                for (const followId of followList) {
                    const aiPosts = await localforage.getItem('weiboAIPosts_' + followId) || [];
                    post = aiPosts.find(p => p.id === postId);
                    if (post) break;
                }
            }
            
            // 如果没找到，可能是AI生成的新闻
            if (!post) {
                post = weiboNewsData.find(p => p.id === postId);
            }
            
            if (!post) {
                console.log('找不到动态:', postId);
                alert('无法找到该动态');
                return;
            }
            
            console.log('找到动态:', post);
            await weiboOpenMyPostDetail(post);
        };

        window.weiboOpenMyPostDetail = async function(post) {
            if (!post) return;
            
            // 确保详情页元素存在
            let detailPage = document.getElementById('weiboDetailPage');
            let contentEl = document.getElementById('weiboDetailContent');
            
            if (!detailPage) {
                // 创建详情页
                detailPage = document.createElement('div');
                detailPage.id = 'weiboDetailPage';
                detailPage.style.cssText = 'position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: #f5f5f5; z-index: 10001; display: none; flex-direction: column; overflow: hidden;';
                detailPage.innerHTML = `
                    <div style="background: #fff; padding: 12px 16px; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #f0f0f0;">
                        <div style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; cursor: pointer;" onclick="weiboCloseDetailPage()">
                            <svg viewBox="0 0 24 24" fill="currentColor" style="width: 24px; height: 24px;">
                                <path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/>
                            </svg>
                        </div>
                        <div style="font-size: 17px; font-weight: 600;">动态详情</div>
                        <div style="width: 40px;"></div>
                    </div>
                    <div style="flex: 1; overflow-y: auto; padding: 16px;" id="weiboDetailContent"></div>
                `;
                document.body.appendChild(detailPage);
                contentEl = document.getElementById('weiboDetailContent');
            }
            
            // 处理头像显示
            let avatarContent = '😀';
            if (post.userAvatar) {
                if (post.userAvatar.length <= 2) {
                    // emoji头像
                    avatarContent = post.userAvatar;
                } else if (post.userAvatar.startsWith('http') || post.userAvatar.startsWith('data:')) {
                    // 图片URL
                    avatarContent = `<img src="${post.userAvatar}" style="width:100%;height:100%;object-fit:cover;" onerror="this.style.display='none';this.parentNode.innerText='😀'">`;
                } else {
                    // 其他情况用默认emoji
                    avatarContent = '😀';
                }
            }
            
            // 获取评论
            const comments = await localforage.getItem('weiboComments_' + post.id) || [];
            const timeDisplay = post.timestamp ? weiboFormatTime(post.timestamp) : (post.time || '刚刚');
            
            let commentsHtml = '';
            if (comments.length > 0) {
                commentsHtml = `
                    <div style="margin-top: 20px; padding-top: 20px; border-top: 1px solid #f0f0f0;">
                        <div style="font-size: 14px; font-weight: 600; color: #333; margin-bottom: 12px;">评论 (${comments.length})</div>
                        ${comments.map((c, index) => `
                            <div style="margin-bottom: 12px; padding: 12px; background: #f8f8f8; border-radius: 8px;" id="comment_${c.id}">
                                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                                    <div style="font-size: 14px; color: #576b95; font-weight: 500;">${c.user}</div>
                                    <div style="font-size: 12px; color: #999;">${c.likes || 0}赞</div>
                                </div>
                                ${c.replyTo ? `<div style="font-size: 13px; color: #999; margin-bottom: 4px;">回复 ${c.replyTo}:</div>` : ''}
                                <div style="font-size: 15px; color: #333; line-height: 1.5;">${c.content}</div>
                                <div style="margin-top: 8px; font-size: 12px; color: #999; display: flex; gap: 20px;">
                                    <span style="cursor: pointer; display: flex; align-items: center; gap: 4px;" onclick="weiboLikeComment('${post.id}', '${c.id}')">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="width: 14px; height: 14px;">
                                            <path d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
                                        </svg>
                                        点赞
                                    </span>
                                    <span style="cursor: pointer; display: flex; align-items: center; gap: 4px;" onclick="weiboReplyToComment('${post.id}', '${c.id}', '${c.user}')">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="width: 14px; height: 14px;">
                                            <path d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
                                        </svg>
                                        回复
                                    </span>
                                </div>
                                ${c.replies && c.replies.length > 0 ? `
                                    <div style="margin-top: 10px; padding-left: 12px; border-left: 2px solid #ddd;">
                                        ${c.replies.map(r => `
                                            <div style="margin-bottom: 8px; padding: 8px; background: #fff; border-radius: 4px;">
                                                <div style="font-size: 13px; color: #576b95; font-weight: 500; margin-bottom: 2px;">${r.user}</div>
                                                <div style="font-size: 13px; color: #333;">${r.content}</div>
                                            </div>
                                        `).join('')}
                                    </div>
                                ` : ''}
                            </div>
                        `).join('')}
                    </div>
                `;
            }
            
            contentEl.innerHTML = `
                <div class="weibo-detail-article">
                    <div style="display: flex; align-items: center; margin-bottom: 16px;">
                        <div style="width: 50px; height: 50px; border-radius: 50%; overflow: hidden; background: #f0f0f0; display: flex; align-items: center; justify-content: center; margin-right: 12px;">
                            ${avatarContent}
                        </div>
                        <div>
                            <div style="font-size: 16px; font-weight: 500; color: #333;">${post.userName}</div>
                            <div style="font-size: 13px; color: #999;">${timeDisplay}</div>
                        </div>
                    </div>
                    <div class="weibo-detail-article-content" style="font-size: 16px; line-height: 1.6;">
                        <p>${post.content}</p>
                        ${post.images && post.images.length > 0 ? 
                            `<div style="display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px;">${post.images.map(img => `<img src="${img}" style="width: 100%; max-width: 300px; border-radius: 8px;">`).join('')}</div>` 
                            : ''}
                    </div>
                    <div style="display: flex; justify-content: space-around; padding: 16px 0; border-top: 1px solid #f0f0f0; margin-top: 20px;">
                        <div style="display: flex; align-items: center; gap: 6px; color: #666; font-size: 14px; cursor: pointer;" onclick="weiboToggleLike(this)">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="width: 20px; height: 20px;">
                                <path d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
                            </svg>
                            <span>${post.likes || 0}</span>
                        </div>
                        <div style="display: flex; align-items: center; gap: 6px; color: #666; font-size: 14px; cursor: pointer;">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="width: 20px; height: 20px;">
                                <path d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
                            </svg>
                            <span>${post.comments || 0}</span>
                        </div>
                    </div>
                    ${commentsHtml}
                    
                    <!-- 加载更多评论按钮 -->
                    <div style="margin-top: 20px; text-align: center;">
                        <button id="weiboLoadMoreBtn" onclick="weiboLoadMoreComments('${post.id}')" style="padding: 10px 30px; border: 1px solid #ff6b6b; background: #fff; color: #ff6b6b; border-radius: 20px; cursor: pointer; font-size: 14px;">
                            加载更多评论
                        </button>
                    </div>
                    
                    <!-- 评论输入框 -->
                    <div style="margin-top: 20px; padding: 15px; background: #f8f8f8; border-radius: 8px;">
                        <div style="font-size: 14px; color: #666; margin-bottom: 10px;">发表评论</div>
                        <textarea id="weiboCommentInput" placeholder="说点什么..." style="width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 4px; resize: none; font-size: 14px; min-height: 60px; box-sizing: border-box;"></textarea>
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 10px;">
                            <span style="font-size: 12px; color: #999;">支持回复其他评论</span>
                            <button onclick="weiboSubmitComment('${post.id}')" style="padding: 8px 20px; background: #ff6b6b; color: #fff; border: none; border-radius: 4px; cursor: pointer; font-size: 14px;">发送</button>
                        </div>
                    </div>
                </div>
            `;

            // 显示详情页
            detailPage.style.display = 'flex';
            document.body.style.overflow = 'hidden';
            console.log('详情页已显示');
        };

        // 提交评论（用户自己发的）
        window.weiboSubmitComment = async function(postId) {
            const input = document.getElementById('weiboCommentInput');
            const content = input.value.trim();
            if (!content) {
                alert('请输入评论内容');
                return;
            }

            // 获取用户信息
            const userName = await localforage.getItem('weiboProfileName') || '我';
            const userAvatar = await localforage.getItem('weiboProfileAvatar') || '😀';

            // 创建评论
            const newComment = {
                id: 'comment_user_' + Date.now(),
                user: userName,
                content: content,
                avatar: userAvatar,
                type: '用户',
                timestamp: Date.now(),
                likes: 0,
                isUserComment: true
            };

            // 保存评论
            let comments = await localforage.getItem('weiboComments_' + postId) || [];
            comments.push(newComment);
            await localforage.setItem('weiboComments_' + postId, comments);

            // 清空输入框
            input.value = '';

            // 刷新详情页
            await weiboRefreshPostDetail(postId);
        };

        // 回复评论
        window.weiboReplyToComment = async function(postId, commentId, replyToUser) {
            const content = prompt(`回复 ${replyToUser}:`);
            if (!content || !content.trim()) return;

            // 获取用户信息
            const userName = await localforage.getItem('weiboProfileName') || '我';
            const userAvatar = await localforage.getItem('weiboProfileAvatar') || '😀';

            // 创建回复
            const reply = {
                id: 'reply_' + Date.now(),
                user: userName,
                content: `回复${replyToUser}: ${content}`,
                avatar: userAvatar,
                timestamp: Date.now(),
                isReply: true
            };

            // 保存回复
            let comments = await localforage.getItem('weiboComments_' + postId) || [];
            const commentIndex = comments.findIndex(c => c.id === commentId);
            if (commentIndex !== -1) {
                if (!comments[commentIndex].replies) {
                    comments[commentIndex].replies = [];
                }
                comments[commentIndex].replies.push(reply);
                await localforage.setItem('weiboComments_' + postId, comments);

                // 刷新详情页
                await weiboRefreshPostDetail(postId);
            }
        };

        // 点赞评论
        window.weiboLikeComment = async function(postId, commentId) {
            let comments = await localforage.getItem('weiboComments_' + postId) || [];
            const commentIndex = comments.findIndex(c => c.id === commentId);
            if (commentIndex !== -1) {
                comments[commentIndex].likes = (comments[commentIndex].likes || 0) + 1;
                await localforage.setItem('weiboComments_' + postId, comments);
                await weiboRefreshPostDetail(postId);
            }
        };

        // 刷新新闻
        // 刷新实时热点 - 使用AI生成个性化新闻
        window.weiboRefreshNews = async function() {
            const newsList = document.getElementById('weiboNewsList');
            newsList.innerHTML = '<div class="weibo-loading"><div class="weibo-loading-spinner"></div><div style="margin-top: 10px; color: #999;">AI生成中...</div></div>';
            
            try {
                // 1. 收集数据
                const contextData = await weiboCollectContextData();
                console.log('【AI新闻】收集的上下文数据:', contextData);
                
                // 2. 调用AI生成新闻
                const aiNewsData = await weiboGenerateNewsWithAI(contextData);
                
                if (aiNewsData && aiNewsData.length > 0) {
                    // 合并用户自己发布的动态
                    const myPosts = await localforage.getItem('weiboMyPosts') || [];
                    weiboNewsData = [...myPosts, ...aiNewsData];
                    weiboRenderNews();
                    // 保存到缓存
                    localforage.setItem('weiboNewsCache', {
                        data: aiNewsData,
                        timestamp: Date.now(),
                        isAIGenerated: true
                    });
                    console.log('【AI新闻】生成成功并保存');
                } else {
                    // AI生成失败，回退到RSS
                    console.log('【AI新闻】生成失败，使用RSS');
                    weiboLoadNews();
                }
            } catch (error) {
                console.error('【AI新闻】生成失败:', error);
                // 出错时回退到RSS
                weiboLoadNews();
            }
        };
        
        // 使用AI生成新闻
        window.weiboGenerateNewsWithAI = async function(contextData) {
            // 获取API配置
            const savedSettings = await loadAppSettings({});
            const apiUrl = savedSettings.api?.baseUrl || 'https://api.openai.com/v1';
            const apiKey = savedSettings.api?.apiKey || '';
            const model = savedSettings.api?.model || 'gpt-3.5-turbo';
            
            if (!apiKey) {
                console.log('【AI新闻】未配置API，跳过AI生成');
                return null;
            }
            
            // 构建提示词
            const prompt = weiboBuildNewsPrompt(contextData);
            
            try {
                const response = await fetch(`${apiUrl}/chat/completions`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${apiKey}`
                    },
                    body: JSON.stringify({
                        model: model,
                        messages: [
                            { role: 'system', content: '你是一个新闻生成助手。根据提供的世界观和角色人设，生成符合微博风格的实时热点新闻。' },
                            { role: 'user', content: prompt }
                        ],
                        temperature: 0.8,
                        max_tokens: 3000
                    })
                });
                
                if (!response.ok) {
                    throw new Error(`API请求失败: ${response.status}`);
                }
                
                const result = await response.json();
                const content = result.choices[0].message.content;
                
                // 解析AI返回的内容
                return weiboParseAINewsResponse(content);
            } catch (error) {
                console.error('【AI新闻】API调用失败:', error);
                return null;
            }
        };
        
        // 构建新闻生成提示词
        window.weiboBuildNewsPrompt = function(data) {
            let prompt = '请创作5条真实的微博实时热点新闻，格式为JSON数组。每条包含：title(标题), source(来源), time(时间如"刚刚"/"5分钟前"), content(完整新闻内容400-600字), image(可选，留空字符串)\n\n';

            // 添加当前日期和节日信息
            if (data.dateInfo) {
                prompt += `【当前日期】${data.dateInfo.date} ${data.dateInfo.weekday}\n`;
                if (data.dateInfo.festival) {
                    prompt += `【节日】今天是${data.dateInfo.festival}，新闻内容应与节日相关或受节日影响\n`;
                }
                prompt += `【季节】${data.dateInfo.season}\n\n`;
            }

            // 添加世界书世界观
            if (data.worldbooks.length > 0) {
                prompt += '【世界观设定】\n';
                data.worldbooks.forEach((book, i) => {
                    prompt += `${book.name}: ${book.content.substring(0, 800)}\n`;
                });
                prompt += '\n';
            }

            // 添加角色人设
            if (data.characters.length > 0) {
                prompt += '【角色人设】\n';
                data.characters.forEach((char, i) => {
                    prompt += `${char.name}: ${char.description || '普通角色'}\n`;
                });
                prompt += '\n';
            }

            prompt += '【创作要求】\n';
            prompt += '1. 基于当前日期、节日、世界观和角色人设，创作真实、具体、有情节的新闻事件\n';
            prompt += '2. 如果今天有节日（如春节、国庆节、情人节等），新闻内容应与节日相关或受节日影响\n';
            prompt += '3. 标题要吸引人，符合微博新闻风格（20-35字），有新闻性、有看点\n';
            prompt += '4. content字段必须是完整的新闻报道，像真实记者写的新闻一样，包含：\n';
            prompt += '   - 新闻导语（最重要的信息）\n';
            prompt += '   - 事件的详细经过（时间、地点、人物、起因、经过、结果）\n';
            prompt += '   - 当事人的真实反应、对话、表情\n';
            prompt += '   - 目击者的描述\n';
            prompt += '   - 事件的后续发展或影响\n';
            prompt += '5. 不要套模板，不要写"近日"、"据悉"、"据报道"这类套话\n';
            prompt += '6. 要像真实发生的新闻事件，有具体时间（如"今天下午3点"）、具体地点、真实对话\n';
            prompt += '7. 内容要有故事性和现场感，400-600字\n';
            prompt += '8. 来源可以是角色名字或虚拟媒体名称\n';
            prompt += '9. 返回纯JSON数组格式，不要其他文字\n';
            prompt += '10. 示例：[{"title":"角色A街头偶遇旧友当场泪崩","source":"娱乐前线","time":"刚刚","content":"今天下午3点，角色A在市中心商业街购物时，意外遇见了十年未见的老友B。两人四目相对的瞬间，角色A当场愣住，随后眼眶泛红..."}]';

            return prompt;
        };
        
        // 解析AI返回的新闻数据
        window.weiboParseAINewsResponse = function(content) {
            try {
                // 尝试直接解析JSON
                return JSON.parse(content);
            } catch (e) {
                // 尝试从文本中提取JSON
                const jsonMatch = content.match(/\[[\s\S]*\]/);
                if (jsonMatch) {
                    return JSON.parse(jsonMatch[0]);
                }
                throw new Error('无法解析AI返回的内容');
            }
        };

        // 当前选中的分类
        let weiboCurrentCategory = 'hot';

        // 分类配置 - 更多详细分类
        const weiboCategoryConfig = {
            // 主分类
            'hot': { name: '全网热搜', icon: '🔥', color: '#ff6b6b', keywords: '' },
            'weibo': { name: '微博热搜', icon: '🐚', color: '#ff8200', keywords: '' },
