        // 自定义 Alert 弹窗函数
        function showCustomAlert(title, message, type = 'alert', onConfirm = null, onCancel = null) {
            const modal = document.getElementById('customAlertModal');
            const titleEl = document.getElementById('customAlertTitle');
            const messageEl = document.getElementById('customAlertMessage');
            const confirmBtn = document.getElementById('customAlertConfirmBtn');
            const cancelBtn = document.getElementById('customAlertCancelBtn');

            titleEl.textContent = title;
            messageEl.textContent = message;

            // 重置按钮状态
            cancelBtn.style.display = type === 'confirm' ? 'block' : 'none';
            confirmBtn.textContent = '确定';

            // 确认按钮点击事件
            confirmBtn.onclick = () => {
                hideCustomAlert();
                if (onConfirm) onConfirm();
            };

            // 取消按钮点击事件
            cancelBtn.onclick = () => {
                hideCustomAlert();
                if (onCancel) onCancel();
            };

            // 显示弹窗
            modal.style.display = 'flex';
            setTimeout(() => {
                modal.classList.add('show');
            }, 10);
        }

        function hideCustomAlert() {
            const modal = document.getElementById('customAlertModal');
            modal.classList.remove('show');
            setTimeout(() => {
                modal.style.display = 'none';
            }, 300);
        }

        // 欢迎弹窗相关变量
        let welcomeCountdownInterval = null;
        let welcomeCountdownValue = 8;

        // 显示欢迎弹窗
        async function showWelcomeModal() {
            // 检查是否已经选择不再提醒
            let hideWelcome = false;
            if (SQLiteManager.isAvailable) {
                hideWelcome = await SQLiteManager.getAppState('hideWelcomeModal', false);
                console.log('✅ 从 SQLite 读取欢迎弹窗状态');
            } else {
                hideWelcome = localStorage.getItem('hideWelcomeModal') === 'true';
                console.log('✅ 从 localStorage 读取欢迎弹窗状态（降级方案）');
            }
            if (hideWelcome === true || hideWelcome === 'true') {
                console.log('【欢迎弹窗】用户已选择不再提醒，跳过显示');
                return;
            }

            const modal = document.getElementById('welcomeModal');
            const dismissBtn = document.getElementById('welcomeDismissBtn');
            const countdownSpan = document.getElementById('welcomeCountdown');
            
            if (!modal) return;

            // 重置倒计时
            welcomeCountdownValue = 8;
            countdownSpan.textContent = welcomeCountdownValue;
            dismissBtn.disabled = true;

            // 显示弹窗
            modal.style.display = 'flex';
            setTimeout(() => {
                modal.classList.add('show');
            }, 10);

            // 启动倒计时
            welcomeCountdownInterval = setInterval(() => {
                welcomeCountdownValue--;
                countdownSpan.textContent = welcomeCountdownValue;
                
                if (welcomeCountdownValue <= 0) {
                    clearInterval(welcomeCountdownInterval);
                    dismissBtn.disabled = false;
                    dismissBtn.innerHTML = '不再提醒';
                }
            }, 1000);

            console.log('【欢迎弹窗】已显示，开始8秒倒计时');
        }

        // 关闭欢迎弹窗
        function closeWelcomeModal(dontShowAgain = false) {
            const modal = document.getElementById('welcomeModal');
            
            // 清除倒计时
            if (welcomeCountdownInterval) {
                clearInterval(welcomeCountdownInterval);
                welcomeCountdownInterval = null;
            }

            // 如果选择不再提醒，保存到 SQLite 或本地存储
            if (dontShowAgain) {
                (async () => {
                    if (SQLiteManager.isAvailable) {
                        await SQLiteManager.setAppState('hideWelcomeModal', true);
                        console.log('✅ 保存欢迎弹窗状态到 SQLite');
                    } else {
                        localStorage.setItem('hideWelcomeModal', 'true');
                        console.log('✅ 保存欢迎弹窗状态到 localStorage（降级方案）');
                    }
                })();
            }

            // 关闭弹窗动画
            modal.classList.remove('show');
            setTimeout(() => {
                modal.style.display = 'none';
            }, 300);
        }

        // 点击遮罩关闭弹窗
        document.addEventListener('DOMContentLoaded', () => {
            const modal = document.getElementById('customAlertModal');
            if (modal) {
                modal.addEventListener('click', (e) => {
                    if (e.target === modal) {
                        hideCustomAlert();
                    }
                });
            }
        });

        // 个人资料设置功能
        async function openPersonalProfile() {
            console.log('打开个人资料设置');
            await loadPersonalProfile();
            document.getElementById('personalProfilePage').style.display = 'flex';
            // 渲染荣誉墙
            await renderHonorWall();
        }

        function closePersonalProfile() {
            console.log('关闭个人资料设置');
            document.getElementById('personalProfilePage').style.display = 'none';
        }

        // 初始化个人资料（页面加载时调用）
        async function initPersonalProfile() {
            let savedProfile = {};
            let loadLocation = '';
            
            // 【修复】优先从 localforage 读取（目前最可靠）
            if (typeof localforage !== 'undefined') {
                try {
                    savedProfile = await localforage.getItem('personalProfile') || {};
                    if (savedProfile && savedProfile.avatar) {
                        console.log('✅ 使用 localforage 初始化个人资料');
                        loadLocation = 'localforage';
                    }
                } catch (lfError) {
                    console.error('❌ localforage 读取失败:', lfError);
                }
            }
            
            // 如果 localforage 没有数据，尝试 SQLite
            if (!savedProfile || !savedProfile.avatar) {
                if (SQLiteManager.isAvailable) {
                    try {
                        const sqliteProfile = await SQLiteManager.getPersonalProfile() || {};
                        if (sqliteProfile && sqliteProfile.avatar) {
                            console.log('✅ 使用 SQLite 初始化个人资料');
                            savedProfile = sqliteProfile;
                            loadLocation = 'sqlite';
                        }
                    } catch (sqliteError) {
                        console.error('❌ SQLite 读取失败:', sqliteError);
                    }
                }
            }
            
            // 最后尝试 localStorage
            if (!savedProfile || !savedProfile.avatar) {
                try {
                    const stored = localStorage.getItem('personalProfile');
                    if (stored) {
                        savedProfile = JSON.parse(stored);
                        console.log('✅ 使用 localStorage 初始化个人资料（降级方案）');
                        loadLocation = 'localStorage';
                    }
                } catch (lsError) {
                    console.error('❌ localStorage 读取失败:', lsError);
                }
            }
            
            console.log('初始化个人资料:', savedProfile, '来源:', loadLocation);

            // 更新全局缓存
            cachedPersonalProfile = savedProfile;
            console.log('个人资料缓存已初始化:', cachedPersonalProfile);

            // 【修复】更新页面上的头像显示
            const avatarImg = document.getElementById('profileAvatar');
            if (savedProfile.avatar && savedProfile.avatar !== '' && savedProfile.avatar !== 'undefined') {
                console.log('个人资料头像已设置:', savedProfile.avatar);
                avatarImg.src = savedProfile.avatar;
            } else {
                console.log('个人资料头像未设置，使用默认头像');
                avatarImg.src = 'https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=cartoon%20avatar%20of%20a%20user%2C%20cute%2C%20simple%20style&image_size=square';
            }

            return savedProfile;
        }

        // 加载个人资料
        async function loadPersonalProfile() {
            let savedProfile = {};
            let loadLocation = '';
            
            // 【修复】优先从 localforage 读取（目前最可靠）
            if (typeof localforage !== 'undefined') {
                try {
                    savedProfile = await localforage.getItem('personalProfile') || {};
                    if (savedProfile && savedProfile.avatar) {
                        console.log('✅ 使用 localforage 加载个人资料');
                        loadLocation = 'localforage';
                    }
                } catch (lfError) {
                    console.error('❌ localforage 读取失败:', lfError);
                }
            }
            
            // 如果 localforage 没有数据，尝试 SQLite
            if (!savedProfile || !savedProfile.avatar) {
                if (SQLiteManager.isAvailable) {
                    try {
                        const sqliteProfile = await SQLiteManager.getPersonalProfile() || {};
                        if (sqliteProfile && sqliteProfile.avatar) {
                            console.log('✅ 使用 SQLite 加载个人资料');
                            savedProfile = sqliteProfile;
                            loadLocation = 'sqlite';
                        }
                    } catch (sqliteError) {
                        console.error('❌ SQLite 读取失败:', sqliteError);
                    }
                }
            }
            
            // 最后尝试 localStorage
            if (!savedProfile || !savedProfile.avatar) {
                try {
                    const stored = localStorage.getItem('personalProfile');
                    if (stored) {
                        savedProfile = JSON.parse(stored);
                        console.log('✅ 使用 localStorage 加载个人资料（降级方案）');
                        loadLocation = 'localStorage';
                    }
                } catch (lsError) {
                    console.error('❌ localStorage 读取失败:', lsError);
                }
            }
            
            console.log('加载个人资料:', savedProfile, '来源:', loadLocation);
            
            // 更新缓存
            cachedPersonalProfile = savedProfile;
            console.log('个人资料缓存已更新:', cachedPersonalProfile);
            
            // 设置头像
            const avatarImg = document.getElementById('profileAvatar');
            if (savedProfile.avatar && savedProfile.avatar !== '' && savedProfile.avatar !== 'undefined') {
                console.log('设置头像:', savedProfile.avatar);
                avatarImg.src = savedProfile.avatar;
            } else {
                console.log('使用默认头像');
                avatarImg.src = 'https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=cartoon%20avatar%20of%20a%20user%2C%20cute%2C%20simple%20style&image_size=square';
            }
            
            // 设置基本信息
            document.getElementById('profileNickname').value = savedProfile.nickname || '';
            document.getElementById('profileWeixinId').value = savedProfile.weixinId || savedProfile.wechatId || '';
            document.getElementById('profileGender').value = savedProfile.gender || '';
            
            // 设置个人人设
            document.getElementById('profileBio').value = savedProfile.bio || '';
            document.getElementById('profileInterests').value = savedProfile.interests || '';
            document.getElementById('profileTags').value = savedProfile.tags || '';
        }

        // 选择个人头像
        function selectPersonalAvatar() {
            document.getElementById('profileAvatarInput').click();
        }

        // 处理头像变化
        function handlePersonalAvatarChange(input) {
            const file = input.files[0];
            if (file) {
                console.log('选择头像文件:', file.name);
                const reader = new FileReader();
                reader.onload = function(e) {
                    const imageData = e.target.result;
                    console.log('头像文件读取完成，大小:', imageData.length);
                    // 压缩头像
                    compressImage(imageData, function(compressedData) {
                        console.log('头像压缩完成');
                        document.getElementById('profileAvatar').src = compressedData;
                    });
                };
                reader.onerror = function(e) {
                    console.error('头像文件读取失败:', e);
                };
                reader.readAsDataURL(file);
            } else {
                console.log('没有选择文件');
            }
        }

        // 保存个人资料
        async function savePersonalProfile() {
            try {
                // 【防闪退】显示保存中状态
                const saveBtn = document.querySelector('.profile-save-btn');
                if (saveBtn) {
                    saveBtn.textContent = '保存中...';
                    saveBtn.disabled = true;
                }

                // 【防闪退】让出主线程，避免UI卡顿
                await new Promise(resolve => setTimeout(resolve, 50));

                const profile = {
                    avatar: document.getElementById('profileAvatar').src,
                    nickname: document.getElementById('profileNickname').value.trim(),
                    weixinId: document.getElementById('profileWeixinId').value.trim(),
                    gender: document.getElementById('profileGender').value,
                    bio: document.getElementById('profileBio').value.trim(),
                    interests: document.getElementById('profileInterests').value.trim(),
                    tags: document.getElementById('profileTags').value.trim(),
                    updateTime: new Date().toISOString()
                };

                console.log('保存个人资料:', profile);

                // 【防闪退】验证头像数据，限制为200KB
                if (profile.avatar && profile.avatar.length > 200000) {
                    alert('头像图片过大，请重新选择较小的图片（建议小于100KB）');
                    if (saveBtn) {
                        saveBtn.textContent = '保存设置';
                        saveBtn.disabled = false;
                    }
                    return;
                }

                // 【优先使用 SQLite】检查 SQLite 是否可用
                let saveSuccess = false;
                let saveLocation = '';
                
                // 首先尝试保存到 localforage（最可靠的方式）
                if (typeof localforage !== 'undefined') {
                    try {
                        await localforage.setItem('personalProfile', profile);
                        console.log('✅ 使用 localforage 保存个人资料成功');
                        saveSuccess = true;
                        saveLocation = 'localforage';
                    } catch (lfError) {
                        console.error('❌ localforage 保存失败:', lfError);
                    }
                }
                
                // 然后尝试保存到 SQLite
                if (SQLiteManager.isAvailable) {
                    try {
                        const sqliteSuccess = await SQLiteManager.savePersonalProfile(profile);
                        if (sqliteSuccess) {
                            console.log('✅ 使用 SQLite 保存个人资料成功');
                            saveLocation = saveLocation ? 'both' : 'sqlite';
                        }
                    } catch (sqliteError) {
                        console.error('❌ SQLite 保存失败:', sqliteError);
                    }
                }
                
                // 最后降级到 localStorage
                if (!saveSuccess) {
                    try {
                        localStorage.setItem('personalProfile', JSON.stringify(profile));
                        console.log('✅ 使用 localStorage 保存个人资料成功（降级方案）');
                        saveSuccess = true;
                        saveLocation = 'localStorage';
                    } catch (lsError) {
                        console.error('❌ localStorage 保存失败:', lsError);
                    }
                }
                
                console.log('个人资料保存位置:', saveLocation);

                // 【防闪退】让出主线程
                await new Promise(resolve => setTimeout(resolve, 50));

                // 更新缓存的个人资料
                cachedPersonalProfile = profile;
                console.log('个人资料缓存已更新:', cachedPersonalProfile);
                
                // 同时更新 relationshipData 中的个人资料
                if (!relationshipData) {
                    relationshipData = {};
                }
                relationshipData.personalProfile = profile;
                
                // 【修复】立即更新头像显示
                const avatarImg = document.getElementById('profileAvatar');
                if (profile.avatar && profile.avatar !== '' && profile.avatar !== 'undefined') {
                    avatarImg.src = profile.avatar;
                    console.log('✅ 头像已更新:', profile.avatar);
                }

                // 【防闪退】延迟执行聊天数据更新，避免影响当前保存流程
                setTimeout(() => {
                    try {
                        updateUserProfileInChats(profile);
                    } catch (updateError) {
                        console.error('更新聊天数据时出错:', updateError);
                        // 不影响个人资料保存的成功提示
                    }
                }, 1000);

                // 【防闪退】恢复按钮状态
                if (saveBtn) {
                    saveBtn.textContent = '保存设置';
                    saveBtn.disabled = false;
                }

                alert('个人资料保存成功！');
                
                // 刷新"我的"界面显示
                await renderWechatMeView();
                
                closePersonalProfile();

            } catch (error) {
                console.error('保存个人资料失败:', error);
                alert(`保存个人资料失败: ${error.message}`);

                // 【防闪退】恢复按钮状态
                const saveBtn = document.querySelector('.profile-save-btn');
                if (saveBtn) {
                    saveBtn.textContent = '保存设置';
                    saveBtn.disabled = false;
                }
            }
        }

