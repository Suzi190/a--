        // 处理AI朋友圈封面选择
        // 【防闪退】处理AI朋友圈封面选择
        async function handleAIMomentsCoverSelect(event) {
            const file = event.target.files[0];
            if (!file) return;
            
            // 【防闪退】检查文件大小（最大10MB）
            const MAX_FILE_SIZE = 10 * 1024 * 1024;
            if (file.size > MAX_FILE_SIZE) {
                showCustomAlert('错误', '图片太大，请选择10MB以下的图片', 'alert');
                event.target.value = '';
                return;
            }
            
            if (!currentAIProfileId) return;
            
            const aiChat = relationshipData.wechatChatList.find(chat => chat.id === currentAIProfileId);
            if (!aiChat) return;
            
            // 【防闪退】显示加载状态
            const coverBg = document.getElementById('aiMomentsCoverBg');
            const originalBg = coverBg.style.backgroundImage;
            coverBg.style.opacity = '0.5';
            
            try {
                console.log('【封面调试】开始处理文件:', file.name, file.size);
                
                // 【防闪退】让出主线程
                await new Promise(resolve => setTimeout(resolve, 50));
                
                // 将File转换为Base64
                const base64 = await fileToBase64(file);
                console.log('【封面调试】转换为Base64成功，长度:', base64.length);
                
                // 【防闪退】让出主线程
                await new Promise(resolve => setTimeout(resolve, 50));
                
                // 创建图片对象进行压缩
                const img = new Image();
                
                // 【防闪退】设置超时
                const loadTimeout = setTimeout(() => {
                    console.error('【封面调试】图片加载超时');
                    coverBg.style.opacity = '1';
                    showCustomAlert('错误', '图片处理超时，请重试', 'alert');
                }, 10000);
                
                img.onload = async function() {
                    clearTimeout(loadTimeout);
                    console.log('【封面调试】图片加载成功，尺寸:', img.width, 'x', img.height);
                    
                    // 【防闪退】限制最大尺寸
                    let width = img.width;
                    let height = img.height;
                    const maxWidth = 800;
                    const maxHeight = 800;
                    
                    if (width > maxWidth || height > maxHeight) {
                        const ratio = Math.min(maxWidth / width, maxHeight / height);
                        width = Math.floor(width * ratio);
                        height = Math.floor(height * ratio);
                    }
                    
                    // 【防闪退】让出主线程
                    await new Promise(resolve => setTimeout(resolve, 50));
                    
                    // 创建canvas进行压缩
                    const canvas = document.createElement('canvas');
                    canvas.width = width;
                    canvas.height = height;
                    const ctx = canvas.getContext('2d');
                    
                    // 【防闪退】使用try-catch
                    try {
                        ctx.drawImage(img, 0, 0, width, height);
                        
                        // 转换为压缩后的base64
                        const compressedBase64 = canvas.toDataURL('image/jpeg', 0.7);
                        console.log('【封面调试】压缩后长度:', compressedBase64.length);
                        
                        // 【防闪退】检查压缩后大小（最大2MB）
                        if (compressedBase64.length > 2 * 1024 * 1024) {
                            coverBg.style.opacity = '1';
                            showCustomAlert('错误', '图片压缩后仍然太大，请选择更小的图片', 'alert');
                            return;
                        }
                        
                        // 【防闪退】让出主线程
                        await new Promise(resolve => setTimeout(resolve, 50));
                        
                        // 保存到AI数据
                        aiChat.momentsCover = compressedBase64;
                        await saveData();
                        console.log('【封面调试】保存成功');
                        
                        // 更新显示
                        coverBg.style.backgroundImage = `url(${compressedBase64})`;
                        coverBg.style.backgroundColor = '';
                        coverBg.style.opacity = '1';
                        console.log('【封面调试】界面更新成功');
                        
                        showCustomAlert('成功', '封面更换成功', 'alert');
                    } catch (drawError) {
                        console.error('【封面调试】Canvas绘制失败:', drawError);
                        coverBg.style.opacity = '1';
                        showCustomAlert('错误', '图片处理失败，请重试', 'alert');
                    }
                };
                
                img.onerror = function() {
                    clearTimeout(loadTimeout);
                    coverBg.style.opacity = '1';
                    console.error('【封面调试】图片加载失败');
                    showCustomAlert('错误', '图片处理失败，请重试', 'alert');
                };
                
                img.src = base64;
            } catch (error) {
                coverBg.style.opacity = '1';
                console.error('【封面调试】更换封面失败:', error);
                showCustomAlert('错误', '更换封面失败，请重试', 'alert');
            }
            
            // 清空文件输入框
            event.target.value = '';
        }

        // 将File转换为Base64
        function fileToBase64(file) {
            return new Promise((resolve, reject) => {
                const reader = new FileReader();
                reader.onload = (e) => resolve(e.target.result);
                reader.onerror = (e) => reject(e);
                reader.readAsDataURL(file);
            });
        }

