                // 20. 迁移 IndexedDB 图片数据
                console.log('【数据迁移】迁移图片数据...');
                migrationToast.innerHTML = '<div>📦 正在迁移图片数据...</div>';
                try {
                    const images = await ChatMessageManager.getAllImagesFromIndexedDB();
                    if (images && images.length > 0) {
                        for (const img of images) {
                            await SQLiteManager.saveRelationshipData(`img_${img.id}`, img);
                        }
                        migratedCount += images.length;
