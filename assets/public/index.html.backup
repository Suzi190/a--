                    if (Object.keys(honorWallData).length > 0) {
                        await SQLiteManager.saveHonorWall(honorWallData);
                        migratedCount++;
                        console.log('【数据迁移】荣誉墙迁移完成');
                    }
                } catch (e) {
                    console.warn('【数据迁移】荣誉墙迁移失败:', e);
                }
                
                // 14. 迁移简易日记数据（使用专用表）
                console.log('【数据迁移】迁移简易日记...');
                migrationToast.innerHTML = '<div>📦 正在迁移简易日记...</div>';
                try {
                    const simpleDiaryData = await localforage.getItem('simpleDiaryData_v1') || {};
                    if (Object.keys(simpleDiaryData).length > 0) {
                        await SQLiteManager.saveMyDiaryContents(simpleDiaryData);
                        migratedCount++;
                        console.log('【数据迁移】简易日记迁移完成');
                    }
                    // 同时迁移 myDiaryContents
                    const myDiaryContents = await localforage.getItem('myDiaryContents');
                    if (myDiaryContents) {
                        await SQLiteManager.saveMyDiaryContents(myDiaryContents);
                        migratedCount++;
                        console.log('【数据迁移】我的日记内容迁移完成');
                    }
                } catch (e) {
                    console.warn('【数据迁移】简易日记迁移失败:', e);
                }
                
                // 15. 迁移 CSS 预设和自定义样式（使用专用表）
                console.log('【数据迁移】迁移 CSS 设置...');
                migrationToast.innerHTML = '<div>📦 正在迁移 CSS 设置...</div>';
                try {
                    const cssPresets = await localforage.getItem('css_presets') || [];
                    if (cssPresets.length > 0) {
                        await SQLiteManager.saveCssPresets(cssPresets);
                        migratedCount++;
                    }
                    const globalCustomCss = await localforage.getItem('global_custom_css');
                    if (globalCustomCss) {
                        await SQLiteManager.saveApiSetting('global_custom_css', globalCustomCss);
                        migratedCount++;
                    }
                    console.log('【数据迁移】CSS 设置迁移完成');
                } catch (e) {
                    console.warn('【数据迁移】CSS 设置迁移失败:', e);
                }
                
                // 16. 迁移备忘录数据（使用专用表）
                console.log('【数据迁移】迁移备忘录...');
                migrationToast.innerHTML = '<div>📦 正在迁移备忘录...</div>';
                try {
                    const memoKeys = [
                        'memo_houseRules', 'memo_bg', 'memo_bg_image', 'memo_media',
                        'memo_media_type', 'memo_violations', 'memo_todayMemos',
                        'memo_lastDate', 'memo_guardian'
                    ];
                    for (const key of memoKeys) {
                        const data = await localforage.getItem(key);
                        if (data !== null) {
                            await SQLiteManager.saveMemoData(key, data);
                            migratedCount++;
                            console.log('【数据迁移】', key, '迁移完成');
                        }
                    }
                    console.log('【数据迁移】备忘录数据迁移完成');
                } catch (e) {
                    console.warn('【数据迁移】备忘录迁移失败:', e);
                }
                
                // 17. 迁移次要 API 模型（使用专用表）
                console.log('【数据迁移】迁移次要 API 模型...');
                migrationToast.innerHTML = '<div>📦 正在迁移次要 API 模型...</div>';
                try {
                    const secondaryApiModels = await localforage.getItem('secondaryApiModels');
                    if (secondaryApiModels) {
                        await SQLiteManager.saveApiSetting('secondaryApiModels', secondaryApiModels);
                        migratedCount++;
                        console.log('【数据迁移】次要 API 模型迁移完成');
                    }
                } catch (e) {
                    console.warn('【数据迁移】次要 API 模型迁移失败:', e);
