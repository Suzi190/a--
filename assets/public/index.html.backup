            try {
                if (SQLiteManager.isAvailable) {
                    const success = await SQLiteManager.saveMemoData(key, value);
                    if (success) {
                        console.log(`✅ 备忘录 ${key} 已保存到 SQLite`);
                        return true;
                    }
                }
                await localforage.setItem(key, value);
                console.log(`✅ 备忘录 ${key} 已保存到 localforage（降级方案）`);
                return true;
            } catch (error) {
                console.error(`❌ 保存备忘录 ${key} 失败:`, error);
                return false;
            }
        }
        
