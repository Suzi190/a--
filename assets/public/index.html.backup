        <!-- 倒计时显示 -->
        <div id="blackRoomTimer" style="position: absolute; top: 30%; left: 50%; transform: translateX(-50%); font-size: 48px; color: #ff0000; font-family: 'Courier New', monospace; font-weight: bold; text-shadow: 0 0 10px #ff0000; pointer-events: none;">
            ∞
        </div>

        <!-- 对话区域 -->
        <div id="blackRoomChat" style="position: absolute; top: 45%; left: 50%; transform: translateX(-50%); width: 90%; max-width: 400px; max-height: 30%; overflow-y: auto; padding: 10px; pointer-events: auto; touch-action: pan-y; -webkit-overflow-scrolling: touch;">
            <!-- 对话消息会显示在这里 -->
        </div>

        <!-- 输入框区域 -->
        <div id="blackRoomInputArea" style="position: absolute; bottom: 120px; left: 50%; transform: translateX(-50%); width: 90%; max-width: 400px; display: flex; gap: 10px; pointer-events: auto; z-index: 100000; touch-action: auto;">
            <input type="text" id="blackRoomInput" placeholder="说点什么..." style="flex: 1; padding: 12px; background: rgba(26,26,26,0.9); border: 1px solid #333; border-radius: 20px; color: #fff; font-size: 14px; outline: none; pointer-events: auto; -webkit-user-select: auto; user-select: auto; touch-action: auto;">
            <button id="blackRoomSendBtn" style="padding: 12px 20px; background: #ff0000; border: none; border-radius: 20px; color: #fff; font-size: 14px; cursor: pointer; pointer-events: auto; touch-action: auto;">发送</button>
        </div>

        <!-- 正在输入中提示 -->
        <div id="blackRoomTyping" style="display: none; position: absolute; bottom: 165px; left: 50%; transform: translateX(-50%); color: #666; font-size: 12px; pointer-events: none;">
            对方正在输入中...
        </div>

        <!-- 小老鼠图标（隐藏出口） -->
        <img id="blackRoomMouse" src="https://s41.ax1x.com/2026/02/02/pZ4T4XT.png" style="position: absolute; bottom: 20px; right: 20px; width: 80px; height: 80px; cursor: pointer; opacity: 0.4; transition: opacity 0.3s; user-select: none; object-fit: contain; pointer-events: auto; z-index: 100001; touch-action: auto;">
    </div>

    <!-- 小黑屋暗号输入弹窗 -->
    <div id="blackRoomCodeModal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.9); z-index: 100000; justify-content: center; align-items: center;">
        <div style="background: #1a1a1a; padding: 30px; border-radius: 15px; border: 1px solid #333; width: 90%; max-width: 350px; text-align: center;">
            <div style="font-size: 40px; margin-bottom: 15px;">🐭</div>
            <div style="color: #fff; font-size: 16px; margin-bottom: 20px;">给看守的老鼠什么好处？</div>
            <input type="text" id="blackRoomCodeInput" placeholder="输入暗号..." style="width: 100%; padding: 12px; background: #000; border: 1px solid #333; border-radius: 8px; color: #fff; font-size: 14px; margin-bottom: 15px; box-sizing: border-box;">
            <div style="display: flex; gap: 10px;">
                <button onclick="closeBlackRoomCodeModal()" style="flex: 1; padding: 12px; background: #333; border: none; border-radius: 8px; color: #fff; cursor: pointer;">取消</button>
