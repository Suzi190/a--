        }

        // 打开备忘录页面
        async function openMemo() {
            console.log('打开备忘录');
            const memoPage = document.getElementById('memoPage');
            if (memoPage) {
                memoPage.classList.add('show');
                // 加载备忘录数据
                await loadMemoData();
                // 加载各模块背景
                await loadAllMemoModuleBgs();
            }
        }

        // 关闭备忘录页面
        function closeMemoPage() {
            const memoPage = document.getElementById('memoPage');
            if (memoPage) {
                memoPage.classList.remove('show');
            }
        }

        // 加载备忘录数据
        async function loadMemoData() {
            try {
                // 加载家规
                const houseRules = await loadMemoDataUnified('memo_houseRules') || [
                    '1. 早睡早起',
                    '2. 按时吃饭'
                ];
                updateHouseRulesPreview(houseRules);

                // 加载背景图片（优先）
                const memoBgImage = await loadMemoDataUnified('memo_bg_image');
                if (memoBgImage) {
                    const bgImage = document.getElementById('memoBgImage');
                    const bgText = document.getElementById('memoBgText');
                    const bgCard = document.getElementById('memoBgCard');
                    bgImage.src = memoBgImage;
                    bgImage.style.display = 'block';
                    bgText.style.display = 'none';
                    bgCard.style.background = 'transparent';
                } else {
                    // 加载渐变背景（兼容旧数据）
                    const memoBg = await loadMemoDataUnified('memo_bg');
                    if (memoBg) {
                        document.getElementById('memoBgCard').style.background = memoBg;
                        document.getElementById('memoBgText').style.display = 'none';
                    }
                }

                // 加载媒体
                const memoMedia = await loadMemoDataUnified('memo_media');
                const memoMediaType = await loadMemoDataUnified('memo_media_type') || 'image';
                if (memoMedia) {
                    const imgContent = document.getElementById('memoMediaContent');
                    const videoContent = document.getElementById('memoVideoContent');
                    const mediaPlaceholder = document.getElementById('memoMediaPlaceholder');
                    
                    // 隐藏所有媒体
                    imgContent.style.display = 'none';
                    videoContent.style.display = 'none';
                    
                    if (memoMediaType === 'video') {
                        // 视频文件
                        videoContent.src = memoMedia;
                        videoContent.style.display = 'block';
                        videoContent.play().catch(e => console.log('视频自动播放被阻止:', e));
                    } else {
                        // 图片文件
                        imgContent.src = memoMedia;
                        imgContent.style.display = 'block';
                    }
                    mediaPlaceholder.style.display = 'none';
                }

                // 加载违规记录
                violations = await loadMemoDataUnified('memo_violations') || [];
                updateViolationsList(violations);

                // 加载今日备忘（检查是否需要清空）
                await checkAndClearTodayMemos();

                // 加载监护人
                loadGuardian();

            } catch (error) {
                console.error('加载备忘录数据失败:', error);
            }
        }

        // 更新家规预览
        function updateHouseRulesPreview(rules) {
            houseRules = rules;
            const container = document.getElementById('houseRulesPreview');
            if (rules.length === 0) {
                container.innerHTML = '<div class="house-rule-item">暂无家规，点击+添加</div>';
            } else {
                container.innerHTML = rules.map((rule, index) => 
                    `<div class="house-rule-item" onclick="toggleHouseRuleDelete(this, ${index})">${index + 1}. ${rule}<span class="house-rule-delete" onclick="deleteHouseRule(event, ${index})">✕</span></div>`
                ).join('');
            }
        }

        // 添加家规
        async function addHouseRule(event) {
            event.stopPropagation();
            const rule = prompt('请输入新的家规：');
            if (rule && rule.trim()) {
                houseRules.push(rule.trim());
                await saveMemoDataUnified('memo_houseRules', houseRules);
                updateHouseRulesPreview(houseRules);
            }
        }

        // 切换家规删除按钮显示
        function toggleHouseRuleDelete(element, index) {
            // 移除其他项的删除显示
            document.querySelectorAll('.house-rule-item').forEach(item => {
                if (item !== element) {
                    item.classList.remove('show-delete');
                }
            });
            // 切换当前项
            element.classList.toggle('show-delete');
        }

        // 删除家规
        async function deleteHouseRule(event, index) {
            event.stopPropagation();
            houseRules.splice(index, 1);
            await saveMemoDataUnified('memo_houseRules', houseRules);
            updateHouseRulesPreview(houseRules);
        }

        // 更新违规记录列表
        function updateViolationsList(violations) {
            const container = document.getElementById('violationsList');
            const countEl = document.getElementById('violationCount');
            countEl.textContent = violations.length;

            if (violations.length === 0) {
                container.innerHTML = '<div class="violation-empty">暂无违规记录</div>';
            } else {
                container.innerHTML = violations.map(v =>
                    `<div class="violation-item">${v.date}: ${v.reason}</div>`
                ).join('');
            }
        }

        // 检查是否需要清空备忘录（新的一天）
        async function checkAndClearTodayMemos() {
            try {
                const lastDate = await loadMemoDataUnified('memo_today_date');
                const today = new Date().toDateString();
                
                if (lastDate !== today) {
                    // 新的一天，清空备忘录
                    todayMemos = [];
                    nextMemoId = 1;
                    await saveMemoDataUnified('memo_today', todayMemos);
                    await saveMemoDataUnified('memo_today_date', today);
                    await saveMemoDataUnified('memo_today_nextId', nextMemoId);
                    console.log('新的一天，已清空昨日备忘录');
                } else {
                    // 同一天，加载现有数据
                    todayMemos = await loadMemoDataUnified('memo_today') || [];
                    nextMemoId = await loadMemoDataUnified('memo_today_nextId') || 1;
                }
                updateTodayMemoList(todayMemos);
            } catch (error) {
                console.error('检查备忘录日期失败:', error);
            }
        }

        // 更新今日备忘列表
        function updateTodayMemoList(memos) {
            todayMemos = memos;
            const container = document.getElementById('todayMemoList');
            const countEl = document.getElementById('todayMemoCount');
            const uncheckedCount = memos.filter(m => !m.checked).length;
            countEl.textContent = uncheckedCount;

            if (memos.length === 0) {
                container.innerHTML = '<div style="color: #999; text-align: center; padding: 20px;">暂无备忘，点击+添加</div>';
            } else {
                container.innerHTML = memos.map(memo => `
                    <div class="memo-item">
                        <input type="checkbox" class="memo-checkbox" id="memo${memo.id}" 
                            ${memo.checked ? 'checked' : ''} onchange="toggleMemo(${memo.id})">
                        <label for="memo${memo.id}" class="memo-item-text">${memo.text}</label>
                    </div>
                `).join('');
            }
        }

        // 添加今日备忘
        async function addTodayMemo(event) {
            event.stopPropagation();
            const text = prompt('请输入今日备忘：');
            if (text && text.trim()) {
                const newMemo = {
                    id: nextMemoId++,
                    text: text.trim(),
                    checked: false
                };
                todayMemos.push(newMemo);
                await saveMemoDataUnified('memo_today', todayMemos);
                await saveMemoDataUnified('memo_today_nextId', nextMemoId);
                await saveMemoDataUnified('memo_today_date', new Date().toDateString());
                updateTodayMemoList(todayMemos);
            }
        }

        // 切换备忘状态
        async function toggleMemo(id) {
            try {
                const memo = todayMemos.find(m => m.id === id);
                if (memo) {
                    memo.checked = !memo.checked;
                    await saveMemoDataUnified('memo_today', todayMemos);
                    updateTodayMemoList(todayMemos);
                }
            } catch (error) {
                console.error('更新备忘状态失败:', error);
            }
        }

        // 更换备忘录背景 - 打开文件选择器
        function changeMemoBg() {
            document.getElementById('memoBgInput').click();
        }

        // 上传备忘录背景图片
        async function uploadMemoBg(input) {
            if (input.files && input.files[0]) {
                const file = input.files[0];
                
                // 检查文件大小（限制为5MB）
                if (file.size > 5 * 1024 * 1024) {
                    alert('图片大小不能超过5MB');
                    return;
                }
                
                const reader = new FileReader();
                reader.onload = async function(e) {
                    try {
                        const dataUrl = e.target.result;
                        const bgImage = document.getElementById('memoBgImage');
                        const bgText = document.getElementById('memoBgText');
                        const bgCard = document.getElementById('memoBgCard');
                        
                        // 显示图片，隐藏文字和渐变背景
                        bgImage.src = dataUrl;
                        bgImage.style.display = 'block';
                        bgText.style.display = 'none';
                        bgCard.style.background = 'transparent';
                        
                        // 保存背景图片
                        await saveMemoDataUnified('memo_bg_image', dataUrl);
                        await localforage.removeItem('memo_bg'); // 移除旧的渐变背景
                        
                        console.log('背景图片已保存');
                    } catch (error) {
                        console.error('保存背景图片失败:', error);
                        alert('保存失败，请重试');
                    }
                };
                reader.readAsDataURL(file);
            }
            // 清空input，允许重复选择同一文件
            input.value = '';
        }

        // 更换备忘录媒体
        async function changeMemoMedia() {
            const input = document.createElement('input');
            input.type = 'file';
            input.accept = 'image/*,image/gif,video/*';
            input.onchange = async function(e) {
                const file = e.target.files[0];
                if (!file) return;
                
                // 检查文件大小（限制为20MB）
                if (file.size > 20 * 1024 * 1024) {
                    alert('文件大小不能超过20MB');
                    return;
                }
                
                const isVideo = file.type.startsWith('video/');
                const reader = new FileReader();
                reader.onload = async function(event) {
                    const dataUrl = event.target.result;
                    const imgContent = document.getElementById('memoMediaContent');
                    const videoContent = document.getElementById('memoVideoContent');
                    const mediaPlaceholder = document.getElementById('memoMediaPlaceholder');
                    
                    // 隐藏所有媒体
                    imgContent.style.display = 'none';
                    videoContent.style.display = 'none';
                    
                    if (isVideo) {
                        // 视频文件
                        videoContent.src = dataUrl;
                        videoContent.style.display = 'block';
                        videoContent.play().catch(e => console.log('视频自动播放被阻止:', e));
                        // 保存媒体类型信息
                        await saveMemoDataUnified('memo_media_type', 'video');
                    } else {
                        // 图片文件
                        imgContent.src = dataUrl;
                        imgContent.style.display = 'block';
                        await saveMemoDataUnified('memo_media_type', 'image');
                    }
                    mediaPlaceholder.style.display = 'none';
                    
                    // 保存媒体
                    await saveMemoDataUnified('memo_media', dataUrl);
                };
                reader.readAsDataURL(file);
            };
            input.click();
        }

        // 打开家规管理
