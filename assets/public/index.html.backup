                    { title: '装修风格流行趋势', source: '家居', time: '1小时前', image: 'https://images.unsplash.com/photo-1616486338812-3dadae4b4ace?w=200&h=140&fit=crop' }
                ],
                // 音乐
                'music': [
                    { title: '热门歌曲排行榜', source: '音乐', time: '10分钟前', image: 'https://images.unsplash.com/photo-1493225457124-a3eb161ffa5f?w=200&h=140&fit=crop' },
                    { title: '歌手新专辑发布', source: '音乐', time: '30分钟前', image: 'https://images.unsplash.com/photo-1514320291840-2e0a9bf2a9ae?w=200&h=140&fit=crop' },
                    { title: '演唱会行程公布', source: '演出', time: '1小时前', image: 'https://images.unsplash.com/photo-1459749411175-04bf5292ceea?w=200&h=140&fit=crop' }
                ],
                // 动漫
                'anime': [
                    { title: '新番动漫开播时间表', source: '动漫', time: '10分钟前', image: 'https://images.unsplash.com/photo-1547700055-b61cacebece9?w=200&h=140&fit=crop' },
                    { title: '手办周边新品预定', source: '手办', time: '30分钟前', image: 'https://images.unsplash.com/photo-1566577739112-5180d4bf9390?w=200&h=140&fit=crop' },
                    { title: 'COSPLAY作品精选', source: 'COS', time: '1小时前', image: 'https://images.unsplash.com/photo-1535581652167-3d6b98c7a699?w=200&h=140&fit=crop' }
                ]
            };
            
            return backupNews[category] || backupNews['hot'];
        };

        // 执行搜索
        window.weiboDoSearch = function() {
            const keyword = document.getElementById('weiboKeywordInput').value.trim();
            if (keyword) {
                weiboCloseCategoryModal();
                
                // 显示搜索结果
                document.getElementById('weiboHeaderTitle').textContent = '搜索: ' + keyword;
                
                const hotList = document.getElementById('weiboHotList');
                const newsList = document.getElementById('weiboNewsList');
                
                hotList.innerHTML = '<div class="weibo-loading"><div class="weibo-loading-spinner"></div></div>';
                newsList.innerHTML = '<div class="weibo-loading"><div class="weibo-loading-spinner"></div></div>';
                
                // 搜索内容
                weiboSearchContent(keyword);
            }
        };

        // 搜索内容
        window.weiboSearchContent = async function(keyword) {
            const hotData = await weiboSearchHotFromAPI(keyword);
            const newsData = await weiboSearchNewsFromAPI(keyword);
            
            if (hotData && hotData.length > 0) {
                weiboHotData = hotData;
            } else {
                weiboHotData = [{ rank: 1, title: '未找到相关热点', heat: '', tag: '', num: '' }];
            }
            weiboRenderHotSearch();
            
            if (newsData && newsData.length > 0) {
                weiboNewsData = newsData;
            } else {
                weiboNewsData = [{ title: '未找到相关新闻', source: '搜索结果', time: '刚刚', image: '' }];
            }
            weiboRenderNews();
        };

        // 刷新消息列表（显示NPC私信）
        window.weiboRefreshMessageList = async function() {
            const messageList = document.getElementById('weiboMessageList');
            if (!messageList) return;

            // 获取NPC私信
            let npcMessages = await localforage.getItem('weiboNPCMessages') || [];

            // 过滤掉没有头像的默认NPC，添加默认头像
            npcMessages = npcMessages.map(msg => {
                if (!msg.avatar || msg.avatar === '') {
                    const defaultAvatars = ['👩', '👨', '👧', '👦', '🧑', '👱', '👩‍🦰', '👨‍🦱', '👩‍🦳', '🧔'];
                    msg.avatar = defaultAvatars[Math.floor(Math.random() * defaultAvatars.length)];
                }
                return msg;
            });

            // 构建NPC私信列表HTML
            let npcHtml = '';
            if (npcMessages.length > 0) {
                npcHtml = npcMessages.map(msg => {
                    const avatarContent = msg.avatar && msg.avatar.length <= 2 ? msg.avatar :
                        (msg.avatar ? `<img src="${msg.avatar}" style="width: 100%; height: 100%; object-fit: cover; border-radius: 50%;">` : '👤');

                    return `
                        <div class="weibo-message-item" onclick="weiboOpenIdNPCChatBy('${msg.id}')">
                            <div class="weibo-message-avatar">${avatarContent}</div>
                            <div class="weibo-message-content">
                                <div class="weibo-message-title">${msg.npcName || '网友'}</div>
                                <div class="weibo-message-text">${msg.message || msg.content || ''}</div>
                                <div class="weibo-message-time">${msg.time || '刚刚'}</div>
                            </div>
                        </div>
                    `;
                }).join('');
            }

            // 保留系统通知，添加NPC私信在下面
            const systemNotifyHtml = `
                <div class="weibo-message-item">
                    <div class="weibo-message-avatar">🤖</div>
                    <div class="weibo-message-content">
                        <div class="weibo-message-title">系统通知</div>
                        <div class="weibo-message-text">欢迎来到微博！在这里发现新鲜事。</div>
                        <div class="weibo-message-time">刚刚</div>
                    </div>
                </div>
            `;

            messageList.innerHTML = systemNotifyHtml + npcHtml;
        };

        // 通过ID打开NPC聊天
        window.weiboOpenNPCChatById = async function(messageId) {
            const npcMessages = await localforage.getItem('weiboNPCMessages') || [];
            const message = npcMessages.find(m => m.id === messageId);
            if (message) {
                weiboOpenNPCChat(message);
            }
        };

        // 切换消息标签
        window.weiboSwitchMessageTab = function(tab) {
            document.querySelectorAll('.weibo-message-tab').forEach(t => t.classList.remove('active'));
            event.target.classList.add('active');
            // 这里可以加载不同类型的消息
        };

        // 加载个人资料
        window.weiboLoadProfile = async function() {
            // 优先从 personalProfile 读取，与"我的"页面同步
            const personalProfile = await localforage.getItem('personalProfile') || {};
            const savedName = await localforage.getItem('weiboProfileName') || personalProfile.name;
            const savedBio = await localforage.getItem('weiboProfileBio');
            const savedAvatar = await localforage.getItem('weiboProfileAvatar') || personalProfile.avatar;
            const savedFollowers = await localforage.getItem('weiboFollowersCount');
            const savedBgImage = await localforage.getItem('weiboProfileBgImage');
            
            if (savedName) document.getElementById('weiboProfileName').textContent = savedName;
            if (savedBio) document.getElementById('weiboProfileBio').textContent = savedBio;
            
            // 处理头像（emoji或图片）
            const avatarEl = document.getElementById('weiboAvatarImg');
            if (savedAvatar) {
                if (savedAvatar.length <= 2) {
                    // emoji头像
                    avatarEl.style.display = 'none';
                    avatarEl.parentElement.innerHTML = `<div style="font-size: 60px; line-height: 80px;">${savedAvatar}</div>`;
                } else {
                    // 图片头像
                    avatarEl.src = savedAvatar;
                }
            }
            
            // 处理背景图片
            if (savedBgImage) {
                const bgEl = document.querySelector('.weibo-profile-bg');
                if (bgEl) {
                    bgEl.style.background = `url(${savedBgImage}) center/cover no-repeat`;
                }
            }
            
            if (savedFollowers) document.getElementById('weiboStatFollowers').textContent = savedFollowers;
            
            // 更新关注数
            const followList = await localforage.getItem('weiboFollowList') || [];
            document.getElementById('weiboStatFollowing').textContent = followList.length;
            
            // 更新微博数
            const myPosts = await localforage.getItem('weiboMyPosts') || [];
            document.getElementById('weiboStatPosts').textContent = myPosts.length;
        };
        
        // 编辑粉丝数
        window.weiboEditFollowers = async function() {
            const el = document.getElementById('weiboStatFollowers');
            el.focus();
            
            // 保存粉丝数
            el.addEventListener('blur', async function() {
                const count = parseInt(this.textContent) || 0;
                await localforage.setItem('weiboFollowersCount', count);
                console.log('粉丝数已保存:', count);
            }, { once: true });
        };
        
        // 点击关注数跳转到关注页面
        window.weiboEditFollowing = function() {
            weiboSwitchTab('follow');
        };

        // 更换头像
        window.weiboChangeAvatar = function() {
            const input = document.createElement('input');
            input.type = 'file';
            input.accept = 'image/*';
            input.onchange = async function(e) {
                const file = e.target.files[0];
                if (file) {
                    const reader = new FileReader();
                    reader.onload = async function(event) {
                        document.getElementById('weiboAvatarImg').src = event.target.result;
                        await localforage.setItem('weiboProfileAvatar', event.target.result);
                    };
                    reader.readAsDataURL(file);
                }
            };
            input.click();
        };

        // 更换背景图片
        window.weiboChangeBgImage = function() {
            const input = document.createElement('input');
            input.type = 'file';
            input.accept = 'image/*';
            input.onchange = async function(e) {
                const file = e.target.files[0];
                if (file) {
                    const reader = new FileReader();
                    reader.onload = async function(event) {
                        // 设置背景图片
                        const bgEl = document.querySelector('.weibo-profile-bg');
                        if (bgEl) {
                            bgEl.style.background = `url(${event.target.result}) center/cover no-repeat`;
                        }
                        // 保存到localforage
                        await localforage.setItem('weiboProfileBgImage', event.target.result);
                    };
                    reader.readAsDataURL(file);
                }
            };
            input.click();
        };

        // 发现用户
        // 发现用户 - 从微信角色列表获取
        // 加载关注页面
        window.weiboLoadFollowPage = async function() {
            const followList = document.getElementById('weiboFollowList');
            const emptyState = document.querySelector('.weibo-empty-state');
            
            // 获取已关注列表
            const followedList = await localforage.getItem('weiboFollowList') || [];
            
            // 获取微信角色列表
            let wechatContacts = [];
            if (relationshipData.wechatChatList && Array.isArray(relationshipData.wechatChatList)) {
                wechatContacts = relationshipData.wechatChatList;
            }
            
            // 过滤出已关注的联系人（统一转为字符串比较）
            const followedContacts = wechatContacts.filter(c => followedList.map(String).includes(String(c.id)));
            
            if (followedContacts.length === 0 && wechatContacts.length === 0) {
                // 没有联系人，显示空状态
                emptyState.style.display = 'block';
                followList.style.display = 'none';
                return;
            }
            
            // 显示列表
            emptyState.style.display = 'none';
            followList.style.display = 'block';
            followList.innerHTML = '';
            
            // 1. 显示已关注的人
            if (followedContacts.length > 0) {
                followList.innerHTML += '<div style="padding: 12px 16px; color: #666; font-size: 14px; font-weight: 500;">👤 已关注</div>';
                
                // 使用for...of循环以支持async/await
                for (const contact of followedContacts) {
                    const avatarContent = contact.avatar && contact.avatar.length <= 2 ? contact.avatar : 
                        (contact.avatar ? `<img src="${contact.avatar}" style="width: 100%; height: 100%; object-fit: cover;">` : '👤');
                    
                    // 获取AI的粉丝数（使用统一的函数，确保数据一致）
                    const aiStats = await weiboGetAIStats(contact);
                    
                    const item = document.createElement('div');
                    item.className = 'weibo-follow-item';
                    item.style.cssText = 'display: flex; align-items: center; padding: 12px 16px; border-bottom: 1px solid #f0f0f0; background: #fff; cursor: pointer;';
                    item.onclick = function() {
                        weiboOpenAIProfile(contact);
                    };
                    
                    item.innerHTML = `
                        <div class="weibo-follow-avatar" style="width: 50px; height: 50px; border-radius: 50%; overflow: hidden; background: #f0f0f0; display: flex; align-items: center; justify-content: center; margin-right: 12px; flex-shrink: 0;">
                            ${avatarContent}
                        </div>
                        <div class="weibo-follow-info" style="flex: 1; min-width: 0;">
                            <div class="weibo-follow-name" style="font-size: 15px; font-weight: 500; color: #333; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">${contact.remark || contact.name || '微信联系人'}</div>
                            <div class="weibo-follow-desc" style="font-size: 13px; color: #999; margin-top: 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">${contact.description || '来自微信好友'} · 粉丝 ${aiStats.followers}</div>
                        </div>
                        <button class="weibo-follow-btn" style="padding: 6px 16px; border: none; border-radius: 15px; background: #ccc; color: white; font-size: 13px; cursor: default; flex-shrink: 0;">已关注</button>
                    `;
                    
                    followList.appendChild(item);
                }
            }
            
            // 2. 显示发现用户按钮
            const unfollowedContacts = wechatContacts.filter(c => !followedList.map(String).includes(String(c.id)));
            if (unfollowedContacts.length > 0) {
                const discoverBtn = document.createElement('div');
                discoverBtn.style.cssText = 'padding: 20px; text-align: center;';
                discoverBtn.innerHTML = `
                    <button onclick="weiboShowDiscoverList()" style="padding: 12px 40px; background: #ff6b6b; color: white; border: none; border-radius: 25px; font-size: 15px; cursor: pointer; display: flex; align-items: center; gap: 8px; margin: 0 auto;">
                        <span>👥</span>
                        <span>发现用户 (${unfollowedContacts.length})</span>
                    </button>
                    <div style="color: #999; font-size: 12px; margin-top: 8px;">还有 ${unfollowedContacts.length} 位微信好友可以关注</div>
                `;
                followList.appendChild(discoverBtn);
            }
        };

        // 显示发现用户列表
        window.weiboShowDiscoverList = function() {
            const followList = document.getElementById('weiboFollowList');
            
            // 获取微信角色列表
            let wechatContacts = [];
            if (relationshipData.wechatChatList && Array.isArray(relationshipData.wechatChatList)) {
                wechatContacts = relationshipData.wechatChatList;
            }
            
            // 获取已关注列表
            localforage.getItem('weiboFollowList').then(followedList => {
                followedList = followedList || [];
                const unfollowedContacts = wechatContacts.filter(c => !followedList.map(String).includes(String(c.id)));
                
                // 添加标题
                const title = document.createElement('div');
                title.style.cssText = 'padding: 12px 16px; color: #666; font-size: 14px; font-weight: 500; border-top: 8px solid #f5f5f5;';
                title.innerHTML = '👥 可能认识的人 <span style="float: right; cursor: pointer; color: #999;" onclick="weiboLoadFollowPage()">收起</span>';
                followList.appendChild(title);
                
                // 显示未关注的人
                unfollowedContacts.forEach(contact => {
                    const avatarContent = contact.avatar && contact.avatar.length <= 2 ? contact.avatar : 
                        (contact.avatar ? `<img src="${contact.avatar}" style="width: 100%; height: 100%; object-fit: cover;">` : '👤');
                    
                    const item = document.createElement('div');
                    item.className = 'weibo-follow-item';
                    item.style.cssText = 'display: flex; align-items: center; padding: 12px 16px; border-bottom: 1px solid #f0f0f0; background: #fff;';
                    
                    item.innerHTML = `
                        <div class="weibo-follow-avatar" style="width: 50px; height: 50px; border-radius: 50%; overflow: hidden; background: #f0f0f0; display: flex; align-items: center; justify-content: center; margin-right: 12px; flex-shrink: 0;">
                            ${avatarContent}
                        </div>
                        <div class="weibo-follow-info" style="flex: 1; min-width: 0;">
                            <div class="weibo-follow-name" style="font-size: 15px; font-weight: 500; color: #333; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">${contact.remark || contact.name || '微信联系人'}</div>
                            <div class="weibo-follow-desc" style="font-size: 13px; color: #999; margin-top: 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">${contact.description || '来自微信好友'}</div>
                        </div>
                        <button class="weibo-follow-btn" onclick="weiboFollowUser(this, '${contact.id}')" style="padding: 6px 16px; border: none; border-radius: 15px; background: #ff6b6b; color: white; font-size: 13px; cursor: pointer; flex-shrink: 0;">关注</button>
                    `;
                    
                    followList.appendChild(item);
                });
            });
        };

        // 点击发现用户按钮（兼容旧代码）
        window.weiboDiscoverUsers = function() {
            weiboLoadFollowPage();
        };

        // 关注用户
        window.weiboFollowUser = async function(btn, userId) {
            btn.textContent = '已关注';
            btn.style.background = '#ccc';
            btn.disabled = true;
            
            try {
                // 保存关注列表
                let followList = await localforage.getItem('weiboFollowList') || [];
                console.log('当前关注列表:', followList);
                
                // 确保userId是字符串类型
                const userIdStr = String(userId);
                
                if (!followList.includes(userIdStr)) {
                    followList.push(userIdStr);
                    await localforage.setItem('weiboFollowList', followList);
                    console.log('关注成功:', userIdStr, '新列表:', followList);
                } else {
                    console.log('已经关注过了:', userIdStr);
                }
                
                // 立即刷新页面显示
                await weiboLoadFollowPage();
            } catch (error) {
                console.error('关注失败:', error);
                alert('关注失败，请重试');
            }
        };

        // 打开AI个人主页
        window.weiboOpenAIProfile = async function(contact) {
                // 确保AI默认关注我（这会从relationshipData读取或初始化）
                await weiboEnsureAIFollowsUser(contact);
                
                // 创建AI主页
                let profilePage = document.getElementById('weiboAIProfilePage');
                if (!profilePage) {
                    profilePage = document.createElement('div');
                    profilePage.id = 'weiboAIProfilePage';
                    profilePage.style.cssText = 'position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: #f5f5f5; z-index: 10001; display: none; flex-direction: column; overflow: hidden;';
                    document.body.appendChild(profilePage);
                }
                
                // 获取AI的微博统计数据（从relationshipData读取，确保是最新保存的数据）
                const aiStats = await weiboGetAIStats(contact);
                
                // 获取AI的微博列表
                const aiPosts = await weiboGetAIPosts(contact);
                
                const avatarContent = contact.avatar && contact.avatar.length <= 2 ? contact.avatar : 
                    (contact.avatar ? `<img src="${contact.avatar}" style="width: 100%; height: 100%; object-fit: cover; border-radius: 50%;">` : '👤');
                
                profilePage.innerHTML = `
                    <!-- 顶部白色卡片 -->
                    <div style="height: 30px; background: #fff; width: 100%; flex-shrink: 0;"></div>
                    <div style="background: #fff; position: relative;">
                        <!-- 头部 -->
                        <div style="padding: 12px 16px; display: flex; align-items: center; border-bottom: 1px solid #f0f0f0;">
                            <div style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; cursor: pointer;" onclick="weiboCloseAIProfile()">
                                <svg viewBox="0 0 24 24" fill="currentColor" style="width: 24px; height: 24px;">
                                    <path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/>
                                </svg>
                            </div>
                            <div style="flex: 1; text-align: center; font-size: 17px; font-weight: 600;">${contact.remark || contact.name}</div>
                            <div style="width: 40px;"></div>
                        </div>
                        
                        <!-- 个人信息 -->
                        <div style="padding: 20px 16px;">
                            <div style="display: flex; align-items: flex-start;">
                                <div style="width: 80px; height: 80px; border-radius: 50%; overflow: hidden; background: #f0f0f0; display: flex; align-items: center; justify-content: center; font-size: 40px; margin-right: 16px; flex-shrink: 0;">
                                    ${avatarContent}
                                </div>
                                <div style="flex: 1; padding-top: 10px;">
                                    <div style="font-size: 20px; font-weight: 600; color: #333; margin-bottom: 8px;">${contact.remark || contact.name}</div>
                                    <div style="font-size: 14px; color: #666; line-height: 1.5;">${contact.description || '暂无简介'}</div>
                                </div>
                            </div>
                            
                            <!-- 统计数据 -->
                            <div style="display: flex; justify-content: space-around; margin-top: 20px; padding: 15px 0; border-top: 1px solid #f0f0f0;">
                                <div style="text-align: center;">
                                    <div style="font-size: 18px; font-weight: 600; color: #333;">${aiStats.posts}</div>
                                    <div style="font-size: 12px; color: #999; margin-top: 2px;">微博</div>
                                </div>
                                <div style="text-align: center;">
                                    <div style="font-size: 18px; font-weight: 600; color: #333;">${aiStats.following}</div>
                                    <div style="font-size: 12px; color: #999; margin-top: 2px;">关注</div>
                                </div>
                                <div style="text-align: center; cursor: pointer;" onclick="weiboEditAIFollowers('${contact.id}')" title="点击编辑粉丝数">
                                    <div style="font-size: 18px; font-weight: 600; color: #333;" id="weiboAIFollowers_${contact.id}">${aiStats.followers}</div>
                                    <div style="font-size: 12px; color: #999; margin-top: 2px;">粉丝 ✏️</div>
                                </div>
                            </div>
                            
                            <!-- 操作按钮 -->
                            <div style="display: flex; gap: 10px; margin-top: 15px;">
                                <button onclick="weiboChatWithAI('${contact.id}')" style="flex: 1; padding: 10px; background: #ff6b6b; color: #fff; border: none; border-radius: 20px; font-size: 14px; cursor: pointer;">私信</button>
                            </div>
                        </div>
                    </div>
                    
                    <!-- 微博列表 -->
                    <div id="weiboAIPostsList" style="flex: 1; overflow-y: auto; padding: 10px;">
                        ${aiPosts.length > 0 ? aiPosts.map(post => weiboRenderAIPost(post, contact)).join('') : '<div style="text-align: center; padding: 40px; color: #999;">暂无动态</div>'}
                    </div>
                `;
                
                profilePage.style.display = 'flex';
                document.body.style.overflow = 'hidden';
        };

        // 关闭AI主页
        window.weiboCloseAIProfile = function() {
            const profilePage = document.getElementById('weiboAIProfilePage');
            if (profilePage) {
                profilePage.style.display = 'none';
            }
            document.body.style.overflow = '';
        };

        // 确保AI关注我
        window.weiboEnsureAIFollowsUser = async function(contact) {
            // 直接从localforage读取最新的wechatChatList
            const savedChatList = await localforage.getItem('wechatChatList') || [];
            const index = savedChatList.findIndex(c => c.id == contact.id);
            
            if (index !== -1) {
                // 如果保存的数据中已有weiboStats，直接使用
                if (savedChatList[index].weiboStats) {
                    contact.weiboStats = savedChatList[index].weiboStats;
                    // 同时更新relationshipData
                    const relIndex = relationshipData.wechatChatList.findIndex(c => c.id == contact.id);
                    if (relIndex !== -1) {
                        relationshipData.wechatChatList[relIndex].weiboStats = savedChatList[index].weiboStats;
                    }
                    return;
                }
                
                // 如果没有数据，初始化默认值
                contact.weiboStats = {
                    followers: Math.floor(Math.random() * 5000) + 100,
                    following: 1, // 默认关注用户
                    posts: 0
                };
                
                // 保存到localforage
                savedChatList[index].weiboStats = contact.weiboStats;
                await localforage.setItem('wechatChatList', savedChatList);
                
                // 同时更新relationshipData
                const relIndex = relationshipData.wechatChatList.findIndex(c => c.id == contact.id);
                if (relIndex !== -1) {
                    relationshipData.wechatChatList[relIndex].weiboStats = contact.weiboStats;
                }
            }
        };

        // 获取AI的微博统计
        window.weiboGetAIStats = async function(contact) {
            // 直接从localforage读取最新的wechatChatList
            const savedChatList = await localforage.getItem('wechatChatList') || [];
            const index = savedChatList.findIndex(c => c.id == contact.id);
            
            if (index !== -1) {
                // 如果保存的数据中有weiboStats，使用它
                if (savedChatList[index].weiboStats) {
                    // 同时更新relationshipData中的数据，保持同步
                    const relIndex = relationshipData.wechatChatList.findIndex(c => c.id == contact.id);
                    if (relIndex !== -1) {
                        relationshipData.wechatChatList[relIndex].weiboStats = savedChatList[index].weiboStats;
                    }
                    return savedChatList[index].weiboStats;
                }
                
                // 如果没有数据，初始化默认值并保存
                const defaultStats = {
                    followers: Math.floor(Math.random() * 5000) + 100,
                    following: 1,
                    posts: 0
                };
                
                savedChatList[index].weiboStats = defaultStats;
                await localforage.setItem('wechatChatList', savedChatList);
                
                // 同时更新relationshipData
                const relIndex = relationshipData.wechatChatList.findIndex(c => c.id == contact.id);
                if (relIndex !== -1) {
                    relationshipData.wechatChatList[relIndex].weiboStats = defaultStats;
                }
                
                return defaultStats;
            }
            
            // 如果找不到联系人，返回临时数据（不保存）
            return contact.weiboStats || { followers: 0, following: 1, posts: 0 };
        };

        // 获取AI的微博列表（不自动调用API生成）
        window.weiboGetAIPosts = async function(contact) {
            const cacheKey = 'weiboAIPosts_' + contact.id;
            let posts = await localforage.getItem(cacheKey);
            
            // 如果没有缓存，返回空数组，不自动调用API
            // AI只会在聊天时自己决定是否发微博
            if (!posts) {
                posts = [];
            }
            
            return posts;
        };

        // 生成AI动态
        window.weiboGenerateAIPosts = async function(contact) {
            try {
                const savedSettings = await loadAppSettings({});
                const apiUrl = savedSettings.api?.baseUrl || 'https://api.openai.com/v1';
                const apiKey = savedSettings.api?.apiKey || '';
                const model = savedSettings.api?.model || 'gpt-3.5-turbo';
                
                if (!apiKey) {
                    return [];
                }
                
                // 收集上下文
                const contextData = await weiboCollectContextData();
                
                const prompt = `你是${contact.name}，${contact.description || '一个普通用户'}。

请根据你的人设，生成3条微博动态。每条动态包含：
1. content: 动态内容（50-100字，符合你的人设和语气）
2. time: 发布时间（如"刚刚"、"5分钟前"、"1小时前"、"昨天"）
3. likes: 点赞数（10-500之间的随机数）
4. comments: 评论数（5-100之间的随机数）

动态类型可以是：
- 分享日常生活
- 表达观点或感受
- 转发热点并评论
- 与他人互动
- 发布照片/心情

要求：
1. 语气要符合你的人设
2. 内容要真实自然，像真实用户发的微博
3. 使用微博风格，可以有emoji
4. 返回JSON数组格式
5. 示例：[{"content":"今天天气真好，出去散步了🌞","time":"刚刚","likes":23,"comments":5}]`;

                const response = await fetch(`${apiUrl}/chat/completions`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${apiKey}`
                    },
                    body: JSON.stringify({
                        model: model,
                        messages: [
                            { role: 'system', content: '你是一个微博内容生成助手。' },
                            { role: 'user', content: prompt }
                        ],
                        temperature: 0.8,
                        max_tokens: 1000
                    })
                });
                
                if (!response.ok) {
                    throw new Error(`API请求失败: ${response.status}`);
                }
                
                const result = await response.json();
                const content = result.choices[0].message.content;
                
                // 解析JSON
                let posts = [];
                try {
                    const jsonMatch = content.match(/\[[\s\S]*\]/);
                    if (jsonMatch) {
                        posts = JSON.parse(jsonMatch[0]);
                    }
                } catch (e) {
                    console.error('解析AI动态失败:', e);
                }
                
                // 添加元数据
                posts = posts.map((post, index) => ({
                    ...post,
                    id: 'ai_post_' + contact.id + '_' + Date.now() + '_' + index,
                    userId: contact.id,
                    userName: contact.name,
                    userAvatar: contact.avatar,
                    timestamp: Date.now() - (index * 3600000) // 错开时间
                }));
                
                // 保存到缓存
                const cacheKey = 'weiboAIPosts_' + contact.id;
                await localforage.setItem(cacheKey, posts);
                
                // 更新AI的微博数
                if (contact.weiboStats) {
                    contact.weiboStats.posts = posts.length;
                }
                
                return posts;
                
            } catch (error) {
                console.error('生成AI动态失败:', error);
                return [];
            }
        };

        // 渲染AI动态
        window.weiboRenderAIPost = function(post, contact) {
            return `
                <div style="background: #fff; margin-bottom: 10px; padding: 15px; border-radius: 8px;">
                    <div style="display: flex; align-items: center; margin-bottom: 10px;">
                        <div style="width: 40px; height: 40px; border-radius: 50%; overflow: hidden; background: #f0f0f0; display: flex; align-items: center; justify-content: center; margin-right: 10px; font-size: 20px;">
                            ${contact.avatar && contact.avatar.length <= 2 ? contact.avatar : (contact.avatar ? `<img src="${contact.avatar}" style="width: 100%; height: 100%; object-fit: cover;">` : '👤')}
                        </div>
                        <div>
                            <div style="font-size: 15px; font-weight: 500; color: #333;">${contact.name}</div>
                            <div style="font-size: 12px; color: #999;">${post.time || '刚刚'}</div>
                        </div>
                    </div>
                    <div style="font-size: 15px; color: #333; line-height: 1.6; margin-bottom: 12px;">${post.content}</div>
                    <div style="display: flex; gap: 20px; color: #999; font-size: 13px;">
                        <span style="display: flex; align-items: center; gap: 4px;">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="width: 16px; height: 16px;">
                                <path d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
                            </svg>
                            ${post.likes || 0}
                        </span>
                        <span style="display: flex; align-items: center; gap: 4px;">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="width: 16px; height: 16px;">
                                <path d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
                            </svg>
                            ${post.comments || 0}
                        </span>
                    </div>
                </div>
            `;
        };

        // 刷新AI动态
        window.weiboRefreshAIPosts = async function(contactId) {
            const contact = relationshipData.wechatChatList.find(c => c.id == contactId);
            if (!contact) return;
            
            // 清除缓存，重新生成
            const cacheKey = 'weiboAIPosts_' + contactId;
            await localforage.removeItem(cacheKey);
            
            // 重新加载页面
            weiboOpenAIProfile(contact);
        };

        // 与AI私信 - 微博风格私信界面
        window.weiboChatWithAI = function(contactId) {
            const contact = relationshipData.wechatChatList.find(c => c.id == contactId);
            if (!contact) {
                alert('无法打开聊天，联系人不存在');
                return;
            }

            // 创建微博风格私信界面
            let dmPage = document.getElementById('weiboDMPage');
            if (!dmPage) {
                dmPage = document.createElement('div');
                dmPage.id = 'weiboDMPage';
                document.body.appendChild(dmPage);
            }

            const avatarContent = contact.avatar && contact.avatar.length <= 2 ? contact.avatar :
                (contact.avatar ? `<img src="${contact.avatar}" style="width: 100%; height: 100%; object-fit: cover; border-radius: 50%;">` : '👤');

            dmPage.innerHTML = `
                <style>
                    #weiboDMPage {
                        position: fixed;
                        top: 0;
                        left: 0;
                        right: 0;
                        bottom: 0;
                        background: #f5f5f5;
                        z-index: 10002;
