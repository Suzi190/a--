        // 保存烹饪设置
        async function saveRecipeMenuInfo() {
            const ingredients = document.getElementById('recipeIngredients').value.trim();
            const appliances = document.getElementById('recipeAppliances').value.trim();
            const goals = document.getElementById('recipeGoals').value.trim();
            const situation = document.getElementById('recipeSituation').value.trim();
            
            await localforage.setItem('recipe_cooking_info', {
                ingredients,
                appliances,
                goals,
                situation
            });
            
            document.querySelector('.recipe-menu-modal').remove();
            showBodyManagerToast('烹饪设置已保存');
        }

