        // 更新小红花显示（支持闪电）
        function updateFlowers(count, lightningCount = 0) {
            const container = document.getElementById('flowerContainer');
            const statusEl = document.getElementById('accountingWeekStatus');
            if (!container) return;

            // 限制最大4个
            count = Math.min(Math.max(count, 0), 4);
            lightningCount = Math.min(Math.max(lightningCount, 0), 4);
            accountingData.weekFlowers = count;
            accountingData.lightningCount = lightningCount;

            // 根据数量设置状态文字（魔丸/灵珠系统）
            let status = '需努力';
            if (lightningCount > 0) {
                // 有闪电显示魔丸等级
                const levels = ['不好', '很不好', '非常不好', '魔丸'];
                status = levels[lightningCount - 1] || '不好';
            } else if (count === 0) {
                status = '需努力';
            } else if (count === 4) {
                status = '灵珠';
            } else {
                status = '良好';
            }

            if (statusEl) {
                statusEl.textContent = status;
            }

            // 生成小红花和闪电
            let html = '';
            // 先显示小红花（使用自定义图片或默认emoji）
            const flowerIcon = window.accountingFlowerIcon;
            for (let i = 0; i < count; i++) {
                if (flowerIcon) {
                    html += '<img src="' + flowerIcon + '" style="width: 24px; height: 24px; object-fit: cover; border-radius: 50%; filter: drop-shadow(0 2px 4px rgba(233, 30, 99, 0.3)); animation: flowerBloom 0.5s ease ' + (i * 0.1) + 's both;">';
                } else {
                    html += '<span style="font-size: 24px; filter: drop-shadow(0 2px 4px rgba(233, 30, 99, 0.3)); animation: flowerBloom 0.5s ease ' + (i * 0.1) + 's both;">🌸</span>';
                }
            }
            // 再显示闪电
            for (let i = 0; i < lightningCount; i++) {
                html += '<span style="font-size: 24px; filter: drop-shadow(0 2px 4px rgba(255, 193, 7, 0.5)); animation: lightningFlash 0.5s ease ' + ((count + i) * 0.1) + 's both;">⚡</span>';
            }

            container.innerHTML = html;

            // 检查是否满4朵花并触发转盘
            if (count === 4 && lightningCount === 0) {
                checkAndTriggerLuckyWheel();
            }
        }

        // 添加小红花和闪电动画样式
        const flowerStyle = document.createElement('style');
        flowerStyle.textContent = `
            @keyframes flowerBloom {
                0% { transform: scale(0) rotate(-180deg); opacity: 0; }
                50% { transform: scale(1.2) rotate(0deg); }
                100% { transform: scale(1) rotate(0deg); opacity: 1; }
            }
            @keyframes lightningFlash {
                0% { transform: scale(0); opacity: 0; }
                50% { transform: scale(1.3); opacity: 1; }
                100% { transform: scale(1); opacity: 1; }
            }
        `;
        document.head.appendChild(flowerStyle);

        // ==================== 预算设置功能 ====================

        // 打开预算设置弹窗
        function openBudgetSettingModal() {
            const modal = document.getElementById('budgetSettingModal');
            const input = document.getElementById('budgetInput');
            if (modal) {
                modal.style.display = 'flex';
                if (input) input.value = accountingData.totalBudget || '';
            }
        }

        // 关闭预算设置弹窗
        function closeBudgetSettingModal() {
            const modal = document.getElementById('budgetSettingModal');
            if (modal) modal.style.display = 'none';
        }

        // 保存预算
        async function saveBudget() {
            const input = document.getElementById('budgetInput');
            const budget = parseFloat(input.value);
            if (isNaN(budget) || budget < 0) {
                alert('请输入有效的预算金额');
                return;
            }

            accountingData.totalBudget = budget;
            // 重新计算剩余预算
            const totalExpense = accountingData.records.reduce((sum, r) => sum + (r.amount || 0), 0);
            accountingData.remainingBudget = budget - totalExpense;

            // 保存到localforage
            await saveAccountingData();

            // 更新UI
            updateBudgetDisplay();
            closeBudgetSettingModal();
            console.log('预算已设置:', budget);
        }

        // 更新预算显示
        function updateBudgetDisplay() {
            const totalEl = document.getElementById('totalBudgetDisplay');
            const remainingEl = document.getElementById('remainingBudgetDisplay');

            if (totalEl) {
                totalEl.textContent = '¥' + (accountingData.totalBudget || 0).toLocaleString();
            }
            if (remainingEl) {
                remainingEl.textContent = '¥' + (accountingData.remainingBudget || 0).toLocaleString();
            }
        }

        // ==================== 消费记录功能 ====================

        let tempExpenseType = null;
        let tempExpenseIcon = null;

        // 打开消费类型选择弹窗
        function openExpenseTypeModal() {
            const modal = document.getElementById('expenseTypeModal');
            if (modal) modal.style.display = 'flex';
        }

        // 关闭消费类型选择弹窗
        function closeExpenseTypeModal() {
            const modal = document.getElementById('expenseTypeModal');
            if (modal) modal.style.display = 'none';
        }

        // 选择消费类型
        function selectExpenseType(type, icon) {
            tempExpenseType = type;
            tempExpenseIcon = icon;
            closeExpenseTypeModal();

            // 打开金额输入弹窗
            setTimeout(() => {
                openExpenseAmountModal(type, icon);
            }, 100);
        }

        // 打开金额输入弹窗
        function openExpenseAmountModal(type, icon) {
            const modal = document.getElementById('expenseAmountModal');
            const iconEl = document.getElementById('selectedTypeIcon');
            const nameEl = document.getElementById('selectedTypeName');
            const input = document.getElementById('expenseAmountInput');

            if (iconEl) iconEl.textContent = icon;
            if (nameEl) nameEl.textContent = type;
            if (input) input.value = '';
            if (modal) modal.style.display = 'flex';
        }

        // 关闭金额输入弹窗
        function closeExpenseAmountModal() {
            const modal = document.getElementById('expenseAmountModal');
            if (modal) modal.style.display = 'none';
            tempExpenseType = null;
            tempExpenseIcon = null;
        }

        // 保存消费记录
        async function saveExpenseRecord() {
            const input = document.getElementById('expenseAmountInput');
            const amount = parseFloat(input.value);

            if (isNaN(amount) || amount <= 0) {
                alert('请输入有效的金额');
                return;
            }

            // 检查预算
            if (amount > accountingData.remainingBudget) {
                alert('超出剩余预算！');
                return;
            }

            // 创建记录
            const record = {
                id: Date.now(),
                type: tempExpenseType,
                icon: tempExpenseIcon,
                amount: amount,
                date: new Date().toISOString(),
                timestamp: Date.now()
            };

            // 添加到记录列表
            accountingData.records.unshift(record);

            // 更新剩余预算
            accountingData.remainingBudget -= amount;

            // 保存到localforage
            await saveAccountingData();

            // 更新UI
            updateBudgetDisplay();
            renderAccountingList();
            closeExpenseAmountModal();

            console.log('消费记录已保存:', record);
        }

        // 渲染记账列表
        function renderAccountingList() {
            const list = document.getElementById('accountingList');
            if (!list) return;

            if (accountingData.records.length === 0) {
                list.innerHTML = '<div style="text-align: center; color: #999; padding: 30px;">暂无消费记录</div>';
                return;
            }

            let html = '';
            accountingData.records.forEach(record => {
                const date = new Date(record.date);
                const dateStr = `${date.getMonth() + 1}月${date.getDate()}日 ${date.getHours()}:${date.getMinutes().toString().padStart(2, '0')}`;

                html += `
                    <div style="display: flex; align-items: center; padding: 12px; border-bottom: 1px solid #f0f0f0;">
                        <div style="width: 40px; height: 40px; background: linear-gradient(135deg, #ffecd2 0%, #fcb69f 100%); border-radius: 10px; display: flex; align-items: center; justify-content: center; margin-right: 12px;">
                            <span style="font-size: 20px;">${record.icon || '📦'}</span>
                        </div>
                        <div style="flex: 1;">
                            <div style="font-size: 15px; color: #333; font-weight: 500;">${record.type || '其他'}</div>
                            <div style="font-size: 12px; color: #999;">${dateStr}</div>
                        </div>
                        <div style="font-size: 16px; color: #ff6b6b; font-weight: 600;">-¥${record.amount.toFixed(2)}</div>
                    </div>
                `;
            });

            list.innerHTML = html;
        }

        // 保存记账数据到localforage
        async function saveAccountingData() {
            try {
                await localforage.setItem('accountingData', accountingData);
                console.log('记账数据已保存');
            } catch (error) {
                console.error('保存记账数据失败:', error);
            }
        }

        // 加载记账数据
        async function loadAccountingData() {
            try {
                const saved = await localforage.getItem('accountingData');
                if (saved) {
                    accountingData = { ...accountingData, ...saved };
                    // 重新计算剩余预算
                    const totalExpense = accountingData.records.reduce((sum, r) => sum + (r.amount || 0), 0);
                    accountingData.remainingBudget = (accountingData.totalBudget || 0) - totalExpense;
                    updateBudgetDisplay();
                    renderAccountingList();
                    console.log('记账数据已加载');
                }
                
                // 恢复评语显示（无论是否有保存数据都执行）
                const commentEl = document.getElementById('accountingCommentText');
                if (commentEl && accountingData.lastComment) {
                    commentEl.textContent = accountingData.lastComment;
                }
            } catch (error) {
                console.error('加载记账数据失败:', error);
            }
        }

        // ==================== CSV导入功能 ====================

        let csvParsedData = null;

        // 打开CSV导入弹窗
        function openCSVImportModal() {
            const modal = document.getElementById('csvImportModal');
            const statusEl = document.getElementById('csvImportStatus');
            if (modal) {
                modal.style.display = 'flex';
                csvParsedData = null;
                if (statusEl) {
                    statusEl.style.display = 'none';
                    statusEl.textContent = '';
                }
            }
        }

        // 关闭CSV导入弹窗
        function closeCSVImportModal() {
            const modal = document.getElementById('csvImportModal');
            if (modal) modal.style.display = 'none';
            csvParsedData = null;
        }

        // 处理CSV文件选择
        document.addEventListener('DOMContentLoaded', () => {
            const csvInput = document.getElementById('csvFileInput');
            if (csvInput) {
                csvInput.addEventListener('change', handleCSVFileSelect);
            }
        });

        // 处理CSV文件选择
        function handleCSVFileSelect(event) {
            const file = event.target.files[0];
            if (!file) return;

            const statusEl = document.getElementById('csvImportStatus');
            if (statusEl) {
                statusEl.style.display = 'block';
                statusEl.textContent = '正在解析文件...';
                statusEl.style.color = '#666';
            }

            Papa.parse(file, {
                complete: function(results) {
                    console.log('CSV解析完成:', results);
                    const parsed = parseCSVData(results.data);
                    if (parsed.length > 0) {
                        csvParsedData = parsed;
                        if (statusEl) {
                            statusEl.textContent = `成功解析 ${parsed.length} 条记录`;
                            statusEl.style.color = '#4CAF50';
                        }
                    } else {
                        if (statusEl) {
                            statusEl.textContent = '未找到有效记录';
                            statusEl.style.color = '#f44336';
                        }
                    }
                },
                error: function(error) {
                    console.error('CSV解析错误:', error);
                    if (statusEl) {
                        statusEl.textContent = '解析失败: ' + error.message;
                        statusEl.style.color = '#f44336';
                    }
                }
            });
        }

        // 解析CSV数据（支持支付宝和微信）
        function parseCSVData(data) {
            const records = [];
            let startIndex = 0;

            // 找到表头行
            for (let i = 0; i < data.length; i++) {
                const row = data[i];
                if (row && row.length >= 3) {
                    const rowStr = row.join(',');
                    // 检查是否包含关键词
                    if (rowStr.includes('时间') || rowStr.includes('交易时间') ||
                        rowStr.includes('名称') || rowStr.includes('交易对方') ||
                        rowStr.includes('金额') || rowStr.includes('金额(')) {
                        startIndex = i + 1;
                        break;
                    }
                }
            }

            // 解析数据行
            for (let i = startIndex; i < data.length; i++) {
                const row = data[i];
                if (!row || row.length < 3) continue;

                // 跳过空行和合计行
                if (row[0] === '' || row[0].includes('合计') || row[0].includes('统计')) continue;

                let time = '', name = '', amount = 0, type = '其他';

                // 尝试解析支付宝格式
                if (row.length >= 5) {
                    time = row[0] || '';
                    name = row[2] || row[1] || '';
                    const amountStr = row[3] || row[4] || '0';
                    amount = parseAmount(amountStr);
                    type = detectExpenseType(name);
                }

                // 尝试解析微信格式
                if (time === '' && row.length >= 7) {
                    time = row[0] || '';
                    name = row[2] || '';
                    const amountStr = row[4] || row[5] || '0';
                    amount = parseAmount(amountStr);
                    type = detectExpenseType(name);
                }

                if (time && name && amount > 0) {
                    records.push({
                        time: time,
                        name: name,
                        amount: amount,
                        type: type,
                        icon: getIconByType(type),
                        timestamp: parseTime(time)
                    });
                }
            }

            // 按时间倒序排序
            records.sort((a, b) => b.timestamp - a.timestamp);

            return records;
        }

        // 解析金额
        function parseAmount(amountStr) {
            if (!amountStr) return 0;
            // 去掉货币符号、千分位、空格
            const cleaned = amountStr.toString()
                .replace(/[¥$￥,\s]/g, '')
                .replace(/[+-]$/, '');
            const amount = parseFloat(cleaned);
            return isNaN(amount) ? 0 : Math.abs(amount);
        }

        // 解析时间
        function parseTime(timeStr) {
            if (!timeStr) return Date.now();
            try {
                // 尝试解析各种格式
                const time = new Date(timeStr);
                if (!isNaN(time.getTime())) return time.getTime();
            } catch (e) {}
            return Date.now();
        }

        // 根据名称检测消费类型
        function detectExpenseType(name) {
            const typeMap = {
                '餐饮': ['餐', '饭', '面', '粉', '汉堡', '奶茶', '咖啡', '肯德基', '麦当劳', '星巴克'],
                '交通': ['地铁', '公交', '打车', '滴滴', '出租车', '高铁', '火车', '机票'],
                '衣服': ['衣', '服', '鞋', '包', '淘宝', '京东', '天猫'],
                '化妆品': ['化妆品', '护肤', '美容', '口红', '面膜'],
                '超市购物': ['超市', '便利店', '沃尔玛', '家乐福', '永辉'],
                '蔬菜': ['蔬菜', '菜市', '生鲜'],
                '水果': ['水果', '果切'],
                '住房': ['房租', '水电', '物业', '燃气'],
                '娱乐': ['电影', '游戏', 'KTV', '娱乐'],
                '医疗': ['医院', '药', '诊所', '医疗'],
                '教育': ['学费', '培训', '课程', '书'],
                '通讯': ['话费', '流量', '宽带', '移动', '联通', '电信']
            };

            for (const [type, keywords] of Object.entries(typeMap)) {
                for (const keyword of keywords) {
                    if (name.includes(keyword)) return type;
                }
            }
            return '其他';
        }

        // 根据类型获取图标
        function getIconByType(type) {
            const iconMap = {
                '餐饮': '🍔',
                '交通': '🚌',
                '衣服': '👔',
                '化妆品': '💄',
                '超市购物': '🛒',
                '蔬菜': '🥬',
                '水果': '🍎',
                '住房': '🏠',
                '娱乐': '🎮',
                '医疗': '💊',
                '教育': '📚',
                '通讯': '📱'
            };
            return iconMap[type] || '📦';
        }

        // 处理CSV导入
        async function processCSVImport() {
            if (!csvParsedData || csvParsedData.length === 0) {
                alert('请先选择有效的CSV文件');
                return;
            }

            // 将解析的数据添加到记账记录
            let addedCount = 0;
            let totalAmount = 0;

            for (const item of csvParsedData) {
                // 检查是否已存在（根据时间和名称）
                const exists = accountingData.records.some(r =>
                    r.name === item.name &&
                    Math.abs(r.timestamp - item.timestamp) < 60000
                );

                if (!exists) {
                    const record = {
                        id: Date.now() + Math.random(),
                        type: item.type,
                        icon: item.icon,
                        name: item.name,
                        amount: item.amount,
                        date: new Date(item.timestamp).toISOString(),
                        timestamp: item.timestamp,
                        fromCSV: true
                    };

                    accountingData.records.push(record);
                    totalAmount += item.amount;
                    addedCount++;
                }
            }

            // 更新剩余预算
            accountingData.remainingBudget -= totalAmount;
            if (accountingData.remainingBudget < 0) accountingData.remainingBudget = 0;

            // 保存到localforage
            await saveAccountingData();

            // 更新UI
            updateBudgetDisplay();
            renderAccountingList();

            closeCSVImportModal();
            alert(`成功导入 ${addedCount} 条记录，共 ¥${totalAmount.toFixed(2)}`);

            console.log('CSV导入完成:', addedCount, '条记录');
        }

        // ==================== API评价功能 ====================

        // 调用API进行记账评价
        async function callAccountingAPI() {
            if (!accountingData.aiEvaluator) {
                alert('请先选择记账评价AI');
                return;
            }

            // 获取本周账单
            const weekRecords = getWeekRecords();
            if (weekRecords.length === 0) {
                alert('本周暂无消费记录');
                return;
            }

            // 显示加载状态
            const commentEl = document.getElementById('accountingCommentText');
            if (commentEl) {
                commentEl.textContent = 'AI正在评价中...';
            }

            try {
                // 构建账单摘要
                const totalExpense = weekRecords.reduce((sum, r) => sum + r.amount, 0);
                const categorySummary = {};
                weekRecords.forEach(r => {
                    categorySummary[r.type] = (categorySummary[r.type] || 0) + r.amount;
                });

                let billSummary = `本周消费总额：¥${totalExpense.toFixed(2)}\n\n分类统计：\n`;
                for (const [type, amount] of Object.entries(categorySummary)) {
                    billSummary += `${type}：¥${amount.toFixed(2)}\n`;
                }
                billSummary += `\n详细记录：\n`;
                weekRecords.slice(0, 10).forEach(r => {
                    billSummary += `${r.type} - ${r.name || r.type}：¥${r.amount.toFixed(2)}\n`;
                });

                // 获取AI人设和记忆
                const teacherId = accountingData.aiEvaluator.id;
                let personaInfo = '';
                let longTermMemory = '';
                let chatContext = [];

                // 从角色数据中获取人设
                if (relationshipData.wechatChatList) {
                    const aiChar = relationshipData.wechatChatList.find(chat => chat.id == teacherId);
                    if (aiChar) {
                        if (aiChar.persona) personaInfo = aiChar.persona;
                    }
                }

                // 获取长期记忆（从localforage直接读取）
                try {
                    const beautifulMemories = await localforage.getItem('beautifulMemories') || [];
                    const relatedMemories = beautifulMemories
                        .filter(m => m.chatId == teacherId)
                        .slice(-3);
                    if (relatedMemories.length > 0) {
                        longTermMemory = relatedMemories.map(m => m.content).join('\n');
                    }
                } catch (e) {
                    console.error('获取长期记忆失败:', e);
                }

                // 获取聊天记录上下文（从localforage直接读取）
                try {
                    const chatMessages = await localforage.getItem('chatMessages') || [];
                    chatContext = chatMessages
                        .filter(msg => msg.chatId == teacherId)
                        .slice(-5)
                        .map(msg => ({
                            role: msg.sender === 'user' ? 'user' : 'assistant',
                            content: msg.content || msg.text || ''
                        }));
                } catch (e) {
                    console.error('获取聊天记录失败:', e);
                }

                // 构建系统提示词
                let systemPrompt = `你是${accountingData.aiEvaluator.name}，一位专业的财务顾问。`;
                if (personaInfo) {
                    systemPrompt += `\n\n【你的人设】\n${personaInfo}`;
                }
                if (longTermMemory) {
                    systemPrompt += `\n\n【关于用户的长期记忆】\n${longTermMemory}`;
                }
                systemPrompt += `\n\n请根据用户的本周账单给出评价建议。评价要简洁有力，给出具体的改进建议。最后给出评分：优秀/良好/需努力。`;

                // 构建工具（记账评价工具）
                const tools = [{
                    type: "function",
                    function: {
                        name: "accounting_evaluation",
                        description: "对用户的记账情况进行评价",
                        parameters: {
                            type: "object",
                            properties: {
                                evaluation: {
                                    type: "string",
                                    description: "评价内容，包含消费分析和建议"
                                },
                                rating: {
                                    type: "string",
                                    enum: ["优秀", "良好", "需努力"],
                                    description: "整体评分"
                                }
                            },
                            required: ["evaluation", "rating"]
                        }
                    }
                }];

                // 获取API配置
                const savedSettings = await loadAppSettings({});
                const apiKey = savedSettings.api?.apiKey || '';
                const apiUrl = savedSettings.api?.baseUrl || 'https://api.openai.com/v1';
                const modelName = savedSettings.api?.model || 'gpt-4o';
                const apiTemperature = savedSettings.api?.temperature ?? 0.7;

                if (!apiKey) {
                    throw new Error('请先在设置中配置API密钥');
                }

                // 构建请求数据
                const requestData = {
                    model: modelName,
                    messages: [
                        { role: 'system', content: systemPrompt },
                        ...chatContext,
                        { role: 'user', content: `请评价我的本周账单：\n\n${billSummary}` }
                    ],
                    temperature: apiTemperature,
                    max_tokens: 500,
                    tools: tools,
                    tool_choice: 'auto'
                };

                // 记录API调用日志
                addApiCallLog('记账评价请求', {
                    url: `${apiUrl}/chat/completions`,
                    model: modelName,
                    systemPrompt: systemPrompt,
                    chatContext: chatContext,
                    billSummary: billSummary,
                    tools: tools
                });

                // 调用API
                // 【修复】添加超时处理，防止请求卡住
                const controller = new AbortController();
                const timeoutId = setTimeout(() => controller.abort(), 300000); // 【修改】300秒超时

                const response = await fetch(`${apiUrl}/chat/completions`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${apiKey}`
                    },
                    body: JSON.stringify(requestData),
                    signal: controller.signal
                });

                clearTimeout(timeoutId); // 请求成功，清除超时

                if (!response.ok) {
                    throw new Error(`API请求失败: ${response.status}`);
                }

                const data = await response.json();
                const aiMessage = data.choices[0].message;

                // 记录API响应日志
                addApiCallLog('记账评价响应', {
                    aiMessage: aiMessage,
                    fullResponse: data
                });

                // 处理工具调用
                let evaluation = '';
                let rating = '需努力';

                if (aiMessage.tool_calls && aiMessage.tool_calls.length > 0) {
                    for (const toolCall of aiMessage.tool_calls) {
                        if (toolCall.function.name === 'accounting_evaluation') {
                            try {
                                const args = JSON.parse(toolCall.function.arguments);
                                evaluation = args.evaluation;
                                rating = args.rating;
                            } catch (e) {
                                console.error('解析评价失败:', e);
                            }
                        }
                    }
                }

                // 如果没有工具调用，使用content
                if (!evaluation && aiMessage.content) {
                    evaluation = aiMessage.content;
                    // 从内容中检测评分
                    if (evaluation.includes('优秀')) rating = '优秀';
                    else if (evaluation.includes('良好')) rating = '良好';
                }

                // 更新UI
                if (commentEl) {
                    commentEl.textContent = evaluation || '评价完成';
                }

                // 保存评语
                accountingData.lastComment = evaluation || '评价完成';
                accountingData.lastCommentTime = Date.now();
                console.log('准备保存评语:', accountingData.lastComment);
                console.log('当前accountingData:', JSON.stringify(accountingData, null, 2));
                await saveAccountingData();
                console.log('评语已保存到localforage');

                // 更新评分状态
                updateAccountingRating(rating);

                console.log('AI评价完成:', rating);

            } catch (error) {
                console.error('API评价失败:', error);
                if (commentEl) {
                    commentEl.textContent = '评价失败，请稍后重试';
                }
            }
        }

        // 获取本周记录
        function getWeekRecords() {
            const now = new Date();
            const weekStart = new Date(now);
            weekStart.setDate(now.getDate() - now.getDay());
            weekStart.setHours(0, 0, 0, 0);

            return accountingData.records.filter(r => {
                const recordDate = new Date(r.timestamp);
                return recordDate >= weekStart;
            });
        }

        // 更新记账评分（小红花/闪电系统）
        function updateAccountingRating(rating) {
            let currentFlowers = accountingData.weekFlowers || 0;
            let currentLightning = accountingData.lightningCount || 0;
            let flowerAdded = false;
            let lightningAdded = false;

            if (rating === '优秀') {
                // 有闪电先去掉闪电，否则加花
                if (currentLightning > 0) {
                    currentLightning--;
                } else if (currentFlowers < 4) {
                    currentFlowers++;
                    flowerAdded = true;
                }
            } else if (rating === '需努力') {
                // 有花扣花，没花加闪电
                if (currentFlowers > 0) {
                    currentFlowers--;
                } else if (currentLightning < 4) {
                    currentLightning++;
                    lightningAdded = true;
                }
            }
            // 良好不改变

            accountingData.weekFlowers = currentFlowers;
            accountingData.lightningCount = currentLightning;

            // 保存并更新UI
            saveAccountingData();
            updateFlowers(currentFlowers, currentLightning);

            // 如果获得了小红花，显示奖励动画
            if (flowerAdded) {
                setTimeout(() => {
                    showFlowerReward();
                }, 300);
            }

            // 如果获得了闪电，显示惩罚动画
            if (lightningAdded) {
                setTimeout(() => {
                    showLightningPunish();
                }, 300);
            }
        }

        // 调整小红花数量（调试用）- 有闪电时加花先减闪电
        async function adjustFlowers(delta) {
            let currentFlowers = accountingData.weekFlowers || 0;
            let currentLightning = accountingData.lightningCount || 0;
            let flowerEffect = false;
            let lightningEffect = false;
            
            if (delta > 0) {
                // 增加花朵：有闪电先减闪电（减闪电也算获得花的正向效果），没闪电才加花
                for (let i = 0; i < delta; i++) {
                    if (currentLightning > 0) {
                        currentLightning--;
                        flowerEffect = true; // 减闪电也是正向效果
                    } else if (currentFlowers < 4) {
                        currentFlowers++;
                        flowerEffect = true;
                    }
                }
            } else {
                // 减少花朵：直接减
                currentFlowers = Math.max(0, currentFlowers + delta);
            }
            
            accountingData.weekFlowers = currentFlowers;
            accountingData.lightningCount = currentLightning;
            await saveAccountingData();
            updateFlowers(currentFlowers, currentLightning);
            console.log('调整后 - 花:', currentFlowers, '闪电:', currentLightning);
            
            // 如果有花的正向效果（加花或减闪电），显示奖励动画
            if (flowerEffect) {
                setTimeout(() => {
                    showFlowerReward();
                }, 300);
            }
        }

        // 调整闪电数量（调试用）- 有花时加闪电先扣花
        async function adjustLightning(delta) {
            let currentFlowers = accountingData.weekFlowers || 0;
            let currentLightning = accountingData.lightningCount || 0;
            let lightningEffect = false;
            
            if (delta > 0) {
                // 增加闪电：有花先扣花（扣花也算获得闪电的负面效果），没花才加闪电
                for (let i = 0; i < delta; i++) {
                    if (currentFlowers > 0) {
                        currentFlowers--;
                        lightningEffect = true; // 扣花也是负面效果
                    } else if (currentLightning < 4) {
                        currentLightning++;
                        lightningEffect = true;
                    }
                }
            } else {
                // 减少闪电：直接减
                currentLightning = Math.max(0, currentLightning + delta);
            }
            
            accountingData.weekFlowers = currentFlowers;
            accountingData.lightningCount = currentLightning;
            await saveAccountingData();
            updateFlowers(currentFlowers, currentLightning);
            console.log('调整后 - 花:', currentFlowers, '闪电:', currentLightning);
            
            // 如果有闪电的负面效果（加闪电或扣花），显示惩罚动画
            if (lightningEffect) {
                setTimeout(() => {
                    showLightningPunish();
                }, 300);
            }
        }

        // 重置小红花和闪电（调试用）
        async function resetFlowers() {
            accountingData.weekFlowers = 0;
            accountingData.lightningCount = 0;
            await saveAccountingData();
            updateFlowers(0, 0);
            console.log('小红花和闪电已重置');
        }

        // ==================== 小红花奖励动画功能 ====================

        // 显示获得小红花奖励
        function showFlowerReward() {
            const modal = document.getElementById('flowerRewardModal');
            const confettiContainer = document.getElementById('confettiContainer');
            
            if (!modal) return;
            
            // 清空之前的彩带
            if (confettiContainer) confettiContainer.innerHTML = '';
            
            // 显示弹窗
            modal.style.display = 'flex';
            
            // 创建彩带
            createConfetti();
            
            // 2秒后自动关闭
            setTimeout(() => {
                closeFlowerReward();
            }, 2000);
        }

        // 关闭奖励弹窗
        function closeFlowerReward() {
            const modal = document.getElementById('flowerRewardModal');
            if (modal) modal.style.display = 'none';
        }

        // 创建彩带
        function createConfetti() {
            const container = document.getElementById('confettiContainer');
            if (!container) return;
            
            const colors = ['#ff6b9d', '#feca57', '#48dbfb', '#ff9ff3', '#54a0ff', '#5f27cd'];
            const confettiCount = 50;
            
            for (let i = 0; i < confettiCount; i++) {
                setTimeout(() => {
                    const confetti = document.createElement('div');
                    confetti.className = 'confetti';
                    
                    // 随机颜色
                    const color = colors[Math.floor(Math.random() * colors.length)];
                    confetti.style.backgroundColor = color;
                    
                    // 随机位置
                    const left = Math.random() * 100;
                    confetti.style.left = left + '%';
                    
                    // 随机大小
                    const size = Math.random() * 8 + 6;
                    confetti.style.width = size + 'px';
                    confetti.style.height = size + 'px';
                    
                    // 随机动画时长
                    const duration = Math.random() * 2 + 2;
                    confetti.style.animationDuration = duration + 's';
                    
                    // 随机形状
                    const shape = Math.random();
                    if (shape < 0.33) {
                        confetti.style.borderRadius = '50%';
                    } else if (shape < 0.66) {
                        confetti.style.borderRadius = '0';
                    } else {
                        confetti.style.width = '0';
                        confetti.style.height = '0';
                        confetti.style.borderLeft = size/2 + 'px solid transparent';
                        confetti.style.borderRight = size/2 + 'px solid transparent';
                        confetti.style.borderBottom = size + 'px solid ' + color;
                        confetti.style.backgroundColor = 'transparent';
                    }
                    
                    container.appendChild(confetti);
                    
                    // 动画结束后移除
                    setTimeout(() => {
                        confetti.remove();
                    }, duration * 1000);
                }, i * 30);
            }
        }

        // ==================== 小红花奖励动画功能结束 ====================

        // ==================== 闪电惩罚动画功能 ====================

        // 显示获得闪电惩罚
        function showLightningPunish() {
            const modal = document.getElementById('lightningPunishModal');
            const poopContainer = document.getElementById('poopContainer');
            const danmakuContainer = document.getElementById('danmakuContainer');
            
            if (!modal) return;
            
            // 清空之前的屎和弹幕
            if (poopContainer) poopContainer.innerHTML = '';
            if (danmakuContainer) danmakuContainer.innerHTML = '';
            
            // 显示弹窗
            modal.style.display = 'flex';
            
            // 创建屎雨
            createPoopRain();
            
            // 创建弹幕
            createDanmaku();
            
            // 2秒后自动关闭
            setTimeout(() => {
                closeLightningPunish();
            }, 2000);
        }

        // 关闭惩罚弹窗
        function closeLightningPunish() {
            const modal = document.getElementById('lightningPunishModal');
            if (modal) modal.style.display = 'none';
        }

        // 创建屎雨
        function createPoopRain() {
            const container = document.getElementById('poopContainer');
            if (!container) return;
            
            const poopCount = 40;
            
            for (let i = 0; i < poopCount; i++) {
                setTimeout(() => {
                    const poop = document.createElement('div');
                    poop.className = 'poop';
                    poop.textContent = '💩';
                    
                    // 随机位置
                    const left = Math.random() * 100;
                    poop.style.left = left + '%';
                    
                    // 随机动画时长
                    const duration = Math.random() * 1.5 + 1.5;
                    poop.style.animationDuration = duration + 's';
                    
                    // 随机大小
                    const size = Math.random() * 10 + 20;
                    poop.style.fontSize = size + 'px';
                    
                    container.appendChild(poop);
                    
                    // 动画结束后移除
                    setTimeout(() => {
                        poop.remove();
                    }, duration * 1000);
                }, i * 40);
            }
        }

        // 创建弹幕
        function createDanmaku() {
            const container = document.getElementById('danmakuContainer');
            if (!container) return;
            
            const colors = ['#ff6b6b', '#feca57', '#48dbfb', '#ff9ff3', '#54a0ff', '#5f27cd', '#00d2d3', '#ff9f43', '#ee5a24', '#009432'];
            const danmakuCount = 15;
            
            for (let i = 0; i < danmakuCount; i++) {
                setTimeout(() => {
                    const danmaku = document.createElement('div');
                    danmaku.className = 'danmaku';
                    danmaku.textContent = '竟然忘本了！';
                    
                    // 随机颜色
                    const color = colors[Math.floor(Math.random() * colors.length)];
                    danmaku.style.color = color;
                    
                    // 随机垂直位置
                    const top = Math.random() * 80 + 10;
                    danmaku.style.top = top + '%';
                    
                    // 随机动画时长
                    const duration = Math.random() * 1 + 2;
                    danmaku.style.animationDuration = duration + 's';
                    
                    // 随机字体大小
                    const size = Math.random() * 8 + 16;
                    danmaku.style.fontSize = size + 'px';
                    
                    container.appendChild(danmaku);
                    
                    // 动画结束后移除
                    setTimeout(() => {
                        danmaku.remove();
                    }, duration * 1000);
                }, i * 150);
            }
        }

        // ==================== 闪电惩罚动画功能结束 ====================

        // ==================== 灵珠大转盘功能 ====================

        // 奖品配置
        const wheelPrizes = [
            { id: 0, name: '免惩罚券', icon: '🛡️', color: '#ff6b9d', probability: 0.2 },
            { id: 1, name: '聊天标识', icon: '💬', color: '#a29bfe', probability: 0.2 },
            { id: 2, name: '以上所有！', icon: '👑', color: '#ffd93d', probability: 0.1 },
            { id: 3, name: '情书券', icon: '💌', color: '#74b9ff', probability: 0.2 },
            { id: 4, name: '荣誉奖章', icon: '🏅', color: '#fdcb6e', probability: 0.2 },
            { id: 5, name: '谢谢惠顾', icon: '😅', color: '#b2bec3', probability: 0.1 }
        ];

        let isSpinning = false;
        let currentRotation = 0;

        // 打开大转盘
        function openLuckyWheel() {
            const modal = document.getElementById('luckyWheelModal');
            const wheel = document.getElementById('luckyWheel');
            const resultDiv = document.getElementById('wheelResult');
            const btn = document.getElementById('spinWheelBtn');
            
            if (modal) {
                modal.style.display = 'flex';
                // 重置转盘状态
                currentRotation = 0;
                if (wheel) wheel.style.transform = 'rotate(0deg)';
                if (resultDiv) resultDiv.style.display = 'none';
                if (btn) {
                    btn.disabled = false;
                    btn.style.opacity = '1';
                    btn.textContent = '🎉 开始抽奖';
                }
                isSpinning = false;
            }
        }

        // 关闭大转盘
        function closeLuckyWheel() {
            const modal = document.getElementById('luckyWheelModal');
            if (modal) modal.style.display = 'none';
        }

        // 抽奖逻辑
        function drawPrize() {
            const random = Math.random();
            let cumulative = 0;
            
            for (const prize of wheelPrizes) {
                cumulative += prize.probability;
                if (random <= cumulative) {
                    return prize;
                }
            }
            return wheelPrizes[wheelPrizes.length - 1];
        }

        // 旋转转盘
        function spinLuckyWheel() {
            if (isSpinning) return;
            
            const wheel = document.getElementById('luckyWheel');
            const btn = document.getElementById('spinWheelBtn');
            const resultDiv = document.getElementById('wheelResult');
            const resultText = document.getElementById('wheelResultText');
            
            if (!wheel || !btn) return;
            
            isSpinning = true;
            btn.disabled = true;
            btn.style.opacity = '0.5';
            btn.textContent = '旋转中...';
            
            // 抽奖
            const prize = drawPrize();
            
            // 计算旋转角度 (每个扇形60度，指针在顶部)
            // 需要让指针指向中奖扇形的中心
            const sectorAngle = 60;
            const targetAngle = 360 - (prize.id * sectorAngle + sectorAngle / 2);
            
            // 至少旋转5圈 + 目标角度
            const spins = 5;
            const finalRotation = currentRotation + spins * 360 + targetAngle + (360 - currentRotation % 360);
            currentRotation = finalRotation;
            
            // 应用旋转
            wheel.style.transform = `rotate(${finalRotation}deg)`;
            
            // 4秒后显示结果并关闭
            setTimeout(async () => {
                isSpinning = false;
                btn.textContent = '已抽奖';
                btn.disabled = true;
                btn.style.opacity = '0.5';
                
                if (resultDiv && resultText) {
                    resultDiv.style.display = 'block';
                    const isGrandPrize = prize.id === 2;
                    resultText.innerHTML = `
                        <div style="color: ${isGrandPrize ? '#e74c3c' : prize.color}; font-size: 20px;">
                            ${prize.name}
                        </div>
                        ${isGrandPrize ? '<div style="font-size: 12px; color: #999; margin-top: 5px;">恭喜获得所有奖品！</div>' : ''}
                    `;
                }
                
                // 保存奖品到localforage
                savePrize(prize);
                
                console.log('抽奖结果:', prize.name);
                
                // 2秒后关闭转盘并清空小红花
                setTimeout(async () => {
                    closeLuckyWheel();
                    // 清空小红花
                    accountingData.weekFlowers = 0;
                    await saveAccountingData();
                    updateFlowers(0, accountingData.lightningCount || 0);
                    console.log('小红花已清空');
                }, 2000);
            }, 4000);
        }

        // 保存奖品
        async function savePrize(prize) {
            try {
                let prizes = await localforage.getItem('luckyWheelPrizes') || [];
                prizes.push({
                    ...prize,
                    time: Date.now(),
                    date: new Date().toLocaleString()
                });
                await localforage.setItem('luckyWheelPrizes', prizes);
                console.log('奖品已保存:', prize.name);

                // 如果是"以上所有！"，发放所有奖品
                if (prize.name === '以上所有！') {
                    // 发放免惩罚券
                    await window.addCouponToInventoryGlobal('免惩罚券', 1);
                    console.log('大奖：免惩罚券已添加');

                    // 发放情书券
                    await window.addCouponToInventoryGlobal('情书券', 1);
                    console.log('大奖：情书券已添加');

                    // 解锁荣誉奖章
                    const unlockedMedal = await randomUnlockHonorMedal();
                    console.log(`大奖：荣誉奖章已解锁: ${unlockedMedal.name}`);

                    // 解锁聊天标识
                    const unlockedBadge = await randomUnlockChatBadge();
                    console.log(`大奖：聊天标识已解锁: ID=${unlockedBadge.id}`);

                    showToast('🎉 恭喜获得所有奖品！');
                    return;
                }

                // 如果是免惩罚券或情书券，添加到券券库存
                if (prize.name === '免惩罚券' || prize.name === '情书券') {
                    // 使用全局函数添加券券
                    await window.addCouponToInventoryGlobal(prize.name, 1);
                    console.log(`奖品已添加到券券库存: ${prize.name}`);
                }

                // 如果是荣誉奖章，随机解锁一个奖章
                if (prize.name === '荣誉奖章') {
                    const unlockedMedal = await randomUnlockHonorMedal();
                    console.log(`荣誉奖章已解锁: ${unlockedMedal.name}`);
                }

                // 如果是聊天标识，随机解锁一个聊天标识
                if (prize.name === '聊天标识') {
                    const unlockedBadge = await randomUnlockChatBadge();
                    console.log(`聊天标识已解锁: ID=${unlockedBadge.id}`);
                }
            } catch (error) {
                console.error('保存奖品失败:', error);
            }
        }

        // 检查是否满4朵花并触发转盘
        function checkAndTriggerLuckyWheel() {
            if (accountingData.weekFlowers >= 4 && accountingData.lightningCount === 0) {
                // 延迟一点显示，让用户看到满花的状态
                setTimeout(() => {
                    openLuckyWheel();
                }, 500);
            }
        }

        // ==================== 灵珠大转盘功能结束 ====================

        // ==================== 券券功能 ====================
        
        // 当前选中的券
