            shareBox.addEventListener('click', function() {
                // 创建弹窗显示通话记录详情
                const contentPopup = document.createElement('div');
                contentPopup.style.cssText = `
                    position: fixed;
                    top: 50%;
                    left: 50%;
                    transform: translate(-50%, -50%);
                    background-color: white;
                    border-radius: 12px;
                    padding: 20px;
                    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
                    z-index: 10000;
                    max-width: 80%;
                    max-height: 80%;
                    overflow-y: auto;
                `;
                
                contentPopup.innerHTML = `
                    <div style="font-weight: 500; margin-bottom: 10px; color: #333;">通话记录详情：</div>
                    <div style="color: #666; line-height: 1.8;">
                        <div><strong>联系人：</strong>${shareRecord.chatName}</div>
                        <div><strong>通话时间：</strong>${shareRecord.callDate} ${shareRecord.callTime}</div>
                        <div><strong>通话时长：</strong>${shareRecord.duration}</div>
                        <div style="margin-top: 10px;"><strong>通话总结：</strong></div>
                        <div style="margin-top: 5px; word-break: break-word;">${shareRecord.summary}</div>
                    </div>
                    <button id="closeSharePopup" style="
                        margin-top: 15px;
                        padding: 8px 20px;
                        background-color: #007AFF;
                        color: white;
                        border: none;
                        border-radius: 6px;
                        cursor: pointer;
                        font-size: 14px;
                    ">关闭</button>
                `;
                
                document.body.appendChild(contentPopup);
                
                // 关闭按钮事件
                document.getElementById('closeSharePopup').addEventListener('click', function() {
                    contentPopup.remove();
                });
                
                // 点击背景关闭
                contentPopup.addEventListener('click', function(e) {
                    if (e.target === contentPopup) {
                        contentPopup.remove();
                    }
                });
            });
            
            shareContainer.appendChild(shareBox);
            chatContent.appendChild(shareContainer);
            
            // 滚动到底部
            if (scrollToBottom) {
                chatContent.scrollTop = chatContent.scrollHeight;
            }
        }

        // 查找通话记录上下文
        async function findCallRecordContext(prompt) {
            // 获取通话记录
            let callRecords = [];
            try {
                const callRecordsKey = `callRecords_${currentChatId}`;
                callRecords = await localforage.getItem(callRecordsKey) || [];
            } catch (e) {
                console.error('解析通话记录失败:', e);
                return null;
            }
            
            if (callRecords.length === 0) return null;
            
            // 检查提示词中是否提到了通话记录
            const keywords = ['通话', '电话', '刚才', '上次', '之前', '那天', '那天', '什么时候'];
            const hasKeyword = keywords.some(keyword => prompt.includes(keyword));
            
            if (!hasKeyword) return null;
            
            // 查找最近的通话记录（最多5条）
            const recentRecords = callRecords.slice(0, 5);
            
            // 构建上下文
            let context = '';
            recentRecords.forEach((record, index) => {
                context += `通话记录${index + 1}：
联系人：${record.chatName}
通话时间：${record.callDate} ${record.callTime}
通话时长：${record.duration}
通话总结：${record.summary}

`;
            });
            
            return context;
        }

        // 显示通话状态消息
        async function displayCallStatusMessage(sender, text, type) {
            const chatContent = document.getElementById('chatContent');
            if (!chatContent) return;

            // 【严格分页】创建新消息对象（直接显示文本，不添加发送者前缀）
            const newMessage = {
                sender: sender,
                content: text,
                timestamp: Date.now(),
                chatId: currentChatId,
                callStatus: type,
                type: 'call' // 标记为通话消息
            };

            // 【重构】保存到IndexedDB
            try {
                await ChatMessageManager.saveMessage(newMessage);
                console.log('【重构】通话消息已保存到IndexedDB');
            } catch (error) {
                console.error('【重构】保存通话消息失败:', error);
                relationshipData.chatMessages.push(newMessage);
            }

            saveData();
            
            // 【严格分页】使用appendNewMessage追加到界面，不刷新整个列表
            appendNewMessage(newMessage);
        }

        // 压缩图片 - 支持两种调用方式：
        // 1. compressImage(base64Data, callback) - 旧版回调方式
        // 2. compressImage(base64Data, maxWidth, maxHeight, quality) - 新版Promise方式
        // 【性能优化】添加缓存机制，避免重复压缩同一张图片
        const __compressImageCache = new Map();
        const __compressImageCacheMaxSize = 10; // 最多缓存10张图片
        
        function compressImage(base64Data, arg2, arg3, arg4) {
            // 【防闪退】参数验证
            if (!base64Data || typeof base64Data !== 'string') {
                console.error('❌ compressImage: 无效的base64数据');
                return Promise.resolve('');
            }
            
            // 【性能优化】检查缓存
            const cacheKey = base64Data.substring(0, 100) + (arg2?.toString() || '') + (arg3?.toString() || '') + (arg4?.toString() || '');
            if (__compressImageCache.has(cacheKey)) {
                console.log('【图片压缩】使用缓存结果');
                return Promise.resolve(__compressImageCache.get(cacheKey));
            }
            
            // 判断是回调方式还是Promise方式
            const isCallbackMode = typeof arg2 === 'function';
            
            const maxWidth = isCallbackMode ? 512 : (arg2 || 512);
            const maxHeight = isCallbackMode ? 512 : (arg3 || 512);
            const quality = isCallbackMode ? 0.8 : (arg4 || 0.8);
            const callback = isCallbackMode ? arg2 : null;
            
            // 【性能优化】降低内存限制，更严格的控制
            const MAX_BASE64_LENGTH = window.__performanceConfig?.memoryLimit?.maxBase64Length || 10 * 1024 * 1024; // 10MB
            if (base64Data.length > MAX_BASE64_LENGTH) {
                console.error('❌ 图片太大，超过10MB限制，拒绝处理');
                showToast('图片太大，请选择更小的图片', 'error');
                if (callback) callback('');
                return Promise.resolve('');
            }
            
            return new Promise((resolve) => {
                try {
                    const img = new Image();
                    
                    // 【防闪退】图片加载超时处理 - 缩短到5秒
                    let loadTimeout = setTimeout(() => {
                        console.warn('⚠️ 图片处理超时，使用原图');
                        if (callback) callback(base64Data); // 返回原图
                        resolve(base64Data);
                    }, 5000); // 【优化】5秒超时，更快响应
                    
                    img.onload = function() {
                        clearTimeout(loadTimeout);
                        
                        try {
                            const canvas = document.createElement('canvas');
                            const ctx = canvas.getContext('2d');
                            
                            let width = img.width;
                            let height = img.height;
                            
                            // 【性能优化】降低最大尺寸限制，减少内存占用
                            const ABSOLUTE_MAX = 1024; // 【优化】从2048降到1024
                            if (width > ABSOLUTE_MAX || height > ABSOLUTE_MAX) {
                                const ratio = Math.min(ABSOLUTE_MAX / width, ABSOLUTE_MAX / height);
                                width *= ratio;
                                height *= ratio;
                                console.warn('⚠️ 图片尺寸过大，已限制到', ABSOLUTE_MAX);
                            }
                            
                            if (width > maxWidth || height > maxHeight) {
                                const ratio = Math.min(maxWidth / width, maxHeight / height);
                                width *= ratio;
                                height *= ratio;
                            }
                            
                            canvas.width = width;
                            canvas.height = height;
                            ctx.drawImage(img, 0, 0, width, height);
                            
                            // 如果是回调模式且没有指定质量，尝试从UI获取
                            let finalQuality = quality;
                            if (isCallbackMode) {
                                const qualityElement = document.getElementById('compressQuality');
                                finalQuality = qualityElement ? parseInt(qualityElement.value) / 100 : 0.8;
                            }
                            
                            const compressedData = canvas.toDataURL('image/jpeg', finalQuality);
                            
                            // 【性能优化】添加到缓存
                            if (__compressImageCache.size >= __compressImageCacheMaxSize) {
                                // 清理最旧的缓存
                                const firstKey = __compressImageCache.keys().next().value;
                                __compressImageCache.delete(firstKey);
                            }
                            __compressImageCache.set(cacheKey, compressedData);
                            
                            // 【性能优化】只在开发环境输出详细日志
                            if (window.location.hostname === 'localhost') {
                                console.log('原始图片尺寸:', img.width, 'x', img.height);
                                console.log('压缩后图片尺寸:', width, 'x', height);
                                console.log('原始图片大小:', (base64Data.length / 1024).toFixed(1) + 'KB');
                                console.log('压缩后图片大小:', (compressedData.length / 1024).toFixed(1) + 'KB');
                                console.log('压缩质量:', (finalQuality * 100).toFixed(0) + '%');
                                console.log('压缩率:', ((1 - compressedData.length / base64Data.length) * 100).toFixed(2) + '%');
                            }
                            
                            if (callback) {
                                callback(compressedData);
                            }
                            resolve(compressedData);
                        } catch (compressError) {
                            console.error('❌ 图片压缩过程出错:', compressError);
                            if (callback) callback(base64Data);
                            resolve(base64Data);
                        }
                    };
                    
                    img.onerror = function() {
                        clearTimeout(loadTimeout);
                        console.error('❌ 图片加载失败');
                        if (callback) callback(base64Data);
                        resolve(base64Data);
                    };
                    
                    img.src = base64Data;
                } catch (error) {
                    console.error('❌ compressImage 发生错误:', error);
                    if (callback) callback(base64Data);
                    resolve(base64Data);
                }
            });
        }
        
        // 【防闪退】安全加载图片 - 带错误处理和大小限制
        function safeLoadImage(imgElement, src, maxRetries = 3) {
            return new Promise((resolve, reject) => {
                if (!src) {
                    reject(new Error('图片源为空'));
                    return;
                }
                
                // 检查是否是超大base64图片
                if (src.startsWith('data:') && src.length > 10 * 1024 * 1024) {
                    console.warn('⚠️ 检测到超大图片，尝试压缩后加载');
                    compressImage(src, 800, 800, 0.6).then(compressed => {
                        imgElement.src = compressed;
                        resolve(compressed);
                    }).catch(() => {
                        reject(new Error('图片压缩失败'));
                    });
                    return;
                }
                
                let retries = 0;
                
                const tryLoad = () => {
                    imgElement.onload = () => {
                        resolve(src);
                    };
                    
                    imgElement.onerror = () => {
                        retries++;
                        if (retries < maxRetries) {
                            console.warn(`⚠️ 图片加载失败，重试 ${retries}/${maxRetries}`);
                            setTimeout(tryLoad, 1000);
                        } else {
                            reject(new Error('图片加载失败，已达最大重试次数'));
                        }
                    };
                    
                    // 设置超时
                    setTimeout(() => {
                        if (!imgElement.complete) {
                            retries++;
                            if (retries < maxRetries) {
                                console.warn(`⚠️ 图片加载超时，重试 ${retries}/${maxRetries}`);
                                imgElement.src = src; // 重新加载
                            } else {
                                reject(new Error('图片加载超时'));
                            }
                        }
                    }, 10000);
                    
                    imgElement.src = src;
                };
                
                tryLoad();
            });
        }

        // 【重写】发送图片消息 - 简化逻辑，确保图片正确显示
        // 【性能优化】使用更严格的压缩策略，防止内存溢出
        async function sendImageMessage(imageData, fileName) {
            // 参数验证
            if (!imageData || typeof imageData !== 'string' || !imageData.startsWith('data:image')) {
                console.error('❌ sendImageMessage: 无效的图片数据');
                showToast('图片数据无效', 'error');
                return;
            }
            
            // 【性能优化】检查图片大小，超过限制直接拒绝
            const maxSize = window.__performanceConfig?.memoryLimit?.maxBase64Length || 10 * 1024 * 1024;
            if (imageData.length > maxSize) {
                console.error('❌ 图片太大:', (imageData.length / 1024 / 1024).toFixed(2) + 'MB');
                showToast('图片太大，请选择小于10MB的图片', 'error');
                return;
            }
            
            let success = false;
            
            try {
                const timestamp = Date.now();
                
                // 【性能优化】强制压缩所有图片，使用更小的尺寸
                let displayImageData = imageData;
                console.log('【图片】原始大小:', (imageData.length / 1024).toFixed(1) + 'KB');
                
                // 无论大小都进行压缩，使用更激进的压缩策略
                try {
                    // 【优化】使用更小的尺寸和更低的质量
                    const compressed = await compressImage(imageData, 300, 300, 0.6);
                    if (compressed && compressed.length > 0 && compressed.length < imageData.length) {
                        displayImageData = compressed;
                        console.log('【图片】压缩后大小:', (compressed.length / 1024).toFixed(1) + 'KB');
                    }
                } catch (compressError) {
                    console.warn('【图片】压缩失败，使用原图:', compressError);
                }
                
                // 【性能优化】AI使用的图片也进行压缩，但保留更多细节
                let aiImageData = imageData;
                if (imageData.length > 2 * 1024 * 1024) { // 超过2MB才压缩AI用图
                    try {
                        const aiCompressed = await compressImage(imageData, 800, 800, 0.7);
                        if (aiCompressed && aiCompressed.length > 0) {
                            aiImageData = aiCompressed;
                        }
                    } catch (e) {
                        console.warn('【图片】AI图片压缩失败:', e);
                    }
                }
                
                // 【性能优化】如果显示图片仍然太大，进一步压缩
                const maxDisplaySize = window.__performanceConfig?.memoryLimit?.maxImageSize || 2 * 1024 * 1024;
                if (displayImageData.length > maxDisplaySize) {
                    console.warn('【图片】显示图片仍然太大，进一步压缩');
                    try {
                        const furtherCompressed = await compressImage(displayImageData, 200, 200, 0.5);
                        if (furtherCompressed && furtherCompressed.length > 0) {
                            displayImageData = furtherCompressed;
                        }
                    } catch (e) {
                        console.warn('【图片】二次压缩失败:', e);
                    }
                }
                
                // 创建消息数据
                const messageData = {
                    sender: 'user',
                    content: '[图片]', // 简化内容显示
                    timestamp: timestamp,
                    chatId: currentChatId,
                    fileName: fileName,
                    imageData: aiImageData, // 保存压缩后的图片数据供AI识别
                    displayImageData: displayImageData // 保存显示用的压缩图片
                };
                
                // 【性能优化】使用防抖保存，避免频繁写入
                relationshipData.chatMessages.push(messageData);
                
                // 显示图片消息（使用DOM操作而不是HTML字符串）
                displayImageMessageDOM(displayImageData, timestamp);
                
                // 【性能优化】延迟保存数据，避免阻塞UI
                setTimeout(async () => {
                    try {
                        await saveData();
                    } catch (saveError) {
                        console.warn('【图片】保存数据失败:', saveError);
                    }
                }, 100);
                
                // 增加用户消息计数
                try {
                    await incrementUserMessageCount();
                } catch (countError) {
                    console.warn('【图片】计数失败:', countError);
                }
                
                success = true;
                console.log('【图片】图片消息发送成功:', fileName);
            } catch (error) {
                console.error('❌ sendImageMessage 错误:', error);
                // 只有在真正失败时才显示错误提示
                if (!success) {
                    showToast('发送图片失败', 'error');
                }
            }
        }
        
        // 【新增】使用DOM操作显示图片消息 - 避免HTML字符串解析问题
        function displayImageMessageDOM(imageData, timestamp) {
            const chatContent = document.getElementById('chatContent');
            if (!chatContent) {
                console.error('❌ 找不到chatContent元素');
                return;
            }
            
            // 创建消息容器
            const messageContainer = document.createElement('div');
            messageContainer.className = 'message-container user';
            messageContainer.dataset.timestamp = timestamp;
            messageContainer.dataset.messageId = timestamp.toString();
            
            // 创建消息气泡
            const messageBubble = document.createElement('div');
            messageBubble.className = 'message-bubble';
            messageBubble.style.maxWidth = '200px';
            messageBubble.style.padding = '4px';
            messageBubble.style.background = '#FFB7C5';
            messageBubble.style.borderRadius = '12px';
            
            // 创建图片元素
            const img = document.createElement('img');
            img.src = imageData;
            img.style.maxWidth = '192px';
            img.style.maxHeight = '192px';
            img.style.borderRadius = '8px';
            img.style.objectFit = 'cover';
            img.style.cursor = 'pointer';
            img.style.display = 'block';
            
            // 点击图片显示大图
            img.onclick = function() {
                showFullImageFromThumb(this);
            };
            
            // 图片加载完成后的处理
            img.onload = function() {
                console.log('【图片】图片加载成功');
                // 尝试滚动到底部，但不强制
                try {
                    if (typeof scrollToChatBottom === 'function') {
                        scrollToChatBottom();
                    }
                } catch (e) {
                    // 忽略滚动错误
                }
            };
            
            // 图片加载失败处理 - 但对于Base64图片通常不会真正失败
            img.onerror = function() {
                console.warn('【图片】图片加载事件触发，可能是误报');
                // Base64图片通常不会因为加载失败而触发onerror
                // 如果触发了，可能是内存问题，但图片数据是正常的
                // 所以我们不显示错误，让图片保持原样
            };
            
            // 组装消息
            messageBubble.appendChild(img);
            
            // 创建头像
            const avatar = document.createElement('div');
            avatar.className = 'message-avatar';
            const personalProfile = cachedPersonalProfile || {};
            if (personalProfile.avatar) {
                const avatarImg = document.createElement('img');
                avatarImg.src = personalProfile.avatar;
                avatarImg.style.width = '40px';
                avatarImg.style.height = '40px';
                avatarImg.style.objectFit = 'cover';
                avatarImg.style.borderRadius = '50%';
                avatar.appendChild(avatarImg);
            } else {
                avatar.innerHTML = '<div style="width: 40px; height: 40px; background-color: #f0f0f0; display: flex; align-items: center; justify-content: center; font-size: 20px; border-radius: 50%;">👤</div>';
            }
            
            // 组装消息容器（用户消息：气泡在左，头像在右）
            messageContainer.appendChild(messageBubble);
            messageContainer.appendChild(avatar);
            
            // 添加到聊天内容
            chatContent.appendChild(messageContainer);
            
            // 尝试滚动到底部
            try {
                if (typeof scrollToChatBottom === 'function') {
                    scrollToChatBottom();
                }
            } catch (e) {
                // 忽略滚动错误
            }
        }

        // 处理Word文件
        async function handleWordFile(file) {
            try {
                // 读取Word文件内容
                const arrayBuffer = await file.arrayBuffer();
                
                // 使用 mammoth.js 库提取文本内容
                // 首先检查是否已经加载了 mammoth.js
                if (typeof mammoth === 'undefined') {
                    // 动态加载 mammoth.js 库
                    await loadScript('https://cdnjs.cloudflare.com/ajax/libs/mammoth/1.6.0/mammoth.browser.min.js');
                }
                
                const result = await mammoth.extractRawText({ arrayBuffer: arrayBuffer });
                const textContent = result.value;
                
                if (textContent.trim()) {
                    // 发送文件内容作为消息
                    await sendFileContentMessage(file.name, textContent, 'word');
                } else {
                    alert('Word文件内容为空');
                }
            } catch (error) {
                console.error('Word文件处理失败:', error);
                alert('Word文件处理失败，请确保文件格式正确');
            }
        }

        // 处理文本文件
        async function handleTextFile(file) {
            try {
                const textContent = await file.text();
                
                if (textContent.trim()) {
                    // 发送文件内容作为消息
                    await sendFileContentMessage(file.name, textContent, 'text');
                } else {
                    alert('文本文件内容为空');
                }
            } catch (error) {
                console.error('文本文件处理失败:', error);
                alert('文本文件处理失败');
            }
        }

        // 发送文件内容消息（卡片形式）
        async function sendFileContentMessage(fileName, content, type) {
            // 创建文件卡片HTML
            const fileId = 'file_' + Date.now() + '_' + Math.random().toString(36).substr(2, 9);
            const fileSize = formatFileSize(content.length);
            const fileTypeText = type === 'word' ? 'Word文档' : '文本文件';
            
            const cardContent = `
                <div id="${fileId}" class="file-card" style="
                    background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
                    border-radius: 12px;
                    padding: 16px;
                    margin: 8px 0;
                    cursor: pointer;
                    transition: all 0.3s ease;
                    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
                    border: 1px solid rgba(255,255,255,0.2);
                " onclick="toggleFileContent('${fileId}')">
                    <div style="display: flex; align-items: center; gap: 12px;">
                        <div style="
                            width: 40px;
                            height: 40px;
                            background: linear-gradient(45deg, #667eea 0%, #764ba2 100%);
                            border-radius: 8px;
                            display: flex;
                            align-items: center;
                            justify-content: center;
                            font-size: 20px;
                            color: white;
                        ">📄</div>
                        <div style="flex: 1;">
                            <div style="font-weight: 600; color: #333; margin-bottom: 4px;">${fileName}</div>
                            <div style="font-size: 12px; color: #666;">${fileTypeText} • ${fileSize}</div>
                        </div>
                        <div style="font-size: 16px; color: #999;">▼</div>
                    </div>
                    <div id="${fileId}_content" style="display: none; margin-top: 12px; padding-top: 12px; border-top: 1px solid rgba(0,0,0,0.1);">
                        <div style="background: rgba(255,255,255,0.8); border-radius: 8px; padding: 12px; font-size: 14px; line-height: 1.6; max-height: 300px; overflow-y: auto;">
                            <pre style="margin: 0; white-space: pre-wrap; word-wrap: break-word; font-family: inherit;">${escapeHtml(content)}</pre>
                        </div>
                    </div>
                </div>
            `;
            
            // 显示文件卡片
            displayMessage('user', cardContent);

            // 保存到聊天记录
            relationshipData.chatMessages.push({
                sender: 'user',
                content: cardContent,
                timestamp: Date.now(),
                chatId: currentChatId,
                fileInfo: {
                    fileName: fileName,
                    content: content,
                    type: type,
                    size: content.length,
                    fileId: fileId
                }
            });

            saveData();

            // 【修复】增加用户消息计数
            await incrementUserMessageCount();

            // 不再自动调用AI分析，等待用户手动点击话筒按钮
        }

        // 格式化文件大小
        function formatFileSize(bytes) {
            if (bytes < 1024) return bytes + ' B';
            if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
            return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
        }

        // 切换文件内容显示/隐藏
        function toggleFileContent(fileId) {
            const contentDiv = document.getElementById(fileId + '_content');
            const arrow = document.querySelector(`#${fileId} > div:last-child`);
            
            if (contentDiv.style.display === 'none') {
                contentDiv.style.display = 'block';
                arrow.textContent = '▲';
                arrow.style.transform = 'rotate(180deg)';
            } else {
                contentDiv.style.display = 'none';
                arrow.textContent = '▼';
                arrow.style.transform = 'rotate(0deg)';
            }
        }

        // 动态加载脚本
        function loadScript(src) {
            return new Promise((resolve, reject) => {
                const script = document.createElement('script');
                script.src = src;
                script.onload = resolve;
                script.onerror = reject;
                document.head.appendChild(script);
            });
        }

        // 分析文件内容并调用AI回复
        async function analyzeFileContent(fileName, content, type) {
            try {
                // 构建分析文件内容的提示词
                const fileTypeText = type === 'word' ? 'Word文档' : '文本文件';
                const analysisPrompt = `用户发送了一个${fileTypeText}，文件名为"${fileName}"。请分析以下内容并提供回复：

文件内容：
${content}

请根据文件内容给出适当的回复，可以总结内容、回答问题或进行讨论。`;
                
                // 构建聊天上下文并调用AI
                const context = await buildChatContext();
                context.fileContent = {
                    fileName: fileName,
                    content: content,
                    type: type
                };
                
                // 调用AI分析文件内容
                await callAIDirectlyWithContext(context, analysisPrompt);
            } catch (error) {
                console.error('AI分析文件内容失败:', error);
            }
        }

        function sendFileMessage(fileData, fileName, type, fileContent = null) {
            let content = '';
            if (type === 'audio') {
                content = `<audio controls src="${fileData}" style="max-width: 300px;"></audio>`;
            } else if (type === 'file' && fileContent) {
                // 如果是包含内容的文件，显示内容预览
                const maxLength = 500;
                let previewContent = fileContent;
                if (fileContent.length > maxLength) {
                    previewContent = fileContent.substring(0, maxLength) + '...（内容已截断）';
                }
                content = `
📄 ${fileName}
━━━━━━━━━━━━━━━━━━━━
${previewContent}
━━━━━━━━━━━━━━━━━━━━
                `;
            } else {
                content = `<a href="${fileData}" download="${fileName}" style="color: #007aff; text-decoration: none;">📎 ${fileName}</a>`;
            }
            
            displayMessage('user', content);
            
            const messageData = {
                sender: 'user',
                content: content,
                timestamp: Date.now(),
                chatId: currentChatId,
                fileName: fileName
            };
            
            // 如果有文件内容，保存到消息数据中
            if (fileContent) {
                messageData.fileInfo = {
                    fileName: fileName,
                    content: fileContent,
                    type: type,
                    size: fileContent.length
                };
            }
            
            relationshipData.chatMessages.push(messageData);
            saveData();
        }

        // OpenAI API 调用函数（基础版）
        // 【优化】支持标准对话格式，传入 messages 数组或单条 prompt
        async function callOpenAIAPI(promptOrMessages, systemPrompt = null) {
            try {
                const savedSettings = await loadAppSettings({});
                const apiKey = savedSettings.api?.apiKey || '';
                const baseUrl = savedSettings.api?.baseUrl || 'https://api.openai.com/v1';
                const model = savedSettings.api?.model || 'gpt-3.5-turbo';
                const apiTemperature = savedSettings.api?.temperature ?? 0.7;

                if (!apiKey) {
                    throw new Error('请先在设置中配置API密钥');
                }

                console.log('调用 OpenAI API:', baseUrl);
                console.log('模型:', model);

                // 构建 messages 数组
                let messages = [];

                // 如果传入的是数组，直接使用
                if (Array.isArray(promptOrMessages)) {
                    messages = promptOrMessages;
                    console.log('【API调用】使用标准对话格式，消息数:', messages.length);
                } else {
                    // 兼容旧格式：单条 prompt 字符串
                    // 如果有 systemPrompt，添加 system 消息
                    if (systemPrompt) {
                        messages.push({
                            role: 'system',
                            content: systemPrompt
                        });
                    }
                    messages.push({
                        role: 'user',
                        content: promptOrMessages
                    });
                    console.log('【API调用】使用兼容格式（单条消息）');
                }

                // 【调试】打印消息结构
                console.log('【API调用】Messages 结构:');
                messages.forEach((msg, idx) => {
                    console.log(`  [${idx}] ${msg.role}: ${msg.content?.substring(0, 50)}...`);
                });

                // 【修复】添加超时处理，防止请求卡住
                const controller = new AbortController();
                const timeoutId = setTimeout(() => controller.abort(), 300000); // 300秒超时

                const response = await fetch(`${baseUrl}/chat/completions`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${apiKey}`
                    },
                    body: JSON.stringify({
                        model: model,
                        messages: messages,
                        temperature: apiTemperature,
                        max_tokens: 2000
                    }),
                    signal: controller.signal
                });
                
                clearTimeout(timeoutId); // 请求成功，清除超时
                
                if (!response.ok) {
                    const errorText = await response.text();
                    throw new Error(`API请求失败: ${response.status} ${response.statusText} - ${errorText}`);
                }
                
                // 【防闪退】API响应解析保护
                let data;
                try {
                    const responseText = await response.text();
                    if (!responseText || responseText.trim() === '') {
                        throw new Error('API返回空响应');
                    }
                    
                    // 【防闪退】限制响应大小，避免超大响应导致内存问题
                    const MAX_RESPONSE_SIZE = 10 * 1024 * 1024; // 10MB
                    if (responseText.length > MAX_RESPONSE_SIZE) {
                        console.error('❌ API响应过大:', responseText.length, '字节');
                        throw new Error('API响应过大，可能导致内存问题');
                    }
                    
                    data = JSON.parse(responseText);
                    
                    // 【详细调试】检查API返回结构
                    console.log('🔍 callOpenAIAPI - API返回数据结构:', {
                        hasChoices: !!data.choices,
                        choicesLength: data.choices?.length,
                        hasFirstChoice: !!data.choices?.[0],
                        hasMessage: !!data.choices?.[0]?.message,
                        content: data.choices?.[0]?.message?.content,
                        contentType: typeof data.choices?.[0]?.message?.content,
                        finishReason: data.choices?.[0]?.finish_reason,
                        usage: data.usage
                    });
                } catch (parseError) {
                    console.error('❌ API响应JSON解析失败:', parseError);
                    showToast('API响应格式错误，请检查网络或API配置', 'error');
                    throw new Error('API响应JSON解析失败: ' + parseError.message);
                }
                
                if (!data.choices || !data.choices[0] || !data.choices[0].message) {
                    console.error('❌ API返回结构异常:', JSON.stringify(data, null, 2));
                    showToast('API返回数据异常', 'error');
                    throw new Error('API返回空回复');
                }
                
                const content = data.choices[0].message.content;
                
                // 【改进】检查content是否为空
                if (content === null || content === undefined || content.trim() === '') {
                    console.error('❌ AI返回空内容:', {
                        content: content,
                        finishReason: data.choices[0].finish_reason
                    });
                    
                    if (data.choices[0].finish_reason === 'content_filter') {
                        showToast('AI回复被过滤，请调整对话内容', 'warning');
                        throw new Error('API返回空回复: 内容被过滤');
                    }
                    
                    throw new Error('API返回空回复');
                }
                
                return content;
            } catch (error) {
                console.error('callOpenAIAPI 错误:', error);

                // 【手机端调试】详细记录错误信息
                const errorInfo = {
                    message: error.message,
                    name: error.name,
                    stack: error.stack,
                    baseUrl: baseUrl,
                    model: model,
                    isCapacitor: !!window.Capacitor,
                    userAgent: navigator.userAgent,
                    timestamp: new Date().toISOString()
                };
                console.error('【API错误详情】', JSON.stringify(errorInfo, null, 2));

                // 【手机端修复】处理特定的网络错误
                let userErrorMessage = error.message;

                if (error.name === 'TypeError' && error.message.includes('Failed to fetch')) {
                    userErrorMessage = '网络请求失败，可能原因：\n1. API地址无法访问\n2. 跨域被阻止\n3. 网络连接问题\n\n建议：检查API配置或切换网络';
                } else if (error.name === 'AbortError') {
                    userErrorMessage = '请求超时（5分钟），API响应过慢';
                } else if (error.message.includes('NetworkError')) {
                    userErrorMessage = '网络错误，请检查手机网络连接';
                } else if (error.message.includes('CORS')) {
                    userErrorMessage = '跨域访问被阻止，请联系API提供商';
                }

                // 【防闪退】显示错误提示而不是直接崩溃
                if (error.message && !error.message.includes('API响应JSON解析失败')) {
                    showToast('API调用失败: ' + userErrorMessage, 'error');
                }
                throw error;
            }
        }

        async function callAIWithImage(imageData, fileName, senderChatItem = null) {
            const chatContent = document.getElementById('chatContent');
            if (!chatContent) return;
            
            const chatItem = senderChatItem || relationshipData.wechatChatList.find(item => item.id == currentChatId);
            if (!chatItem) return;
            
            console.log('callAIWithImage - chatItem:', chatItem.name, 'senderChatItem:', senderChatItem ? senderChatItem.name : 'null');
            
            const aiName = chatItem.name;
            const userNickname = chatItem.myNickname || '';
            
            let contextLength = 20;
            if (chatItem && chatItem.contextLength) {
                contextLength = chatItem.contextLength;
            }
            
            // 【关键修复】获取当前聊天消息并去重（基于时间戳）
            const currentChatMessages = relationshipData.chatMessages.filter(msg => msg.chatId === currentChatId);
            const uniqueMessages = [];
            const seenTimestamps = new Set();
            for (const msg of currentChatMessages) {
                if (!seenTimestamps.has(msg.timestamp)) {
                    seenTimestamps.add(msg.timestamp);
                    uniqueMessages.push(msg);
                }
            }
            if (uniqueMessages.length < currentChatMessages.length) {
                console.log('【关键修复】上下文去重：从', currentChatMessages.length, '条去重到', uniqueMessages.length, '条');
            }
            const recentMessages = uniqueMessages.slice(-contextLength);
            
            let worldbookContent = '';
            if (chatItem && chatItem.worldbook) {
                const worldbookId = chatItem.worldbook;
                const worldbook = relationshipData.worldBooks.find(book => book.id == worldbookId);
                if (worldbook) {
                    worldbookContent = worldbook.content;
                }
            }
            
            let relationshipInfo = null;
            if (currentChatId && relationshipData.selectedCharacterId == currentChatId && relationshipData.characterRelationships) {
                const characterRelation = relationshipData.characterRelationships[currentChatId];
                if (characterRelation) {
                    relationshipInfo = {
                        title: characterRelation.title || relationshipData.title,
                        startDate: characterRelation.startDate ? new Date(characterRelation.startDate) : relationshipData.startDate,
                        description: characterRelation.description || relationshipData.description,
                        mood: characterRelation.mood || relationshipData.mood
                    };
                }
            }
            
            const context = {
                relationshipInfo: relationshipInfo,
                aiName: aiName,
                userNickname: userNickname,
                recentMessages: recentMessages,
                worldbookContent: worldbookContent,
                currentTime: new Date().toLocaleString('zh-CN')
            };
            
            let prompt = `
【图片识别任务】
用户刚刚发送了一张图片，请仔细观察并识别图片中的内容，包括但不限于：
- 图片中的主要场景和背景
- 图片中的人物（如果有）
- 图片中的物体和物品
- 图片中的文字（如果有）
- 图片的颜色和风格
- 图片的整体氛围和情感

请根据图片内容生成一个自然、贴切的回复。
`;
            
            if (context.relationshipInfo) {
                prompt += `
关系信息：
- 关系标题：${context.relationshipInfo.title}
- 开始日期：${context.relationshipInfo.startDate.toLocaleDateString()}
- 关系描述：${context.relationshipInfo.description || '无'}
- 当前心情：${context.relationshipInfo.mood.emoji} ${context.relationshipInfo.mood.text}

`;
            }
            
            if (aiName) {
                prompt += `AI信息：
- 本名：${aiName}
`;
            }
            
            if (context.personality) {
                prompt += `- 角色人设描述：${context.personality}
`;
            }
            
            if (userNickname) {
                prompt += `- 用户昵称：${userNickname}

`;
            }
            
            if (context.worldbookContent) {
                prompt += `世界书内容：
${context.worldbookContent}

`;
            }
            
            // 【改进】分离历史消息和当前图片消息
            // 找到AI最后一条回复的位置，之后的所有消息都是"最新消息"
            const allMessages = context.recentMessages || [];
            let lastAIReplyIndex = -1;
            for (let i = allMessages.length - 1; i >= 0; i--) {
                if (allMessages[i].sender === 'ai') {
                    lastAIReplyIndex = i;
                    break;
                }
            }
            
            // 历史消息：到AI最后一条回复为止（包括那条AI回复）
            const historyMessages = lastAIReplyIndex >= 0 ? allMessages.slice(0, lastAIReplyIndex + 1) : [];
            // 当前需要回复的消息：AI最后回复之后的所有消息（可能包含多张图片）
            const currentMessages = lastAIReplyIndex >= 0 ? allMessages.slice(lastAIReplyIndex + 1) : allMessages;
            
            // 构建历史聊天记录
            let chatHistory = '';
            if (historyMessages.length > 0) {
                chatHistory = `==============================\n`;
                historyMessages.forEach(msg => {
                    // 确保 content 是字符串
                    const content = ensureStringContent(msg.content);
                    const msgTime = msg.timestamp ? new Date(msg.timestamp).toLocaleTimeString('zh-CN', {hour: '2-digit', minute: '2-digit'}) : '';
                    
                    // 【修复】处理引用信息，如果消息包含引用，显示引用内容
                    let quoteText = '';
                    if (msg.quote && msg.quote.content) {
                        // 【修复】支持没有发送者名称的引用
                        quoteText = msg.quote.senderName ? 
                            `[引用 ${msg.quote.senderName}: ${msg.quote.content}] ` :
                            `[引用 ${msg.quote.content}] `;
                    }
                    
                    if (content.includes('<img')) {
                        chatHistory += `${msg.sender === 'user' ? '用户' : 'AI'} [${msgTime}]：${quoteText}[图片]\n`;
                    } else if (content.includes('<audio')) {
                        chatHistory += `${msg.sender === 'user' ? '用户' : 'AI'} [${msgTime}]：${quoteText}[语音]\n`;
                    } else {
                        chatHistory += `${msg.sender === 'user' ? '用户' : 'AI'} [${msgTime}]：${quoteText}${content}\n`;
                    }
                });
                chatHistory += `==============================\n`;
            }
            
            if (historyMessages.length > 0) {
                prompt += `【历史聊天记录 - 必须结合上下文回复】\n`;
                prompt += `以下是你和用户的完整对话历史，回复时必须结合这些上下文：\n`;
                prompt += `- 理解对话的连贯性和话题发展\n`;
                prompt += `- 参考之前的讨论内容做出相关回应\n`;
                prompt += `- 不要重复回复已经回复过的内容\n\n`;
                prompt += `${chatHistory}\n`;
            }
            
            // 构建当前需要回复的消息（可能包含多张图片）
            prompt += `>>> 当前需要回复的新消息 <<<\n`;
            if (currentMessages.length > 0) {
                currentMessages.forEach(msg => {
                    const content = ensureStringContent(msg.content);
                    const msgTime = msg.timestamp ? new Date(msg.timestamp).toLocaleTimeString('zh-CN', {hour: '2-digit', minute: '2-digit'}) : '';
                    
                    // 【修复】处理引用信息，如果消息包含引用，显示引用内容
                    let quoteText = '';
                    if (msg.quote && msg.quote.content) {
                        // 【修复】支持没有发送者名称的引用
                        quoteText = msg.quote.senderName ? 
                            `[引用 ${msg.quote.senderName}: ${msg.quote.content}] ` :
                            `[引用 ${msg.quote.content}] `;
                    }
                    
                    if (content.includes('<img')) {
                        prompt += `用户 [${msgTime}]：${quoteText}[图片]\n`;
                    } else if (content.includes('<audio')) {
                        prompt += `用户 [${msgTime}]：${quoteText}[语音]\n`;
                    } else {
                        prompt += `用户 [${msgTime}]：${quoteText}${content}\n`;
                    }
                });
            }
            // 添加当前发送的图片
            prompt += `用户发送了一张图片，文件名：${fileName}\n`;
            prompt += `【重要】请仔细观察用户发送的图片，识别图片中的内容、场景、人物、物体、文字等信息。\n\n`;
            
            prompt += `【当前时间】${context.currentTime}\n\n`;
            
            prompt += `请回复用户发送的图片内容。要求：
1. 基于图片内容生成相应的回复
2. 不用感到拘束，你是绝对自由的，可以表达善意和关怀也可以表达不满

重要提醒：
1. 每次回复请发送3-8条消息，不要每次都回复相同条数，保持变化
2. 将长内容拆分为短句，模拟真实聊天体验
3. 句末可以不使用标点符号，这是线上聊天环境
4. 不要滥用标点符号，保持简洁自然
5. 适度使用表情符号，不要过度使用
6. 如果你注意到用户撤回了消息，可以理解这可能是打错字、回避话题或害怕等原因
7. 你也可以撤回用户的消息，使用撤回格式
8. 你也可以撤回自己的消息，使用撤回格式

【特别注意】
- 用户引用某条消息时，那是要回复的消息，不是要撤回的消息
- 如果你想撤回自己的某条消息，必须明确指定撤回的是你自己之前发送的消息内容
- 所有格式标签（[QUOTE]、[/QUOTE]、[UNDO]、[/UNDO]、[CALL]、[/CALL]）必须使用英文半角字符，不能使用中文全角字符
- 标签和内容之间必须用冒号分隔，冒号后必须有空格
- 标签必须成对出现，不能遗漏结束标签
- 使用[CALL]标签时，会触发来电界面，用户可以选择接听或拒绝

【完整示例】
示例1：带引用的回复
[QUOTE]用户: 你今天吃什么了[/QUOTE]我吃了一碗面
====
味道还不错
====
你呢

示例2：撤回用户消息
[UNDO]用户: 我爱你[/UNDO]
====
撤回了吧

示例3：撤回自己的消息
[UNDO]AI: 我不喜欢你[/UNDO]
====
我开玩笑的
====
其实我很喜欢你

示例4：普通回复
今天天气真好
====
要不要一起出去玩
====
我想你了
`;
            
            try {
                const savedSettings = await loadAppSettings({});
                const modelName = savedSettings.api?.model || 'gpt-4o';
                const apiUrl = savedSettings.api?.baseUrl || 'https://api.openai.com/v1';
                const apiKey = savedSettings.api?.apiKey || '';
                const apiTemperature = savedSettings.api?.temperature ?? 0.7;
                
                if (!apiKey) {
                    throw new Error('请先在设置中配置API密钥');
                }
                
                console.log('发送图片请求，模型:', modelName);
                console.log('图片数据长度:', imageData.length);
                console.log('图片数据前缀:', imageData.substring(0, 100));
                
                const requestBody = {
                    model: modelName,
                    messages: [
                        {
                            role: 'user',
                            content: [
                                {
                                    type: 'text',
                                    text: prompt
                                },
                                {
                                    type: 'image_url',
                                    image_url: {
                                        url: imageData
                                    }
                                }
                            ]
                        }
                    ],
                    temperature: apiTemperature,
                    max_tokens: 2000
                };
                
                console.log('请求体:', JSON.stringify(requestBody, null, 2));
                
                // 【修复】添加超时处理，防止请求卡住
                const controller = new AbortController();
                const timeoutId = setTimeout(() => controller.abort(), 300000); // 【修改】300秒超时
                
                const response = await fetch(`${apiUrl}/chat/completions`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${apiKey}`
                    },
                    body: JSON.stringify(requestBody),
                    signal: controller.signal
                });
                
                clearTimeout(timeoutId); // 请求成功，清除超时
                
                if (!response.ok) {
                    throw new Error(`API请求失败: ${response.status}`);
                }
                
                // 【防闪退】API响应解析保护
                let data;
                try {
                    const responseText = await response.text();
                    if (!responseText || responseText.trim() === '') {
                        throw new Error('API返回空响应');
                    }
                    data = JSON.parse(responseText);
                    console.log('响应数据:', JSON.stringify(data, null, 2));
                } catch (parseError) {
                    console.error('❌ API响应JSON解析失败:', parseError);
                    showToast('API响应格式错误，请检查网络或API配置', 'error');
                    throw new Error('API响应JSON解析失败: ' + parseError.message);
                }
                
                // 【详细调试】检查API返回结构
                console.log('🔍 API返回数据结构:', {
                    hasChoices: !!data.choices,
                    choicesLength: data.choices?.length,
                    hasFirstChoice: !!data.choices?.[0],
                    hasMessage: !!data.choices?.[0]?.message,
                    messageKeys: data.choices?.[0]?.message ? Object.keys(data.choices[0].message) : 'N/A',
                    content: data.choices?.[0]?.message?.content,
                    contentType: typeof data.choices?.[0]?.message?.content,
                    contentLength: data.choices?.[0]?.message?.content?.length,
                    finishReason: data.choices?.[0]?.finish_reason,
                    usage: data.usage
                });
                
                if (!data.choices || !data.choices[0] || !data.choices[0].message) {
                    console.error('❌ API返回结构异常:', JSON.stringify(data, null, 2));
                    showToast('API返回数据异常', 'error');
                    throw new Error('空回复');
                }
                
                let aiResponse = data.choices[0].message.content;
                
                // 【智能格式修复】自动修复格式错误
                aiResponse = await fixMessageFormat(aiResponse);
                
                // 【详细调试】检查content字段
                console.log('🔍 AI响应内容检查:', {
                    content: aiResponse,
                    type: typeof aiResponse,
                    isNull: aiResponse === null,
                    isUndefined: aiResponse === undefined,
                    length: aiResponse?.length,
                    trimmedLength: aiResponse?.trim()?.length,
                    finishReason: data.choices[0].finish_reason
                });
                
                // 【改进】检查更多空回情况
                if (aiResponse === null || aiResponse === undefined) {
                    console.error('❌ AI返回null/undefined内容');
                    showToast('AI未生成回复（可能被过滤）', 'warning');
                    throw new Error('空回复: content为null/undefined');
                }
                
                if (aiResponse.trim() === '') {
                    console.error('❌ AI返回空字符串');
                    showToast('AI返回空内容（可能被过滤）', 'warning');
                    throw new Error('空回复: content为空字符串');
                }
                
                // 【新增】检查finish_reason
                const finishReason = data.choices[0].finish_reason;
                if (finishReason === 'content_filter') {
                    console.error('❌ AI回复被内容过滤器拦截');
                    showToast('AI回复被过滤，请调整对话内容', 'warning');
                    throw new Error('空回复: 内容被过滤');
                }
                
                // 检查回复是否包含多条消息（使用====分隔）
                if (aiResponse.includes('====')) {
                    // 分割成多条消息
                    const messages = aiResponse.split('====').map(msg => msg.trim()).filter(msg => msg);
                    
                    // 逐条显示消息
                    for (const message of messages) {
                        // 先检查是否是撤回操作
                        const undoData = parseUndoFromMessage(message);
                        if (undoData && undoData.undo) {
                            // 执行撤回操作，根据发送者决定撤回谁的消息
                            const targetSender = undoData.sender === '用户' ? 'user' : (undoData.sender === 'AI' ? 'ai' : null);
                            if (targetSender) {
                                await undoMessage(undoData.undo, targetSender);
                            } else {
                                // 兼容旧格式，没有指定发送者
                                await undoMessage(undoData.undo);
                            }
                            continue;
                        }
                        
                        // 检查是否是语音条操作
                        const voiceData = parseVoiceFromMessage(message);
                        if (voiceData && voiceData.transcript) {
                            // 生成语音条内容（使用转文字内容）
                            const voiceContent = `data:audio/wav;base64,UklGRiQAAABXQVZFZm10IBAAAAABAAEAQB8AAEAfAAABAAgAZGF0YQAAAAA=`;
                            const voiceDuration = Math.max(3, Math.ceil(voiceData.transcript.length / 5));
                            const voiceUrl = `${voiceContent}?duration=${voiceDuration}&transcript=${encodeURIComponent(voiceData.transcript)}`;

                            // 【关键修复】先生成timestamp，再显示消息
                            const voiceTimestamp = Date.now();

                            // 显示语音条消息【关键修复】传递timestamp参数
                            await displayMessage('ai', voiceUrl, false, null, 'voice', true, voiceTimestamp, chatItem);

                            // 【关键修复】将AI语音消息保存到ChatMessageManager（SQLite/IndexedDB）
                            const voiceMessage = {
                                sender: 'ai',
                                senderName: chatItem.name,
                                senderAvatar: chatItem.avatar,
                                content: voiceUrl,
                                timestamp: voiceTimestamp,
                                chatId: currentChatId,
                                type: 'voice',
                                isGroupChat: chatItem.isGroupChat
                            };
                            relationshipData.chatMessages.push(voiceMessage);
                            ChatMessageManager.saveMessage(voiceMessage).catch(err => console.error('保存AI语音消息失败:', err));
                            await saveData();
                            
                            // 如果还有其他内容，也显示出来
                            if (voiceData.content) {
                                let quoteData = parseQuoteFromMessage(voiceData.content);
                                // 【修复】处理引用发送者名称，将"用户"替换为实际昵称
                                const chatItemForVoice = relationshipData.wechatChatList.find(item => item.id == currentChatId);
                                quoteData = processQuoteSenderName(quoteData, chatItemForVoice);
                                const actualContent = quoteData ? quoteData.content : voiceData.content;
                                await displayMessage('ai', actualContent, false, quoteData ? quoteData.quote : null);
                                relationshipData.chatMessages.push({
                                    sender: 'ai',
                                    content: actualContent,
                                    timestamp: Date.now(),
                                    chatId: currentChatId,
                                    quote: quoteData ? quoteData.quote : null
                                });
                                await saveData();
                            }
                            continue;
                        }
                        
                        // 【新增】检查是否是信件操作
                        const letterData = parseLetterFromMessage(message);
                        if (letterData && letterData.letterContent) {
                            // 保存信件到信件格子
                            const chatItemForLetter = relationshipData.wechatChatList.find(item => item.id == currentChatId);
                            if (chatItemForLetter) {
                                // 添加信件（会自动保存到localStorage）
                                addNewLetter(
                                    letterData.letterContent,
                                    letterData.event || '',
                                    null, // 使用当前日期
                                    letterData.festival || '',
                                    chatItemForLetter.id,
                                    chatItemForLetter.remark || chatItemForLetter.name
                                );
                                
                                // 显示提示
                                showToast(`${chatItemForLetter.remark || chatItemForLetter.name}给你写了一封信！`, 'success');
                                
                                // 如果还有其他内容，也显示出来
                                if (letterData.content) {
                                    let quoteData = parseQuoteFromMessage(letterData.content);
                                    quoteData = processQuoteSenderName(quoteData, chatItemForLetter);
                                    const actualContent = quoteData ? quoteData.content : letterData.content;
                                    await displayMessage('ai', actualContent, false, quoteData ? quoteData.quote : null);
                                    relationshipData.chatMessages.push({
                                        sender: 'ai',
                                        content: actualContent,
                                        timestamp: Date.now(),
                                        chatId: currentChatId,
                                        quote: quoteData ? quoteData.quote : null
                                    });
                                    await saveData();
                                }
                            }
                            continue;
                        }
                        
                        // 解析引用格式
                        let quoteData = parseQuoteFromMessage(message);
                        // 【修复】处理引用发送者名称，将"用户"替换为实际昵称
                        const chatItemForQuote = relationshipData.wechatChatList.find(item => item.id == currentChatId);
                        quoteData = processQuoteSenderName(quoteData, chatItemForQuote);
                        const actualContent = quoteData ? quoteData.content : message;

                        // 解析心声格式
                        const thoughtData = parseInnerThoughtFromMessage(actualContent);
                        const finalContent = thoughtData ? thoughtData.content : actualContent;

                        // 【关键修复】先生成timestamp，再显示消息
                        const aiReplyTimestamp = Date.now();

                        // 显示AI回复（传递心声内容）【关键修复】传递timestamp参数
                        await displayMessage('ai', finalContent, false, quoteData ? quoteData.quote : null, 'text', true, aiReplyTimestamp, null, thoughtData ? thoughtData.thought : null);

                        // 将AI回复添加到存储数组
                        relationshipData.chatMessages.push({
                            sender: 'ai',
                            content: finalContent,
                            timestamp: aiReplyTimestamp,
                            chatId: currentChatId,
                            quote: quoteData ? quoteData.quote : null
                        });
                        
                        // 保存数据到localforage
                        await saveData();
                        
                        // 每条消息之间添加延迟，模拟真人回复（2-3秒随机延迟）
                        if (messages.indexOf(message) < messages.length - 1) {
                            const delay = 2000 + Math.random() * 1000; // 2-3秒随机延迟
                            await new Promise(resolve => setTimeout(resolve, delay));
                        }
                    }
                } else {
                    // 先检查是否是撤回操作
                    const undoData = parseUndoFromMessage(aiResponse);
                    if (undoData && undoData.undo) {
                        // 执行撤回操作，根据发送者决定撤回谁的消息
                        const targetSender = undoData.sender === '用户' ? 'user' : (undoData.sender === 'AI' ? 'ai' : null);
                        if (targetSender) {
                            await undoMessage(undoData.undo, targetSender);
                        } else {
                            // 兼容旧格式，没有指定发送者
                            await undoMessage(undoData.undo);
                        }
                    } else {
                        // 检查是否是语音条操作
                        const voiceData = parseVoiceFromMessage(aiResponse);
                        if (voiceData && voiceData.transcript) {
                            // 生成语音条内容（使用转文字内容）
                            const voiceContent = `data:audio/wav;base64,UklGRiQAAABXQVZFZm10IBAAAAABAAEAQB8AAEAfAAABAAgAZGF0YQAAAAA=`;
                            const voiceDuration = Math.max(3, Math.ceil(voiceData.transcript.length / 5));
                            const voiceUrl = `${voiceContent}?duration=${voiceDuration}&transcript=${encodeURIComponent(voiceData.transcript)}`;

                            // 【关键修复】先生成timestamp，再显示消息
                            const voiceTimestamp = Date.now();

                            // 显示语音条消息【关键修复】传递timestamp参数
                            await displayMessage('ai', voiceUrl, false, null, 'voice', true, voiceTimestamp, chatItem);

                            // 【关键修复】将AI语音消息保存到ChatMessageManager（SQLite/IndexedDB）
                            const voiceMessage = {
                                sender: 'ai',
                                senderName: chatItem.name,
                                senderAvatar: chatItem.avatar,
                                content: voiceUrl,
                                timestamp: voiceTimestamp,
                                chatId: currentChatId,
                                type: 'voice',
                                isGroupChat: chatItem.isGroupChat
                            };
                            relationshipData.chatMessages.push(voiceMessage);
                            ChatMessageManager.saveMessage(voiceMessage).catch(err => console.error('保存AI语音消息失败:', err));
                            await saveData();
                            
                            // 如果还有其他内容，也显示出来
                            if (voiceData.content) {
                                let quoteData = parseQuoteFromMessage(voiceData.content);
                                // 【修复】处理引用发送者名称，将"用户"替换为实际昵称
                                quoteData = processQuoteSenderName(quoteData, chatItem);
                                const actualContent = quoteData ? quoteData.content : voiceData.content;
                                await displayMessage('ai', actualContent, false, quoteData ? quoteData.quote : null);
                                const textMessage = {
                                    sender: 'ai',
                                    content: actualContent,
                                    timestamp: Date.now(),
                                    chatId: currentChatId,
                                    quote: quoteData ? quoteData.quote : null
                                };
                                relationshipData.chatMessages.push(textMessage);
                                ChatMessageManager.saveMessage(textMessage).catch(err => console.error('保存AI文本消息失败:', err));
                                await saveData();
                            }
                        } else {
                            // 【新增】检查是否是信件操作
                            const letterData = parseLetterFromMessage(aiResponse);
                            if (letterData && letterData.letterContent) {
                                // 保存信件到信件格子
                                if (chatItem) {
                                    // 添加信件（会自动保存到localStorage）
                                    addNewLetter(
                                        letterData.letterContent,
                                        letterData.event || '',
                                        null, // 使用当前日期
                                        letterData.festival || '',
                                        chatItem.id,
                                        chatItem.remark || chatItem.name
                                    );
                                    
                                    // 显示提示
                                    showToast(`${chatItem.remark || chatItem.name}给你写了一封信！`, 'success');
                                    
                                    // 如果还有其他内容，也显示出来
                                    if (letterData.content) {
                                        let quoteData = parseQuoteFromMessage(letterData.content);
                                        quoteData = processQuoteSenderName(quoteData, chatItem);
                                        const actualContent = quoteData ? quoteData.content : letterData.content;
                                        await displayMessage('ai', actualContent, false, quoteData ? quoteData.quote : null);
                                        const textMessage = {
                                            sender: 'ai',
                                            content: actualContent,
                                            timestamp: Date.now(),
                                            chatId: currentChatId,
                                            quote: quoteData ? quoteData.quote : null
                                        };
                                        relationshipData.chatMessages.push(textMessage);
                                        ChatMessageManager.saveMessage(textMessage).catch(err => console.error('保存AI文本消息失败:', err));
                                        await saveData();
                                    }
                                }
                            } else {
                                // 解析引用格式
                                let quoteData = parseQuoteFromMessage(aiResponse);
                                // 【修复】处理引用发送者名称，将"用户"替换为实际昵称
                                quoteData = processQuoteSenderName(quoteData, chatItem);
                                const actualContent = quoteData ? quoteData.content : aiResponse;

                                // 解析心声格式
                                const thoughtData = parseInnerThoughtFromMessage(actualContent);
                                const finalContent = thoughtData ? thoughtData.content : actualContent;

                                // 【关键修复】先生成timestamp，再显示消息
                                const aiResponseTimestamp = Date.now();

                                // 显示AI回复（传递心声内容）【关键修复】传递timestamp参数
                                displayMessage('ai', finalContent, false, quoteData ? quoteData.quote : null, 'text', true, aiResponseTimestamp, null, thoughtData ? thoughtData.thought : null);

                                // 将AI回复添加到存储数组
                                relationshipData.chatMessages.push({
                                    sender: 'ai',
                                    content: finalContent,
                                    timestamp: aiResponseTimestamp,
                                    chatId: currentChatId,
                                    quote: quoteData ? quoteData.quote : null
                                });
                                
                                // 保存数据到localStorage
                                saveData();
                            }
                        }
                    }
                }
            } catch (error) {
                console.error('调用AI API失败:', error);
                
                let errorMessage = '未知错误';
                
                if (error.message.includes('空回复')) {
                    errorMessage = 'AI返回了空回复';
                } else if (error.message.includes('403')) {
                    errorMessage = 'API密钥无效或权限不足 (403)';
                } else if (error.message.includes('500')) {
                    errorMessage = '服务器内部错误 (500)';
                } else if (error.message.includes('503')) {
                    errorMessage = '服务不可用 (503)';
                } else if (error.message.includes('502')) {
                    errorMessage = '网关错误 (502)';
                } else if (error.message.includes('504')) {
                    errorMessage = '网关超时 (504)';
                } else if (error.message.includes('400')) {
                    errorMessage = '请求参数错误 (400)';
                } else if (error.message.includes('401')) {
                    errorMessage = '未授权 (401)';
                } else if (error.message.includes('404')) {
                    errorMessage = 'API地址不存在 (404)';
                } else if (error.message.includes('429')) {
                    errorMessage = '请求过于频繁 (429)';
                } else if (error.message.includes('timeout')) {
                    errorMessage = '请求超时';
                } else if (error.message.includes('network')) {
                    errorMessage = '网络连接失败';
                } else {
                    errorMessage = error.message;
                }
                
                showCustomAlert('AI回复失败', `错误原因：${errorMessage}\n\n请检查API配置或稍后再试`);
            }
        }

