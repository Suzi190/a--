                // 19. 迁移恶魔测验数据
                console.log('【数据迁移】迁移恶魔测验数据...');
                migrationToast.innerHTML = '<div>📦 正在迁移恶魔测验...</div>';
                try {
                    const demonQuizzes = await localforage.getItem('demonQuizzes') || [];
                    if (demonQuizzes.length > 0) {
                        await SQLiteManager.saveDemonQuizzes(demonQuizzes);
                        migratedCount++;
                        console.log('【数据迁移】恶魔测验数据迁移完成:', demonQuizzes.length, '个');
                    }
                    const demonQuizData = await localforage.getItem('demonQuizData');
                    if (demonQuizData) {
                        await SQLiteManager.saveDemonQuizState('demonQuizData', demonQuizData);
                        migratedCount++;
                        console.log('【数据迁移】恶魔测验状态迁移完成');
                    }
                } catch (e) {
                    console.warn('【数据迁移】恶魔测验数据迁移失败:', e);
