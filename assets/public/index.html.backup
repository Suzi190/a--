                        } else {
                            console.log('【防闪退】AI语音合成成功, blob类型:', result.data.type, '大小:', result.data.size);
                            return result.data;
                        }
                    } else {
                        console.log('【语音合成】使用 fetch API');
                        response = await fetch(url, {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'Authorization': `Bearer ${minimaxConfig.apiKey}`
