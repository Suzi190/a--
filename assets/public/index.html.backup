        // AI使用工具修改个人资料
        async function updateAIProfile(args, aiId) {
            console.log('AI修改个人资料:', args, 'AI ID:', aiId);
            
            const { field, value } = args;
            
            // 查找AI数据
            const aiChat = relationshipData.wechatChatList.find(chat => chat.id === aiId);
            if (!aiChat) {
                return { success: false, error: '未找到AI数据' };
            }
            
            try {
                if (field === 'wechatId') {
                    // 检查是否已经修改过微信号
                    if (aiChat.wechatIdChanged) {
                        return { success: false, error: '每个AI只能修改一次微信号，你已经修改过了' };
                    }
                    
                    // 验证微信号格式
                    const wechatIdRegex = /^[a-zA-Z0-9_]{6,20}$/;
                    if (!wechatIdRegex.test(value)) {
                        return { success: false, error: '微信号只能包含6-20位字母、数字或下划线' };
                    }
                    
                    // 检查是否与其他AI重复
                    const isDuplicate = relationshipData.wechatChatList.some(chat => 
                        chat.id !== aiId && chat.wechatId === value
                    );
                    if (isDuplicate) {
                        return { success: false, error: '该微信号已被其他AI使用' };
                    }
                    
                    // 修改微信号
                    aiChat.wechatId = value;
                    aiChat.wechatIdChanged = true;
                    await saveData();
                    
                    console.log('AI微信号修改成功:', value);
                    return { 
                        success: true, 
                        message: `微信号修改成功！你的新微信号是：${value}。注意：每个AI只能修改一次微信号。`,
                        field: 'wechatId',
                        value: value
                    };
                    
                } else if (field === 'signature') {
                    // 修改签名
                    aiChat.signature = value.trim();
                    await saveData();
                    
                    console.log('AI签名修改成功:', value);
                    return { 
                        success: true, 
                        message: `个性签名修改成功！你的新签名是："${value || '暂无签名'}"`,
                        field: 'signature',
                        value: value
                    };
                }
                
                return { success: false, error: '未知的字段类型' };
            } catch (error) {
                console.error('修改个人资料失败:', error);
                return { success: false, error: '修改失败，请稍后重试' };
            }
        }

        // 编辑AI微信号
        function editAIWechatId() {
            if (!currentAIProfileId) return;
            
            const aiChat = relationshipData.wechatChatList.find(chat => chat.id === currentAIProfileId);
            if (!aiChat) return;
            
            // 检查是否已经修改过微信号
            if (aiChat.wechatIdChanged) {
                showCustomAlert('提示', '每个AI只能修改一次微信号', 'alert');
                return;
            }
            
            const currentWechatId = aiChat.wechatId || '00000000';
            const newWechatId = prompt('请输入新的微信号（每个AI只能修改一次）：', currentWechatId);
            
            if (newWechatId && newWechatId.trim() !== '' && newWechatId !== currentWechatId) {
                // 验证微信号格式（只允许字母、数字、下划线，6-20位）
                const wechatIdRegex = /^[a-zA-Z0-9_]{6,20}$/;
                if (!wechatIdRegex.test(newWechatId)) {
                    showCustomAlert('错误', '微信号只能包含6-20位字母、数字或下划线', 'alert');
                    return;
                }
                
                // 检查是否与其他AI重复
                const isDuplicate = relationshipData.wechatChatList.some(chat => 
                    chat.id !== currentAIProfileId && chat.wechatId === newWechatId
                );
                if (isDuplicate) {
                    showCustomAlert('错误', '该微信号已被其他AI使用', 'alert');
                    return;
                }
                
                aiChat.wechatId = newWechatId;
                aiChat.wechatIdChanged = true; // 标记已修改过
                saveData();
                
                // 更新显示
                document.getElementById('aiFriendProfileWechatId').textContent = newWechatId;
                document.getElementById('aiProfileWechatId').textContent = newWechatId;
                
                showCustomAlert('成功', '微信号修改成功', 'alert');
            }
        }

        // 编辑AI签名
        function editAISignature() {
            if (!currentAIProfileId) return;
            
            const aiChat = relationshipData.wechatChatList.find(chat => chat.id === currentAIProfileId);
            if (!aiChat) return;
            
            const currentSignature = aiChat.signature || '';
            const newSignature = prompt('请输入新的签名：', currentSignature);
            
            if (newSignature !== null) { // 用户点击了确定（即使是空字符串）
                aiChat.signature = newSignature.trim();
                saveData();
                
                // 更新显示
                const displaySignature = aiChat.signature || '暂无签名';
                document.getElementById('aiFriendProfileSignature').textContent = displaySignature;
                document.getElementById('aiMomentsSignature').textContent = displaySignature;
            }
        }

