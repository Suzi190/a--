        // 微信底部导航切换
        function switchWechatTab(tab) {
            console.log('切换到微信标签:', tab);
            
            // 移除所有标签的active类并恢复默认图标
            const navItems = document.querySelectorAll('.wechat-nav-item');
            navItems.forEach(item => {
                item.classList.remove('active');
                // 恢复默认图标
                const icon = item.querySelector('.wechat-nav-icon img');
                if (icon) {
                    if (item.querySelector('.wechat-nav-label').textContent === '微信') {
                        icon.src = 'https://s41.ax1x.com/2026/01/20/pZ64Yb8.jpg';
                    } else if (item.querySelector('.wechat-nav-label').textContent === '通讯录') {
                        icon.src = 'https://s41.ax1x.com/2026/01/22/pZcoPW4.jpg';
                    } else if (item.querySelector('.wechat-nav-label').textContent === '发现') {
                        icon.src = 'https://s41.ax1x.com/2026/01/22/pZco9FU.jpg';
                    } else if (item.querySelector('.wechat-nav-label').textContent === '我的') {
                        icon.src = 'https://s41.ax1x.com/2026/01/22/pZcoCYF.jpg';
                    }
                }
            });
            
            // 为当前标签添加active类并更新图标
            const activeItem = document.querySelector(`[onclick="switchWechatTab('${tab}')"]`);
            if (activeItem) {
                activeItem.classList.add('active');
                // 更新active图标
                const icon = activeItem.querySelector('.wechat-nav-icon img');
                if (icon) {
                    if (tab === 'chat') {
                        icon.src = 'https://s41.ax1x.com/2026/01/20/pZ64NVS.jpg';
                    } else if (tab === 'contacts') {
                        icon.src = 'https://s41.ax1x.com/2026/01/22/pZcIzwV.jpg';
                    } else if (tab === 'discover') {
                        icon.src = 'https://s41.ax1x.com/2026/01/22/pZcoSoT.jpg';
                    } else if (tab === 'me') {
                        icon.src = 'https://s41.ax1x.com/2026/01/22/pZcIxe0.jpg';
                    }
                }
            }
            
            // 获取顶栏标题元素
            const wechatHeaderTitle = document.querySelector('.wechat-header h1');
            
            // 处理微信聊天标签
            if (tab === 'chat') {
                // 显示聊天视图，隐藏其他视图
                const chatView = document.getElementById('wechatChatView');
                const contactsView = document.getElementById('wechatContactsView');
                const meView = document.getElementById('wechatMeView');
                if (chatView) chatView.style.display = 'block';
                if (contactsView) contactsView.style.display = 'none';
                if (meView) meView.style.display = 'none';

                // 更新顶栏标题
                if (wechatHeaderTitle) wechatHeaderTitle.textContent = '微信';
            }

            // 处理通讯录标签页
            if (tab === 'contacts') {
                // 隐藏其他视图，显示通讯录视图
                const chatView = document.getElementById('wechatChatView');
                const contactsView = document.getElementById('wechatContactsView');
                const meView = document.getElementById('wechatMeView');
                if (chatView) chatView.style.display = 'none';
                if (contactsView) {
                    contactsView.style.display = 'block';
                    renderWechatContactsList();
                }
                if (meView) meView.style.display = 'none';

                // 更新顶栏标题
                if (wechatHeaderTitle) wechatHeaderTitle.textContent = '通讯录';
            }
            
            // 处理"我的"标签页
            if (tab === 'me') {
                // 隐藏其他视图，显示我的视图
                const chatView = document.getElementById('wechatChatView');
                const contactsView = document.getElementById('wechatContactsView');
                const meView = document.getElementById('wechatMeView');
                if (chatView) chatView.style.display = 'none';
                if (contactsView) contactsView.style.display = 'none';
                if (meView) {
                    meView.style.display = 'block';
                    // 异步渲染
                    renderWechatMeView().catch(console.error);
                }
                
                // 更新顶栏标题
                if (wechatHeaderTitle) wechatHeaderTitle.textContent = '我';
            }

            // 后续可以添加不同标签页的内容切换
        }
        
        // 渲染"我的"视图
        async function renderWechatMeView() {
            // 获取个人资料
            const profile = await getPersonalProfileData();
            
            // 更新头像
            const avatarImg = document.getElementById('wechatMeAvatar');
            if (avatarImg) {
                avatarImg.src = profile.avatar || 'https://img.58sb.cn/file/img/V7Ucqzhl.jpg';
            }
            
            // 更新名称（优先显示昵称）
            const nameEl = document.getElementById('wechatMeName');
            if (nameEl) {
                const displayName = profile.nickname || profile.name || '未设置';
                nameEl.textContent = displayName;
            }
            
            // 更新微信号
            const wechatIdEl = document.getElementById('wechatMeId');
            if (wechatIdEl) {
                const wechatId = profile.weixinId || profile.wechatId || profile.wechat_id || '未设置';
                wechatIdEl.textContent = wechatId;
            }
        }
        
        // 获取个人资料数据（异步版本）
        async function getPersonalProfileData() {
            // 尝试从多个来源获取个人资料
            let profile = {};
            
            // 优先从 localforage 获取（最可靠）
            if (typeof localforage !== 'undefined') {
                try {
                    const lfProfile = await localforage.getItem('personalProfile');
                    if (lfProfile) {
                        profile = { ...profile, ...lfProfile };
                    }
                } catch (e) {}
            }
            
            // 如果 localforage 没有数据，从 localStorage 获取
            if (!profile || !profile.nickname) {
                try {
                    const localProfile = localStorage.getItem('personalProfile');
                    if (localProfile) {
                        const parsed = JSON.parse(localProfile);
                        profile = { ...profile, ...parsed };
                    }
                } catch (e) {}
            }
            
            // 最后从 relationshipData 获取（作为降级方案）
            if ((!profile || !profile.nickname) && relationshipData && relationshipData.personalProfile) {
                profile = { ...profile, ...relationshipData.personalProfile };
            }
            
            return profile;
        }
        
        // 编辑我的资料
        function editMyProfile() {
            openPersonalProfile();
        }

        // 打开公益说明弹窗
        function openDonationModal() {
            const modal = document.getElementById('donationModal');
            if (modal) {
                modal.style.display = 'flex';
            }
        }

        // 关闭公益说明弹窗
        function closeDonationModal() {
            const modal = document.getElementById('donationModal');
            if (modal) {
                modal.style.display = 'none';
            }
        }

        // 打开赞赏码展示页面
        function openDonationCodePage() {
            // 先关闭弹窗
            closeDonationModal();
            // 显示赞赏码页面
            const page = document.getElementById('donationCodePage');
            if (page) {
                page.style.display = 'flex';
            }
        }

        // 关闭赞赏码展示页面
        function closeDonationCodePage() {
            const page = document.getElementById('donationCodePage');
            if (page) {
                page.style.display = 'none';
            }
        }

        // 渲染微信通讯录列表
        function renderWechatContactsList() {
            const contactsList = document.getElementById('wechatContactsList');
            if (!contactsList) return;
            
            if (!relationshipData || !relationshipData.wechatChatList || relationshipData.wechatChatList.length === 0) {
                contactsList.innerHTML = '<div style="padding: 20px; text-align: center; color: #999;">暂无联系人</div>';
                return;
            }
            
            // 获取所有非群聊的角色，并按ID去重
            const characters = relationshipData.wechatChatList
                .filter(item => !item.isGroupChat)
                .filter((item, index, self) =>
                    index === self.findIndex((t) => t.id === item.id)
                );

            // 按备注名或名字的首字母排序
            const sortedCharacters = characters.sort((a, b) => {
                const nameA = (a.remark || a.name || '').toString();
                const nameB = (b.remark || b.name || '').toString();
                return nameA.localeCompare(nameB, 'zh-CN');
            });
            
            // 按首字母分组
            const grouped = {};
            sortedCharacters.forEach(char => {
                const name = (char.remark || char.name || '未命名').toString();
                const firstChar = name.charAt(0);
                // 获取首字母（如果是中文则获取拼音首字母，否则直接取首字符）
                let letter = getFirstLetter(firstChar);
                if (!grouped[letter]) {
                    grouped[letter] = [];
                }
                grouped[letter].push(char);
            });
            
            // 按字母顺序排序
            const sortedLetters = Object.keys(grouped).sort((a, b) => {
                // 特殊字符排在最后
                const isALetter = /^[A-Za-z]/.test(a);
                const isBLetter = /^[A-Za-z]/.test(b);
                if (isALetter && !isBLetter) return -1;
                if (!isALetter && isBLetter) return 1;
                return a.localeCompare(b);
            });
            
            // 生成HTML
            let html = '';
            sortedLetters.forEach(letter => {
                html += `<div class="wechat-contacts-letter-section">`;
                html += `<div class="wechat-contacts-letter">${letter.toUpperCase()}</div>`;
                html += `<div class="wechat-contacts-letter-items">`;
                
                grouped[letter].forEach(char => {
                    const displayName = char.remark || char.name || '未命名';
                    const realName = char.name && char.remark ? char.name : '';
                    html += `
                        <div class="wechat-contacts-character-item" onclick="openChatInterface(${char.id})">
                            <img class="wechat-contacts-avatar" src="${char.avatar || 'https://img.58sb.cn/file/img/V7Ucqzhl.jpg'}" alt="${displayName}">
                            <span class="wechat-contacts-name">${displayName}</span>
                            ${realName ? `<span class="wechat-contacts-remark">(${realName})</span>` : ''}
                        </div>
                    `;
                });
                
                html += `</div></div>`;
            });
            
            contactsList.innerHTML = html;
        }
        
        // 获取字符的首字母
        function getFirstLetter(char) {
            if (!char) return '#';
            
            // 如果是英文字母，直接返回大写
            if (/^[a-zA-Z]/.test(char)) {
                return char.toUpperCase();
            }
            
            // 如果是数字，归为#组
            if (/^[0-9]/.test(char)) {
                return '#';
            }
            
            // 中文获取拼音首字母
            const py = getPinyinFirstLetter(char);
            if (py && py !== '#') return py;
            
            // 如果无法获取拼音首字母，返回字符本身（大写）
            return '#';
        }
        
