                        justify-content: center;
                        font-size: 18px;
                        flex-shrink: 0;
                        overflow: hidden;
                    }
                    .dm-message-bubble {
                        padding: 10px 14px;
                        border-radius: 18px;
                        font-size: 15px;
                        line-height: 1.5;
                        word-wrap: break-word;
