        async function testNotification() {
            const resultDiv = document.getElementById('debugNotificationResult');
            resultDiv.innerHTML = '⏳ 10秒后将发送通知...';
            resultDiv.className = 'debug-result';
            
            console.log('=== 开始测试通知 ===');
            console.log('Capacitor:', window.Capacitor);
            console.log('LocalNotifications插件:', window.Capacitor?.Plugins?.LocalNotifications);
            
            setTimeout(async () => {
                const aiName = relationshipData.wechatChatList.find(item => item.id == currentChatId)?.name || 'AI';
                const message = '这是一条测试通知消息';
                
                console.log('准备发送通知:', { aiName, message });
                
                if (window.Capacitor && window.Capacitor.Plugins && window.Capacitor.Plugins.LocalNotifications) {
                    const LocalNotifications = window.Capacitor.Plugins.LocalNotifications;
                    
                    try {
                        const permissions = await LocalNotifications.checkPermissions();
                        console.log('当前通知权限:', permissions);
                        
                        if (permissions.display !== 'granted') {
                            console.log('请求通知权限...');
                            const requestResult = await LocalNotifications.requestPermissions();
                            console.log('权限请求结果:', requestResult);
                            
                            if (requestResult.display !== 'granted') {
                                resultDiv.innerHTML = '❌ 通知权限未授予';
                                resultDiv.className = 'debug-result error';
                                console.error('❌ 通知权限未授予');
                                return;
                            }
                        }
                        
                        console.log('创建通知渠道...');
                        await LocalNotifications.createChannel({
                            id: 'test_notification',
                            name: '测试通知',
                            description: '用于测试通知功能',
                            importance: 5,
                            visibility: 1,
                            lights: true,
                            lightColor: '#FF0000',
                            vibration: true,
                            sound: 'default'
                        });
                        console.log('✅ 测试通知渠道已创建');
                        
                        console.log('发送通知...');
                        const notificationId = Math.floor(Date.now() / 1000) % 2147483647;
                        console.log('通知ID:', notificationId);
                        
                        await LocalNotifications.schedule({
                            notifications: [{
                                title: `${aiName} 发来新消息`,
                                body: message,
                                id: notificationId,
                                schedule: { at: new Date(new Date().getTime() + 1000 * 5) },
                                smallIcon: 'ic_stat_notify',
                                largeIcon: 'icon',
                                channelId: 'test_notification',
                                sound: 'default',
                                vibration: true,
                                ongoing: false,
                                autoCancel: true
                            }]
                        });
                        
                        console.log('✅ 测试通知已发送');
                        resultDiv.innerHTML = '✅ 通知已发送<br><small>请检查手机通知栏和锁屏</small>';
                        resultDiv.className = 'debug-result success';
                        
                        setTimeout(async () => {
                            const pending = await LocalNotifications.getPending();
                            console.log('待发送通知:', pending);
                            const notifications = await LocalNotifications.getDelivered();
                            console.log('已发送通知:', notifications);
                        }, 1000);
                        
                    } catch (error) {
                        console.error('❌ 通知发送失败:', error);
                        resultDiv.innerHTML = `❌ 发送失败: ${error.message}<br><small>请检查应用通知权限</small>`;
                        resultDiv.className = 'debug-result error';
                    }
                } else {
                    console.warn('当前环境不支持通知');
                    resultDiv.innerHTML = '⚠️ 当前环境不支持通知';
                    resultDiv.className = 'debug-result warning';
                }
            }, 10000);
        }

