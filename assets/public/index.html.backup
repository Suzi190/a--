            cursor: pointer;
            transition: all 0.3s ease;
        }
        
        .companion-settings-close:hover {
            background: rgba(255, 107, 157, 0.3);
            transform: scale(1.1);
        }
        
        .companion-settings-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 16px 0;
            border-bottom: 1px solid rgba(255, 182, 193, 0.2);
        }
        
        .companion-settings-label {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 15px;
            color: #555;
            font-weight: 500;
        }
        
        .companion-settings-desc {
            font-size: 12px;
            color: #999;
            margin-top: 6px;
            margin-bottom: 12px;
            line-height: 1.5;
        }
        
        /* 开关样式 */
        .companion-settings-switch {
            position: relative;
            width: 50px;
            height: 28px;
            cursor: pointer;
        }
        
        .companion-settings-switch input {
            opacity: 0;
            width: 0;
            height: 0;
        }
        
        .companion-settings-slider {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: #e0e0e0;
            border-radius: 28px;
            transition: all 0.3s ease;
        }
        
        .companion-settings-slider::before {
            content: '';
            position: absolute;
            height: 22px;
            width: 22px;
            left: 3px;
            bottom: 3px;
            background: white;
            border-radius: 50%;
            transition: all 0.3s ease;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.2);
        }
        
        .companion-settings-switch input:checked + .companion-settings-slider {
            background: linear-gradient(135deg, #ff6b9d 0%, #ff8fab 100%);
        }
        
        .companion-settings-switch input:checked + .companion-settings-slider::before {
            transform: translateX(22px);
        }
        
        .companion-settings-status {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 12px;
            background: rgba(255, 182, 193, 0.1);
            border-radius: 12px;
            margin: 16px 0;
            font-size: 13px;
            color: #ff6b9d;
        }
        
        .companion-status-indicator {
            width: 8px;
            height: 8px;
            background: #4CAF50;
            border-radius: 50%;
            animation: pulse 2s infinite;
        }
        
        @keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.5; }
        }
        
        .companion-settings-actions {
            margin-top: 20px;
            text-align: center;
        }
        
        .companion-settings-btn {
            padding: 12px 40px;
            border: none;
            border-radius: 25px;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
        }
        
        .companion-settings-btn.confirm {
            background: linear-gradient(135deg, #ff6b9d 0%, #ff8fab 100%);
            color: white;
            box-shadow: 0 4px 15px rgba(255, 107, 157, 0.4);
        }
        
        .companion-settings-btn.confirm:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(255, 107, 157, 0.5);
        }
        
        /* 扇形菜单 - 圆形围绕布局 */
        .companion-fan-menu {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 180px;
            height: 180px;
            pointer-events: none;
        }
        
        .companion-fan-menu.active {
            pointer-events: auto;
        }
        
        .fan-menu-item {
            position: absolute;
            width: 52px;
            height: 52px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            opacity: 0;
            transform: scale(0);
            transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
            top: 50%;
            left: 50%;
            margin-top: -26px;
            margin-left: -26px;
            border: 2px solid rgba(255, 255, 255, 0.8);
            box-shadow: 
                0 4px 15px rgba(0, 0, 0, 0.15),
                inset 0 2px 4px rgba(255, 255, 255, 0.5);
            font-size: 12px;
            font-weight: 600;
            color: white;
            text-shadow: 0 1px 2px rgba(0, 0, 0, 0.2);
        }
        
        .companion-fan-menu.active .fan-menu-item {
            opacity: 1;
            transform: scale(1);
        }
        
        /* 圆形围绕 - 上方 */
        .companion-fan-menu.active .fan-menu-item:nth-child(1) {
            top: -20px;
            left: 50%;
        }
        
        /* 圆形围绕 - 左下方 */
        .companion-fan-menu.active .fan-menu-item:nth-child(2) {
            top: 75%;
            left: 15%;
        }
        
        /* 圆形围绕 - 右下方 */
        .companion-fan-menu.active .fan-menu-item:nth-child(3) {
            top: 75%;
            left: 85%;
        }
        
        /* 梦幻糖果渐变 */
        .fan-menu-item.share {
            background: linear-gradient(135deg, 
                rgba(255, 182, 193, 0.95) 0%, 
                rgba(255, 105, 180, 0.9) 100%);
        }
        
        .fan-menu-item.end {
            background: linear-gradient(135deg, 
                rgba(255, 218, 185, 0.95) 0%, 
                rgba(255, 160, 122, 0.9) 100%);
        }
        
        .fan-menu-item.settings {
            background: linear-gradient(135deg, 
                rgba(200, 200, 255, 0.95) 0%, 
                rgba(180, 180, 240, 0.9) 100%);
        }
        
        .fan-menu-item:hover {
            transform: scale(1.1) !important;
            box-shadow: 
                0 6px 20px rgba(0, 0, 0, 0.2),
                inset 0 2px 6px rgba(255, 255, 255, 0.6);
        }
        
        /* 空状态 */
        .companion-empty-state {
            text-align: center;
            padding: 40px 20px;
            color: #999;
        }
        
        .companion-empty-state-icon {
            font-size: 48px;
            margin-bottom: 12px;
            opacity: 0.5;
        }
        
        .companion-empty-state-text {
            font-size: 14px;
        }
        
        /* 随机查看弹窗 */
        .random-view-modal {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.8);
            backdrop-filter: blur(20px);
            z-index: 10001;
            display: none;
            justify-content: center;
            align-items: center;
            opacity: 0;
            transition: opacity 0.3s ease;
        }
        
        .random-view-modal.active {
            display: flex;
            opacity: 1;
        }
        
        .random-view-content {
            width: 85%;
            max-width: 350px;
            background: white;
            border-radius: 24px;
            padding: 30px;
            text-align: center;
            transform: scale(0.9);
            transition: transform 0.3s ease;
        }
        
        .random-view-modal.active .random-view-content {
            transform: scale(1);
        }
        
        .random-view-avatar {
            width: 100px;
            height: 100px;
            border-radius: 50%;
            object-fit: cover;
            margin: 0 auto 20px;
            border: 4px solid #f0f0f0;
        }
        
        .random-view-name {
            font-size: 22px;
            font-weight: 600;
            color: #333;
            margin-bottom: 8px;
        }
        
        .random-view-message {
            font-size: 14px;
            color: #666;
            margin-bottom: 24px;
            line-height: 1.6;
        }
        
        .random-view-btn {
            padding: 12px 32px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border: none;
            border-radius: 25px;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
        }
        
        .random-view-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(102, 126, 234, 0.4);
        }
    </style>

    <!-- 身材管理页面脚本 -->
    <script>
        // 打开身材管理页面
        window.openBodyManager = function() {
            const loadingPage = document.getElementById('bodyManagerLoadingPage');
            const mainPage = document.getElementById('bodyManagerPage');
            
            // 显示加载动画
            loadingPage.classList.add('active');
            document.body.style.overflow = 'hidden';
            
            // 2秒后显示主页面
            setTimeout(() => {
                loadingPage.classList.remove('active');
                mainPage.classList.add('active');
            }, 2000);
        };

        // 关闭身材管理页面
        window.closeBodyManager = function() {
            const loadingPage = document.getElementById('bodyManagerLoadingPage');
            const mainPage = document.getElementById('bodyManagerPage');
            
            mainPage.classList.remove('active');
            loadingPage.classList.remove('active');
            document.body.style.overflow = '';
        };

        // 打开计划选择 - 跳转到专属定制页面
        window.openPlanSelection = function() {
            openCustomPlanPage();
        };

        // 选择计划
        window.selectPlan = function(planType) {
            const planNames = {
                'weight-loss': '减脂计划',
                'muscle': '增肌计划',
                'maintain': '保持计划',
                'couple': '情侣计划'
            };
            
            // 移除弹窗
            const modal = document.querySelector('.plan-selection-modal');
            if (modal) modal.remove();
            
            // 显示提示
            showBodyManagerToast(`已选择：${planNames[planType]}，开始你的自律之旅吧！`);
        };

        // 切换底部导航
        window.switchBodyTab = function(tabName) {
            // 移除所有active状态
            document.querySelectorAll('.body-manager-bottom-nav .nav-item').forEach(item => {
                item.classList.remove('active');
            });

            // 添加当前active状态
            const tabMap = {
                'fasting': 0,
                'recipe': 1,
                'add': 2,
                'data': 3,
                'more': 4
            };

            const navItems = document.querySelectorAll('.body-manager-bottom-nav .nav-item');
            if (navItems[tabMap[tabName]]) {
                navItems[tabMap[tabName]].classList.add('active');
            }

            // 断食标签 - 进入追踪页面
            if (tabName === 'fasting') {
                if (currentFastingPlan) {
                    openFastingTracker(currentFastingPlan);
                } else {
                    openPlanSelection();
                }
                return;
            }

            // 食谱标签 - 进入食谱页面
            if (tabName === 'recipe') {
                openRecipePage();
                return;
            }

            // 加号标签 - 显示弹出菜单
            if (tabName === 'add') {
                showAddMenu();
                return;
            }

            // 数据标签 - 显示数据页面
            if (tabName === 'data') {
                openDataPage();
                return;
            }

            // 更多标签 - 显示更多页面
            if (tabName === 'more') {
                openMorePage();
                return;
            }

            // 显示提示
            const tabNames = {};

            if (tabName !== 'add' && tabName !== 'fasting' && tabName !== 'recipe' && tabName !== 'data' && tabName !== 'more') {
                showBodyManagerToast(tabNames[tabName]);
            }
        };

        // 显示提示消息
        function showBodyManagerToast(message) {
            const existingToast = document.querySelector('.body-manager-toast');
            if (existingToast) {
                existingToast.remove();
            }
            
            const toast = document.createElement('div');
            toast.className = 'body-manager-toast';
            toast.innerHTML = `
                <style>
                    .body-manager-toast {
                        position: fixed;
                        top: 50%;
                        left: 50%;
                        transform: translate(-50%, -50%);
                        background: rgba(0, 0, 0, 0.8);
                        color: white;
                        padding: 15px 30px;
                        border-radius: 25px;
                        font-size: 14px;
                        z-index: 100001;
                        animation: fadeInOut 2s ease forwards;
                    }
                    @keyframes fadeInOut {
                        0% { opacity: 0; transform: translate(-50%, -50%) scale(0.9); }
                        20% { opacity: 1; transform: translate(-50%, -50%) scale(1); }
                        80% { opacity: 1; transform: translate(-50%, -50%) scale(1); }
                        100% { opacity: 0; transform: translate(-50%, -50%) scale(0.9); }
                    }
                </style>
                ${message}
            `;
            
            document.body.appendChild(toast);
            
            setTimeout(() => {
                if (toast.parentNode) {
                    toast.remove();
                }
            }, 2000);
        }

        // NPC老公点击交互
        window.showHusbandDialog = function() {
