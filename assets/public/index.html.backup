        // 关闭思念时间线弹窗
        function closeMissYouTimeline() {
            const modal = document.getElementById('missYouTimelineModal');
            if (modal) {
                modal.style.display = 'none';
            }
        }

        // 更新思念时间线列表
        function updateMissYouTimelineList() {
            const listContainer = document.getElementById('missYouTimelineList');
            if (!listContainer) return;

            // 获取当前角色的思念记录
            const chatItem = relationshipData.wechatChatList.find(item => item.id == currentChatId);
            if (!chatItem || !chatItem.missYouRecords || chatItem.missYouRecords.length === 0) {
                listContainer.innerHTML = `
                    <div style="text-align: center; padding: 50px 30px; color: #999; font-size: 14px;">
                        <div style="font-size: 48px; margin-bottom: 15px;">💕</div>
                        <div>还没有思念记录</div>
                        <div style="font-size: 12px; margin-top: 10px; color: #bbb;">长按悬浮窗头像发送思念</div>
                    </div>
                `;
                return;
            }

            // 过滤出今天的记录
            const today = new Date();
            today.setHours(0, 0, 0, 0);
            const tomorrow = new Date(today);
            tomorrow.setDate(tomorrow.getDate() + 1);

            const todayRecords = chatItem.missYouRecords.filter(record => {
                const recordDate = new Date(record.timestamp);
                return recordDate >= today && recordDate < tomorrow;
            });

            if (todayRecords.length === 0) {
                listContainer.innerHTML = `
                    <div style="text-align: center; padding: 50px 30px; color: #999; font-size: 14px;">
                        <div style="font-size: 48px; margin-bottom: 15px;">💕</div>
                        <div>今天还没有思念记录</div>
                        <div style="font-size: 12px; margin-top: 10px; color: #bbb;">点击下方按钮发送思念</div>
                    </div>
                `;
                return;
            }

            // 渲染轨迹样式记录 - 全屏优化
            const totalCount = todayRecords.length;
            listContainer.innerHTML = `
                <div style="position: relative; padding-left: 40px; max-width: 600px; margin: 0 auto;">
                    <!-- 轨迹线 -->
                    <div style="position: absolute; left: 12px; top: 0; bottom: 0; width: 3px; background: linear-gradient(to bottom, #ff4757, #ffc0cb);"></div>
                    
                    ${todayRecords.map((record, index) => `
                        <div style="position: relative; margin-bottom: 25px;">
                            <!-- 轨迹点 -->
                            <div style="position: absolute; left: -34px; top: 8px; width: 20px; height: 20px; background: ${index === totalCount - 1 ? '#ff4757' : '#ff6b6b'}; border-radius: 50%; border: 4px solid white; box-shadow: 0 3px 10px rgba(255, 107, 107, 0.5); z-index: 1;"></div>
                            
                            <!-- 记录卡片 -->
                            <div style="background: #fafafa; border-radius: 16px; padding: 20px; box-shadow: 0 2px 16px rgba(0,0,0,0.06);">
                                <div style="display: flex; align-items: center; justify-content: space-between;">
                                    <div style="display: flex; align-items: center;">
                                        <span style="font-size: 28px; margin-right: 15px;">💕</span>
                                        <div>
                                            <div style="font-size: 20px; color: #333; font-weight: 600;">${record.timeStr}</div>
                                            <div style="font-size: 14px; color: #999; margin-top: 4px;">我很想你</div>
                                        </div>
                                    </div>
                                    <div style="text-align: center; min-width: 50px;">
                                        <div style="font-size: 24px; font-weight: bold; color: #ff4757;">${index + 1}</div>
                                        <div style="font-size: 11px; color: #bbb;">次</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    `).join('')}
                </div>
                
                <!-- 总计 -->
                <div style="text-align: center; margin-top: 30px; padding: 25px; background: linear-gradient(135deg, #ffe4e1 0%, #ffc0cb 100%); border-radius: 20px; max-width: 600px; margin-left: auto; margin-right: auto;">
                    <div style="font-size: 14px; color: #ff6b6b; margin-bottom: 8px;">今日思念</div>
                    <div style="font-size: 36px; font-weight: bold; color: #ff4757;">${totalCount}<span style="font-size: 16px; font-weight: normal;"> 次</span></div>
                </div>
                
                <!-- 底部留白 -->
                <div style="height: 40px;"></div>
            `;
        }

        // 从时间线弹窗发送思念
        async function sendMissYouMessageFromTimeline() {
            if (!currentChatId) {
                showToast('请先选择一个聊天');
                return;
            }

            const chatItem = relationshipData.wechatChatList.find(item => item.id == currentChatId);
            if (!chatItem) {
                showToast('未找到聊天信息');
                return;
            }

            // 获取当前时间
            const now = new Date();
            const timeStr = `${now.getHours().toString().padStart(2, '0')}:${now.getMinutes().toString().padStart(2, '0')}`;
            const messageContent = `${timeStr} 我很想你`;

            // 创建消息对象
            const missYouMessage = {
                id: Date.now(),
                chatId: currentChatId,
                role: 'system',
                content: messageContent,
                timestamp: now.getTime(),
                type: 'miss_you',
                isSystem: true
            };

            // 保存到聊天记录
            if (!relationshipData.chatMessages) {
                relationshipData.chatMessages = [];
            }
            relationshipData.chatMessages.push(missYouMessage);

            // 保存到角色的 missYouRecords
            if (!chatItem.missYouRecords) {
                chatItem.missYouRecords = [];
            }
            chatItem.missYouRecords.push({
                timeStr: timeStr,
                timestamp: now.getTime(),
                message: messageContent
            });

            // 只保留最近50条
            if (chatItem.missYouRecords.length > 50) {
                chatItem.missYouRecords = chatItem.missYouRecords.slice(-50);
            }

            // 保存数据
            await saveData();

            // 显示 Toast
            showToast(`${timeStr} 已向${chatItem.remark || chatItem.name || 'AI'}发送想念`);

            // 更新列表
            updateMissYouTimelineList();

            // 如果当前正在该角色的聊天界面，实时显示消息
            const currentChatInterfaceId = document.querySelector('.chat-interface')?.getAttribute('data-chat-id');
            if (currentChatInterfaceId == currentChatId) {
                displayMissYouMessage(missYouMessage);
            }
        }

        // 检查并清空过期的思念记录（每天0点）
        async function checkAndClearExpiredMissYouRecords() {
            const today = new Date();
            today.setHours(0, 0, 0, 0);

            let hasChanges = false;

            relationshipData.wechatChatList.forEach(chatItem => {
                if (chatItem.missYouRecords && chatItem.missYouRecords.length > 0) {
                    // 过滤出今天的记录
                    const todayRecords = chatItem.missYouRecords.filter(record => {
                        const recordDate = new Date(record.timestamp);
                        recordDate.setHours(0, 0, 0, 0);
                        return recordDate.getTime() === today.getTime();
                    });

                    if (todayRecords.length !== chatItem.missYouRecords.length) {
                        chatItem.missYouRecords = todayRecords;
                        hasChanges = true;
                    }
                }
            });

            if (hasChanges) {
                await saveData();
                console.log('已清空过期的思念记录');
            }
        }

        // 更新思念数量徽章
        function updateMissYouCountBadge() {
            const badge = document.getElementById('missYouCountBadge');
            if (!badge) return;

            const chatItem = relationshipData.wechatChatList.find(item => item.id == currentChatId);
            if (!chatItem || !chatItem.missYouRecords || chatItem.missYouRecords.length === 0) {
                badge.style.display = 'none';
                return;
            }

            // 过滤出今天的记录
            const today = new Date();
            today.setHours(0, 0, 0, 0);
            const tomorrow = new Date(today);
            tomorrow.setDate(tomorrow.getDate() + 1);

            const todayCount = chatItem.missYouRecords.filter(record => {
                const recordDate = new Date(record.timestamp);
                return recordDate >= today && recordDate < tomorrow;
            }).length;

            if (todayCount > 0) {
                badge.textContent = todayCount;
                badge.style.display = 'inline-block';
            } else {
                badge.style.display = 'none';
            }
        }

        // 从聊天信息弹窗打开聊天设置
