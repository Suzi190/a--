        // IndexedDB数据库名称和版本
        const DB_NAME = 'RelationshipDB';
        const DB_VERSION = 3; // 【重构】升级版本，添加消息存储

        // 打开IndexedDB连接
        function openDB() {
            return new Promise((resolve, reject) => {
                const request = indexedDB.open(DB_NAME, DB_VERSION);

                request.onerror = (event) => {
                    console.error('数据库连接失败:', event.target.error);
                    reject('数据库连接失败');
                };
                request.onsuccess = () => resolve(request.result);

                request.onupgradeneeded = (event) => {
                    const db = event.target.result;
                    if (!db.objectStoreNames.contains('images')) {
                        // 使用更大的存储容量
                        const store = db.createObjectStore('images', { keyPath: 'id' });
                        store.createIndex('type', 'type', { unique: false });
                    }
                    // 【重构】添加消息存储
                    if (!db.objectStoreNames.contains('chatMessages')) {
                        const msgStore = db.createObjectStore('chatMessages', { keyPath: 'id' });
                        msgStore.createIndex('chatId', 'chatId', { unique: false });
                        msgStore.createIndex('timestamp', 'timestamp', { unique: false });
                        console.log('【重构】创建chatMessages存储');
                    }
                    // 【重构】添加应用数据存储（替代localStorage）
                    if (!db.objectStoreNames.contains('appData')) {
                        const appDataStore = db.createObjectStore('appData', { keyPath: 'key' });
                        console.log('【重构】创建appData存储');
                    }
                };
            });
        }

        // 【重构】聊天消息管理器 - 使用IndexedDB存储
        const ChatMessageManager = {
            // 内存中只保留当前聊天的消息缓存
            currentChatCache: new Map(),
            currentChatId: null,
            MAX_CACHE_SIZE: 100, // 内存中最多缓存100条

            // 生成消息唯一ID
            generateId(chatId, timestamp) {
                return `${chatId}_${timestamp}`;
            },

            // 【优化】保存单条消息 - 只使用 SQLite + 内存缓存
            async saveMessage(message) {
                // 【优化】只保存到 SQLite，不再重复保存到 IndexedDB
                if (SQLiteManager.isAvailable) {
                    try {
                        const success = await SQLiteManager.saveMessage(message);
                        if (success) {
                            console.log('【优化存储】消息已保存到SQLite:', message.chatId);
                            // 同时更新内存缓存
                            const id = this.generateId(message.chatId, message.timestamp);
                            if (message.chatId === this.currentChatId) {
                                this.currentChatCache.set(id, { ...message, id });
                            }
                            return true;
                        }
                    } catch (sqliteError) {
                        console.error('【优化存储】SQLite保存失败:', sqliteError);
                        // 【关键修复】不再抛出错误，避免导致闪退
                        // 禁用 SQLite 并保存到内存缓存
                        SQLiteManager.isAvailable = false;
                        console.warn('【优化存储】SQLite已禁用，切换到内存缓存模式');
                    }
                }
                
                // SQLite 不可用或保存失败时，只保存到内存（下次启动时会从 localforage 迁移）
                console.warn('【优化存储】消息仅保存到内存缓存');
                const id = this.generateId(message.chatId, message.timestamp);
                if (message.chatId === this.currentChatId) {
                    this.currentChatCache.set(id, { ...message, id });
                }
                return true;
            },

            // 【优化】批量保存消息 - 只使用 SQLite
            async saveMessages(messages) {
                // 【优化】只保存到 SQLite
                if (SQLiteManager.isAvailable) {
                    try {
                        const savedCount = await SQLiteManager.saveMessages(messages);
                        if (savedCount > 0) {
                            console.log(`【优化存储】批量保存${savedCount}/${messages.length}条消息到SQLite成功`);
                            return true;
                        }
                    } catch (sqliteError) {
                        console.error('【优化存储】SQLite批量保存失败:', sqliteError);
                        // 【关键修复】不再抛出错误，避免导致闪退
                        // 禁用 SQLite 并继续执行
                        SQLiteManager.isAvailable = false;
                        console.warn('【优化存储】SQLite已禁用，切换到内存缓存模式');
                    }
                }
                
                // SQLite 不可用或保存失败时，跳过批量保存
                console.warn('【优化存储】SQLite不可用，批量保存跳过');
                return true;
            },

            // 【优化】获取指定聊天的消息（分页）- 只从 SQLite 读取
            async getMessages(chatId, offset = 0, limit = 50) {
                // 【优化】只从 SQLite 读取
                if (SQLiteManager.isAvailable) {
                    try {
                        const messages = await SQLiteManager.getMessages(chatId, offset, limit);
                        if (messages !== null) {
                            console.log(`【优化存储】从SQLite获取${messages.length}条可见消息`);
                            return messages;
                        }
                        // 【修复】SQLite 返回 null 时，降级到内存缓存
                        console.warn('【优化存储】SQLite返回null，降级到内存缓存');
                    } catch (sqliteError) {
                        console.error('【优化存储】SQLite读取失败:', sqliteError);
                        // 【修复】出错时降级到内存缓存，而不是抛出错误
                        console.warn('【优化存储】SQLite读取异常，降级到内存缓存');
                    }
                }
                
                // SQLite 不可用、返回 null 或出错时，从内存缓存读取（只返回可见消息）
                console.warn('【优化存储】从内存缓存读取可见消息');
                const cachedMessages = Array.from(this.currentChatCache.values())
                    .filter(msg => msg.chatId === chatId && !msg.isTeaching && !msg.isDateMessage && msg.type !== 'hidden')
                    .sort((a, b) => a.timestamp - b.timestamp);
                return cachedMessages.slice(offset, offset + limit);
            },

            // 【优化】获取指定聊天的最新消息 - 只从 SQLite 读取
            async getLatestMessages(chatId, limit = 50) {
                // 【优化】只从 SQLite 读取
                if (SQLiteManager.isAvailable) {
                    try {
                        // 【修复】获取可见消息总数，然后计算偏移量获取最新的
                        const visibleCount = await SQLiteManager.getMessageCount(chatId);
                        const offset = Math.max(0, visibleCount - limit);
                        const messages = await SQLiteManager.getMessages(chatId, offset, limit);
                        if (messages !== null) {
                            console.log(`【优化存储】从SQLite获取${messages.length}条最新可见消息`);
                            // 按时间戳排序并返回最新的
                            messages.sort((a, b) => a.timestamp - b.timestamp);
                            return messages.slice(-limit);
                        }
                    } catch (sqliteError) {
                        console.error('【优化存储】SQLite读取失败:', sqliteError);
                        throw sqliteError;
                    }
                } else {
                    // SQLite 不可用时，从内存缓存读取（只返回可见消息）
                    console.warn('【优化存储】SQLite不可用，从内存缓存读取最新可见消息');
                    const cachedMessages = Array.from(this.currentChatCache.values())
                        .filter(msg => msg.chatId === chatId && !msg.isTeaching && !msg.isDateMessage && msg.type !== 'hidden')
                        .sort((a, b) => a.timestamp - b.timestamp);
                    return cachedMessages.slice(-limit);
                }
            },

            // 【优化】获取消息总数 - 只从 SQLite 读取（只统计可见消息）
            async getMessageCount(chatId) {
                // 【优化】只从 SQLite 读取
                if (SQLiteManager.isAvailable) {
                    try {
                        const count = await SQLiteManager.getMessageCount(chatId);
                        if (count !== null) {
                            console.log(`【优化存储】从SQLite获取可见消息数量: ${count}`);
                            return count;
                        }
                        // 【修复】SQLite 返回 null 时，降级到内存缓存
                        console.warn('【优化存储】SQLite返回null，降级到内存缓存计算消息数量');
                    } catch (sqliteError) {
                        console.error('【优化存储】SQLite获取消息数量失败:', sqliteError);
                        // 【修复】出错时降级到内存缓存，而不是抛出错误
                        console.warn('【优化存储】SQLite获取数量异常，降级到内存缓存');
                    }
                }
                
                // SQLite 不可用、返回 null 或出错时，从内存缓存计算（只统计可见消息）
                console.warn('【优化存储】从内存缓存计算可见消息数量');
                const cachedMessages = Array.from(this.currentChatCache.values())
                    .filter(msg => msg.chatId === chatId && !msg.isTeaching && !msg.isDateMessage && msg.type !== 'hidden');
                return cachedMessages.length;
            },

            // 【重构】删除指定聊天的旧消息（保留最新的N条）
            async cleanupOldMessages(chatId, keepCount = 800) {
                try {
                    const db = await openDB();
                    const messages = await this.getAllMessages(chatId);

                    if (messages.length <= keepCount) return;

                    // 按时间排序
                    messages.sort((a, b) => a.timestamp - b.timestamp);
                    const toDelete = messages.slice(0, messages.length - keepCount);

                    return new Promise((resolve, reject) => {
                        const transaction = db.transaction('chatMessages', 'readwrite');
                        const store = transaction.objectStore('chatMessages');

                        toDelete.forEach(msg => {
                            store.delete(msg.id);
                        });

                        transaction.oncomplete = () => {
                            console.log(`【ChatMessageManager】清理了${toDelete.length}条旧消息`);
                            resolve(toDelete.length);
                        };
                        transaction.onerror = (event) => {
                            console.error('清理旧消息失败:', event.target.error);
                            reject(event.target.error);
                        };
                    });
                } catch (error) {
                    console.error('【ChatMessageManager】清理旧消息失败:', error);
                }
            },

            // 【重构】获取指定聊天的所有消息（谨慎使用）
            async getAllMessages(chatId) {
                try {
                    const db = await openDB();
                    return new Promise((resolve, reject) => {
                        const transaction = db.transaction('chatMessages', 'readonly');
                        const store = transaction.objectStore('chatMessages');
                        const index = store.index('chatId');

                        const request = index.getAll(chatId);
                        request.onsuccess = () => resolve(request.result);
                        request.onerror = (event) => {
                            console.error('获取所有消息失败:', event.target.error);
                            reject(event.target.error);
                        };
                    });
                } catch (error) {
                    console.error('【ChatMessageManager】获取所有消息失败:', error);
                    return [];
                }
            },

            // 【数据迁移】获取 IndexedDB 中的所有消息（用于迁移到 SQLite）
            async getAllMessagesFromIndexedDB() {
                try {
                    const db = await openDB();
                    return new Promise((resolve, reject) => {
                        const transaction = db.transaction('chatMessages', 'readonly');
                        const store = transaction.objectStore('chatMessages');
                        
                        const request = store.getAll();
                        request.onsuccess = () => {
                            console.log('【数据迁移】从 IndexedDB 读取到', request.result.length, '条消息');
                            resolve(request.result);
                        };
                        request.onerror = (event) => {
                            console.error('【数据迁移】从 IndexedDB 读取消息失败:', event.target.error);
                            reject(event.target.error);
                        };
                    });
                } catch (error) {
                    console.error('【数据迁移】获取所有消息失败:', error);
                    return [];
                }
            },

            // 【数据迁移】获取 IndexedDB 中的所有图片（用于迁移到 SQLite）
            async getAllImagesFromIndexedDB() {
                try {
                    const db = await openDB();
                    return new Promise((resolve, reject) => {
                        const transaction = db.transaction('images', 'readonly');
                        const store = transaction.objectStore('images');
                        
                        const request = store.getAll();
                        request.onsuccess = () => {
                            console.log('【数据迁移】从 IndexedDB 读取到', request.result.length, '张图片');
                            resolve(request.result);
                        };
                        request.onerror = (event) => {
                            console.error('【数据迁移】从 IndexedDB 读取图片失败:', event.target.error);
                            reject(event.target.error);
                        };
                    });
                } catch (error) {
                    console.error('【数据迁移】获取所有图片失败:', error);
                    return [];
                }
            },

            // 【重构】切换当前聊天时更新缓存
            async switchChat(chatId) {
                this.currentChatId = chatId;
                this.currentCache.clear();

                // 加载最新的消息到内存缓存
                const messages = await this.getLatestMessages(chatId, this.MAX_CACHE_SIZE);
                messages.forEach(msg => {
                    this.currentCache.set(msg.id, msg);
                });

                console.log(`【ChatMessageManager】切换到聊天${chatId}，缓存了${messages.length}条消息`);
            },

            // 【重构】清空缓存
            clearCache() {
                this.currentCache.clear();
                this.currentChatId = null;
            },

            // 【重构】删除单条消息
            async deleteMessage(chatId, timestamp) {
                try {
                    const db = await openDB();
                    // 【关键修复】确保 timestamp 是数字类型
                    const numericTimestamp = Number(timestamp);
                    const id = this.generateId(chatId, numericTimestamp);
                    console.log('【删除调试】IndexedDB删除消息，生成ID:', id, '原始timestamp:', timestamp);

                    return new Promise((resolve, reject) => {
                        const transaction = db.transaction('chatMessages', 'readwrite');
                        const store = transaction.objectStore('chatMessages');
                        store.delete(id);

                        transaction.oncomplete = () => {
                            // 同时从内存缓存中删除
                            if (this.currentChatId === chatId) {
                                this.currentCache.delete(id);
                            }
                            console.log(`【ChatMessageManager】删除消息成功: ${id}`);
                            resolve(true);
                        };
                        transaction.onerror = (event) => {
                            console.error('删除消息失败:', event.target.error);
                            reject(event.target.error);
                        };
                    });
                } catch (error) {
                    console.error('【ChatMessageManager】删除消息失败:', error);
                    throw error;
                }
            },

            // 【重构】批量删除消息
            async deleteMessages(chatId, timestamps) {
                try {
                    const db = await openDB();

                    return new Promise((resolve, reject) => {
                        const transaction = db.transaction('chatMessages', 'readwrite');
                        const store = transaction.objectStore('chatMessages');

                        timestamps.forEach(timestamp => {
                            const id = this.generateId(chatId, timestamp);
                            store.delete(id);
                            // 同时从内存缓存中删除
                            if (this.currentChatId === chatId) {
                                this.currentCache.delete(id);
                            }
                        });

                        transaction.oncomplete = () => {
                            console.log(`【ChatMessageManager】批量删除${timestamps.length}条消息成功`);
                            resolve(true);
                        };
                        transaction.onerror = (event) => {
                            console.error('批量删除消息失败:', event.target.error);
                            reject(event.target.error);
                        };
                    });
                } catch (error) {
                    console.error('【ChatMessageManager】批量删除消息失败:', error);
                    throw error;
                }
            }
        };

        // 【Capacitor SQLite】SQLite数据库管理器 - 用于APK环境，性能比IndexedDB更好
        // 【鸿蒙系统兼容】统一检测是否为鸿蒙/华为/荣耀设备
        // 【鸿蒙系统兼容】统一检测是否为鸿蒙/华为/荣耀设备
        // 使用缓存避免重复检测
        let _isHarmonyDeviceCache = null;
        function checkIsHarmonyDevice() {
            // 如果有缓存，直接返回缓存结果
            if (_isHarmonyDeviceCache !== null) {
                return _isHarmonyDeviceCache;
            }
            
            const ua = navigator.userAgent || '';
            
            // 首先检查是否是Windows或Mac（桌面环境）
            if (/Windows|Macintosh|Mac OS X/i.test(ua)) {
                _isHarmonyDeviceCache = false;
                return false;
            }
            
            // 检测 HarmonyOS 关键字
            const isHarmonyOS = /HarmonyOS|OpenHarmony/i.test(ua);
            // 检测华为设备（包括nova系列）- 使用更严格的匹配
            const isHuawei = /\b(Huawei|HUAWEI)\b/i.test(ua);
            // 检测荣耀设备
            const isHonor = /\b(Honor|HONOR)\b/i.test(ua);
            // 检测华为型号（nova、P系列、Mate系列等）- 必须包含 - 或 _ 字符才认为是型号
            const isHuaweiModel = /(CDY|ANA|ELS|JEF|JER|OCE|NOH|LIO|TAS|WLZ|SPN|PPA|CND|YAL|PCT|SEA|HMA|LYA|EVR|VCE|DVC|JNY|CDL|TET|MNA|DCO|PAL|BAL|MLA|RNE|PRA|FIG|BAC|KNT|CAM|CAN|CHE|CHM|ANE|DUK|EML|CLT|LYO|VKY|BKL|COL|SHT|EVA|VIE|GRA|MT7|MT8|NXT|ALE|VNS|VTR|WAS|STF|TAG|KIW|ATH|BLN|BND|LON|PAR|PLK|JMM)[-_]/i.test(ua);
            
            const result = isHarmonyOS || isHuawei || isHonor || isHuaweiModel;
            
            // 缓存结果
            _isHarmonyDeviceCache = result;
            
            // 调试输出 - 始终输出，便于排查问题
            console.log('【鸿蒙兼容】设备检测:', {
                isHarmonyOS,
                isHuawei,
                isHonor,
                isHuaweiModel,
                result,
                userAgent: ua.substring(0, 150)
            });
            
            return result;
        }

        const SQLiteManager = {
            db: null,
            isAvailable: false,

            // 【新增】安全解析 JSON 的辅助函数
            safeJSONParse(value, defaultValue = null, context = '') {
                if (value === '[object Object]' || value === '' || value === null || value === undefined) {
                    console.warn(`【SQLite】${context}: 检测到无效值，返回默认值:`, value);
                    return defaultValue;
                }
                try {
                    return JSON.parse(value);
                } catch (e) {
                    console.warn(`【SQLite】${context}: JSON.parse 失败，返回默认值:`, value, e.message);
                    return defaultValue;
                }
            },

            // 【新增】重置数据库（用于修复损坏的数据库）
            async resetDatabase(preserveData = true) {
                try {
                    if (!window.Capacitor || !window.Capacitor.Plugins || !window.Capacitor.Plugins.CapacitorSQLite) {
                        console.log('【SQLite】resetDatabase: SQLite 插件不可用');
                        return false;
                    }
                    
                    const { CapacitorSQLite } = window.Capacitor.Plugins;
                    console.log('【SQLite】正在重置数据库...');
                    
                    // 【数据保护】先备份数据到 localforage
                    let backupData = null;
                    if (preserveData) {
                        try {
                            console.log('【SQLite】正在备份数据...');
                            // 从 SQLite 读取所有数据
                            const allMessages = [];
                            const chatList = await this.getChatList();
                            
                            // 获取每个聊天的消息（包括不可见消息）
                            for (const chat of chatList) {
                                const messages = await this.getAllMessagesForBackup(chat.id);
                                if (messages) {
                                    allMessages.push(...messages);
                                }
                            }
                            
                            backupData = {
                                chatList: chatList,
                                messages: allMessages,
                                settings: await this.getSetting('appSettings', null),
                                profile: await this.getPersonalProfile(),
                                worldBooks: await this.getWorldBooks(),
                                backupTime: new Date().toISOString()
                            };
                            
                            // 保存到 localforage
                            await localforage.setItem('__sqlite_backup_before_reset', backupData);
                            console.log('【SQLite】数据备份完成:', {
                                聊天数: chatList.length,
                                消息数: allMessages.length
                            });
                        } catch (backupError) {
                            console.warn('【SQLite】数据备份失败（继续重置）:', backupError);
                        }
                    }
                    
                    // 尝试删除现有数据库
                    try {
                        await CapacitorSQLite.deleteDatabase({ database: 'chat_messages.db' });
                        console.log('【SQLite】旧数据库已删除');
                    } catch (e) {
                        console.log('【SQLite】删除旧数据库失败（可能不存在）:', e.message);
                    }
                    
                    // 重新初始化
                    this.db = null;
                    this.isAvailable = true;
                    const initResult = await this.initDatabase();
                    
                    if (initResult) {
                        console.log('【SQLite】数据库重置成功');
                        
                        // 【数据恢复】从备份恢复数据
                        if (preserveData && backupData) {
                            try {
                                console.log('【SQLite】正在恢复数据...');
                                
                                // 恢复聊天列表
                                if (backupData.chatList && backupData.chatList.length > 0) {
                                    await this.saveChatList(backupData.chatList);
                                    console.log('【SQLite】聊天列表已恢复');
                                }
                                
                                // 恢复消息（分批恢复，避免内存问题）
                                if (backupData.messages && backupData.messages.length > 0) {
                                    const batchSize = 100;
                                    for (let i = 0; i < backupData.messages.length; i += batchSize) {
                                        const batch = backupData.messages.slice(i, i + batchSize);
                                        await this.saveMessages(batch);
                                        console.log(`【SQLite】已恢复 ${Math.min(i + batchSize, backupData.messages.length)}/${backupData.messages.length} 条消息`);
                                    }
                                }
                                
                                // 恢复设置
                                if (backupData.settings) {
                                    await this.setSetting('appSettings', backupData.settings);
                                }
                                
                                // 恢复个人资料
                                if (backupData.profile) {
                                    await this.savePersonalProfile(backupData.profile);
                                }
                                
                                // 恢复世界书
                                if (backupData.worldBooks) {
                                    await this.saveWorldBooks(backupData.worldBooks);
                                }
                                
                                console.log('【SQLite】数据恢复完成');
                                
                                // 清除备份
                                await localforage.removeItem('__sqlite_backup_before_reset');
                            } catch (restoreError) {
                                console.error('【SQLite】数据恢复失败:', restoreError);
                                // 恢复失败时保留备份，方便手动恢复
                            }
                        }
                        
                        return true;
                    } else {
                        console.error('【SQLite】数据库重置失败：初始化失败');
                        return false;
                    }
                } catch (error) {
                    console.error('【SQLite】重置数据库失败:', error);
                    return false;
                }
            },

            // 检查SQLite是否可用（仅在Capacitor环境中）
            async checkAvailability() {
                try {
                    if (window.Capacitor && window.Capacitor.Plugins && window.Capacitor.Plugins.CapacitorSQLite) {
                        this.isAvailable = true;
                        console.log('【SQLite】Capacitor SQLite 插件可用');
                        return true;
                    }
                    console.log('【SQLite】Capacitor SQLite 插件不可用，将使用IndexedDB');
                    this.isAvailable = false;
                    return false;
                } catch (e) {
                    console.log('【SQLite】检查可用性失败:', e);
                    this.isAvailable = false;
                    return false;
                }
            },
            
            // 【新增】强制设置可用状态（用于APK环境）
            setAvailable(available) {
                this.isAvailable = available;
                console.log('【SQLite】手动设置可用状态:', available);
            },

            // 初始化数据库
            async initDatabase() {
                if (!this.isAvailable) {
                    console.log('【SQLite】initDatabase: isAvailable 为 false，跳过初始化');
                    return false;
                }

                // 【鸿蒙系统兼容】鸿蒙系统也尝试使用 SQLite，如果失败会自动降级到 localforage
                // 不再直接禁用，让鸿蒙系统也能享受 SQLite 的性能优势
                const isHarmony = typeof checkIsHarmonyDevice === 'function' ? checkIsHarmonyDevice() : false;
                if (isHarmony) {
                    console.log('【鸿蒙兼容】检测到鸿蒙系统，尝试使用 SQLite...');
                }

                // 【关键修复】添加内部超时保护
                const INIT_DB_TIMEOUT = 15000; // 15秒超时
                const initDbPromise = (async () => {
                    try {
                        const { CapacitorSQLite } = window.Capacitor.Plugins;
                        
                        console.log('【SQLite】正在初始化数据库...');
                        
                        // 【关键修复】必须先创建连接，然后才能打开数据库
                        try {
                            await CapacitorSQLite.createConnection({
                                database: 'chat_messages.db',
                                version: 1
                            });
                            console.log('【SQLite】数据库连接创建成功');
                        } catch (connError) {
                            // 如果连接已存在，会报错，这是正常的
                            console.log('【SQLite】createConnection 返回（可能已存在）:', connError.message);
                        }
                        
                        // 打开数据库
                        try {
                            await CapacitorSQLite.open({
                                database: 'chat_messages.db'
                            });
                            console.log('【SQLite】数据库打开成功');
                        } catch (openError) {
                            console.error('【SQLite】数据库打开失败:', openError.message);
                            throw openError;
                        }
                    
                    // 保存数据库引用（某些版本不需要）
                    this.db = { 
                        execute: async (options) => {
                            return await CapacitorSQLite.execute(options);
                        },
                        query: async (options) => {
                            return await CapacitorSQLite.query(options);
                        },
                        run: async (options) => {
                            return await CapacitorSQLite.run(options);
                        }
                    };
                    console.log('【SQLite】数据库连接成功');

                    // 创建所有数据表
                    console.log('【SQLite】正在创建数据表...');
                    await CapacitorSQLite.execute({
                        database: 'chat_messages.db',
                        statements: `
                            -- 1. 消息表（已存在）
                            CREATE TABLE IF NOT EXISTS chat_messages (
                                id TEXT PRIMARY KEY,
                                chatId TEXT NOT NULL,
                                sender TEXT NOT NULL,
                                content TEXT,
                                timestamp INTEGER NOT NULL,
                                type TEXT DEFAULT 'text',
                                quote TEXT,
                                isTeaching INTEGER DEFAULT 0,
                                isDateMessage INTEGER DEFAULT 0
                            );
                            CREATE INDEX IF NOT EXISTS idx_chatId ON chat_messages(chatId);
                            CREATE INDEX IF NOT EXISTS idx_timestamp ON chat_messages(timestamp);
                            
                            -- 2. 应用设置表（统一存储所有配置）
                            CREATE TABLE IF NOT EXISTS app_settings (
                                key TEXT PRIMARY KEY,
                                value TEXT,
                                updated_at INTEGER DEFAULT (strftime('%s', 'now') * 1000)
                            );
                            
                            -- 3. 聊天列表表
                            CREATE TABLE IF NOT EXISTS chat_list (
                                id TEXT PRIMARY KEY,
                                data TEXT NOT NULL,
                                updated_at INTEGER DEFAULT (strftime('%s', 'now') * 1000)
                            );
                            
                            -- 4. 世界书表
                            CREATE TABLE IF NOT EXISTS world_books (
                                id TEXT PRIMARY KEY,
                                data TEXT NOT NULL,
                                updated_at INTEGER DEFAULT (strftime('%s', 'now') * 1000)
                            );
                            
                            -- 5. 关系数据表（存储 relationshipData 的其他字段）
                            CREATE TABLE IF NOT EXISTS relationship_data (
                                key TEXT PRIMARY KEY,
                                value TEXT,
                                updated_at INTEGER DEFAULT (strftime('%s', 'now') * 1000)
                            );
                            
                            -- 6. 个人资料表
                            CREATE TABLE IF NOT EXISTS personal_profile (
                                id INTEGER PRIMARY KEY CHECK (id = 1),
                                data TEXT NOT NULL,
                                updated_at INTEGER DEFAULT (strftime('%s', 'now') * 1000)
                            );
                            
                            -- 7. 通话记录表
                            CREATE TABLE IF NOT EXISTS call_records (
                                id TEXT PRIMARY KEY,
                                data TEXT NOT NULL,
                                updated_at INTEGER DEFAULT (strftime('%s', 'now') * 1000)
                            );
                            
                            -- 8. 荣誉墙数据表
                            CREATE TABLE IF NOT EXISTS honor_wall (
                                id TEXT PRIMARY KEY,
                                data TEXT NOT NULL,
                                updated_at INTEGER DEFAULT (strftime('%s', 'now') * 1000)
                            );
                            
                            -- 9. 聊天徽章表
                            CREATE TABLE IF NOT EXISTS chat_badges (
                                id TEXT PRIMARY KEY,
                                data TEXT NOT NULL,
                                updated_at INTEGER DEFAULT (strftime('%s', 'now') * 1000)
                            );
                            
                            -- 10. 桌面组件数据表（气泡文本、拍立得等）
                            CREATE TABLE IF NOT EXISTS widget_data (
                                key TEXT PRIMARY KEY,
                                value TEXT,
                                updated_at INTEGER DEFAULT (strftime('%s', 'now') * 1000)
                            );
                            
                            -- 11. 应用状态表（版本号、欢迎弹窗状态等）
                            CREATE TABLE IF NOT EXISTS app_state (
                                key TEXT PRIMARY KEY,
                                value TEXT,
                                updated_at INTEGER DEFAULT (strftime('%s', 'now') * 1000)
                            );
                            
                            -- 12. 日记数据表（角色日记）
                            CREATE TABLE IF NOT EXISTS diary_data (
                                id TEXT PRIMARY KEY,
                                data TEXT NOT NULL,
                                updated_at INTEGER DEFAULT (strftime('%s', 'now') * 1000)
                            );
                            
                            -- 13. 日记封面设置表
                            CREATE TABLE IF NOT EXISTS diary_cover_settings (
                                id TEXT PRIMARY KEY,
                                data TEXT NOT NULL,
                                updated_at INTEGER DEFAULT (strftime('%s', 'now') * 1000)
                            );
                            
                            -- 14. 我的日记内容表（简易日记）
                            CREATE TABLE IF NOT EXISTS my_diary_contents (
                                id TEXT PRIMARY KEY,
                                data TEXT NOT NULL,
                                updated_at INTEGER DEFAULT (strftime('%s', 'now') * 1000)
                            );
                            
                            -- 15. 备忘录数据表
                            CREATE TABLE IF NOT EXISTS memo_data (
                                key TEXT PRIMARY KEY,
                                value TEXT,
                                updated_at INTEGER DEFAULT (strftime('%s', 'now') * 1000)
                            );
                            
                            -- 16. 健康记录数据表
                            CREATE TABLE IF NOT EXISTS health_data (
                                key TEXT PRIMARY KEY,
                                value TEXT,
                                updated_at INTEGER DEFAULT (strftime('%s', 'now') * 1000)
                            );
                            
                            -- 17. 学习课桌数据表
                            CREATE TABLE IF NOT EXISTS study_desk_data (
                                id TEXT PRIMARY KEY,
                                data TEXT NOT NULL,
                                updated_at INTEGER DEFAULT (strftime('%s', 'now') * 1000)
                            );
                            
                            -- 18. API 设置表
                            CREATE TABLE IF NOT EXISTS api_settings (
                                key TEXT PRIMARY KEY,
                                value TEXT,
                                updated_at INTEGER DEFAULT (strftime('%s', 'now') * 1000)
                            );
                            
                            -- 19. CSS 预设表
                            CREATE TABLE IF NOT EXISTS css_presets (
                                id TEXT PRIMARY KEY,
                                data TEXT NOT NULL,
                                updated_at INTEGER DEFAULT (strftime('%s', 'now') * 1000)
                            );
                            
                            -- 20. 日记按钮图标表
                            CREATE TABLE IF NOT EXISTS diary_button_icons (
                                key TEXT PRIMARY KEY,
                                data TEXT NOT NULL,
                                updated_at INTEGER DEFAULT (strftime('%s', 'now') * 1000)
                            );

                            -- 21. 恶魔测验数据表
                            CREATE TABLE IF NOT EXISTS demon_quizzes (
                                id TEXT PRIMARY KEY,
                                data TEXT NOT NULL,
                                updated_at INTEGER DEFAULT (strftime('%s', 'now') * 1000)
                            );
                            
                            -- 21. 恶魔测验当前状态表
                            CREATE TABLE IF NOT EXISTS demon_quiz_state (
                                key TEXT PRIMARY KEY,
                                value TEXT,
                                updated_at INTEGER DEFAULT (strftime('%s', 'now') * 1000)
                            );
                        `
                    });
                    
                        console.log('【SQLite】所有数据表创建成功');
                        return true;
                    } catch (error) {
                        console.error('【SQLite】初始化数据库失败:', error);
                        console.error('【SQLite】错误详情:', error.message, error.stack);
                        
                        // 【调试】显示详细错误信息
                        const errorMsg = `SQLite初始化失败:\n\n错误: ${error.message}\n\n堆栈:\n${error.stack || '无堆栈信息'}\n\n请检查:\n1. 是否是APK环境\n2. Capacitor插件是否正常\n3. 数据库文件是否损坏`;
                        console.error(errorMsg);
                        
                        // 使用setTimeout确保alert不会阻塞控制台输出
                        setTimeout(() => {
                            alert(errorMsg);
                        }, 100);
                        
                        this.isAvailable = false;
                        this.db = null;
                        return false;
                    }
                })();
                
                // 【关键修复】内部超时保护
                try {
                    return await Promise.race([
                        initDbPromise,
                        new Promise((_, reject) => 
                            setTimeout(() => reject(new Error('initDatabase内部超时')), INIT_DB_TIMEOUT)
                        )
                    ]);
                } catch (timeoutError) {
                    console.error('【SQLite】initDatabase 超时:', timeoutError.message);
                    this.isAvailable = false;
                    this.db = null;
                    return false;
                }
            },

            // 保存单条消息
            async saveMessage(message) {
                if (!this.isAvailable) {
                    return false;
                }

                try {
                    const { CapacitorSQLite } = window.Capacitor.Plugins;
                    const id = `${message.chatId}_${message.timestamp}`;
                    
                    // 【修复】确保 quote 字段是有效的对象，不是字符串 "[object Object]"
                    let quoteValue = null;
                    if (message.quote) {
                        if (typeof message.quote === 'string') {
                            // 如果 quote 是字符串，尝试解析它
                            if (message.quote === '[object Object]') {
                                console.warn('【SQLite】saveMessage: 检测到无效的 quote 字符串 "[object Object]"，已清空');
                                quoteValue = null;
                            } else {
                                try {
                                    const parsed = JSON.parse(message.quote);
                                    quoteValue = JSON.stringify(parsed);
                                } catch (e) {
                                    console.warn('【SQLite】saveMessage: quote 字符串解析失败，已清空:', message.quote);
                                    quoteValue = null;
                                }
                            }
                        } else if (typeof message.quote === 'object') {
                            quoteValue = JSON.stringify(message.quote);
                        }
                    }
                    
                    await CapacitorSQLite.run({
                        database: 'chat_messages.db',
                        statement: `
                            INSERT OR REPLACE INTO chat_messages 
                            (id, chatId, sender, content, timestamp, type, quote, isTeaching, isDateMessage)
                            VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)
                        `,
                        values: [
                            id,
                            message.chatId,
                            message.sender,
                            message.content || '',
                            message.timestamp,
                            message.type || 'text',
                            quoteValue,
                            message.isTeaching ? 1 : 0,
                            message.isDateMessage ? 1 : 0
                        ]
                    });
                    return true;
                } catch (error) {
                    console.error('【SQLite】保存消息失败:', error);
                    // 【关键修复】不再自动重置数据库，避免递归调用导致闪退
                    // 只在控制台记录错误，不触发重置操作
                    if (error.message && (error.message.includes('database') || error.message.includes('SQLITE') || error.message.includes('corrupt'))) {
                        console.warn('【SQLite】检测到数据库错误，但不再自动重置以避免闪退');
                        // 禁用 SQLite 防止持续报错
                        this.isAvailable = false;
                        localStorage.setItem('__sqlite_corrupted', 'true');
                    }
                    return false;
                }
            },

            // 批量保存消息
            async saveMessages(messages) {
                if (!this.isAvailable) {
                    console.warn('【SQLite】saveMessages: SQLite 不可用');
                    return false;
                }

                try {
                    const { CapacitorSQLite } = window.Capacitor.Plugins;
                    console.log(`【SQLite】开始保存 ${messages.length} 条消息...`);
                    
                    // 逐条保存（某些版本不支持 executeSet）
                    let successCount = 0;
                    for (const msg of messages) {
                        const id = `${msg.chatId}_${msg.timestamp}`;
                        try {
                            // 【修复】确保 quote 字段是有效的对象
                            let quoteValue = null;
                            if (msg.quote) {
                                if (typeof msg.quote === 'string') {
                                    if (msg.quote === '[object Object]') {
                                        console.warn('【SQLite】saveMessages: 检测到无效的 quote 字符串，已清空');
                                        quoteValue = null;
                                    } else {
                                        try {
                                            const parsed = JSON.parse(msg.quote);
                                            quoteValue = JSON.stringify(parsed);
                                        } catch (e) {
                                            quoteValue = null;
                                        }
                                    }
                                } else if (typeof msg.quote === 'object') {
                                    quoteValue = JSON.stringify(msg.quote);
                                }
                            }
                            
                            await CapacitorSQLite.run({
                                database: 'chat_messages.db',
                                statement: `
                                    INSERT OR REPLACE INTO chat_messages 
                                    (id, chatId, sender, content, timestamp, type, quote, isTeaching, isDateMessage)
                                    VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)
                                `,
                                values: [
                                    id,
                                    msg.chatId,
                                    msg.sender,
                                    msg.content || '',
                                    msg.timestamp,
                                    msg.type || 'text',
                                    quoteValue,
                                    msg.isTeaching ? 1 : 0,
                                    msg.isDateMessage ? 1 : 0
                                ]
                            });
                            successCount++;
                        } catch (itemError) {
                            console.error('【SQLite】保存单条消息失败:', id, itemError);
                        }
                    }
                    console.log(`【SQLite】批量保存完成: ${successCount}/${messages.length} 条成功`);
                    return successCount;
                } catch (error) {
                    console.error('【SQLite】批量保存消息失败:', error);
                    // 【关键修复】不再自动重置数据库，避免递归调用导致闪退
                    // 只在控制台记录错误，不触发重置操作
                    if (error.message && (error.message.includes('database') || error.message.includes('SQLITE') || error.message.includes('corrupt'))) {
                        console.warn('【SQLite】检测到数据库错误，但不再自动重置以避免闪退');
                        // 禁用 SQLite 防止持续报错
                        this.isAvailable = false;
                        localStorage.setItem('__sqlite_corrupted', 'true');
                    }
                    return false;
                }
            },

            // 获取指定聊天的消息（分页）- 只返回可见消息
            async getMessages(chatId, offset = 0, limit = 50) {
                if (!this.isAvailable) {
                    return null; // 返回null表示使用IndexedDB
                }

                try {
                    const { CapacitorSQLite } = window.Capacitor.Plugins;
                    // 【关键修复】只查询可见消息，排除教学消息、约会消息、隐藏消息
                    const result = await CapacitorSQLite.query({
                        database: 'chat_messages.db',
                        statement: `
                            SELECT * FROM chat_messages 
                            WHERE chatId = ? 
                            AND isTeaching = 0 
                            AND isDateMessage = 0 
                            AND (type IS NULL OR type != 'hidden')
                            ORDER BY timestamp ASC 
                            LIMIT ? OFFSET ?
                        `,
                        values: [chatId, limit, offset]
                    });

                    return result.values.map(row => {
                        // 【修复】安全解析 quote 字段
                        let parsedQuote = null;
                        if (row.quote && row.quote !== '[object Object]') {
                            try {
                                parsedQuote = JSON.parse(row.quote);
                            } catch (e) {
                                console.warn('【SQLite】getMessages: quote 字段解析失败:', row.id, row.quote);
                                parsedQuote = null;
                            }
                        }
                        return {
                            id: row.id,
                            chatId: row.chatId,
                            sender: row.sender,
                            content: row.content,
                            timestamp: row.timestamp,
                            type: row.type,
                            quote: parsedQuote,
                            isTeaching: row.isTeaching === 1,
                            isDateMessage: row.isDateMessage === 1
                        };
                    });
                } catch (error) {
                    console.error('【SQLite】获取消息失败:', error);
                    return null;
                }
            },

            // 获取消息总数（只统计可见消息，排除isTeaching、isDateMessage等）
            async getMessageCount(chatId) {
                if (!this.isAvailable) {
                    return null;
                }

                try {
                    const { CapacitorSQLite } = window.Capacitor.Plugins;
                    // 【关键修复】只统计可见消息，排除教学消息、约会消息、隐藏消息
                    const result = await CapacitorSQLite.query({
                        database: 'chat_messages.db',
                        statement: `
                            SELECT COUNT(*) as count FROM chat_messages 
                            WHERE chatId = ? 
                            AND isTeaching = 0 
                            AND isDateMessage = 0 
                            AND (type IS NULL OR type != 'hidden')
                        `,
                        values: [chatId]
                    });
                    return result.values[0].count;
                } catch (error) {
                    console.error('【SQLite】获取消息数量失败:', error);
                    return null;
                }
            },

            // 删除单条消息
            async deleteMessage(chatId, timestamp) {
                if (!this.isAvailable) {
                    return false;
                }

                try {
                    const { CapacitorSQLite } = window.Capacitor.Plugins;
                    
                    // 【关键修复】尝试多种ID格式，确保能匹配到消息
                    const idFormats = [
                        `${chatId}_${timestamp}`,           // 原始格式
                        `${chatId}_${Number(timestamp)}`,   // 数字格式
                        `${chatId}_${String(timestamp)}`    // 字符串格式
                    ];
                    
                    console.log('【删除调试】SQLite删除消息，尝试多种ID格式:', idFormats);
                    
                    // 尝试所有ID格式
                    for (const id of idFormats) {
                        const checkResult = await CapacitorSQLite.query({
                            database: 'chat_messages.db',
                            statement: 'SELECT id FROM chat_messages WHERE id = ?',
                            values: [id]
                        });
                        
                        if (checkResult.values && checkResult.values.length > 0) {
                            console.log('【删除调试】找到消息，使用ID:', id);
                            await CapacitorSQLite.run({
                                database: 'chat_messages.db',
                                statement: 'DELETE FROM chat_messages WHERE id = ?',
                                values: [id]
                            });
                            console.log('【删除调试】SQLite删除消息成功:', id);
                            return true;
                        }
                    }
                    
                    // 如果ID匹配失败，尝试使用timestamp字段直接删除
                    console.warn('【删除调试】ID匹配失败，尝试使用timestamp字段删除:', timestamp);
                    const timestampResult = await CapacitorSQLite.run({
                        database: 'chat_messages.db',
                        statement: 'DELETE FROM chat_messages WHERE chatId = ? AND timestamp = ?',
                        values: [chatId, timestamp]
                    });
                    
                    if (timestampResult.changes && timestampResult.changes > 0) {
                        console.log('【删除调试】使用timestamp字段删除成功');
                        return true;
                    }
                    
                    // 尝试数字timestamp
                    const numericTimestampResult = await CapacitorSQLite.run({
                        database: 'chat_messages.db',
                        statement: 'DELETE FROM chat_messages WHERE chatId = ? AND timestamp = ?',
                        values: [chatId, Number(timestamp)]
                    });
                    
                    if (numericTimestampResult.changes && numericTimestampResult.changes > 0) {
                        console.log('【删除调试】使用数字timestamp字段删除成功');
                        return true;
                    }
                    
                    console.warn('【删除调试】消息确实不存在，所有尝试都失败:', { chatId, timestamp });
                    return false;
                } catch (error) {
                    console.error('【SQLite】删除消息失败:', error);
                    return false;
                }
            },

            // 【新增】清空指定聊天的所有消息
            async clearChatMessages(chatId) {
                if (!this.isAvailable) {
                    return false;
                }

                try {
                    const { CapacitorSQLite } = window.Capacitor.Plugins;
                    
                    console.log('【SQLite】清空聊天消息:', chatId);
                    
                    const result = await CapacitorSQLite.run({
                        database: 'chat_messages.db',
                        statement: 'DELETE FROM chat_messages WHERE chatId = ?',
                        values: [chatId]
                    });
                    
                    console.log('【SQLite】清空聊天消息成功:', chatId, '删除数量:', result.changes || 0);
                    return true;
                } catch (error) {
                    console.error('【SQLite】清空聊天消息失败:', error);
                    return false;
                }
            },

            // 【备份专用】获取指定聊天的所有消息（包括不可见消息）
            async getAllMessagesForBackup(chatId) {
                if (!this.isAvailable) {
                    return null;
                }

                try {
                    const { CapacitorSQLite } = window.Capacitor.Plugins;
                    const result = await CapacitorSQLite.query({
                        database: 'chat_messages.db',
                        statement: `
                            SELECT * FROM chat_messages 
                            WHERE chatId = ? 
                            ORDER BY timestamp ASC
                        `,
                        values: [chatId]
                    });

                    return result.values.map(row => {
                        let parsedQuote = null;
                        if (row.quote && row.quote !== '[object Object]') {
                            try {
                                parsedQuote = JSON.parse(row.quote);
                            } catch (e) {
                                parsedQuote = null;
                            }
                        }
                        return {
                            id: row.id,
                            chatId: row.chatId,
                            sender: row.sender,
                            content: row.content,
                            timestamp: row.timestamp,
                            type: row.type,
                            quote: parsedQuote,
                            isTeaching: row.isTeaching === 1,
                            isDateMessage: row.isDateMessage === 1
                        };
                    });
                } catch (error) {
                    console.error('【SQLite】备份获取消息失败:', error);
                    return null;
                }
            },

            // 【备份专用】获取所有消息总数（包括不可见消息）
            async getTotalMessageCountForBackup(chatId) {
                if (!this.isAvailable) {
                    return null;
                }

                try {
                    const { CapacitorSQLite } = window.Capacitor.Plugins;
                    const result = await CapacitorSQLite.query({
                        database: 'chat_messages.db',
                        statement: 'SELECT COUNT(*) as count FROM chat_messages WHERE chatId = ?',
                        values: [chatId]
                    });
                    return result.values[0].count;
                } catch (error) {
                    console.error('【SQLite】备份获取消息数量失败:', error);
                    return null;
                }
            },

            // 关闭数据库
            async close() {
                if (this.isAvailable) {
                    try {
                        const { CapacitorSQLite } = window.Capacitor.Plugins;
                        await CapacitorSQLite.close({
                            database: 'chat_messages.db'
                        });
                        this.db = null;
                        console.log('【SQLite】数据库连接已关闭');
                    } catch (error) {
                        console.error('【SQLite】关闭数据库失败:', error);
                    }
                }
            },

            // 【新增】获取指定聊天的所有消息（用于导出）
            async getAllMessages(chatId) {
                if (!this.isAvailable) {
                    return null;
                }

                try {
                    const { CapacitorSQLite } = window.Capacitor.Plugins;
                    const result = await CapacitorSQLite.query({
                        database: 'chat_messages.db',
                        statement: `
                            SELECT * FROM chat_messages 
                            WHERE chatId = ? 
                            ORDER BY timestamp ASC
                        `,
                        values: [chatId]
                    });

                    return result.values.map(row => ({
                        id: row.id,
                        chatId: row.chatId,
                        sender: row.sender,
                        content: row.content,
                        timestamp: row.timestamp,
                        type: row.type,
                        quote: row.quote ? JSON.parse(row.quote) : null,
                        isTeaching: row.isTeaching === 1,
                        isDateMessage: row.isDateMessage === 1
                    }));
                } catch (error) {
                    console.error('【SQLite】获取所有消息失败:', error);
                    return null;
                }
            },

            // 【新增】清理旧消息，只保留每个聊天的最新N条
            async cleanupOldMessages(maxMessagesPerChat = 1000) {
                if (!this.isAvailable) {
                    return false;
                }

                try {
                    const { CapacitorSQLite } = window.Capacitor.Plugins;
                    console.log('【SQLite】开始清理旧消息，每个聊天保留最新', maxMessagesPerChat, '条');
                    
                    // 获取所有聊天ID
                    const chatResult = await CapacitorSQLite.query({
                        database: 'chat_messages.db',
                        statement: 'SELECT DISTINCT chatId FROM chat_messages'
                    });
                    
                    let totalDeleted = 0;
                    
                    for (const row of chatResult.values) {
                        const chatId = row.chatId;
                        
                        // 获取该聊天的消息总数
                        const countResult = await this.db.query({
                            statement: 'SELECT COUNT(*) as count FROM chat_messages WHERE chatId = ?',
                            values: [chatId]
                        });
                        
                        const messageCount = countResult.values[0].count;
                        
                        if (messageCount > maxMessagesPerChat) {
                            // 删除旧消息，只保留最新的
                            const deleteResult = await this.db.run({
                                statement: `
                                    DELETE FROM chat_messages 
                                    WHERE chatId = ? AND id IN (
                                        SELECT id FROM chat_messages 
                                        WHERE chatId = ? 
                                        ORDER BY timestamp ASC 
                                        LIMIT ?
                                    )
                                `,
                                values: [chatId, chatId, messageCount - maxMessagesPerChat]
                            });
                            
                            totalDeleted += deleteResult.changes || 0;
                            console.log(`【SQLite】聊天 ${chatId} 已清理 ${deleteResult.changes || 0} 条旧消息`);
                        }
                    }
                    
                    console.log('【SQLite】清理完成，共删除', totalDeleted, '条旧消息');
                    
                    // 执行 VACUUM 回收空间
                    await this.vacuumDatabase();
                    
                    return true;
                } catch (error) {
                    console.error('【SQLite】清理旧消息失败:', error);
                    return false;
                }
            },

            // 【新增】执行 VACUUM 回收数据库空间
            async vacuumDatabase() {
                if (!this.isAvailable || !this.db) {
                    return false;
                }

                try {
                    console.log('【SQLite】执行 VACUUM 回收空间...');
                    await this.db.execute({ statements: 'VACUUM' });
                    console.log('【SQLite】VACUUM 完成');
                    return true;
                } catch (error) {
                    console.error('【SQLite】VACUUM 失败:', error);
                    return false;
                }
            },

            // 【新增】获取数据库大小（估算）
            async getDatabaseSize() {
                if (!this.isAvailable) {
                    return null;
                }

                try {
                    const { CapacitorSQLite } = window.Capacitor.Plugins;
                    const result = await CapacitorSQLite.query({
                        database: 'chat_messages.db',
                        statement: `
                            SELECT 
                                COUNT(*) as messageCount,
                                SUM(LENGTH(content)) as totalContentSize
                            FROM chat_messages
                        `
                    });
                    
                    return {
                        messageCount: result.values[0].messageCount,
                        totalContentSize: result.values[0].totalContentSize || 0
                    };
                } catch (error) {
                    console.error('【SQLite】获取数据库大小失败:', error);
                    return null;
                }
            },

            // ==================== 统一存储方法 ====================
            
