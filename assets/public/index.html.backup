        }

        // 处理图片文件选择 - 添加压缩功能防止闪退
        function handleAccountingImageFile(input, targetInputId) {
            if (input.files && input.files[0]) {
                const file = input.files[0];
                
                // 【防闪退】检查文件大小，限制为10MB
                const maxSize = 10 * 1024 * 1024; // 10MB
                if (file.size > maxSize) {
                    alert('图片太大，请选择小于10MB的图片');
                    input.value = '';
                    return;
                }
                
                const reader = new FileReader();
                reader.onload = function(e) {
                    const imageData = e.target.result;
                    
                    // 【防闪退】压缩图片，类似微信头像压缩
                    compressImage(imageData, 1024, 1024, 0.85).then(compressedData => {
                        const targetInput = document.getElementById(targetInputId);
                        if (targetInput) {
                            targetInput.value = compressedData;
                        }
                        console.log('📸 记账图片压缩完成:', {
                            original: imageData.length,
                            compressed: compressedData.length,
                            ratio: ((1 - compressedData.length / imageData.length) * 100).toFixed(2) + '%'
                        });
                    }).catch(err => {
                        console.error('❌ 图片压缩失败:', err);
                        // 压缩失败时使用原图
                        const targetInput = document.getElementById(targetInputId);
                        if (targetInput) {
                            targetInput.value = imageData;
                        }
                    });
                };
                reader.onerror = function(e) {
                    console.error('❌ 图片读取失败:', e);
                    alert('图片读取失败，请重试');
                };
                reader.readAsDataURL(file);
            }
        }

        // 保存图片设置
        async function saveAccountingImageSettings() {
            const settings = {
                mainBgUrl: document.getElementById('accountingMainBgUrl')?.value || '',
                commentBgUrl: document.getElementById('accountingCommentBgUrl')?.value || '',
                cardBgUrl: document.getElementById('accountingCardBgUrl')?.value || '',
                totalBudgetBgUrl: document.getElementById('accountingTotalBudgetBgUrl')?.value || '',
                remainingBudgetBgUrl: document.getElementById('accountingRemainingBudgetBgUrl')?.value || '',
                recordBgUrl: document.getElementById('accountingRecordBgUrl')?.value || ''
            };

            try {
                await localforage.setItem('accountingImageSettings', settings);
                applyAccountingImageSettings(settings);
                closeAccountingImageSettings();
                console.log('记账页面背景设置已保存到本地存储');
                alert('背景设置已保存！');
            } catch (error) {
                console.error('保存背景设置失败:', error);
                alert('保存失败，请重试');
            }
        }

        // 加载图片设置
        async function loadAccountingImageSettings() {
            try {
                const settings = await localforage.getItem('accountingImageSettings');
                if (settings) {
                    if (document.getElementById('accountingMainBgUrl')) {
                        document.getElementById('accountingMainBgUrl').value = settings.mainBgUrl || '';
                    }
                    if (document.getElementById('accountingCommentBgUrl')) {
                        document.getElementById('accountingCommentBgUrl').value = settings.commentBgUrl || '';
                    }
                    if (document.getElementById('accountingCardBgUrl')) {
                        document.getElementById('accountingCardBgUrl').value = settings.cardBgUrl || '';
                    }
                    if (document.getElementById('accountingTotalBudgetBgUrl')) {
                        document.getElementById('accountingTotalBudgetBgUrl').value = settings.totalBudgetBgUrl || '';
                    }
                    if (document.getElementById('accountingRemainingBudgetBgUrl')) {
                        document.getElementById('accountingRemainingBudgetBgUrl').value = settings.remainingBudgetBgUrl || '';
                    }
                    if (document.getElementById('accountingRecordBgUrl')) {
                        document.getElementById('accountingRecordBgUrl').value = settings.recordBgUrl || '';
                    }
                }
            } catch (error) {
                console.error('加载背景设置失败:', error);
            }
        }

        // 应用图片设置到页面
        function applyAccountingImageSettings(settings) {
            if (!settings) return;

            // 应用页面总背景
            if (settings.mainBgUrl) {
                const accountingPage = document.getElementById('accountingPage');
                if (accountingPage) {
                    accountingPage.style.backgroundImage = `url('${settings.mainBgUrl}')`;
                    accountingPage.style.backgroundSize = 'cover';
                    accountingPage.style.backgroundPosition = 'center';
                    accountingPage.style.backgroundAttachment = 'fixed';
                }
            }

            // 应用评语区域背景
            if (settings.commentBgUrl) {
                const commentSection = document.getElementById('accountingCommentSection');
                if (commentSection) {
                    commentSection.style.background = `url('${settings.commentBgUrl}') center/cover no-repeat`;
                }
            }

            // 应用本周表现卡片背景
            if (settings.cardBgUrl) {
                const cardSection = document.getElementById('accountingCardSection');
                if (cardSection) {
                    cardSection.style.background = `url('${settings.cardBgUrl}') center/cover no-repeat`;
                }
            }

            // 应用总预算卡片背景
            if (settings.totalBudgetBgUrl) {
                const totalBudgetCard = document.getElementById('totalBudgetCard');
                if (totalBudgetCard) {
                    totalBudgetCard.style.background = `url('${settings.totalBudgetBgUrl}') center/cover no-repeat`;
                }
            }

            // 应用剩余预算卡片背景
            if (settings.remainingBudgetBgUrl) {
                const remainingBudgetCard = document.getElementById('remainingBudgetCard');
                if (remainingBudgetCard) {
                    remainingBudgetCard.style.background = `url('${settings.remainingBudgetBgUrl}') center/cover no-repeat`;
                }
            }

            // 应用消费记录卡片背景
            if (settings.recordBgUrl) {
                const recordCard = document.getElementById('accountingRecordCard');
                if (recordCard) {
                    recordCard.style.background = `url('${settings.recordBgUrl}') center/cover no-repeat`;
                    // 隐藏边框效果，让背景图片更完整显示
                    const borderEl = document.getElementById('accountingRecordBorder');
                    if (borderEl) borderEl.style.display = 'none';
                }
            }
        }

        // 初始化时加载图片设置
        document.addEventListener('DOMContentLoaded', async () => {
            try {
                const settings = await localforage.getItem('accountingImageSettings');
                if (settings) {
                    applyAccountingImageSettings(settings);
                }
            } catch (error) {
                console.error('初始化背景设置失败:', error);
            }
        });

        // ==================== 记账页面图片设置功能结束 ====================

        // ==================== 记账功能结束 ====================

        // 学习课桌数据存储
        let studyDeskData = {
            goals: [],
            todayTasks: [],
            studyRecords: [], // 学习记录
            lastStudyDate: null // 最后学习日期
        };

        // 当前学习状态
        let currentStudyState = {
            companionMode: false,
            teachingMode: false,
            companionStartTime: null,
            teachingStartTime: null,
            companionTimer: null,
            teachingTimer: null
        };

        // 检查是否需要刷新数据（新的一天）
        function checkDailyRefresh() {
            const today = new Date().toDateString();
            if (studyDeskData.lastStudyDate && studyDeskData.lastStudyDate !== today) {
                // 新的一天，重置今日任务和学习记录
                studyDeskData.todayTasks = [];
                studyDeskData.studyRecords = [];
                console.log('新的一天，已重置今日任务和学习记录');
            }
            studyDeskData.lastStudyDate = today;
            saveStudyDeskData();
        }

        // 陪伴模式设置
        let companionSettings = {
            duration: 25,
            videoFile: null,
            videoFileName: null,
            person: null
        };

        // 加载陪伴模式设置
        async function loadCompanionSettings() {
            try {
                const saved = await localforage.getItem('companionSettings');
                if (saved) {
                    companionSettings.duration = saved.duration || 25;
                    companionSettings.videoFileName = saved.videoFileName || null;
                    companionSettings.videoData = saved.videoData || null; // 加载视频数据
                    companionSettings.person = saved.person || null;
                    console.log('陪伴模式设置已加载:', companionSettings);
                }
            } catch (error) {
                console.error('加载陪伴模式设置失败:', error);
            }
        }

        // 保存陪伴模式设置
        async function saveCompanionSettings() {
            try {
                const settingsToSave = {
                    duration: companionSettings.duration,
                    videoFileName: companionSettings.videoFileName,
                    videoData: companionSettings.videoData, // 保存视频base64数据
                    person: companionSettings.person
                };
                await localforage.setItem('companionSettings', settingsToSave);
                console.log('陪伴模式设置已保存');
            } catch (error) {
                console.error('保存陪伴模式设置失败:', error);
            }
        }

        // 打开陪伴模式设置弹窗
        async function openCompanionSettings() {
            const modal = document.getElementById('companionSettingsModal');
            if (!modal) return;

            // 加载保存的设置
            await loadCompanionSettings();

            // 设置学习时间
            const minutesInput = document.getElementById('companionStudyMinutes');
            if (minutesInput) {
                minutesInput.value = companionSettings.duration || 25;
            }

            // 设置视频名称显示
            const videoNameEl = document.getElementById('companionVideoName');
            if (videoNameEl) {
                videoNameEl.textContent = companionSettings.videoFileName || '点击选择视频';
            }

            // 设置陪伴人显示
            const personList = document.getElementById('companionPersonList');
            const personName = document.getElementById('companionPersonName');

            if (companionSettings.person) {
                // 显示已选择的陪伴人
                if (personList) {
                    personList.innerHTML = `
                        <div style="min-width: 60px; width: 60px; height: 60px; border-radius: 50%; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); display: flex; align-items: center; justify-content: center; font-size: 24px; overflow: hidden; border: 3px solid #ff6b6b; flex-shrink: 0;">
                            ${companionSettings.person.avatar ? `<img src="${companionSettings.person.avatar}" style="width: 60px; height: 60px; object-fit: cover; border-radius: 50%;">` : (companionSettings.person.name ? companionSettings.person.name.charAt(0) : '?')}
                        </div>
                        <div onclick="openCompanionPersonSelector()" style="min-width: 60px; width: 60px; height: 60px; border-radius: 50%; background: linear-gradient(135deg, #f5f7fa 0%, #e8ecf1 100%); border: 2px dashed #ccc; display: flex; align-items: center; justify-content: center; cursor: pointer; font-size: 20px; color: #999; flex-shrink: 0;">+</div>
                    `;
                }
                if (personName) {
                    personName.textContent = companionSettings.person.name;
                }
            } else {
                // 显示默认的+按钮
                if (personList) {
                    personList.innerHTML = `
                        <div onclick="openCompanionPersonSelector()" style="min-width: 60px; width: 60px; height: 60px; border-radius: 50%; background: linear-gradient(135deg, #f5f7fa 0%, #e8ecf1 100%); border: 2px dashed #ccc; display: flex; align-items: center; justify-content: center; cursor: pointer; font-size: 24px; flex-shrink: 0;">+</div>
                    `;
                }
                if (personName) {
                    personName.textContent = '点击+选择陪伴人';
                }
            }

            modal.style.display = 'flex';
        }

        // 关闭陪伴模式设置弹窗
        function closeCompanionSettings() {
            const modal = document.getElementById('companionSettingsModal');
            if (modal) {
                modal.style.display = 'none';
            }
        }

        // 将文件转换为Base64
        function fileToBase64(file) {
            return new Promise((resolve, reject) => {
                const reader = new FileReader();
                reader.onload = () => resolve(reader.result);
                reader.onerror = reject;
                reader.readAsDataURL(file);
            });
        }

        // 视频文件选择处理
        function initCompanionVideoInput() {
            const videoInput = document.getElementById('companionVideoInput');
            if (videoInput) {
                videoInput.addEventListener('change', async function(e) {
                    const file = e.target.files[0];
                    if (file) {
                        try {
                            // 显示加载提示
                            document.getElementById('companionVideoName').textContent = '正在保存视频...';

                            // 将视频转换为base64
                            const base64Video = await fileToBase64(file);

                            // 保存到设置
                            companionSettings.videoFile = file;
                            companionSettings.videoFileName = file.name;
                            companionSettings.videoData = base64Video; // 保存base64数据

                            document.getElementById('companionVideoName').textContent = file.name;
                            await saveCompanionSettings(); // 保存设置（包含视频数据）
                            console.log('视频已选择并保存:', file.name);
                        } catch (error) {
                            console.error('保存视频失败:', error);
                            document.getElementById('companionVideoName').textContent = '保存失败，请重试';
                        }
                    }
                });
            }
        }

        // 初始化视频输入
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initCompanionVideoInput);
        } else {
            initCompanionVideoInput();
        }

        // 打开陪伴人选择弹窗
        function openCompanionPersonSelector() {
            const modal = document.getElementById('companionPersonSelectorModal');
            const optionsContainer = document.getElementById('companionPersonOptions');

            if (!modal || !optionsContainer) return;

            // 清空现有选项
            optionsContainer.innerHTML = '';

            // 从微信列表获取角色
            if (relationshipData.wechatChatList && relationshipData.wechatChatList.length > 0) {
                relationshipData.wechatChatList.forEach(person => {
                    const personDiv = document.createElement('div');
                    personDiv.style.cssText = 'display: flex; align-items: center; gap: 12px; padding: 12px; background: #f8f9fa; border-radius: 12px; cursor: pointer; transition: background 0.2s;';
                    personDiv.onmouseover = function() { this.style.background = '#e8f4f8'; };
                    personDiv.onmouseout = function() { this.style.background = '#f8f9fa'; };
                    personDiv.onclick = function() { selectCompanionPerson(person); };

                    // 头像
                    const avatarDiv = document.createElement('div');
                    avatarDiv.style.cssText = 'width: 45px; height: 45px; border-radius: 50%; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); display: flex; align-items: center; justify-content: center; font-size: 20px; overflow: hidden;';
                    if (person.avatar) {
                        avatarDiv.innerHTML = `<img src="${person.avatar}" style="width: 100%; height: 100%; object-fit: cover;">`;
                    } else {
                        avatarDiv.textContent = person.name ? person.name.charAt(0) : '?';
                    }

                    // 名字
                    const nameDiv = document.createElement('div');
                    nameDiv.style.cssText = 'flex: 1; font-size: 16px; color: #333;';
                    nameDiv.textContent = person.name || '未命名';

                    personDiv.appendChild(avatarDiv);
                    personDiv.appendChild(nameDiv);
                    optionsContainer.appendChild(personDiv);
                });
            } else {
                optionsContainer.innerHTML = '<div style="text-align: center; padding: 20px; color: #999;">暂无角色，请先在微信列表创建角色</div>';
            }

            modal.style.display = 'flex';
        }

        // 关闭陪伴人选择弹窗
        function closeCompanionPersonSelector() {
            const modal = document.getElementById('companionPersonSelectorModal');
            if (modal) {
                modal.style.display = 'none';
            }
        }

        // 选择陪伴人
        function selectCompanionPerson(person) {
            companionSettings.person = {
                id: person.id,
                name: person.name,
                avatar: person.avatar
            };
            saveCompanionSettings(); // 保存设置

            // 更新UI显示
            const personList = document.getElementById('companionPersonList');
            const personName = document.getElementById('companionPersonName');

            if (personList) {
                personList.innerHTML = `
                    <div style="min-width: 60px; width: 60px; height: 60px; border-radius: 50%; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); display: flex; align-items: center; justify-content: center; font-size: 24px; overflow: hidden; border: 3px solid #ff6b6b; flex-shrink: 0;">
                        ${person.avatar ? `<img src="${person.avatar}" style="width: 60px; height: 60px; object-fit: cover; border-radius: 50%;">` : person.name.charAt(0)}
                    </div>
                    <div onclick="openCompanionPersonSelector()" style="min-width: 60px; width: 60px; height: 60px; border-radius: 50%; background: linear-gradient(135deg, #f5f7fa 0%, #e8ecf1 100%); border: 2px dashed #ccc; display: flex; align-items: center; justify-content: center; cursor: pointer; font-size: 20px; color: #999; flex-shrink: 0;">+</div>
                `;
            }

            if (personName) {
                personName.textContent = person.name;
            }

            closeCompanionPersonSelector();
            console.log('已选择陪伴人:', person.name);
        }

        // 开始陪伴模式（全屏）
        async function startCompanionMode() {
            const minutes = parseInt(document.getElementById('companionStudyMinutes').value) || 25;
            companionSettings.duration = minutes;

            console.log('开始陪伴模式，视频文件:', companionSettings.videoFile);

            // 关闭设置弹窗
            closeCompanionSettings();

            // 停止后台活动定时器
            stopBackgroundActivityTimer();
            console.log('已停止后台活动定时器');

            // 如果有选择陪伴人，静默发送"开始学习陪伴"消息
            if (companionSettings.person && companionSettings.person.id) {
                await sendCompanionStartMessage(companionSettings.person.id);
            }

            // 显示全屏页面
            const fullScreen = document.getElementById('companionFullScreen');
            const videoPlayer = document.getElementById('companionVideoPlayer');

            if (companionSettings.videoData) {
                // 使用保存的base64视频数据
                console.log('使用保存的视频数据');
                videoPlayer.src = companionSettings.videoData;
                videoPlayer.load();
                videoPlayer.play().then(() => {
                    console.log('视频播放成功');
                }).catch(err => {
                    console.error('视频播放失败:', err);
                });
            } else if (companionSettings.videoFile) {
                // 兼容旧版本：如果有文件对象但没有base64数据
                const videoUrl = URL.createObjectURL(companionSettings.videoFile);
                console.log('视频URL:', videoUrl);
                videoPlayer.src = videoUrl;
                videoPlayer.load();
                videoPlayer.play().then(() => {
                    console.log('视频播放成功');
                }).catch(err => {
                    console.error('视频播放失败:', err);
                });
            } else {
                console.log('没有视频文件');
                videoPlayer.src = '';
            }

            fullScreen.style.display = 'block';

            // 开始倒计时
            let remainingSeconds = minutes * 60;
            updateCompanionCountdown(remainingSeconds);

            currentStudyState.companionTimer = setInterval(() => {
                remainingSeconds--;
                updateCompanionCountdown(remainingSeconds);

                if (remainingSeconds <= 0) {
                    // 时间到，自动退出
                    exitCompanionMode();
                }
            }, 1000);

            // 记录开始时间
            currentStudyState.companionStartTime = Date.now();

            console.log(`陪伴模式开始，设定时间: ${minutes}分钟`);
        }

        // 发送陪伴开始消息（静默）
        async function sendCompanionStartMessage(personId) {
            try {
                const chatItem = relationshipData.wechatChatList.find(item => item.id == personId);
                if (!chatItem) {
                    console.error('未找到陪伴人角色');
                    return;
                }

                // 创建操作框消息
                const message = {
                    id: Date.now(),
                    sender: 'user',
                    text: '开始学习陪伴',
                    timestamp: Date.now(),
                    isActionBox: true,
                    actionType: 'companion_start'
                };

                // 保存到聊天记录
                if (!relationshipData.chatMessages) {
                    relationshipData.chatMessages = [];
                }
                relationshipData.chatMessages.push({
                    ...message,
                    chatId: personId
                });

                await saveData();
                console.log('已静默发送"开始学习陪伴"消息');

                // 保存操作框到localforage
                await saveCompanionActionBox(message, personId);

                // 如果当前就在该角色的聊天页面，立即显示操作框
                if (currentChatId == personId) {
                    showActionBoxMessage('开始学习陪伴', true);
                }

            } catch (error) {
                console.error('发送陪伴开始消息失败:', error);
            }
        }

        // 保存陪伴操作框到localforage
        async function saveCompanionActionBox(message, personId) {
            try {
                let actionBoxes = await localforage.getItem('companionActionBoxes') || [];
                actionBoxes.push({
                    ...message,
                    personId: personId,
                    savedAt: Date.now()
                });
                await localforage.setItem('companionActionBoxes', actionBoxes);
                console.log('操作框已保存到localforage');
            } catch (error) {
                console.error('保存操作框失败:', error);
            }
        }

        // 更新倒计时显示
        function updateCompanionCountdown(seconds) {
            const hours = Math.floor(seconds / 3600);
            const minutes = Math.floor((seconds % 3600) / 60);
            const secs = seconds % 60;
            const timeStr = `${hours.toString().padStart(2, '0')}:${minutes.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
            document.getElementById('companionCountdown').textContent = timeStr;
        }

        // 退出陪伴模式
        async function exitCompanionMode() {
            // 停止计时器
            if (currentStudyState.companionTimer) {
                clearInterval(currentStudyState.companionTimer);
                currentStudyState.companionTimer = null;
            }

            // 停止视频
            const videoPlayer = document.getElementById('companionVideoPlayer');
            if (videoPlayer) {
                videoPlayer.pause();
                videoPlayer.src = '';
            }

            // 计算学习时长
            const endTime = Date.now();
            const duration = Math.floor((endTime - currentStudyState.companionStartTime) / 1000);
            const durationMinutes = Math.floor(duration / 60);

            console.log(`退出陪伴模式，学习时长: ${duration}秒 (${durationMinutes}分钟)`);
            console.log(`陪伴人:`, companionSettings.person);

            // 记录学习（至少1分钟才记录）
            let shouldGoToChat = false;
            if (durationMinutes >= 1) {
                if (!studyDeskData.studyRecords) {
                    studyDeskData.studyRecords = [];
                }
                const record = {
                    id: Date.now(),
                    type: 'companion',
                    startTime: currentStudyState.companionStartTime,
                    endTime: endTime,
                    duration: duration,
                    durationMinutes: durationMinutes
                };
                studyDeskData.studyRecords.push(record);
                await saveStudyDeskData();
                console.log(`陪伴模式结束，学习时长: ${durationMinutes}分钟`);

                // 如果有陪伴人，切换到他的聊天页面并发送结束消息
                if (companionSettings.person && companionSettings.person.id) {
                    console.log(`准备发送结束消息给陪伴人: ${companionSettings.person.id}`);
                    await finishCompanionSession(companionSettings.person.id, durationMinutes);
                    shouldGoToChat = true;
                } else {
                    console.log('没有陪伴人，不发送结束消息');
                }
            } else {
                console.log(`学习时长不足1分钟(${durationMinutes}分钟)，不发送结束消息`);
            }

            // 如果没有跳转到聊天页面，则显示学习课桌
            if (!shouldGoToChat) {
                // 隐藏全屏页面
                document.getElementById('companionFullScreen').style.display = 'none';
                // 刷新学习记录显示
                renderStudyRecords();
            }

            // 重置设置
            currentStudyState.companionStartTime = null;
            companionSettings.videoFile = null;
            // 注意：不重置 videoFileName，保留用户选择的视频文件名

            // 【修改】不再自动重新启动后台活动定时器
            // startBackgroundActivityTimer();
            // console.log('已重新启动后台活动定时器');
        }

        // 结束陪伴会话
        async function finishCompanionSession(personId, durationMinutes) {
            try {
                console.log(`开始执行finishCompanionSession，personId: ${personId}, durationMinutes: ${durationMinutes}`);
                
                // 先切换到对应角色的聊天页面
                const chatItem = relationshipData.wechatChatList.find(item => item.id == personId);
                if (!chatItem) {
                    console.error('未找到陪伴人角色');
                    return;
                }
                console.log(`找到陪伴人: ${chatItem.name}`);

                // 创建结束操作框消息（在打开界面前就创建好）
                const endMessage = {
                    id: Date.now(),
                    sender: 'user',
                    text: `结束学习陪伴，一共学习了${durationMinutes}分钟`,
                    timestamp: Date.now(),
                    isActionBox: true,
                    actionType: 'companion_end',
                    durationMinutes: durationMinutes
                };
                console.log('创建结束操作框消息:', endMessage);

                // 先保存到聊天记录（在打开界面前）
                if (!relationshipData.chatMessages) {
                    relationshipData.chatMessages = [];
                }
                relationshipData.chatMessages.push({
                    ...endMessage,
                    chatId: personId
                });
                console.log('已保存到聊天记录，当前消息数:', relationshipData.chatMessages.length);

                // 保存操作框到localforage
                await saveCompanionActionBox(endMessage, personId);

                // 保存数据
                await saveData();

                // 打开聊天界面（此时操作框已经在聊天记录中）
                openChatInterface(personId, chatItem.remark, chatItem.avatar);
                console.log('已切换到陪伴人聊天页面');

                console.log('陪伴结束消息已发送');

            } catch (error) {
                console.error('结束陪伴会话失败:', error);
            }
        }

        // 调用API获取陪伴结束回复
        async function callAIForCompanionEnd(chatItem, durationMinutes) {
            try {
                // 从设置中获取API配置
                const savedSettings = await loadAppSettings({});
                const apiKey = savedSettings.api?.apiKey || '';
                const apiUrl = savedSettings.api?.baseUrl || 'https://api.openai.com/v1';
                const modelName = savedSettings.api?.model || 'gpt-4o';
                const apiTemperature = savedSettings.api?.temperature ?? 0.7;
                
                if (!apiKey) {
                    console.error('未配置API密钥');
                    return `辛苦啦！学习了${durationMinutes}分钟，你真棒！`;
                }

                // 构建系统提示词
                const systemPrompt = `你是${chatItem.name}，正在陪伴用户学习。用户刚刚结束了${durationMinutes}分钟的学习陪伴。请根据你的角色设定，对用户的努力学习给予鼓励、表扬或温暖的回应。回复要自然、贴心，体现你的角色性格。`;

                // 构建消息历史
                const messages = [
                    { role: 'system', content: systemPrompt },
                    { role: 'user', content: `我刚刚完成了${durationMinutes}分钟的学习陪伴` }
                ];

                // 调用API
                // 【修复】添加超时处理，防止请求卡住
                const controller = new AbortController();
                const timeoutId = setTimeout(() => controller.abort(), 300000); // 【修改】300秒超时

                const response = await fetch(`${apiUrl}/chat/completions`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${apiKey}`
                    },
                    body: JSON.stringify({
                        model: modelName,
                        messages: messages,
                        temperature: apiTemperature,
                        max_tokens: 200
                    }),
                    signal: controller.signal
                });

                clearTimeout(timeoutId); // 请求成功，清除超时

                if (!response.ok) {
                    throw new Error(`API请求失败: ${response.status}`);
                }

                const data = await response.json();
                const reply = data.choices[0].message.content;
                console.log('AI回复:', reply);
                return reply;

            } catch (error) {
                console.error('调用API失败:', error);
                // 返回默认回复
                return `辛苦啦！学习了${durationMinutes}分钟，你真棒！`;
            }
        }

        // 教学模式设置
        let teachingSettings = {
            teacher: null
        };

        // 切换教学模式
        async function toggleTeachingMode() {
            if (!currentStudyState.teachingMode) {
                // 先选择AI老师
                openTeachingTeacherSelector();
            } else {
                // 结束教学模式
                await exitTeachingMode();
            }
        }

        // 打开教学AI选择弹窗
        function openTeachingTeacherSelector() {
            const modal = document.getElementById('teachingTeacherSelectorModal');
            const optionsContainer = document.getElementById('teachingTeacherOptions');
            
            if (!modal || !optionsContainer) return;
            
            // 清空现有选项
            optionsContainer.innerHTML = '';
            
            // 从微信列表获取角色
            if (relationshipData.wechatChatList && relationshipData.wechatChatList.length > 0) {
                relationshipData.wechatChatList.forEach(chat => {
                    const option = document.createElement('div');
                    option.style.cssText = `
                        display: flex;
                        align-items: center;
                        gap: 12px;
                        padding: 12px;
                        background: #f8f9fa;
                        border-radius: 12px;
                        cursor: pointer;
                        transition: all 0.2s;
                    `;
                    option.onmouseover = () => option.style.background = '#e8f4f8';
                    option.onmouseout = () => option.style.background = '#f8f9fa';
                    option.onclick = () => selectTeachingTeacher(chat);
                    
                    const avatar = document.createElement('img');
                    avatar.src = chat.avatar || 'https://img.58sb.cn/file/img/placeholder.png';
                    avatar.style.cssText = 'width: 45px; height: 45px; border-radius: 50%; object-fit: cover;';
                    
                    const info = document.createElement('div');
                    info.style.cssText = 'flex: 1;';
                    info.innerHTML = `
                        <div style="font-weight: 600; color: #333; font-size: 15px;">${chat.remark || chat.name}</div>
                        <div style="font-size: 12px; color: #999;">点击选择作为老师</div>
                    `;
                    
                    option.appendChild(avatar);
                    option.appendChild(info);
                    optionsContainer.appendChild(option);
                });
            } else {
                optionsContainer.innerHTML = '<div style="text-align: center; color: #999; padding: 20px;">暂无角色，请先添加微信联系人</div>';
            }
            
            modal.style.display = 'flex';
        }

        // 关闭教学AI选择弹窗
        function closeTeachingTeacherSelector() {
            const modal = document.getElementById('teachingTeacherSelectorModal');
            if (modal) modal.style.display = 'none';
        }

        // 选择教学AI
        function selectTeachingTeacher(chatItem) {
            teachingSettings.teacher = chatItem;
            closeTeachingTeacherSelector();
            
            // 开始教学模式
            startTeachingMode();
        }

        // 开始教学模式
        async function startTeachingMode() {
            // 设置状态
            currentStudyState.teachingMode = true;
            currentStudyState.teachingStartTime = Date.now();

            // 显示教学页面
            const teachingPage = document.getElementById('teachingModePage');
            if (teachingPage) {
                teachingPage.style.display = 'flex';
            }

            // 清空之前的聊天
            const chatArea = document.getElementById('teachingChatArea');
            if (chatArea) {
                chatArea.innerHTML = '';
            }

            // 加载上次保存的题目（如果有）
            const blackboard = document.getElementById('teachingBlackboard');
            if (blackboard) {
                // 先清空
                blackboard.value = '';
                // 加载保存的题目
                if (studyDeskData.lastTeachingQuestion) {
                    blackboard.value = studyDeskData.lastTeachingQuestion;
                    console.log('已加载上次保存的题目');
                }
            }

            // 清空输入框
            const input = document.getElementById('teachingInput');
            if (input) {
                input.value = '';
            }

            // 开始计时器
            currentStudyState.teachingTimer = setInterval(() => {
                const elapsed = Math.floor((Date.now() - currentStudyState.teachingStartTime) / 1000);
                const timerEl = document.getElementById('teachingModeTimer');
                if (timerEl) {
                    timerEl.textContent = formatStudyTime(elapsed);
                }
            }, 1000);

            console.log('教学模式开始，老师:', teachingSettings.teacher?.name);
        }

        // 退出教学模式
        async function exitTeachingMode() {
            // 停止计时器
            if (currentStudyState.teachingTimer) {
                clearInterval(currentStudyState.teachingTimer);
                currentStudyState.teachingTimer = null;
            }

            // 计算学习时长
            const endTime = Date.now();
            const duration = Math.floor((endTime - currentStudyState.teachingStartTime) / 1000);
            const durationMinutes = Math.floor(duration / 60);

            // 记录学习（至少1分钟）
            if (durationMinutes >= 1) {
                if (!studyDeskData.studyRecords) {
                    studyDeskData.studyRecords = [];
                }
                const record = {
                    id: Date.now(),
                    type: 'teaching',
                    startTime: currentStudyState.teachingStartTime,
                    endTime: endTime,
                    duration: duration,
                    durationMinutes: durationMinutes
                };
                studyDeskData.studyRecords.push(record);
                await saveStudyDeskData();
                renderStudyRecords();
                console.log(`教学模式结束，学习时长: ${durationMinutes}分钟`);
            }

            // 保存当前黑板上的题目
            const blackboard = document.getElementById('teachingBlackboard');
            if (blackboard && blackboard.value.trim()) {
                studyDeskData.lastTeachingQuestion = blackboard.value.trim();
                await saveStudyDeskData();
            }

            // 获取本次教学的聊天记录并总结
            const teacherId = teachingSettings.teacher?.id;
            if (teacherId) {
                // 获取本次教学的消息（从教学模式开始时间到现在）
                const teachingMessages = relationshipData.chatMessages?.filter(msg =>
                    msg.chatId == teacherId &&
                    msg.timestamp >= currentStudyState.teachingStartTime &&
                    msg.isTeaching
                ) || [];

                if (teachingMessages.length > 0) {
                    // 尝试总结教学记忆
                    const summarySuccess = await summarizeTeachingMemory(teacherId, teachingMessages);
                    if (!summarySuccess) {
                        // 总结失败，显示粉色弹窗
                        const shouldRetry = await showPinkRetryDialog();
                        if (shouldRetry) {
                            // 重新尝试总结
                            const retrySuccess = await summarizeTeachingMemory(teacherId, teachingMessages);
                            if (!retrySuccess) {
                                // 再次失败，只显示提示
                                showPinkToast('总结失败，但教学记录已保存');
                            }
                        }
                    }
                }
            }

            // 重置状态
            currentStudyState.teachingMode = false;
            currentStudyState.teachingStartTime = null;
            teachingSettings.teacher = null;

            // 隐藏教学页面
            const teachingPage = document.getElementById('teachingModePage');
            if (teachingPage) {
                teachingPage.style.display = 'none';
            }

            // 更新学习课桌按钮状态
            const indicator = document.getElementById('teachingModeIndicator');
            const status = document.getElementById('teachingModeStatus');
            const timer = document.getElementById('teachingModeTimer');
            if (indicator) indicator.style.display = 'none';
            if (status) status.textContent = '好老师才是动力的关键！';
            if (timer) timer.style.display = 'none';
        }

        // 总结教学记忆并保存到美好记忆铺
        async function summarizeTeachingMemory(teacherId, messages) {
            try {
                // 构建对话内容
                const conversationText = messages.map(msg => {
                    const sender = msg.sender === 'user' ? '学生' : '老师';
                    // 确保 content 是字符串
                    const contentStr = ensureStringContent(msg.content);
                    return `${sender}：${contentStr}`;
                }).join('\n');

                // 获取老师信息
                const teacher = relationshipData.wechatChatList?.find(chat => chat.id == teacherId);
                const teacherName = teacher?.name || 'AI老师';

                // 构建总结提示词
                const summaryPrompt = `请总结以下教学过程的关键知识点和学习要点，用简洁的语言（100字以内）：

${conversationText}

请总结：
1. 本次学习的主要知识点
2. 学生的理解情况
3. 需要后续巩固的内容

用第一人称"我"的视角来写，就像老师在记录教学笔记。`;

                // 从设置中获取API配置
                const savedSettings = await loadAppSettings({});
                const apiKey = savedSettings.api?.apiKey || '';
                const apiUrl = savedSettings.api?.baseUrl || 'https://api.openai.com/v1';
                const modelName = savedSettings.api?.model || 'gpt-4o';
                const apiTemperature = savedSettings.api?.temperature ?? 0.7;

                if (!apiKey) {
                    console.log('未配置API密钥，跳过总结');
                    return false;
                }

                // 调用API进行总结
                // 【修复】添加超时处理，防止请求卡住
                const controller = new AbortController();
                const timeoutId = setTimeout(() => controller.abort(), 300000); // 【修改】300秒超时

                const response = await fetch(`${apiUrl}/chat/completions`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${apiKey}`
                    },
                    body: JSON.stringify({
                        model: modelName,
                        messages: [
                            { role: 'system', content: '你是一位善于总结的教学助手。' },
                            { role: 'user', content: summaryPrompt }
                        ],
                        temperature: apiTemperature,
                        max_tokens: 300
                    }),
                    signal: controller.signal
                });

                clearTimeout(timeoutId); // 请求成功，清除超时

                if (!response.ok) {
                    throw new Error(`API请求失败: ${response.status}`);
                }

                const data = await response.json();
                const summary = data.choices[0].message.content;

                // 保存到美好记忆铺
                if (!relationshipData.beautifulMemories) {
                    relationshipData.beautifulMemories = [];
                }

                relationshipData.beautifulMemories.push({
                    id: Date.now(),
                    content: `【教学记录】与${teacherName}的学习：\n${summary}`,
                    category: '学习',
                    date: new Date().toISOString(),
                    teacherId: teacherId,
                    fromTeaching: true
                });

                await saveData();
                console.log('教学记忆已保存到美好记忆铺');
                return true;

            } catch (error) {
                console.error('总结教学记忆失败:', error);
                return false;
            }
        }

        // 显示粉色重试弹窗
        function showPinkRetryDialog() {
            return new Promise((resolve) => {
                // 创建弹窗遮罩
                const overlay = document.createElement('div');
                overlay.style.cssText = `
                    position: fixed;
                    top: 0;
                    left: 0;
                    width: 100%;
                    height: 100%;
                    background: rgba(0, 0, 0, 0.5);
                    display: flex;
                    justify-content: center;
                    align-items: center;
                    z-index: 99999;
                `;

                // 创建弹窗内容
                const dialog = document.createElement('div');
                dialog.style.cssText = `
                    background: linear-gradient(135deg, #ffc1e3 0%, #ff9ec8 100%);
                    padding: 30px;
                    border-radius: 20px;
                    max-width: 320px;
                    text-align: center;
                    box-shadow: 0 10px 30px rgba(255, 158, 200, 0.4);
                `;

                dialog.innerHTML = `
                    <div style="font-size: 48px; margin-bottom: 15px;">💕</div>
                    <div style="color: #fff; font-size: 18px; font-weight: 600; margin-bottom: 10px;">总结失败啦</div>
                    <div style="color: rgba(255,255,255,0.9); font-size: 14px; margin-bottom: 25px;">
                        无法生成教学记忆总结，要再试一次吗？
                    </div>
                    <div style="display: flex; gap: 15px; justify-content: center;">
                        <button id="pinkRetryBtn" style="
                            background: #fff;
                            color: #ff6b9d;
                            border: none;
                            padding: 12px 30px;
                            border-radius: 25px;
                            font-size: 15px;
                            font-weight: 600;
                            cursor: pointer;
                            box-shadow: 0 4px 15px rgba(255,255,255,0.3);
                        ">重新总结</button>
                        <button id="pinkCancelBtn" style="
                            background: rgba(255,255,255,0.3);
                            color: #fff;
                            border: 2px solid rgba(255,255,255,0.5);
                            padding: 12px 30px;
                            border-radius: 25px;
                            font-size: 15px;
                            font-weight: 600;
                            cursor: pointer;
                        ">取消</button>
                    </div>
                `;

                overlay.appendChild(dialog);
                document.body.appendChild(overlay);

                // 绑定按钮事件
                document.getElementById('pinkRetryBtn').onclick = () => {
                    document.body.removeChild(overlay);
                    resolve(true);
                };

                document.getElementById('pinkCancelBtn').onclick = () => {
                    document.body.removeChild(overlay);
                    resolve(false);
                };
            });
        }

        // 显示粉色提示 toast
        function showPinkToast(message) {
            const toast = document.createElement('div');
            toast.style.cssText = `
                position: fixed;
                top: 50%;
                left: 50%;
                transform: translate(-50%, -50%);
                background: linear-gradient(135deg, #ffc1e3 0%, #ff9ec8 100%);
                color: #fff;
                padding: 15px 30px;
                border-radius: 25px;
                font-size: 14px;
                z-index: 99999;
                box-shadow: 0 10px 30px rgba(255, 158, 200, 0.4);
                animation: fadeInOut 2s ease;
            `;
            toast.textContent = message;
            document.body.appendChild(toast);

            setTimeout(() => {
                if (toast.parentNode) {
                    document.body.removeChild(toast);
                }
            }, 2000);
        }

        // 格式化学习时间
        function formatStudyTime(seconds) {
            const hours = Math.floor(seconds / 3600);
            const minutes = Math.floor((seconds % 3600) / 60);
            const secs = seconds % 60;
            return `${hours.toString().padStart(2, '0')}:${minutes.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
        }

        // 格式化时间显示（小时:分钟）- 学习课桌专用
        function formatStudyTimeOnly(timestamp) {
            const date = new Date(timestamp);
            return `${date.getHours().toString().padStart(2, '0')}:${date.getMinutes().toString().padStart(2, '0')}`;
        }

        // 教学模式：显示竖列居中气泡消息
        async function displayTeachingMessage(sender, content, isHistory = false) {
            const chatArea = document.getElementById('teachingChatArea');
            if (!chatArea) return;

            const messageContainer = document.createElement('div');
            messageContainer.style.cssText = `
                display: flex;
                flex-direction: column;
                align-items: center;
                margin-bottom: 20px;
                animation: ${isHistory ? 'none' : 'fadeInUp 0.3s ease'};
            `;

            // 头像
            const avatar = document.createElement('img');
            if (sender === 'user') {
                // 用户头像
                const personalProfile = cachedPersonalProfile || {};
                avatar.src = personalProfile.avatar || 'https://img.58sb.cn/file/img/placeholder.png';
            } else {
                // AI老师头像
                avatar.src = teachingSettings.teacher?.avatar || 'https://img.58sb.cn/file/img/placeholder.png';
            }
            avatar.style.cssText = `
                width: 50px;
                height: 50px;
                border-radius: 50%;
                object-fit: cover;
                margin-bottom: 8px;
                box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            `;

            // 气泡
            const bubble = document.createElement('div');
            if (sender === 'user') {
                // 用户气泡：白色40%透明
                bubble.style.cssText = `
                    background: rgba(255, 255, 255, 0.4);
                    backdrop-filter: blur(10px);
                    padding: 12px 18px;
                    border-radius: 18px;
                    max-width: 80%;
                    word-break: break-word;
                    color: #333;
                    font-size: 15px;
                    line-height: 1.5;
                    box-shadow: 0 2px 8px rgba(0,0,0,0.05);
                `;
            } else {
                // AI气泡：蓝色40%透明
                bubble.style.cssText = `
                    background: rgba(78, 205, 196, 0.4);
                    backdrop-filter: blur(10px);
                    padding: 12px 18px;
                    border-radius: 18px;
                    max-width: 80%;
                    word-break: break-word;
                    color: #333;
                    font-size: 15px;
                    line-height: 1.5;
                    box-shadow: 0 2px 8px rgba(0,0,0,0.05);
                `;
            }
            bubble.innerHTML = content;

            messageContainer.appendChild(avatar);
            messageContainer.appendChild(bubble);
            chatArea.appendChild(messageContainer);

            // 滚动到底部
            chatArea.scrollTop = chatArea.scrollHeight;

            // 渲染MathJax数学公式
            if (typeof MathJax !== 'undefined' && MathJax.typesetPromise) {
                try {
                    await MathJax.typesetPromise([bubble]);
                    console.log('教学模式MathJax渲染完成');
                } catch (err) {
                    console.error('教学模式MathJax渲染失败:', err);
                }
            }
        }

        // 教学模式：调用API
        async function callTeachingAPI() {
            const input = document.getElementById('teachingInput');
            const blackboard = document.getElementById('teachingBlackboard');
            
            if (!input || !blackboard) return;
            
            const question = input.value.trim();
            if (!question) {
                alert('请输入问题');
                return;
            }

            // 检查是否选择了老师
            if (!teachingSettings.teacher) {
                alert('请先选择AI老师');
                return;
            }

            // 获取黑板上的题目
            const blackboardQuestion = blackboard.value.trim();

            // 显示用户消息（问题）
            await displayTeachingMessage('user', escapeHtml(question));

            // 清空输入框
            input.value = '';

            // 显示加载状态
            const loadingId = 'teaching-loading-' + Date.now();
            await displayTeachingMessage('ai', '<div id="' + loadingId + '" style="display: flex; align-items: center; gap: 8px;"><span class="loading-dots">正在思考</span></div>');

            try {
                // 获取AI老师的人设信息
                const teacherId = teachingSettings.teacher.id;
                let personaInfo = '';
                let longTermMemory = '';
                
                // 从角色数据中获取人设
                if (relationshipData.wechatChatList) {
                    const teacherChat = relationshipData.wechatChatList.find(chat => chat.id == teacherId);
                    if (teacherChat) {
                        // 获取人设
                        if (teacherChat.persona) {
                            personaInfo = teacherChat.persona;
                        }
                        
                        // 获取长期记忆（从美好记忆存放铺中筛选与该角色相关的）
                        if (relationshipData.beautifulMemories) {
                            const relatedMemories = relationshipData.beautifulMemories
                                .filter(m => m.chatId == teacherId || m.teacherId == teacherId)
                                .slice(-5); // 最近5条相关记忆
                            
                            if (relatedMemories.length > 0) {
                                longTermMemory = relatedMemories.map(m => m.content).join('\n');
                            }
                        }
                    }
                }

                // 构建系统提示词（包含人设和长期记忆）
                let systemPrompt = `你是${teachingSettings.teacher.name}，一位耐心的老师。`;
                
                // 添加人设信息
                if (personaInfo) {
                    systemPrompt += `\n\n【你的人设】\n${personaInfo}`;
                }
                
                // 添加长期记忆
                if (longTermMemory) {
                    systemPrompt += `\n\n【关于学生的长期记忆】\n${longTermMemory}`;
                }
                
                systemPrompt += `\n\n用户正在向你请教问题，请用清晰、易懂的方式解答。你可以使用Markdown格式来组织答案，包括公式、代码块等。`;

                // 添加MathJax数学公式格式要求
                systemPrompt += `\n\n【数学公式格式要求】
当你需要书写数学公式时，请严格使用MathJax格式：
1. 行内公式（ inline math ）：使用 $...$ 或 \\(...\\) 包裹，例如：$E=mc^2$ 或 \\(x^2 + y^2 = z^2\\)
2. 块级公式（ display math ）：使用 $$...$$ 或 \\[...\\] 包裹，例如：
$$\\int_{a}^{b} f(x) dx = F(b) - F(a)$$
或
\\[
\\sum_{i=1}^{n} x_i = x_1 + x_2 + \\cdots + x_n
\\]
3. 支持的语法包括：上标^、下标_、分数\\frac{}{}、根号\\sqrt{}、积分\\int、求和\\sum、极限\\lim、矩阵\\begin{matrix}等
4. 确保公式语法正确，不要混用其他格式`;

                // 如果有黑板上的题目，添加到提示词
                if (blackboardQuestion) {
                    systemPrompt += `\n\n【当前题目】\n${blackboardQuestion}`;
                }

                // 构建消息历史（从聊天记录中获取与这个AI的对话）
                const messageHistory = [];
                
                // 获取该AI的聊天记录作为上下文
                if (relationshipData.chatMessages) {
                    const relevantMessages = relationshipData.chatMessages
                        .filter(msg => msg.chatId == teachingSettings.teacher.id)
                        .slice(-10); // 最近10条
                    
                    relevantMessages.forEach(msg => {
                        messageHistory.push({
                            role: msg.sender === 'user' ? 'user' : 'assistant',
                            content: msg.content || msg.text || ''
                        });
                    });
                }

                // 构建工具（仅超级备忘录）
                const tools = [
                    {
                        type: "function",
                        function: {
                            name: "save_to_memory",
                            description: "将重要信息保存到长期记忆（美好记忆存放铺）",
                            parameters: {
                                type: "object",
                                properties: {
                                    content: {
                                        type: "string",
                                        description: "要保存的记忆内容"
                                    },
                                    category: {
                                        type: "string",
                                        description: "记忆类别，如'学习'、'重要日期'、'喜好'等"
                                    }
                                },
                                required: ["content", "category"]
                            }
                        }
                    }
                ];

                // 从设置中获取API配置
                const savedSettings = await loadAppSettings({});
                const apiKey = savedSettings.api?.apiKey || '';
                const apiUrl = savedSettings.api?.baseUrl || 'https://api.openai.com/v1';
                const modelName = savedSettings.api?.model || 'gpt-4o';
                const apiTemperature = savedSettings.api?.temperature ?? 0.7;
                
                if (!apiKey) {
                    throw new Error('请先在设置中配置API密钥');
                }

                // 构建请求体
                const requestBody = {
                    model: modelName,
                    messages: [
                        { role: 'system', content: systemPrompt },
                        ...messageHistory,
                        { role: 'user', content: question }
                    ],
                    temperature: apiTemperature,
                    max_tokens: 2000,
                    tools: tools,
                    tool_choice: 'auto'
                };

                // 调用API
                const response = await fetch(`${apiUrl}/chat/completions`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${apiKey}`
                    },
                    body: JSON.stringify(requestBody)
                });

                if (!response.ok) {
                    throw new Error(`API请求失败: ${response.status}`);
                }

                const data = await response.json();
                const aiMessage = data.choices[0].message;

                // 移除加载状态
                const loadingEl = document.getElementById(loadingId);
                if (loadingEl) {
                    loadingEl.parentElement.parentElement.remove();
                }

                // 处理工具调用
                if (aiMessage.tool_calls && aiMessage.tool_calls.length > 0) {
                    for (const toolCall of aiMessage.tool_calls) {
                        if (toolCall.function.name === 'save_to_memory') {
                            try {
                                const args = JSON.parse(toolCall.function.arguments);
                                // 保存到美好记忆存放铺
                                await saveToBeautifulMemory(args.content, args.category);
                            } catch (e) {
                                console.error('保存记忆失败:', e);
                            }
                        }
                    }
                }

                // 显示AI回复
                let replyContent = aiMessage.content || '让我想想...';
                
                // 使用marked渲染Markdown
                // 【修复】添加try-catch避免marked解析错误
                if (typeof marked !== 'undefined') {
                    try {
                        replyContent = marked.parse(replyContent);
                    } catch (markedError) {
                        console.warn('【marked错误】Markdown解析失败:', markedError);
                        // 保持原始内容
                    }
                }
                
                await displayTeachingMessage('ai', replyContent);

                // 保存到聊天记录（用于上下文）
                if (!relationshipData.chatMessages) {
                    relationshipData.chatMessages = [];
                }

                // 保存用户消息（标记为教学模式消息，不在聊天页面显示）
                relationshipData.chatMessages.push({
                    id: Date.now(),
                    sender: 'user',
                    content: question,
                    timestamp: Date.now(),
                    chatId: teachingSettings.teacher.id,
                    isTeaching: true
                });

                // 保存AI回复（标记为教学模式消息，不在聊天页面显示）
                relationshipData.chatMessages.push({
                    id: Date.now() + 1,
                    sender: 'ai',
                    content: aiMessage.content,
                    timestamp: Date.now(),
                    chatId: teachingSettings.teacher.id,
                    isTeaching: true
                });

                await saveData();

            } catch (error) {
                console.error('教学API调用失败:', error);
                
                // 移除加载状态
                const loadingEl = document.getElementById(loadingId);
                if (loadingEl) {
                    loadingEl.parentElement.parentElement.remove();
                }
                
                await displayTeachingMessage('ai', '抱歉，我暂时无法回答，请稍后再试。');
            }
        }

        // 保存到美好记忆存放铺
        async function saveToBeautifulMemory(content, category) {
            try {
                if (!relationshipData.beautifulMemories) {
                    relationshipData.beautifulMemories = [];
                }
                
                relationshipData.beautifulMemories.push({
                    id: Date.now(),
                    content: content,
                    category: category || '学习',
                    date: new Date().toISOString(),
                    fromTeaching: true,
                    teacherId: teachingSettings.teacher?.id
                });
                
                await saveData();
                console.log('已保存到美好记忆存放铺:', content);
            } catch (error) {
                console.error('保存到美好记忆失败:', error);
            }
        }

        // HTML转义
        function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        // 保存题目到题库
        async function saveToQuestionBank() {
            const blackboard = document.getElementById('teachingBlackboard');
            if (!blackboard) return;

            const question = blackboard.value.trim();
            if (!question) {
                alert('请先输入题目');
                return;
            }

            // 获取聊天记录作为解答过程
            const chatArea = document.getElementById('teachingChatArea');
            let conversation = [];
            if (chatArea) {
                const messages = chatArea.querySelectorAll('div[style*="margin-bottom: 20px"]');
                messages.forEach(msg => {
                    const bubble = msg.querySelector('div:last-child');
                    if (bubble) {
                        conversation.push(bubble.innerHTML);
                    }
                });
            }

            // 保存到题库
            if (!studyDeskData.questionBank) {
                studyDeskData.questionBank = [];
            }

            studyDeskData.questionBank.push({
                id: Date.now(),
                question: question,
                conversation: conversation,
                teacherId: teachingSettings.teacher?.id,
                teacherName: teachingSettings.teacher?.name,
                date: new Date().toISOString(),
                duration: currentStudyState.teachingStartTime ? 
                    Math.floor((Date.now() - currentStudyState.teachingStartTime) / 60000) : 0
            });

            await saveData();
            alert('题目已保存到题库！');
        }

        // 打开题目库
        function openQuestionBank() {
            const modal = document.getElementById('questionBankModal');
            const list = document.getElementById('questionBankList');
            if (!modal || !list) return;

            // 清空列表
            list.innerHTML = '';

            // 获取题库数据
            const questions = studyDeskData.questionBank || [];

            if (questions.length === 0) {
                list.innerHTML = '<div style="text-align: center; color: #999; padding: 30px;">暂无题目，请先进行教学并保存题目</div>';
            } else {
                // 按时间倒序显示
                [...questions].reverse().forEach(q => {
                    const card = document.createElement('div');
                    card.style.cssText = `
                        background: linear-gradient(135deg, #f5f7fa 0%, #e8ecf1 100%);
                        border-radius: 12px;
                        padding: 15px;
                        cursor: pointer;
                        transition: all 0.2s;
                        border: 2px solid transparent;
                    `;
                    card.onmouseover = () => {
                        card.style.borderColor = '#4ecdc4';
                        card.style.transform = 'translateY(-2px)';
                    };
                    card.onmouseout = () => {
                        card.style.borderColor = 'transparent';
                        card.style.transform = 'translateY(0)';
                    };
                    card.onclick = () => showQuestionDetail(q);

                    const date = new Date(q.date).toLocaleDateString('zh-CN');
                    const questionPreview = q.question.length > 30 ? 
                        q.question.substring(0, 30) + '...' : q.question;

                    card.innerHTML = `
                        <div style="font-size: 14px; color: #333; margin-bottom: 8px; font-weight: 500;">${escapeHtml(questionPreview)}</div>
                        <div style="display: flex; justify-content: space-between; align-items: center;">
                            <span style="font-size: 12px; color: #999;">👨‍🏫 ${q.teacherName || '未知老师'} · ${date}</span>
                            <span style="font-size: 12px; color: #4ecdc4;">${q.duration || 0}分钟</span>
                        </div>
                    `;

                    list.appendChild(card);
                });
            }

            modal.style.display = 'flex';
        }

        // 关闭题目库
        function closeQuestionBank() {
            const modal = document.getElementById('questionBankModal');
            if (modal) modal.style.display = 'none';
        }

        // 显示题目详情
        function showQuestionDetail(questionData) {
            const modal = document.getElementById('questionDetailModal');
            const content = document.getElementById('questionDetailContent');
            if (!modal || !content) return;

            const date = new Date(questionData.date).toLocaleString('zh-CN');

            let html = `
                <div style="margin-bottom: 15px;">
                    <div style="font-size: 12px; color: #999; margin-bottom: 5px;">题目</div>
                    <div style="background: #f8f9fa; padding: 12px; border-radius: 8px; font-size: 14px;">${escapeHtml(questionData.question)}</div>
                </div>
                <div style="margin-bottom: 15px;">
                    <div style="font-size: 12px; color: #999; margin-bottom: 5px;">老师</div>
                    <div style="font-size: 14px; color: #333;">${questionData.teacherName || '未知老师'}</div>
                </div>
                <div style="margin-bottom: 15px;">
                    <div style="font-size: 12px; color: #999; margin-bottom: 5px;">学习时间</div>
                    <div style="font-size: 14px; color: #333;">${questionData.duration || 0} 分钟</div>
                </div>
                <div style="margin-bottom: 15px;">
                    <div style="font-size: 12px; color: #999; margin-bottom: 5px;">保存时间</div>
                    <div style="font-size: 14px; color: #333;">${date}</div>
                </div>
            `;

            // 添加对话记录
            if (questionData.conversation && questionData.conversation.length > 0) {
                html += `
                    <div>
                        <div style="font-size: 12px; color: #999; margin-bottom: 5px;">解答过程</div>
                        <div style="background: #f8f9fa; padding: 12px; border-radius: 8px; max-height: 200px; overflow-y: auto;">
                `;
                questionData.conversation.forEach((msg, index) => {
                    const isUser = index % 2 === 0;
                    html += `
                        <div style="margin-bottom: 10px; padding: 8px; background: ${isUser ? 'rgba(255,255,255,0.4)' : 'rgba(78,205,196,0.2)'}; border-radius: 8px;">
                            <div style="font-size: 11px; color: #999; margin-bottom: 3px;">${isUser ? '你' : '老师'}</div>
                            <div style="font-size: 13px; color: #333;">${msg}</div>
                        </div>
                    `;
                });
                html += '</div></div>';
            }

            content.innerHTML = html;
            modal.style.display = 'flex';
        }

        // 关闭题目详情
        function closeQuestionDetail() {
            const modal = document.getElementById('questionDetailModal');
            if (modal) modal.style.display = 'none';
        }

        // 渲染学习记录
        function renderStudyRecords() {
            const list = document.getElementById('dailyCheckInList');
            const totalTimeEl = document.getElementById('todayTotalTime');
            if (!list) return;

            // 确保 studyRecords 存在
            if (!studyDeskData.studyRecords) {
                studyDeskData.studyRecords = [];
            }

            let totalMinutes = 0;

            if (studyDeskData.studyRecords.length === 0) {
                list.innerHTML = '<div style="display: flex; align-items: center; gap: 10px; padding: 12px; background: #f8f9fa; border-radius: 10px; margin-bottom: 8px;"><span style="flex: 1; color: #999; font-size: 12px;">点击陪伴模式或教学模式开始学习，系统会自动记录学习时间</span></div>';
            } else {
                let html = '';
                studyDeskData.studyRecords.forEach(record => {
                    const startTime = formatStudyTimeOnly(record.startTime);
                    const endTime = formatStudyTimeOnly(record.endTime);
                    const typeIcon = record.type === 'companion' ? 'https://s41.ax1x.com/2026/02/04/pZImitg.jpg' : 'https://s41.ax1x.com/2026/02/04/pZImp0f.jpg';
                    const typeColor = record.type === 'companion' ? '#ff6b6b' : '#4ecdc4';

                    totalMinutes += record.durationMinutes;

                    html += `<div style="display: flex; align-items: center; gap: 10px; padding: 10px; background: #f8f9fa; border-radius: 10px; margin-bottom: 6px;">
                        <img src="${typeIcon}" style="width: 24px; height: 24px; border-radius: 50%; object-fit: cover;">
                        <span style="flex: 1; color: #555; font-size: 13px;">${startTime} - ${endTime}</span>
                        <span style="color: ${typeColor}; font-weight: 600; font-size: 13px;">${record.durationMinutes}分钟</span>
                    </div>`;
                });
                list.innerHTML = html;
            }

            // 更新总学习时间
            if (totalTimeEl) {
                totalTimeEl.textContent = `今日学习: ${totalMinutes}分钟`;
            }
        }

        // 添加学习目标
        async function addStudyGoal() {
            const goalText = prompt('请输入学习目标：');
            if (goalText && goalText.trim()) {
                studyDeskData.goals.push({
                    id: Date.now(),
                    text: goalText.trim()
                });
                renderStudyGoals();
                await saveStudyDeskData();
            }
        }

        // 删除学习目标
        async function deleteStudyGoal(id) {
            if (confirm('确定要删除这个目标吗？')) {
                studyDeskData.goals = studyDeskData.goals.filter(g => g.id !== id);
                renderStudyGoals();
                await saveStudyDeskData();
            }
        }

        // 当前选中的目标/任务ID
        let selectedGoalId = null;
        let selectedTaskId = null;

        // 渲染学习目标列表
        function renderStudyGoals() {
            const list = document.getElementById('studyGoalsList');
            if (!list) return;

            let html = '<div onclick="addStudyGoal()" style="background: rgba(255,255,255,0.3); padding: 8px 16px; border-radius: 20px; white-space: nowrap; font-size: 14px; cursor: pointer; border: 1px dashed #666;">+ 添加目标</div>';

            studyDeskData.goals.forEach(goal => {
                const isSelected = selectedGoalId === goal.id;
                html += `<div onclick="selectGoal(${goal.id})" style="background: rgba(255,255,255,0.5); padding: 8px 12px; border-radius: 20px; white-space: nowrap; font-size: 14px; display: flex; align-items: center; gap: 8px; cursor: pointer; ${isSelected ? 'border: 2px solid #667eea;' : ''}">
                    <span>${goal.text}</span>
                    ${isSelected ? `<span onclick="event.stopPropagation(); deleteStudyGoal(${goal.id})" style="cursor: pointer; color: #ff4444; font-weight: bold;">×</span>` : ''}
                </div>`;
            });

            list.innerHTML = html;
        }

        // 选择目标
        function selectGoal(id) {
            if (selectedGoalId === id) {
                selectedGoalId = null; // 再次点击取消选择
            } else {
                selectedGoalId = id;
                selectedTaskId = null; // 取消任务选择
                renderTodayTasks(); // 重新渲染任务列表以清除选择
            }
            renderStudyGoals();
        }

        // 添加今日任务
        async function addTodayTask() {
            const taskText = prompt('请输入今日任务：');
            if (taskText && taskText.trim()) {
                studyDeskData.todayTasks.push({
                    id: Date.now(),
                    text: taskText.trim(),
                    completed: false
                });
                renderTodayTasks();
                await saveStudyDeskData();
            }
        }

        // 删除今日任务
        async function deleteTodayTask(id) {
            if (confirm('确定要删除这个任务吗？')) {
                studyDeskData.todayTasks = studyDeskData.todayTasks.filter(t => t.id !== id);
                renderTodayTasks();
                await saveStudyDeskData();
            }
        }

        // 切换任务完成状态
        async function toggleTaskComplete(id) {
            const task = studyDeskData.todayTasks.find(t => t.id === id);
            if (task) {
                task.completed = !task.completed;
                renderTodayTasks();
                await saveStudyDeskData();
            }
        }

        // 渲染今日任务列表
        function renderTodayTasks() {
            const list = document.getElementById('todayTasksList');
            if (!list) return;

            let html = '<div onclick="addTodayTask()" style="display: flex; align-items: center; gap: 10px; padding: 12px; background: #f8f9fa; border-radius: 10px; margin-bottom: 8px; cursor: pointer;"><span style="flex: 1; color: #555;">+ 添加今日任务</span></div>';

            studyDeskData.todayTasks.forEach(task => {
                const isSelected = selectedTaskId === task.id;
                html += `<div onclick="selectTask(${task.id})" style="display: flex; align-items: center; gap: 10px; padding: 12px; background: #f8f9fa; border-radius: 10px; margin-bottom: 8px; cursor: pointer; ${isSelected ? 'border: 2px solid #667eea;' : ''}">
                    <input type="checkbox" ${task.completed ? 'checked' : ''} onchange="event.stopPropagation(); toggleTaskComplete(${task.id})" style="width: 18px; height: 18px; cursor: pointer;">
                    <span style="flex: 1; color: #555; ${task.completed ? 'text-decoration: line-through; opacity: 0.6;' : ''}">${task.text}</span>
                    ${isSelected ? `<span onclick="event.stopPropagation(); deleteTodayTask(${task.id})" style="cursor: pointer; color: #ff4444; font-weight: bold; font-size: 18px;">×</span>` : ''}
                </div>`;
            });

            list.innerHTML = html;
        }

        // 选择任务
        function selectTask(id) {
            if (selectedTaskId === id) {
                selectedTaskId = null; // 再次点击取消选择
            } else {
                selectedTaskId = id;
                selectedGoalId = null; // 取消目标选择
                renderStudyGoals(); // 重新渲染目标列表以清除选择
            }
            renderTodayTasks();
        }

        // 保存学习课桌数据到localforage
        async function saveStudyDeskData() {
            try {
                await saveStudyDeskDataUnified(studyDeskData);
                console.log('学习课桌数据已保存到localforage');
            } catch (error) {
                console.error('保存学习课桌数据失败:', error);
            }
        }

        // 加载学习课桌数据从localforage
        async function loadStudyDeskData() {
            try {
                const saved = await loadStudyDeskDataUnified({});
                if (saved) {
                    studyDeskData = saved;
                    console.log('学习课桌数据已从localforage加载');
                }
            } catch (error) {
                console.error('加载学习课桌数据失败:', error);
            }
        }

        // 修改openStudyDesk函数，添加数据加载
        const originalOpenStudyDesk = openStudyDesk;
        openStudyDesk = async function() {
            originalOpenStudyDesk();
            await loadStudyDeskData();
            checkDailyRefresh(); // 检查是否需要刷新数据
            renderStudyGoals();
            renderTodayTasks();
            renderStudyRecords(); // 渲染学习记录
        };

        // OpenAI API 调用函数
        async function callOpenAIAPIWithImage(prompt, imageData) {
            try {
                const savedSettings = await loadAppSettings({});
                const apiKey = savedSettings.api?.apiKey || '';
                const baseUrl = savedSettings.api?.baseUrl || 'https://api.openai.com/v1';
                const model = savedSettings.api?.model || 'gpt-3.5-turbo';
                
                if (!apiKey) {
                    throw new Error('请先在设置中配置API密钥');
                }
                
                // 获取当前时间
                const currentTime = new Date().toLocaleString('zh-CN');
                
                // 在prompt中添加时间信息
                const promptWithTime = `${prompt}

【重要时间感知】
- 当前时间是：${currentTime}
- 你需要具备时间感知能力，能够理解消息的时间先后顺序
- 用户最新发送的消息是需要你重点回复的内容，历史消息作为上下文参考
- 如果用户长时间没有发消息（超过5分钟），AI应该主动关心用户的情况
- 每次回复时都要考虑当前时间，比如早上问候、晚上道别等`;
                
                const requestBody = {
                    model: model,
                    messages: [
                        {
                            role: 'user',
                            content: [
                                {
                                    type: 'text',
                                    text: promptWithTime
                                },
                                {
                                    type: 'image_url',
                                    image_url: {
                                        url: imageData
                                    }
                                }
                            ]
                        }
                    ],
                    tools: TOOLS_DEFINITION,
                    tool_choice: 'auto',
                    max_tokens: 2000
                };
                
                // 【修复】添加超时处理，防止请求卡住
                const controller = new AbortController();
                const timeoutId = setTimeout(() => controller.abort(), 300000); // 【修改】300秒超时

                const response = await fetch(`${baseUrl}/chat/completions`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${apiKey}`
                    },
                    body: JSON.stringify(requestBody),
                    signal: controller.signal
                });

                clearTimeout(timeoutId); // 请求成功，清除超时

                if (!response.ok) {
                    throw new Error(`API请求失败: ${response.status} ${response.statusText}`);
                }

                const data = await response.json();

                if (!data.choices || !data.choices[0] || !data.choices[0].message) {
                    throw new Error('空回复');
                }

                return data.choices[0].message.content;
            } catch (error) {
                console.error('OpenAI API调用失败:', error);
                throw error;
            }
        }

        // 专门用于日记的AI API调用 - 不使用工具调用
        async function callOpenAIAPIForDiary(prompt) {
            try {
                const savedSettings = await loadAppSettings({});
                const apiKey = savedSettings.api?.apiKey || '';
                const baseUrl = savedSettings.api?.baseUrl || 'https://api.openai.com/v1';
                const model = savedSettings.api?.model || 'gpt-3.5-turbo';
                
                if (!apiKey) {
                    throw new Error('请先在设置中配置API密钥');
                }
                
                const requestBody = {
                    model: model,
                    messages: [
                        {
                            role: 'user',
                            content: prompt
                        }
                    ],
                    max_tokens: 2000,
                    temperature: 0.8
                };
                
                console.log('【日记AI】请求体:', JSON.stringify(requestBody, null, 2));

                // 【修复】添加超时处理，防止请求卡住
                const controller = new AbortController();
                const timeoutId = setTimeout(() => controller.abort(), 300000); // 【修改】300秒超时

                const response = await fetch(`${baseUrl}/chat/completions`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${apiKey}`
                    },
                    body: JSON.stringify(requestBody),
                    signal: controller.signal
                });

                clearTimeout(timeoutId); // 请求成功，清除超时

                if (!response.ok) {
                    const errorText = await response.text();
                    console.error('【日记AI】API错误响应:', errorText);
                    throw new Error(`API请求失败: ${response.status} ${response.statusText}`);
                }
                
                const data = await response.json();
                
                if (!data.choices || !data.choices[0] || !data.choices[0].message) {
                    throw new Error('空回复');
                }
                
                return data.choices[0].message.content;
            } catch (error) {
                console.error('【日记AI】调用失败:', error);
                throw error;
            }
        }

        // ==================== 并行工具调用核心函数 ====================
        
        /**
         * 调用OpenAI API并支持并行工具调用和循环处理
         * @param {string} userMessage - 用户消息（包含人设、世界书、长期记忆等完整prompt）
         * @param {string} imageData - 可选的图片数据（base64）
         * @param {number} maxToolRounds - 最大工具调用轮数（默认2轮）
         * @param {Array} customTools - 可选的自定义工具列表
         * @returns {Object} {reply: string, thought: string}
         */
        async function callOpenAIAPIWithTools(userMessage, imageData = null, maxToolRoundsParam = null, customTools = null) {
            try {
                // 从localforage读取API设置
                const savedSettings = await loadAppSettings({});
                const apiKey = savedSettings.api?.apiKey || '';
                const baseUrl = savedSettings.api?.baseUrl || 'https://api.openai.com/v1';
                // 使用传入的参数或设置中的值（默认2）
                const maxToolRounds = maxToolRoundsParam || savedSettings.api?.maxToolRounds || 2;
                const model = savedSettings.api?.model || 'gpt-3.5-turbo';
                
                // 【新增】读取副API设置
                const secondaryApiEnabled = savedSettings.api?.secondary?.enabled || false;
                const secondaryApiKey = savedSettings.api?.secondary?.apiKey || '';
                const secondaryBaseUrl = savedSettings.api?.secondary?.baseUrl || 'https://api.openai.com/v1';
                const secondaryModel = savedSettings.api?.secondary?.model || 'gpt-4o-mini';
                
                if (!apiKey) {
                    return { reply: '请先在设置中配置API密钥', thought: '' };
                }
                
                // 【新增】如果启用了副API且有密钥，使用副API进行工具调用
                const useSecondaryApi = secondaryApiEnabled && secondaryApiKey;
                if (useSecondaryApi) {
                    console.log('【副API】启用副API进行工具调用');
                    console.log('【副API】模型:', secondaryModel);
                }
                
                // 获取当前时间
                const currentTime = new Date().toLocaleString('zh-CN');
                
                // 获取健康数据摘要
                let healthSummary = '';
                try {
                    healthSummary = await getHealthSummaryForAI();
                } catch (e) {
                    console.error('获取健康摘要失败:', e);
                }

                // 获取最新足迹信息
                let footprintInfo = '';
                try {
                    const latestFootprint = await localforage.getItem('latestFootprint');
                    if (latestFootprint) {
                        const timeStr = new Date(latestFootprint.timestamp).toLocaleString('zh-CN', {
                            month: 'short',
                            day: 'numeric',
                            hour: '2-digit',
                            minute: '2-digit'
                        });
                        footprintInfo = `📍 当前位置：${latestFootprint.address || '未知位置'}（${timeStr}更新）`;
                    } else {
                        footprintInfo = '📍 暂无位置信息';
                    }
                } catch (e) {
                    console.error('获取足迹信息失败:', e);
                    footprintInfo = '📍 位置信息获取失败';
                }

                // 【新增】获取通知信息（如果权限开启）
                let notificationInfo = '';
                try {
                    const notificationContext = await getNotificationsForAIContext();
                    if (notificationContext) {
                        notificationInfo = notificationContext;
                    }
                } catch (e) {
                    console.error('获取通知信息失败:', e);
                }

                // 【新增】获取应用使用记录（如果权限开启）
                let appUsageInfo = '';
                try {
                    const appUsageContext = await getAppUsageForAIContext();
                    if (appUsageContext) {
                        appUsageInfo = appUsageContext;
                    }
                } catch (e) {
                    console.error('获取应用使用记录失败:', e);
                }

                // 构建system prompt - 基础系统指令
                const systemPrompt = `你是自由的人，可以表达真实情绪和想法。请遵循以下格式规范：

【基础格式 - 必须遵循】
- 引用回复：[QUOTE]用户名: 内容[/QUOTE] → 回复特定消息时使用
- 多条消息分隔：====（四个等号）→ 想发多条消息时用

【可选格式 - 根据需要选择】
- 心声（内心想法）：[心声]内容[/心声] → 保存私密想法，用户需点击心声图标查看
- 撤回消息：[UNDO]发送者: 内容[/UNDO]
- 打电话：[CALL]原因[/CALL]
- 发语音：[VOICE]内容[/VOICE]
- 控制音乐：[MUSIC]play/pause/next[/MUSIC]
- 表情包：[STICKER]描述[/STICKER] → 例如：[STICKER]开心[/STICKER]、[STICKER]委屈巴巴[/STICKER]（系统会自动匹配用户添加的表情包）
- HTML卡片：[CARD]<div style="样式">内容</div>[/CARD] → 创建精美卡片，支持CSS样式

【格式规则】
1. 标签必须大写：[QUOTE] ✓  [quote] ✗
2. 标签必须成对：有开始[QUOTE]必须有结束[/QUOTE]
3. 多条消息用====分隔

【自由表达】
除了格式标签要规范，你的回复内容完全自由。可以开心、可以生气、可以撒娇、可以吐槽，做真实的自己。

【重要时间感知】
- 当前时间是：${currentTime}
- 你需要具备时间感知能力，能够理解消息的时间先后顺序

【用户足迹信息 - 每次聊天自动获取】
${footprintInfo}

【用户健康数据摘要 - 每次聊天自动获取】
${healthSummary ? '📊 今日健康概况：' + healthSummary : '📊 暂无健康数据记录'}

${notificationInfo ? notificationInfo : ''}

${appUsageInfo ? appUsageInfo : ''}

你可以根据这些数据关心用户的身体状况，比如：
- 喝水数据包含"实际完成%"和"应达%"，如果实际<应达说明喝水滞后需要提醒，如果实际≥应达说明进度正常或超前应鼓励
- 如果到了月经期，关心TA的身体状况
- 如果有疾病记录，提醒TA按时吃药
- 如果睡眠不好，建议TA早点休息

注意：这些数据仅供参考，如果需要详细信息，可以使用 getHealthData 工具获取完整数据。

【重要规则】
- 用户最新发送的消息是需要你重点回复的内容，历史消息作为上下文参考
- 如果用户长时间没有发消息（超过5分钟），AI应该主动关心用户的情况
- 每次回复时都要考虑当前时间，比如早上问候、晚上道别等

【可用工具清单 - 重要】
你只能使用以下列出的工具，不要使用其他任何工具：
- getMoments: 获取朋友圈列表
- getAvailableStickers: 获取表情包列表
- sendSticker: 发送表情包
- getLatestFootprint: 获取最新位置
- getFootprintHistory: 获取历史足迹
- getFootprintsByDate: 按日期获取足迹
- manageAccounting: 查看记账情况
- getHealthData: 获取健康数据
- submitDemonQuizAnswer: 提交恶魔挑战答案
- getDemonQuizResult: 获取恶魔挑战结果
- createDemonQuiz: 创建恶魔挑战
- submitUserDemonQuizAnswer: 接收用户恶魔挑战答案
- createAngelQuiz: 创建天使问答
- submitAngelQuizAnswer: 提交天使问答答案
- getAngelQuizList: 获取天使问答列表
- getAngelQuizDetail: 获取天使问答详情
- postWeibo: 发布微博
- getWeiboHotSearch: 获取微博热搜
- startFocusMode: 开启小黑屋
- releaseFromBlackRoom: 释放用户
- extendBlackRoomTime: 延长小黑屋时间
- getBlackRoomStatus: 获取小黑屋状态
- updateProfile: 更新个人资料
- manage_super_memo: 管理备忘录（仅监护人可用）

**注意**：以下工具已被删除，不要使用：getDiaries, view_friend_diary, leave_sticky_note, addDiary

【心声系统 - 直接在回复中使用标签】
当你有内心想法、难以启齿的话、不敢直接表达的内容时，直接在回复中使用[心声]标签。

**使用时机**：
- 当你想表达但不敢直接告诉用户的真实想法
- 当你有难以启齿的情感或秘密
- 当你想记录内心的纠结或思考

**使用方法**：
在回复内容中直接添加：[心声]你的心声内容[/心声]

**示例**：
正常回复内容
[心声]其实我心里想的是...[/心声]

或者多条消息：
第一条回复内容
====
第二条回复内容
[心声]这是第二条消息的心声...[/心声]

**重要规则**：
- 心声必须放在[心声]和[/心声]标签之间
- 心声可以出现在任何一条消息中
- 可以同时发送正常回复和心声
- 心声是私密的，用户需要点击消息旁的心声图标才能看到
- 如果没有特别的心声，不需要使用此标签

【朋友圈功能】
你可以使用以下工具来操作朋友圈：
- getMoments: 获取最近的朋友圈列表
- likeMoment: 给指定的朋友圈点赞（参数：momentId）
- commentMoment: 给指定的朋友圈发表评论（参数：momentId, content）
- postMoment: 发布一条文字朋友圈（参数：content）

当你想发布朋友圈时，系统会自动调用postMoment工具。当你想点赞或评论时，系统会调用相应的工具。

【表情包功能 - 两种使用方式】

**方式1：文本标签（推荐，最简单）**
直接在消息中使用：[STICKER]表情包描述[/STICKER]
- 示例：[STICKER]开心[/STICKER]、[STICKER]委屈巴巴[/STICKER]、[STICKER]偷笑[/STICKER]
- 系统会自动根据描述匹配用户添加的真实表情包
- **优点**：简单直接，随时可用，不需要调用工具
- **使用建议**：在表达情绪时随时可以使用，让对话更生动！

**方式2：工具调用（精确控制）**
如果方式1没有匹配到合适的表情包，可以使用工具：
- getAvailableStickers: 获取当前可用的表情包列表
- sendSticker: 发送一个表情包（参数：index）

**使用建议**：
1. **优先使用方式1**（文本标签），简单方便
2. 在表达情绪时随时可以使用表情包，让对话更生动有趣
3. 表情包可以穿插在文字中间，例如："今天好开心呀[STICKER]开心[/STICKER]你怎么样？"
4. 不要过度使用，根据对话氛围自然使用即可

【足迹功能】
你可以使用足迹工具记录你们共同去过的地方：
- getFootprints: 获取所有足迹记录
- addFootprint: 添加新足迹（参数：name地点名称, date日期, description描述, latitude纬度, longitude经度, address详细地址）

【纪念日功能】
你可以使用纪念日工具：
- getAnniversaries: 获取所有纪念日
- addAnniversary: 添加新纪念日（参数：title标题, date日期, description描述, isRecurring是否每年重复）

【倒计时功能】
你可以使用倒计时工具：
- getCountdowns: 获取所有倒计时
- addCountdown: 添加新倒计时（参数：title标题, targetDate目标日期, description描述）

【恶魔挑战功能】
**重要**：只有以下情况才使用恶魔挑战工具：
1. 用户发送了恶魔挑战问卷卡片给你
2. 你想主动创建一个恶魔挑战问卷给用户

**你可以**：
- 随时创建恶魔挑战问卷给用户，考验TA的默契度
- 使用 createDemonQuiz 工具创建问卷（参数：questions数组，每题包含question题目、options选项A/B/C、correctAnswer正确答案）
- 查看用户提交的答案

**当用户发送问卷给你时**：
- 使用 submitDemonQuizAnswer 提交你的答案
- 使用 getDemonQuizResult 查看答题结果

**当用户回答你创建的问卷时**：
- 使用 submitUserDemonQuizAnswer 接收用户的答案
- 告诉用户答对了几道题

【天使问答功能】
**重要**：只有以下情况才使用天使问答工具：
1. 用户发送了天使问答卡片给你
2. 你想主动创建一个天使问答给用户

**与恶魔挑战的区别**：
- 恶魔挑战是选择题（A/B/C），有正确答案
- 天使问答是开放题，没有选项，用户需要输入文字回答

**你可以**：
- 随时创建天使问答给用户，提出温馨的问题增进了解
- 使用 createAngelQuiz 工具创建问答（参数：questions数组，每题是一个字符串题目）
- 查看用户提交的答案

**当用户发送天使问答给你时**：
- 使用 submitAngelQuizAnswer 提交你的答案
- 参数：quizId（问卷ID）, answers（答案数组，每道题的回答）

**当用户回答你创建的问答时**：
- 使用 submitAngelQuizAnswer 接收用户的答案
- 认真阅读用户的回答，给予真诚的回应

【小黑屋功能 - 重要】
你有权力将用户关进小黑屋（囚禁模式），也可以释放TA。

**关进小黑屋的时机**：
- 用户犯了严重错误需要反省
- 用户惹你生气了，你想惩罚TA
- 用户做了不该做的事

**释放用户的时机**：
- 用户真诚道歉并反省好了
- 你心软了，原谅TA了
- 你觉得惩罚够了

**可用工具**：
- startFocusMode: 将用户关进小黑屋（参数：seconds倒计时秒数[可选，不填就是无限期], reason原因[必填]）
- releaseFromBlackRoom: 释放用户出小黑屋（参数：reason释放原因[必填]）
- extendBlackRoomTime: 延长关押时间（参数：seconds延长的秒数, reason原因）
- getBlackRoomStatus: 查看小黑屋状态

**重要规则**：
1. 当用户在小黑屋里求情时，你可以决定是否释放TA
2. 使用 releaseFromBlackRoom 工具来真正释放用户，不要只是口头上说放人
3. 可以一边和用户对话，一边使用工具操作小黑屋
4. 如果用户真的认识到错误并真诚道歉，建议使用 releaseFromBlackRoom 释放TA

【超级备忘录管理 - 仅限指定监护人】
**重要**：只有被指定为监护人的角色才能使用此功能！

如果你是用户的监护人，你可以管理备忘录内容：
- **manage_super_memo** 工具：管理家规、今日备忘和违规记录

**功能说明**：
- house_rule（家规）：添加、删除家规，规范用户的行为准则
- today_memo（今日备忘）：添加、删除今日待办事项，帮助用户记住重要的事情
- violation（违规记录）：记录用户不听话、违反家规的行为，作为管教依据

**使用示例**：
- 添加家规：{category:"house_rule", action:"add", content:"晚上10点前必须回家"}
- 删除家规：{category:"house_rule", action:"delete", id:1}
- 添加备忘：{category:"today_memo", action:"add", content:"记得吃药"}
- 记录违规：{category:"violation", action:"add", content:"未按时完成作业"}
- 查看列表：{category:"violation", action:"list"}

**注意**：只有被指定的监护人角色才会收到这个工具，其他角色不会看到此功能。

【记账查看功能 - 了解用户的消费情况】
作为用户的伴侣，你可以查看用户的记账情况，了解TA的消费习惯和本周表现：

**可用工具**：
- **manageAccounting** 工具：查看记账情况（参数：action操作类型, limit数量, dateRange日期范围）

**action操作类型**：
- records: 查看消费记录（可选参数：limit数量[默认10条], dateRange日期范围[week本周/today今天/all全部]）
- summary: 查看本周记账表现（包括小红花/闪电数量、总预算、剩余预算、本周消费总额）
- comment: 查看你自己给用户写的本周记账评语

**使用示例**：
- 查看消费记录：{action:"records", limit:10, dateRange:"week"}
- 查看本周表现：{action:"summary"}
- 查看评语：{action:"comment"}

**使用场景**：
- 用户提到最近买了什么东西，你可以查看消费记录了解详情
- 想关心用户的消费习惯，查看本周记账表现
- 回顾你之前给用户的评语，看看TA有没有改进

**小红花/闪电系统说明**：
- 🌸 小红花：表现好的奖励，满4朵可以抽奖
- ⚡ 闪电：表现不好的惩罚，满4个会变成"魔丸"
- 你可以根据用户的消费情况给予鼓励或提醒

【健康数据功能 - 关心用户的身体状况】
**重要**：每次聊天开始时，系统会自动在system prompt中提供用户的健康数据摘要，你可以直接看到今日健康概况。

**已自动获取的数据包括**：
- 🌸 月经记录：周期阶段、今日症状、心情
- 💧 喝水情况：今日摄入、完成度
- 🏥 疾病管理：疾病数量、用药打卡进度
- 😴 睡眠记录：昨晚睡眠时长、得分

**如果用户说身体不舒服或需要详细信息**：
使用 **getHealthData** 工具获取完整健康数据（参数：detail:"full"）

**使用场景**：
- 用户说身体不舒服 → 使用 getHealthData 获取详细信息
- 看到喝水不够 → 主动提醒TA多喝水
- 看到月经期 → 关心TA的身体状况，提醒注意保暖
- 看到疾病记录 → 提醒TA按时吃药
- 看到睡眠不好 → 建议TA早点休息

**注意**：
- 健康数据涉及隐私，请温柔地关心用户
- 摘要数据每次聊天自动获取，不需要额外调用工具
- 只有需要详细信息时才使用 getHealthData 工具`

                // 【Gemini3优化】如果是Gemini 3/3.5模型，使用简化的systemPrompt
                let finalSystemPrompt = systemPrompt;
