            // 保存数据
            await saveData();

            // 关闭弹窗并刷新列表
            closePostTextModal();
            renderMomentsList();

            // 【NPC自动评论】触发NPC对用户朋友圈的评论
            triggerNPCComments(moment, 'user');

            console.log('朋友圈发布成功:', moment);
        }

        // 发布图片朋友圈
