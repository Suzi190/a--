                        justify-content: center;
                        cursor: pointer;
                        font-size: 20px;
                    }
                    .dm-input-wrapper {
                        flex: 1;
                        display: flex;
                        align-items: center;
                        background: #f5f5f5;
                        border-radius: 20px;
                        padding: 8px 16px;
                    }
                    .dm-input {
                        flex: 1;
                        border: none;
