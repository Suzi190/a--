    <script>
        // 检查Capacitor环境
        if (window.Capacitor) {
            window.__appLoadStatus = 'capacitor-ready';
            // 等待Capacitor初始化完成
            window.Capacitor.ready().then(() => {
                window.__appLoadStatus = 'capacitor-initialized';
            }).catch(function(e) {
                console.error('Capacitor初始化失败:', e);
