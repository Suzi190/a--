        };

        // 打开搜索/分类选择
        window.weiboOpenSearch = function() {
            // 创建分类选择弹窗
            let modal = document.getElementById('weiboCategoryModal');
            if (!modal) {
                modal = document.createElement('div');
                modal.id = 'weiboCategoryModal';
                modal.className = 'weibo-category-modal';
                modal.innerHTML = `
                    <div class="weibo-category-backdrop" onclick="weiboCloseCategoryModal()"></div>
                    <div class="weibo-category-content">
                        <div class="weibo-category-header">
                            <span>选择感兴趣的内容</span>
                            <span class="weibo-category-close" onclick="weiboCloseCategoryModal()">×</span>
                        </div>
                        <div class="weibo-category-list" id="weiboCategoryList">
                            <!-- 分类列表 -->
                        </div>
                        <div class="weibo-category-search">
                            <input type="text" id="weiboKeywordInput" placeholder="搜索感兴趣的内容..." onkeypress="if(event.key==='Enter')weiboDoSearch()">
                            <button onclick="weiboDoSearch()">搜索</button>
                        </div>
                    </div>
                `;
                document.body.appendChild(modal);
                
                // 添加弹窗样式
                const styles = document.createElement('style');
                styles.textContent = `
                    .weibo-category-modal {
                        position: fixed;
                        top: 0;
                        left: 0;
                        width: 100%;
                        height: 100%;
                        z-index: 10002;
                        display: none;
                        align-items: flex-end;
                        justify-content: center;
                    }
                    .weibo-category-modal.active {
                        display: flex;
                    }
                    .weibo-category-backdrop {
                        position: absolute;
                        top: 0;
                        left: 0;
                        width: 100%;
                        height: 100%;
                        background: rgba(0,0,0,0.5);
                    }
                    .weibo-category-content {
                        position: relative;
                        width: 100%;
                        background: #fff;
                        border-radius: 20px 20px 0 0;
                        max-height: 80%;
                        overflow-y: auto;
                        animation: slideUp 0.3s ease;
                    }
                    @keyframes slideUp {
                        from { transform: translateY(100%); }
                        to { transform: translateY(0); }
                    }
                    .weibo-category-header {
                        display: flex;
                        justify-content: space-between;
                        align-items: center;
                        padding: 16px 20px;
                        border-bottom: 1px solid #f0f0f0;
                        font-size: 16px;
                        font-weight: 600;
                        color: #333;
                        position: sticky;
                        top: 0;
                        background: #fff;
                    }
                    .weibo-category-close {
                        font-size: 28px;
                        color: #999;
                        cursor: pointer;
                        line-height: 1;
                    }
                    .weibo-category-list {
                        display: grid;
                        grid-template-columns: repeat(4, 1fr);
                        gap: 10px;
                        padding: 16px;
                    }
                    .weibo-category-section-title {
                        grid-column: 1 / -1;
                        font-size: 12px;
                        color: #999;
                        margin-top: 8px;
                        margin-bottom: 4px;
                        padding-left: 4px;
                    }
                    .weibo-category-section-title:first-child {
                        margin-top: 0;
                    }
                    .weibo-category-item {
                        display: flex;
                        flex-direction: column;
                        align-items: center;
                        padding: 16px 8px;
                        border-radius: 12px;
                        cursor: pointer;
                        transition: all 0.2s;
                    }
                    .weibo-category-item:active {
                        background: #f5f5f5;
                        transform: scale(0.95);
                    }
                    .weibo-category-item.active {
                        background: #fff0f0;
                    }
                    .weibo-category-icon {
                        width: 48px;
                        height: 48px;
                        border-radius: 50%;
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        font-size: 24px;
                        margin-bottom: 8px;
                    }
                    .weibo-category-name {
                        font-size: 12px;
                        color: #333;
                        text-align: center;
                    }
                    .weibo-category-search {
                        display: flex;
                        gap: 10px;
                        padding: 16px 20px;
                        border-top: 1px solid #f0f0f0;
                        position: sticky;
                        bottom: 0;
                        background: #fff;
                    }
                    .weibo-category-search input {
                        flex: 1;
                        padding: 12px 16px;
                        border: 1px solid #e0e0e0;
                        border-radius: 20px;
                        font-size: 14px;
                        outline: none;
                    }
                    .weibo-category-search input:focus {
                        border-color: #ff6b6b;
                    }
                    .weibo-category-search button {
                        padding: 12px 24px;
                        background: #ff6b6b;
                        color: #fff;
                        border: none;
                        border-radius: 20px;
                        font-size: 14px;
                        cursor: pointer;
                    }
                `;
                document.head.appendChild(styles);
            }
            
            // 渲染分类列表（分组显示）
            const listEl = document.getElementById('weiboCategoryList');
            
            const mainCategories = ['hot', 'weibo', 'zhihu', 'bilibili', 'toutiao', 'baidu', 'douyin'];
            const subCategories = ['entertainment', 'tech', 'finance', 'sports', 'game', 'food', 'car', 'health', 'edu', 'travel', 'fashion', 'house', 'music', 'anime'];
            
            let html = '<div class="weibo-category-section-title">🌐 全网热门</div>';
            html += mainCategories.map(key => {
                const val = weiboCategoryConfig[key];
                return `
                    <div class="weibo-category-item ${weiboCurrentCategory === key ? 'active' : ''}" 
                         onclick="weiboSelectCategory('${key}')"
                         style="background: ${weiboCurrentCategory === key ? val.color + '15' : ''}">
                        <div class="weibo-category-icon" style="background: ${val.color}20; color: ${val.color}">
                            ${val.icon}
                        </div>
                        <div class="weibo-category-name">${val.name}</div>
                    </div>
                `;
            }).join('');
            
            html += '<div class="weibo-category-section-title">📂 细分领域</div>';
            html += subCategories.map(key => {
                const val = weiboCategoryConfig[key];
                return `
                    <div class="weibo-category-item ${weiboCurrentCategory === key ? 'active' : ''}" 
                         onclick="weiboSelectCategory('${key}')"
                         style="background: ${weiboCurrentCategory === key ? val.color + '15' : ''}">
                        <div class="weibo-category-icon" style="background: ${val.color}20; color: ${val.color}">
                            ${val.icon}
                        </div>
                        <div class="weibo-category-name">${val.name}</div>
                    </div>
                `;
            }).join('');
            
            listEl.innerHTML = html;
            modal.classList.add('active');
        };

        // 关闭分类弹窗
        window.weiboCloseCategoryModal = function() {
            const modal = document.getElementById('weiboCategoryModal');
            if (modal) {
                modal.classList.remove('active');
            }
        };

        // 选择分类
        window.weiboSelectCategory = function(category) {
            weiboCurrentCategory = category;
            weiboCloseCategoryModal();
            
            // 更新显示
            const config = weiboCategoryConfig[category];
            document.getElementById('weiboHeaderTitle').textContent = config.name;
            
            // 根据分类加载不同内容
            weiboLoadCategoryContent(category);
        };

        // 根据分类加载内容
        window.weiboLoadCategoryContent = async function(category) {
            const hotList = document.getElementById('weiboHotList');
            const newsList = document.getElementById('weiboNewsList');
            
            hotList.innerHTML = '<div class="weibo-loading"><div class="weibo-loading-spinner"></div></div>';
            newsList.innerHTML = '<div class="weibo-loading"><div class="weibo-loading-spinner"></div></div>';
            
            // 获取分类对应的API
            const categoryData = await weiboFetchCategoryData(category);
            
            if (categoryData.hot) {
                weiboHotData = categoryData.hot;
                weiboRenderHotSearch();
            }
            
            if (categoryData.news) {
                weiboNewsData = categoryData.news;
                weiboRenderNews();
            }
        };

        // 获取分类数据 - 聚合多平台
        window.weiboFetchCategoryData = async function(category) {
            let hotData = [];
            let newsData = [];
            
            // 判断是否是主平台分类
            const mainPlatforms = ['weibo', 'zhihu', 'bilibili', 'toutiao', 'baidu', 'douyin'];
            const isMainPlatform = mainPlatforms.includes(category);
            
            if (category === 'hot') {
                // 全网热搜 - 聚合所有平台
                hotData = await weiboFetchAllPlatformsHot();
                newsData = await weiboFetchAllPlatformsNews();
            } else if (isMainPlatform) {
                // 单个平台
                hotData = await weiboFetchPlatformHot(category);
                newsData = await weiboFetchPlatformNews(category);
            } else {
                // 细分领域 - 聚合搜索
                const keywords = weiboCategoryConfig[category]?.keywords || '';
                hotData = await weiboSearchHotFromAPI(keywords);
                newsData = await weiboSearchNewsFromAPI(keywords);
            }
            
            // 如果API失败，使用备用数据
            if (!hotData || hotData.length === 0) {
                hotData = weiboGetBackupHotByCategory(category);
            }
            if (!newsData || newsData.length === 0) {
                newsData = weiboGetBackupNewsByCategory(category);
            }
            
            return { hot: hotData, news: newsData };
        };

        // 聚合所有平台热搜
        window.weiboFetchAllPlatformsHot = async function() {
            const allHot = [];
            
            // 并行请求多个平台
            const promises = [
                weiboFetchPlatformHot('baidu').catch(() => []),
                weiboFetchPlatformHot('zhihu').catch(() => []),
                weiboFetchPlatformHot('douyin').catch(() => []),
                weiboSearchHotFromAPI('热门').catch(() => [])
            ];
            
            const results = await Promise.all(promises);
            
            // 合并并按热度排序
            results.forEach(platformData => {
                if (platformData && platformData.length > 0) {
                    allHot.push(...platformData.slice(0, 8));
                }
            });
            
            // 去重并返回前20
            const seen = new Set();
            const unique = allHot.filter(item => {
                const key = item.title.substring(0, 10);
                if (seen.has(key)) return false;
                seen.add(key);
                return true;
            });
            
            return unique.slice(0, 20);
        };

        // 聚合所有平台新闻
        window.weiboFetchAllPlatformsNews = async function() {
            const allNews = [];
            
            const promises = [
                weiboFetchPlatformNews('toutiao').catch(() => []),
                weiboFetchPlatformNews('tencent').catch(() => []),
                weiboSearchNewsFromAPI('热点').catch(() => [])
            ];
            
            const results = await Promise.all(promises);
            
            results.forEach(platformData => {
                if (platformData && platformData.length > 0) {
                    allNews.push(...platformData.slice(0, 5));
                }
            });
            
            // 去重
            const seen = new Set();
            const unique = allNews.filter(item => {
                const key = item.title.substring(0, 10);
                if (seen.has(key)) return false;
                seen.add(key);
                return true;
            });
            
            return unique.slice(0, 15);
        };

        // 获取单个平台热搜
        window.weiboFetchPlatformHot = async function(platform) {
            try {
                if (platform === 'baidu') {
                    const response = await fetch('https://top.baidu.com/api/recommend?get=1');
                    const data = await response.json();
                    if (data.data) {
                        return data.data.map((item, index) => ({
                            rank: index + 1,
                            title: item.word,
                            heat: item.hotScore ? (item.hotScore > 10000 ? Math.floor(item.hotScore/10000) + '万' : item.hotScore) : '',
                            tag: index < 3 ? 'hot' : '',
                            num: item.hotScore || '',
                            platform: 'baidu'
                        }));
                    }
                } else if (platform === 'zhihu') {
                    const response = await fetch('https://www.zhihu.com/api/v3/feed/topstory/hot-lists/total?limit=50');
                    const data = await response.json();
                    if (data.data) {
                        return data.data.map((item, index) => ({
                            rank: index + 1,
                            title: item.target ? item.target.title : item.title,
                            heat: item.detail_text || '',
                            tag: index < 3 ? 'hot' : '',
                            num: item.detail_text || '',
                            platform: 'zhihu'
                        }));
                    }
                } else if (platform === 'douyin') {
                    // 抖音热搜（使用百度数据模拟）
                    return weiboSearchHotFromAPI('抖音 热点');
                }
            } catch (e) {
                console.log('获取平台热搜失败:', platform, e);
            }
            return [];
        };

        // 获取单个平台新闻
        window.weiboFetchPlatformNews = async function(platform) {
            try {
                if (platform === 'toutiao') {
                    const response = await fetch('https://www.toutiao.com/api/pc/feed/?category=news_hot&max_behot_time=0&utm_source=toutiao');
                    const data = await response.json();
                    if (data.data) {
                        return data.data.filter(item => item.title).slice(0, 10).map(item => ({
                            title: item.title,
                            source: item.source || '今日头条',
                            time: item.publish_time ? weiboTimeAgo(item.publish_time) : '刚刚',
                            image: item.image_url || '',
                            content: item.abstract || '',
                            platform: 'toutiao'
                        }));
                    }
                } else if (platform === 'tencent') {
                    const response = await fetch('https://r.inews.qq.com/gw/event/hot_ranking');
                    const data = await response.json();
                    if (data.idlist && data.idlist[0] && data.idlist[0].newslist) {
                        return data.idlist[0].newslist.slice(0, 10).map(item => ({
                            title: item.title,
                            source: item.source || '腾讯新闻',
                            time: item.time || '刚刚',
                            image: item.img || '',
                            content: item.intro || '',
                            platform: 'tencent'
                        }));
                    }
                }
            } catch (e) {
                console.log('获取平台新闻失败:', platform, e);
            }
            return [];
        };

        // 搜索热点
        window.weiboSearchHotFromAPI = async function(keyword) {
            try {
                // 尝试使用百度搜索趋势
                const response = await fetch('https://top.baidu.com/api/search?ui2=web.utils.getRankList&' + new URLSearchParams({
                    ksFrom: 'wise_toplist',
                    nu: keyword,
                    rn: 20
                }));
                
                if (response.ok) {
                    const data = await response.json();
                    if (data.data) {
                        return data.data.map((item, index) => ({
                            rank: index + 1,
                            title: item.word,
                            heat: item.hotScore ? (item.hotScore > 10000 ? Math.floor(item.hotScore/10000) + '万' : item.hotScore) : '',
                            tag: index < 3 ? 'hot' : '',
                            num: item.hotScore || ''
                        }));
                    }
                }
            } catch (e) {
                console.log('搜索热点失败', e);
            }
            return null;
        };

        // 搜索新闻
        window.weiboSearchNewsFromAPI = async function(keyword) {
            try {
                // 使用今日头条搜索
                const response = await fetch(`https://www.toutiao.com/api/pc/feed/?${new URLSearchParams({
                    category: 'news_' + keyword.split(' ')[0],
                    max_behot_time: 0,
                    utm_source: 'toutiao'
                })}`);
                
                if (response.ok) {
                    const data = await response.json();
                    if (data.data) {
                        return data.data.filter(item => item.title).slice(0, 10).map(item => ({
                            title: item.title,
                            source: item.source || '今日头条',
                            time: item.publish_time ? weiboTimeAgo(item.publish_time) : '刚刚',
                            image: item.image_url || '',
                            content: item.abstract || ''
                        }));
                    }
                }
            } catch (e) {
                console.log('搜索新闻失败', e);
            }
            return null;
        };

