    <!-- 信件格子页面 -->
    <div id="letterGridPage" class="letter-grid-page">
        <div class="letter-grid-bg"></div>
        <button class="letter-grid-close" onclick="closeLetterGridPage()">✕</button>
        <!-- 飞过来的信封动画元素 -->
        <img src="https://s41.ax1x.com/2026/02/16/pZLLVbQ.png" class="flying-envelope" id="flyingEnvelope" alt="飞来的信封">
        <div class="letter-grid-content">
            <!-- 信件格子区域 -->
            <div class="letter-grid-container" id="letterGridContainer">
                <!-- 格子将通过JS动态生成 -->
            </div>
        </div>
        <!-- 修改信纸背景按钮 -->
        <button class="letter-test-btn" onclick="openLetterBgModal()">🖼️ 修改信纸背景</button>
        <!-- 编辑信件按钮 -->
        <button class="letter-edit-btn" id="letterEditBtn" onclick="toggleLetterEditMode()">✏️ 编辑信件</button>
        <!-- 底部日期文本区域 -->
        <div class="letter-date-bar" id="letterDateBar">
            <span class="letter-date-text">点击信封查看日期</span>
        </div>
