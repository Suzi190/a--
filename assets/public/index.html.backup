        // 【Capacitor SQLite】初始化SQLite（如果是APK环境）
        async function initSQLite() {
            // 【诊断】详细检查Capacitor环境
            console.log('【SQLite】开始初始化...');
            console.log('【SQLite】window.Capacitor:', typeof window.Capacitor);
            console.log('【SQLite】window.Capacitor?.Plugins:', typeof window.Capacitor?.Plugins);
            console.log('【SQLite】window.Capacitor?.Plugins?.CapacitorSQLite:', typeof window.Capacitor?.Plugins?.CapacitorSQLite);
            
            // 【关键修复】添加全局超时保护，确保不会永远卡住
            const GLOBAL_TIMEOUT = 25000; // 25秒全局超时
            const initPromise = (async () => {
                // 【低版本兼容】检测Android版本
                const userAgent = navigator.userAgent;
                const androidVersion = userAgent.match(/Android\s([0-9.]+)/);
                const isLowVersionAndroid = androidVersion && parseFloat(androidVersion[1]) < 8;
                
                if (isLowVersionAndroid) {
                    console.warn('【SQLite】检测到Android版本较低 (' + androidVersion[1] + ')，将使用降级方案');
                    SQLiteManager.setAvailable(false);
                    // 标记使用降级模式
                    window.__useFallbackStorage = true;
                    return false;
                }
            
            // 【紧急修复】检查是否被禁用
            const isDisabled = localStorage.getItem('__sqlite_disabled') === 'true';
            if (isDisabled) {
                console.warn('【SQLite】SQLite 已被用户禁用，跳过初始化');
                SQLiteManager.setAvailable(false);
                return false;
            }
            
            // 【紧急修复】检查是否需要强制重置数据库
            const needsReset = localStorage.getItem('__sqlite_corrupted') === 'true';
            const forceReset = localStorage.getItem('__sqlite_force_reset') === 'true';
            
            if (needsReset || forceReset) {
                console.warn('【SQLite】检测到数据库损坏标记，准备强制重置...');
                localStorage.removeItem('__sqlite_corrupted');
                localStorage.removeItem('__sqlite_force_reset');
                
                if (window.Capacitor && window.Capacitor.Plugins && window.Capacitor.Plugins.CapacitorSQLite) {
                    try {
                        const { CapacitorSQLite } = window.Capacitor.Plugins;
                        // 强制删除数据库
                        try {
                            await CapacitorSQLite.deleteDatabase({ database: 'chat_messages.db' });
                            console.log('【SQLite】已强制删除损坏的数据库');
                        } catch (e) {
                            console.log('【SQLite】删除数据库失败（可能不存在）:', e.message);
                        }
                    } catch (e) {
                        console.error('【SQLite】强制重置失败:', e);
                    }
                }
            }
            
            // 【APK环境检测】如果是APK环境，强制设置SQLite可用
            const isAPK = window.Capacitor && window.Capacitor.isNativePlatform && window.Capacitor.isNativePlatform();
            const hasSQLitePlugin = window.Capacitor && window.Capacitor.Plugins && window.Capacitor.Plugins.CapacitorSQLite;
            
            if (isAPK || hasSQLitePlugin) {
                console.log('【SQLite】检测到APK环境或SQLite插件，强制启用SQLite');
                SQLiteManager.setAvailable(true);
                
                // 【低版本兼容】添加超时机制，防止卡住
                let initResult = false;
                try {
                    initResult = await Promise.race([
                        SQLiteManager.initDatabase(),
                        new Promise((_, reject) => 
                            setTimeout(() => reject(new Error('数据库初始化超时')), 10000)
                        )
                    ]);
                } catch (timeoutError) {
                    console.error('【SQLite】数据库初始化超时:', timeoutError.message);
                    initResult = false;
                }
                
                console.log('【SQLite】数据库初始化结果:', initResult);
                
                // 【自动修复】如果初始化失败，尝试重置数据库
                let initSuccess = initResult === true;
                if (!initSuccess) {
                    console.warn('【SQLite】数据库初始化失败，尝试重置数据库...');
                    const resetSuccess = await SQLiteManager.resetDatabase();
                    if (resetSuccess) {
                        console.log('【SQLite】数据库已重置，重新初始化...');
                        try {
                            initSuccess = await Promise.race([
                                SQLiteManager.initDatabase(),
                                new Promise((_, reject) => 
                                    setTimeout(() => reject(new Error('数据库重新初始化超时')), 8000)
                                )
                            ]);
                        } catch (timeoutError) {
                            console.error('【SQLite】数据库重新初始化超时');
                            initSuccess = false;
                        }
                        console.log('【SQLite】重新初始化结果:', initSuccess);
                    }
                }
                
                if (initSuccess) {
                    // 【新增】检查数据库大小并记录日志（不自动清理，保留所有回忆）
                    console.log('【SQLite】检查数据库状态...');
                    const dbSize = await SQLiteManager.getDatabaseSize();
                    if (dbSize) {
                        const sizeMB = (dbSize.totalContentSize / 1024 / 1024).toFixed(2);
                        console.log('【SQLite】当前数据库状态:', {
                            消息总数: dbSize.messageCount,
                            内容总大小: sizeMB + ' MB',
                            说明: '所有消息记录都已保留'
                        });
                        
                        // 如果数据库很大，提示用户可以手动优化（不自动清理）
                        if (dbSize.totalContentSize > 100 * 1024 * 1024) { // 超过100MB
                            console.log('【SQLite】数据库较大，建议手动优化以释放空间');
                        }
                    }
                    
                    // 【数据迁移】检查是否需要从 localforage 迁移数据
                    await migrateDataToSQLite();
                    
                    return true;
                } else {
                    // 【修复】如果初始化失败，重置 isAvailable
                    console.warn('【SQLite】APK环境数据库初始化失败，禁用SQLite');
                    SQLiteManager.setAvailable(false);
                }
            }
            
            // 【关键修复】如果Capacitor还没有加载，等待一段时间再试
            let retries = 0;
            const maxRetries = 5; // 【优化】减少重试次数，避免低版本手机长时间卡住
            while (retries < maxRetries) {
                let available = false;
                try {
                    available = await Promise.race([
                        SQLiteManager.checkAvailability(),
                        new Promise((_, reject) => 
                            setTimeout(() => reject(new Error('检查可用性超时')), 5000)
                        )
                    ]);
                } catch (timeoutError) {
                    console.warn(`【SQLite】检查可用性超时 (尝试 ${retries + 1}/${maxRetries})`);
                    available = false;
                }
                
                console.log(`【SQLite】可用性检查结果 (尝试 ${retries + 1}/${maxRetries}):`, available);
                
                if (available) {
                    let initSuccess = false;
                    try {
                        initSuccess = await Promise.race([
                            SQLiteManager.initDatabase(),
                            new Promise((_, reject) => 
                                setTimeout(() => reject(new Error('数据库初始化超时')), 8000)
                            )
                        ]);
                    } catch (timeoutError) {
                        console.error('【SQLite】数据库初始化超时');
                        initSuccess = false;
                    }
                    
                    console.log('【SQLite】数据库初始化结果:', initSuccess);
                    
                    if (initSuccess) {
                        // 【新增】检查数据库大小并记录日志（不自动清理，保留所有回忆）
                        console.log('【SQLite】检查数据库状态...');
                        const dbSize = await SQLiteManager.getDatabaseSize();
                        if (dbSize) {
                            const sizeMB = (dbSize.totalContentSize / 1024 / 1024).toFixed(2);
                            console.log('【SQLite】当前数据库状态:', {
                                消息总数: dbSize.messageCount,
                                内容总大小: sizeMB + ' MB',
                                说明: '所有消息记录都已保留'
                            });
                            
                            // 如果数据库很大，提示用户可以手动优化（不自动清理）
                            if (dbSize.totalContentSize > 100 * 1024 * 1024) { // 超过100MB
                                console.log('【SQLite】数据库较大，建议手动优化以释放空间');
                            }
                        }
                        
                        // 【数据迁移】检查是否需要从 localforage 迁移数据
                        await migrateDataToSQLite();
                        
                        return true;
                    }
                }
                
                // 等待一段时间后重试
                retries++;
                if (retries < maxRetries) {
                    console.log(`【SQLite】Capacitor插件尚未加载，等待300ms后重试...`);
                    await new Promise(resolve => setTimeout(resolve, 300)); // 【优化】减少等待时间
                }
            }
            
                console.warn('【SQLite】SQLite 不可用（已重试' + maxRetries + '次），将使用 IndexedDB 存储消息');
                // 标记使用降级模式
                window.__useFallbackStorage = true;
                // 显示提示给用户
                setTimeout(() => {
                    showToast('SQLite 未启用，使用 IndexedDB 存储', 'info');
                }, 3000);
                return false;
            })();
            
            // 【关键修复】全局超时保护
            try {
                return await Promise.race([
                    initPromise,
                    new Promise((_, reject) => 
                        setTimeout(() => reject(new Error('SQLite初始化全局超时')), GLOBAL_TIMEOUT)
                    )
                ]);
            } catch (globalTimeoutError) {
                console.error('【SQLite】全局超时触发:', globalTimeoutError.message);
                console.warn('【SQLite】强制使用降级模式');
                SQLiteManager.setAvailable(false);
                window.__useFallbackStorage = true;
                return false;
            }
        }

        // 【数据迁移】强制重新迁移数据（用于调试或重新迁移）
        async function forceMigrateDataToSQLite() {
            console.log('【数据迁移】强制重新迁移数据...');
            // 清除迁移标记
            await SQLiteManager.setSetting('__migration_completed', false);
            await SQLiteManager.setSetting('__migration_date', null);
            await SQLiteManager.setSetting('__migration_count', 0);
            // 执行迁移
            await migrateDataToSQLite();
        }

        // 【调试】显示迁移调试面板
        function showMigrationDebugPanel() {
            // 创建调试面板
            const debugPanel = document.createElement('div');
            debugPanel.id = 'migrationDebugPanel';
            debugPanel.style.cssText = `
                position: fixed;
                top: 50%;
                left: 50%;
                transform: translate(-50%, -50%);
                width: 90%;
                max-width: 400px;
                max-height: 80vh;
                background: white;
                border-radius: 15px;
                box-shadow: 0 10px 40px rgba(0,0,0,0.3);
                z-index: 99999;
                display: flex;
                flex-direction: column;
                font-family: monospace;
                font-size: 12px;
            `;
            
            debugPanel.innerHTML = `
                <div style="padding: 15px; border-bottom: 1px solid #eee; display: flex; justify-content: space-between; align-items: center;">
                    <div style="font-weight: bold; font-size: 14px;">🔧 迁移调试面板</div>
                    <button onclick="document.getElementById('migrationDebugPanel').remove()" style="background: #ff6b6b; color: white; border: none; border-radius: 50%; width: 24px; height: 24px; cursor: pointer;">×</button>
                </div>
                <div id="debugLogContent" style="padding: 15px; overflow-y: auto; flex: 1; max-height: 60vh; background: #f5f5f5;">
                    <div style="color: #666;">等待迁移开始...</div>
                </div>
                <div style="padding: 15px; border-top: 1px solid #eee; display: flex; gap: 10px;">
                    <button onclick="startMigrationWithDebug()" style="flex: 1; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; border: none; padding: 10px; border-radius: 8px; cursor: pointer;">
                        🚀 开始迁移
                    </button>
                    <button onclick="checkSQLiteStatus()" style="flex: 1; background: #f0f0f0; color: #333; border: none; padding: 10px; border-radius: 8px; cursor: pointer;">
                        🔍 检查状态
                    </button>
                </div>
            `;
            
            document.body.appendChild(debugPanel);
        }

        // 【调试】添加日志到调试面板
        function addDebugLog(message, type = 'info') {
            const debugContent = document.getElementById('debugLogContent');
            if (!debugContent) return;
            
            const color = type === 'error' ? '#ff6b6b' : type === 'success' ? '#51cf66' : '#333';
            const time = new Date().toLocaleTimeString();
            const logEntry = document.createElement('div');
            logEntry.style.cssText = `margin-bottom: 5px; color: ${color}; word-break: break-all;`;
            logEntry.textContent = `[${time}] ${message}`;
            
            debugContent.appendChild(logEntry);
            debugContent.scrollTop = debugContent.scrollHeight;
        }

        // 【调试】检查 SQLite 状态
        async function checkSQLiteStatus() {
            addDebugLog('🔍 检查 SQLite 状态...', 'info');
            
            try {
                addDebugLog(`SQLite 可用: ${SQLiteManager.isAvailable}`, 'info');
                
                if (SQLiteManager.isAvailable) {
                    const dbSize = await SQLiteManager.getDatabaseSize();
                    addDebugLog(`SQLite 消息数: ${dbSize?.messageCount || 0}`, 'info');
                    addDebugLog(`SQLite 内容大小: ${((dbSize?.totalContentSize || 0) / 1024 / 1024).toFixed(2)} MB`, 'info');
                }
                
                // 检查 localforage 所有键
                addDebugLog('📦 检查 localforage...', 'info');
                const allKeys = await localforage.keys();
                addDebugLog(`localforage 总键数: ${allKeys.length}`, 'info');
                
                // 显示所有键名和大小
                for (const key of allKeys) {
                    try {
                        const value = await localforage.getItem(key);
                        let size = 0;
                        if (typeof value === 'string') {
                            size = value.length;
                        } else if (value) {
                            size = JSON.stringify(value).length;
                        }
                        const sizeKB = (size / 1024).toFixed(1);
                        
                        // 如果是数组，显示长度
                        let count = '';
                        if (Array.isArray(value)) {
                            count = ` [${value.length}项]`;
                        } else if (value && typeof value === 'object') {
                            // 检查是否有 chatMessages
                            if (value.chatMessages && Array.isArray(value.chatMessages)) {
                                count = ` [chatMessages:${value.chatMessages.length}条]`;
                            } else {
                                count = ` [${Object.keys(value).length}键]`;
                            }
                        }
                        
                        addDebugLog(`  ${key}: ${sizeKB}KB${count}`, 'info');
                    } catch (e) {
                        addDebugLog(`  ${key}: 读取失败`, 'error');
                    }
                }
                
                // 检查 IndexedDB
                addDebugLog('💾 检查 IndexedDB...', 'info');
                const idxMessages = await ChatMessageManager.getAllMessagesFromIndexedDB();
                addDebugLog(`IndexedDB 消息数: ${idxMessages?.length || 0}`, 'info');
                
            } catch (e) {
                addDebugLog(`检查失败: ${e.message}`, 'error');
            }
        }

        // 【调试】带调试的迁移
        async function startMigrationWithDebug() {
            addDebugLog('🚀 开始迁移...', 'info');
            
            try {
                // 清除迁移标记
                await SQLiteManager.setSetting('__migration_completed', false);
                addDebugLog('✅ 清除迁移标记', 'success');
                
                // 检查 SQLite
                if (!SQLiteManager.isAvailable) {
                    addDebugLog('❌ SQLite 不可用！', 'error');
                    return;
                }
                addDebugLog('✅ SQLite 可用', 'success');
                
                // 检查数据源
                const relationshipData = await localforage.getItem('relationshipData') || {};
                const localMsgCount = relationshipData.chatMessages?.length || 0;
                addDebugLog(`📦 localforage 消息: ${localMsgCount} 条`, 'info');
                
                const idxMessages = await ChatMessageManager.getAllMessagesFromIndexedDB();
                const idxMsgCount = idxMessages?.length || 0;
                addDebugLog(`📦 IndexedDB 消息: ${idxMsgCount} 条`, 'info');
                
                if (localMsgCount === 0 && idxMsgCount === 0) {
                    addDebugLog('⚠️ 没有找到消息数据', 'error');
                    return;
                }
                
                // 开始迁移
                let totalMigrated = 0;
                
                // 迁移 localforage 数据
                if (localMsgCount > 0) {
                    addDebugLog('📝 迁移 localforage 数据...', 'info');
                    const batchSize = 100;
                    const oldMessages = relationshipData.chatMessages;
                    for (let i = 0; i < oldMessages.length; i += batchSize) {
                        const batch = oldMessages.slice(i, i + batchSize);
                        try {
                            const savedCount = await SQLiteManager.saveMessages(batch);
                            totalMigrated += savedCount;
                            addDebugLog(`✅ 批次 ${Math.floor(i/batchSize) + 1}: ${savedCount}/${batch.length} 条`, 'success');
                        } catch (e) {
                            addDebugLog(`❌ 批次 ${Math.floor(i/batchSize) + 1} 失败: ${e.message}`, 'error');
                        }
                    }
                }
                
                // 迁移 IndexedDB 数据
                if (idxMsgCount > 0) {
                    addDebugLog('📝 迁移 IndexedDB 数据...', 'info');
                    const batchSize = 100;
                    for (let i = 0; i < idxMessages.length; i += batchSize) {
                        const batch = idxMessages.slice(i, i + batchSize);
                        try {
                            const savedCount = await SQLiteManager.saveMessages(batch);
                            totalMigrated += savedCount;
                            addDebugLog(`✅ 批次 ${Math.floor(i/batchSize) + 1}: ${savedCount}/${batch.length} 条`, 'success');
                        } catch (e) {
                            addDebugLog(`❌ 批次 ${Math.floor(i/batchSize) + 1} 失败: ${e.message}`, 'error');
                        }
                    }
                }
                
                addDebugLog(`🎉 迁移完成！共 ${totalMigrated} 条`, 'success');
                
                // 验证结果
                const dbSize = await SQLiteManager.getDatabaseSize();
                addDebugLog(`📊 最终 SQLite 消息数: ${dbSize?.messageCount || 0}`, 'info');
                
                // 标记迁移完成
                await SQLiteManager.setSetting('__migration_completed', true);
                await SQLiteManager.setSetting('__migration_count', totalMigrated);
                
            } catch (e) {
                addDebugLog(`❌ 迁移失败: ${e.message}`, 'error');
            }
        }

        // 【数据迁移】将 localforage 数据迁移到 SQLite
        async function migrateDataToSQLite() {
            try {
                console.log('【数据迁移】检查是否需要迁移数据...');
                
                // 【修复】如果 SQLite 不可用，跳过迁移
                if (!SQLiteManager.isAvailable) {
                    console.log('【数据迁移】SQLite 不可用，跳过迁移');
                    return;
                }
                
                // 检查是否已经迁移过
                const migrationStatus = await SQLiteManager.getSetting('__migration_completed', false);
                // 【修复】处理可能返回字符串 "true" 的情况
                const isMigrated = migrationStatus === true || migrationStatus === 'true' || migrationStatus === 1;
                if (isMigrated) {
                    console.log('【数据迁移】数据已经迁移过，跳过');
                    // 检查 SQLite 中是否有数据
                    const dbSize = await SQLiteManager.getDatabaseSize();
                    if (dbSize && dbSize.messageCount === 0) {
                        console.warn('【数据迁移】警告：迁移标记为完成，但 SQLite 中没有消息数据！');
                        console.log('【数据迁移】如需重新迁移，请在控制台执行：await forceMigrateDataToSQLite()');
                    }
                    return;
                }
                
                console.log('【数据迁移】开始从 localforage 迁移数据到 SQLite...');
                
                // 显示迁移提示
                const migrationToast = document.createElement('div');
                migrationToast.style.cssText = 'position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);background:rgba(0,0,0,0.9);color:white;padding:20px;border-radius:10px;z-index:99999;font-size:16px;text-align:center;';
                migrationToast.innerHTML = '<div>📦 正在迁移数据到 SQLite...</div><div style="font-size:14px;margin-top:10px;color:#aaa">这可能需要几分钟时间</div>';
                document.body.appendChild(migrationToast);
                
                let migratedCount = 0;
                
                // 1. 迁移应用设置
                console.log('【数据迁移】迁移应用设置...');
                migrationToast.innerHTML = '<div>📦 正在迁移应用设置...</div>';
                try {
                    // 【修复】直接从 localforage 读取旧数据，而不是使用包装函数
                    const appSettings = await localforage.getItem('appSettings') || {};
                    for (const [key, value] of Object.entries(appSettings)) {
                        await SQLiteManager.setSetting(`app_${key}`, value);
                        migratedCount++;
                    }
                    console.log('【数据迁移】应用设置迁移完成');
                } catch (e) {
                    console.warn('【数据迁移】应用设置迁移失败:', e);
                }
                
                // 2. 迁移聊天列表
                console.log('【数据迁移】迁移聊天列表...');
                migrationToast.innerHTML = '<div>📦 正在迁移聊天列表...</div>';
                try {
                    const relationshipData = await localforage.getItem('relationshipData') || {};
                    if (relationshipData.wechatChatList && relationshipData.wechatChatList.length > 0) {
                        await SQLiteManager.saveChatList(relationshipData.wechatChatList);
                        migratedCount += relationshipData.wechatChatList.length;
                        console.log('【数据迁移】聊天列表迁移完成:', relationshipData.wechatChatList.length, '个聊天');
                    }
                } catch (e) {
                    console.warn('【数据迁移】聊天列表迁移失败:', e);
                }
                
                // 3. 迁移世界书
                console.log('【数据迁移】迁移世界书...');
                migrationToast.innerHTML = '<div>📦 正在迁移世界书...</div>';
                try {
                    const relationshipData = await localforage.getItem('relationshipData') || {};
                    if (relationshipData.worldBooks && relationshipData.worldBooks.length > 0) {
                        await SQLiteManager.saveWorldBooks(relationshipData.worldBooks);
                        migratedCount += relationshipData.worldBooks.length;
                        console.log('【数据迁移】世界书迁移完成:', relationshipData.worldBooks.length, '本');
                    }
                } catch (e) {
                    console.warn('【数据迁移】世界书迁移失败:', e);
                }
                
                // 4. 迁移其他关系数据
                console.log('【数据迁移】迁移其他关系数据...');
                migrationToast.innerHTML = '<div>📦 正在迁移其他数据...</div>';
                try {
                    const relationshipData = await localforage.getItem('relationshipData') || {};
                    const keysToMigrate = ['title', 'description', 'startDate', 'mood', 'theme', 'innerThoughts', 'npcList', 'moments'];
                    for (const key of keysToMigrate) {
                        if (relationshipData[key] !== undefined) {
                            await SQLiteManager.saveRelationshipData(key, relationshipData[key]);
                            migratedCount++;
                        }
                    }
                    console.log('【数据迁移】其他关系数据迁移完成');
                } catch (e) {
                    console.warn('【数据迁移】其他关系数据迁移失败:', e);
                }
                
                // 5. 迁移消息数据（从 IndexedDB 和 localforage 中的旧数据）
                console.log('【数据迁移】迁移消息数据...');
                migrationToast.innerHTML = '<div>📦 正在迁移消息数据...</div><div style="font-size:14px;margin-top:10px;color:#aaa">这可能需要一些时间</div>';
                let totalMigratedMessages = 0;
                
                try {
                    // 5.1 先从 localforage 的 relationshipData 中迁移旧消息数据
                    console.log('【数据迁移】检查 localforage 中的旧消息数据...');
                    const relationshipData = await localforage.getItem('relationshipData') || {};
                    if (relationshipData.chatMessages && relationshipData.chatMessages.length > 0) {
                        console.log('【数据迁移】发现 localforage 中的旧消息:', relationshipData.chatMessages.length, '条');
                        const batchSize = 100;
                        const oldMessages = relationshipData.chatMessages;
                        for (let i = 0; i < oldMessages.length; i += batchSize) {
                            const batch = oldMessages.slice(i, i + batchSize);
                            const savedCount = await SQLiteManager.saveMessages(batch);
                            if (savedCount > 0) {
                                totalMigratedMessages += savedCount;
                                console.log(`【数据迁移】成功保存批次 ${i/batchSize + 1}: ${savedCount}/${batch.length} 条`);
                            } else {
                                console.error(`【数据迁移】批次 ${i/batchSize + 1} 保存失败 (0/${batch.length})`);
                            }
                            
                            const progress = Math.round((i / oldMessages.length) * 100);
                            migrationToast.innerHTML = `<div>📦 正在迁移 localforage 消息...</div><div style="font-size:14px;margin-top:10px;color:#aaa">${progress}% (${i}/${oldMessages.length})</div>`;
                            await new Promise(resolve => setTimeout(resolve, 10));
                        }
                        console.log('【数据迁移】localforage 旧消息迁移完成:', totalMigratedMessages, '条');
                    } else {
                        console.log('【数据迁移】localforage 中没有旧消息数据');
                    }
                    
                    // 5.2 从 IndexedDB 读取消息
                    console.log('【数据迁移】检查 IndexedDB 中的消息...');
                    const allMessages = await ChatMessageManager.getAllMessagesFromIndexedDB();
                    if (allMessages && allMessages.length > 0) {
                        console.log('【数据迁移】发现 IndexedDB 消息:', allMessages.length, '条');
                        const batchSize = 100;
                        for (let i = 0; i < allMessages.length; i += batchSize) {
                            const batch = allMessages.slice(i, i + batchSize);
                            const savedCount = await SQLiteManager.saveMessages(batch);
                            if (savedCount > 0) {
                                totalMigratedMessages += savedCount;
                                console.log(`【数据迁移】成功保存批次 ${i/batchSize + 1}: ${savedCount}/${batch.length} 条`);
                            } else {
                                console.error(`【数据迁移】批次 ${i/batchSize + 1} 保存失败 (0/${batch.length})`);
                            }
                            
                            const progress = Math.round((i / allMessages.length) * 100);
                            migrationToast.innerHTML = `<div>📦 正在迁移 IndexedDB 消息...</div><div style="font-size:14px;margin-top:10px;color:#aaa">${progress}% (${i}/${allMessages.length})</div>`;
                            await new Promise(resolve => setTimeout(resolve, 10));
                        }
                        console.log('【数据迁移】IndexedDB 消息迁移完成');
                    } else {
                        console.log('【数据迁移】IndexedDB 中没有消息数据');
                    }
                    
                    migratedCount += totalMigratedMessages;
                    console.log('【数据迁移】消息数据迁移完成，共', totalMigratedMessages, '条');
                    
                    // 验证迁移结果
                    const dbSize = await SQLiteManager.getDatabaseSize();
                    console.log('【数据迁移】迁移后 SQLite 状态:', dbSize);
                } catch (e) {
                    console.warn('【数据迁移】消息数据迁移失败:', e);
                }
                
                // 6. 迁移日记数据（使用专用表）
                console.log('【数据迁移】迁移日记数据...');
                migrationToast.innerHTML = '<div>📦 正在迁移日记数据...</div>';
                try {
                    // 【修复】直接从 localforage 读取旧数据
                    const diaryData = await localforage.getItem('diaryData') || [];
                    if (diaryData.length > 0) {
                        await SQLiteManager.saveDiaryData(diaryData);
                        migratedCount += diaryData.length;
                        console.log('【数据迁移】日记数据迁移完成:', diaryData.length, '条');
                    }
                    const diaryCoverSettings = await localforage.getItem('diaryCoverSettings') || {};
                    if (Object.keys(diaryCoverSettings).length > 0) {
                        await SQLiteManager.saveDiaryCoverSettings(diaryCoverSettings);
                        migratedCount++;
                    }
                } catch (e) {
                    console.warn('【数据迁移】日记数据迁移失败:', e);
                }
                
                // 7. 迁移健康记录数据（使用专用表）
                console.log('【数据迁移】迁移健康记录数据...');
                migrationToast.innerHTML = '<div>📦 正在迁移健康记录...</div>';
                try {
                    const healthDataKeys = ['periodData', 'waterData', 'sleepData', 'diseaseData'];
                    for (const key of healthDataKeys) {
                        const data = await localforage.getItem(key);
                        if (data) {
                            await SQLiteManager.saveHealthData(key, data);
                            migratedCount++;
                            console.log('【数据迁移】', key, '迁移完成');
                        }
                    }
                } catch (e) {
                    console.warn('【数据迁移】健康记录迁移失败:', e);
                }
                
                // 8. 迁移学习课桌数据（使用专用表）
                console.log('【数据迁移】迁移学习课桌数据...');
                migrationToast.innerHTML = '<div>📦 正在迁移学习课桌...</div>';
                try {
                    const studyDeskData = await localforage.getItem('studyDeskData') || {};
                    if (Object.keys(studyDeskData).length > 0) {
                        await SQLiteManager.saveStudyDeskData(studyDeskData);
                        migratedCount++;
                        console.log('【数据迁移】学习课桌数据迁移完成');
                    }
                } catch (e) {
                    console.warn('【数据迁移】学习课桌数据迁移失败:', e);
                }
                
                // 9. 迁移个人资料（使用专用表）
                console.log('【数据迁移】迁移个人资料...');
                migrationToast.innerHTML = '<div>📦 正在迁移个人资料...</div>';
                try {
                    const personalProfile = await localforage.getItem('personalProfile') || {};
                    if (Object.keys(personalProfile).length > 0) {
                        await SQLiteManager.savePersonalProfile(personalProfile);
                        migratedCount++;
                        console.log('【数据迁移】个人资料迁移完成');
                    }
                } catch (e) {
                    console.warn('【数据迁移】个人资料迁移失败:', e);
                }
                
                // 10. 迁移通话记录（使用专用表）
                console.log('【数据迁移】迁移通话记录...');
                migrationToast.innerHTML = '<div>📦 正在迁移通话记录...</div>';
                try {
                    const callRecords = await localforage.getItem('callRecords') || [];
                    if (Array.isArray(callRecords) && callRecords.length > 0) {
                        await SQLiteManager.saveCallRecords(callRecords);
                        migratedCount += callRecords.length;
                        console.log('【数据迁移】通话记录迁移完成:', callRecords.length, '条');
                    }
                } catch (e) {
                    console.warn('【数据迁移】通话记录迁移失败:', e);
                }
                
                // 11. 迁移 API 设置（使用专用表）
                console.log('【数据迁移】迁移 API 设置...');
                migrationToast.innerHTML = '<div>📦 正在迁移 API 设置...</div>';
                try {
                    const apiModels = await localforage.getItem('apiModels');
                    if (apiModels) {
                        await SQLiteManager.saveApiSetting('apiModels', apiModels);
                        migratedCount++;
                    }
                    const apiPresets = await localforage.getItem('apiPresets') || [];
                    if (apiPresets.length > 0) {
                        await SQLiteManager.saveApiSetting('apiPresets', apiPresets);
                        migratedCount++;
                    }
                    const useLocalServer = await localforage.getItem('useLocalServer');
                    if (useLocalServer !== null) {
                        await SQLiteManager.saveApiSetting('useLocalServer', useLocalServer);
                        migratedCount++;
                    }
                    console.log('【数据迁移】API 设置迁移完成');
                } catch (e) {
                    console.warn('【数据迁移】API 设置迁移失败:', e);
                }
                
                // 12. 迁移聊天徽章数据（使用专用表）
                console.log('【数据迁移】迁移聊天徽章...');
                migrationToast.innerHTML = '<div>📦 正在迁移聊天徽章...</div>';
                try {
                    const chatBadges = await localforage.getItem('chatBadges') || {};
                    if (Object.keys(chatBadges).length > 0) {
                        await SQLiteManager.saveChatBadges(chatBadges);
                        migratedCount++;
                        console.log('【数据迁移】聊天徽章迁移完成');
                    }
                } catch (e) {
                    console.warn('【数据迁移】聊天徽章迁移失败:', e);
                }
                
                // 13. 迁移荣誉墙数据（使用专用表）
                console.log('【数据迁移】迁移荣誉墙...');
                migrationToast.innerHTML = '<div>📦 正在迁移荣誉墙...</div>';
                try {
