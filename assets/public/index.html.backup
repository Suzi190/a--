                '走': 'Z', '奏': 'Z', '租': 'Z', '足': 'Z', '卒': 'Z', '族': 'Z', '阻': 'Z', '组': 'Z', '祖': 'Z', '钻': 'Z',
                '嘴': 'Z', '最': 'Z', '罪': 'Z', '醉': 'Z', '尊': 'Z', '遵': 'Z', '昨': 'Z', '左': 'Z', '佐': 'Z', '作': 'Z',
                '坐': 'Z', '座': 'Z', '做': 'Z'
            };
            
            if (pinyinMap[char]) {
                return pinyinMap[char];
            }
            
            // 如果字符是中文但没有在映射表中，尝试使用 Unicode 范围估算
            const code = char.charCodeAt(0);
            if (code >= 0x4E00 && code <= 0x9FA5) {
                // 根据 Unicode 码点粗略估计
                const letters = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
                const index = Math.floor((code - 0x4E00) / (0x9FA5 - 0x4E00) * 26);
                return letters[Math.min(index, 25)];
            }
            
            return '#';
        }
        
