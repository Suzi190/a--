                container.innerHTML = `
                    <div class="memo-detail-empty">
                        <div class="memo-detail-empty-icon">📜</div>
                        <div>暂无家规</div>
                    </div>
                `;
            } else {
                container.innerHTML = houseRules.map((rule, index) => `
                    <div class="memo-detail-item">
                        <div class="memo-detail-item-text">${index + 1}. ${rule}</div>
