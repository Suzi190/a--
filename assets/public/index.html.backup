            // 【统一存储】保存关系数据
            async saveRelationshipData(key, value) {
                if (!this.isAvailable) return false;
                try {
                    const { CapacitorSQLite } = window.Capacitor.Plugins;
                    
                    // 【简化】直接序列化，让 replacer 处理特殊值
                    const serializedValue = JSON.stringify(value, (k, v) => {
                        if (v === undefined) return null;
                        if (typeof v === 'string' && v === '[object Object]') {
                            console.warn(`【SQLite】字段 ${k} 包含 [object Object]，已清空`);
                            return '';
                        }
                        return v;
                    });
                    
                    // 最终检查
                    if (serializedValue.includes('[object Object]')) {
                        console.error('【SQLite】saveRelationshipData: 序列化后仍包含 [object Object]，拒绝保存');
                        return false;
                    }
                    
                    await CapacitorSQLite.run({
                        database: 'chat_messages.db',
                        statement: `INSERT OR REPLACE INTO relationship_data (key, value, updated_at) VALUES (?, ?, ?)`,
                        values: [key, serializedValue, Date.now()]
                    });
                    return true;
                } catch (error) {
                    console.error('【SQLite】保存关系数据失败:', error);
                    // 【紧急修复】如果保存失败，禁用 SQLite 防止持续报错
                    if (error.message && (error.message.includes('[object Object]') || error.message.includes('not valid JSON'))) {
                        console.error('【SQLite】检测到严重错误，自动禁用 SQLite');
                        this.isAvailable = false;
                        localStorage.setItem('__sqlite_corrupted', 'true');
                    }
                    return false;
                }
            },
            
            // 【新增】清理对象中的 [object Object] 值
            cleanObjectValues(obj, path = '') {
                if (obj === null || obj === undefined) return obj;
                
                if (typeof obj === 'string') {
                    if (obj === '[object Object]' || obj.includes('[object Object]')) {
                        console.warn(`【SQLite】cleanObjectValues: 发现无效值 "[object Object]" 在路径: ${path}，已清空`);
                        return '';
                    }
                    return obj;
                }
                
                if (Array.isArray(obj)) {
                    return obj.map((item, index) => this.cleanObjectValues(item, `${path}[${index}]`));
                }
                
                if (typeof obj === 'object') {
                    const cleaned = {};
                    for (const [key, value] of Object.entries(obj)) {
                        cleaned[key] = this.cleanObjectValues(value, `${path}.${key}`);
                    }
                    return cleaned;
                }
                
                return obj;
            },
            
            // 【统一存储】获取关系数据
            async getRelationshipData(key, defaultValue = null) {
                if (!this.isAvailable) return defaultValue;
                try {
                    const { CapacitorSQLite } = window.Capacitor.Plugins;
                    const result = await CapacitorSQLite.query({
                        database: 'chat_messages.db',
                        statement: `SELECT value FROM relationship_data WHERE key = ?`,
                        values: [key]
                    });
                    if (result.values && result.values.length > 0) {
                        return this.safeJSONParse(result.values[0].value, defaultValue, 'getRelationshipData');
                    }
                    return defaultValue;
                } catch (error) {
                    console.error('【SQLite】获取关系数据失败:', error);
                    return defaultValue;
                }
            },
            
