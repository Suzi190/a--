        // ==================== NPC长按上传图片功能 ====================
        
        // 初始化NPC长按事件
        (function initNPCLongPress() {
            const husbandNPC = document.getElementById('husbandNPC');
            const wifeNPC = document.getElementById('wifeNPC');
            
            if (husbandNPC) setupLongPress(husbandNPC, 'husband');
            if (wifeNPC) setupLongPress(wifeNPC, 'wife');
            
            // 加载已保存的NPC图片
            loadNPCImages();
        })();

        // 页面显示时加载NPC图片
        const originalOpenBodyManager = window.openBodyManager;
        window.openBodyManager = async function() {
            originalOpenBodyManager();
            // 等待页面显示后加载图片和背景
            setTimeout(async () => {
                await loadNPCImages();
                await initMainBackground();
            }, 100);
        };

        // 设置长按事件
        function setupLongPress(element, npcType) {
            let pressTimer;
            let isLongPress = false;
            const longPressDuration = 800; // 长按800毫秒触发
            
            // 触摸事件
            element.addEventListener('touchstart', (e) => {
                isLongPress = false;
                element.classList.add('long-pressing');
                pressTimer = setTimeout(() => {
                    isLongPress = true;
                    element.classList.remove('long-pressing');
                    if (npcType === 'husband') {
                        openCharacterSelection();
                    } else {
                        openNPCImageUpload(npcType);
                    }
                }, longPressDuration);
            }, { passive: true });
            
            element.addEventListener('touchend', (e) => {
                clearTimeout(pressTimer);
                element.classList.remove('long-pressing');
                if (!isLongPress) {
                    // 短按显示对话
                    if (npcType === 'husband') showHusbandDialog();
                    else showWifeDialog();
                }
            });
            
            element.addEventListener('touchmove', () => {
                clearTimeout(pressTimer);
                element.classList.remove('long-pressing');
            });
            
            // 鼠标事件
            element.addEventListener('mousedown', (e) => {
                isLongPress = false;
                element.classList.add('long-pressing');
                pressTimer = setTimeout(() => {
                    isLongPress = true;
                    element.classList.remove('long-pressing');
                    if (npcType === 'husband') {
                        openCharacterSelection();
                    } else {
                        openNPCImageUpload(npcType);
                    }
                }, longPressDuration);
            });
            
            element.addEventListener('mouseup', (e) => {
                clearTimeout(pressTimer);
                element.classList.remove('long-pressing');
                if (!isLongPress) {
                    if (npcType === 'husband') showHusbandDialog();
                    else showWifeDialog();
                }
            });
            
            element.addEventListener('mouseleave', () => {
                clearTimeout(pressTimer);
                element.classList.remove('long-pressing');
            });
            
            // 阻止右键菜单
            element.addEventListener('contextmenu', (e) => {
                e.preventDefault();
            });
        }

        // 打开角色选择弹窗 - 从微信联系人列表选择
        function openCharacterSelection() {
            const modal = document.createElement('div');
            modal.className = 'character-selection-modal';
            modal.id = 'bodyManagerCharSelectModal';
            
            // 获取所有可选择的角色（微信联系人 + NPC）
            let characters = [];
            
            // 添加微信联系人
            if (relationshipData.wechatChatList && relationshipData.wechatChatList.length > 0) {
                relationshipData.wechatChatList.forEach(char => {
                    characters.push({
                        id: char.id,
                        name: char.remark || char.name,
                        avatar: char.avatar,
                        type: 'wechat',
                        isGroup: char.isGroupChat
                    });
                });
            }
            
            // 添加NPC
            if (relationshipData.npcList && relationshipData.npcList.length > 0) {
                relationshipData.npcList.forEach(npc => {
                    characters.push({
                        id: `npc_${npc.id}`,
                        name: npc.name,
                        avatar: npc.avatar,
                        type: 'npc'
                    });
                });
            }
            
            // 生成角色列表HTML
            let charactersHTML = '';
            if (characters.length === 0) {
                charactersHTML = '<div style="text-align: center; padding: 40px; color: #999;">暂无角色，请先添加微信联系人或NPC</div>';
            } else {
                charactersHTML = characters.map(char => {
                    let avatarHTML = '👤';
                    if (char.avatar && (char.avatar.startsWith('http') || char.avatar.startsWith('data:'))) {
                        avatarHTML = `<img src="${char.avatar}" style="width: 100%; height: 100%; border-radius: 50%; object-fit: cover;">`;
                    } else if (char.avatar && char.avatar.length <= 2) {
                        avatarHTML = char.avatar;
                    }
                    
                    const typeLabel = char.type === 'npc' ? 'NPC' : (char.isGroup ? '群聊' : '联系人');
                    
                    return `
                        <div class="character-list-item" onclick="selectCharacterForBodyManager('${char.id}', '${char.name}', '${char.avatar || ''}', '${char.type}')">
                            <div class="character-list-avatar">${avatarHTML}</div>
                            <div class="character-list-info">
                                <div class="character-list-name">${char.name}</div>
                                <div class="character-list-type">${typeLabel}</div>
                            </div>
                        </div>
                    `;
                }).join('');
            }
            
            modal.innerHTML = `
                <style>
                    .character-selection-modal {
                        position: fixed;
                        top: 0;
                        left: 0;
                        width: 100%;
                        height: 100%;
                        background: rgba(0, 0, 0, 0.6);
                        z-index: 100000;
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        animation: fadeIn 0.3s ease;
                    }
                    .character-selection-content {
                        background: white;
                        border-radius: 25px;
                        padding: 25px;
                        width: 90%;
                        max-width: 360px;
                        max-height: 70vh;
                        display: flex;
                        flex-direction: column;
                        animation: slideUp 0.3s ease;
                    }
                    .character-selection-title {
                        font-size: 18px;
                        font-weight: 700;
                        color: #333;
                        text-align: center;
                        margin-bottom: 20px;
                        flex-shrink: 0;
                    }
                    .character-list {
                        overflow-y: auto;
                        max-height: 50vh;
                        padding-right: 5px;
                    }
                    .character-list::-webkit-scrollbar {
                        width: 4px;
                    }
                    .character-list::-webkit-scrollbar-thumb {
                        background: #ffb6c1;
                        border-radius: 2px;
                    }
                    .character-list-item {
                        display: flex;
                        align-items: center;
                        gap: 15px;
                        padding: 15px;
                        margin-bottom: 10px;
                        background: linear-gradient(135deg, #fff5f8 0%, #ffeff4 100%);
                        border-radius: 15px;
                        cursor: pointer;
                        transition: all 0.3s ease;
                        border: 2px solid transparent;
                    }
                    .character-list-item:hover {
                        border-color: #ffb6c1;
                        transform: translateX(5px);
                    }
                    .character-list-avatar {
                        width: 45px;
                        height: 45px;
                        background: linear-gradient(135deg, #ffb6c1 0%, #ff9eb5 100%);
                        border-radius: 50%;
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        font-size: 24px;
                        flex-shrink: 0;
                        overflow: hidden;
                    }
                    .character-list-info {
                        flex: 1;
                        min-width: 0;
                    }
                    .character-list-name {
                        font-size: 15px;
                        font-weight: 600;
                        color: #333;
                        margin-bottom: 3px;
                        white-space: nowrap;
                        overflow: hidden;
                        text-overflow: ellipsis;
                    }
                    .character-list-type {
                        font-size: 11px;
                        color: #999;
                    }
                    .character-list-actions {
                        display: flex;
                        gap: 10px;
                        margin-top: 20px;
                        flex-shrink: 0;
                    }
                    .character-list-btn {
                        flex: 1;
                        padding: 12px;
                        border: none;
                        border-radius: 12px;
                        font-size: 14px;
                        cursor: pointer;
                        transition: all 0.3s ease;
                    }
                    .character-list-btn.cancel {
                        background: #f5f5f5;
                        color: #666;
                    }
                    .character-list-btn.cancel:hover {
                        background: #eee;
                    }
                    .character-list-btn.custom {
                        background: linear-gradient(135deg, #ffb6c1 0%, #ff6b9d 100%);
                        color: white;
                    }
                    .character-list-btn.custom:hover {
                        transform: translateY(-2px);
                        box-shadow: 0 4px 12px rgba(255, 107, 157, 0.4);
                    }
                    @keyframes fadeIn {
                        from { opacity: 0; }
                        to { opacity: 1; }
                    }
                    @keyframes slideUp {
                        from { transform: translateY(30px); opacity: 0; }
                        to { transform: translateY(0); opacity: 1; }
                    }
                </style>
                <div class="character-selection-content">
                    <div class="character-selection-title">选择角色 👤</div>
                    <div class="character-list">
                        ${charactersHTML}
                    </div>
                    <div class="character-list-actions">
                        <button class="character-list-btn cancel" onclick="document.getElementById('bodyManagerCharSelectModal').remove()">取消</button>
                        <button class="character-list-btn custom" onclick="document.getElementById('bodyManagerCharSelectModal').remove(); openNPCImageUpload('husband')">上传自定义</button>
                    </div>
                </div>
            `;
            
            modal.addEventListener('click', (e) => {
                if (e.target === modal) modal.remove();
            });
            
            document.body.appendChild(modal);
        }

        // 选择角色用于身材管理
        window.selectCharacterForBodyManager = async function(charId, charName, charAvatar, charType) {
            const modal = document.getElementById('bodyManagerCharSelectModal');
            if (modal) modal.remove();
            
            // 保存选择的角色信息到 localforage
            const selectedChar = {
                id: charId,
                name: charName,
                type: charType
            };
            await localforage.setItem('bodyManager_selected_char', selectedChar);
            
            // 更新气泡文字
            const bubble = document.querySelector('#husbandBubble .bubble-content');
            if (bubble) {
                bubble.textContent = `${charName}，今天要一起运动吗？`;
            }
            
            // 弹出选择 NPC 图片弹窗
            openNPCImageUpload('husband');
            
            showBodyManagerToast(`已选择角色：${charName}，请上传形象图片`);
        };

        // 打开NPC图片上传
        function openNPCImageUpload(npcType) {
