        // IndexedDB 数据库名称和版本
        const NPC_DB_NAME = 'BodyManagerNPCDB';
        const NPC_DB_VERSION = 1;
        const NPC_STORE_NAME = 'npcImages';
        let npcDB = null;

        // 初始化 IndexedDB
        function initNPCDB() {
            return new Promise((resolve, reject) => {
                const request = indexedDB.open(NPC_DB_NAME, NPC_DB_VERSION);
                
                request.onerror = () => reject(request.error);
                request.onsuccess = () => {
                    npcDB = request.result;
                    resolve(npcDB);
                };
                
                request.onupgradeneeded = (event) => {
                    const db = event.target.result;
                    if (!db.objectStoreNames.contains(NPC_STORE_NAME)) {
                        db.createObjectStore(NPC_STORE_NAME, { keyPath: 'id' });
                    }
                };
            });
        }

        // 保存NPC图片到IndexedDB
        async function saveNPCImage(npcType, imageData) {
            if (!npcDB) await initNPCDB();
            
            return new Promise((resolve, reject) => {
                const transaction = npcDB.transaction([NPC_STORE_NAME], 'readwrite');
                const store = transaction.objectStore(NPC_STORE_NAME);
                const request = store.put({ id: npcType, imageData: imageData });
                
                request.onsuccess = () => resolve();
                request.onerror = () => reject(request.error);
            });
        }

        // 从IndexedDB获取NPC图片
        async function getNPCImage(npcType) {
            if (!npcDB) await initNPCDB();
            
            return new Promise((resolve, reject) => {
                const transaction = npcDB.transaction([NPC_STORE_NAME], 'readonly');
                const store = transaction.objectStore(NPC_STORE_NAME);
                const request = store.get(npcType);
                
                request.onsuccess = () => resolve(request.result ? request.result.imageData : null);
                request.onerror = () => reject(request.error);
            });
        }

        // 从IndexedDB删除NPC图片
        async function removeNPCImage(npcType) {
            if (!npcDB) await initNPCDB();
            
            return new Promise((resolve, reject) => {
                const transaction = npcDB.transaction([NPC_STORE_NAME], 'readwrite');
                const store = transaction.objectStore(NPC_STORE_NAME);
                const request = store.delete(npcType);
                
                request.onsuccess = () => resolve();
                request.onerror = () => reject(request.error);
            });
        }

        // 处理NPC图片上传
        window.handleNPCImageUpload = async function(input, npcType) {
            const file = input.files[0];
            if (!file) return;
            
            // 检查文件类型
            if (!file.type.startsWith('image/')) {
                showBodyManagerToast('请选择图片文件');
                return;
            }
            
            // 检查文件大小（最大10MB）
            if (file.size > 10 * 1024 * 1024) {
                showBodyManagerToast('图片大小不能超过10MB');
                return;
            }
            
            const reader = new FileReader();
            reader.onload = async function(e) {
                try {
                    const imageData = e.target.result;
                    
                    // 保存到IndexedDB
                    await saveNPCImage(npcType, imageData);
                    
                    // 更新显示
                    updateNPCImage(npcType, imageData);
                    
                    // 关闭弹窗
                    const modal = document.querySelector('.npc-upload-modal');
                    if (modal) modal.remove();
                    
                    showBodyManagerToast(`${npcType === 'husband' ? '老公' : '我'}的形象已更新！`);
                } catch (error) {
                    console.error('保存图片失败:', error);
                    showBodyManagerToast('保存失败，请重试');
                }
            };
            reader.readAsDataURL(file);
        };

        // 更新NPC图片显示
        function updateNPCImage(npcType, imageData) {
            const containerId = npcType === 'husband' ? 'husbandImageContainer' : 'wifeImageContainer';
            const container = document.getElementById(containerId);
            if (!container) return;
            
            // 清空容器
            container.innerHTML = '';
            container.classList.add('has-image');
            
            // 创建图片元素
            const img = document.createElement('img');
            img.src = imageData;
            img.alt = npcType === 'husband' ? '老公' : '我';
            
            // 创建删除按钮
            const deleteBtn = document.createElement('div');
            deleteBtn.className = 'delete-btn';
            deleteBtn.innerHTML = '×';
            deleteBtn.onclick = async (e) => {
                e.stopPropagation();
                await deleteNPCImage(npcType);
            };
            
            container.appendChild(img);
            container.appendChild(deleteBtn);
        }

        // 删除NPC图片
        async function deleteNPCImage(npcType) {
            try {
                await removeNPCImage(npcType);
                
                const containerId = npcType === 'husband' ? 'husbandImageContainer' : 'wifeImageContainer';
                const container = document.getElementById(containerId);
                if (!container) return;
                
                // 恢复默认SVG
                container.classList.remove('has-image');
                container.innerHTML = npcType === 'husband' ? `
                    <svg class="person-svg" width="120" height="180" viewBox="0 0 60 90">
                        <circle cx="30" cy="12" r="10" fill="none" stroke="#ff9eb5" stroke-width="2" stroke-dasharray="4 3"/>
                        <line x1="30" y1="22" x2="30" y2="55" stroke="#ff9eb5" stroke-width="2" stroke-dasharray="4 3"/>
                        <path d="M30 30 Q15 35 10 45" fill="none" stroke="#ff9eb5" stroke-width="2" stroke-dasharray="4 3"/>
                        <path d="M30 30 Q45 35 50 45" fill="none" stroke="#ff9eb5" stroke-width="2" stroke-dasharray="4 3"/>
                        <path d="M30 55 Q20 70 15 85" fill="none" stroke="#ff9eb5" stroke-width="2" stroke-dasharray="4 3"/>
                        <path d="M30 55 Q40 70 45 85" fill="none" stroke="#ff9eb5" stroke-width="2" stroke-dasharray="4 3"/>
                    </svg>
                ` : `
                    <svg class="person-svg female" width="110" height="170" viewBox="0 0 60 90">
                        <circle cx="30" cy="12" r="10" fill="none" stroke="#ffb6c1" stroke-width="2" stroke-dasharray="4 3"/>
                        <line x1="30" y1="22" x2="30" y2="55" stroke="#ffb6c1" stroke-width="2" stroke-dasharray="4 3"/>
                        <path d="M30 30 Q15 35 10 45" fill="none" stroke="#ffb6c1" stroke-width="2" stroke-dasharray="4 3"/>
                        <path d="M30 30 Q45 35 50 45" fill="none" stroke="#ffb6c1" stroke-width="2" stroke-dasharray="4 3"/>
                        <path d="M30 55 Q20 70 15 85" fill="none" stroke="#ffb6c1" stroke-width="2" stroke-dasharray="4 3"/>
                        <path d="M30 55 Q40 70 45 85" fill="none" stroke="#ffb6c1" stroke-width="2" stroke-dasharray="4 3"/>
                    </svg>
                `;
                
                showBodyManagerToast('已恢复默认形象');
            } catch (error) {
                console.error('删除图片失败:', error);
                showBodyManagerToast('删除失败，请重试');
            }
        }

        // 加载保存的NPC图片
        async function loadNPCImages() {
            try {
                const husbandImage = await getNPCImage('husband');
                const wifeImage = await getNPCImage('wife');
                
                if (husbandImage) updateNPCImage('husband', husbandImage);
                if (wifeImage) updateNPCImage('wife', wifeImage);
            } catch (error) {
                console.error('加载NPC图片失败:', error);
            }
        }

        // ==================== 黑板点击功能 ====================
        
        // 点击黑板进入追踪页面
        window.openTrackerFromBlackboard = function() {
            if (currentFastingPlan) {
                openFastingTracker(currentFastingPlan);
            } else {
                openPlanSelection();
            }
        };

        // 处理计划按钮点击
        window.handlePlanButtonClick = function() {
            if (!currentFastingPlan) {
                // 没有选择计划，打开选择页面
                openPlanSelection();
            } else if (isFasting) {
                // 正在断食，提前结束断食
                toggleFastingState();
            } else {
                // 正在饮食，提前开始断食
                toggleFastingState();
            }
        };

        // 更新计划按钮显示
        function updatePlanButton() {
            const btn = document.getElementById('selectPlanBtn');
            const btnText = document.getElementById('planBtnText');
            
            if (!currentFastingPlan) {
                btnText.textContent = '选择计划';
                btn.classList.remove('fasting');
            } else if (isFasting) {
                btnText.textContent = '提前进食';
                btn.classList.add('fasting');
            } else {
                btnText.textContent = '提前断食';
                btn.classList.remove('fasting');
            }
        }

        // 加载保存的黑板文字（仅默认文字）
        function loadBlackboardText() {
            // 检查 currentFastingPlan 是否已定义
            if (typeof currentFastingPlan === 'undefined' || !currentFastingPlan) {
                const line1 = localStorage.getItem('bodyManager_text_line1');
                const line2 = localStorage.getItem('bodyManager_text_line2');
                
                // 只加载非计时器的文字（不包含冒号的）
                if (line1 && !line1.includes(':')) {
                    document.getElementById('chalkLine1').textContent = line1;
                }
                if (line2 && !line2.includes(':')) {
                    document.getElementById('chalkLine2').textContent = line2;
                }
            }
        }

        // 加载保存的角色选择
        async function loadSelectedCharacter() {
            const charData = await localforage.getItem('bodyManager_selected_char');
            if (!charData) return;
            
            try {
                // 更新气泡文字
                const bubble = document.querySelector('#husbandBubble .bubble-content');
                if (bubble && charData.name) {
                    bubble.textContent = `${charData.name}，今天要一起运动吗？`;
                }
                
                // 从 IndexedDB 加载头像
                const avatar = await getNPCImage('husband');
                if (avatar) {
                    updateNPCImage('husband', avatar);
                }
            } catch (error) {
                console.error('加载选择的角色失败:', error);
            }
        }

        // 页面加载时调用（延迟执行，确保变量已定义）
        setTimeout(() => {
            loadBlackboardText();
            loadSelectedCharacter();
        }, 100);
    </script>

