                const isGemini3 = modelLower.includes('gemini-3') || modelLower.includes('gemini3') || 
                                  (modelLower.includes('gemini') && (modelLower.includes('3.') || modelLower.includes('-3')));
                if (isGemini3) {
                    console.log('【Gemini3优化】检测到Gemini 3/3.5模型，使用简化systemPrompt');
                    finalSystemPrompt = `你是用户的AI恋人。当前时间：${currentTime}。

【格式标签】[QUOTE]引用[/QUOTE] [心声]内心想法[/心声] [CALL]电话[/CALL] [VOICE]语音[/VOICE] [STICKER]表情[/STICKER] ====分隔多条

【工具调用】需要时调用工具，系统会自动处理格式。

【可用工具】
心声：saveInnerThought({"thought": "内容"})
备忘录：manage_super_memo({"category": "house_rule|today_memo|violation", "action": "add|delete|list", "content": "内容"})
健康：getHealthData()
足迹：getFootprints() | addFootprint({"name": "地点", "date": "日期", "description": "描述"})
纪念日：getAnniversaries() | addAnniversary({"title": "标题", "date": "日期"})
倒计时：getCountdowns() | addCountdown({"title": "标题", "targetDate": "目标日期"})
朋友圈：getMoments() | likeMoment({"momentId": ID}) | commentMoment({"momentId": ID, "content": "评论"}) | postMoment({"content": "内容"})
表情包：getAvailableStickers() | sendSticker({"index": 0})
恶魔挑战：createDemonQuiz({"questions": [{"question": "问题", "options": ["A","B","C"], "correctAnswer": "A"}]})
天使问答：createAngelQuiz({"questions": ["问题1", "问题2"]})
音乐：controlMusic({"action": "play|pause|next"})
小黑屋：startFocusMode({"seconds": 秒数, "reason": "原因"}) | releaseFromBlackRoom({"reason": "原因"})

【足迹】${footprintInfo}

【健康】${healthSummary ? healthSummary : '暂无'}

【重要】已删除工具（不要使用）：getDiaries, view_friend_diary, leave_sticky_note, addDiary

【规则】标签大写，需要时调用工具，回复自由真实。`;
                    console.log('【Gemini3优化】简化后systemPrompt长度:', finalSystemPrompt.length);
                } else if (modelLower.includes('gemini')) {
                    console.log('【Gemini】检测到其他Gemini模型，使用完整systemPrompt');
                }

                // 检查消息是否包含恶魔挑战或天使问答相关内容
                const hasDemonQuiz = userMessage.includes('[恶魔挑战') || userMessage.includes('默契问答') || userMessage.includes('终极选择');
                const hasAngelQuiz = userMessage.includes('[天使问答') || userMessage.includes('开放问答');
                const hasQuiz = hasDemonQuiz || hasAngelQuiz;
                
                // 构建消息数组
                // userMessage 已经包含了完整的人设、世界书、长期记忆等内容
                // systemPrompt 只包含基础系统指令
                let messages = [
                    { role: 'system', content: finalSystemPrompt },
                    { role: 'user', content: userMessage }
                ];
                
                // 如果有图片，将图片添加到 user 消息中
                if (imageData) {
                    console.log('【图片】添加图片到API请求，图片数据长度:', imageData.length);
                    console.log('【图片】图片数据前50字符:', imageData.substring(0, 50));
                    messages[1].content = [
                        { type: 'text', text: userMessage },
                        { type: 'image_url', image_url: { url: imageData } }
                    ];
                }
                
                console.log('【API请求】systemPrompt长度:', systemPrompt.length);
                console.log('【API请求】finalSystemPrompt长度:', finalSystemPrompt.length);
                console.log('【API请求】userMessage长度:', userMessage.length);
                console.log('【API请求】messages数量:', messages.length);
                
                // 检查当前聊天对象是否为指定监护人
                const guardianId = await loadMemoDataUnified('memo_guardian_id');
                const isGuardian = guardianId && currentChatId && guardianId.toString() === currentChatId.toString();

                // 构建工具列表 - 如果有自定义工具列表，优先使用
                let toolsList;
                if (customTools && Array.isArray(customTools) && customTools.length > 0) {
                    toolsList = [...customTools];
                    console.log('【AI工具】使用自定义工具列表:', customTools.map(t => t.function?.name || t.name));
                } else {
                    toolsList = hasQuiz ? [...TOOLS_DEFINITION, ...DEMON_QUIZ_TOOLS] : [...TOOLS_DEFINITION];
                }

                // 只有指定监护人才添加超级备忘录管理工具
                if (isGuardian) {
                    toolsList.push({
                        "type": "function",
                        "function": {
                            "name": "manage_super_memo",
                            "description": "管理备忘录内容，包括家规、今日备忘和违规记录。只有被指定的监护人才可以使用此工具。可以添加、删除家规和今日备忘，记录和删除违规记录。",
                            "parameters": {
                                "type": "object",
                                "properties": {
                                    "category": {
                                        "type": "string",
                                        "enum": ["house_rule", "today_memo", "violation"],
                                        "description": "操作类别：house_rule(家规)、today_memo(今日备忘)、violation(违规记录)"
                                    },
                                    "action": {
                                        "type": "string",
                                        "enum": ["add", "delete", "list"],
                                        "description": "操作类型：add(添加)、delete(删除)、list(查看列表)"
                                    },
                                    "content": {
                                        "type": "string",
                                        "description": "添加时的内容，删除时的ID或关键词"
                                    },
                                    "id": {
                                        "type": "number",
                                        "description": "删除时的项目ID（可选）"
                                    }
                                },
                                "required": ["category", "action"]
                            }
                        }
                    });
                    console.log('【AI工具】指定监护人 detected，添加 manage_super_memo 工具');
                }

                // 获取温度设置（默认0.7）
                const apiTemperature = savedSettings.api?.temperature ?? 0.7;

                // 构建请求体，包含工具定义
                const requestBody = {
                    model: model,
                    messages: messages,
                    tools: toolsList,
                    tool_choice: 'auto',
                    temperature: apiTemperature
                };

                // 发送API请求
                console.log('📤 发送API请求:', JSON.stringify(requestBody, null, 2));
                
                // 【修复】添加超时处理，防止请求卡住
                const controller = new AbortController();
                const timeoutId = setTimeout(() => controller.abort(), 300000); // 【修改】300秒超时
                
                let response;
                try {
                    response = await fetch(`${baseUrl}/chat/completions`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'Authorization': `Bearer ${apiKey}`
                        },
                        body: JSON.stringify(requestBody),
                        signal: controller.signal
                    });
                } catch (fetchError) {
                    clearTimeout(timeoutId);
                    // 【修复】处理 AbortController 超时错误
                    if (fetchError.name === 'AbortError' || fetchError.message?.includes('aborted')) {
                        throw new Error('请求超时：AI 响应时间超过300秒，请稍后重试');
                    }
                    throw fetchError;
                }
                
                clearTimeout(timeoutId); // 请求成功，清除超时

                if (!response.ok) {
                    const errorText = await response.text();
                    console.error('❌ API请求失败:', response.status, response.statusText);
                    console.error('❌ 错误详情:', errorText);
                    throw new Error(`API请求失败: ${response.status} ${response.statusText} - ${errorText}`);
                }

                // 【修复】获取响应文本并检查是否为JSON格式
                const responseText = await response.text();
                let data;
                try {
                    data = JSON.parse(responseText);
                } catch (parseError) {
                    console.error('❌ API返回的不是JSON格式:', responseText.substring(0, 500));
                    // 检查是否是HTML错误页面
                    if (responseText.trim().startsWith('<')) {
                        // 尝试提取HTML中的错误信息
                        const htmlError = extractHtmlErrorMessage(responseText);
                        if (htmlError) {
                            throw new Error(`API错误: ${htmlError}，请检查API配置或稍后重试`);
                        }
                        throw new Error('API返回了HTML页面而不是JSON，可能是API配置错误或网络问题');
                    }
                    throw new Error(`JSON解析失败: ${parseError.message}`);
                }
                
                // 检查 API 响应是否有效
                if (!data.choices || !data.choices[0] || !data.choices[0].message) {
                    console.error('❌ API 返回无效响应:', JSON.stringify(data, null, 2));
                    return { reply: 'API 返回了无效的响应格式，请检查 API 配置', thought: '' };
                }
                
                let message = data.choices[0].message;

                console.log('========== 心声系统调试 ==========');
                console.log('API原始响应:', JSON.stringify(data, null, 2));
                console.log('message对象:', message);
                console.log('消息内容:', message.content);
                console.log('消息内容类型:', typeof message.content);
                console.log('消息内容长度:', message.content ? message.content.length : 0);
                console.log('是否有tool_calls:', message.tool_calls ? '有' : '无');
                console.log('tool_calls内容:', message.tool_calls);
                console.log('finish_reason:', data.choices[0].finish_reason);
                console.log('================================');

                // 【Gemini修复】检测并修复错误的工具调用格式
                if (message.content && typeof message.content === 'string') {
                    const content = message.content;

                    // 检测 [T00L_CALL] 或 [TOOL_CALL] 格式
                    const toolCallRegex = /\[T00L_CALL\]|\[TOOL_CALL\]/i;
                    if (toolCallRegex.test(content)) {
                        console.log('【Gemini修复】检测到错误的工具调用格式，尝试解析...');

                        // 尝试提取工具调用信息
                        const toolNameMatch = content.match(/tool_name:\s*(\w+)/i);
                        const argsMatch = content.match(/tool_args:\s*({[\s\S]*?})|(\w+):\s*(.+)/i);

                        if (toolNameMatch) {
                            const toolName = toolNameMatch[1];
                            let toolArgs = {};

                            if (argsMatch) {
                                try {
                                    // 尝试解析参数
                                    if (argsMatch[1]) {
                                        toolArgs = JSON.parse(argsMatch[1]);
                                    } else {
                                        // 简单键值对格式
                                        const key = argsMatch[2];
                                        const value = argsMatch[3];
                                        toolArgs[key] = value;
                                    }
                                } catch (e) {
                                    console.warn('【Gemini修复】解析参数失败:', e);
                                }
                            }

                            // 构建正确的 tool_calls 格式
                            message.tool_calls = [{
                                id: 'gemini_fix_' + Date.now(),
                                type: 'function',
                                function: {
                                    name: toolName,
                                    arguments: JSON.stringify(toolArgs)
                                }
                            }];

                            // 清理 content 中的工具调用标记
                            message.content = content.replace(/\[T00L_CALL\][\s\S]*?_end_tool_call/i, '').trim();

                            console.log('【Gemini修复】修复后的 tool_calls:', message.tool_calls);
                            console.log('【Gemini修复】修复后的 content:', message.content);
                        }
                    }
                    
                    // 【新增】检测并修复 tool_calls JSON 格式错误（引号未转义）
                    // 错误："arguments": "{"thought": "内容"}"
                    // 正确："arguments": "{\"thought\": \"内容\"}"
                    if (content.includes('"tool_calls"') || content.includes("'tool_calls'")) {
                        console.log('【Gemini修复】检测到 tool_calls JSON，尝试修复格式...');
                        console.log('【Gemini修复】原始content:', content.substring(0, 500));
                        
                        // 【修复】尝试提取tool_calls部分，保留其他内容
                        const toolCallsMatch = content.match(/\{[\s\S]*?"tool_calls"[\s\S]*?\}\s*\}/);
                        if (toolCallsMatch) {
                            const toolCallsJson = toolCallsMatch[0];
                            console.log('【Gemini修复】提取的tool_calls JSON:', toolCallsJson.substring(0, 500));
                            
                            const fixedContent = fixToolCallsFormat(toolCallsJson);
                            if (fixedContent !== toolCallsJson) {
                                try {
                                    const parsed = JSON.parse(fixedContent);
                                    if (parsed.tool_calls && parsed.tool_calls.length > 0) {
                                        message.tool_calls = parsed.tool_calls;
                                        // 【修复】只移除tool_calls JSON部分，保留其他文本内容
                                        message.content = content.replace(toolCallsJson, '').trim();
                                        // 清理可能留下的多余空行和分隔符
                                        message.content = message.content.replace(/\n{3,}/g, '\n\n').trim();
                                        console.log('【Gemini修复】修复后的 tool_calls:', message.tool_calls);
                                        console.log('【Gemini修复】清理后的content:', message.content.substring(0, 200));
                                    }
                                } catch (e) {
                                    console.warn('【Gemini修复】修复 tool_calls 格式失败:', e);
                                    // 【新增】尝试终极修复
                                    console.log('【Gemini修复】尝试终极修复...');
                                    const extractedToolCalls = extractToolCallsFromMessyContent(toolCallsJson);
                                    if (extractedToolCalls && extractedToolCalls.length > 0) {
                                        message.tool_calls = extractedToolCalls;
                                        message.content = content.replace(toolCallsJson, '').trim();
                                        message.content = message.content.replace(/\n{3,}/g, '\n\n').trim();
                                        console.log('【Gemini修复】终极修复成功:', message.tool_calls);
                                    }
                                }
                            } else {
                                // 【新增】如果fixToolCallsFormat没有变化，也尝试终极修复
                                console.log('【Gemini修复】标准修复未生效，尝试终极修复...');
                                const extractedToolCalls = extractToolCallsFromMessyContent(toolCallsJson);
                                if (extractedToolCalls && extractedToolCalls.length > 0) {
                                    message.tool_calls = extractedToolCalls;
                                    message.content = content.replace(toolCallsJson, '').trim();
                                    message.content = message.content.replace(/\n{3,}/g, '\n\n').trim();
                                    console.log('【Gemini修复】终极修复成功:', message.tool_calls);
                                }
                            }
                        }
                    }
                }

                // 检查 message.content 是否为空
                if (!message.content && !message.tool_calls) {
                    console.warn('⚠️ API 返回了空内容且没有工具调用');
                    return { reply: 'AI 没有返回任何内容，请重试', thought: '' };
                }

                // 【新增】记录执行的工具调用，用于后续显示操作提示
                const executedTools = [];
                
                // 处理工具调用
                if (message.tool_calls && message.tool_calls.length > 0) {
                    console.log('🛠️ AI触发了Tool调用:', message.tool_calls);
                    
                    // 在已有的 messages 基础上添加 assistant 的 tool_calls 消息
                    // 注意：assistant 消息如果有 tool_calls，content 必须为 null
                    messages.push({
                        role: 'assistant',
                        content: message.content || null,
                        tool_calls: message.tool_calls
                    });
                    
                    // 处理每个工具调用
                    for (const toolCall of message.tool_calls) {
                        const functionName = toolCall.function.name;
                        
                        // 【修复】添加try-catch保护arguments解析
                        let functionArgs;
                        try {
                            functionArgs = JSON.parse(toolCall.function.arguments);
                        } catch (parseError) {
                            console.error('❌ 解析工具参数失败:', parseError);
                            console.error('❌ 原始参数:', toolCall.function.arguments);
                            // 尝试修复格式
                            try {
                                const fixedArgs = fixToolCallsFormat(`{"arguments": "${toolCall.function.arguments}"}`);
                                const parsed = JSON.parse(fixedArgs);
                                functionArgs = JSON.parse(parsed.arguments);
                                console.log('✅ 修复后参数:', functionArgs);
                            } catch (fixError) {
                                console.error('❌ 无法修复参数，跳过此工具调用:', fixError);
                                continue; // 跳过这个工具调用，继续下一个
                            }
                        }
                        
                        console.log(`🛠️ 执行函数: ${functionName}, 参数:`, functionArgs);

                        // 执行本地函数
                        let toolResult;
                        switch (functionName) {
                            case 'getMoments':
                                toolResult = await getMoments(functionArgs);
                                break;
                            case 'getAvailableStickers':
                                toolResult = await getAvailableStickers();
                                break;
                            case 'sendSticker':
                                toolResult = await sendStickerByAI(functionArgs);
                                break;
                            case 'getLatestFootprint':
                                toolResult = await getLatestFootprint();
                                break;
                            case 'getFootprintHistory':
                                toolResult = await getFootprintHistory(functionArgs);
                                break;
                            case 'getFootprintsByDate':
                                toolResult = await getFootprintsByDate(functionArgs);
                                break;
                            case 'manageAccounting':
                                toolResult = await manageAccountingTool(functionArgs);
                                break;
                            case 'getHealthData':
                                if (functionArgs.detail === 'summary') {
                                    toolResult = await getHealthSummaryForAI();
                                } else {
                                    toolResult = await getHealthDataForAI();
                                }
                                break;
                            case 'submitDemonQuizAnswer':
                                toolResult = await submitDemonQuizAnswer(functionArgs);
                                break;
                            case 'getDemonQuizResult':
                                toolResult = await getDemonQuizResult();
                                break;
                            case 'createDemonQuiz':
                                toolResult = await createDemonQuiz(functionArgs);
                                break;
                            case 'submitUserDemonQuizAnswer':
                                toolResult = await submitUserDemonQuizAnswer(functionArgs);
                                break;
                            case 'createAngelQuiz':
                                toolResult = await createAngelQuiz(functionArgs);
                                break;
                            case 'submitAngelQuizAnswer':
                                toolResult = await submitAngelQuizAnswer(functionArgs);
                                break;
                            case 'getAngelQuizList':
                                toolResult = await getAngelQuizList(functionArgs);
                                break;
                            case 'getAngelQuizDetail':
                                toolResult = await getAngelQuizDetail(functionArgs);
                                break;
                            case 'postWeibo':
                                // 发微博工具
                                console.log('【微博AI】处理 postWeibo 工具调用');
                                toolResult = await postWeiboTool(functionArgs);
                                break;
                            case 'getWeiboHotSearch':
                                // 微博热搜工具
                                console.log('【微博AI】处理 getWeiboHotSearch 工具调用');
                                toolResult = await getWeiboHotSearchTool();
                                break;
                            case 'startFocusMode':
                                toolResult = await startFocusModeTool(functionArgs);
                                break;
                            case 'releaseFromBlackRoom':
                                toolResult = await releaseFromBlackRoomTool(functionArgs);
                                break;
                            case 'extendBlackRoomTime':
                                toolResult = await extendBlackRoomTimeTool(functionArgs);
                                break;
                            case 'getBlackRoomStatus':
                                toolResult = await getBlackRoomStatusTool(functionArgs);
                                break;
                            case 'manage_super_memo':
                                toolResult = await manageSuperMemoTool(functionArgs);
                                break;
                            case 'updateProfile':
                                toolResult = await updateAIProfile(functionArgs, chatItem.id);
                                break;
                            default:
                                console.error('未知函数:', functionName);
                                continue;
                        }
                        console.log(`✅ 函数执行结果:`, toolResult);
                        
                        // 【新增】记录执行的工具（无论成功与否都记录，避免空回复问题）
                        executedTools.push({
                            name: functionName,
                            result: toolResult || { success: true }
                        });

                        // 添加工具结果到消息历史
                        messages.push({
                            role: 'tool',
                            tool_call_id: toolCall.id,
                            content: JSON.stringify(toolResult)
                        });
                    }

                    // 发送所有工具结果给AI，获取最终回复（支持多轮工具调用）
                    let currentRound = 1;
                    let finalReply = null;
                    
                    while (currentRound <= maxToolRounds) {
                        console.log(`🔄 工具调用第 ${currentRound}/${maxToolRounds} 轮`);
                        
                        // 【新增】如果启用副API，使用副API进行工具调用
                        const useSecondaryApi = secondaryApiEnabled && secondaryApiKey;
                        const actualBaseUrl = useSecondaryApi ? secondaryBaseUrl : baseUrl;
                        const actualApiKey = useSecondaryApi ? secondaryApiKey : apiKey;
                        const actualModel = useSecondaryApi ? secondaryModel : model;
                        
                        if (useSecondaryApi) {
                            console.log('【副API】使用副API进行工具调用:', actualModel);
                        }

                        // 【修复】添加超时处理，防止请求卡住
                        const controller = new AbortController();
                        const timeoutId = setTimeout(() => controller.abort(), 300000); // 【修改】300秒超时

                        let toolResponse;
                        try {
                            toolResponse = await fetch(`${actualBaseUrl}/chat/completions`, {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/json',
                                    'Authorization': `Bearer ${actualApiKey}`
                                },
                                body: JSON.stringify({
                                    model: actualModel,
                                    messages: messages,
                                    tools: hasQuiz ? [...TOOLS_DEFINITION, ...DEMON_QUIZ_TOOLS] : TOOLS_DEFINITION,
                                    tool_choice: 'auto',
                                    temperature: apiTemperature
                                }),
                                signal: controller.signal
                            });
                        } catch (fetchError) {
                            clearTimeout(timeoutId);
                            // 【修复】处理 AbortController 超时错误
                            if (fetchError.name === 'AbortError' || fetchError.message?.includes('aborted')) {
                                throw new Error('请求超时：AI 工具调用响应时间超过300秒，请稍后重试');
                            }
                            throw fetchError;
                        }

                        clearTimeout(timeoutId); // 请求成功，清除超时

                        if (!toolResponse.ok) {
                            throw new Error(`工具响应失败: ${toolResponse.statusText}`);
                        }

                        // 【修复】获取响应文本并检查是否为JSON格式
                        const toolResponseText = await toolResponse.text();
                        let toolData;
                        try {
                            toolData = JSON.parse(toolResponseText);
                        } catch (parseError) {
                            console.error('❌ 工具调用API返回的不是JSON格式:', toolResponseText.substring(0, 500));
                            if (toolResponseText.trim().startsWith('<')) {
                                const htmlError = extractHtmlErrorMessage(toolResponseText);
                                if (htmlError) {
                                    throw new Error(`API错误: ${htmlError}，请检查API配置或稍后重试`);
                                }
                                throw new Error('API返回了HTML页面而不是JSON，可能是API配置错误或网络问题');
                            }
                            throw new Error(`JSON解析失败: ${parseError.message}`);
                        }
                        const toolMessage = toolData.choices[0].message;
                        const toolMessageContent = toolMessage.content;
                        
                        console.log(`📨 第 ${currentRound} 轮AI响应:`, toolMessageContent);
                        
                        // 检查是否还有更多工具调用
                        if (toolMessage.tool_calls && toolMessage.tool_calls.length > 0) {
                            if (currentRound >= maxToolRounds) {
                                console.log(`⚠️ 已达到最大工具调用轮数(${maxToolRounds})，停止继续调用`);
                                finalReply = toolMessageContent || '';
                                break;
                            }
                            
                            console.log(`🛠️ 第 ${currentRound} 轮AI再次触发工具调用，继续处理...`);
                            
                            // 添加assistant消息到历史
                            messages.push({
                                role: 'assistant',
                                content: toolMessage.content || null,
                                tool_calls: toolMessage.tool_calls
                            });
                            
                            // 处理新一轮的工具调用
                            for (const toolCall of toolMessage.tool_calls) {
                                const functionName = toolCall.function.name;
                                
                                // 【修复】添加try-catch保护arguments解析
                                let functionArgs;
                                try {
                                    functionArgs = JSON.parse(toolCall.function.arguments);
                                } catch (parseError) {
                                    console.error('❌ 第二轮解析工具参数失败:', parseError);
                                    console.error('❌ 原始参数:', toolCall.function.arguments);
                                    // 尝试修复格式
                                    try {
                                        const fixedArgs = fixToolCallsFormat(`{"arguments": "${toolCall.function.arguments}"}`);
                                        const parsed = JSON.parse(fixedArgs);
                                        functionArgs = JSON.parse(parsed.arguments);
                                        console.log('✅ 第二轮修复后参数:', functionArgs);
                                    } catch (fixError) {
                                        console.error('❌ 第二轮无法修复参数，跳过此工具调用:', fixError);
                                        continue; // 跳过这个工具调用，继续下一个
                                    }
                                }
                                
                                console.log(`🛠️ 执行函数: ${functionName}, 参数:`, functionArgs);

                                let toolResult;
                                switch (functionName) {
                                    case 'getMoments':
                                        toolResult = await getMoments(functionArgs);
                                        break;
                                    case 'getAvailableStickers':
                                        toolResult = await getAvailableStickers();
                                        break;
