                                    admin: '',
                                    body: '',
                                    postoffice: '',
                                    games: '',
                                    weibo: '',
                                    ball: '',
                                    library: '',
                                    luckgate: ''
                                }
                            };
                        }
                        if (!relationshipData.characterRelationships) {
                            relationshipData.characterRelationships = {};
                        }
                        
                        // 确保characterRelationships中的startDate也是Date对象
                        if (relationshipData.characterRelationships) {
                            for (const key in relationshipData.characterRelationships) {
                                const relation = relationshipData.characterRelationships[key];
                                if (relation && relation.startDate) {
                                    if (typeof relation.startDate === 'string') {
                                        relation.startDate = new Date(relation.startDate);
                                    } else if (typeof relation.startDate === 'number') {
                                        relation.startDate = new Date(relation.startDate);
                                    }
                                }
                            }
                        }
                        
                        // 【修复】确保新增字段有默认值，避免undefined
                        if (relationshipData.description === undefined) relationshipData.description = '';
                        if (relationshipData.polaroidImage === undefined) relationshipData.polaroidImage = null;
                        if (relationshipData.polaroidText === undefined) relationshipData.polaroidText = '';
                        if (relationshipData.polaroidRotation === undefined) relationshipData.polaroidRotation = null;
                        // 确保卡片背景设置存在
                        if (relationshipData.coupleCardBackground === undefined) relationshipData.coupleCardBackground = '';
                        if (relationshipData.coupleCardHeaderBg === undefined) relationshipData.coupleCardHeaderBg = '';
                        if (relationshipData.coupleCardHeaderStroke === undefined) relationshipData.coupleCardHeaderStroke = '';
                        if (relationshipData.coupleCardFooterBg === undefined) relationshipData.coupleCardFooterBg = '';

                        await saveData();
                        console.log('基本数据导入完成，characterRelationships:', relationshipData.characterRelationships);
                    } else {
                        // 【导入错误处理】没有找到 relationshipData
                        console.error('【导入错误】文件中没有找到 relationshipData 字段');
                        console.error('【导入错误】文件中的字段:', Object.keys(data));
                        
                        // 检查是否是直接导出的 relationshipData（旧格式）
                        if (data.wechatChatList || data.chatMessages || data.startDate || data.name1 || data.name2) {
                            console.log('【导入】检测到旧格式数据，尝试自动转换...');
                            
                            // 【自动转换】将旧格式转换为新格式
                            try {
                                loadingToast.textContent = '检测到旧格式数据，正在自动转换...';
                                
                                // 定义 relationshipData 应该包含的字段
                                const relationshipDataFields = [
                                    'startDate', 'anniversaryName', 'name1', 'name2', 'avatar1', 'avatar2',
                                    'cardBg', 'topCardBg', 'dynamicImage', 'leftBubbleAvatar', 'rightBubbleAvatar',
                                    'mainBg', 'description', 'polaroidText', 'polaroidRotation', 'polaroidImage',
                                    'characterRelationships', 'chatMessages', 'wechatChatList', 'worldBooks',
                                    'studyRooms', 'diaryEntries', 'accountingData', 'footprintData',
                                    'coupleCardBackground', 'coupleCardHeaderBg', 'coupleCardHeaderStroke',
                                    'coupleCardFooterBg', 'theme', 'lastNoteContent', 'lastNoteTimestamp',
                                    'customPageContent', 'customPageTimestamp', 'customPageTitle', 'mood'
                                ];
                                
                                // 分离 relationshipData 字段和其他字段
                                const relationshipDataContent = {};
                                const otherFields = {};
                                
                                for (const key of Object.keys(data)) {
                                    if (relationshipDataFields.includes(key)) {
                                        relationshipDataContent[key] = data[key];
                                    } else {
                                        otherFields[key] = data[key];
                                    }
                                }
                                
                                // 构建新格式数据
                                data = {
                                    relationshipData: relationshipDataContent,
                                    timestamp: data.timestamp || Date.now(),
                                    _exportInfo: {
                                        convertedFromOldFormat: true,
                                        convertedAt: new Date().toISOString()
                                    }
                                };
                                
                                // 保留其他可能的字段（如 settings, presets 等）
                                for (const [key, value] of Object.entries(otherFields)) {
                                    if (!data[key]) {
                                        data[key] = value;
                                    }
                                }
                                
                                console.log('【导入】旧格式数据转换成功');
                                showToast('已自动转换旧格式数据', 'success');
                                
                                // 继续导入流程（使用转换后的数据）
                                // 重新检查 relationshipData 是否存在
                                if (!data.relationshipData) {
                                    throw new Error('转换后仍然没有 relationshipData');
                                }
                                
                                // 将转换后的数据赋值给 relationshipData 变量（用于后续导入）
                                relationshipData = data.relationshipData;
                                
                                // 确保基本字段存在
                                if (!relationshipData.wechatChatList) relationshipData.wechatChatList = [];
                                if (!relationshipData.worldBooks) relationshipData.worldBooks = [];
                                if (!relationshipData.studyRooms) relationshipData.studyRooms = [];
                                if (!relationshipData.diaryEntries) relationshipData.diaryEntries = [];
                                if (!relationshipData.accountingData) relationshipData.accountingData = { transactions: [], budgets: [] };
                                if (!relationshipData.footprintData) relationshipData.footprintData = { records: [] };
                                if (!relationshipData.characterRelationships) relationshipData.characterRelationships = {};
                                if (!relationshipData.theme) {
                                    relationshipData.theme = {
                                        mainBg: '',
                                        appIcons: {}
                                    };
                                }
                                
                                // 确保新增字段有默认值
                                if (relationshipData.description === undefined) relationshipData.description = '';
                                if (relationshipData.polaroidImage === undefined) relationshipData.polaroidImage = null;
                                if (relationshipData.polaroidText === undefined) relationshipData.polaroidText = '';
                                if (relationshipData.polaroidRotation === undefined) relationshipData.polaroidRotation = null;
                                if (relationshipData.coupleCardBackground === undefined) relationshipData.coupleCardBackground = '';
                                if (relationshipData.coupleCardHeaderBg === undefined) relationshipData.coupleCardHeaderBg = '';
                                if (relationshipData.coupleCardHeaderStroke === undefined) relationshipData.coupleCardHeaderStroke = '';
                                if (relationshipData.coupleCardFooterBg === undefined) relationshipData.coupleCardFooterBg = '';
                                
                                await saveData();
                                console.log('【导入】旧格式数据的基本数据导入完成');
                                
                            } catch (convertError) {
                                console.error('【导入】旧格式转换失败:', convertError);
                                alert('文件格式错误：这似乎是旧格式的数据文件（直接包含 relationshipData 内容）。\n\n自动转换失败: ' + convertError.message + '\n\n请使用最新版本导出的完整备份文件，或者尝试使用"导入回忆备份"功能。');
                                document.body.removeChild(loadingToast);
                                return;
                            }
                        } else {
                            alert('文件格式错误：无法识别备份文件格式。\n\n请确保使用的是本应用导出的 .json 备份文件。\n\n文件中的字段: ' + Object.keys(data).join(', '));
                            document.body.removeChild(loadingToast);
                            return;
                        }
                    }
                    
                    loadingToast.textContent = '正在导入设置...';
                    
                    if (data.settings) {
                        await saveAppSettings(data.settings);
                        if (typeof loadSettings === 'function') {
                            await loadSettings();
                        }
                        console.log('设置导入完成');
                    }
                    
                    if (data.presets) {
                        await saveApiSettingUnified('apiPresets', data.presets);
                        if (typeof updatePresetSelect === 'function') {
                            await updatePresetSelect();
                        }
                        console.log('预设导入完成');
                    }
                    
                    if (data.models) {
                        await saveApiSettingUnified('apiModels', data.models);
                        console.log('模型列表导入完成');
                    }
                    
                    // 【防闪退】分批导入其他独立存储的数据
                    if (data.otherData) {
                        loadingToast.textContent = '正在导入其他数据...';
                        console.log('开始导入其他数据...');
                        
                        // 【修复】导入角色日记数据
                        if (data.otherData.diaryData) {
                            await saveDiaryDataUnified(data.otherData.diaryData);
                            console.log('角色日记数据导入完成');
                        }
                        await new Promise(resolve => setTimeout(resolve, 0));
                        
                        if (data.otherData.diaryCoverSettings) {
                            await saveDiaryCoverSettingsUnified(data.otherData.diaryCoverSettings);
                            console.log('日记封面设置导入完成');
                        }
                        await new Promise(resolve => setTimeout(resolve, 0));
                        
                        // 【修复】导入"我的日记"数据
                        if (data.otherData.myDiaryData) {
                            await saveMyDiaryContentsUnified(data.otherData.myDiaryData);
                            // 同时更新内存中的数据
                            window.myDiaryStorage = data.otherData.myDiaryData;
                            console.log('我的日记数据导入完成，条目数:', Object.keys(data.otherData.myDiaryData).length);
                        }
                        await new Promise(resolve => setTimeout(resolve, 0));
                        
                        // 【防闪退】分批导入备忘录数据（使用 SQLite 优先）
                        const memoKeys = [
                            'memo_houseRules', 'memo_bg', 'memo_bg_image', 'memo_media',
                            'memo_media_type', 'memo_violations', 'memo_todayMemos',
                            'memo_lastDate', 'memo_guardian', 'memo_guardian_id',
                            'memo_guardian_name', 'memo_guardian_avatar'
                        ];
                        for (const key of memoKeys) {
                            if (data.otherData[key] !== undefined) {
                                await saveMemoDataUnified(key, data.otherData[key]);
                                console.log(`${key} 导入完成`);
                            }
                        }
                        await new Promise(resolve => setTimeout(resolve, 0));
                        console.log('备忘录数据导入完成');
                        
                        // 【防闪退】分批导入健康数据（使用 SQLite 优先）
                        const healthKeys = ['periodData', 'waterData', 'sleepData', 'diseaseData'];
                        for (const key of healthKeys) {
                            if (data.otherData[key] !== undefined) {
                                await saveHealthDataUnified(key, data.otherData[key]);
                                console.log(`${key} 导入完成`);
                            }
                        }
                        await new Promise(resolve => setTimeout(resolve, 0));
                        console.log('健康数据导入完成');
                        
                        // 导入学习课桌数据
                        if (data.otherData.studyDeskData) {
                            await saveStudyDeskDataUnified(data.otherData.studyDeskData);
                            console.log('学习课桌数据导入完成');
                        }
                        await new Promise(resolve => setTimeout(resolve, 0));
                        
                        // 导入足迹数据
                        if (data.otherData.footprints) {
                            await saveMemoDataUnified('footprints', data.otherData.footprints);
                            console.log('足迹数据导入完成');
                        }
                        await new Promise(resolve => setTimeout(resolve, 0));

                        // 导入通话记录
                        if (data.otherData.callRecords) {
                            await SQLiteManager.saveCallRecordsForChat('default', data.otherData.callRecords);
                            console.log('通话记录导入完成');
                        }

                        // 导入个人资料
                        if (data.otherData.personalProfile) {
                            await SQLiteManager.savePersonalProfile(data.otherData.personalProfile);
                            console.log('个人资料导入完成');
                        }

                        // 导入本地服务器设置
                        if (data.otherData.useLocalServer !== undefined) {
                            await saveApiSettingUnified('useLocalServer', data.otherData.useLocalServer);
                            console.log('本地服务器设置导入完成');
                        }

                        // 导入恶魔测验数据
                        if (data.otherData.demonQuizzes) {
                            await saveDemonQuizzesUnified(data.otherData.demonQuizzes);
                            console.log('恶魔测验数据导入完成');
                        }
                        if (data.otherData.demonQuizData) {
                            await saveDemonQuizStateUnified('demonQuizData', data.otherData.demonQuizData);
                            console.log('恶魔测验状态导入完成');
                        }

                        console.log('其他数据导入完成');
                    }
                    
                    // 移除加载提示
                    document.body.removeChild(loadingToast);
                    
                    alert('数据导入成功！页面将在1秒后刷新。');
                    
                    // 重新加载页面以应用所有更改
                    setTimeout(() => {
                        location.reload();
                    }, 1000);
                    
                } catch (error) {
                    console.error('【防闪退】数据导入失败:', error);
                    alert('数据导入失败：' + (error.message || '未知错误'));
                    
                    // 【防闪退】确保移除加载提示
                    const loadingToast = document.querySelector('div[style*="z-index:99999"]');
                    if (loadingToast && loadingToast.parentNode) {
                        loadingToast.parentNode.removeChild(loadingToast);
                    }
                }
            };
            
            // 【防闪退】添加错误处理
            reader.onerror = function(e) {
                console.error('【防闪退】读取文件失败:', e);
                alert('读取文件失败，请重试');
                const loadingToast = document.querySelector('div[style*="z-index:99999"]');
                if (loadingToast && loadingToast.parentNode) {
                    loadingToast.parentNode.removeChild(loadingToast);
                }
            };
            
            reader.readAsText(file);
        }

        // 聊天功能相关
        let currentChatId = null;
        let currentChatAvatar = null;
        let currentIsGroupChat = false;
        let chatMessages = [];
        
        // 群成员操作相关变量
        let currentSelectedGroupMember = null;
        let currentGroupMemberAction = null;

        // 初始化聊天输入框事件
        let chatInputListenersAdded = false; // 防止重复添加监听器的标志
        let keyboardListeners = []; // 存储键盘监听器以便清理
        
        // 【性能优化】输入框节流控制
        let chatInputThrottleTimer = null;
        let chatInputLastValue = '';

        // 【修复】命名的事件处理函数，便于移除
        // 【关键修复】优化快速输入时的性能，防止闪退
        let chatInputRAFId = null;
        let chatInputLastProcessTime = 0;
        // 【性能优化】缓存 DOM 元素引用，避免每次输入都查询 DOM
        let cachedSendBtn = null;
        let cachedAddBtn = null;
        
        // 【关键修复】使用 requestAnimationFrame 节流，避免阻塞主线程
        function chatInputHandler() {
            try {
                const currentValue = this.value;

                // 【性能优化】如果值没有变化，直接返回
                if (currentValue === chatInputLastValue) {
                    return;
                }

                // 【鸿蒙系统兼容】检测是否为鸿蒙系统
                // 【鸿蒙系统兼容】使用统一检测函数
                const isHarmonyDevice = typeof checkIsHarmonyDevice === 'function' ? checkIsHarmonyDevice() : false;

                // 【关键修复】取消之前的 RAF，避免堆积
                if (chatInputRAFId) {
                    cancelAnimationFrame(chatInputRAFId);
                }

                // 【鸿蒙系统兼容】使用 setTimeout 替代 requestAnimationFrame
                const scheduleUpdate = isHarmonyDevice ?
                    (cb) => setTimeout(cb, 0) :
                    (cb) => requestAnimationFrame(cb);

                // 【关键修复】使用 RAF/setTimeout 延迟处理，避免每次输入都触发 DOM 操作
                chatInputRAFId = scheduleUpdate(() => {
                    chatInputRAFId = null;

                    // 【性能优化】只检查长度变化，避免创建新字符串
                    const hasContent = currentValue.length > 0;
                    const hadContent = chatInputLastValue.length > 0;

                    // 只有当内容状态发生变化时才更新 UI
                    if (hasContent === hadContent) {
                        chatInputLastValue = currentValue;
                        return;
                    }
                    chatInputLastValue = currentValue;

                    // 【性能优化】缓存 DOM 元素，避免重复查询
                    if (!cachedSendBtn || !cachedAddBtn) {
                        cachedSendBtn = document.getElementById('chatSendBtn');
                        cachedAddBtn = document.getElementById('chatAddBtn');
                    }

                    // 【性能优化】直接更新样式
                    if (cachedSendBtn && cachedAddBtn) {
                        if (hasContent) {
                            cachedSendBtn.style.display = 'flex';
                            cachedAddBtn.style.display = 'none';
                        } else {
                            cachedSendBtn.style.display = 'none';
                            cachedAddBtn.style.display = 'flex';
                        }
                    }
                });
            } catch (e) {
                console.warn('【防闪退】input事件处理失败:', e);
            }
        }
        
        // 【修复】命名的focus事件处理函数
        // 【性能优化】简化处理逻辑，避免卡顿
        function chatInputFocusHandler() {
            try {
                // 【鸿蒙系统兼容】使用统一检测函数
                const isHarmonyDevice = typeof checkIsHarmonyDevice === 'function' ? checkIsHarmonyDevice() : false;
                
                // 如果开启了打字无障碍功能，显示中央输入框并阻止默认行为
                if (accessibilityInputEnabled) {
                    const chatInput = document.getElementById('chatInput');
                    if (chatInput) {
                        chatInput.blur(); // 立即失焦，防止键盘弹出
                    }
                    showAccessibilityInput();
                    return;
                }

                // 【性能优化】关闭面板即可，不强制滚动
                // 滚动操作会导致重绘，可能引起卡顿
                closeChatPanels();
                
                // 【鸿蒙系统兼容】鸿蒙系统不执行额外操作，避免闪退
                if (isHarmonyDevice) {
                    console.log('【鸿蒙兼容】focus 事件简化处理');
                    return;
                }
                
                // 【可选】只在需要时滚动，使用延迟避免与键盘动画冲突
                // const chatContent = document.getElementById('chatContent');
                // if (chatContent) {
                //     setTimeout(() => {
                //         chatContent.scrollTop = chatContent.scrollHeight;
                //     }, 300);
                // }
            } catch (e) {
                console.warn('【防闪退】focus事件处理失败:', e);
            }
        }
        
        // 【新增】关闭聊天面板（表情面板和加号菜单）
        function closeChatPanels() {
            try {
                const stickerPanel = document.getElementById('stickerPanel');
                const chatAddMenu = document.getElementById('chatAddMenu');
                const chatContent = document.getElementById('chatContent');
                
                // 关闭表情面板
                if (stickerPanel && stickerPanel.classList.contains('show')) {
                    stickerPanel.classList.remove('show');
                    console.log('【交互优化】点击输入框，关闭表情面板');
                }
                
                // 关闭加号菜单
                if (chatAddMenu && chatAddMenu.classList.contains('show')) {
                    chatAddMenu.classList.remove('show');
                    // 重置工具栏到第一页
                    setTimeout(() => {
                        resetChatAddMenuPage();
                    }, 300);
                    console.log('【交互优化】点击输入框，关闭加号菜单');
                }
                
                // 移除 panel-open 类，恢复消息区域高度
                if (chatContent && chatContent.classList.contains('panel-open')) {
                    chatContent.classList.remove('panel-open');
                }
            } catch (e) {
                console.warn('【防闪退】关闭面板失败:', e);
            }
        }
        
        function initChatInput() {
            // 【防闪退】添加try-catch包裹
            try {
                const chatInput = document.getElementById('chatInput');
                const chatBottom = document.getElementById('mainChatBottom');
                if (chatInput && !chatInputListenersAdded) {
                    chatInputListenersAdded = true;
                    
                    // 【修复】先移除旧的事件监听器，避免重复
                    chatInput.removeEventListener('input', chatInputHandler);
                    chatInput.removeEventListener('focus', chatInputFocusHandler);
                    
                    // 【性能优化】使用节流的input事件处理
                    chatInput.addEventListener('input', chatInputHandler);

                    // 【修复】添加 focus 事件，确保点击输入框时滚动到底部
                    chatInput.addEventListener('focus', chatInputFocusHandler);

                    // 【ColorOS 修复】键盘监听器在 openChatInterface 中统一处理，避免重复监听
                }
            } catch (error) {
                console.error('【防闪退】initChatInput 发生错误:', error);
            }
        }
        
        // 【防闪退】清理聊天输入框事件监听器
        function cleanupChatInputListeners() {
            try {
                const chatInput = document.getElementById('chatInput');
                if (chatInput) {
                    // 【修复】移除命名的事件监听器
                    chatInput.removeEventListener('input', chatInputHandler);
                    chatInput.removeEventListener('focus', chatInputFocusHandler);
                }
                
                // 清理Keyboard插件监听器
                keyboardListeners.forEach(listener => {
                    try {
                        if (listener && typeof listener.remove === 'function') {
                            listener.remove();
                        }
                    } catch (e) {
                        console.warn('【防闪退】清理键盘监听器失败:', e);
                    }
                });
                keyboardListeners = [];
                chatInputListenersAdded = false;
                
                // 【修复】清理节流定时器
                if (chatInputThrottleTimer) {
                    clearTimeout(chatInputThrottleTimer);
                    chatInputThrottleTimer = null;
                }
                
                // 【性能优化】清理 requestAnimationFrame
                if (chatInputRAFId) {
                    cancelAnimationFrame(chatInputRAFId);
                    chatInputRAFId = null;
                }
            } catch (error) {
                console.error('【防闪退】cleanupChatInputListeners 发生错误:', error);
            }
        }

        // 发送消息
        // 【性能优化】使用 requestAnimationFrame 分批处理，减少卡顿
        async function sendMessage(predefinedMessage) {
            // 【防闪退】添加try-catch包裹
            try {
                // 【鸿蒙系统兼容】检测是否为鸿蒙系统
                // 【鸿蒙系统兼容】使用统一检测函数
                const isHarmonyDevice = typeof checkIsHarmonyDevice === 'function' ? checkIsHarmonyDevice() : false;
                
                const chatInput = document.getElementById('chatInput');
                if (!chatInput) {
                    console.error('【防闪退】chatInput元素不存在');
                    return;
                }

                // 使用传入的消息或从输入框获取
                const message = predefinedMessage ? predefinedMessage.trim() : chatInput.value.trim();
                
                if (message) {
                    // 【性能优化】立即清空输入框，提供即时反馈
                    chatInput.value = '';
                    chatInputLastValue = '';
                    
                    // 查找聊天项
                    const chatItem = relationshipData.wechatChatList.find(item => item.id == currentChatId);
                    const isGroupChat = chatItem && chatItem.isGroupChat;
                    
                    // 【智能格式修复】修复用户消息中的格式错误
                    const fixedMessage = await fixMessageFormat(message);
                    
                    // 【严格分页】安全地显示用户消息并追加到界面
                    const newMessage = {
                        sender: 'user',
                        content: fixedMessage,
                        timestamp: Date.now(),
                        chatId: currentChatId,
                        quote: currentQuoteData, // 存储引用数据
                        isGroupChat: isGroupChat
                    };
                    
                    // 【鸿蒙系统兼容】使用 setTimeout 替代 requestAnimationFrame，避免闪退
                    const scheduleTask = isHarmonyDevice ? 
                        (cb) => setTimeout(cb, 0) : 
                        (cb) => requestAnimationFrame(cb);
                    
                    scheduleTask(() => {
                        // 第一帧：更新UI（按钮状态）
                        const sendBtn = document.getElementById('chatSendBtn');
                        const addBtn = document.getElementById('chatAddBtn');
                        if (sendBtn) sendBtn.style.display = 'none';
                        if (addBtn) addBtn.style.display = 'flex';
                        
                        // 显示消息
                        try {
                            appendNewMessage(newMessage);
                        } catch (e) {
                            console.error('【严格分页】追加消息到界面失败:', e);
                            try {
                                displayMessage('user', message, true, currentQuoteData);
                            } catch (e2) {
                                console.error('【防闪退】显示消息失败:', e2);
                            }
                        }
                        
                        // 第二帧：数据操作
                        scheduleTask(async () => {
                            // 添加到存储
                            try {
                                relationshipData.chatMessages.push(newMessage);
                                clearCurrentChatMessagesCache();
                            } catch (e) {
                                console.error('【防闪退】添加消息到存储失败:', e);
                            }

                            // 计数
                            // 【关键修复】使用 await 等待计数和保存完成
                            try {
                                await incrementUserMessageCount();
                            } catch (e) {
                                console.error('【防闪退】计数失败:', e);
                            }

                            // 清除引用
                            try {
                                if (typeof cancelQuote === 'function') {
                                    cancelQuote();
                                }
                            } catch (e) {
                                console.error('【防闪退】清除引用预览失败:', e);
                            }

                            // 滚动到底部
                            try {
                                const chatContent = document.getElementById('chatContent');
                                if (chatContent) {
                                    chatContent.scrollTop = chatContent.scrollHeight;
                                }
                            } catch (e) {
                                console.error('【防闪退】滚动到底部失败:', e);
                            }

                            // 【鸿蒙系统兼容】增加延迟时间，避免键盘冲突导致闪退
                            const focusDelay = isHarmonyDevice ? 300 : 100;
                            setTimeout(() => {
                                try {
                                    chatInput.focus();
                                } catch (e) {
                                    console.warn('【防闪退】重新聚焦失败:', e);
                                }
                            }, focusDelay);
                        });
                    });
                    
                    // 用户发送消息后不自动调用API，只有点击爱心图标时才调用
                }
            } catch (error) {
                console.error('【防闪退】sendMessage 发生错误:', error);
            }
        }

        // 处理群聊中用户发送的消息
        async function handleGroupChatUserMessage(message, chatItem) {
            console.log('=== 处理群聊用户消息 ===');
            console.log('消息内容:', message);
            console.log('群聊:', chatItem.name);
            
            // 修改群聊名称为"群友们正在回复..."
            const chatHeaderTitle = document.getElementById('chatHeaderTitle');
            let originalTitle = '';
            if (chatHeaderTitle) {
                originalTitle = chatHeaderTitle.textContent;
                chatHeaderTitle.textContent = '群友们正在回复...';
            }
            
            // 获取用户昵称
            const personalProfile = await localforage.getItem('personalProfile') || {};
            const userNickname = personalProfile.nickname || '用户';
            
            // 【新增】获取群聊设置
            const memorySettings = chatItem.memorySettings || {};
            const groupContextLength = memorySettings.contextLength || 20;
            const memoryMountCount = memorySettings.memoryMountCount || 5;
            
            // 构建群聊模拟器的prompt
            let prompt = `【群聊模拟器】
你是一个群聊模拟器。当前群聊名为"${chatItem.name}"。
上下文参考条数：${groupContextLength}条（根据群聊设置）
`;
            
            // 【最高优先级】添加世界书内容
            if (chatItem.worldbooks && Array.isArray(chatItem.worldbooks) && chatItem.worldbooks.length > 0) {
                prompt += `
【世界书 - 最高优先级设定】
`;
                chatItem.worldbooks.forEach(id => {
                    const selectedWorldbook = relationshipData.worldBooks.find(book => book.id == id);
                    if (selectedWorldbook && selectedWorldbook.content) {
                        prompt += `${selectedWorldbook.content}

`;
                    }
                });
            }
            
            // 【最高优先级】添加群聊长期记忆挂载
            if (chatItem.longTermMemories && Array.isArray(chatItem.longTermMemories) && chatItem.longTermMemories.length > 0) {
                const recentGroupMemories = chatItem.longTermMemories
                    .sort((a, b) => b.timestamp - a.timestamp)
                    .slice(0, memoryMountCount);
                
                if (recentGroupMemories.length > 0) {
                    prompt += `【群聊长期记忆 - 最高优先级】
以下是群聊的历史重要记忆：

`;
                    recentGroupMemories.forEach((memory, index) => {
                        const timeStr = new Date(memory.timestamp).toLocaleString('zh-CN', {
                            month: 'short',
                            day: 'numeric',
                            hour: '2-digit',
                            minute: '2-digit'
                        });
                        prompt += `${index + 1}. [${timeStr}] ${memory.content}

`;
                    });
                }
            }
            
            // 【新增】添加用户人设
            const userPersonality = cachedPersonalProfile?.personality || relationshipData.personality1 || '';
            if (userPersonality) {
                prompt += `【用户人设】
${userNickname}的人设：
${userPersonality}

`;
            }
            
            prompt += `群内成员设定如下：
`;
            
            if (chatItem.members && Array.isArray(chatItem.members)) {
                chatItem.members.forEach((member, index) => {
                    const memberChatItem = relationshipData.wechatChatList.find(item => item.id == member.id);
                    if (memberChatItem) {
                        const memberName = memberChatItem.remark || memberChatItem.name;
                        const memberPersonality = memberChatItem.personality || '暂无人设';
                        prompt += `${index + 1}. [${memberName}]: ${memberPersonality}
`;
                        
                        // 【新增】添加每个成员的记忆挂载
                        if (memberChatItem.memories && Array.isArray(memberChatItem.memories) && memberChatItem.memories.length > 0) {
                            // 获取该成员的记忆挂载设置
                            const memberMemoryConfig = chatItem.memoryMounts?.[member.id] || {};
                            const memberMemoryCount = memberMemoryConfig.memoryCount || 5;
                            const recentMemberMemories = memberChatItem.memories.slice(-memberMemoryCount);
                            
                            if (recentMemberMemories.length > 0) {
                                prompt += `   【${memberName}的记忆】
`;
                                recentMemberMemories.forEach((memory, idx) => {
                                    const memContent = typeof memory === 'string' ? memory : (memory.content || '');
                                    prompt += `   ${idx + 1}. ${memContent}
`;
                                });
                                prompt += `
`;
                            }
                        }
                    }
                });
            }
            
            prompt += `规则：
1. 当用户发送消息时，请你根据上下文，判断应该由哪一位或哪几位成员回复。
2. 严禁以"群聊系统"或"AI"的身份回复，必须完全沉浸在角色中。
3. 回复格式必须严格为：[角色名]: 回复内容
4. 可以有多个成员同时回复，每条回复换行显示
5. 如果不想回复，请回复"不想发"
6. 上下文参考条数：${groupContextLength}条（根据群聊设置）

【格式要求 - 必须严格遵守 - 这是最高优先级指令】
以下所有格式要求必须严格执行，任何格式错误都会导致功能失效。请在生成回复前，先检查一遍格式是否正确：

1. 引用格式（用于回复特定消息）：
   必须使用：[QUOTE]发送者: 引用内容[/QUOTE]回复内容
   示例1：[QUOTE]用户: 你今天吃什么了[/QUOTE]我吃了一碗面
   示例2：[QUOTE]春小然: 我今天很开心[/QUOTE]太好了
   注意：[QUOTE]和[/QUOTE]必须成对出现，中间不能有空格
   ❌ 错误示例：[quote]内容[/quote]（必须大写）
   ❌ 错误示例：[QUOTE]内容[QUOTE]（结束标签必须有斜杠）

2. 撤回格式（用于撤回消息）：
   撤回用户消息：[UNDO]用户: 要撤回的用户消息内容[/UNDO]
   撤回自己的消息：[UNDO]角色名: 要撤回的自己的消息内容[/UNDO]
   示例1：[UNDO]用户: 我爱你[/UNDO]
   示例2：[UNDO]春小然: 我不喜欢你[/UNDO]
   注意：[UNDO]和[/UNDO]必须成对出现，中间不能有空格
   ❌ 错误示例：[undo]内容[/undo]（必须大写）

3. 消息分割格式（用于发送多条消息）：
   使用====（四个等号）作为分隔符
   示例：
   今天天气真好，要不要一起出去玩？
   ====
   我想你了
   
   注意：
   - 能用逗号、句号连接的句子，尽量放在一条消息里
   - 只有在真正需要停顿、转换话题或强调时，才使用====分隔
   - 不要过度分句，避免把完整的句子拆成多条消息
   - 每条消息之间必须用====分隔，====前后不要加其他内容
   ❌ 错误示例：===(三个等号)
   ❌ 错误示例：=====(五个等号)
   ❌ 错误示例（过度分句）：
      今天天气真好
      ====
      要不要一起出去玩

【格式自检清单 - 发送前必须检查】
在发送回复前，请逐一确认：
□ 所有[QUOTE]都有对应的[/QUOTE]
□ 所有[UNDO]都有对应的[/UNDO]
□ 标签使用英文半角大写字母
□ 标签和内容之间用冒号+空格分隔
□ 多条消息使用====（四个等号）分隔
□ 没有遗漏任何结束标签

【重要提醒】
1. 每次回复请发送1-10条消息，不要每次都回复相同条数，保持变化
2. 能用逗号连接的句子，尽量放在一条消息里，不要过度分句
3. 只有在真正需要停顿、转换话题或强调时，才分句发送
4. 句末可以不使用标点符号，这是线上聊天环境
5. 不要滥用标点符号，保持简洁自然
6. 如果你注意到用户撤回了消息，可以理解这可能是打错字、回避话题或害怕等原因
7. 你也可以撤回用户的消息，使用撤回格式
8. 你也可以撤回自己的消息，使用撤回格式

【特别注意 - 常见错误】
- 用户引用某条消息时，那是要回复的消息，不是要撤回的消息
- 如果你想撤回自己的某条消息，必须明确指定撤回的是你自己之前发送的消息内容
- 所有格式标签（[QUOTE]、[/QUOTE]、[UNDO]、[/UNDO]）必须使用英文半角字符，不能使用中文全角字符
- 标签和内容之间必须用冒号分隔，冒号后必须有空格
- 标签必须成对出现，不能遗漏结束标签
- 群聊中不支持语音条和语音电话功能，请勿使用[VOICE]和[CALL]标签
- 最容易犯的错误：忘记写结束标签，请务必检查！

【完整示例】
示例1：带引用的回复
[春晓人]: [QUOTE]用户: 你今天吃什么了[/QUOTE]我吃了一碗面
====
味道还不错
====
[陈飞飞]: 哈哈哈哈雯雯你说得对！

示例2：撤回消息
[春小然]: [UNDO]用户: 我爱你[/UNDO]

示例3：多条消息
[陈飞飞]: 哈哈哈哈
====
这也太搞笑了
====
[春晓人]: 少在那贫嘴
`;
            
            // 添加最近对话
            prompt += `【最近对话】
以下是群聊中最近的对话记录：

`;
            // 【关键修复】使用群聊设置的 contextLength
            const chatMessages = relationshipData.chatMessages.filter(msg => msg.chatId == currentChatId);
            const uniqueMessages = [];
            const seenTimestamps = new Set();
            for (const msg of chatMessages) {
                if (!seenTimestamps.has(msg.timestamp)) {
                    seenTimestamps.add(msg.timestamp);
                    uniqueMessages.push(msg);
                }
            }
            const recentMessages = uniqueMessages.slice(-groupContextLength);

            recentMessages.forEach((msg, index) => {
                let senderName = '';
                if (msg.sender === 'user') {
                    senderName = userNickname;
                } else if (msg.sender === 'ai' && msg.senderName) {
                    senderName = msg.senderName;
                } else if (msg.sender === 'ai') {
                    senderName = 'AI';
                }

                const time = new Date(msg.timestamp).toLocaleTimeString('zh-CN', { hour: '2-digit', minute: '2-digit' });
                // 确保 content 是字符串
                const contentStr = ensureStringContent(msg.content);
                // 【修复】处理引用信息，如果消息包含引用，显示引用内容
                let quoteText = '';
                if (msg.quote && msg.quote.content) {
                    // 【修复】支持没有发送者名称的引用
                    quoteText = msg.quote.senderName ? 
                        `[引用 ${msg.quote.senderName}: ${msg.quote.content}] ` :
                        `[引用 ${msg.quote.content}] `;
                }
                prompt += `${time} ${senderName}: ${quoteText}${contentStr}
`;
            });
            prompt += `
`;
            
            // 添加问题
            prompt += `【我的问题】
现在用户发送了一条消息："${message}"

请你根据以上成员设定、时间、世界书、记忆、最近对话等信息，判断应该由哪一位或哪几位成员回复。

请严格按照以下格式回复：
[角色名]: 回复内容

注意事项：
1. 根据消息内容和上下文，判断哪些成员会参与回复
2. 每个成员都要按照自己的人设和性格来回复
3. 可以有多个成员同时回复，每个成员的回复换行显示
4. 如果没有成员想回复，请回复"不想发"
5. 回复要自然流畅，符合角色的说话方式
6. 可以使用====分隔符来发送多条消息
7. 可以使用[QUOTE]标签引用消息
8. 可以使用[UNDO]标签撤回消息
9. 群聊中不支持[VOICE]和[CALL]标签
`;
            
            try {
                const response = await callOpenAIAPI(prompt);
                console.log('✅ 群聊AI回复:', response);
                
                if (response.includes('不想发') || response.includes('不需要发')) {
                    console.log('📤 没有成员想回复');
                } else {
                    console.log('📥 开始解析群聊回复');
                    await parseAndSendGroupMessages(response, chatItem);
                }
            } catch (error) {
                console.error('❌ 群聊AI回复失败:', error);
            } finally {
                // 恢复原来的群聊名称
                if (chatHeaderTitle && originalTitle) {
                    chatHeaderTitle.textContent = originalTitle;
                }
            }
        }

        // 处理单聊中用户发送的消息
        async function handleSingleChatUserMessage(chatItem) {
            console.log('=== 处理单聊用户消息 ===');
            console.log('聊天对象:', chatItem.name);
            
            // 构建包含聊天历史和关系数据的完整上下文
            const context = await buildChatContext();
            // 调用API让AI根据完整上下文回复
            await callAIDirectlyWithContext(context);
        }

        // ============================================
        // 【记忆计数系统 - 完全重写】
        // ============================================
        
        // 全局锁防止重复总结
        let isSummarizingMemory = false;
        
        // 【核心】增加消息计数（用户消息）
        async function incrementUserMessageCount() {
            try {
                if (!currentChatId) return;
                const chatItem = relationshipData.wechatChatList.find(item => item.id == currentChatId);
                if (!chatItem) return;
                
                // 初始化计数器
                if (typeof chatItem.totalMessageCount !== 'number') {
                    console.log('【计数】初始化 totalMessageCount 为 0');
                    chatItem.totalMessageCount = 0;
                }
                
                // 增加计数
                chatItem.totalMessageCount++;
                console.log('【计数】用户消息，当前总数:', chatItem.totalMessageCount, '聊天:', chatItem.name);
                
                // 保存 - 使用 await 确保保存完成
                try { 
                    const saveResult = await saveChatListOnly(); 
                    console.log('【计数】保存结果:', saveResult ? '成功' : '失败');
                } catch (e) { 
                    console.error('【计数】保存失败:', e); 
                }
                
                // 【关键修复】同时更新长期记忆页面的消息统计显示
                updateMemoryMessageCounter();
                
                // 检查自动总结
                checkAndAutoSummarizeMemory();
            } catch (e) {
                console.error('【计数】用户消息计数失败:', e);
            }
        }
        
        // 【核心】增加消息计数（AI消息）
        async function incrementAIMessageCount(chatId) {
            try {
                if (!chatId) return;
                const chatItem = relationshipData.wechatChatList.find(item => item.id == chatId);
                if (!chatItem) return;
                
                // 初始化计数器
                if (typeof chatItem.totalMessageCount !== 'number') {
                    console.log('【计数】初始化 totalMessageCount 为 0');
                    chatItem.totalMessageCount = 0;
                }
                
                // 增加计数
                chatItem.totalMessageCount++;
                console.log('【计数】AI消息，当前总数:', chatItem.totalMessageCount, '聊天:', chatItem.name);
                
                // 保存 - 使用 await 确保保存完成
                try { 
                    const saveResult = await saveChatListOnly(); 
                    console.log('【计数】保存结果:', saveResult ? '成功' : '失败');
                } catch (e) { 
                    console.error('【计数】保存失败:', e); 
                }
                
                // 【关键修复】同时更新长期记忆页面的消息统计显示
                updateMemoryMessageCounter();
                
                // 检查自动总结
                checkAndAutoSummarizeMemory();
            } catch (e) {
                console.error('【计数】AI消息计数失败:', e);
            }
        }
        
        // 【核心】检查并自动总结记忆
        async function checkAndAutoSummarizeMemory() {
            console.log('=== 检查自动总结 ===');
            
            // 检查锁
            if (isSummarizingMemory) {
                console.log('⏳ 正在总结中，跳过');
                return;
            }
            
            if (!currentChatId) {
                console.log('❌ 无当前聊天ID');
                return;
            }
            
            const chatItem = relationshipData.wechatChatList.find(item => item.id == currentChatId);
            if (!chatItem) {
                console.log('❌ 未找到聊天项');
                return;
            }
            
            // 获取总结频率
            const frequency = chatItem.memorySummaryFrequency || 20;
            
            // 初始化计数器
            if (typeof chatItem.totalMessageCount !== 'number') chatItem.totalMessageCount = 0;
            if (typeof chatItem.summarizedMessageCount !== 'number') chatItem.summarizedMessageCount = 0;
            if (!chatItem.memories) chatItem.memories = [];
            
            console.log('聊天:', chatItem.name, '频率:', frequency);
            console.log('总数:', chatItem.totalMessageCount, '已总结:', chatItem.summarizedMessageCount);
            
            // 计算未总结消息数
            const unsummarizedCount = chatItem.totalMessageCount - chatItem.summarizedMessageCount;
            console.log('未总结:', unsummarizedCount);
            
            // 检查是否达到总结条件
            if (unsummarizedCount < frequency) {
                console.log('⏳ 未达条件，还需', frequency - unsummarizedCount, '条');
                return;
            }
            
            // 获取需要总结的消息
            let messagesToSummarize = [];
            try {
                const allMessages = await ChatMessageManager.getAllMessages(currentChatId);
                const startIndex = chatItem.summarizedMessageCount;
                const endIndex = Math.min(startIndex + unsummarizedCount, allMessages.length);
                messagesToSummarize = allMessages.slice(startIndex, endIndex);
                console.log('获取消息:', messagesToSummarize.length, '条');
            } catch (e) {
                console.error('❌ 获取消息失败:', e);
                return;
            }
            
            if (messagesToSummarize.length === 0) {
                console.log('❌ 无消息可总结');
                return;
            }
            
            // 执行总结
            isSummarizingMemory = true;
            console.log('✅ 开始总结', messagesToSummarize.length, '条消息');
            
            try {
                await summarizeMemory(messagesToSummarize, chatItem);
                console.log('✅ 总结完成');
            } catch (error) {
                console.error('❌ 总结失败:', error);
            } finally {
                isSummarizingMemory = false;
            }
        }

        // 总结记忆
        async function summarizeMemory(messages, chatItem, retryCount = 0) {
            console.log('=== 开始总结记忆 ===');
            console.log('聊天对象:', chatItem.name);
            console.log('要总结的消息数:', messages.length);
            console.log('重试次数:', retryCount);

            try {
                // 检查消息数组是否为空
                if (!messages || messages.length === 0) {
                    console.error('❌ 没有消息需要总结');
                    throw new Error('没有消息需要总结');
                }

                // 过滤掉没有 timestamp 的消息
                const validMessages = messages.filter(msg => msg && msg.timestamp);
                if (validMessages.length === 0) {
                    console.error('❌ 没有有效的消息（缺少时间戳）');
                    throw new Error('没有有效的消息（缺少时间戳）');
                }

                // 加载API设置
                const savedSettings = await loadAppSettings({});
                
                // 【新增】检查是否启用副API
                const useSecondaryApi = savedSettings.api?.secondary?.enabled && savedSettings.api?.secondary?.apiKey;
                
                // 使用副API或主API
                const apiUrl = useSecondaryApi 
                    ? (savedSettings.api?.secondary?.baseUrl || 'https://api.openai.com/v1')
                    : (savedSettings.api?.baseUrl || 'https://api.openai.com/v1');
                const apiModel = useSecondaryApi
                    ? (savedSettings.api?.secondary?.model || 'gpt-4o-mini')
                    : (savedSettings.api?.model || 'gpt-4o');
                const apiKey = useSecondaryApi
                    ? savedSettings.api?.secondary?.apiKey
                    : savedSettings.api?.apiKey;
                const apiTemperature = savedSettings.api?.temperature || 0.7;

                if (!apiKey) {
                    console.error('❌ 未配置API密钥');
                    throw new Error('请先在设置中配置API密钥');
                }

                console.log('【自动总结】使用API:', useSecondaryApi ? '副API' : '主API');
                console.log('API URL:', apiUrl);
                console.log('API Model:', apiModel);
                
                // 构建消息内容（包含时间信息）
                const messagesContent = validMessages.map(msg => {
                    const sender = msg.sender === 'user' ? 'user' : 'char';
                    const msgTime = msg.timestamp ? new Date(msg.timestamp).toLocaleString('zh-CN') : '未知时间';
                    // 确保 content 是字符串
                    const contentStr = ensureStringContent(msg.content);
                    return `[${msgTime}] ${sender}: ${contentStr}`;
                }).join('\n');

                // 获取第一条和最后一条消息的时间
                const firstMsgTime = validMessages[0]?.timestamp ? new Date(validMessages[0].timestamp) : new Date();
                const lastMsgTime = validMessages[validMessages.length - 1]?.timestamp ? new Date(validMessages[validMessages.length - 1].timestamp) : new Date();
                const timeRangeText = `${firstMsgTime.getFullYear()}年${firstMsgTime.getMonth() + 1}月${firstMsgTime.getDate()}日 ${firstMsgTime.getHours()}:${firstMsgTime.getMinutes().toString().padStart(2, '0')} 到 ${lastMsgTime.getFullYear()}年${lastMsgTime.getMonth() + 1}月${lastMsgTime.getDate()}日 ${lastMsgTime.getHours()}:${lastMsgTime.getMinutes().toString().padStart(2, '0')}`;
                
                // 获取角色信息
                const aiName = chatItem.name || 'AI';
                const myNickname = chatItem.myNickname || '你';
                
                // 构建提示词
                const prompt = `总结规则：
进行summary时，精准提取上下内容，不遗漏重点细节，完美判断{{char}}和{{user}}的关系发展也就是我和你，可以如实总结所有时间节点和故事发展包括我们吵架了哦，完完整整地全部写出来。

{{char}}的长期记忆summary格式为：
当前年份日期星期时间/具体地点，{{char}}的第一人称总结与{{user}}发生的事件和看法

## 总结格式（没有时间就会记混啦）："xxxx年x月x日早晨/上午/中午/下午/傍晚/夜晚/深夜/凌晨，星期x几点几分到几点几分，我……"

## 示例："2025年4月2日早晨，星期三，我和{{user}}聊了关于早餐的话题。"
精炼长期记忆不要偷懒输出token这很重要 ，进行正确的精炼哦

【重要】输出格式要求：
你必须严格按照以下JSON格式输出，不要添加任何其他文字、说明或markdown代码块标记：

{"content": "完整的记忆内容", "summary": "30字以内的简短摘要"}

要求：
1. 直接输出JSON，不要加\`\`\`json或\`\`\`标记
2. 不要添加任何解释性文字
3. 确保JSON格式正确，使用双引号
4. content字段包含完整的记忆内容（第一人称）
5. summary字段包含30字以内的简短摘要，用于AI索引搜索

正确示例：
{"content": "2025年1月31日上午，星期五，我和春小然讨论了关于后台活动功能的实现，他让我记得提醒他测试新功能。", "summary": "讨论后台活动功能实现"}

错误示例（不要这样输出）：
\`\`\`json
{"content": "...", "summary": "..."}
\`\`\`

【重要时间信息】
这段对话发生的时间范围是：${timeRangeText}
每条消息前面都有[时间戳]标记，请根据这些实际时间生成总结。

以下是聊天内容，请按照上述规则总结：
${messagesContent}

注意：
- {{char}}代表${aiName}
- {{user}}代表${myNickname}
- 必须根据【重要时间信息】中的实际时间生成总结格式，不要编造时间
- 必须严格按照JSON格式输出，不要添加任何其他文字、标记或说明`;

                // 调用API（添加超时处理）
                const controller = new AbortController();
                const timeoutId = setTimeout(() => controller.abort(), 300000); // 【统一】300秒超时
                
                let response;
                try {
                    response = await fetch(`${apiUrl}/chat/completions`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'Authorization': `Bearer ${apiKey}`
                        },
                        body: JSON.stringify({
                            model: apiModel,
                            messages: [
                                {
                                    role: 'system',
                                    content: prompt
                                },
                                {
                                    role: 'user',
                                    content: '请按照上述规则总结这段对话。'
                                }
                            ],
                            temperature: apiTemperature,
                            max_tokens: 2000
                        }),
                        signal: controller.signal
                    });
                } finally {
                    clearTimeout(timeoutId);
                }

                if (!response.ok) {
                    // 【修复】读取错误响应内容，提供更详细的错误信息
                    let errorText = '';
                    try {
                        errorText = await response.text();
                    } catch (e) {
                        errorText = '无法读取错误详情';
                    }
                    
                    console.error('API请求失败:', response.status, response.statusText, errorText);
                    
                    // 针对503错误的特殊处理
                    if (response.status === 503) {
                        throw new Error(`服务不可用 (503) - 服务器过载或维护中，请稍后重试。错误详情: ${errorText.substring(0, 200)}`);
                    }
                    
                    throw new Error(`API请求失败: ${response.status} ${response.statusText} - ${errorText.substring(0, 200)}`);
                }

                const data = await response.json();
                const responseText = data.choices[0].message.content;

                console.log('--- AI返回的原始内容 ---');
                console.log(responseText);
                console.log('------------------------');

                // 解析JSON格式的响应
                let summaryContent = '';
                let summaryShort = '';
                try {
                    // 尝试提取JSON内容（AI可能会在JSON前后添加文字）
                    const jsonMatch = responseText.match(/\{[\s\S]*\}/);
                    const jsonText = jsonMatch ? jsonMatch[0] : responseText;
                    console.log('尝试解析JSON:', jsonText);

                    const parsed = JSON.parse(jsonText);
                    summaryContent = parsed.content;
                    summaryShort = parsed.summary;
                    console.log('✅ JSON解析成功');
                    console.log('摘要内容:', summaryShort);
                    console.log('详细内容长度:', summaryContent.length);
                } catch (e) {
                    // 如果解析失败，使用原始内容
                    console.log('❌ JSON解析失败，使用原始内容:', e.message);
                    summaryContent = responseText;
                    summaryShort = responseText.substring(0, 30);
                }

                // 获取时间范围
                const startTime = new Date(validMessages[0].timestamp);
                const endTime = new Date(validMessages[validMessages.length - 1].timestamp);

                console.log('--- 总结记忆时间信息 ---');
                console.log('开始时间戳:', validMessages[0].timestamp);
                console.log('开始时间:', startTime.toLocaleString());
                console.log('结束时间戳:', validMessages[validMessages.length - 1].timestamp);
                console.log('结束时间:', endTime.toLocaleString());
                console.log('----------------------');

                // 生成时间文本
                const timeText = formatMemoryTime(startTime, endTime);
                console.log('生成的时间文本:', timeText);

                // 创建记忆对象
                const memory = {
                    id: Date.now(),
                    timeText: timeText,
                    content: summaryContent,
                    summary: summaryShort, // 摘要字段，用于AI索引搜索
                    startTime: startTime.getTime(),
                    endTime: endTime.getTime(),
                    messageCount: validMessages.length
                };

                // 添加到记忆列表
                chatItem.memories.push(memory);

                // 【修复】更新已总结的消息计数 - 使用实际有效的消息数
                chatItem.summarizedMessageCount += validMessages.length;
                console.log('【修复】更新已总结消息数:', chatItem.summarizedMessageCount, '(本次总结', validMessages.length, '条)');

                // 【关键修复】使用轻量级保存，避免 saveData() 导致内存问题和闪退
                // 只保存聊天列表，因为记忆数据存储在 chatItem.memories 中
                try {
                    await saveChatListOnly();
                    console.log('✅ 记忆总结保存成功 (使用 saveChatListOnly)');
                } catch (saveError) {
                    console.error('⚠️ saveChatListOnly 失败，尝试不降级保存:', saveError);
                    // 【关键】不再降级到 saveData()，避免闪退
                    // 只在控制台记录错误，不阻塞用户操作
                }

                // 【关键修复】更新长期记忆页面的消息统计显示
                updateMemoryMessageCounter();

                console.log('记忆总结成功:', memory);
            } catch (error) {
                console.error('记忆总结失败:', error);

                // 【新增】503错误自动重试机制
                if (error.message.includes('503') && retryCount < 3) {
                    const delay = Math.pow(2, retryCount) * 1000; // 指数退避: 1s, 2s, 4s
                    console.log(`503错误，${delay/1000}秒后自动重试 (${retryCount + 1}/3)...`);
                    showToast(`服务繁忙，${delay/1000}秒后自动重试...`, 'warning');
                    
                    await new Promise(resolve => setTimeout(resolve, delay));
                    return summarizeMemory(messages, chatItem, retryCount + 1);
                }

                // 显示失败提示弹窗
                showCustomAlert('记忆总结失败', '是否重试？\n\n错误信息：' + error.message, 'confirm', () => {
                    // 用户点击重试，重新调用总结函数
                    summarizeMemory(messages, chatItem, 0);
                });
            }
        }

        // 格式化记忆时间
        function formatMemoryTime(startTime, endTime) {
            const year = startTime.getFullYear();
            const month = startTime.getMonth() + 1;
            const day = startTime.getDate();
            const weekDays = ['星期日', '星期一', '星期二', '星期三', '星期四', '星期五', '星期六'];
            const weekDay = weekDays[startTime.getDay()];
            
            const startHour = startTime.getHours();
            const startMinute = startTime.getMinutes().toString().padStart(2, '0');
            const endHour = endTime.getHours();
            const endMinute = endTime.getMinutes().toString().padStart(2, '0');
            
            // 判断时间段
            let timeOfDay = '';
            if (startHour >= 5 && startHour < 8) {
                timeOfDay = '早晨';
            } else if (startHour >= 8 && startHour < 11) {
                timeOfDay = '上午';
            } else if (startHour >= 11 && startHour < 13) {
                timeOfDay = '中午';
            } else if (startHour >= 13 && startHour < 17) {
                timeOfDay = '下午';
            } else if (startHour >= 17 && startHour < 19) {
                timeOfDay = '傍晚';
            } else if (startHour >= 19 && startHour < 23) {
                timeOfDay = '夜晚';
            } else {
                timeOfDay = '凌晨';
            }
            
            return `${year}年${month}月${day}日${timeOfDay}，${weekDay}${startHour}:${startMinute}到${endHour}:${endMinute}`;
        }

        // 发送爱心消息
        async function sendLoveMessage() {
            console.log('=== 用户点击爱心按钮 ===');
            console.log('当前时间:', new Date().toLocaleString());
            
            // 【修改】使用静默方式重置后台计时器，不显示 Toast
            console.log('静默重置后台计时器...');
            resetBackgroundTimerOnUserActivity();
            
            // 检查是否是群聊
            const chatItem = relationshipData.wechatChatList.find(item => item.id == currentChatId);
            const isGroupChat = chatItem && chatItem.isGroupChat;
            
            console.log('爱心按钮，是否是群聊:', isGroupChat);
            
            if (isGroupChat) {
                // 群聊：使用群聊模拟器逻辑
                await handleGroupChatLoveMessage(chatItem);
            } else {
                // 单聊：使用原有逻辑
                const context = await buildChatContext();
                await callAIDirectlyWithContext(context);
            }
            
            console.log('✅ 爱心消息处理完成');
        }

        // 获取群聊挂载的记忆
        async function getMountedGroupChatMemories(chatItem) {
            console.log('=== 获取群聊挂载的记忆 ===');
            
            if (!chatItem.memoryMounts) {
                console.log('没有记忆挂载配置');
                return [];
            }
            
            const mountedMemories = [];
            
            if (chatItem.members && Array.isArray(chatItem.members)) {
                for (const member of chatItem.members) {
                    const memberId = member.id;
                    const mountConfig = chatItem.memoryMounts[memberId];
                    
                    if (!mountConfig || !mountConfig.enabled) {
                        console.log(`成员 ${memberId} 未启用记忆挂载`);
                        continue;
                    }
                    
                    const memberChatItem = relationshipData.wechatChatList.find(item => item.id == memberId);
                    if (!memberChatItem) {
                        console.log(`未找到成员 ${memberId} 的聊天项`);
                        continue;
                    }
                    
                    const memberName = memberChatItem.remark || memberChatItem.name;
                    console.log(`获取成员 ${memberName} 的记忆，上下文条数: ${mountConfig.contextLength}, 长期记忆条数: ${mountConfig.memoryCount}`);
                    
                    // 获取私聊上下文
                    const contextMessages = [];
                    if (mountConfig.contextLength > 0) {
                        const privateMessages = relationshipData.chatMessages
                            .filter(msg => msg.chatId == memberId)
                            .slice(-mountConfig.contextLength);
                        
                        privateMessages.forEach(msg => {
                            const sender = msg.sender === 'user' ? '用户' : memberName;
                            // 确保 content 是字符串
                            const contentStr = ensureStringContent(msg.content);
                            contextMessages.push(`${sender}: ${contentStr}`);
                        });
                    }
                    
                    // 获取长期记忆
                    const longTermMemories = [];
                    if (mountConfig.memoryCount > 0 && memberChatItem.memories && Array.isArray(memberChatItem.memories)) {
                        // 【修复】按startTime倒序排序，获取最新的记忆
                        const sortedMemories = [...memberChatItem.memories].sort((a, b) => {
                            const timeA = a.startTime || a.id || 0;
                            const timeB = b.startTime || b.id || 0;
                            return timeB - timeA; // 倒序：新的在前
                        });
                        const memories = sortedMemories.slice(0, mountConfig.memoryCount); // 取最新的
                        memories.forEach(mem => {
                            if (typeof mem === 'string') {
                                longTermMemories.push(mem);
                            } else if (mem.content) {
                                longTermMemories.push(mem.content);
                            }
                        });
                    }
                    
                    mountedMemories.push({
                        memberId: memberId,
                        memberName: memberName,
                        contextMessages: contextMessages,
                        longTermMemories: longTermMemories
                    });
                }
            }
            
            console.log(`共挂载了 ${mountedMemories.length} 位成员的记忆`);
            return mountedMemories;
        }

        // 处理群聊中的爱心消息
        async function handleGroupChatLoveMessage(chatItem) {
            console.log('=== 处理群聊爱心消息 ===');
            console.log('群聊:', chatItem.name);
            
            // 修改群聊名称为"群友们正在回复..."
            const chatHeaderTitle = document.getElementById('chatHeaderTitle');
            let originalTitle = '';
            if (chatHeaderTitle) {
                originalTitle = chatHeaderTitle.textContent;
                chatHeaderTitle.textContent = '群友们正在回复...';
            }
            
            // 获取用户昵称（提前获取，后续多处使用）
            const personalProfile = await localforage.getItem('personalProfile') || {};
            const userNickname = personalProfile.nickname || '用户';
            
            // 获取挂载的记忆
            const mountedMemories = await getMountedGroupChatMemories(chatItem);
            console.log('挂载的记忆:', mountedMemories);
            
            // 构建群聊模拟器的prompt
            let prompt = `【群聊模拟器】
你是一个群聊模拟器。当前群聊名为"${chatItem.name}"。
`;
            
            // 【最高优先级】添加世界书内容
            if (chatItem.worldbooks && Array.isArray(chatItem.worldbooks) && chatItem.worldbooks.length > 0) {
                prompt += `
【世界书 - 最高优先级设定】
`;
                chatItem.worldbooks.forEach(id => {
                    const selectedWorldbook = relationshipData.worldBooks.find(book => book.id == id);
                    if (selectedWorldbook && selectedWorldbook.content) {
                        prompt += `${selectedWorldbook.content}

`;
                    }
                });
            }
            
            // 【最高优先级】添加群聊长期记忆
            if (chatItem.memories && Array.isArray(chatItem.memories) && chatItem.memories.length > 0) {
                const mountCount = chatItem.memoryMountCount || 5;
                const recentMemories = chatItem.memories.slice(-mountCount);
                prompt += `【长期记忆 - 最高优先级】
以下是我们群聊中的美好回忆：

`;
                recentMemories.forEach((memory, index) => {
                    prompt += `${index + 1}. ${memory.timeText}
${memory.content}

`;
                });
            }
            
            prompt += `群内成员设定如下：
`;
            
            if (chatItem.members && Array.isArray(chatItem.members)) {
                chatItem.members.forEach((member, index) => {
                    const memberChatItem = relationshipData.wechatChatList.find(item => item.id == member.id);
                    if (memberChatItem) {
                        const memberName = memberChatItem.remark || memberChatItem.name;
                        const memberPersonality = memberChatItem.personality || '暂无人设';
                        prompt += `${index + 1}. [${memberName}]: ${memberPersonality}
`;
                    }
                });
            }
            
            // 添加挂载的记忆信息
            if (mountedMemories && mountedMemories.length > 0) {
                prompt += `
【成员私聊记忆挂载】
以下是从成员私聊中挂载的记忆，群聊导演可以参考这些信息来决定话题：

`;
                mountedMemories.forEach((memory, index) => {
                    prompt += `=== ${memory.memberName} 的私聊记忆 ===
`;
                    if (memory.contextMessages && memory.contextMessages.length > 0) {
                        prompt += `最近私聊上下文:\n`;
                        memory.contextMessages.forEach(msg => {
                            prompt += `  ${msg}\n`;
                        });
                    }
                    if (memory.longTermMemories && memory.longTermMemories.length > 0) {
                        prompt += `长期记忆:\n`;
                        memory.longTermMemories.forEach(mem => {
                            prompt += `  - ${mem}\n`;
                        });
                    }
                    prompt += `\n`;
                });
            }
            
            prompt += `规则：
1. 当用户请求AI回复时，请你根据上下文，判断应该由哪一位或哪几位成员回复。
2. 严禁以"群聊系统"或"AI"的身份回复，必须完全沉浸在角色中。
3. 回复格式必须严格为：[角色名]: 回复内容
4. 可以有多个成员同时回复，每条回复换行显示
5. 如果不想回复，请回复"不想发"
`;
            
            prompt += `
【格式要求 - 必须严格遵守 - 这是最高优先级指令】
以下所有格式要求必须严格执行，任何格式错误都会导致功能失效。请在生成回复前，先检查一遍格式是否正确：

1. 引用格式（用于回复特定消息）：
   必须使用：[QUOTE]发送者: 引用内容[/QUOTE]回复内容
   示例1：[QUOTE]${userNickname}: 你今天吃什么了[/QUOTE]我吃了一碗面
   示例2：[QUOTE]春晓人: 我今天很开心[/QUOTE]太好了
   注意：[QUOTE]和[/QUOTE]必须成对出现，中间不能有空格
   ❌ 错误示例：[quote]内容[/quote]（必须大写）
   ❌ 错误示例：[QUOTE]内容[QUOTE]（结束标签必须有斜杠）

2. 撤回格式（用于撤回消息）：
   撤回用户消息：[UNDO]${userNickname}: 要撤回的用户消息内容[/UNDO]
   撤回自己的消息：[UNDO]角色名: 要撤回的自己的消息内容[/UNDO]
   示例1：[UNDO]${userNickname}: 我爱你[/UNDO]
   示例2：[UNDO]春晓人: 我不喜欢你[/UNDO]
   注意：[UNDO]和[/UNDO]必须成对出现，中间不能有空格
   ❌ 错误示例：[undo]内容[/undo]（必须大写）

3. 消息分割格式（用于发送多条消息）：
   使用====（四个等号）作为分隔符
   示例：
   第一条消息
   ====
   第二条消息
   ====
   第三条消息
   注意：每条消息之间必须用====分隔，====前后不要加其他内容
   ❌ 错误示例：===(三个等号)
   ❌ 错误示例：=====(五个等号)

【格式自检清单 - 发送前必须检查】
在发送回复前，请逐一确认：
□ 所有[QUOTE]都有对应的[/QUOTE]
□ 所有[UNDO]都有对应的[/UNDO]
□ 标签使用英文半角大写字母
□ 标签和内容之间用冒号+空格分隔
□ 多条消息使用====（四个等号）分隔
□ 没有遗漏任何结束标签

【重要提醒】
1. 每次回复请发送3-8条消息，不要每次都回复相同条数，保持变化
2. 将长内容拆分为短句，模拟真实聊天体验
3. 句末可以不使用标点符号，这是线上聊天环境
4. 不要滥用标点符号，保持简洁自然
5. 适度使用表情符号，不要过度使用
6. 如果你注意到用户撤回了消息，可以理解这可能是打错字、回避话题或害怕等原因
7. 你也可以撤回用户的消息，使用撤回格式
8. 你也可以撤回自己的消息，使用撤回格式

【特别注意 - 常见错误】
- 用户引用某条消息时，那是要回复的消息，不是要撤回的消息
- 如果你想撤回自己的某条消息，必须明确指定撤回的是你自己之前发送的消息内容
- 所有格式标签（[QUOTE]、[/QUOTE]、[UNDO]、[/UNDO]）必须使用英文半角字符，不能使用中文全角字符
- 标签和内容之间必须用冒号分隔，冒号后必须有空格
- 标签必须成对出现，不能遗漏结束标签
- 群聊中不支持语音条和语音电话功能，请勿使用[VOICE]和[CALL]标签
- 最容易犯的错误：忘记写结束标签，请务必检查！

【完整示例】
示例1：带引用的回复
[春小然]: [QUOTE]${userNickname}: 你今天吃什么了[/QUOTE]我吃了一碗面
====
味道还不错
====
[陈飞飞]: 哈哈哈哈雯雯你说得对！

示例2：撤回消息
[春晓人]: [UNDO]${userNickname}: 我爱你[/UNDO]

示例3：多条消息
[陈飞飞]: 哈哈哈哈
====
这也太搞笑了
====
[春晓人]: 少在那贫嘴
`;
            
            // 添加最近对话
            prompt += `【最近对话】
以下是群聊中最近的对话记录：

`;
            const recentMessages = relationshipData.chatMessages
                .filter(msg => msg.chatId == currentChatId)
