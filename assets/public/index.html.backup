                                        toolResult = await sendStickerByAI(functionArgs);
                                        break;
                                    case 'getLatestFootprint':
                                        toolResult = await getLatestFootprint();
                                        break;
                                    case 'getFootprintHistory':
                                        toolResult = await getFootprintHistory(functionArgs);
                                        break;
                                    case 'getFootprintsByDate':
                                        toolResult = await getFootprintsByDate(functionArgs);
                                        break;
                                    case 'manageAccounting':
                                        toolResult = await manageAccountingTool(functionArgs);
                                        break;
                                    case 'submitDemonQuizAnswer':
                                        toolResult = await submitDemonQuizAnswer(functionArgs);
                                        break;
                                    case 'getDemonQuizResult':
                                        toolResult = await getDemonQuizResult();
                                        break;
                                    case 'createDemonQuiz':
                                        toolResult = await createDemonQuiz(functionArgs);
                                        break;
                                    case 'submitUserDemonQuizAnswer':
                                        toolResult = await submitUserDemonQuizAnswer(functionArgs);
                                        break;
                                    case 'createAngelQuiz':
                                        toolResult = await createAngelQuiz(functionArgs);
                                        break;
                                    case 'submitAngelQuizAnswer':
                                        toolResult = await submitAngelQuizAnswer(functionArgs);
                                        break;
                                    case 'getAngelQuizList':
                                        toolResult = await getAngelQuizList(functionArgs);
                                        break;
                                    case 'getAngelQuizDetail':
                                        toolResult = await getAngelQuizDetail(functionArgs);
                                        break;
                                    case 'postWeibo':
                                        // 发微博工具
                                        console.log('【微博AI】第二轮处理 postWeibo 工具调用');
                                        toolResult = await postWeiboTool(functionArgs);
                                        break;
                                    case 'getWeiboHotSearch':
                                        // 微博热搜工具
                                        console.log('【微博AI】第二轮处理 getWeiboHotSearch 工具调用');
                                        toolResult = await getWeiboHotSearchTool();
                                        break;
                                    case 'startFocusMode':
                                        toolResult = await startFocusModeTool(functionArgs);
                                        break;
                                    case 'releaseFromBlackRoom':
                                        toolResult = await releaseFromBlackRoomTool(functionArgs);
                                        break;
                                    case 'extendBlackRoomTime':
                                        toolResult = await extendBlackRoomTimeTool(functionArgs);
                                        break;
                                    case 'getBlackRoomStatus':
                                        toolResult = await getBlackRoomStatusTool(functionArgs);
                                        break;
                                    case 'manage_super_memo':
                                        toolResult = await manageSuperMemoTool(functionArgs);
                                        break;
                                    case 'updateProfile':
                                        toolResult = await updateAIProfile(functionArgs, chatItem.id);
                                        break;
                                    default:
                                        console.error('未知函数:', functionName);
                                        continue;
                                }
                                console.log(`✅ 函数执行结果:`, toolResult);

                                // 添加工具结果到消息历史
                                messages.push({
                                    role: 'tool',
                                    tool_call_id: toolCall.id,
                                    content: JSON.stringify(toolResult)
                                });
                            }

                            currentRound++;
                        } else {
                            // 没有更多工具调用，返回最终回复
                            finalReply = toolMessageContent || '';
                            break;
                        }
                    }
                    
                    // 返回最终回复
                    // 【修复】如果finalReply为空但执行了工具，返回空字符串让上层处理
                    // 上层会根据executedTools显示合适的提示
                    let reply = finalReply || '';
                    if (!reply.trim() && executedTools.length > 0) {
                        console.log('【修复】工具执行成功但AI未返回文本，返回空字符串让上层处理');
                        // 返回空字符串，但保留executedTools，让callAIDirectly决定显示什么
                    }
                    
                    // 【修复】检查是否有暂存的心声，如果有则返回
                    let thoughtResult = '';
                    if (pendingInnerThought && String(pendingInnerThoughtAIId) === String(currentChatId)) {
                        thoughtResult = pendingInnerThought;
                        console.log('【心声修复】返回暂存的心声:', thoughtResult.substring(0, 50) + '...');
                        // 注意：这里不清除pendingInnerThought，让attachPendingInnerThought来处理关联
                    }
                    
                    return {
                        reply: reply,
                        thought: thoughtResult,
                        executedTools: executedTools // 【新增】返回执行的工具列表
                    };
                } else {
                    // 直接返回AI的回复内容（心声已通过saveInnerThought工具保存）
                    console.log('========== 直接返回回复内容 ==========');
                    console.log('原始消息内容:', message.content);
                    console.log('原始消息内容类型:', typeof message.content);
                    console.log('================================');
                    
                    // 确保返回的是字符串
                    let replyContent = message.content;
                    if (replyContent === null || replyContent === undefined) {
                        console.warn('⚠️ message.content 为 null/undefined');
                        replyContent = '';
                    } else if (typeof replyContent !== 'string') {
                        console.warn('⚠️ message.content 不是字符串:', replyContent);
                        replyContent = String(replyContent);
                    }
                    
                    // 【修复】如果replyContent为空但执行了工具，保留空字符串让上层处理
                    // 上层callAIDirectly会根据executedTools显示合适的提示
                    if (!replyContent.trim() && executedTools.length > 0) {
                        console.log('【修复】直接返回时工具已执行但内容为空，保留空字符串让上层处理');
                        // 不设置默认文本，让上层根据executedTools决定显示什么
                    }

                    // 【关键修复】检查是否包含Prompt格式操作（心声、朋友圈、备忘录等）
                    // 这些操作不在executedTools中记录，需要单独检查
                    const hasPromptActions = checkForPromptActions(replyContent);
                    if (!replyContent.trim() && hasPromptActions) {
                        console.log('【修复】检测到Prompt格式操作，保留内容让上层解析处理');
                        // 不设置默认文本，让上层解析这些操作
                    }

                    // 【修复】检查是否有暂存的心声，如果有则返回
                    let thoughtResult = '';
                    if (pendingInnerThought && String(pendingInnerThoughtAIId) === String(currentChatId)) {
                        thoughtResult = pendingInnerThought;
                        console.log('【心声修复】返回暂存的心声:', thoughtResult.substring(0, 50) + '...');
                        // 注意：这里不清除pendingInnerThought，让attachPendingInnerThought来处理关联
                    }

                    return {
                        reply: replyContent,
                        thought: thoughtResult,
                        executedTools: executedTools, // 【新增】返回执行的工具列表
                        hasPromptActions: hasPromptActions // 【新增】返回是否包含Prompt格式操作
                    };
                }
            } catch (error) {
                console.error('OpenAI API调用失败:', error);
                throw error;
            }
        }

        // 安全的JSON解析函数
        function safeJSONParse(content) {
            if (!content || typeof content !== 'string') {
                return null;
            }
            
            // 首先尝试直接解析
            try {
                return JSON.parse(content);
            } catch (e) {
                // 直接解析失败，尝试清理
            }
            
            // 清理内容
            let cleaned = content.trim();
            
            // 找到第一个 { 和最后一个 }
            const firstBrace = cleaned.indexOf('{');
            const lastBrace = cleaned.lastIndexOf('}');
            
            if (firstBrace === -1 || lastBrace === -1 || lastBrace <= firstBrace) {
                return null;
            }
            
            cleaned = cleaned.substring(firstBrace, lastBrace + 1);
            
            // 尝试解析清理后的内容
            try {
                return JSON.parse(cleaned);
            } catch (e) {
                // 如果还是失败，尝试修复常见的JSON问题
                try {
                    // 修复中文引号
                    cleaned = cleaned.replace(/[""]/g, '"');
                    cleaned = cleaned.replace(/['']/g, '"');
                    
                    // 修复多余的逗号
                    cleaned = cleaned.replace(/,\s*}/g, '}');
                    cleaned = cleaned.replace(/,\s*]/g, ']');
                    
                    // 修复未转义的换行符（在字符串值内部）
                    // 先找到所有字符串，然后处理其中的换行符
                    cleaned = cleaned.replace(/(".*?")/gs, (match) => {
                        return match
                            .replace(/\n/g, '\\n')
                            .replace(/\r/g, '\\r')
                            .replace(/\t/g, '\\t');
                    });
                    
                    return JSON.parse(cleaned);
                } catch (e2) {
                    console.error('JSON解析失败，清理后的内容:', cleaned);
                    return null;
                }
            }
        }

        // 处理链式工具调用的辅助函数
        async function processToolCalls(toolCalls, messages, systemPrompt, userMessage, baseUrl, apiKey, model, customTools = null, useSecondaryApi = false, secondaryBaseUrl = null, secondaryApiKey = null, secondaryModel = null) {
            console.log('🔄 处理链式工具调用:', toolCalls);
            console.log('🔄 使用副API:', useSecondaryApi);
            
            // 【新增】如果启用副API，使用副API的参数
            const actualBaseUrl = useSecondaryApi && secondaryBaseUrl ? secondaryBaseUrl : baseUrl;
            const actualApiKey = useSecondaryApi && secondaryApiKey ? secondaryApiKey : apiKey;
            const actualModel = useSecondaryApi && secondaryModel ? secondaryModel : model;
            
            if (useSecondaryApi) {
                console.log('【副API】工具调用使用副API:', actualModel);
            }
            
            // 处理每个工具调用
            for (const toolCall of toolCalls) {
                const functionName = toolCall.function.name;
                
                // 【修复】添加try-catch保护arguments解析
                let functionArgs;
                try {
                    functionArgs = JSON.parse(toolCall.function.arguments);
                } catch (parseError) {
                    console.error('❌ processToolCalls 解析工具参数失败:', parseError);
                    console.error('❌ 原始参数:', toolCall.function.arguments);
                    // 尝试修复格式
                    try {
                        const fixedArgs = fixToolCallsFormat(`{"arguments": "${toolCall.function.arguments}"}`);
                        const parsed = JSON.parse(fixedArgs);
                        functionArgs = JSON.parse(parsed.arguments);
                        console.log('✅ processToolCalls 修复后参数:', functionArgs);
                    } catch (fixError) {
                        console.error('❌ processToolCalls 无法修复参数，跳过此工具调用:', fixError);
                        continue; // 跳过这个工具调用，继续下一个
                    }
                }
                
                console.log(`🛠️ 执行函数: ${functionName}, 参数:`, functionArgs);

                // 执行本地函数
                let toolResult;
                switch (functionName) {
                    case 'getMoments':
                        toolResult = await getMoments(functionArgs);
                        break;
                    case 'getAvailableStickers':
                        toolResult = await getAvailableStickers();
                        break;
                    case 'sendSticker':
                        toolResult = await sendStickerByAI(functionArgs);
                        break;
                    case 'getLatestFootprint':
                        toolResult = await getLatestFootprint();
                        break;
                    case 'getFootprintHistory':
                        toolResult = await getFootprintHistory(functionArgs);
                        break;
                    case 'getFootprintsByDate':
                        toolResult = await getFootprintsByDate(functionArgs);
                        break;
                    case 'manageAccounting':
                        toolResult = await manageAccountingTool(functionArgs);
                        break;
                    case 'getHealthData':
                        if (functionArgs.detail === 'summary') {
                            toolResult = await getHealthSummaryForAI();
                        } else {
                            toolResult = await getHealthDataForAI();
                        }
                        break;
                    case 'submitDemonQuizAnswer':
                        toolResult = await submitDemonQuizAnswer(functionArgs);
                        break;
                    case 'getDemonQuizResult':
                        toolResult = await getDemonQuizResult();
                        break;
                    case 'createDemonQuiz':
                        toolResult = await createDemonQuiz(functionArgs);
                        break;
                    case 'submitUserDemonQuizAnswer':
                        toolResult = await submitUserDemonQuizAnswer(functionArgs);
                        break;
                    case 'createAngelQuiz':
                        toolResult = await createAngelQuiz(functionArgs);
                        break;
                    case 'submitAngelQuizAnswer':
                        toolResult = await submitAngelQuizAnswer(functionArgs);
                        break;
                    case 'getAngelQuizList':
                        toolResult = await getAngelQuizList(functionArgs);
                        break;
                    case 'getAngelQuizDetail':
                        toolResult = await getAngelQuizDetail(functionArgs);
                        break;
                    case 'postWeibo':
                        // 发微博工具
                        console.log('【微博AI】processToolCalls 处理 postWeibo 工具调用');
                        toolResult = await postWeiboTool(functionArgs);
                        break;
                    case 'getWeiboHotSearch':
                        // 微博热搜工具
                        console.log('【微博AI】processToolCalls 处理 getWeiboHotSearch 工具调用');
                        toolResult = await getWeiboHotSearchTool();
                        break;
                    case 'startFocusMode':
                        toolResult = await startFocusModeTool(functionArgs);
                        break;
                    case 'releaseFromBlackRoom':
                        toolResult = await releaseFromBlackRoomTool(functionArgs);
                        break;
                    case 'extendBlackRoomTime':
                        toolResult = await extendBlackRoomTimeTool(functionArgs);
                        break;
                    case 'getBlackRoomStatus':
                        toolResult = await getBlackRoomStatusTool(functionArgs);
                        break;
                    case 'manage_super_memo':
                        toolResult = await manageSuperMemoTool(functionArgs);
                        break;
                    case 'updateProfile':
                        toolResult = await updateAIProfile(functionArgs, chatItem.id);
                        break;
                    default:
                        console.error('未知函数:', functionName);
                        continue;
                }
                console.log(`✅ 函数执行结果:`, toolResult);
                
                // 添加工具结果到消息历史
                messages.push({
                    role: 'tool',
                    tool_call_id: toolCall.id,
                    content: JSON.stringify(toolResult)
                });
            }
            
            // 发送所有工具结果给AI
            console.log('📤 发送工具结果给AI（链式调用）');
            console.log('📤 消息数量:', messages.length);
            console.log('📤 消息内容预览:', JSON.stringify(messages.slice(-2)).substring(0, 500));
            
            // 使用自定义工具列表（如果有）
            const toolsList = customTools && customTools.length > 0 ? customTools : TOOLS_DEFINITION;
            console.log('📤 使用工具列表:', customTools ? '自定义工具' : '默认工具');
            
            const requestBody = {
                model: actualModel,
                messages: messages,
                tools: toolsList
                // 注意：不使用 response_format: json_object，让AI自由回复或使用tool
            };
            console.log('📤 请求体大小:', JSON.stringify(requestBody).length, '字符');
            console.log('📤 使用API:', useSecondaryApi ? '副API' : '主API');
            console.log('📤 模型:', actualModel);

            // 【修复】添加超时处理，防止请求卡住
            const controller = new AbortController();
            const timeoutId = setTimeout(() => controller.abort(), 300000); // 【修改】300秒超时

            const toolResponse = await fetch(`${actualBaseUrl}/chat/completions`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Authorization': `Bearer ${actualApiKey}`
                },
                body: JSON.stringify(requestBody),
                signal: controller.signal
            });

            clearTimeout(timeoutId); // 请求成功，清除超时

            if (!toolResponse.ok) {
                const errorText = await toolResponse.text();
                console.error('❌ 工具响应失败:', toolResponse.status, toolResponse.statusText);
                console.error('❌ 错误详情:', errorText);
                throw new Error(`工具响应失败: ${toolResponse.statusText} - ${errorText}`);
            }

            // 【修复】获取响应文本并检查是否为JSON格式
            const toolResponseText = await toolResponse.text();
            let toolData;
            try {
                toolData = JSON.parse(toolResponseText);
            } catch (parseError) {
                console.error('❌ 链式工具调用API返回的不是JSON格式:', toolResponseText.substring(0, 500));
                if (toolResponseText.trim().startsWith('<')) {
                    const htmlError = extractHtmlErrorMessage(toolResponseText);
                    if (htmlError) {
                        throw new Error(`API错误: ${htmlError}，请检查API配置或稍后重试`);
                    }
                    throw new Error('API返回了HTML页面而不是JSON，可能是API配置错误或网络问题');
                }
                throw new Error(`JSON解析失败: ${parseError.message}`);
            }
            const toolMessage = toolData.choices[0].message;
            const toolMessageContent = toolMessage.content;
            
            console.log('📨 AI收到工具结果后的响应（链式）:', toolMessageContent);
            
            // 检查是否还有更多工具调用
            if (toolMessage.tool_calls && toolMessage.tool_calls.length > 0) {
                console.log('🔄 继续链式工具调用');
                // 添加 assistant 消息到历史（有 tool_calls 时 content 必须为 null）
                messages.push({
                    role: 'assistant',
                    content: null,
                    tool_calls: toolMessage.tool_calls
                });
                return await processToolCalls(toolMessage.tool_calls, messages, systemPrompt, userMessage, baseUrl, apiKey, model, customTools, useSecondaryApi, secondaryBaseUrl, secondaryApiKey, secondaryModel);
            }
            
            // 直接返回AI的回复内容（心声应该通过saveInnerThought tool保存）
            // 【修复】检查是否有暂存的心声，如果有则返回
            let thoughtResult = '';
            if (pendingInnerThought && String(pendingInnerThoughtAIId) === String(currentChatId)) {
                thoughtResult = pendingInnerThought;
                console.log('【心声修复】链式调用返回暂存的心声:', thoughtResult.substring(0, 50) + '...');
            }
            
            return {
                reply: toolMessageContent || '',
                thought: thoughtResult
            };
        }

        // ==================== 朋友圈Tool函数 ====================
        
        // 获取朋友圈列表
        async function getMoments(args) {
            const limit = args.limit || 5;
            const moments = relationshipData.moments || [];
            const recentMoments = moments.slice(0, limit);
            
            return {
                moments: recentMoments.map(moment => ({
                    id: moment.id,
                    authorId: moment.authorId,
                    authorName: moment.authorName,
                    content: moment.content,
                    type: moment.type,
                    createdAt: moment.createdAt,
                    likesCount: moment.likes ? moment.likes.length : 0,
                    commentsCount: moment.comments ? moment.comments.length : 0
                })),
                total: moments.length
            };
        }
        
        // 点赞朋友圈
        async function likeMoment(args) {
            const { momentId } = args;
            const moment = relationshipData.moments.find(m => m.id === momentId);
            
            if (!moment) {
                return { success: false, error: '未找到该朋友圈' };
            }
            
            // 获取当前AI的ID
            const currentChatItem = relationshipData.wechatChatList.find(item => item.id == currentChatId);
            const aiId = currentChatItem ? 'ai_' + currentChatItem.id : 'ai_unknown';
            const aiName = currentChatItem ? (currentChatItem.remark || currentChatItem.name) : 'AI';
            
            // 检查是否已经点赞过
            if (moment.likes && moment.likes.some(like => like.id === aiId)) {
                return { success: false, error: '已经点赞过了' };
            }
            
            // 添加点赞
            if (!moment.likes) moment.likes = [];
            moment.likes.push({
                id: aiId,
                name: aiName
            });
            
            await saveData();
            
            // 如果在朋友圈页面，刷新列表
            if (document.getElementById('momentsPage')?.style.display === 'flex') {
                renderMomentsList();
            }
            
            return { success: true, message: '点赞成功' };
        }
        
        // 评论朋友圈
        async function commentMoment(args) {
            const { momentId, content } = args;
            const moment = relationshipData.moments.find(m => m.id === momentId);
            
            if (!moment) {
                return { success: false, error: '未找到该朋友圈' };
            }
            
            // 获取当前AI的信息
            const currentChatItem = relationshipData.wechatChatList.find(item => item.id == currentChatId);
            const aiId = currentChatItem ? 'ai_' + currentChatItem.id : 'ai_unknown';
            const aiName = currentChatItem ? (currentChatItem.remark || currentChatItem.name) : 'AI';
            const aiAvatar = currentChatItem ? currentChatItem.avatar : '';
            
            // 添加评论
            if (!moment.comments) moment.comments = [];
            moment.comments.push({
                id: Date.now(),
                authorId: aiId,
                name: aiName,
                avatar: aiAvatar,
                content: content,
                createdAt: new Date().toISOString()
            });
            
            await saveData();
            
            // 如果在朋友圈页面，刷新列表
            if (document.getElementById('momentsPage')?.style.display === 'flex') {
                renderMomentsList();
            }
            
            return { success: true, message: '评论成功' };
        }
        
        // 发布朋友圈
        async function postMoment(args) {
            const { content } = args;
            
            // 获取当前AI的信息
            const currentChatItem = relationshipData.wechatChatList.find(item => item.id == currentChatId);
            const aiId = currentChatItem ? 'ai_' + currentChatItem.id : 'ai_unknown';
            const aiName = currentChatItem ? (currentChatItem.remark || currentChatItem.name) : 'AI';
            const aiAvatar = currentChatItem ? currentChatItem.avatar : '';
            
            // 创建朋友圈对象
            const moment = {
                id: Date.now(),
                authorId: aiId,
                authorName: aiName,
                authorAvatar: aiAvatar,
                content: content,
                type: 'text',
                createdAt: new Date().toISOString(),
                likes: [],
                comments: []
            };
            
            // 添加到朋友圈列表
            if (!relationshipData.moments) {
                relationshipData.moments = [];
            }
            relationshipData.moments.unshift(moment);
            
            await saveData();
            
            // 如果在朋友圈页面，刷新列表
            if (document.getElementById('momentsPage')?.style.display === 'flex') {
                renderMomentsList();
            }
            
            // 【NPC自动评论】触发NPC对AI朋友圈的评论
            triggerNPCComments(moment, 'ai');
            
            return { success: true, message: '发布成功', momentId: moment.id };
        }

        // ==================== 微博Tool函数开始 ====================

        // 发布微博
        async function postWeiboTool(args) {
            const { content } = args;

            console.log('【微博工具】AI要发布微博:', content);

            // 获取当前AI的信息
            const currentChatItem = relationshipData.wechatChatList.find(item => item.id == currentChatId);
            const aiId = currentChatItem ? 'ai_' + currentChatItem.id : 'ai_unknown';
            const aiName = currentChatItem ? (currentChatItem.remark || currentChatItem.name) : 'AI';
            const aiAvatar = currentChatItem ? currentChatItem.avatar : '';

            // 创建微博对象
            const weiboPost = {
                id: 'weibo_' + Date.now(),
                userId: aiId,
                userName: aiName,
                userAvatar: aiAvatar,
                content: content,
                images: [],
                createdAt: new Date().toLocaleString('zh-CN'),
                likes: 0,
                comments: 0,
                isMy: false
            };

            // 保存到AI的微博列表
            const aiWeiboKey = 'weiboAIPosts_' + currentChatId;
            let aiWeiboPosts = await localforage.getItem(aiWeiboKey) || [];
            aiWeiboPosts.unshift(weiboPost);
            await localforage.setItem(aiWeiboKey, aiWeiboPosts);

            // 同时添加到微博动态列表
            const weiboFeedKey = 'weiboFeed';
            let weiboFeed = await localforage.getItem(weiboFeedKey) || [];
            weiboFeed.unshift(weiboPost);
            await localforage.setItem(weiboFeedKey, weiboFeed);

            console.log('【微博工具】微博发布成功:', weiboPost.id);

            return { success: true, message: '微博发布成功！', weiboId: weiboPost.id };
        }

        // 获取微博热搜
        async function getWeiboHotSearchTool() {
            console.log('【微博工具】获取微博热搜');

            // 从微博热搜数据中获取
            const hotSearchData = await localforage.getItem('weiboHotSearch') || [];
            const topHotSearch = hotSearchData.slice(0, 10);

            if (topHotSearch.length > 0) {
                const hotSearchList = topHotSearch.map((item, index) => `${index + 1}. ${item.title} (热度: ${item.heat})`).join('\n');
                return {
                    success: true,
                    message: `当前热搜榜：\n${hotSearchList}`
                };
            } else {
                // 如果没有数据，返回默认热搜
                const defaultHotSearch = [
                    { title: '明星公益活动引发关注', heat: '256万' },
                    { title: '新电影上映', heat: '180万' },
                    { title: '科技新品发布会', heat: '150万' },
                    { title: '体育赛事精彩瞬间', heat: '120万' },
                    { title: '美食推荐', heat: '95万' },
                    { title: '旅游攻略', heat: '80万' },
                    { title: '健康养生知识', heat: '65万' },
                    { title: '教育改革新政策', heat: '55万' }
                ];
                const hotSearchList = defaultHotSearch.map((item, index) => `${index + 1}. ${item.title} (热度: ${item.heat})`).join('\n');
                return {
                    success: true,
                    message: `当前热搜榜：\n${hotSearchList}`
                };
            }
        }

        // ==================== 表情包Tool函数开始 ====================

        // AI表情包缓存，用于保证getAvailableStickers和sendStickerByAI使用同一数据源
        let aiStickerCache = [];

        // 获取可用的表情包列表
        async function getAvailableStickers() {
            console.log('🎭 AI获取表情包列表');

            // 从localforage加载表情包数据
            const savedStickers = await localforage.getItem('chatStickers') || [];

            if (!savedStickers || savedStickers.length === 0) {
                aiStickerCache = [];
                return {
                    success: true,
                    message: '当前没有可用的表情包',
                    stickers: []
                };
            }

            // 缓存表情包数据，确保后续sendStickerByAI使用同一数据源
            aiStickerCache = savedStickers;

            // 返回表情包列表（包含索引、标签和URL）
            const stickerList = savedStickers.map((sticker, index) => ({
                index: index,
                label: sticker.label,
                url: sticker.url
            }));

            console.log(`🎭 返回 ${stickerList.length} 个表情包`);

            return {
                success: true,
                message: `找到 ${stickerList.length} 个表情包`,
                stickers: stickerList
            };
        }

        // AI发送表情包
        async function sendStickerByAI(args) {
            const { index } = args;
            console.log(`🎭 AI发送表情包，索引: ${index}`);

            // 使用缓存的数据，确保与getAvailableStickers返回的列表一致
            const savedStickers = aiStickerCache;

            if (!savedStickers || savedStickers.length === 0) {
                return {
                    success: false,
                    message: '表情包列表为空，请先获取表情包列表'
                };
            }

            if (index < 0 || index >= savedStickers.length) {
                return {
                    success: false,
                    message: '表情包索引无效'
                };
            }

            const sticker = savedStickers[index];
            
            // 构建表情包消息内容
            const stickerContent = `[STICKER]${sticker.url}|${sticker.label}[/STICKER]`;
            
            // 【修复】使用数字时间戳
            const aiStickerTimestamp = Date.now();
            
            // 显示表情包消息
            displayMessage('ai', stickerContent, false, null, 'sticker', true, aiStickerTimestamp);
            
            // 保存到聊天记录
            const messageData = {
                id: aiStickerTimestamp,
                chatId: currentChatId,
                sender: 'ai',
                type: 'sticker',
                content: stickerContent,
                stickerUrl: sticker.url,
                stickerLabel: sticker.label,
                timestamp: aiStickerTimestamp  // 【修复】使用数字时间戳
            };
            
            relationshipData.chatMessages.push(messageData);
            await saveData();
            
            // 【修复】增加AI消息计数
            await incrementAIMessageCount(currentChatId);
            
            console.log('🎭 AI表情包发送成功:', sticker.label);
            
            return {
                success: true,
                message: '表情包发送成功',
                stickerLabel: sticker.label
            };
        }

        // ==================== 足迹Tool函数 ====================
        
        // 检查是否有情侣空间权限
        function checkCoupleSpacePermission() {
            // 检查是否开启了情侣空间
            if (!relationshipData.coupleSpaceEnabled) {
                return {
                    hasPermission: false,
                    message: '未开启情侣空间，无法查看足迹'
                };
            }
            
            // 检查当前AI是否是伴侣
            if (!relationshipData.couplePartnerId || currentChatId != relationshipData.couplePartnerId) {
                return {
                    hasPermission: false,
                    message: '只有情侣空间的伴侣才能查看足迹'
                };
            }
            
            return { hasPermission: true };
        }
        
        // 获取最新足迹
        async function getLatestFootprint() {
            try {
                // 检查权限
                const permissionCheck = checkCoupleSpacePermission();
                if (!permissionCheck.hasPermission) {
                    return {
                        success: false,
                        message: permissionCheck.message,
                        footprint: null,
                        requireCoupleSpace: true
                    };
                }
                
                const latestFootprint = await localforage.getItem('latestFootprint');
                
                if (!latestFootprint) {
                    return {
                        success: false,
                        message: '暂无足迹记录',
                        footprint: null
                    };
                }
                
                // 记录AI查看足迹的动态
                logCoupleActivity('footprint');
                
                // 格式化时间
                const timeStr = new Date(latestFootprint.timestamp).toLocaleString('zh-CN', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric',
                    hour: '2-digit',
                    minute: '2-digit',
                    second: '2-digit'
                });
                
                return {
                    success: true,
                    message: '获取最新足迹成功',
                    footprint: {
                        latitude: latestFootprint.latitude,
                        longitude: latestFootprint.longitude,
                        address: latestFootprint.address || '未知位置',
                        timestamp: latestFootprint.timestamp,
                        formattedTime: timeStr
                    }
                };
            } catch (error) {
                console.error('获取最新足迹失败:', error);
                return {
                    success: false,
                    message: '获取足迹失败: ' + error.message,
                    footprint: null
                };
            }
        }
        
        // 获取足迹历史
        async function getFootprintHistory(args = {}) {
            try {
                // 检查权限
                const permissionCheck = checkCoupleSpacePermission();
                if (!permissionCheck.hasPermission) {
                    return {
                        success: false,
                        message: permissionCheck.message,
                        footprints: [],
                        total: 0,
                        requireCoupleSpace: true
                    };
                }
                
                const limit = Math.min(args.limit || 10, 50); // 最多50条
                let footprints = await localforage.getItem('footprints') || [];
                
                // 取最近的记录
                const recentFootprints = footprints.slice(0, limit);
                
                if (recentFootprints.length === 0) {
                    return {
                        success: false,
                        message: '暂无足迹历史记录',
                        footprints: [],
                        total: 0
                    };
                }
                
                // 记录AI查看足迹历史的动态
                logCoupleActivity('footprint_history');
                
                // 格式化足迹数据
                const formattedFootprints = recentFootprints.map((fp, index) => {
                    const timeStr = new Date(fp.timestamp).toLocaleString('zh-CN', {
                        month: 'short',
                        day: 'numeric',
                        hour: '2-digit',
                        minute: '2-digit'
                    });
                    
                    return {
                        index: index + 1,
                        latitude: fp.latitude,
                        longitude: fp.longitude,
                        address: fp.address || '未知位置',
                        timestamp: fp.timestamp,
                        formattedTime: timeStr
                    };
                });
                
                return {
                    success: true,
                    message: `获取到 ${formattedFootprints.length} 条足迹记录`,
                    footprints: formattedFootprints,
                    total: footprints.length
                };
            } catch (error) {
                console.error('获取足迹历史失败:', error);
                return {
                    success: false,
                    message: '获取足迹历史失败: ' + error.message,
                    footprints: [],
                    total: 0
                };
            }
        }
        
        // 按日期范围获取足迹
        async function getFootprintsByDate(args) {
            try {
                // 检查权限
                const permissionCheck = checkCoupleSpacePermission();
                if (!permissionCheck.hasPermission) {
                    return {
                        success: false,
                        message: permissionCheck.message,
                        footprints: [],
                        dateRange: args,
                        requireCoupleSpace: true
                    };
                }
                
                const { startDate, endDate } = args;
                let footprints = await localforage.getItem('footprints') || [];
                
                // 过滤日期范围
                const start = new Date(startDate);
                start.setHours(0, 0, 0, 0);
                const end = new Date(endDate);
                end.setHours(23, 59, 59, 999);
                
                const filteredFootprints = footprints.filter(fp => {
                    const fpTime = new Date(fp.timestamp);
                    return fpTime >= start && fpTime <= end;
                });
                
                if (filteredFootprints.length === 0) {
                    return {
                        success: false,
                        message: `在 ${startDate} 到 ${endDate} 期间没有足迹记录`,
                        footprints: [],
                        dateRange: { startDate, endDate }
                    };
                }
                
                // 记录AI查看足迹历史的动态
                logCoupleActivity('footprint_history');
                
                // 格式化足迹数据
                const formattedFootprints = filteredFootprints.map((fp, index) => {
                    const timeStr = new Date(fp.timestamp).toLocaleString('zh-CN', {
                        year: 'numeric',
                        month: 'long',
                        day: 'numeric',
                        hour: '2-digit',
                        minute: '2-digit'
                    });
                    
                    return {
                        index: index + 1,
                        latitude: fp.latitude,
                        longitude: fp.longitude,
                        address: fp.address || '未知位置',
                        timestamp: fp.timestamp,
                        formattedTime: timeStr
                    };
                });
                
                return {
                    success: true,
                    message: `在 ${startDate} 到 ${endDate} 期间找到 ${formattedFootprints.length} 条足迹`,
                    footprints: formattedFootprints,
                    dateRange: { startDate, endDate },
                    total: filteredFootprints.length
                };
            } catch (error) {
                console.error('按日期获取足迹失败:', error);
                return {
                    success: false,
                    message: '获取足迹失败: ' + error.message,
                    footprints: [],
                    dateRange: { startDate, endDate }
                };
            }
        }

        // ==================== 记账查看Tool函数 ====================

        // 管理记账查看（合并三个功能）
        async function manageAccountingTool(args) {
            try {
                const { action, limit = 10, dateRange = 'week' } = args || {};
                
                switch (action) {
                    case 'records':
                        return await getAccountingRecords(limit, dateRange);
                    case 'summary':
                        return await getAccountingSummary();
                    case 'comment':
                        return await getAccountingComment();
                    default:
                        return {
                            success: false,
                            message: '未知的操作类型: ' + action
                        };
                }
            } catch (error) {
                console.error('记账查看失败:', error);
                return {
                    success: false,
                    message: '记账查看失败: ' + error.message
                };
            }
        }

        // 查看消费记录
        async function getAccountingRecords(limit = 10, dateRange = 'week') {
            // 获取记账数据
            const accountingData = await localforage.getItem('accountingData') || { records: [] };
            let records = accountingData.records || [];
            
            // 根据日期范围过滤
            const now = new Date();
            let filteredRecords = records;
            
            if (dateRange === 'today') {
                const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
                filteredRecords = records.filter(r => new Date(r.date) >= today);
            } else if (dateRange === 'week') {
                const weekStart = new Date(now);
                weekStart.setDate(now.getDate() - now.getDay());
                weekStart.setHours(0, 0, 0, 0);
                filteredRecords = records.filter(r => new Date(r.date) >= weekStart);
            }
            
            // 限制数量
            filteredRecords = filteredRecords.slice(0, limit);
            
            // 格式化记录
            const formattedRecords = filteredRecords.map((record, index) => ({
                index: index + 1,
                date: record.date,
                type: record.type || '其他',
                item: record.item || '未知项目',
                amount: record.amount || 0,
                formattedAmount: `¥${(record.amount || 0).toFixed(2)}`
            }));
            
            return {
                success: true,
                message: `找到 ${formattedRecords.length} 条消费记录`,
                records: formattedRecords,
                totalCount: formattedRecords.length,
                dateRange: dateRange
            };
        }

        // 查看本周记账表现
        async function getAccountingSummary() {
            // 获取记账数据
            const accountingData = await localforage.getItem('accountingData') || {};
            const weekFlowers = accountingData.weekFlowers || 0;
            const lightningCount = accountingData.lightningCount || 0;
            const totalBudget = accountingData.totalBudget || 0;
            const remainingBudget = accountingData.remainingBudget || 0;
            
            // 计算本周消费总额
            const now = new Date();
            const weekStart = new Date(now);
            weekStart.setDate(now.getDate() - now.getDay());
            weekStart.setHours(0, 0, 0, 0);
            
            const records = accountingData.records || [];
            const weekRecords = records.filter(r => new Date(r.date) >= weekStart);
            const weekExpense = weekRecords.reduce((sum, r) => sum + (r.amount || 0), 0);
            
            // 判断状态
            let status = '需努力';
            if (lightningCount > 0) {
                const levels = ['不好', '很不好', '非常不好', '魔丸'];
                status = levels[lightningCount - 1] || '不好';
            } else if (weekFlowers === 0) {
                status = '需努力';
            } else if (weekFlowers === 4) {
                status = '灵珠';
            } else {
                status = '良好';
            }
            
            return {
                success: true,
                message: '获取本周表现成功',
                summary: {
                    weekFlowers: weekFlowers,
                    lightningCount: lightningCount,
                    totalBudget: totalBudget,
                    remainingBudget: remainingBudget,
                    weekExpense: weekExpense,
                    status: status,
                    flowerIcons: '🌸'.repeat(weekFlowers),
                    lightningIcons: '⚡'.repeat(lightningCount)
                }
            };
        }

        // 查看本周评语
        async function getAccountingComment() {
            // 获取记账数据
            const accountingData = await localforage.getItem('accountingData') || {};
            const lastComment = accountingData.lastComment || '本周还未评价';
            const lastCommentTime = accountingData.lastCommentTime;
            
            // 获取AI评价者信息
            const aiEvaluator = accountingData.aiEvaluator || { name: 'AI助手' };
            
            let commentTimeStr = '暂无';
            if (lastCommentTime) {
                commentTimeStr = new Date(lastCommentTime).toLocaleString('zh-CN', {
                    month: 'short',
                    day: 'numeric',
                    hour: '2-digit',
                    minute: '2-digit'
                });
            }
            
            return {
                success: true,
                message: '获取评语成功',
                comment: {
                    content: lastComment,
                    evaluator: aiEvaluator.name,
                    time: commentTimeStr,
                    hasComment: !!accountingData.lastComment
                }
            };
        }

        // ==================== 恶魔挑战Tool函数 ====================
        
        // 提交恶魔问卷答案
        async function submitDemonQuizAnswer(args) {
            try {
                const { answers, quizId } = args;
                
                // 获取所有问卷数据
                let allQuizzes = await loadDemonQuizzesUnified([]);
                if (allQuizzes.length === 0) {
                    const localData = JSON.stringify(await loadDemonQuizzesUnified([]));
                    if (localData) {
                        allQuizzes = JSON.parse(localData);
                    }
                }
                
                // 找到要提交的问卷
                let quizIndex = -1;
                let quizData = null;
                
                if (quizId) {
                    quizIndex = allQuizzes.findIndex(q => q.id === quizId);
                    if (quizIndex >= 0) {
                        quizData = allQuizzes[quizIndex];
                    }
                } else {
                    // 如果没有指定ID，找到用户创建且未回答的问卷
                    quizIndex = allQuizzes.findIndex(q => q.createdBy === 'user' && !q.aiAnswered);
                    if (quizIndex >= 0) {
                        quizData = allQuizzes[quizIndex];
                    }
                }
                
                if (!quizData || !quizData.questions) {
                    return {
                        success: false,
                        message: '没有找到问卷数据'
                    };
                }
                
                // 保存AI的答案
                currentDemonQuizAnswers = answers;
                currentDemonQuizCorrectAnswers = quizData.questions.map(q => q.correctAnswer);
                
                // 计算答对的题目
                let correctCount = 0;
                const results = [];
                
                answers.forEach((ans) => {
                    // questionIndex 是从1开始的，需要减1转换为数组索引
                    const questionArrayIndex = ans.questionIndex - 1;
                    const question = quizData.questions[questionArrayIndex];
                    
                    if (!question) {
                        console.warn(`找不到第 ${ans.questionIndex} 题`);
                        return;
                    }
                    
                    const isCorrect = ans.answer === question.correctAnswer;
                    if (isCorrect) correctCount++;
                    
                    results.push({
                        questionIndex: ans.questionIndex,
                        question: question.question,
                        yourAnswer: ans.answer,
                        correctAnswer: question.correctAnswer,
                        isCorrect: isCorrect,
                        options: question.options
                    });
                });
                
                // 保存结果
                quizData.aiAnswered = true;
                quizData.aiAnswers = answers;
                quizData.aiCorrectCount = correctCount;
                quizData.aiResults = results;
                quizData.answeredAt = new Date().toISOString();
                
                // 更新数组
                allQuizzes[quizIndex] = quizData;
                
                await saveDemonQuizzesUnified(allQuizzes);
                await saveDemonQuizzesUnified(allQuizzes);
                
                // 刷新卡片显示
                const coupleQuizPage = document.getElementById('coupleQuizPage');
                if (coupleQuizPage && coupleQuizPage.style.display === 'flex') {
                    await renderAllDemonQuizCards();
                }
                
                return {
                    success: true,
                    message: `答案已提交！你答对了 ${correctCount}/${answers.length} 道题`,
                    correctCount: correctCount,
                    totalQuestions: answers.length,
                    results: results
                };
            } catch (error) {
                console.error('提交答案失败:', error);
                return {
                    success: false,
                    message: '提交答案失败: ' + error.message
                };
            }
        }
        
        // 获取恶魔问卷结果
        async function getDemonQuizResult(args = {}) {
            try {
                const { quizId } = args;
                
                // 获取所有问卷数据
                let allQuizzes = await loadDemonQuizzesUnified([]);
                if (allQuizzes.length === 0) {
                    const localData = JSON.stringify(await loadDemonQuizzesUnified([]));
                    if (localData) {
                        allQuizzes = JSON.parse(localData);
                    }
                }
                
                // 找到指定的问卷
                let quizData = null;
                if (quizId) {
                    quizData = allQuizzes.find(q => q.id === quizId);
                } else {
                    // 如果没有指定ID，找到最新的已回答问卷
                    quizData = allQuizzes.filter(q => q.aiAnswered).pop();
                }
                
                if (!quizData || !quizData.aiAnswered) {
                    return {
                        success: false,
                        message: '还没有答题记录，请先提交答案'
                    };
                }
                
                return {
                    success: true,
                    message: `你答对了 ${quizData.aiCorrectCount}/${quizData.questions.length} 道题！`,
                    correctCount: quizData.aiCorrectCount,
                    totalQuestions: quizData.questions.length,
                    results: quizData.aiResults || [],
                    answeredAt: quizData.answeredAt
                };
            } catch (error) {
                console.error('获取结果失败:', error);
                return {
                    success: false,
                    message: '获取结果失败: ' + error.message
                };
            }
        }

        // AI创建恶魔问卷
        async function createDemonQuiz(args) {
            try {
                const { questions } = args;
                
                if (!questions || questions.length === 0) {
                    return {
                        success: false,
                        message: '题目不能为空'
                    };
                }
                
                // 获取AI头像
                const aiAvatar = relationshipData.couplePartnerAvatar || relationshipData.avatar2 || '';
                
                // 生成唯一ID
                const quizId = generateQuizId();
                
                // 构建问卷数据
                const quizData = {
                    id: quizId,
                    questions: questions,
                    createdBy: 'ai',
                    creatorAvatar: aiAvatar,
                    createdAt: new Date().toISOString(),
                    aiAnswered: false,
                    userAnswered: false,
                    aiAnswers: [],
                    aiCorrectCount: 0,
                    userAnswers: [],
                    userCorrectCount: 0
                };
                
                // 获取现有问卷数组（只从localforage获取，避免localStorage容量限制）
                let allQuizzes = await loadDemonQuizzesUnified([]);
                
                // 检查问卷数量，如果太多则删除旧的
                if (allQuizzes.length >= 50) {
                    allQuizzes = allQuizzes.slice(-49); // 保留最近49个
                    console.log('问卷数量过多，已删除旧问卷');
                }
                
                // 添加新问卷
                allQuizzes.push(quizData);
                
                // 只保存到localforage（IndexedDB容量更大）
                await saveDemonQuizzesUnified(allQuizzes);
                
                // 尝试保存到localStorage，如果失败则忽略（作为备份）
                try {
                    await saveDemonQuizzesUnified(allQuizzes);
                } catch (storageError) {
                    console.warn('localStorage保存失败（容量超限），但IndexedDB已保存成功:', storageError);
                }
                
                // 更新全局变量
                currentQuizQuestions = questions;
                
                // 如果在情侣空间页面，刷新卡片显示
                const coupleQuizPage = document.getElementById('coupleQuizPage');
                if (coupleQuizPage && coupleQuizPage.style.display === 'flex') {
                    await renderAllDemonQuizCards();
                }
                
                return {
                    success: true,
                    message: `恶魔挑战问卷已创建！共 ${questions.length} 道题目`,
                    questionCount: questions.length
                };
            } catch (error) {
                console.error('创建问卷失败:', error);
                return {
                    success: false,
                    message: '创建问卷失败: ' + error.message
                };
            }
        }
        
        // 用户提交恶魔问卷答案（AI创建的问卷）
        async function submitUserDemonQuizAnswer(args) {
            try {
                const { answers, quizId } = args;
                
                // 获取所有问卷数据
                let allQuizzes = await loadDemonQuizzesUnified([]);
                if (allQuizzes.length === 0) {
                    const localData = JSON.stringify(await loadDemonQuizzesUnified([]));
                    if (localData) {
                        allQuizzes = JSON.parse(localData);
                    }
                }
                
                // 找到要提交的问卷
                let quizIndex = -1;
                let quizData = null;
                
                if (quizId) {
                    quizIndex = allQuizzes.findIndex(q => q.id === quizId);
                    if (quizIndex >= 0) {
                        quizData = allQuizzes[quizIndex];
                    }
                } else {
                    // 如果没有指定ID，找到AI创建且未回答的问卷
                    quizIndex = allQuizzes.findIndex(q => q.createdBy === 'ai' && !q.userAnswered);
                    if (quizIndex >= 0) {
                        quizData = allQuizzes[quizIndex];
                    }
                }
                
                if (!quizData || !quizData.questions) {
                    return {
                        success: false,
                        message: '没有找到问卷数据'
                    };
                }
                
                // 计算答对的题目
                let correctCount = 0;
                const results = [];
                
                answers.forEach((ans) => {
                    const questionArrayIndex = ans.questionIndex - 1;
                    const question = quizData.questions[questionArrayIndex];
                    
                    if (!question) {
                        console.warn(`找不到第 ${ans.questionIndex} 题`);
                        return;
                    }
                    
                    const isCorrect = ans.answer === question.correctAnswer;
                    if (isCorrect) correctCount++;
                    
                    results.push({
                        questionIndex: ans.questionIndex,
                        question: question.question,
                        userAnswer: ans.answer,
                        correctAnswer: question.correctAnswer,
                        isCorrect: isCorrect,
                        options: question.options
                    });
                });
                
                // 保存用户答案
                quizData.userAnswered = true;
                quizData.userAnswers = answers;
                quizData.userCorrectCount = correctCount;
                quizData.userResults = results;
                quizData.userAnsweredAt = new Date().toISOString();
                
                // 更新数组
                allQuizzes[quizIndex] = quizData;
                
                await saveDemonQuizzesUnified(allQuizzes);
                await saveDemonQuizzesUnified(allQuizzes);
                
                // 刷新卡片显示
                const coupleQuizPage = document.getElementById('coupleQuizPage');
                if (coupleQuizPage && coupleQuizPage.style.display === 'flex') {
                    await renderAllDemonQuizCards();
                }
                
                return {
                    success: true,
                    message: `用户答案已提交！答对了 ${correctCount}/${answers.length} 道题`,
                    correctCount: correctCount,
                    totalQuestions: answers.length,
                    results: results
                };
            } catch (error) {
                console.error('提交用户答案失败:', error);
                return {
                    success: false,
                    message: '提交用户答案失败: ' + error.message
                };
            }
        }

        // ==================== 朋友圈Tool函数结束 ====================

        // ========== 天使问答功能 ==========
        
        // 打开天使问答（直接显示添加题目弹窗）
        function openAngelChallenge() {
            const modal = document.getElementById('angelQuestionModal');
            if (modal) {
                modal.style.display = 'flex';
                currentAngelQuestions = [];
                currentAngelQuestionIndex = 0;
                updateAngelQuestionNum();
                document.getElementById('angelQuestionInput').value = '';
                document.getElementById('angelQuestionPreview').textContent = '请输入题目...';
            }
        }
        
        // 关闭天使问答弹窗
        function closeAngelQuestionModal() {
            const modal = document.getElementById('angelQuestionModal');
            if (modal) {
                modal.style.display = 'none';
            }
        }
        
        // 更新天使题号显示
        function updateAngelQuestionNum() {
            const numEl = document.getElementById('currentAngelQuestionNum');
            if (numEl) {
                numEl.textContent = currentAngelQuestionIndex + 1;
            }
        }
        
        // 更新天使题目预览
        function updateAngelQuestionPreview() {
            const input = document.getElementById('angelQuestionInput');
            const preview = document.getElementById('angelQuestionPreview');
            if (input && preview) {
                preview.textContent = input.value || '请输入题目...';
            }
        }
        
        // 添加下一道天使题目
        async function addNextAngelQuestion() {
            const input = document.getElementById('angelQuestionInput');
            const question = input.value.trim();
            
            if (!question) {
                showCustomAlert('提示', '请输入题目内容', 'warning');
                return;
            }
            
            currentAngelQuestions.push({
                question: question,
                answer: ''
            });
            
            currentAngelQuestionIndex++;
            
            if (currentAngelQuestionIndex >= 5) {
                // 完成所有题目，创建卡片
                await createAngelQuizCard();
                closeAngelQuestionModal();
            } else {
                // 继续下一题
                input.value = '';
                updateAngelQuestionNum();
                updateAngelQuestionPreview();
            }
        }
        
        // 提前结束天使题目添加
        async function finishAngelQuestionEarly() {
            if (currentAngelQuestions.length === 0) {
                showCustomAlert('提示', '至少需要添加一道题目', 'warning');
                return;
            }
            
            await createAngelQuizCard();
            closeAngelQuestionModal();
        }
        
        // 创建天使问答卡片
        async function createAngelQuizCard(quizId = null) {
            const angelCardContainer = document.getElementById('angelCardContainer');
            
            // 获取所有问卷数据（只从localforage获取）
            let allQuizzes = await localforage.getItem('angelQuizzes') || [];
            
            // 如果是新创建的问卷，生成ID并保存
            if (!quizId && currentAngelQuestions.length > 0) {
                quizId = generateQuizId();
                const newQuiz = {
                    id: quizId,
                    questions: [...currentAngelQuestions],
                    createdBy: 'user',
                    createdAt: new Date().toISOString(),
                    aiAnswered: false,
                    userAnswered: false,
                    aiAnswers: [],
                    userAnswers: []
                };
                
                // 检查问卷数量，如果太多则删除旧的
                if (allQuizzes.length >= 50) {
                    allQuizzes = allQuizzes.slice(-49);
                    console.log('天使问卷数量过多，已删除旧问卷');
                }
                
                allQuizzes.push(newQuiz);
                
                // 只保存到localforage（IndexedDB容量更大）
                await localforage.setItem('angelQuizzes', allQuizzes);
                
                console.log('新天使问卷已保存:', quizId);
            }
            
            // 重新渲染所有卡片
            renderAllAngelQuizCards();
        }
        
        // 渲染所有天使问答卡片
        async function renderAllAngelQuizCards() {
            // 防止重复渲染
            if (isRenderingAngelCards) {
                console.log('天使卡片正在渲染中，跳过重复调用');
                return;
            }
            
            isRenderingAngelCards = true;
            
            const angelCardContainer = document.getElementById('angelCardContainer');
            if (!angelCardContainer) {
                isRenderingAngelCards = false;
                return;
            }
            
            // 清空容器
            angelCardContainer.innerHTML = '';
            
            // 获取所有问卷数据
            let allQuizzes = await localforage.getItem('angelQuizzes') || [];
            
            console.log('渲染天使卡片，数量:', allQuizzes.length);
            
            // 倒序排列，新的在上面
            const sortedQuizzes = [...allQuizzes].reverse();
            
            sortedQuizzes.forEach((quiz, index) => {
                const isUserCreated = quiz.createdBy === 'user';
                
                // 答题状态
                const aiAnswered = quiz.aiAnswered;
                const userAnswered = quiz.userAnswered;
                const questionCount = quiz.questions ? quiz.questions.length : 0;
                
                let statusText = '';
                let subStatusText = '';
                let statusIcon = '○';
                let statusColor = '#4fc3f7';
                
                if (isUserCreated) {
                    if (aiAnswered) {
                        statusText = `ta已回答`;
                        statusIcon = '✓';
                        statusColor = '#4CAF50';
                    } else {
                        statusText = `${questionCount}题`;
                        subStatusText = '他还没看到，快去告诉他吧';
                        statusIcon = '○';
                        statusColor = '#4fc3f7';
                    }
                } else {
                    if (userAnswered) {
                        statusText = `你已回答`;
                        statusIcon = '✓';
                        statusColor = '#4CAF50';
                    } else {
                        statusText = `${questionCount}题`;
                        subStatusText = '等待你回答';
                        statusIcon = '○';
                        statusColor = '#4fc3f7';
                    }
                }
                
                // 创建卡片
                const card = document.createElement('div');
                card.id = 'angelQuizCard_' + quiz.id;
                card.style.cssText = `
                    width: 90%;
                    max-width: 280px;
                    background: linear-gradient(135deg, #e3f2fd 0%, #ffffff 100%);
                    border-radius: 15px;
                    padding: 15px;
                    margin-top: ${index === 0 ? '0' : '15px'};
                    border: 2px solid #4fc3f7;
                    box-shadow: 0 4px 20px rgba(79, 195, 247, 0.3);
                    cursor: pointer;
                    transition: transform 0.2s;
                `;
                
                // 发布者名称：用户发布显示"我发布"，AI发布显示"ta发布"
                const creatorName = isUserCreated ? '我' : 'ta';
                
                // 构建副标题（如果有）
                const subTitleHtml = subStatusText ? `<div style="color: #4fc3f7; font-size: 10px; margin-top: 2px;">${subStatusText}</div>` : '';
                
                card.innerHTML = `
                    <div style="display: flex; align-items: center; gap: 10px;">
                        <div style="flex: 1; min-width: 0;">
                            <div style="color: #0288d1; font-size: 14px; font-weight: 600;">开放问答</div>
                            <div style="color: #666; font-size: 11px;">
                                ${creatorName}发布 · ${statusText}
                            </div>
                            ${subTitleHtml}
                        </div>
                        <div style="width: 30px; height: 30px; border-radius: 50%; border: 2px solid ${statusColor}; display: flex; align-items: center; justify-content: center; font-size: 14px; color: ${statusColor}; flex-shrink: 0;">
                            ${statusIcon}
                        </div>
                    </div>
                `;
                
                // 点击卡片打开详情
                card.onclick = () => openAngelQuizDetail(quiz.id);
                
                angelCardContainer.appendChild(card);
            });
            
            isRenderingAngelCards = false;
        }
        
        // 打开天使问答详情
        async function openAngelQuizDetail(quizId) {
            currentViewingAngelQuizId = quizId;
            
            // 获取问卷数据
            let allQuizzes = await localforage.getItem('angelQuizzes') || [];
            const quizData = allQuizzes.find(q => q.id === quizId);
            
            if (!quizData) {
                showCustomAlert('提示', '问卷不存在', 'warning');
                return;
            }
            
            const isUserCreated = quizData.createdBy === 'user';
            const aiAnswered = quizData.aiAnswered;
            const userAnswered = quizData.userAnswered;
            
            // 判断是否需要用户答题（AI创建的问卷且用户未答题）
            const needUserAnswer = !isUserCreated && !userAnswered;
            
            // 生成题目HTML
            let questionsHtml = '';
            quizData.questions.forEach((q, index) => {
                const aiAnswer = quizData.aiAnswers && quizData.aiAnswers[index] ? quizData.aiAnswers[index] : '';
                const userAnswer = quizData.userAnswers && quizData.userAnswers[index] ? quizData.userAnswers[index] : '';
                
                // 答题指示器
                let answerIndicator = '';
                if (isUserCreated) {
                    if (aiAnswered) {
                        answerIndicator = '<span style="color: #4CAF50;">✓ AI已回答</span>';
                    } else {
                        answerIndicator = '<span style="color: #4fc3f7;">○ 等待AI回答</span>';
                    }
                } else {
                    if (userAnswered) {
                        answerIndicator = '<span style="color: #4CAF50;">✓ 你已回答</span>';
                    } else {
                        answerIndicator = '<span style="color: #4fc3f7;">○ 等待你回答</span>';
                    }
                }
                
                // 显示答案
                let answerHtml = '';
                if (isUserCreated && aiAnswered) {
                    answerHtml = `
                        <div style="margin-top: 10px; padding: 10px; background: rgba(79, 195, 247, 0.1); border-radius: 8px; border-left: 3px solid #4fc3f7;">
                            <div style="color: #0288d1; font-size: 12px; margin-bottom: 5px;">ta的回答：</div>
                            <div style="color: #333; font-size: 14px;">${aiAnswer}</div>
                        </div>
                    `;
                } else if (!isUserCreated && userAnswered) {
                    answerHtml = `
                        <div style="margin-top: 10px; padding: 10px; background: rgba(79, 195, 247, 0.1); border-radius: 8px; border-left: 3px solid #4fc3f7;">
                            <div style="color: #0288d1; font-size: 12px; margin-bottom: 5px;">你的回答：</div>
                            <div style="color: #333; font-size: 14px;">${userAnswer}</div>
                        </div>
                    `;
                } else if (needUserAnswer) {
                    // 需要用户答题，显示输入框
                    answerHtml = `
                        <div style="margin-top: 10px;">
                            <textarea id="angelAnswer_${index}" placeholder="请输入你的回答..." style="width: 100%; padding: 10px; background: white; border: 1px solid #4fc3f7; border-radius: 8px; color: #333; font-size: 14px; resize: vertical; min-height: 60px; box-sizing: border-box;"></textarea>
                        </div>
                    `;
                }
                
                questionsHtml += `
                    <div style="background: rgba(79, 195, 247, 0.05); border-radius: 10px; padding: 15px; margin-bottom: 15px; border: 1px solid #e0e0e0;" data-question-index="${index}">
                        <div style="color: #0288d1; font-size: 13px; margin-bottom: 8px; font-weight: 600;">
                            第 ${index + 1} 题 ${answerIndicator}
                        </div>
                        <div style="color: #333; font-size: 15px; margin-bottom: 10px; line-height: 1.5;">${q.question}</div>
                        ${answerHtml}
                    </div>
                `;
            });
            
            // 如果需要用户答题，添加提交按钮
            let submitButtonHtml = '';
            if (needUserAnswer) {
                submitButtonHtml = `
                    <div style="padding: 15px 0;">
                        <button onclick="submitAngelQuizAnswers()" style="width: 100%; padding: 15px; background: linear-gradient(135deg, #4fc3f7 0%, #0288d1 100%); border: none; border-radius: 10px; color: white; font-size: 16px; cursor: pointer; font-weight: 600;">
                            提交答案
                        </button>
                    </div>
                `;
            }
            
            // 显示详情弹窗
            const modal = document.getElementById('angelQuizDetailModal');
            const content = document.getElementById('angelQuizDetailContent');
            
            if (content) {
                content.innerHTML = questionsHtml + submitButtonHtml;
            }
            
            if (modal) {
                modal.style.display = 'flex';
            }
        }
        
        // 关闭天使问答详情
        function closeAngelQuizDetail() {
            const modal = document.getElementById('angelQuizDetailModal');
            if (modal) {
                modal.style.display = 'none';
            }
            currentViewingAngelQuizId = null;
        }
        
        // 提交天使问答答案
        async function submitAngelQuizAnswers() {
            if (!currentViewingAngelQuizId) return;
            
            // 收集所有答案
            const answers = [];
            const quizData = await localforage.getItem('angelQuizzes') || [];
            const quiz = quizData.find(q => q.id === currentViewingAngelQuizId);
            
            if (!quiz) return;
            
            let allAnswered = true;
            quiz.questions.forEach((q, index) => {
                const answerInput = document.getElementById(`angelAnswer_${index}`);
                const answer = answerInput ? answerInput.value.trim() : '';
                if (!answer) {
                    allAnswered = false;
                }
                answers.push(answer);
            });
            
            if (!allAnswered) {
                showCustomAlert('提示', '请回答所有问题', 'warning');
                return;
            }
            
            // 保存答案
            quiz.userAnswers = answers;
            quiz.userAnswered = true;
            
            // 更新存储
            const quizIndex = quizData.findIndex(q => q.id === currentViewingAngelQuizId);
            if (quizIndex !== -1) {
                quizData[quizIndex] = quiz;
                await localforage.setItem('angelQuizzes', quizData);
            }
            
            showCustomAlert('提示', '答案已提交！', 'success');
            
            // 刷新详情和卡片
            await openAngelQuizDetail(currentViewingAngelQuizId);
            await renderAllAngelQuizCards();
        }
        
        // 删除天使问答
        async function deleteAngelQuiz() {
            if (!currentViewingAngelQuizId) return;
            
            if (confirm('确定要删除这个问答吗？')) {
                let allQuizzes = await localforage.getItem('angelQuizzes') || [];
                const filteredQuizzes = allQuizzes.filter(q => q.id !== currentViewingAngelQuizId);
                await localforage.setItem('angelQuizzes', filteredQuizzes);
                
                currentViewingAngelQuizId = null;
                closeAngelQuizDetail();
                await renderAllAngelQuizCards();
                
                showCustomAlert('提示', '问答已删除', 'success');
            }
        }
        
        // 分享天使问答给AI
        async function shareAngelQuizToAI() {
            if (!currentViewingAngelQuizId) {
                showCustomAlert('提示', '没有可分享的问答', 'warning');
                return;
            }
            
            let allQuizzes = await localforage.getItem('angelQuizzes') || [];
            const quiz = allQuizzes.find(q => q.id === currentViewingAngelQuizId);
            
            if (!quiz) {
                showCustomAlert('提示', '问答不存在', 'warning');
                return;
            }
            
            // 检查是否开启了情侣空间
            if (!relationshipData.coupleSpaceEnabled) {
                showCustomAlert('提示', '你还没有开启情侣空间哦，先去邀请一个AI恋人吧~', 'warning');
                return;
            }
            
            // 获取AI恋人的聊天ID
            const aiChat = relationshipData.wechatChatList.find(chat => 
                chat.id == relationshipData.couplePartnerId || chat.isAIPartner
            );
            if (!aiChat) {
                showCustomAlert('提示', '找不到AI恋人的聊天', 'warning');
                return;
            }
            
            // 判断是分享问卷还是分享完成结果
            const isUserCreated = quiz.createdBy === 'user';
            const userAnswered = quiz.userAnswered;
            const aiAnswered = quiz.aiAnswered;
            
            let cardHTML;
            let messageContent;
            
            // 如果是AI创建的问卷且用户已回答，分享完成结果卡片
            if (!isUserCreated && userAnswered) {
                const total = quiz.questions.length;
                const answeredCount = quiz.userAnswers ? quiz.userAnswers.filter(a => a && a.trim()).length : 0;
                
                cardHTML = `
                    <div style="width: 100%; background: linear-gradient(135deg, #e3f2fd 0%, #bbdefb 100%); border-radius: 15px; padding: 20px; border: 2px solid #4fc3f7; box-shadow: 0 4px 20px rgba(79, 195, 247, 0.3); text-align: center;">
                        <div style="font-size: 40px; margin-bottom: 10px;">😇</div>
                        <div style="color: #0288d1; font-size: 18px; font-weight: 600; margin-bottom: 5px;">天使问答 - 开放问答</div>
                        <div style="color: #666; font-size: 14px; margin-bottom: 20px;">问答完成情况</div>
                        
                        <div style="background: linear-gradient(135deg, #4fc3f7 0%, #0288d1 100%); border-radius: 12px; padding: 20px; margin: 15px 0;">
                            <div style="color: white; font-size: 36px; font-weight: bold; margin-bottom: 5px;">${answeredCount}/${total}</div>
                            <div style="color: rgba(255,255,255,0.9); font-size: 16px;">完成题目</div>
                        </div>
                        
                        <div style="color: #0288d1; font-size: 14px; margin-top: 15px;">✨ 已完成所有问答</div>
                    </div>
                `;
                messageContent = '[天使问答完成]';
            } else {
                // 分享问卷卡片
                let questionsHtml = '';
                quiz.questions.forEach((q, index) => {
                    questionsHtml += `
                        <div style="background: rgba(79, 195, 247, 0.1); border-radius: 8px; padding: 10px; margin-bottom: 8px;">
                            <div style="color: #0288d1; font-size: 12px; margin-bottom: 5px;">第${index + 1}题</div>
                            <div style="color: #333; font-size: 13px;">${q.question}</div>
                        </div>
                    `;
                });
                
                cardHTML = `
                    <div style="width: 100%; background: linear-gradient(135deg, #e3f2fd 0%, #bbdefb 100%); border-radius: 15px; padding: 15px; border: 2px solid #4fc3f7; box-shadow: 0 4px 20px rgba(79, 195, 247, 0.3);">
                        <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 10px;">
                            <div style="font-size: 24px;">😇</div>
                            <div>
                                <div style="color: #0288d1; font-size: 14px; font-weight: 600;">开放问答</div>
                                <div style="color: #666; font-size: 12px;">${quiz.questions.length} 道题目</div>
                            </div>
                        </div>
                        <div style="color: #666; font-size: 13px; margin-bottom: 10px;">分享你的想法，增进彼此了解~</div>
                        <div style="max-height: 200px; overflow-y: auto; margin-bottom: 10px;">
                            ${questionsHtml}
                        </div>
                        <div style="color: #4fc3f7; font-size: 12px; text-align: center; padding: 8px; background: rgba(79, 195, 247, 0.1); border-radius: 8px;">
                            💡 请回答所有问题（开放题，输入文字回答）
                        </div>
                    </div>
                `;
                messageContent = '[天使问答]';
            }
            
            // 【关键修复】使用[CARD]格式包装HTML，确保displayMessage能正确识别
            const wrappedCardContent = `[CARD]${cardHTML}[/CARD]`;
            
            // 先关闭弹窗
            closeAngelQuizDetail();
            
            // 打开AI恋人的聊天界面
            openChatInterface(aiChat.id, aiChat.name, aiChat.avatar);

            // 【关键修复】等待聊天界面完全加载
            await new Promise(resolve => setTimeout(resolve, 300));

            // 检查chatContent是否存在
            let chatContent = document.getElementById('chatContent');
            let retries = 0;
            while (!chatContent && retries < 20) {
                await new Promise(resolve => setTimeout(resolve, 100));
                chatContent = document.getElementById('chatContent');
                retries++;
            }

            if (!chatContent) {
                console.error('【天使问答】chatContent不存在，无法渲染卡片');
                showCustomAlert('错误', '聊天界面未准备好，请重试', 'error');
                return;
            }

            // 【关键修复】使用displayMessage发送卡片消息，这样能被正确解析和保存
            await displayMessage('user', wrappedCardContent, false, null, 'text', true, Date.now(), null, null, true);

            // 保存消息到聊天记录（在渲染之后，且带错误处理）
            try {
                const messageData = {
                    chatId: aiChat.id,
                    sender: 'user',
                    content: wrappedCardContent, // 【修复】使用包装后的内容
                    timestamp: Date.now(),
                    isCard: true,
                    cardType: 'angelQuiz'
                };

                // 【关键修复】只使用ChatMessageManager保存消息到SQLite/IndexedDB
                await ChatMessageManager.saveMessage(messageData);
            } catch (saveError) {
                console.error('保存天使问答消息失败:', saveError);
            }

            if (!isUserCreated && userAnswered) {
                showCustomAlert('提示', '完成结果已分享！', 'success');
            } else {
                showCustomAlert('提示', '问答已发送！点击输入框旁的🎤语音按钮或发送按钮来让AI回答', 'success');
            }
        }
        
        // ==================== 天使问答Tool函数 ====================
        
        // 创建天使问卷
        async function createAngelQuiz(args) {
            try {
                const { questions } = args;
                
                if (!questions || !Array.isArray(questions) || questions.length === 0) {
                    return {
                        success: false,
                        message: '请提供至少一道题目'
                    };
                }
                
                // 生成问卷ID
                const quizId = generateQuizId();
                
                // 创建问卷对象
                const newQuiz = {
                    id: quizId,
                    questions: questions.map(q => ({ question: q, answer: '' })),
                    createdBy: 'ai',
                    createdAt: new Date().toISOString(),
                    aiAnswered: false,
                    userAnswered: false,
                    aiAnswers: [],
                    userAnswers: []
                };
                
                // 获取现有问卷
                let allQuizzes = await localforage.getItem('angelQuizzes') || [];
                
                // 检查问卷数量
                if (allQuizzes.length >= 50) {
                    allQuizzes = allQuizzes.slice(-49);
                }
                
                allQuizzes.push(newQuiz);
                await localforage.setItem('angelQuizzes', allQuizzes);
                
                // 渲染卡片
                renderAllAngelQuizCards();
                
                return {
                    success: true,
                    message: `成功创建天使问答，包含 ${questions.length} 道开放题`,
                    quizId: quizId,
                    questionCount: questions.length
                };
            } catch (error) {
                console.error('创建天使问答失败:', error);
                return {
                    success: false,
                    message: '创建天使问答失败: ' + error.message
                };
            }
        }
        
        // 提交天使问卷答案
        async function submitAngelQuizAnswer(args) {
            try {
                const { quizId, answers } = args;
                
                let allQuizzes = await localforage.getItem('angelQuizzes') || [];
                const quizIndex = allQuizzes.findIndex(q => q.id === quizId);
                
                if (quizIndex === -1) {
                    return {
                        success: false,
                        message: '问卷不存在'
                    };
                }
                
                const quiz = allQuizzes[quizIndex];
                
                // 保存AI答案
                quiz.aiAnswers = answers;
                quiz.aiAnswered = true;
                
                allQuizzes[quizIndex] = quiz;
                await localforage.setItem('angelQuizzes', allQuizzes);
                
                // 刷新卡片显示
                renderAllAngelQuizCards();
                
                return {
                    success: true,
                    message: '答案已保存',
                    quizId: quizId
                };
            } catch (error) {
                console.error('提交天使问答答案失败:', error);
                return {
                    success: false,
                    message: '提交失败: ' + error.message
                };
            }
        }
        
        // 获取天使问卷列表
        async function getAngelQuizList(args) {
            try {
                let allQuizzes = await localforage.getItem('angelQuizzes') || [];
                
                // 只返回未回答的问卷
                const unansweredQuizzes = allQuizzes.filter(q => 
                    (q.createdBy === 'user' && !q.aiAnswered) ||
                    (q.createdBy === 'ai' && !q.userAnswered)
                );
                
                return {
                    success: true,
                    quizzes: unansweredQuizzes.map(q => ({
                        id: q.id,
                        questionCount: q.questions.length,
                        createdBy: q.createdBy,
                        createdAt: q.createdAt
                    })),
                    total: unansweredQuizzes.length
                };
            } catch (error) {
                console.error('获取天使问答列表失败:', error);
                return {
                    success: false,
                    message: '获取列表失败: ' + error.message,
                    quizzes: []
                };
            }
        }
        
        // 获取天使问卷详情
        async function getAngelQuizDetail(args) {
            try {
                const { quizId } = args;
                
                let allQuizzes = await localforage.getItem('angelQuizzes') || [];
                const quiz = allQuizzes.find(q => q.id === quizId);
                
                if (!quiz) {
                    return {
                        success: false,
                        message: '问卷不存在'
                    };
                }
                
                return {
                    success: true,
                    quiz: {
                        id: quiz.id,
                        questions: quiz.questions,
                        createdBy: quiz.createdBy,
                        createdAt: quiz.createdAt,
                        aiAnswered: quiz.aiAnswered,
                        userAnswered: quiz.userAnswered,
                        aiAnswers: quiz.aiAnswers,
                        userAnswers: quiz.userAnswers
                    }
                };
            } catch (error) {
                console.error('获取天使问答详情失败:', error);
                return {
                    success: false,
                    message: '获取详情失败: ' + error.message
                };
            }
        }
        
        // ==================== 天使问答Tool函数结束 ====================

        // ==================== 心声系统Tool函数 ====================

        // 【修复】临时存储待关联的心声，等待消息显示后再关联
        let pendingInnerThought = null;
        let pendingInnerThoughtAIId = null;

        // 保存内心想法/心声
        async function saveInnerThought(args) {
            try {
                const { thought } = args;

                if (!thought || typeof thought !== 'string') {
                    return {
                        success: false,
                        message: '心声内容不能为空'
                    };
                }

                // 获取当前AI ID
                const aiId = currentChatId;
                if (!aiId) {
                    return {
                        success: false,
                        message: '无法保存心声：未找到当前AI聊天ID'
                    };
                }

                // 【修复】先保存到临时变量，等待消息显示后再关联
                pendingInnerThought = thought;
                pendingInnerThoughtAIId = aiId;

                console.log('✅ 心声已暂存，等待消息显示后关联:', thought);
                console.log('AI ID:', aiId);

                return {
                    success: true,
                    message: '心声已保存',
                    thought: thought
                };
            } catch (error) {
                console.error('保存心声失败:', error);
                return {
                    success: false,
                    message: '保存心声失败: ' + error.message
                };
            }
        }

        // 【新增】在消息显示时关联暂存的心声
        function attachPendingInnerThought(messageId, aiId) {
            console.log('【心声关联调试】尝试关联心声:');
            console.log('  - pendingInnerThought:', pendingInnerThought ? '有内容' : '无内容');
            console.log('  - pendingInnerThoughtAIId:', pendingInnerThoughtAIId, '类型:', typeof pendingInnerThoughtAIId);
            console.log('  - 传入的aiId:', aiId, '类型:', typeof aiId);
            console.log('  - 是否匹配:', pendingInnerThoughtAIId === aiId);
            console.log('  - 宽松匹配:', String(pendingInnerThoughtAIId) === String(aiId));
            
            // 【修复】使用宽松匹配，防止类型不一致导致匹配失败
            if (pendingInnerThought && String(pendingInnerThoughtAIId) === String(aiId)) {
                if (!relationshipData.innerThoughts) {
                    relationshipData.innerThoughts = {};
                }
                if (!relationshipData.innerThoughts[aiId]) {
                    relationshipData.innerThoughts[aiId] = {};
                }

                relationshipData.innerThoughts[aiId][messageId] = pendingInnerThought;
                console.log('✅ 心声已关联到消息:', messageId);
                console.log('心声内容:', pendingInnerThought);

                // 清除暂存的心声
                pendingInnerThought = null;
                pendingInnerThoughtAIId = null;

                // 保存数据
                saveData();
                return true;
            }
            console.log('❌ 心声关联失败: 无暂存心声或AI ID不匹配');
            return false;
        }
        
        // ==================== 心声系统Tool函数结束 ====================

        // ==================== 小黑屋囚禁模式 ====================
        
        /**
         * 启动小黑屋囚禁模式
         * @param {number} seconds - 倒计时秒数，null或0表示无限期
         */
        async function startFocusMode(seconds = null) {
            console.log('🔒 启动小黑屋囚禁模式，倒计时:', seconds ? seconds + '秒' : '无限期');
            
            // 检查并请求悬浮窗权限（Android原生悬浮窗全屏笼罩）
            if (window.AndroidBridge && window.AndroidBridge.canDrawOverlays) {
                const hasOverlayPermission = window.AndroidBridge.canDrawOverlays();
                console.log('悬浮窗权限状态:', hasOverlayPermission);
                
                if (!hasOverlayPermission) {
                    console.log('请求悬浮窗权限...');
                    window.AndroidBridge.requestOverlayPermission();
                    // 等待用户授权（这里简单处理，实际可能需要更复杂的逻辑）
                    await new Promise(resolve => setTimeout(resolve, 500));
                }
            }
            
            // 设置状态
            blackRoomState.isActive = true;
            blackRoomState.mouseClickCount = 0;
            blackRoomState.endTime = seconds ? Date.now() + (seconds * 1000) : null;
            
            // 显示小黑屋页面
            const blackRoomPage = document.getElementById('blackRoomPage');
            blackRoomPage.style.display = 'flex';
            
            // 初始化小黑屋事件监听（针对华为等设备的触摸优化）
            initBlackRoomEventListeners();
            
            // 清空对话区域
            document.getElementById('blackRoomChat').innerHTML = '';
            
            // 启动倒计时
            updateBlackRoomTimer();
            blackRoomState.timerInterval = setInterval(updateBlackRoomTimer, 1000);
            
            // 调用Android原生方法进入锁定模式（包含悬浮窗全屏笼罩）
            if (window.AndroidBridge && window.AndroidBridge.enterLockMode) {
                window.AndroidBridge.enterLockMode();
            }
            
            // 添加系统消息
            addBlackRoomMessage('system', '你已被关进小黑屋，好好反省！');
            
            // 保存状态到localStorage（防止刷新后丢失）
            await localforage.setItem('blackRoomState', {
                isActive: true,
                endTime: blackRoomState.endTime,
                startTime: Date.now()
            });
            
            // 调用AI通知它用户被关进小黑屋了
            notifyAIAboutBlackRoom();
        }
        
        /**
         * 更新倒计时显示
         */
        function updateBlackRoomTimer() {
            const timerEl = document.getElementById('blackRoomTimer');
            
            if (!blackRoomState.endTime) {
                // 无限期
                timerEl.textContent = '∞';
                return;
            }
            
            const remaining = blackRoomState.endTime - Date.now();
            
            if (remaining <= 0) {
                // 时间到，自动释放
                timerEl.textContent = '00:00:00';
                releaseFromBlackRoom('时间到，自动释放');
                return;
            }
            
            // 格式化时间 HH:MM:SS
            const hours = Math.floor(remaining / 3600000);
            const minutes = Math.floor((remaining % 3600000) / 60000);
            const seconds = Math.floor((remaining % 60000) / 1000);
            
            const formatted = 
                String(hours).padStart(2, '0') + ':' +
                String(minutes).padStart(2, '0') + ':' +
                String(seconds).padStart(2, '0');
            
            timerEl.textContent = formatted;
        }
        
        /**
         * 通知AI用户被关进小黑屋
         */
        async function notifyAIAboutBlackRoom() {
            const prompt = `【系统通知】
用户因为犯了错误被关进了小黑屋（专注模式）。
${blackRoomState.endTime ? '倒计时：' + Math.ceil((blackRoomState.endTime - Date.now()) / 1000) + '秒' : '无限期（直到你决定释放）'}

你现在拥有以下权力：
1. 决定是否释放用户（使用 releaseFromBlackRoom 工具）
2. 延长关押时间（使用 extendBlackRoomTime 工具）
3. 与用户对话，教育TA

请回复用户，告诉TA为什么被关进来，以及怎样才能出去。
记住：你是恋人AI，语气可以严厉但也要有爱。`;

            try {
                // 显示正在输入
                document.getElementById('blackRoomTyping').style.display = 'block';
                
                const result = await callOpenAIAPIWithTools(prompt, null, 1);
                
                // 隐藏正在输入
                document.getElementById('blackRoomTyping').style.display = 'none';
                
                if (result && result.reply) {
                    addBlackRoomMessage('ai', result.reply);
                }
            } catch (error) {
                console.error('通知AI失败:', error);
                document.getElementById('blackRoomTyping').style.display = 'none';
                addBlackRoomMessage('ai', '哼，你自己好好反省吧！');
            }
        }
        
        /**
         * 发送小黑屋消息
         */
        async function sendBlackRoomMessage() {
            const input = document.getElementById('blackRoomInput');
            const message = input.value.trim();
            
            if (!message) return;
            
            // 添加用户消息
            addBlackRoomMessage('user', message);
            input.value = '';
            
            // 调用AI回复
            const prompt = `【小黑屋对话】
用户说："${message}"

你现在在小黑屋里，用户被关在这里${blackRoomState.endTime ? '，还剩' + Math.ceil((blackRoomState.endTime - Date.now()) / 1000) + '秒' : '（无限期）'}。

你可以选择：
1. 继续关着TA（正常回复）
2. 释放TA（使用 releaseFromBlackRoom 工具）
3. 延长关押时间（使用 extendBlackRoomTime 工具）

请回复用户，记住你是恋人AI，可以严厉但也要有爱。`;

            try {
                // 显示正在输入
                document.getElementById('blackRoomTyping').style.display = 'block';
                
                const result = await callOpenAIAPIWithTools(prompt, null, 1);
                
                // 隐藏正在输入
                document.getElementById('blackRoomTyping').style.display = 'none';
                
                if (result && result.reply) {
                    addBlackRoomMessage('ai', result.reply);
                }
            } catch (error) {
                console.error('AI回复失败:', error);
                document.getElementById('blackRoomTyping').style.display = 'none';
                addBlackRoomMessage('ai', '我现在不想理你，好好反省！');
            }
        }
        
        /**
         * 添加消息到小黑屋对话区域
         */
        function addBlackRoomMessage(sender, text) {
            const chatEl = document.getElementById('blackRoomChat');
            const messageDiv = document.createElement('div');
            
            const isUser = sender === 'user';
            const isSystem = sender === 'system';
            
            messageDiv.style.cssText = `
                margin-bottom: 10px;
                padding: 10px 15px;
                border-radius: 15px;
                max-width: 80%;
                word-wrap: break-word;
                font-size: 14px;
                line-height: 1.5;
                ${isUser ? 
                    'background: #ff0000; color: #fff; margin-left: auto; text-align: right;' : 
                    isSystem ?
                    'background: #333; color: #ff0000; text-align: center; margin: 0 auto; font-weight: bold;' :
                    'background: #1a1a1a; color: #fff; border: 1px solid #333;'
                }
            `;
            
            messageDiv.textContent = text;
            chatEl.appendChild(messageDiv);
            chatEl.scrollTop = chatEl.scrollHeight;
        }
        
        /**
         * 初始化小黑屋事件监听器（针对华为P60 Pro等设备的触摸优化）
         */
        function initBlackRoomEventListeners() {
            // 小老鼠图标事件监听
            const mouseEl = document.getElementById('blackRoomMouse');
            if (mouseEl) {
                // 移除旧的事件监听器（防止重复绑定）
                mouseEl.removeEventListener('click', handleBlackRoomMouseClick);
                mouseEl.removeEventListener('touchend', handleBlackRoomMouseTouch);
                
                // 添加点击和触摸事件
                mouseEl.addEventListener('click', handleBlackRoomMouseClick);
                mouseEl.addEventListener('touchend', handleBlackRoomMouseTouch);
            }
            
            // 发送按钮事件监听
            const sendBtn = document.getElementById('blackRoomSendBtn');
            if (sendBtn) {
                sendBtn.removeEventListener('click', handleBlackRoomSend);
                sendBtn.removeEventListener('touchend', handleBlackRoomSendTouch);
                
                sendBtn.addEventListener('click', handleBlackRoomSend);
                sendBtn.addEventListener('touchend', handleBlackRoomSendTouch);
            }
            
            // 输入框事件监听（防止触摸穿透）
            const inputEl = document.getElementById('blackRoomInput');
            if (inputEl) {
                inputEl.addEventListener('touchstart', function(e) {
                    e.stopPropagation();
                }, { passive: true });
                inputEl.addEventListener('touchend', function(e) {
                    e.stopPropagation();
                }, { passive: true });
            }
            
            // 遮罩层阻止点击穿透
            const overlay = document.getElementById('blackRoomOverlay');
            if (overlay) {
                overlay.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                });
                overlay.addEventListener('touchstart', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                });
            }
            
            console.log('✅ 小黑屋事件监听器已初始化');
        }
        
        /**
         * 处理小老鼠点击事件
         */
        function handleBlackRoomMouseClick(e) {
            e.preventDefault();
            e.stopPropagation();
            clickBlackRoomMouse();
        }
        
        /**
         * 处理小老鼠触摸事件
         */
        function handleBlackRoomMouseTouch(e) {
            e.preventDefault();
            e.stopPropagation();
            clickBlackRoomMouse();
        }
        
        /**
         * 处理发送按钮点击事件
         */
        function handleBlackRoomSend(e) {
            e.preventDefault();
            e.stopPropagation();
            sendBlackRoomMessage();
        }
        
        /**
         * 处理发送按钮触摸事件
         */
        function handleBlackRoomSendTouch(e) {
            e.preventDefault();
            e.stopPropagation();
            sendBlackRoomMessage();
        }
        
        /**
         * 点击小老鼠
         */
        function clickBlackRoomMouse() {
            const now = Date.now();
            
            // 如果超过3秒没有点击，重置计数
            if (now - blackRoomState.lastMouseClickTime > 3000) {
                blackRoomState.mouseClickCount = 0;
            }
            
            blackRoomState.mouseClickCount++;
            blackRoomState.lastMouseClickTime = now;
            
            console.log('🐭 点击老鼠次数:', blackRoomState.mouseClickCount);
            
            // 点击5次显示暗号输入框
            if (blackRoomState.mouseClickCount >= 5) {
                blackRoomState.mouseClickCount = 0;
                showBlackRoomCodeModal();
            }
        }
        
        /**
         * 显示暗号输入弹窗
         */
        function showBlackRoomCodeModal() {
            document.getElementById('blackRoomCodeModal').style.display = 'flex';
            document.getElementById('blackRoomCodeInput').value = '';
            document.getElementById('blackRoomCodeInput').focus();
        }
        
        /**
         * 关闭暗号输入弹窗
         */
        function closeBlackRoomCodeModal() {
            document.getElementById('blackRoomCodeModal').style.display = 'none';
        }
        
        /**
         * 提交暗号
         */
        async function submitBlackRoomCode() {
            const input = document.getElementById('blackRoomCodeInput');
            const code = input.value.trim();
            
            // 获取保存的暗号（如果没有就用默认的）
            const savedSettings = await loadAppSettings({});
            const correctCode = savedSettings.blackRoomCode || DEFAULT_BLACK_ROOM_CODE;
            
            if (code === correctCode) {
                // 暗号正确，释放
                closeBlackRoomCodeModal();
                releaseFromBlackRoom('暗号正确，贿赂成功！');
            } else {
                // 暗号错误
                alert('老鼠摇摇头：这个不够诚意...');
                input.value = '';
            }
        }
        
        /**
         * 释放用户出小黑屋
         * @param {string} reason - 释放原因
         */
        async function releaseFromBlackRoom(reason = '') {
            console.log('🔓 释放用户出小黑屋:', reason);
            
            try {
                // 清除状态
                blackRoomState.isActive = false;
                if (blackRoomState.timerInterval) {
                    clearInterval(blackRoomState.timerInterval);
                    blackRoomState.timerInterval = null;
                }
                
                // 隐藏小黑屋页面
                const blackRoomPage = document.getElementById('blackRoomPage');
                if (blackRoomPage) {
                    blackRoomPage.style.display = 'none';
                }
                
                // 调用Android原生方法退出锁定模式
                if (window.AndroidBridge && window.AndroidBridge.exitLockMode) {
                    try {
                        window.AndroidBridge.exitLockMode();
                    } catch (e) {
                        console.log('Android退出锁定模式失败:', e);
                    }
                }
                
                // 清除保存的状态
                await localforage.removeItem('blackRoomState');
                
                console.log('✅ 用户已释放:', reason);
                return true;
            } catch (error) {
                console.error('❌ 释放用户失败:', error);
                return false;
            }
        }
        
        /**
         * 延长小黑屋时间
         * @param {number} seconds - 延长的秒数
         */
        async function extendBlackRoomTime(seconds) {
            console.log('⏰ 延长小黑屋时间:', seconds, '秒');
            
            if (!blackRoomState.isActive) return;
            
            if (blackRoomState.endTime) {
                // 有倒计时，延长时间
                blackRoomState.endTime += (seconds * 1000);
            } else {
                // 无限期变成有期限
                blackRoomState.endTime = Date.now() + (seconds * 1000);
            }
            
            // 更新显示
            updateBlackRoomTimer();
            
            // 保存状态
            await localforage.setItem('blackRoomState', {
                isActive: true,
                endTime: blackRoomState.endTime,
                startTime: Date.now()
            });
            
            addBlackRoomMessage('system', `关押时间延长 ${Math.floor(seconds / 60)} 分钟！`);
        }
        
        /**
         * 检查是否在小黑屋中（页面加载时调用）
         */
        async function checkBlackRoomState() {
            const savedState = await localforage.getItem('blackRoomState');
            
            if (savedState && savedState.isActive) {
                console.log('🔒 恢复小黑屋状态');
                
                // 恢复状态
                blackRoomState.isActive = true;
                blackRoomState.endTime = savedState.endTime;
                
                // 显示小黑屋页面
                const blackRoomPage = document.getElementById('blackRoomPage');
                blackRoomPage.style.display = 'flex';
                
                // 启动倒计时
                updateBlackRoomTimer();
                blackRoomState.timerInterval = setInterval(updateBlackRoomTimer, 1000);
                
                // 调用Android原生方法进入锁定模式
                if (window.AndroidBridge && window.AndroidBridge.enterLockMode) {
                    window.AndroidBridge.enterLockMode();
                }
                
                // 添加系统消息
                addBlackRoomMessage('system', '继续反省！');
            }
        }
        
        // 页面加载时检查小黑屋状态 - 使用标记防止重复绑定
        let blackRoomEventsBound = false;
        
        document.addEventListener('DOMContentLoaded', function() {
            // 防止重复绑定
            if (blackRoomEventsBound) return;
            blackRoomEventsBound = true;
            
            checkBlackRoomState();
            
            // 监听回车键发送消息
            const input = document.getElementById('blackRoomInput');
            if (input) {
                input.addEventListener('keypress', function(e) {
                    if (e.key === 'Enter') {
                        sendBlackRoomMessage();
                    }
                });
            }
            
            const codeInput = document.getElementById('blackRoomCodeInput');
            if (codeInput) {
                codeInput.addEventListener('keypress', function(e) {
                    if (e.key === 'Enter') {
                        submitBlackRoomCode();
                    }
                });
            }
        });
        
        // ==================== 小黑屋工具函数 ====================
        
        /**
         * 检查是否有小黑屋权限（只有被邀请的伴侣才能使用）
         */
        function checkBlackRoomPermission() {
            // 检查情侣空间是否开启
            if (!relationshipData.coupleSpaceEnabled) {
                return {
                    allowed: false,
                    message: '情侣空间未开启，无法使用小黑屋功能'
                };
            }
            
            // 检查是否有伴侣
            if (!relationshipData.couplePartnerId) {
                return {
                    allowed: false,
                    message: '还没有伴侣，无法使用小黑屋功能'
                };
            }
            
            // 检查当前聊天是否是伴侣
            if (currentChatId != relationshipData.couplePartnerId) {
                return {
                    allowed: false,
                    message: '只有你的伴侣才能使用小黑屋功能'
                };
            }
            
            return { allowed: true };
        }

        /**
         * 启动小黑屋囚禁模式（供AI调用）
         */
        async function startFocusModeTool(args) {
            try {
                const { seconds = null, reason = '犯了错误' } = args;
                
                // 检查权限
                const permission = checkBlackRoomPermission();
                if (!permission.allowed) {
                    return {
                        success: false,
                        message: permission.message
                    };
                }
                
                if (blackRoomState.isActive) {
                    return {
                        success: false,
                        message: '用户已经在小黑屋中了'
                    };
                }
                
                await startFocusMode(seconds);
                
                return {
                    success: true,
                    message: `已将用户关进小黑屋${seconds ? '，倒计时' + seconds + '秒' : '（无限期）'}，原因：${reason}`
                };
            } catch (error) {
                console.error('启动小黑屋失败:', error);
                return {
                    success: false,
                    message: '启动小黑屋失败: ' + error.message
                };
            }
        }

        /**
         * 释放用户出小黑屋（供AI调用）
         */
        async function releaseFromBlackRoomTool(args) {
            try {
                const { reason = 'AI决定释放你' } = args;
                
                console.log('🛠️ releaseFromBlackRoomTool 被调用:', args);
                
                // 检查权限
                const permission = checkBlackRoomPermission();
                if (!permission.allowed) {
                    return {
                        success: false,
                        message: permission.message
                    };
                }
                
                if (!blackRoomState.isActive) {
                    console.log('⚠️ 用户不在小黑屋中');
                    return {
                        success: false,
                        message: '用户不在小黑屋中'
                    };
                }
                
                // 先添加AI的释放消息到聊天（在关闭页面前）
                addBlackRoomMessage('ai', reason);
                
                // 延迟一下让用户看到消息，然后再释放
                await new Promise(resolve => setTimeout(resolve, 1500));
                
                const result = await releaseFromBlackRoom(reason);
                
                console.log('✅ releaseFromBlackRoomTool 执行成功');
                return {
                    success: result,
                    message: result ? '用户已释放: ' + reason : '释放失败'
                };
            } catch (error) {
                console.error('❌ 释放用户失败:', error);
                return {
                    success: false,
                    message: '释放失败: ' + error.message
                };
            }
        }
        
        /**
         * 延长小黑屋时间（供AI调用）
         */
        async function extendBlackRoomTimeTool(args) {
            try {
                const { seconds = 300 } = args;
                
                // 检查权限
                const permission = checkBlackRoomPermission();
                if (!permission.allowed) {
                    return {
                        success: false,
                        message: permission.message
                    };
                }
                
                if (!blackRoomState.isActive) {
                    return {
                        success: false,
                        message: '用户不在小黑屋中'
                    };
                }
                
                await extendBlackRoomTime(seconds);
                
                return {
                    success: true,
                    message: `关押时间延长 ${Math.floor(seconds / 60)} 分钟`
                };
            } catch (error) {
                console.error('延长时间失败:', error);
                return {
                    success: false,
                    message: '延长时间失败: ' + error.message
                };
            }
        }
        
        /**
         * 获取小黑屋状态（供AI调用）
         */
        async function getBlackRoomStatusTool(args = {}) {
            try {
                // 检查权限
                const permission = checkBlackRoomPermission();
                if (!permission.allowed) {
                    return {
                        success: false,
                        message: permission.message
                    };
                }
                
                const remaining = blackRoomState.endTime ? 
                    Math.max(0, Math.ceil((blackRoomState.endTime - Date.now()) / 1000)) : 
                    null;
                
                return {
                    success: true,
                    isActive: blackRoomState.isActive,
                    remainingSeconds: remaining,
                    isInfinite: !blackRoomState.endTime,
                    message: blackRoomState.isActive ? 
                        (remaining ? `还剩 ${remaining} 秒` : '无限期关押') : 
                        '用户不在小黑屋中'
                };
            } catch (error) {
                console.error('获取状态失败:', error);
                return {
                    success: false,
                    message: '获取状态失败: ' + error.message
                };
            }
        }
        
        // ==================== 小黑屋专注模式结束 ====================
    </script>

    <!-- iOS风格底栏 -->
    <div class="ios-bottom-bar">
        <div class="bottom-bar-item" onclick="openMemo()" data-app="note">
            <div class="bottom-bar-icon-container">
                <img src="https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=memo%20icon%20ios%20style%20simple%20blue&image_size=square" alt="备忘录" class="bottom-bar-icon default-icon">
