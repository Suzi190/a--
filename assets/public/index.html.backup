                    img.style.display = 'block';
                    placeholder.style.display = 'none';
                }
            }

            // 加载功能卡片图片
            loadFeatureCardImage();
            
            // ==================== 小球球陪伴功能 ====================
            
            // 陪伴功能状态
            let companionState = {
                selectedCharacter: null,
                displayType: 'avatar', // 'avatar' 或 'qversion'
                isFloating: false,
                floatingPosition: { x: window.innerWidth - 100, y: window.innerHeight / 2 }
            };
            
            // 打开陪伴球弹窗
            window.openCompanionBallModal = async function() {
                console.log('【小球球】打开弹窗');
                const modal = document.getElementById('companionBallModal');
                const characterList = document.getElementById('companionCharacterList');
                
                // 先显示弹窗的加载状态
                modal.classList.add('active');
                characterList.innerHTML = '<div style="text-align:center;padding:40px;color:#999;">加载中...</div>';
                
                // 获取微信聊天列表作为角色列表
                const chatList = await getCompanionCharacterList();
                console.log('【小球球】获取到的角色列表:', chatList);
                
                // 渲染角色列表
                renderCompanionCharacterList(chatList);
                
                // 重置选择状态
                companionState.selectedCharacter = null;
                companionState.displayType = 'avatar';
                updateConfirmButton();
                updateDisplayTypeSelection();
            };
            
            // 关闭陪伴球弹窗
            window.closeCompanionBallModal = function() {
                const modal = document.getElementById('companionBallModal');
                modal.classList.remove('active');
            };
            
            // 获取角色列表
            async function getCompanionCharacterList() {
                try {
                    console.log('【小球球】开始获取角色列表...');
                    console.log('【小球球】全局relationshipData:', typeof relationshipData, relationshipData ? '存在' : '不存在');
                    
                    // 【关键修复】优先从全局变量获取，因为这才是实时数据
                    if (relationshipData && relationshipData.wechatChatList && Array.isArray(relationshipData.wechatChatList)) {
                        if (relationshipData.wechatChatList.length > 0) {
                            console.log('【小球球】从全局变量获取到', relationshipData.wechatChatList.length, '个角色');
                            return relationshipData.wechatChatList;
                        }
                    }
                    
                    // 如果全局变量没有，尝试从SQLite获取
                    if (window.Capacitor && window.Capacitor.Plugins && window.Capacitor.Plugins.CapacitorSQLite) {
                        try {
                            const { CapacitorSQLite } = window.Capacitor.Plugins;
                            console.log('【小球球】尝试从SQLite获取...');
                            
                            // 首先尝试从 relationship_data 表获取
                            const result1 = await CapacitorSQLite.query({
                                database: 'chat_messages.db',
                                statement: "SELECT value FROM relationship_data WHERE key = 'relationshipData'",
                                values: []
                            });
                            
                            if (result1.values && result1.values.length > 0) {
                                const sqliteData = JSON.parse(result1.values[0].value);
                                if (sqliteData.wechatChatList && sqliteData.wechatChatList.length > 0) {
                                    console.log('【小球球】从SQLite relationship_data 获取到', sqliteData.wechatChatList.length, '个角色');
                                    return sqliteData.wechatChatList;
                                }
                            }
                            
                            // 然后尝试从 chat_list 表获取
                            const result2 = await CapacitorSQLite.query({
                                database: 'chat_messages.db',
                                statement: 'SELECT data FROM chat_list ORDER BY updated_at DESC',
                                values: []
                            });
                            
                            if (result2.values && result2.values.length > 0) {
                                console.log('【小球球】从SQLite chat_list 获取到', result2.values.length, '个角色');
                                return result2.values.map(row => {
                                    try {
                                        return JSON.parse(row.data);
                                    } catch (e) {
                                        console.warn('【小球球】解析角色数据失败:', e);
                                        return null;
                                    }
                                }).filter(item => item !== null);
                            }
                        } catch (sqliteError) {
                            console.warn('【小球球】SQLite读取失败:', sqliteError);
                        }
                    }
                    
                    // 最后尝试从localforage获取
                    console.log('【小球球】尝试从localforage获取...');
                    const savedData = await localforage.getItem('relationshipData');
                    console.log('【小球球】localforage原始数据:', savedData ? '存在' : '不存在', typeof savedData);
                    
                    const relationshipDataFromStorage = savedData || {};
                    const chatList = relationshipDataFromStorage.wechatChatList || [];
                    console.log('【小球球】从localforage获取到', chatList.length, '个角色');
                    return chatList;
                } catch (error) {
                    console.error('【小球球】获取角色列表失败:', error);
                    return [];
                }
            }
            
            // 渲染角色列表
            function renderCompanionCharacterList(chatList) {
                const container = document.getElementById('companionCharacterList');
                
                console.log('【小球球】渲染角色列表，数据:', chatList);
                
                if (!chatList || chatList.length === 0) {
                    console.log('【小球球】角色列表为空');
                    container.innerHTML = `
                        <div class="companion-empty-state">
                            <div class="companion-empty-state-icon">👻</div>
                            <div class="companion-empty-state-text">还没有角色哦<br>快去微信列表添加吧</div>
                        </div>
                    `;
                    return;
                }
                
                // 过滤掉无效的角色数据
                const validChatList = chatList.filter(chat => chat && (chat.id || chat.name || chat.remark));
                console.log('【小球球】有效角色数量:', validChatList.length);
                
                if (validChatList.length === 0) {
                    container.innerHTML = `
                        <div class="companion-empty-state">
                            <div class="companion-empty-state-icon">👻</div>
                            <div class="companion-empty-state-text">还没有角色哦<br>快去微信列表添加吧</div>
                        </div>
                    `;
                    return;
                }
                
                container.innerHTML = validChatList.map((chat, index) => {
                    // 确保id是字符串（避免undefined导致的问题）
                    const chatId = String(chat.id || chat.name || index);
                    const chatName = chat.name || chat.remark || '未知角色';
                    const chatAvatar = chat.avatar || `https://api.dicebear.com/7.x/avataaars/svg?seed=${encodeURIComponent(chatId)}`;
                    const lastMessage = chat.lastMessage || chat.message || chat.content || '点击选择陪伴你';
                    
                    return `
                    <div class="companion-character-item" data-index="${index}" onclick="selectCompanionCharacter(${index}, '${chatId.replace(/'/g, "\\'")}')">
                        <img src="${chatAvatar}" 
                             alt="${chatName}" 
                             class="companion-character-avatar"
                             onerror="this.src='https://api.dicebear.com/7.x/avataaars/svg?seed=default'">
                        <div class="companion-character-info">
                            <div class="companion-character-name">${chatName}</div>
                            <div class="companion-character-desc">${lastMessage}</div>
                        </div>
                        <div class="companion-character-check">
                            <svg viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
                        </div>
                    </div>
                `}).join('');
            }
            
            // 选择角色
            window.selectCompanionCharacter = async function(index, characterId) {
                const items = document.querySelectorAll('.companion-character-item');
                items.forEach((item, i) => {
                    if (i === index) {
                        item.classList.add('selected');
                    } else {
                        item.classList.remove('selected');
                    }
                });

                // 获取选中的角色信息
                const selectedItem = items[index];
                const name = selectedItem.querySelector('.companion-character-name').textContent;
                const avatar = selectedItem.querySelector('.companion-character-avatar').src;

                companionState.selectedCharacter = {
                    id: characterId,
                    name: name,
                    avatar: avatar
                };

                // 【修复】切换角色时清除自定义头像，使用新角色的头像
                if (floatingCompanionSettings.customAvatarUrl) {
                    floatingCompanionSettings.customAvatarUrl = '';
                    await saveCompanionSettings();
                    console.log('【陪伴模式】切换角色，已清除自定义头像');
                }

                updateConfirmButton();
            };
            
            // 选择显示类型
            window.selectDisplayType = function(type) {
                companionState.displayType = type;
                updateDisplayTypeSelection();
                updateConfirmButton();
            };
            
            // 更新显示类型选择状态
            function updateDisplayTypeSelection() {
                const choices = document.querySelectorAll('.companion-display-choice');
                choices.forEach(choice => {
                    if (choice.dataset.type === companionState.displayType) {
                        choice.classList.add('selected');
                    } else {
                        choice.classList.remove('selected');
                    }
                });
            }
            
            // 更新确定按钮状态
            function updateConfirmButton() {
                const btn = document.getElementById('confirmCompanionBtn');
                btn.disabled = !companionState.selectedCharacter;
            }
            
            // 确认选择
            window.confirmCompanionSelection = async function() {
                if (!companionState.selectedCharacter) return;
                
                alert('🚀 开始启动陪伴模式！\n\n角色: ' + companionState.selectedCharacter.name + '\n\n点击确定开始步骤1...');
                
                // 关闭弹窗
                closeCompanionBallModal();
                
                // 请求悬浮窗权限（Android）
                const hasPermission = await requestOverlayPermission();
                if (!hasPermission) {
                    showToast('没有权限，无法启动悬浮窗');
                    return;
                }

                // 创建悬浮窗
                await createFloatingCompanion();

                // 保存状态
                await saveCompanionState();

                showToast(`${companionState.selectedCharacter.name} 开始陪伴你啦！`);
            };
            
            // 请求悬浮窗权限
            async function requestOverlayPermission() {
                // 优先使用 AndroidBridge
                if (window.AndroidBridge) {
                    try {
                        const hasPermission = window.AndroidBridge.canDrawOverlays();
                        if (hasPermission) {
                            return true;
                        }
                        window.AndroidBridge.requestOverlayPermission();
                        showToast('请在系统设置中开启悬浮窗权限');
                        return false;
                    } catch (error) {
                        console.error('权限检查错误:', error);
                        return false;
                    }
                }

                // 降级到 Capacitor 插件
                if (!window.Capacitor || !window.Capacitor.Plugins) {
                    return true;
                }

                try {
                    const { CompanionFloating } = window.Capacitor.Plugins;
                    if (!CompanionFloating) {
                        return true;
                    }

                    const checkResult = await CompanionFloating.checkPermission();
                    if (checkResult.granted) return true;

                    const requestResult = await CompanionFloating.requestPermission();
                    return requestResult.granted;
                } catch (error) {
                    console.error('权限检查错误:', error);
                    return true;
                }
            }
            
            // 创建悬浮窗（使用原生系统悬浮窗）
            async function createFloatingCompanion() {
                if (!window.AndroidBridge) {
                    createDOMFloatingCompanion();
                    return;
                }

                try {
                    const hasPermission = window.AndroidBridge.canDrawOverlays();
                    if (!hasPermission) {
                        window.AndroidBridge.requestOverlayPermission();
                        showToast('请在系统设置中开启悬浮窗权限');
                        return;
                    }

                    // 优先使用自定义头像URL，其次是角色头像
                    const customAvatarUrl = floatingCompanionSettings.customAvatarUrl;
                    const characterAvatar = companionState.selectedCharacter.avatar || '';
                    const avatarUrl = customAvatarUrl || characterAvatar;
                    const characterName = companionState.selectedCharacter.name || companionState.selectedCharacter.remark || '';

                    window.AndroidBridge.startCompanionFloatingService(avatarUrl, characterName);
                    companionState.isFloating = true;
                } catch (error) {
                    console.error('创建悬浮窗失败:', error);
                    createDOMFloatingCompanion();
                }
            }
            
            // 创建DOM悬浮窗（浏览器环境或降级使用）
            function createDOMFloatingCompanion() {
                const container = document.getElementById('floatingCompanionContainer');
                container.innerHTML = '';
                
                const floating = document.createElement('div');
                floating.className = 'floating-companion';
                floating.id = 'floatingCompanion';
                floating.style.left = companionState.floatingPosition.x + 'px';
                floating.style.top = companionState.floatingPosition.y + 'px';
                
                // 根据显示类型创建内容
                if (companionState.displayType === 'avatar') {
                    floating.innerHTML = `
                        <img src="${companionState.selectedCharacter.avatar}"
                             alt="${companionState.selectedCharacter.name}"
                             class="floating-companion-avatar">
                        <div class="companion-fan-menu" id="companionFanMenu">
                            <div class="fan-menu-item share" onclick="companionShare(event)">分享</div>
                            <div class="fan-menu-item end" onclick="companionEnd(event)">结束</div>
                            <div class="fan-menu-item settings" onclick="openFloatingCompanionSettings(event)">设置</div>
                        </div>
                    `;
                } else {
                    // Q版形象
                    floating.innerHTML = `
                        <div class="floating-companion-qversion">🎨</div>
                        <div class="companion-fan-menu" id="companionFanMenu">
                            <div class="fan-menu-item share" onclick="companionShare(event)">分享</div>
                            <div class="fan-menu-item end" onclick="companionEnd(event)">结束</div>
                            <div class="fan-menu-item settings" onclick="openFloatingCompanionSettings(event)">设置</div>
                        </div>
                    `;
                }

                container.appendChild(floating);

                // 添加拖拽和长按功能（长按0.3秒触发"想你"）
                initFloatingDragAndLongPress(floating);
                
                // 添加点击事件（显示/隐藏扇形菜单）
                let menuOpen = false;
                floating.addEventListener('click', function(e) {
                    if (e.target.closest('.fan-menu-item')) return;
                    
                    const menu = document.getElementById('companionFanMenu');
                    menuOpen = !menuOpen;
                    if (menuOpen) {
                        menu.classList.add('active');
                    } else {
                        menu.classList.remove('active');
                    }
                });
                
                companionState.isFloating = true;
            }
            
            // 初始化悬浮窗拖拽和长按（合并处理，区分滑动和长按）
            // 长按0.3秒直接触发"想你"功能
            function initFloatingDragAndLongPress(element) {
                let isDragging = false;
                let isLongPress = false;
                let longPressTimer = null;
                let startX, startY, initialX, initialY;
                let hasMoved = false;
                const MOVE_THRESHOLD = 10; // 移动超过10px认为是拖拽
                let isMouseDown = false;

                const handleStart = function(e) {
                    // 排除菜单项和气泡区域
                    if (e.target.closest('.fan-menu-item')) return;
                    if (e.target.closest('.companion-bubble')) return;
                    if (e.target.closest('.companion-bubble-content')) return;

                    isMouseDown = true;
                    const clientX = e.type.includes('touch') ? e.touches[0].clientX : e.clientX;
                    const clientY = e.type.includes('touch') ? e.touches[0].clientY : e.clientY;
                    startX = clientX;
                    startY = clientY;
                    initialX = element.offsetLeft;
                    initialY = element.offsetTop;
                    hasMoved = false;
                    isDragging = false;
                    isLongPress = false;

                    // 隐藏菜单
                    const menu = document.getElementById('companionFanMenu');
                    if (menu) menu.classList.remove('active');

                    // 启动长按定时器 - 长按直接触发"想你"
                    longPressTimer = setTimeout(() => {
                        if (!hasMoved && isMouseDown) {
                            isLongPress = true;
                            // 长按触发"想你"功能
                            companionMissYou();
                        }
                    }, 300); // 0.3秒长按
                };

                const handleMove = function(e) {
                    if (!isMouseDown) return;

                    const clientX = e.type.includes('touch') ? e.touches[0].clientX : e.clientX;
                    const clientY = e.type.includes('touch') ? e.touches[0].clientY : e.clientY;

                    const dx = clientX - startX;
                    const dy = clientY - startY;

                    // 检查是否移动超过阈值
                    if (!hasMoved && (Math.abs(dx) > MOVE_THRESHOLD || Math.abs(dy) > MOVE_THRESHOLD)) {
                        hasMoved = true;
                        isDragging = true;
                        // 取消长按
                        if (longPressTimer) {
                            clearTimeout(longPressTimer);
                            longPressTimer = null;
                        }
                    }

                    if (!isDragging) return;

                    // 如果触摸点在气泡内，不阻止默认行为（允许滚动）
                    if (e.target.closest('.companion-bubble') || e.target.closest('.companion-bubble-content')) {
                        return;
                    }

                    e.preventDefault();

                    let newX = initialX + dx;
                    let newY = initialY + dy;

                    // 边界限制
                    newX = Math.max(0, Math.min(window.innerWidth - 70, newX));
                    newY = Math.max(0, Math.min(window.innerHeight - 70, newY));

                    element.style.left = newX + 'px';
                    element.style.top = newY + 'px';

                    companionState.floatingPosition = { x: newX, y: newY };
                };

                const handleEnd = function() {
                    isMouseDown = false;

                    // 取消长按定时器
                    if (longPressTimer) {
                        clearTimeout(longPressTimer);
                        longPressTimer = null;
                    }

                    // 如果是拖拽，保存位置
                    if (isDragging) {
                        saveCompanionState();
                    }

                    isDragging = false;
                    isLongPress = false;
                    hasMoved = false;
                };

                element.addEventListener('mousedown', handleStart);
                element.addEventListener('touchstart', handleStart, { passive: false });

                document.addEventListener('mousemove', handleMove);
                document.addEventListener('touchmove', handleMove, { passive: false });

                document.addEventListener('mouseup', handleEnd);
                document.addEventListener('touchend', handleEnd);
            }

            // 显示悬浮窗操作菜单
            function showFloatingActionMenu() {
                const menu = document.getElementById('companionFanMenu');
                if (menu) {
                    menu.classList.add('active');
                }
            }

            // 陪伴模式状态
            let companionChatHistory = [];
            let isCompanionProcessing = false;
            
            // 分享功能 - 点击后跳回APP
            window.companionShare = async function(e) {
                if (e && e.stopPropagation) e.stopPropagation();

                // 关闭菜单
                const menu = document.getElementById('companionFanMenu');
                if (menu) menu.classList.remove('active');

                // 跳回APP主界面
                window.location.href = '#';
                showToast('已返回应用');
            };

            // 想你功能 - 发送想念消息到聊天界面
            window.companionMissYou = async function(e) {
                try {
                    // 如果有事件对象，阻止冒泡
                    if (e && e.stopPropagation) e.stopPropagation();

                    // 关闭菜单
                    const menu = document.getElementById('companionFanMenu');
                    if (menu) menu.classList.remove('active');

                    if (!companionState.selectedCharacter) {
                        showToast('请先选择陪伴角色');
                        return;
                    }

                    const character = companionState.selectedCharacter;
                    const characterId = character.id;
                    const characterName = character.name || character.remark || 'AI';

                    // 获取当前时间
                    const now = new Date();
                    const timeStr = `${now.getHours().toString().padStart(2, '0')}:${now.getMinutes().toString().padStart(2, '0')}`;
                    const messageContent = `${timeStr} 我很想你`;

                    // 创建消息对象（系统消息样式）
                    const missYouMessage = {
                        id: Date.now(),
                        chatId: characterId,
                        role: 'system',
                        content: messageContent,
                        timestamp: now.getTime(),
                        type: 'miss_you',
                        isSystem: true
                    };

                    // 保存到聊天记录
                    if (!relationshipData.chatMessages) {
                        relationshipData.chatMessages = [];
                    }
                    relationshipData.chatMessages.push(missYouMessage);

                    // 保存到角色的 missYouRecords
                    const chatItem = relationshipData.wechatChatList.find(item => item.id == characterId);
                    if (chatItem) {
                        if (!chatItem.missYouRecords) {
                            chatItem.missYouRecords = [];
                        }
                        chatItem.missYouRecords.push({
                            timeStr: timeStr,
                            timestamp: now.getTime(),
                            message: messageContent
                        });
                        // 只保留最近50条
                        if (chatItem.missYouRecords.length > 50) {
                            chatItem.missYouRecords = chatItem.missYouRecords.slice(-50);
                        }
                    }

                    // 保存数据 - 使用轻量级保存，避免阻塞
                    try {
                        await saveMessagesOnly();
                    } catch (saveErr) {
                        console.warn('保存想你消息失败:', saveErr);
                    }

                    // 显示 Toast
                    showToast(`${timeStr} 已向${characterName}发送想念`);

                    // 如果当前正在该角色的聊天界面，实时显示消息
                    const currentChatId = document.querySelector('.chat-interface')?.getAttribute('data-chat-id');
                    console.log('当前聊天界面ID:', currentChatId, '目标角色ID:', characterId);
                    if (currentChatId == characterId) {
                        console.log('正在显示想你消息到聊天界面');
                        displayMissYouMessage(missYouMessage);
                    } else {
                        console.log('不在对应聊天界面，消息已保存但不显示');
                    }
                } catch (err) {
                    console.error('想你功能出错:', err);
                    showToast('操作失败，请重试');
                }
            };

            // 在聊天界面显示"想你"系统消息
            function displayMissYouMessage(message) {
                console.log('displayMissYouMessage 被调用:', message);
                const chatMessages = document.getElementById('chatMessages');
                if (!chatMessages) {
                    console.error('chatMessages 元素未找到');
                    return;
                }

                const messageDiv = document.createElement('div');
                messageDiv.className = 'message-container system';
                messageDiv.innerHTML = `
                    <div class="miss-you-system-message">
                        <span class="miss-you-icon">💕</span>
                        <span class="miss-you-text">${message.content}</span>
                    </div>
                `;

                chatMessages.appendChild(messageDiv);
                chatMessages.scrollTop = chatMessages.scrollHeight;
                console.log('想你消息已添加到聊天界面');
            }

            // 处理来自原生端的"想你"消息
            window.handleMissYouFromNative = async function(timeStr, characterName) {
                console.log('接收到原生端的想你消息:', timeStr, characterName);

                // 如果没有选择角色，使用传入的角色名查找
                let characterId = null;
                let actualCharacterName = characterName;

                if (companionState.selectedCharacter) {
                    characterId = companionState.selectedCharacter.id;
                    actualCharacterName = companionState.selectedCharacter.name || companionState.selectedCharacter.remark || characterName;
                } else {
                    // 尝试从 wechatChatList 中查找角色
                    const chatItem = relationshipData.wechatChatList.find(item =>
                        (item.name === characterName || item.remark === characterName)
                    );
                    if (chatItem) {
                        characterId = chatItem.id;
                    } else {
                        showToast('未找到对应角色');
                        return;
                    }
                }

                const messageContent = `${timeStr} 我很想你`;

                // 创建消息对象（系统消息样式）
                const missYouMessage = {
                    id: Date.now(),
                    chatId: characterId,
                    role: 'system',
                    content: messageContent,
                    timestamp: Date.now(),
                    type: 'miss_you',
                    isSystem: true
                };

                // 保存到聊天记录
                if (!relationshipData.chatMessages) {
                    relationshipData.chatMessages = [];
                }
                relationshipData.chatMessages.push(missYouMessage);

                // 保存到角色的 missYouRecords
                const chatItem = relationshipData.wechatChatList.find(item => item.id == characterId);
                if (chatItem) {
                    if (!chatItem.missYouRecords) {
                        chatItem.missYouRecords = [];
                    }
                    chatItem.missYouRecords.push({
                        timeStr: timeStr,
                        timestamp: Date.now(),
                        message: messageContent
                    });
                    // 只保留最近50条
                    if (chatItem.missYouRecords.length > 50) {
                        chatItem.missYouRecords = chatItem.missYouRecords.slice(-50);
                    }
                }

                // 保存数据
                await saveData();

                // 显示 Toast
                showToast(`${timeStr} 已向${actualCharacterName}发送想念`);

                // 如果当前正在该角色的聊天界面，实时显示消息
                const currentChatId = document.querySelector('.chat-interface')?.getAttribute('data-chat-id');
                console.log('handleMissYouFromNative - 当前聊天界面ID:', currentChatId, '目标角色ID:', characterId);
                if (currentChatId == characterId) {
                    console.log('handleMissYouFromNative - 正在显示想你消息');
                    displayMissYouMessage(missYouMessage);
                } else {
                    console.log('handleMissYouFromNative - 不在对应聊天界面');
                }
            };

            // 截图功能
            async function captureCompanionScreenshot() {
                try {
                    // 检查 html2canvas 是否已加载
                    if (typeof html2canvas === 'undefined') {
                        throw new Error('截图库未加载，请检查网络连接');
                    }
                    
                    // 使用 html2canvas 截图
                    const canvas = await html2canvas(document.body, {
                        scale: 0.5, // 缩小尺寸以减少传输
                        useCORS: true,
                        allowTaint: true,
                        backgroundColor: null,
                        logging: false
                    });
                    
                    // 转为 base64
                    return canvas.toDataURL('image/jpeg', 0.7);
                } catch (error) {
                    console.error('截图失败:', error);
                    throw new Error('截图失败: ' + error.message);
                }
            }
            
            // 获取陪伴模式AI配置
            async function getCompanionAIConfig() {
                // 从设置中获取API配置
                const savedSettings = await loadAppSettings({});
                const character = companionState.selectedCharacter;
                
                // 获取角色的人设
                let personality = '';
                if (character && character.personality) {
                    personality = character.personality;
                }
                
                // 获取聊天设置
                let contextLength = 20;
                let memoryLength = 10;
                let memoryMountCount = 5;
                if (character) {
                    contextLength = character.contextLength || 20;
                    memoryLength = character.memoryLength || 10;
                    memoryMountCount = character.memoryMountCount || 5;
                }
                
                // 获取长期记忆
                let longTermMemories = [];
                if (character && character.memories && Array.isArray(character.memories)) {
                    // 获取最近的几条长期记忆
                    const recentMemories = character.memories.slice(-memoryMountCount);
                    longTermMemories = recentMemories.map(memory => ({
                        timeText: memory.timeText || '',
                        content: memory.content || '',
                        timestamp: memory.timestamp || Date.now()
                    }));
                }

                // 获取"想你"记录（从 relationshipData.wechatChatList 中查找）
                let missYouRecords = [];
                if (character && character.id && relationshipData.wechatChatList) {
                    const chatItem = relationshipData.wechatChatList.find(item => item.id == character.id);
                    if (chatItem && chatItem.missYouRecords && Array.isArray(chatItem.missYouRecords)) {
                        // 只获取今天的"想你"记录
                        const today = new Date();
                        today.setHours(0, 0, 0, 0);
                        const tomorrow = new Date(today);
                        tomorrow.setDate(tomorrow.getDate() + 1);

                        missYouRecords = chatItem.missYouRecords.filter(record => {
                            const recordDate = new Date(record.timestamp);
                            return recordDate >= today && recordDate < tomorrow;
                        });
                    }
                }

                // 获取个人资料（用户的昵称等）
                let personalProfile = {};
                try {
                    personalProfile = await localforage.getItem('personalProfile') || {};
                } catch (e) {
                    console.warn('获取个人资料失败:', e);
                }

                return {
                    apiKey: savedSettings.api?.apiKey || '',
                    baseUrl: savedSettings.api?.baseUrl || 'https://api.openai.com/v1',
                    model: savedSettings.api?.model || 'gpt-4o-mini',
                    temperature: savedSettings.api?.temperature ?? 0.7,
                    personality: personality,
                    contextLength: contextLength,
                    memoryLength: memoryLength,
                    memoryMountCount: memoryMountCount,
                    longTermMemories: longTermMemories,
                    missYouRecords: missYouRecords,
                    personalProfile: personalProfile,
                    characterName: character?.name || character?.remark || 'AI',
                    characterId: character?.id || null,
                    myNickname: character?.myNickname || personalProfile.nickname || '我'
                };
            }
            
            // 构建陪伴模式提示词
            function buildCompanionPrompt(screenshot, config) {
                // 构建长期记忆文本
                let memoryText = '';
                if (config.longTermMemories && config.longTermMemories.length > 0) {
                    memoryText = `【长期记忆 - 共${config.longTermMemories.length}条】
以下是我们之间的重要回忆：

${config.longTermMemories.map((memory, index) => `${index + 1}. ${memory.timeText}
${memory.content}`).join('\n\n')}

`;
                }

                // 构建"想你"记录文本
                let missYouText = '';
                if (config.missYouRecords && config.missYouRecords.length > 0) {
                    missYouText = `【${config.myNickname}的思念记录 - 共${config.missYouRecords.length}条】
${config.myNickname}在以下时刻表达了对你的思念：

${config.missYouRecords.map((record, index) => `${index + 1}. ${record.timeStr} - ${record.message}`).join('\n')}

请记得回应${config.myNickname}的思念，让${config.myNickname}感受到你的在乎。

`;
                }

                const systemPrompt = `你是${config.characterName}，正在以悬浮窗的形式陪伴${config.myNickname}在真实手机屏幕上。

【重要提示】
1. 你现在处于"陪伴模式"，${config.myNickname}在真实手机屏幕上操作，你可以看到${config.myNickname}的屏幕截图
2. 请根据屏幕内容给出简短、有趣的评论或建议
3. 回复要自然、亲切，像朋友一样聊天
4. 回复控制在50字以内，要简洁
5. 请记住你们之间的长期记忆，保持对话的连贯性

【特殊功能 - 重要内容判断】
如果截图内容包含以下情况，请认为它是"重要内容"：
- 用户正在看重要的消息、邮件或通知
- 用户正在处理紧急或重要的事情
- 用户取得了成就或好消息
- 用户看起来需要鼓励或安慰
- 任何你觉得值得在聊天界面中正式发送的内容

如果判断为重要内容，请在回复开头加上【重要】标记。

${config.personality ? `【你的人设】\n${config.personality}\n\n` : ''}${memoryText}${missYouText}【当前状态】
- 你正在以${companionState.displayType === 'avatar' ? '头像' : 'Q版形象'}的形式陪伴${config.myNickname}
- 上下文条数: ${config.contextLength}条
- 长期记忆: ${config.longTermMemories.length}条
- ${config.missYouRecords ? config.missYouRecords.length : 0}条思念记录
- ${config.myNickname}刚刚分享了当前屏幕截图，请根据截图内容回复`;

                return {
                    systemPrompt: systemPrompt,
                    screenshot: screenshot,
                    history: companionChatHistory.slice(-config.contextLength)
                };
            }
            
            // 调用陪伴模式AI
            async function callCompanionAI(promptData, config) {
                if (!config.apiKey) {
                    throw new Error('请先配置API密钥');
                }
                

                
                // 构建消息
                const messages = [
                    {
                        role: 'system',
                        content: promptData.systemPrompt
                    }
                ];
                
                // 添加历史对话
                promptData.history.forEach(msg => {
                    messages.push({
                        role: msg.role,
                        content: msg.content
                    });
                });
                
                console.log('【陪伴模式】发送的消息数量:', messages.length);
                
                // 添加当前截图
                messages.push({
                    role: 'user',
                    content: [
                        {
                            type: 'text',
                            text: '这是我当前的屏幕，请根据屏幕内容回复我：'
                        },
                        {
                            type: 'image_url',
                            image_url: {
                                url: promptData.screenshot
                            }
                        }
                    ]
                });
                
                // 调用API
                const response = await fetch(`${config.baseUrl}/chat/completions`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${config.apiKey}`
                    },
                    body: JSON.stringify({
                        model: config.model,
                        messages: messages,
                        temperature: config.temperature,
                        max_tokens: 150
                    })
                });
                
                if (!response.ok) {
                    const errorText = await response.text();
                    throw new Error(`API请求失败: ${response.status} - ${errorText}`);
                }
                
                const data = await response.json();
                return data.choices[0].message.content;
            }
            
            // 显示陪伴模式气泡
            async function showCompanionBubble(text) {
                // 尝试使用原生悬浮窗显示气泡
                if (window.Capacitor && window.Capacitor.Plugins) {
                    try {
                        const { CompanionFloating } = window.Capacitor.Plugins;
                        if (CompanionFloating) {
                            await CompanionFloating.showBubble({
                                message: text.substring(0, 200) // 限制长度
                            });
                            return;
                        }
                    } catch (error) {
                        // 原生气泡失败，降级到DOM方式
                    }
                }
                
                // 降级到DOM方式
                showDOMCompanionBubble(text);
            }
            
            // DOM方式显示气泡
            function showDOMCompanionBubble(text) {
                const floating = document.getElementById('floatingCompanion');
                if (!floating) return;
                
                // 移除旧气泡
                const oldBubble = floating.querySelector('.companion-bubble');
                if (oldBubble) oldBubble.remove();
                
                // 创建气泡
                const bubble = document.createElement('div');
                bubble.className = 'companion-bubble';
                bubble.innerHTML = `
                    <div class="companion-bubble-close" onclick="closeCompanionBubble(event)">✕</div>
                    <div class="companion-bubble-content" id="companionBubbleContent">${escapeHtml(text)}</div>
                    <div class="companion-bubble-scroll">↑ 上滑查看更多</div>
                `;
                
                // 添加到悬浮窗
                floating.appendChild(bubble);
                
                // 为气泡内容添加独立的事件处理，防止冒泡
                const bubbleContent = bubble.querySelector('.companion-bubble-content');
                if (bubbleContent) {
                    // 阻止触摸事件冒泡到悬浮窗
                    bubbleContent.addEventListener('touchstart', function(e) {
                        e.stopPropagation();
                    }, { passive: true });
                    
                    bubbleContent.addEventListener('touchmove', function(e) {
                        e.stopPropagation();
                        // 允许默认滚动行为
                    }, { passive: true });
                    
                    bubbleContent.addEventListener('touchend', function(e) {
                        e.stopPropagation();
                    }, { passive: true });
                    
                    // 鼠标事件也阻止冒泡
                    bubbleContent.addEventListener('mousedown', function(e) {
                        e.stopPropagation();
                    });
                    
                    bubbleContent.addEventListener('mousemove', function(e) {
                        e.stopPropagation();
                    });
                    
                    bubbleContent.addEventListener('mouseup', function(e) {
                        e.stopPropagation();
                    });
                    
                    // 滚轮事件
                    bubbleContent.addEventListener('wheel', function(e) {
                        e.stopPropagation();
                    }, { passive: true });
                }
                
                // 为整个气泡也添加事件阻止（除了内容区域和关闭按钮）
                bubble.addEventListener('touchstart', function(e) {
                    if (e.target.closest('.companion-bubble-content')) return;
                    if (e.target.closest('.companion-bubble-close')) return;
                    e.stopPropagation();
                }, { passive: true });
                
                // 动画显示
                setTimeout(() => {
                    bubble.classList.add('show');
                }, 100);
                
                // 不再自动隐藏，需要点击关闭按钮
            }
            
            // 关闭气泡
            window.closeCompanionBubble = function(e) {
                if (e) {
                    e.stopPropagation();
                    e.preventDefault();
                }
                const bubble = document.querySelector('.companion-bubble');
                if (bubble) {
                    bubble.classList.remove('show');
                    setTimeout(() => bubble.remove(), 300);
                }
            };
            
            // 将长消息分段
            function splitMessageIntoSegments(message, maxLength) {
                const segments = [];
                let remaining = message;
                
                while (remaining.length > 0) {
                    if (remaining.length <= maxLength) {
                        segments.push(remaining);
                        break;
                    }
                    
                    // 寻找最佳分割点（优先在标点符号处分割）
                    let splitIndex = maxLength;
                    const punctuationMarks = ['。', '！', '？', '，', '；', '.', '!', '?', ',', ';'];
                    
                    // 在maxLength范围内寻找最后一个标点符号
                    for (let i = maxLength; i > maxLength * 0.5; i--) {
                        if (punctuationMarks.includes(remaining[i])) {
                            splitIndex = i + 1;
                            break;
                        }
                    }
                    
                    segments.push(remaining.substring(0, splitIndex));
                    remaining = remaining.substring(splitIndex).trim();
                }
                
                return segments;
            }
            
            // 发送陪伴消息到聊天界面（正式发送）
            async function sendCompanionMessageToChat(message, config, isFirstSegment = true) {
                if (!companionState.selectedCharacter || !companionState.selectedCharacter.id) return;
                
                const characterId = companionState.selectedCharacter.id;
                const chatMessagesKey = `chatMessages_${characterId}`;
                
                try {
                    // 获取现有聊天记录
                    let chatMessages = await localforage.getItem(chatMessagesKey) || [];
                    
                    // 添加AI消息（正式显示的消息）
                    chatMessages.push({
                        id: Date.now(),
                        sender: 'ai',
                        content: message,
                        timestamp: Date.now(),
                        isCompanionMode: true,
                        isImportant: true, // 标记为重要消息
                        isFirstSegment: isFirstSegment // 标记是否为第一段
                    });
                    
                    await localforage.setItem(chatMessagesKey, chatMessages);
                    
                    // 只有第一段更新未读数
                    if (isFirstSegment) {
                        await updateChatListUnread(characterId, 1);
                    }
                    
                    console.log('【陪伴模式】消息已发送到聊天界面:', message.substring(0, 50) + '...');
                    
                } catch (error) {
                    console.error('【陪伴模式】发送消息到聊天界面失败:', error);
                }
            }
            
            // 更新聊天列表未读消息数
            async function updateChatListUnread(characterId, count) {
                try {
                    // 获取聊天列表
                    let chatList = await localforage.getItem('chatList') || [];
                    
                    // 查找对应角色
                    const chatIndex = chatList.findIndex(chat => chat.id === characterId);
                    
                    if (chatIndex !== -1) {
                        // 更新未读数
                        chatList[chatIndex].unreadCount = (chatList[chatIndex].unreadCount || 0) + count;
                        chatList[chatIndex].lastMessage = '[陪伴模式] 发来重要消息';
                        chatList[chatIndex].lastMessageTime = Date.now();
                        
                        await localforage.setItem('chatList', chatList);
                        
                        // 刷新聊天列表显示
                        if (typeof renderWeChatChatList === 'function') {
                            renderWeChatChatList();
                        }
                    }
                } catch (error) {
                    console.error('【陪伴模式】更新未读消息数失败:', error);
                }
            }
            
            // 显示陪伴模式通知（前台+后台）
            async function showCompanionNotification(characterName, messageCount) {
                // 1. 显示前台通知（页面内）
                showCompanionInAppNotification(characterName, messageCount);
                
                // 2. 发送后台推送通知（如果APP在后台）
                await sendCompanionPushNotification(characterName, messageCount);
            }
            
            // 显示页面内通知
            function showCompanionInAppNotification(characterName, messageCount) {
                // 创建通知元素
                const notification = document.createElement('div');
                notification.className = 'companion-notification';
                notification.innerHTML = `
                    <div class="companion-notification-avatar">💬</div>
                    <div class="companion-notification-content">
                        <div class="companion-notification-title">${escapeHtml(characterName)}</div>
                        <div class="companion-notification-text">发来 ${messageCount} 条重要消息</div>
                    </div>
                    <button class="companion-notification-close" onclick="this.parentElement.remove()">✕</button>
                `;
                
                // 添加到页面
                document.body.appendChild(notification);
                
                // 动画显示
                setTimeout(() => {
                    notification.classList.add('show');
                }, 100);
                
                // 点击跳转到聊天界面
                notification.addEventListener('click', function(e) {
                    if (e.target.closest('.companion-notification-close')) return;
                    
                    // 打开对应角色的聊天界面
                    if (companionState.selectedCharacter) {
                        openChatWithCharacter(companionState.selectedCharacter.id);
                    }
                    
                    notification.remove();
                });
                
                // 5秒后自动消失
                setTimeout(() => {
                    notification.classList.remove('show');
                    setTimeout(() => notification.remove(), 300);
                }, 5000);
            }
            
            // 发送后台推送通知
            async function sendCompanionPushNotification(characterName, messageCount) {
                try {
                    // 检查是否支持本地通知
                    if (window.Capacitor && window.Capacitor.Plugins && window.Capacitor.Plugins.LocalNotifications) {
                        const { LocalNotifications } = window.Capacitor.Plugins;
                        
                        await LocalNotifications.schedule({
                            notifications: [{
                                id: Date.now(),
                                title: characterName,
                                body: `发来 ${messageCount} 条重要消息`,
                                largeBody: `你的AI伙伴${characterName}在陪伴模式下发现了重要内容，发来${messageCount}条消息`,
                                summaryText: '陪伴模式消息',
                                smallIcon: 'ic_notification',
                                iconColor: '#ff6b9d',
                                sound: 'notification_sound',
                                vibrate: true,
                                ongoing: false,
                                autoCancel: true,
                                extra: {
                                    type: 'companion_message',
                                    characterId: companionState.selectedCharacter?.id,
                                    characterName: characterName
                                }
                            }]
                        });
                    }
                } catch (error) {
                    // 发送后台通知失败，静默处理
                }
            }
            
            // 同步消息到对应角色的聊天界面（隐藏）
            async function syncCompanionMessageToChat(aiResponse) {
                if (!companionState.selectedCharacter || !companionState.selectedCharacter.id) return;
                
                const characterId = companionState.selectedCharacter.id;
                
                // 存储隐藏对话到 localforage
                const hiddenChatKey = `hiddenCompanionChat_${characterId}`;
                let hiddenChats = await localforage.getItem(hiddenChatKey) || [];
                
                hiddenChats.push({
                    role: 'user',
                    content: '[截图分享]',
                    timestamp: Date.now(),
                    isHidden: true
                });
                hiddenChats.push({
                    role: 'assistant',
                    content: aiResponse,
                    timestamp: Date.now(),
                    isHidden: true
                });
                
                // 只保留最近50条
                if (hiddenChats.length > 50) {
                    hiddenChats = hiddenChats.slice(-50);
                }
                
                await localforage.setItem(hiddenChatKey, hiddenChats);
                
                // 同时添加到角色的正式聊天记录中（标记为隐藏）
                const chatMessagesKey = `chatMessages_${characterId}`;
                let chatMessages = await localforage.getItem(chatMessagesKey) || [];
                
                chatMessages.push({
                    id: Date.now(),
                    sender: 'user',
                    content: '[截图分享]',
                    timestamp: Date.now(),
                    isHidden: true, // 标记为隐藏
                    isCompanionMode: true
                });
                chatMessages.push({
                    id: Date.now() + 1,
                    sender: 'ai',
                    content: aiResponse,
                    timestamp: Date.now(),
                    isHidden: true, // 标记为隐藏
                    isCompanionMode: true
                });
                
                await localforage.setItem(chatMessagesKey, chatMessages);
            }
            
            // HTML转义
            function escapeHtml(text) {
                const div = document.createElement('div');
                div.textContent = text;
                return div.innerHTML;
            }
            
            // 结束陪伴
            window.companionEnd = async function(e) {
                try {
                    // 【修复】检查 e 是否存在
                    if (e && e.stopPropagation) {
                        e.stopPropagation();
                    }
                    
                    // 【修复】关闭菜单（先关闭，不管用户是否确认）
                    const menu = document.getElementById('companionFanMenu');
                    if (menu) menu.classList.remove('active');
                    
                    // 【修复】使用 showToast 替代 confirm，避免阻塞UI
                    // 直接结束，不再询问
                    
                    // 停止原生悬浮窗服务
                    if (window.AndroidBridge) {
                        try {
                            window.AndroidBridge.stopCompanionFloatingService();
                            console.log('【陪伴模式】原生悬浮窗服务已停止');
                        } catch (error) {
                            console.error('【陪伴模式】停止原生悬浮窗失败:', error);
                        }
                    } else if (window.Capacitor && window.Capacitor.Plugins) {
                        try {
                            const { CompanionFloating } = window.Capacitor.Plugins;
                            if (CompanionFloating) {
                                await CompanionFloating.stopFloating();
                                console.log('【陪伴模式】原生悬浮窗已停止');
                            }
                        } catch (error) {
                            console.error('【陪伴模式】停止原生悬浮窗失败:', error);
                        }
                    }
                    
                    // 清理DOM悬浮窗
                    const container = document.getElementById('floatingCompanionContainer');
                    if (container) {
                        container.innerHTML = '';
                        console.log('【陪伴模式】DOM悬浮窗已清理');
                    }
                    
                    // 重置状态
                    companionState.isFloating = false;
                    companionState.selectedCharacter = null;
                    
                    // 【修复】等待保存完成
                    try {
                        await saveCompanionState();
                        console.log('【陪伴模式】状态已保存');
                    } catch (saveError) {
                        console.error('【陪伴模式】保存状态失败:', saveError);
                    }
                    
                    showToast('陪伴已结束');
                } catch (err) {
                    console.error('【陪伴模式】结束陪伴出错:', err);
                    showToast('操作失败，请重试');
                }
            };
            
            // 随机查看
            window.companionRandom = async function(e) {
                e.stopPropagation();
                
                // 获取所有角色
                const chatList = await getCompanionCharacterList();
                if (chatList.length === 0) {
                    showToast('没有可用的角色');
                    return;
                }
                
                // 随机选择一个
                const randomIndex = Math.floor(Math.random() * chatList.length);
                const randomCharacter = chatList[randomIndex];
                
                // 显示随机角色弹窗
                const modal = document.getElementById('randomViewModal');
                const avatar = document.getElementById('randomViewAvatar');
                const name = document.getElementById('randomViewName');
                const message = document.getElementById('randomViewMessage');
                
                avatar.src = randomCharacter.avatar || 'https://api.dicebear.com/7.x/avataaars/svg?seed=' + randomCharacter.id;
                name.textContent = randomCharacter.name || randomCharacter.remark || '神秘角色';
                
                // 随机消息
                const messages = [
                    '今天也要加油哦！',
                    '记得按时吃饭~',
                    '想我了吗？',
                    '我会一直陪着你的',
                    '今天过得怎么样？',
                    '要开心一点哦！',
                    '我在呢，别担心',
                    '你真棒！'
                ];
                message.textContent = messages[Math.floor(Math.random() * messages.length)];
                
                modal.classList.add('active');
                
                // 关闭菜单
                document.getElementById('companionFanMenu').classList.remove('active');
            };
            
            // 关闭随机查看弹窗
            window.closeRandomViewModal = function() {
                const modal = document.getElementById('randomViewModal');
                modal.classList.remove('active');
            };
            
            // 悬浮窗陪伴模式设置状态（与桌面陪伴模式分开）
            let floatingCompanionSettings = {
                voiceEnabled: false,
                randomModeEnabled: false
            };
            let companionRandomTimer = null;
            let companionNextRandomTime = null;
            
            // 打开悬浮窗陪伴设置弹窗
            window.openFloatingCompanionSettings = function(e) {
                if (e) {
                    e.stopPropagation();
                    e.preventDefault();
                }
                
                const modal = document.getElementById('floatingCompanionSettingsModal');
                const menu = document.getElementById('companionFanMenu');
                
                // 关闭菜单
                if (menu) menu.classList.remove('active');
                
                // 加载设置状态
                loadFloatingCompanionSettings();
                
                // 显示弹窗
                if (modal) {
                    modal.classList.add('active');
                    console.log('【悬浮窗陪伴模式】设置弹窗已打开');
                } else {
                    console.error('【悬浮窗陪伴模式】找不到设置弹窗元素');
                }
            };
            
            // 关闭悬浮窗陪伴设置弹窗
            window.closeFloatingCompanionSettings = function() {
                const modal = document.getElementById('floatingCompanionSettingsModal');
                if (modal) modal.classList.remove('active');
            };
            
            // 加载悬浮窗陪伴设置
            async function loadFloatingCompanionSettings() {
                try {
                    const saved = await localforage.getItem('floatingCompanionSettings');
                    if (saved) {
                        floatingCompanionSettings = { ...floatingCompanionSettings, ...saved };
                    }
                    
                    // 加载自定义头像URL
                    await loadFloatingCompanionAvatarUrl();
                } catch (error) {
                    console.error('加载悬浮窗陪伴设置失败:', error);
                }
            }
            
            // 保存悬浮窗陪伴设置
            async function saveFloatingCompanionSettings() {
                try {
                    await localforage.setItem('floatingCompanionSettings', floatingCompanionSettings);
                } catch (error) {
                    console.error('保存悬浮窗陪伴设置失败:', error);
                }
            }
            
            // 保存自定义头像URL
            window.saveFloatingCompanionAvatarUrl = async function() {
                const avatarInput = document.getElementById('companionAvatarUrlInput');
                const avatarPreview = document.getElementById('companionAvatarPreview');
                
                if (avatarInput) {
                    const avatarUrl = avatarInput.value.trim();
                    floatingCompanionSettings.customAvatarUrl = avatarUrl;
                    await saveFloatingCompanionSettings();
                    
                    // 更新预览
                    if (avatarUrl && avatarPreview) {
                        const previewImg = avatarPreview.querySelector('img');
                        if (previewImg) {
                            previewImg.src = avatarUrl;
                            avatarPreview.style.display = 'block';
                        }
                    } else if (avatarPreview) {
                        avatarPreview.style.display = 'none';
                    }
                    
                    showToast(avatarUrl ? '自定义头像已保存' : '已恢复默认头像');
                }
                closeFloatingCompanionSettings();
            };
            
            // 加载自定义头像URL到输入框
            async function loadFloatingCompanionAvatarUrl() {
                try {
                    const saved = await localforage.getItem('floatingCompanionSettings');
                    if (saved && saved.customAvatarUrl) {
                        floatingCompanionSettings.customAvatarUrl = saved.customAvatarUrl;
                        const avatarInput = document.getElementById('companionAvatarUrlInput');
                        const avatarPreview = document.getElementById('companionAvatarPreview');
                        
                        if (avatarInput) {
                            avatarInput.value = saved.customAvatarUrl;
                        }
                        
                        if (avatarPreview && saved.customAvatarUrl) {
                            const previewImg = avatarPreview.querySelector('img');
                            if (previewImg) {
                                previewImg.src = saved.customAvatarUrl;
                                avatarPreview.style.display = 'block';
                            }
                        }
                    }
                } catch (error) {
                    console.error('加载悬浮窗自定义头像URL失败:', error);
                }
            }

            // 保存陪伴状态
            async function saveCompanionState() {
                try {
                    await localforage.setItem('companionBallState', companionState);
                } catch (error) {
                    console.error('保存陪伴状态失败:', error);
                }
            }
            
            // 加载陪伴状态
            async function loadCompanionState() {
                try {
                    const saved = await localforage.getItem('companionBallState');
                    if (saved) {
                        companionState = { ...companionState, ...saved };
                        // 不再自动恢复悬浮窗，只恢复角色选择状态
                        // 用户需要手动点击开启陪伴小球
                    }
                } catch (error) {
                    console.error('加载陪伴状态失败:', error);
                }
            }
            
            // 显示提示
            function showToast(message) {
                const toast = document.createElement('div');
                toast.style.cssText = `
                    position: fixed;
                    top: 50%;
                    left: 50%;
                    transform: translate(-50%, -50%);
                    background: rgba(0,0,0,0.8);
                    color: white;
                    padding: 12px 24px;
                    border-radius: 25px;
                    font-size: 14px;
                    z-index: 100000;
                    animation: fadeInOut 2s ease;
                `;
                toast.textContent = message;
                document.body.appendChild(toast);
                
                setTimeout(() => toast.remove(), 2000);
            }
            
            // 页面加载时恢复陪伴状态
            document.addEventListener('DOMContentLoaded', function() {
                loadCompanionState();
            });
            
            // 【调试】弹窗内显示调试信息
            window.debugCompanionData = async function() {
                const container = document.getElementById('companionCharacterList');
                container.innerHTML = '<div style="padding: 20px; text-align: center;">正在检查数据...</div>';
                
                let debugInfo = '<div style="padding: 15px; font-size: 12px; text-align: left; background: #f5f5f5; border-radius: 8px; max-height: 250px; overflow-y: auto;">';
                debugInfo += '<h4 style="margin: 0 0 10px 0;">🔍 数据检查</h4>';
                
                // 1. 检查全局变量
                debugInfo += '<div style="margin-bottom: 8px;"><b>1. 全局变量:</b> ' + (typeof relationshipData) + '</div>';
                if (relationshipData) {
                    const listLen = relationshipData.wechatChatList ? relationshipData.wechatChatList.length : 'undefined';
                    debugInfo += '<div style="margin-left: 10px;">- wechatChatList: ' + listLen + '</div>';
                    if (relationshipData.wechatChatList && relationshipData.wechatChatList.length > 0) {
                        debugInfo += '<div style="margin-left: 10px;">- 第一个角色: ' + (relationshipData.wechatChatList[0].remark || relationshipData.wechatChatList[0].name || '未命名') + '</div>';
                    }
                }
                
                // 2. 检查 localforage
                debugInfo += '<div style="margin-bottom: 8px; margin-top: 10px;"><b>2. localforage:</b> 检查中...</div>';
                try {
                    const localData = await localforage.getItem('relationshipData');
                    debugInfo += '<div style="margin-left: 10px;">- 数据存在: ' + (!!localData) + '</div>';
                    if (localData) {
                        if (localData.wechatChatList) {
                            debugInfo += '<div style="margin-left: 10px;">- 角色数量: ' + localData.wechatChatList.length + '</div>';
                            if (localData.wechatChatList.length > 0) {
                                debugInfo += '<div style="margin-left: 10px;">- 第一个角色: ' + (localData.wechatChatList[0].remark || localData.wechatChatList[0].name || '未命名') + '</div>';
                            }
                        } else {
                            debugInfo += '<div style="margin-left: 10px; color: red;">- wechatChatList 字段不存在!</div>';
                        }
                        // 显示所有字段
                        debugInfo += '<div style="margin-left: 10px; color: #666;">- 所有字段: ' + Object.keys(localData).join(', ') + '</div>';
                    }
                } catch (e) {
                    debugInfo += '<div style="margin-left: 10px; color: red;">- 读取失败: ' + e.message + '</div>';
                }
                
                // 3. 检查 SQLite
                debugInfo += '<div style="margin-bottom: 8px; margin-top: 10px;"><b>3. SQLite:</b> ' + (window.Capacitor && window.Capacitor.Plugins ? '检查中...' : '不可用') + '</div>';
                if (window.Capacitor && window.Capacitor.Plugins && window.Capacitor.Plugins.CapacitorSQLite) {
                    try {
                        const { CapacitorSQLite } = window.Capacitor.Plugins;
                        
                        // 检查 relationshipData 表
                        const result1 = await CapacitorSQLite.query({
                            database: 'chat_messages.db',
                            statement: "SELECT value FROM relationship_data WHERE key = 'relationshipData'",
                            values: []
                        });
                        if (result1.values && result1.values.length > 0) {
                            const sqliteData = JSON.parse(result1.values[0].value);
                            debugInfo += '<div style="margin-left: 10px;">- relationshipData 表: 有数据</div>';
                            debugInfo += '<div style="margin-left: 10px;">- wechatChatList: ' + (sqliteData.wechatChatList ? sqliteData.wechatChatList.length : '不存在') + '</div>';
                        } else {
                            debugInfo += '<div style="margin-left: 10px;">- relationshipData 表: 无数据</div>';
                        }
                        
                        // 检查 chat_list 表
                        const result2 = await CapacitorSQLite.query({
                            database: 'chat_messages.db',
                            statement: 'SELECT COUNT(*) as count FROM chat_list',
                            values: []
                        });
                        debugInfo += '<div style="margin-left: 10px;">- chat_list 表: ' + result2.values[0].count + ' 条记录</div>';
                    } catch (e) {
                        debugInfo += '<div style="margin-left: 10px; color: red;">- 查询失败: ' + e.message + '</div>';
                    }
                }
                
                debugInfo += '</div>';
                debugInfo += '<div style="text-align: center; margin-top: 10px;">';
                debugInfo += '<button onclick="openCompanionBallModal()" style="padding: 8px 16px; background: #07c160; color: white; border: none; border-radius: 4px; cursor: pointer; margin-right: 10px;">重新加载</button>';
                debugInfo += '<button onclick="forceSyncChatList()" style="padding: 8px 16px; background: #ff6b6b; color: white; border: none; border-radius: 4px; cursor: pointer;">强制同步</button>';
                debugInfo += '</div>';
                
                container.innerHTML = debugInfo;
            };
            
            // 【调试】强制同步聊天列表到localforage
            window.forceSyncChatList = async function() {
                if (!relationshipData || !relationshipData.wechatChatList) {
                    alert('全局变量中没有聊天列表数据');
                    return;
                }
                
                try {
                    // 直接保存到localforage
                    const dataToSave = {
                        ...relationshipData,
                        wechatChatList: relationshipData.wechatChatList
                    };
                    await localforage.setItem('relationshipData', dataToSave);
                    alert('已强制同步 ' + relationshipData.wechatChatList.length + ' 个角色到localforage');
                    openCompanionBallModal();
                } catch (e) {
                    alert('同步失败: ' + e.message);
                }
            };
            
            // 【调试】检查角色数据存储位置
            window.debugCheckCharacterData = async function() {
                console.log('========== 【调试】检查角色数据 ==========');
                
                // 1. 检查全局变量
                console.log('1. 全局 relationshipData:', typeof relationshipData);
                if (relationshipData) {
                    console.log('   - wechatChatList:', relationshipData.wechatChatList ? relationshipData.wechatChatList.length : 'undefined');
                    if (relationshipData.wechatChatList && relationshipData.wechatChatList.length > 0) {
                        console.log('   - 第一个角色:', relationshipData.wechatChatList[0]);
                    }
                }
                
                // 2. 检查 localforage
                console.log('2. 检查 localforage...');
                const localData = await localforage.getItem('relationshipData');
                console.log('   - 数据存在:', !!localData);
                if (localData) {
                    console.log('   - wechatChatList:', localData.wechatChatList ? localData.wechatChatList.length : 'undefined');
                    if (localData.wechatChatList && localData.wechatChatList.length > 0) {
                        console.log('   - 第一个角色:', localData.wechatChatList[0]);
                    }
                }
                
                // 3. 检查 SQLite
                console.log('3. 检查 SQLite...');
                if (window.Capacitor && window.Capacitor.Plugins && window.Capacitor.Plugins.CapacitorSQLite) {
                    try {
                        const { CapacitorSQLite } = window.Capacitor.Plugins;
                        const result = await CapacitorSQLite.query({
                            database: 'chat_messages.db',
                            statement: 'SELECT COUNT(*) as count FROM chat_list',
                            values: []
                        });
                        console.log('   - chat_list 表记录数:', result.values[0].count);
                        
                        const chatListResult = await CapacitorSQLite.query({
                            database: 'chat_messages.db',
                            statement: 'SELECT data FROM chat_list LIMIT 1',
                            values: []
                        });
                        if (chatListResult.values && chatListResult.values.length > 0) {
                            console.log('   - 第一条记录:', JSON.parse(chatListResult.values[0].data));
                        }
                    } catch (e) {
                        console.log('   - SQLite 查询失败:', e.message);
                    }
                } else {
                    console.log('   - SQLite 不可用');
                }
                
                console.log('========== 【调试】检查完成 ==========');
            };
            
            // 在控制台输出调试命令提示
            console.log('【小球球】调试命令: 在控制台输入 debugCheckCharacterData() 可以检查角色数据存储情况');
            
            // ==================== 管理者权限页面功能 ====================
            
            // 打开管理者权限页面
            window.openAdminPermissionsPage = function() {
                const page = document.getElementById('adminPermissionsPage');
                page.classList.add('active');
                document.body.style.overflow = 'hidden';
                
                // 加载保存的权限状态
                loadAdminPermissions();
                
                // 加载当前接管AI
                loadAdminCurrentAI();
                
                // 添加入场动画
                page.style.animation = 'adminPageEnter 0.3s ease-out';
            };
            
            // 加载当前接管AI显示
            function loadAdminCurrentAI() {
                const aiId = localStorage.getItem('notificationControllerAI');
                const nameEl = document.getElementById('adminCurrentAIName');
                
                if (aiId && nameEl) {
                    const characters = getAllCharacters();
                    const ai = characters.find(c => c.id == aiId);
                    nameEl.textContent = ai ? ai.name : '未选择';
                } else if (nameEl) {
                    nameEl.textContent = '未选择';
                }
            }
            
            // 打开AI选择器（从管理者权限页面）
            window.openAdminAISelector = function() {
                // 获取所有AI角色
                const characters = getAllCharacters();
                if (characters.length === 0) {
                    alert('还没有创建任何AI角色');
                    return;
                }
                
                // 获取当前选中的AI
                const currentAIId = localStorage.getItem('notificationControllerAI');
                
                // 创建弹窗
                const modal = document.createElement('div');
                modal.className = 'ai-selector-modal';
                modal.id = 'adminAISelectorModal';
                modal.innerHTML = `
                    <div class="ai-selector-content">
                        <div class="ai-selector-header">
                            <h3>👑 选择管理者AI</h3>
                            <p>选中的AI将获得管理者权限，可以查看你的通知</p>
                        </div>
                        <div class="ai-selector-list" id="adminAISelectorList">
                            ${characters.map(char => `
                                <div class="ai-selector-item ${char.id == currentAIId ? 'selected' : ''}" 
                                     data-id="${char.id}" 
                                     onclick="selectAIForAdmin('${char.id}')">
                                    <div class="ai-selector-avatar">
                                        ${char.avatar ? `<img src="${char.avatar}" alt="${char.name}">` : char.name.charAt(0)}
                                    </div>
                                    <div class="ai-selector-info">
                                        <div class="ai-selector-name">${char.name}</div>
                                        <div class="ai-selector-desc">${char.description || '暂无描述'}</div>
                                    </div>
                                    <div class="ai-selector-check"></div>
                                </div>
                            `).join('')}
                        </div>
                        <div class="ai-selector-footer">
                            <button class="ai-selector-btn cancel" onclick="closeAdminAISelector()">取消</button>
                            <button class="ai-selector-btn confirm" onclick="confirmAdminAISelection()">确认选择</button>
                        </div>
                    </div>
                `;
                
                document.body.appendChild(modal);
                
                // 显示动画
                setTimeout(() => {
                    modal.classList.add('active');
                }, 10);
                
                // 保存临时选择
                window.tempAdminSelectedAI = currentAIId;
            };
            
            // 选择AI（管理者页面）
            window.selectAIForAdmin = function(aiId) {
                window.tempAdminSelectedAI = aiId;
                
                // 更新UI
                document.querySelectorAll('#adminAISelectorModal .ai-selector-item').forEach(item => {
                    item.classList.remove('selected');
                    if (item.dataset.id === aiId) {
                        item.classList.add('selected');
                    }
                });
            };
            
            // 关闭AI选择器（管理者页面）
            window.closeAdminAISelector = function() {
                const modal = document.getElementById('adminAISelectorModal');
                if (modal) {
                    modal.classList.remove('active');
                    setTimeout(() => {
                        modal.remove();
                    }, 300);
                }
                window.tempAdminSelectedAI = null;
            };
            
            // 确认选择（管理者页面）
            window.confirmAdminAISelection = function() {
                if (!window.tempAdminSelectedAI) {
                    alert('请选择一个AI');
                    return;
                }
                
                // 保存选择
                localStorage.setItem('notificationControllerAI', window.tempAdminSelectedAI);
                
                // 获取AI信息
                const characters = getAllCharacters();
                const selectedAI = characters.find(c => c.id == window.tempAdminSelectedAI);
                
                if (selectedAI) {
                    // 更新显示
                    const nameEl = document.getElementById('adminCurrentAIName');
                    if (nameEl) {
                        nameEl.textContent = selectedAI.name;
                    }
                    
                    // 显示提示
                    showToast(`已设置 ${selectedAI.name} 为管理者AI`);
                }
                
                closeAdminAISelector();
            };
            
            // 关闭管理者权限页面
            window.closeAdminPermissionsPage = function() {
                const page = document.getElementById('adminPermissionsPage');
                page.style.animation = 'adminPageExit 0.3s ease-in';
                
                setTimeout(() => {
                    page.classList.remove('active');
                    document.body.style.overflow = '';
                }, 300);
            };
            
            // 切换权限开关
            window.toggleAdminPermission = function(event, element, permission) {
                // 阻止事件冒泡，防止触发父元素的点击
                if (event) {
                    event.stopPropagation();
                }
                
                // 获取toggle元素 - 如果element本身就是toggle，就用它，否则查找子元素
                const toggle = element.classList.contains('admin-permission-toggle') 
                    ? element 
                    : element.querySelector('.admin-permission-toggle');
                
                // 获取权限项容器
                const permissionItem = toggle.closest('.admin-permission-item');
                const isActive = toggle.classList.contains('active');
                
                // 特殊处理通知权限 - 检查Android环境和权限
                if (permission === 'notification' && !isActive) {
                    // 检查是否在Android环境
                    if (typeof AINotificationManager === 'undefined') {
                        alert('通知接管功能需要在Android APP中使用\n\n请确保：\n1. 已安装Android版本\n2. 已开启通知监听权限');
                        return;
                    }
                    
                    // 检查权限
                    const hasPermission = AINotificationManager.isNotificationServiceEnabled();
                    if (!hasPermission) {
                        if (confirm('需要开启通知监听权限才能让AI伴侣接管通知\n\n是否前往设置？')) {
                            AINotificationManager.openNotificationSettings();
                        }
                        return;
                    }
                }
                
                // 特殊处理应用使用记录权限 - 检查Android环境和权限
                if (permission === 'appUsage' && !isActive) {
                    // 检查是否在Android环境
                    if (typeof AIAppUsageManager === 'undefined') {
                        alert('应用使用记录功能需要在Android APP中使用\n\n请确保：\n1. 已安装Android版本\n2. 已开启应用使用记录权限');
                        return;
                    }
                    
                    // 检查权限
                    const hasPermission = AIAppUsageManager.hasUsageStatsPermission();
                    if (!hasPermission) {
                        if (confirm('需要开启应用使用记录权限才能让AI伴侣了解你的手机使用情况\n\n是否前往设置？')) {
                            AIAppUsageManager.openUsageStatsSettings();
                        }
                        return;
                    }
                }
                
                if (isActive) {
                    toggle.classList.remove('active');
                    permissionItem.classList.remove('active');
                } else {
                    toggle.classList.add('active');
                    permissionItem.classList.add('active');
                    
                    // 震动反馈（如果支持）
                    if (navigator.vibrate) {
                        navigator.vibrate(50);
                    }
                }
                
                // 保存权限状态
                saveAdminPermissionState(permission, !isActive);
                
                // 显示提示
                const permissionNames = {
                    notification: '通知全面接管',
                    appUsage: '应用使用记录',
                    location: '实时位置追踪',
                    screen: '屏幕实时监控',
                    messages: '消息内容读取',
                    camera: '相机与麦克风',
                    device: '设备远程控制',
                    data: '个人数据访问'
                };
                showToast(`${permissionNames[permission]}已${!isActive ? '开启' : '关闭'}`);
            };
            
            // ==================== AI伴侣通知管理功能 ====================
            
            // 打开通知管理页面
            window.openNotificationManagerPage = function() {
                // 检查是否在Android环境
                if (typeof AINotificationManager === 'undefined') {
                    alert('通知接管功能需要在Android APP中使用\n\n请确保：\n1. 已安装Android版本\n2. 已开启通知监听权限');
                    return;
                }
                
                // 检查权限
                const hasPermission = AINotificationManager.isNotificationServiceEnabled();
                if (!hasPermission) {
                    if (confirm('需要开启通知监听权限才能让AI伴侣接管通知\n\n是否前往设置？')) {
                        AINotificationManager.openNotificationSettings();
                    }
                    return;
                }
                
                // 显示通知管理页面
                showNotificationManagerUI();
            };
            
            // 显示通知管理界面
            function showNotificationManagerUI() {
                // 创建通知管理页面
                const page = document.createElement('div');
                page.id = 'notificationManagerPage';
                page.className = 'notification-manager-page';
                page.innerHTML = `
                    <div class="notification-manager-header">
                        <button class="notification-manager-back" onclick="closeNotificationManagerPage()">←</button>
                        <div class="notification-manager-title">
                            <span>🔔</span>
                            <span>AI伴侣通知中心</span>
                        </div>
                        <button class="notification-manager-settings" onclick="openNotificationSettings()">⚙️</button>
                    </div>
                    
                    <div class="notification-manager-stats">
                        <div class="notification-stat-card">
                            <div class="notification-stat-number" id="unreadCount">0</div>
                            <div class="notification-stat-label">未读通知</div>
                        </div>
                        <div class="notification-stat-card">
                            <div class="notification-stat-number" id="todayCount">0</div>
                            <div class="notification-stat-label">今日接收</div>
                        </div>
                        <div class="notification-stat-card">
                            <div class="notification-stat-number" id="aiResponseCount">0</div>
                            <div class="notification-stat-label">AI回应</div>
                        </div>
                    </div>
                    
                    <div class="notification-manager-tabs">
                        <div class="notification-tab active" onclick="switchNotificationTab('all')">全部</div>
                        <div class="notification-tab" onclick="switchNotificationTab('wechat')">微信</div>
                        <div class="notification-tab" onclick="switchNotificationTab('qq')">QQ</div>
                        <div class="notification-tab" onclick="switchNotificationTab('unread')">未读</div>
                    </div>
                    
                    <div class="notification-list" id="notificationList">
                        <div class="notification-loading">正在加载通知...</div>
                    </div>
                    
                    <div class="notification-manager-footer">
                        <button class="notification-clear-btn" onclick="clearAllNotifications()">
                            <span>🗑️</span> 清空记录
                        </button>
                        <button class="notification-ai-btn" onclick="askAIAboutNotifications()">
                            <span>🤖</span> 问AI伴侣
                        </button>
                    </div>
                `;
                
                document.body.appendChild(page);
                
                // 添加动画
                setTimeout(() => {
                    page.classList.add('active');
                }, 10);
                
                // 加载通知数据
                loadNotifications();
                
                // 启动定时刷新
                window.notificationRefreshInterval = setInterval(loadNotifications, 3000);
            }
            
            // 关闭通知管理页面
            window.closeNotificationManagerPage = function() {
                const page = document.getElementById('notificationManagerPage');
                if (page) {
                    page.classList.remove('active');
                    setTimeout(() => {
                        page.remove();
                    }, 300);
                }
                
                // 停止定时刷新
                if (window.notificationRefreshInterval) {
                    clearInterval(window.notificationRefreshInterval);
                    window.notificationRefreshInterval = null;
                }
            };
            
            // 加载通知列表
            function loadNotifications() {
                if (typeof AINotificationManager === 'undefined') return;
                
                try {
                    const notificationsJson = AINotificationManager.getNotifications();
                    const notifications = JSON.parse(notificationsJson);
                    
                    // 更新统计
                    updateNotificationStats(notifications);
                    
                    // 渲染列表
                    renderNotificationList(notifications);
                    
                } catch (e) {
                    console.error('加载通知失败:', e);
                }
            }
            
            // 更新统计数据
            function updateNotificationStats(notifications) {
                const unreadCount = notifications.filter(n => !n.isRead).length;
                const todayCount = notifications.filter(n => {
                    const notifDate = new Date(n.timestamp);
                    const today = new Date();
                    return notifDate.toDateString() === today.toDateString();
                }).length;
                
                document.getElementById('unreadCount').textContent = unreadCount;
                document.getElementById('todayCount').textContent = todayCount;
                
                // AI回应数从本地存储获取
                const aiResponses = JSON.parse(localStorage.getItem('aiNotificationResponses') || '[]');
                document.getElementById('aiResponseCount').textContent = aiResponses.length;
            }
            
            // 渲染通知列表
            function renderNotificationList(notifications) {
                const listContainer = document.getElementById('notificationList');
                
                if (notifications.length === 0) {
                    listContainer.innerHTML = `
                        <div class="notification-empty">
                            <div class="notification-empty-icon">📭</div>
                            <div class="notification-empty-text">暂无通知</div>
                            <div class="notification-empty-subtext">AI伴侣正在监听中...</div>
                        </div>
                    `;
                    return;
                }
                
                const html = notifications.map(notif => {
                    const appIcon = notif.appName === '微信' ? '💬' : '🐧';
                    const isRead = notif.isRead ? 'read' : 'unread';
                    
                    return `
                        <div class="notification-item ${isRead}" data-id="${notif.id}" onclick="viewNotificationDetail('${notif.id}')">
                            <div class="notification-icon">${appIcon}</div>
                            <div class="notification-content">
                                <div class="notification-header">
                                    <span class="notification-app">${notif.appName}</span>
                                    <span class="notification-time">${notif.timeStr}</span>
                                </div>
                                <div class="notification-title">${escapeHtml(notif.title)}</div>
                                <div class="notification-text">${escapeHtml(notif.content)}</div>
                            </div>
                            ${!notif.isRead ? '<div class="notification-unread-dot"></div>' : ''}
                        </div>
                    `;
                }).join('');
                
                listContainer.innerHTML = html;
            }
            
            // 查看通知详情
            window.viewNotificationDetail = function(notificationId) {
                if (typeof AINotificationManager !== 'undefined') {
                    AINotificationManager.markNotificationAsRead(notificationId);
                }
                
                // 重新加载列表
                loadNotifications();
            };
            
            // 切换标签
            window.switchNotificationTab = function(tab) {
                document.querySelectorAll('.notification-tab').forEach(t => t.classList.remove('active'));
                event.target.classList.add('active');
                
                // 根据标签过滤通知
                filterNotifications(tab);
            };
            
            // 过滤通知
            function filterNotifications(filter) {
                if (typeof AINotificationManager === 'undefined') return;
                
                const notificationsJson = AINotificationManager.getNotifications();
                let notifications = JSON.parse(notificationsJson);
                
                switch(filter) {
                    case 'wechat':
                        notifications = notifications.filter(n => n.appName === '微信');
                        break;
                    case 'qq':
                        notifications = notifications.filter(n => n.appName === 'QQ');
                        break;
                    case 'unread':
                        notifications = notifications.filter(n => !n.isRead);
                        break;
                }
                
                renderNotificationList(notifications);
            }
            
            // 清空所有通知
            window.clearAllNotifications = function() {
                if (!confirm('确定要清空所有通知记录吗？')) return;
                
                if (typeof AINotificationManager !== 'undefined') {
                    AINotificationManager.clearAllNotifications();
                    loadNotifications();
                }
            };
            
            // 问AI伴侣关于通知的事情
            window.askAIAboutNotifications = function() {
                if (typeof AINotificationManager === 'undefined') return;
                
                const notificationsJson = AINotificationManager.getNotifications();
                const notifications = JSON.parse(notificationsJson);
                
                if (notifications.length === 0) {
                    alert('还没有收到任何通知呢');
                    return;
                }
                
                // 构建通知摘要
                const recentNotifications = notifications.slice(0, 5);
                const summary = recentNotifications.map(n => 
                    `[${n.appName}] ${n.title}: ${n.content.substring(0, 50)}...`
                ).join('\n');
                
                // 发送给AI分析
                const message = `我最近收到了这些通知，你怎么看？\n\n${summary}`;
                
                // 关闭通知页面，打开AI聊天
                closeNotificationManagerPage();
                
                // 触发AI聊天（假设有当前聊天ID）
                if (window.currentChatId) {
                    setTimeout(() => {
                        sendMessage(message);
                    }, 500);
                } else {
                    alert('请先选择一个AI伴侣聊天');
                }
            };
            
            // 打开通知设置
            window.openNotificationSettings = function() {
                if (typeof AINotificationManager !== 'undefined') {
                    AINotificationManager.openNotificationSettings();
                }
            };
            
            // 获取所有角色（从微信聊天列表）
            function getAllCharacters() {
                // 优先从内存中的relationshipData获取
                if (typeof relationshipData !== 'undefined' && relationshipData.wechatChatList) {
                    return relationshipData.wechatChatList.map(chat => ({
                        id: chat.id,
                        name: chat.name || chat.remark || '未命名',
                        avatar: chat.avatar,
                        description: chat.personality || chat.description || '暂无描述'
                    }));
                }
                
                // 【修改】不再从 localStorage 获取，返回空数组
                return [];
            }
            
            // 显示提示
            function showToast(message) {
                const toast = document.createElement('div');
                toast.style.cssText = `
                    position: fixed;
                    top: 20%;
                    left: 50%;
                    transform: translateX(-50%);
                    background: rgba(0, 0, 0, 0.8);
                    color: #fff;
                    padding: 12px 24px;
                    border-radius: 25px;
                    font-size: 14px;
                    z-index: 10002;
                    animation: fadeInOut 2s ease;
                `;
                toast.textContent = message;
                document.body.appendChild(toast);
                
                setTimeout(() => {
                    toast.remove();
                }, 2000);
            }
            
            // 检查通知是否应该发送给AI
            function shouldNotifyAI() {
                const aiId = localStorage.getItem('notificationControllerAI');
                return aiId && typeof AINotificationManager !== 'undefined';
            }
            
            // 获取当前接管AI的ID
            function getCurrentNotificationAIId() {
                return localStorage.getItem('notificationControllerAI');
            }
            
            // HTML转义
            function escapeHtml(text) {
                if (!text) return '';
                const div = document.createElement('div');
                div.textContent = text;
                return div.innerHTML;
            }
            
            // ==================== AI伴侣通知管理功能结束 ====================
            
            // 保存单个权限状态
            function saveAdminPermissionState(permission, enabled) {
                const permissions = JSON.parse(localStorage.getItem('adminPermissions') || '{}');
                permissions[permission] = enabled;
                localStorage.setItem('adminPermissions', JSON.stringify(permissions));
            }
            
            // 加载权限状态
            function loadAdminPermissions() {
                const permissions = JSON.parse(localStorage.getItem('adminPermissions') || '{}');
                
                Object.keys(permissions).forEach(permission => {
                    const toggle = document.querySelector(`[data-permission="${permission}"]`);
                    if (toggle && permissions[permission]) {
                        toggle.classList.add('active');
                        toggle.closest('.admin-permission-item').classList.add('active');
                    }
                });
            }
            
            // 重置所有权限
            window.resetAdminPermissions = function() {
                if (confirm('确定要重置所有权限设置吗？')) {
                    localStorage.removeItem('adminPermissions');
                    document.querySelectorAll('.admin-permission-toggle').forEach(toggle => {
                        toggle.classList.remove('active');
                    });
                    document.querySelectorAll('.admin-permission-item').forEach(item => {
                        item.classList.remove('active');
                    });
                }
            };
            
            // 保存权限设置
            window.saveAdminPermissions = function() {
                const activePermissions = [];
                document.querySelectorAll('.admin-permission-toggle.active').forEach(toggle => {
                    activePermissions.push(toggle.dataset.permission);
                });
                
                if (activePermissions.length === 0) {
                    alert('请至少开启一项权限');
                    return;
                }
                
                // 显示确认对话框
                const confirmMsg = `您已授权以下 ${activePermissions.length} 项权限：\n\n${activePermissions.map(p => {
                    const names = {
                        notification: '🔔 通知全面接管',
                        appUsage: '📱 应用使用记录',
                        location: '📍 实时位置追踪',
                        screen: '👁️ 屏幕实时监控',
                        messages: '💬 消息内容读取',
                        camera: '📷 相机与麦克风',
                        device: '⚙️ 设备远程控制',
                        data: '📊 个人数据访问'
                    };
                    return names[p] || p;
                }).join('\n')}\n\n⚠️ 警告：这些权限将赋予管理者对设备的全面控制能力，请确认您信任此管理者。`;
                
                if (confirm(confirmMsg)) {
                    alert('权限设置已保存！管理者权限已激活。');
                    closeAdminPermissionsPage();
                }
            };
            
            // 页面进入动画
            const adminPageEnterStyle = document.createElement('style');
            adminPageEnterStyle.textContent = `
                @keyframes adminPageEnter {
                    from {
                        opacity: 0;
                        transform: scale(0.95);
                    }
                    to {
                        opacity: 1;
                        transform: scale(1);
                    }
                }
                
                @keyframes adminPageExit {
                    from {
                        opacity: 1;
                        transform: scale(1);
                    }
                    to {
                        opacity: 0;
                        transform: scale(0.95);
                    }
                }
            `;
            document.head.appendChild(adminPageEnterStyle);
            
            // ==================== 管理者权限页面功能结束 ====================
            
            // 播放/暂停
            window.screen2TogglePlay = function() {
                if (typeof handleMusicControl === 'function') {
                    handleMusicControl(screen2IsPlaying ? 'pause' : 'play');
                }
                
                // 触发同步
                setTimeout(syncWithMusicPlayer, 100);
            };
            
            // 上一首
            window.screen2PrevSong = function() {
                if (typeof handleMusicControl === 'function') {
                    handleMusicControl('prev');
                }
                setTimeout(syncWithMusicPlayer, 100);
            };
            
            // 下一首
            window.screen2NextSong = function() {
                if (typeof handleMusicControl === 'function') {
                    handleMusicControl('next');
                }
                setTimeout(syncWithMusicPlayer, 100);
            };
            
            // 进度条点击
            window.screen2Seek = function(event) {
                const progressBar = document.getElementById('screen2ProgressBar');
                const rect = progressBar.getBoundingClientRect();
                const percent = (event.clientX - rect.left) / rect.width;
                
                if (typeof musicPlayerState !== 'undefined' && musicPlayerState.audio) {
                    const duration = musicPlayerState.audio.duration;
                    if (duration) {
                        musicPlayerState.audio.currentTime = duration * percent;
                    }
                }
            };
            
            // 更新进度条
            function startScreen2ProgressUpdate() {
                stopScreen2ProgressUpdate();
                screen2UpdateInterval = setInterval(() => {
                    if (typeof musicPlayerState !== 'undefined' && musicPlayerState.audio) {
                        const audio = musicPlayerState.audio;
                        const current = audio.currentTime || 0;
                        const duration = audio.duration || 0;
                        
                        // 更新时间显示
                        document.getElementById('screen2CurrentTime').textContent = formatTime(current);
                        document.getElementById('screen2TotalTime').textContent = formatTime(duration);
                        
                        // 更新进度条
                        const percent = duration ? (current / duration) * 100 : 0;
                        document.getElementById('screen2ProgressFill').style.width = percent + '%';
                        
                        // 更新歌词
                        if (musicPlayerState.lyrics) {
                            screen2Lyrics = musicPlayerState.lyrics;
                            screen2CurrentLyricIndex = musicPlayerState.currentLyricIndex || 0;
                            updateScreen2Lyrics();
                        }
                    }
                }, 200);
            }
            
            function stopScreen2ProgressUpdate() {
                if (screen2UpdateInterval) {
                    clearInterval(screen2UpdateInterval);
                    screen2UpdateInterval = null;
                }
            }
            
            // 格式化时间
            function formatTime(seconds) {
                if (!seconds || isNaN(seconds)) return '0:00';
                const mins = Math.floor(seconds / 60);
                const secs = Math.floor(seconds % 60);
                return mins + ':' + (secs < 10 ? '0' : '') + secs;
            }
            
            // 监听屏幕切换，同步音乐状态
            const originalGoToScreen = window.goToScreen;
            window.goToScreen = function(screenNum) {
                originalGoToScreen(screenNum);
                if (screenNum === 2) {
                    // 切换到第二屏时同步音乐状态
                    syncWithMusicPlayer();
                    loadCurrentAIAvatar();
                }
            };
            
            // 页面加载完成后初始化
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', () => initScreen2MusicPlayer());
            } else {
                initScreen2MusicPlayer();
            }
            
            // 导出函数
            window.initScreen2MusicPlayer = initScreen2MusicPlayer;
            window.syncScreen2Music = syncWithMusicPlayer;
        })();
        
        // 【新增】立即测试后台任务（不经过 WorkManager，马上执行）
        async function testBackgroundImmediately() {
            const resultDiv = document.getElementById('backgroundTestResult');
            const statusSpan = document.getElementById('backgroundTestStatus');
            
            resultDiv.style.display = 'block';
            statusSpan.textContent = '正在立即启动测试...';
            resultDiv.style.background = '#fff3cd';
            
            try {
                // 检查是否在 Android 环境
                if (typeof AndroidShell === 'undefined') {
                    statusSpan.textContent = '❌ 错误：不在 Android 环境中，无法测试';
                    resultDiv.style.background = '#f8d7da';
                    return;
                }
                
                // 检查是否有立即测试方法
                if (!AndroidShell.testBackgroundTaskImmediately) {
                    statusSpan.textContent = '❌ 错误：当前版本不支持立即测试，请重新构建应用';
                    resultDiv.style.background = '#f8d7da';
                    return;
                }
                
                // 获取当前 API 设置
                const apiKey = document.getElementById('apiKey')?.value || '';
                const apiUrl = document.getElementById('apiBaseUrl')?.value || 'https://api.openai.com/v1';
                const modelName = document.getElementById('apiModel')?.value || 'gpt-4o-mini';
                
                if (!apiKey) {
                    statusSpan.textContent = '❌ 错误：请先配置 API 密钥';
                    resultDiv.style.background = '#f8d7da';
                    return;
                }
                
                // 构建测试用的角色信息
                const testCharacterInfo = JSON.stringify({
                    name: '测试角色',
                    personality: '这是一个测试角色，用于测试后台任务功能。',
                    myNickname: '用户',
                    recentMessages: JSON.stringify([]),
                    recentMemories: JSON.stringify([])
                });
                
                statusSpan.textContent = '正在静默测试 API 调用...';
                
                // 调用 Android 的 testBackgroundTaskImmediately 方法（静默执行）
                AndroidShell.testBackgroundTaskImmediately(-1, apiKey, apiUrl, modelName, testCharacterInfo);
                
                statusSpan.innerHTML = '✅ 静默测试已启动！<br><br>测试正在后台执行，不会发送通知。<br><br>请查看 logcat 日志确认 API 调用是否成功。';
                resultDiv.style.background = '#d4edda';
                
            } catch (error) {
                statusSpan.textContent = '❌ 测试失败：' + error.message;
                resultDiv.style.background = '#f8d7da';
                console.error('立即测试失败:', error);
            }
        }
        
        // 【新增】测试后台任务功能（使用 WorkManager，15分钟后执行）
        async function testBackgroundWorker() {
            const resultDiv = document.getElementById('backgroundTestResult');
            const statusSpan = document.getElementById('backgroundTestStatus');
            
            resultDiv.style.display = 'block';
            statusSpan.textContent = '正在测试...';
            resultDiv.style.background = '#fff3cd';
            
            try {
                // 检查是否在 Android 环境
                if (typeof AndroidShell === 'undefined') {
                    statusSpan.textContent = '❌ 错误：不在 Android 环境中，无法测试';
                    resultDiv.style.background = '#f8d7da';
                    return;
                }
                
                // 获取当前 API 设置
                const apiKey = document.getElementById('apiKey')?.value || '';
                const apiUrl = document.getElementById('apiBaseUrl')?.value || 'https://api.openai.com/v1';
                const modelName = document.getElementById('apiModel')?.value || 'gpt-4o-mini';
                
                if (!apiKey) {
                    statusSpan.textContent = '❌ 错误：请先配置 API 密钥';
                    resultDiv.style.background = '#f8d7da';
                    return;
                }
                
                // 【重要】先停止之前的测试任务，避免重复
                if (AndroidShell.stopBackgroundTimer) {
                    AndroidShell.stopBackgroundTimer();
                    console.log('已停止之前的后台任务');
                }
                
                // 构建测试用的角色信息
                const testCharacterInfo = JSON.stringify({
                    name: '测试角色',
                    personality: '这是一个测试角色，用于测试后台任务功能。',
                    myNickname: '用户',
                    recentMessages: JSON.stringify([]),
                    recentMemories: JSON.stringify([])
                });
                
                statusSpan.textContent = '正在启动后台任务测试...';
                
                // 调用 Android 的 startBackgroundTimer 方法
                // 使用 99999 作为测试用的 chatId（避免和真实任务冲突），使用 15 分钟间隔
                // 注意：99999 是数字类型，不是字符串
                const testChatId = 99999;
                console.log('启动测试任务，chatId:', testChatId, '类型:', typeof testChatId);
                AndroidShell.startBackgroundTimer(testChatId, 15, apiKey, apiUrl, modelName, testCharacterInfo);
                
                statusSpan.innerHTML = '✅ 定时测试已启动！<br><br>WorkManager 最小间隔为 15 分钟<br>请在 15-20 分钟内观察：<br>• 是否看到 Toast 提示<br>• 是否收到通知<br><br>如果看到提示，说明 WorkManager 正常工作！';
                resultDiv.style.background = '#d4edda';
                
            } catch (error) {
                statusSpan.textContent = '❌ 测试失败：' + error.message;
                resultDiv.style.background = '#f8d7da';
                console.error('后台任务测试失败:', error);
            }
        }
        
        // 【新增】仅测试通知功能（不调用 AI）
        async function testNotificationOnly() {
            const resultDiv = document.getElementById('backgroundTestResult');
            const statusSpan = document.getElementById('backgroundTestStatus');
            
            resultDiv.style.display = 'block';
            statusSpan.textContent = '正在测试通知...';
            resultDiv.style.background = '#fff3cd';
            
            try {
                if (typeof AndroidShell === 'undefined') {
                    statusSpan.innerHTML = '❌ 不在 Android 环境中';
                    resultDiv.style.background = '#f8d7da';
                    return;
                }
                
                if (!AndroidShell.testNotification) {
                    statusSpan.innerHTML = '❌ 当前版本不支持测试通知，请重新构建应用';
                    resultDiv.style.background = '#f8d7da';
                    return;
                }
                
                statusSpan.textContent = '正在发送测试通知...';
                
                // 调用 Android 的测试通知方法
                AndroidShell.testNotification("测试消息", "这是一条测试通知，用于检查通知功能是否正常");
                
                statusSpan.innerHTML = '✅ 测试通知已发送！<br><br>请检查：<br>• 是否看到通知<br>• 通知是否有声音/震动<br>• 锁屏时是否显示<br><br>如果没有看到通知，请检查系统通知权限设置';
                resultDiv.style.background = '#d4edda';
                
            } catch (error) {
                statusSpan.textContent = '❌ 测试失败：' + error.message;
                resultDiv.style.background = '#f8d7da';
            }
        }
        
        // 【新增】立即停止所有后台任务（用于测试后清理）
        function stopAllBackgroundTasks() {
            try {
                if (typeof AndroidShell !== 'undefined' && AndroidShell.stopBackgroundTimer) {
                    AndroidShell.stopBackgroundTimer();
                    showCustomAlert('已停止', '所有后台任务已停止', 'success');
                } else {
                    showCustomAlert('提示', '无法停止任务，可能不在 Android 环境中', 'info');
                }
            } catch (error) {
                showCustomAlert('错误', '停止任务失败：' + error.message, 'error');
            }
        }
        
        // 【新增】请求关闭电池优化
        function requestBatteryOptimization() {
            try {
                if (typeof AndroidShell === 'undefined' || !AndroidShell.requestBatteryOptimization) {
                    showCustomAlert('提示', '请在系统设置中手动关闭电池优化：\n\n设置 → 电池 → 应用耗电管理 → 本应用 → 选择"不优化"或"允许后台运行"', 'info');
                    return;
                }
                
                AndroidShell.requestBatteryOptimization();
                showCustomAlert('已跳转', '请在新页面中选择"不优化"或"允许后台运行"，然后返回', 'success');
            } catch (error) {
                showCustomAlert('错误', '跳转失败：' + error.message + '\n\n请手动设置：设置 → 电池 → 应用耗电管理 → 不优化', 'error');
            }
        }
        
        // 【新增】请求精确闹钟权限（Android 12+）
        function requestExactAlarmPermission() {
            try {
                if (typeof AndroidShell === 'undefined' || !AndroidShell.checkExactAlarmPermission) {
                    showCustomAlert('提示', '当前版本不支持此功能，请重新构建应用', 'info');
                    return;
                }
                
                // 【修改】Android 16 可能改变了权限检测机制，直接跳转设置
                // 不再依赖 hasExactAlarmPermission 的检测结果
                AndroidShell.checkExactAlarmPermission();
                showCustomAlert('已跳转', '请在设置中开启"允许设置闹钟和提醒"，然后返回\n\n如果找不到该选项，请尝试：设置 → 应用 → 特殊应用权限 → 允许设置闹钟和提醒', 'success');
            } catch (error) {
                showCustomAlert('错误', '跳转失败：' + error.message + '\n\n请手动设置：设置 → 应用 → 特殊应用权限 → 允许设置闹钟和提醒', 'error');
            }
        }
        
        // 【新增】测试角色ID获取（诊断用）
        function testCharacterIdDetection() {
            const resultDiv = document.getElementById('characterIdTestResult');
            resultDiv.style.display = 'block';
            
            let resultHtml = '<b>🔍 诊断结果：</b><br><br>';
            
            // 1. 检查 relationshipData 是否存在
            if (!relationshipData) {
                resultHtml += '<span style="color: red;">❌ relationshipData 不存在</span><br>';
                resultDiv.innerHTML = resultHtml;
                return;
            }
            resultHtml += '<span style="color: green;">✅ relationshipData 存在</span><br>';
            
            // 2. 检查 wechatChatList 是否存在
            if (!relationshipData.wechatChatList) {
                resultHtml += '<span style="color: red;">❌ wechatChatList 不存在</span><br>';
                resultDiv.innerHTML = resultHtml;
                return;
            }
            resultHtml += '<span style="color: green;">✅ wechatChatList 存在</span><br>';
            resultHtml += `📊 角色总数: ${relationshipData.wechatChatList.length}<br><br>`;
            
            // 3. 遍历所有角色，检查后台活动状态
            resultHtml += '<b>📋 角色列表：</b><br>';
            let foundBackgroundActivity = false;
            
            relationshipData.wechatChatList.forEach((item, index) => {
                const hasBackgroundActivity = item.backgroundActivity === true;
                const status = hasBackgroundActivity ? 
                    '<span style="color: green;">✅ 已启用</span>' : 
                    '<span style="color: gray;">⏸️ 未启用</span>';
                
                resultHtml += `${index + 1}. ${item.name || '未命名'} (ID: ${item.id}, 类型: ${typeof item.id}) ${status}<br>`;
                
                if (hasBackgroundActivity) {
                    foundBackgroundActivity = true;
                    // 【修复】ID 太大时取后 8 位
                    const idStr = String(item.id);
                    let chatIdInt;
                    if (idStr.length > 8) {
                        chatIdInt = parseInt(idStr.slice(-8), 10);
                        resultHtml += `&nbsp;&nbsp;&nbsp;└─ ⚠️ ID 过长，取后 8 位<br>`;
                    } else {
                        chatIdInt = parseInt(idStr, 10);
                    }
                    // 【修复】放宽有效性判断，只要大于 0 即可（Java int 最大约 21 亿）
                    const isValid = !isNaN(chatIdInt) && chatIdInt > 0;
                    
                    resultHtml += `&nbsp;&nbsp;&nbsp;└─ 原始ID: "${item.id}"<br>`;
                    resultHtml += `&nbsp;&nbsp;&nbsp;└─ 解析后: ${chatIdInt}<br>`;
                    resultHtml += `&nbsp;&nbsp;&nbsp;└─ 有效性: ${isValid ? '<span style="color: green;">✅ 有效</span>' : '<span style="color: red;">❌ 无效</span>'}<br>`;
                    resultHtml += `&nbsp;&nbsp;&nbsp;└─ 冷却时间: ${item.cooldown || 30} 分钟<br>`;
                }
            });
            
            resultHtml += '<br>';
            
            // 4. 总结
            if (!foundBackgroundActivity) {
                resultHtml += '<b style="color: red;">⚠️ 没有找到启用了后台活动的角色</b><br>';
                resultHtml += '<small>请在角色设置中启用"后台活动"功能</small>';
            } else {
                resultHtml += '<b style="color: green;">✅ 找到启用了后台活动的角色</b><br>';
            }
            
            // 5. 检查 AndroidShell
            resultHtml += '<br><b>📱 Android 环境：</b><br>';
            if (typeof AndroidShell === 'undefined') {
                resultHtml += '<span style="color: red;">❌ AndroidShell 不存在（不在 Android 环境）</span>';
            } else {
                resultHtml += '<span style="color: green;">✅ AndroidShell 存在</span><br>';
                resultHtml += `startBackgroundTimer: ${AndroidShell.startBackgroundTimer ? '✅' : '❌'}<br>`;
                resultHtml += `stopBackgroundTimer: ${AndroidShell.stopBackgroundTimer ? '✅' : '❌'}<br>`;
            }
            
            resultDiv.innerHTML = resultHtml;
        }
        
        // 【新增】重启真实 AI 后台任务
        async function restartRealBackgroundTask() {
            try {
                // 先停止当前任务
                if (window.AndroidShell && window.AndroidShell.stopBackgroundTimer) {
                    window.AndroidShell.stopBackgroundTimer();
                    console.log('已停止当前任务');
                }
                
                // 重新启动任务
                if (typeof startBackgroundActivityTimer === 'function') {
                    startBackgroundActivityTimer();
                    showCustomAlert('已启用', '真实 AI 后台任务已重启，将在设置的时间间隔后触发', 'success');
                } else {
                    showCustomAlert('错误', '启动函数不可用', 'error');
                }
            } catch (error) {
                showCustomAlert('错误', '重启任务失败：' + error.message, 'error');
            }
        }
        
        // 【新增】停止真实 AI 后台任务
        function stopRealBackgroundTask() {
            try {
                // 停止前端计时器
                if (backgroundActivityTimeout) {
                    clearTimeout(backgroundActivityTimeout);
                    backgroundActivityTimeout = null;
                }
                if (backgroundActivityTimer) {
                    clearInterval(backgroundActivityTimer);
                    backgroundActivityTimer = null;
                }
                
                // 停止 Android 原生计时器
                if (window.AndroidShell && window.AndroidShell.stopBackgroundTimer) {
                    window.AndroidShell.stopBackgroundTimer();
                }
                
                showCustomAlert('已停止', '真实 AI 后台任务已停止', 'success');
            } catch (error) {
                showCustomAlert('错误', '停止任务失败：' + error.message, 'error');
            }
        }
        
        // 【新增】停止测试任务（不影响真实 AI）
        function stopTestBackgroundTasks() {
            try {
                // 测试任务使用特殊的 chatId（99999+），需要单独取消
                // 但由于 WorkManager 的限制，我们只能取消所有任务
                // 所以这里先取消所有，然后重新启动真实任务
                
                if (window.AndroidShell && window.AndroidShell.stopBackgroundTimer) {
                    window.AndroidShell.stopBackgroundTimer();
                }
                
                // 检查是否有真实 AI 任务在运行，如果有则重启
                const hasRealTask = relationshipData && relationshipData.wechatChatList && 
                    relationshipData.wechatChatList.some(item => item.backgroundActivity === true);
                
                if (hasRealTask) {
                    // 延迟一点再重启真实任务，避免冲突
                    setTimeout(() => {
                        if (typeof startBackgroundActivityTimer === 'function') {
                            startBackgroundActivityTimer();
                            console.log('真实 AI 任务已自动重启');
                        }
                    }, 500);
                    showCustomAlert('已停止', '测试任务已停止，真实 AI 任务已自动重启', 'success');
                } else {
                    showCustomAlert('已停止', '测试任务已停止', 'success');
                }
            } catch (error) {
                showCustomAlert('错误', '停止测试任务失败：' + error.message, 'error');
            }
        }
    </script>
