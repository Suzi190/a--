                        console.error('【防闪退】请求参数:', {
                            model: minimaxConfig.model || 'speech-01',
                            voiceId: voiceId,
                            voiceSpeed: voiceSpeed,
                            textLength: text.length
                        });
                        return null;
                    }
                } catch (fetchError) {
                    clearTimeout(timeoutId);
                    if (fetchError.name === 'AbortError') {
                        console.error('【防闪退】语音合成请求超时');
                    } else {
                        console.error('【防闪退】语音合成请求失败:', fetchError);
                    }
                    return null;
