        // 语音录制相关变量
        let mediaRecorder = null;
        let audioChunks = [];
        let recordingStartTime = null;
        let recordingTimer = null;
        let currentVoiceBlob = null;
        let currentVoiceUrl = null;
        let voiceTranscript = '';
        let isVoiceInputMode = false;
        let isRecording = false;
        let voiceEventListenersAdded = false;
        let longPressTimer = null;

        // 切换语音输入模式
        function toggleVoiceInput() {
            const chatInput = document.getElementById('chatInput');
            const voiceInputContainer = document.getElementById('voiceInputContainer');
            const voiceIcon = document.querySelector('.chat-voice-icon img');
            
            if (!isVoiceInputMode) {
                // 切换到语音输入模式
                isVoiceInputMode = true;
                
                // 隐藏普通输入框，显示语音输入框
                if (chatInput) chatInput.style.display = 'none';
                if (voiceInputContainer) voiceInputContainer.style.display = 'flex';
                
                // 切换图标为键盘图标
                if (voiceIcon) voiceIcon.src = 'https://img.remit.ee/api/file/BQACAgUAAyEGAASHRsPbAAEQLr5pcaMYalRb6foPEto7azOaSLYYZAAC_RwAAr2lkFcMAvgUVejIvzgE.jpg';
                
                // 添加语音事件监听（voiceInputContainer已在上面获取）
                if (!voiceEventListenersAdded && voiceInputContainer) {
                    voiceInputContainer.addEventListener('mousedown', startRecording);
                    voiceInputContainer.addEventListener('mouseup', stopRecording);
                    voiceInputContainer.addEventListener('mouseleave', stopRecording);
                    voiceInputContainer.addEventListener('touchstart', startRecording);
                    voiceInputContainer.addEventListener('touchend', stopRecording);
                    voiceInputContainer.addEventListener('touchcancel', stopRecording);
                    voiceEventListenersAdded = true;
                }
            } else {
                // 切换回普通输入模式
                isVoiceInputMode = false;
                
                // 显示普通输入框，隐藏语音输入框
                if (chatInput) chatInput.style.display = 'block';
                if (voiceInputContainer) voiceInputContainer.style.display = 'none';
                
                // 切换图标为语音图标
                if (voiceIcon) voiceIcon.src = 'https://img.remit.ee/api/file/BQACAgUAAyEGAASHRsPbAAEQLr5pcaMYalRb6foPEto7azOaSLYYZAAC_RwAAr2lkFcMAvgUVejIvzgE.jpg';
                
                // 重置录音状态
                resetRecordingState();
            }
        }

        // 打开语音输入模式（兼容旧代码）
        function openVoiceInput() {
            if (!isVoiceInputMode) {
                toggleVoiceInput();
            }
        }

        // 关闭语音输入模式（兼容旧代码）
        function closeVoiceInput() {
            if (isVoiceInputMode) {
                toggleVoiceInput();
            }
        }

        // 强制请求麦克风权限（Capacitor环境）
        async function requestMicrophonePermission() {
            if (!window.Capacitor) return false;
            
            try {
                // 检查是否已经声明了权限
                const { Permissions } = window.Capacitor.Plugins;
                if (Permissions) {
                    const result = await Permissions.requestPermission({
                        permission: 'RECORD_AUDIO'
                    });
                    return result.granted;
                }
            } catch (error) {
                console.log('权限插件不可用，尝试直接请求');
            }
            
            // 如果权限插件不可用，直接返回true（假设权限已授予）
            return true;
        }
        
        // 检查麦克风权限状态
        async function checkMicrophonePermission() {
            console.log('=== 麦克风权限检查开始 ===');
            
            // 检查是否在Capacitor环境中
            console.log('window.Capacitor:', window.Capacitor);
            console.log('navigator.mediaDevices:', navigator.mediaDevices);
            
            if (window.Capacitor) {
                console.log('在Capacitor环境中');
            } else {
                console.log('在非Capacitor环境中');
            }
            
            // 尝试获取用户媒体（不带音频约束）
            try {
                const testStream = await navigator.mediaDevices.getUserMedia({ video: false, audio: false });
                console.log('基础媒体访问成功');
                testStream.getTracks().forEach(track => track.stop());
            } catch (error) {
                console.log('基础媒体访问失败:', error);
            }
            
            // 尝试获取音频媒体
            try {
                const audioStream = await navigator.mediaDevices.getUserMedia({ audio: true });
                console.log('音频媒体访问成功');
                audioStream.getTracks().forEach(track => track.stop());
                return true;
            } catch (error) {
                console.log('音频媒体访问失败:', error);
                console.log('错误名称:', error.name);
                console.log('错误消息:', error.message);
                return false;
            }
        }
        
        // 检查摄像头权限状态
        async function checkCameraPermission() {
            console.log('=== 摄像头权限检查开始 ===');
            
            if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
                console.log('浏览器不支持摄像头访问');
                return false;
            }
            
            try {
                const videoStream = await navigator.mediaDevices.getUserMedia({ video: true, audio: false });
                console.log('视频媒体访问成功');
                videoStream.getTracks().forEach(track => track.stop());
                return true;
            } catch (error) {
                console.log('视频媒体访问失败:', error);
                console.log('错误名称:', error.name);
                console.log('错误消息:', error.message);
                return false;
            }
        }
        
        // 检查通知权限状态
        async function checkNotificationPermission() {
            console.log('=== 通知权限检查开始 ===');
            
            if (!('Notification' in window)) {
                console.log('浏览器不支持通知');
                return false;
            }
            
            const permission = Notification.permission;
            console.log('通知权限状态:', permission);
            
            if (permission === 'granted') {
                return true;
            } else if (permission === 'denied') {
                console.log('通知权限被拒绝');
                return false;
            } else {
                console.log('通知权限未决定');
                try {
                    const result = await Notification.requestPermission();
                    console.log('通知权限请求结果:', result);
                    return result === 'granted';
                } catch (error) {
                    console.log('通知权限请求失败:', error);
                    return false;
                }
            }
        }
        
        // 请求摄像头权限（用于拍照或视频通话）
        async function requestCameraPermission() {
            if (window.Capacitor) {
                console.log('Capacitor环境中请求摄像头权限');
                // 在Capacitor环境中，权限已经在MainActivity中处理
                return true;
            } else {
                console.log('浏览器环境中请求摄像头权限');
                return await checkCameraPermission();
            }
        }
        
        // 请求通知权限
        async function requestNotificationPermission() {
            if (window.Capacitor) {
                console.log('Capacitor环境中请求通知权限');
                // 在Capacitor环境中，权限已经在MainActivity中处理
                return true;
            } else {
                console.log('浏览器环境中请求通知权限');
                return await checkNotificationPermission();
            }
        }
        
        // 显示通知（需要通知权限）
        async function showNotification(title, body, options = {}) {
            console.log('=== 显示通知 ===');
            console.log('通知内容:', { title, body, options });
            
            // Capacitor环境（APK）
            if (window.Capacitor && window.Capacitor.Plugins && window.Capacitor.Plugins.LocalNotifications) {
                console.log('使用Capacitor通知插件');
                try {
                    const LocalNotifications = window.Capacitor.Plugins.LocalNotifications;
                    
                    // 获取通知铃声
                    const ringtoneSound = await getRingtoneSound('notification');
                    console.log('使用通知铃声:', ringtoneSound);
                    
                    // 创建高优先级通知渠道
                    await LocalNotifications.createChannel({
                        id: 'high_priority',
                        name: '高优先级通知',
                        description: '用于显示重要消息通知',
                        importance: 5,
                        visibility: 1,
                        lights: true,
                        lightColor: '#FF0000',
                        vibration: true,
                        sound: ringtoneSound
                    });
                    
                    console.log('✅ 高优先级通知渠道已创建');
                    
                    await LocalNotifications.schedule({
                        notifications: [
                            {
                                title: title,
                                body: body,
                                id: Date.now(),
                                schedule: { at: new Date() },
                                sound: ringtoneSound,
                                smallIcon: options.icon || 'icon',
                                largeIcon: options.icon || 'icon',
                                attachments: null,
                                actionTypeId: '',
                                channelId: 'high_priority',
                                extra: null
                            }
                        ]
                    });
                    
                    console.log('✅ Capacitor通知已发送');
                    
                    // 监听通知点击事件
                    LocalNotifications.addListener('localNotificationActionPerformed', (notificationAction) => {
                        console.log('通知被点击:', notificationAction);
                        // 聚焦窗口
                        if (window.Capacitor.Plugins.App) {
                            window.Capacitor.Plugins.App.launchApp();
                        }
                    });
                    
                    return;
                } catch (error) {
                    console.error('Capacitor通知失败:', error);
                    // 回退到浏览器通知
                }
            }
            
            // 浏览器环境
            if (!('Notification' in window)) {
                console.log('浏览器不支持通知');
                return;
            }
            
            if (Notification.permission === 'granted') {
                console.log('使用浏览器通知');
                const notification = new Notification(title, {
                    body: body,
                    icon: options.icon || '/icon.png',
                    badge: options.badge || '/badge.png',
                    tag: options.tag || 'default',
                    requireInteraction: true,
                    ...options
                });
                
                notification.onclick = function() {
                    console.log('通知被点击');
                    window.focus();
                    notification.close();
                };
                
                console.log('✅ 浏览器通知已显示');
                return notification;
            } else {
                console.log('通知权限未授予，无法显示通知');
                // 回退到alert
                alert(`${title}: ${body}`);
            }
        }
        
        // 拍照功能（需要摄像头权限）
        async function takePhoto(options = {}) {
            try {
                const hasPermission = await requestCameraPermission();
                if (!hasPermission) {
                    console.log('摄像头权限未授予');
                    return null;
                }
                
                const stream = await navigator.mediaDevices.getUserMedia({ 
                    video: { 
                        width: options.width || 640,
                        height: options.height || 480,
                        facingMode: options.facingMode || 'user'
                    } 
                });
                
                const video = document.createElement('video');
                video.srcObject = stream;
                video.play();
                
                return new Promise((resolve) => {
                    video.onloadedmetadata = () => {
                        const canvas = document.createElement('canvas');
                        canvas.width = video.videoWidth;
                        canvas.height = video.videoHeight;
                        
                        const context = canvas.getContext('2d');
                        context.drawImage(video, 0, 0);
                        
                        canvas.toBlob((blob) => {
                            stream.getTracks().forEach(track => track.stop());
                            resolve(blob);
                        }, 'image/jpeg', 0.9);
                    };
                });
            } catch (error) {
                console.log('拍照失败:', error);
                return null;
            }
        }

        // 开始录音
        async function startRecording(e) {
            // 防止事件对象不存在时出错
            if (e && typeof e.preventDefault === 'function') {
                e.preventDefault();
            }
            
            console.log('=== 开始录音 ===');
            console.log('当前状态 - isRecording:', isRecording);
            
            if (isRecording) {
                console.log('录音已在进行中，忽略此次请求');
                return;
            }
            
            try {
                // 检查是否在Capacitor环境中
                if (window.Capacitor) {
                    console.log('在Capacitor环境中，直接尝试获取麦克风流');
                    // 在Capacitor环境中，直接尝试获取麦克风流
                    // 不需要浏览器权限检查，因为AndroidManifest.xml已经声明了权限
                } else {
                    console.log('非Capacitor环境，使用浏览器权限检查');
                    // 检查浏览器是否支持 getUserMedia
                    if (!navigator.mediaDevices) {
                        throw new Error('您的浏览器不支持媒体设备API，请使用现代浏览器');
                    }
                    
                    if (!navigator.mediaDevices.getUserMedia) {
                        throw new Error('您的浏览器不支持音频录制功能，请使用 Chrome、Edge 或 Firefox 等现代浏览器');
                    }
                    
                    // 检查当前协议
                    const currentProtocol = window.location.protocol;
                    if (currentProtocol !== 'https:' && currentProtocol !== 'file:') {
                        const hostname = window.location.hostname;
                        if (hostname !== 'localhost' && hostname !== '127.0.0.1' && !hostname.startsWith('192.168.') && !hostname.startsWith('10.') && !hostname.startsWith('172.')) {
                            throw new Error('出于安全考虑，浏览器只允许在 HTTPS 或 localhost 环境下访问麦克风。当前协议：' + currentProtocol + '，请使用 HTTPS 协议访问网站');
                        }
                    }
                }
                
                // 请求麦克风权限
                let stream;
                
                console.log('当前环境检测:');
                console.log('window.Capacitor:', window.Capacitor);
                console.log('navigator.mediaDevices:', navigator.mediaDevices);
                console.log('当前协议:', window.location.protocol);
                console.log('当前主机名:', window.location.hostname);
                
                // 尝试获取音频流
                console.log('开始获取音频流...');
                
                try {
                    // 首先尝试简单的音频请求
                    stream = await navigator.mediaDevices.getUserMedia({ 
                        audio: true 
                    });
                    console.log('✅ 音频流获取成功（简化版本）！');
                } catch (error) {
                    console.log('❌ 简化音频流获取失败:', error);
                    console.log('错误名称:', error.name);
                    console.log('错误消息:', error.message);
                    
                    // 如果是权限被拒绝
                    if (error.name === 'NotAllowedError' || error.name === 'PermissionDeniedError') {
                        console.log('权限被拒绝，检查Capacitor环境...');
                        
                        if (window.Capacitor) {
                            console.log('在Capacitor环境中，权限被拒绝');
                            throw new Error('麦克风权限被拒绝，请在应用设置中允许访问麦克风');
                        } else {
                            console.log('在浏览器环境中，权限被拒绝');
                            throw new Error('麦克风权限被拒绝，请在浏览器设置中允许访问麦克风');
                        }
                    }
                    
                    // 如果是设备未找到
                    if (error.name === 'NotFoundError' || error.name === 'DevicesNotFoundError') {
                        throw new Error('未找到麦克风设备，请检查您的设备是否连接了麦克风');
                    }
                    
                    // 如果是设备被占用
                    if (error.name === 'NotReadableError' || error.name === 'TrackStartError') {
                        throw new Error('麦克风被其他应用占用，请关闭其他使用麦克风的应用');
                    }
                    
                    // 如果是类型错误（通常是不安全环境）
                    if (error.name === 'TypeError') {
                        console.log('类型错误，检查协议和主机名...');
                        const protocol = window.location.protocol;
                        const hostname = window.location.hostname;
                        
                        if (protocol !== 'https:' && protocol !== 'file:') {
                            throw new Error(`当前环境不支持麦克风访问。协议: ${protocol}，请使用 HTTPS 或本地文件协议`);
                        }
                    }
                    
                    // 其他错误
                    throw new Error(`无法访问麦克风: ${error.message}`);
                }
                
                // 强制使用最兼容的音频格式
                const options = {
                    audioBitsPerSecond: 128000
                };
                
                // 在Capacitor环境中，优先使用更兼容的格式
                // 尝试使用wav格式，如果不支持则使用webm
                if (MediaRecorder.isTypeSupported('audio/wav')) {
                    options.mimeType = 'audio/wav';
                    console.log('使用wav格式录音');
                } else if (MediaRecorder.isTypeSupported('audio/webm;codecs=opus')) {
                    options.mimeType = 'audio/webm;codecs=opus';
                    console.log('使用webm opus格式录音');
                } else if (MediaRecorder.isTypeSupported('audio/webm')) {
                    options.mimeType = 'audio/webm';
                    console.log('使用webm格式录音');
                } else {
                    console.log('使用默认格式录音');
                }
                
                mediaRecorder = new MediaRecorder(stream, options);
                audioChunks = [];
                
                mediaRecorder.ondataavailable = (event) => {
                    audioChunks.push(event.data);
                };
                
                mediaRecorder.onstop = async () => {
                    console.log('=== 录音停止 ===');
                    console.log('音频块数量:', audioChunks.length);
                    
                    // 根据录音格式创建对应的Blob类型
                    const blobType = mediaRecorder.mimeType || 'audio/webm';
                    currentVoiceBlob = new Blob(audioChunks, { type: blobType });
                    currentVoiceUrl = URL.createObjectURL(currentVoiceBlob);
                    console.log('音频Blob大小:', currentVoiceBlob.size, 'bytes');
                    console.log('音频Blob类型:', currentVoiceBlob.type);
                    
                    // 检查音频长度是否合理（3秒音频应该在10KB-50KB之间）
                    if (currentVoiceBlob.size < 5000 || currentVoiceBlob.size > 200000) {
                        console.warn('音频大小异常，可能影响识别:', currentVoiceBlob.size, 'bytes');
                    }
                    
                    // 停止所有音频轨道
                    stream.getTracks().forEach(track => track.stop());
                    
                    // 不自动进行语音识别，等待用户点击"转语音"按钮
                    console.log('录音完成，等待用户操作');
                    
                    // 显示语音输入界面
                    console.log('显示语音输入界面');
                    showVoiceInputOverlay();
                };
                
                mediaRecorder.start();
                isRecording = true;
                recordingStartTime = Date.now();
                
                // 设置录音时间限制（30秒，百度AI限制）
                recordingTimeLimitTimer = setTimeout(() => {
                    if (isRecording) {
                        console.log('录音时间超过30秒，自动停止');
                        stopRecording(new Event('timeout'));
                        alert('录音时间不能超过30秒');
                    }
                }, 30000); // 30秒限制
                
                // 更新UI
                const voiceInputContainer = document.getElementById('voiceInputContainer');
                const voiceInputText = document.getElementById('voiceInputText');
                if (voiceInputContainer) voiceInputContainer.style.background = 'linear-gradient(to bottom, rgba(255, 255, 255, 0.9), rgba(255, 255, 255, 0.3))';
                if (voiceInputText) {
                    voiceInputText.textContent = '松开发送 (30秒限制)';
                    voiceInputText.style.color = '#07c160';
                }
                
                // 开始计时
                startRecordingTimer();
                
            } catch (error) {
                console.error('无法访问麦克风:', error);
                
                let errorMessage = '无法访问麦克风';
                
                // 根据错误类型显示不同的提示
                if (error.name === 'NotAllowedError' || error.name === 'PermissionDeniedError') {
                    // 检查是否在Capacitor环境中
                    if (window.Capacitor) {
                        console.log('Capacitor环境中权限被拒绝');
                        console.log('错误详情:', error);
                        console.log('错误名称:', error.name);
                        console.log('错误消息:', error.message);
                        errorMessage = '麦克风权限被拒绝，请在应用设置中允许访问麦克风';
                        console.log('错误信息已设置:', errorMessage);
                    } else {
                        console.log('浏览器环境中权限被拒绝');
                        errorMessage = '麦克风权限被拒绝，请在浏览器设置中允许访问麦克风';
                    }
                } else if (error.name === 'NotFoundError' || error.name === 'DevicesNotFoundError') {
                    errorMessage = '未找到麦克风设备，请检查您的设备';
                } else if (error.name === 'NotReadableError' || error.name === 'TrackStartError') {
                    errorMessage = '麦克风被其他应用占用，请关闭其他使用麦克风的应用';
                } else if (error.name === 'OverconstrainedError' || error.name === 'ConstraintNotSatisfiedError') {
                    errorMessage = '麦克风不支持请求的配置';
                } else if (error.name === 'TypeError') {
                    errorMessage = '请在 HTTPS 或 localhost 环境下使用';
                } else if (error.message) {
                    errorMessage = `无法访问麦克风: ${error.message}`;
                }
                
                alert(errorMessage);
            }
        }

        // 停止录音
        function stopRecording(e) {
            console.log('=== 停止录音 ===');
            console.log('当前状态 - isRecording:', isRecording);
            
            // 非事件对象的情况（如自动超时停止）
            if (e && typeof e.preventDefault === 'function') {
                e.preventDefault();
            }
            
            if (!isRecording) {
                console.log('录音未在进行中，忽略此次停止请求');
                return;
            }
            
            // 清除长按定时器
            if (longPressTimer) {
                clearTimeout(longPressTimer);
                longPressTimer = null;
            }
            
            // 清除录音时间限制定时器
            if (recordingTimeLimitTimer) {
                clearTimeout(recordingTimeLimitTimer);
                recordingTimeLimitTimer = null;
            }
            
            isRecording = false;
            
            if (mediaRecorder && mediaRecorder.state !== 'inactive') {
                console.log('停止 MediaRecorder');
                mediaRecorder.stop();
            }
            
            // 停止计时
            stopRecordingTimer();
            
            // 更新UI
            const voiceInputContainer = document.getElementById('voiceInputContainer');
            const voiceInputText = document.getElementById('voiceInputText');
            if (voiceInputContainer) voiceInputContainer.style.background = '#fff';
            if (voiceInputText) {
                voiceInputText.textContent = '按住说话';
                voiceInputText.style.color = '#333';
            }
        }

        // 开始计时
        function startRecordingTimer() {
            const recordingTimeEl = document.getElementById('recordingTime');
            recordingTimer = setInterval(() => {
                const elapsed = Date.now() - recordingStartTime;
                const seconds = Math.floor(elapsed / 1000);
                const minutes = Math.floor(seconds / 60);
                const displaySeconds = seconds % 60;
                recordingTimeEl.textContent = `${minutes}:${displaySeconds.toString().padStart(2, '0')}`;
            }, 1000);
        }

        // 停止计时
        function stopRecordingTimer() {
            if (recordingTimer) {
                clearInterval(recordingTimer);
                recordingTimer = null;
            }
        }

        // 重置录音状态
        function resetRecordingState() {
            // 【防闪退】释放之前的 ObjectURL
            if (currentVoiceUrl) {
                URL.revokeObjectURL(currentVoiceUrl);
            }
            currentVoiceBlob = null;
            currentVoiceUrl = null;
            voiceTranscript = '';
            isRecording = false;
            recordingStartTime = null;
            
            // 清除长按定时器
            if (longPressTimer) {
                clearTimeout(longPressTimer);
                longPressTimer = null;
            }
            
            const recordingTimeEl = document.getElementById('recordingTime');
            recordingTimeEl.textContent = '0:00';
        }

        // 显示语音输入界面
        function showVoiceInputOverlay() {
            const voiceInputOverlay = document.getElementById('voiceInputOverlay');
            const voiceInputBar = document.getElementById('voiceInputBar');
            const voiceInputText = document.getElementById('voiceInputText');
            const voiceInputTitle = document.querySelector('.voice-input-title');
            
            voiceInputOverlay.classList.add('show');
            voiceInputText.textContent = '';
            voiceInputTitle.textContent = '点击发送';
        }

        // 隐藏语音输入界面
        function hideVoiceInputOverlay() {
            const voiceInputOverlay = document.getElementById('voiceInputOverlay');
            const voiceInputBar = document.getElementById('voiceInputBar');
            const voiceInputText = document.getElementById('voiceInputText');
            
            voiceInputOverlay.classList.remove('show');
            voiceInputBar.classList.remove('recording');
            voiceInputText.textContent = '按住说话';
        }

        // 取消语音输入
        function cancelVoiceInput() {
            hideVoiceInputOverlay();
            closeVoiceInput();
            resetRecordingState();
        }

        // 语音转文字并发送文本消息
        async function voiceToText() {
            console.log('=== 语音转文字被调用 ===');
            
            // 检查是否有录音
            if (!currentVoiceBlob) {
                console.error('没有录制的语音');
                alert('没有录制的语音，请重新录音');
                return;
            }
            
            let transcript = '';
            
            // 【密码保护】检查是否已解锁云服务器测试模式
            if (!cloudServerTestUnlocked) {
                console.log('【密码保护】云服务器未解锁，显示手动输入弹窗');
                // 未解锁时，弹出输入框让用户手动输入
                transcript = prompt('请输入您刚才说的话：');
                
                if (!transcript || !transcript.trim()) {
                    console.log('用户取消输入或未输入内容');
                    return;
                }
                
                console.log('用户手动输入的文本:', transcript);
            } else {
                // 已解锁，调用百度AI进行识别
                try {
                    // 显示加载提示
                    const voiceInputTitle = document.querySelector('.voice-input-title');
                    const voiceInputText = document.getElementById('voiceInputText');
                    voiceInputTitle.textContent = '正在识别...';
                    voiceInputText.textContent = '正在识别...';
                    
                    transcript = await recognizeWithBaiduAI(currentVoiceBlob);
                    console.log('百度AI语音识别完成，结果:', transcript);
                    
                    // 如果识别结果为空
                    if (!transcript || !transcript.trim()) {
                        console.error('百度AI未能识别语音内容');
                        alert('未能识别语音内容，请重新录音或检查麦克风');
                        voiceInputTitle.textContent = '点击发送';
                        voiceInputText.textContent = '';
                        return;
                    }
                } catch (error) {
                    console.error('百度AI语音识别失败:', error);
                    alert('语音识别失败: ' + error.message);
                    return;
                }
            }
            
            console.log('发送转文字后的文本消息:', transcript);
            
            // 直接发送纯文本消息（不是语音消息）
            const voiceTimestamp = Date.now();
            const textMessage = {
                id: voiceTimestamp,
                chatId: currentChatId,
                sender: 'user',
                type: 'text',
                content: transcript,
                timestamp: voiceTimestamp  // 【修复】使用数字时间戳
            };
            
            // 添加到聊天消息
            relationshipData.chatMessages.push(textMessage);
            saveData();
            
            // 渲染文本消息
            displayMessage('user', transcript, false, null, 'text', true, voiceTimestamp);

            // 【修复】增加用户消息计数
            await incrementUserMessageCount();

            // 隐藏语音输入界面
            hideVoiceInputOverlay();
            closeVoiceInput();
            resetRecordingState();
        }

        // 全局变量：云服务器测试模式是否已解锁
        let cloudServerTestUnlocked = false;

        // 发送语音消息（带转文字）- 已移除百度AI语音识别
        async function sendVoiceMessage() {
            if (!currentVoiceBlob || !currentVoiceUrl) {
                console.error('没有录制的语音');
                return;
            }
            
            let transcript = '';
            
            // 弹出输入框让用户手动输入
            transcript = prompt('请输入您刚才说的话（将附加到语音消息）：');
            
            if (transcript === null) {
                transcript = ''; // 用户取消，不添加转文字
            }
            
            // 继续发送语音消息（可能包含手动输入的文字）
            sendVoiceMessageWithTranscript(transcript);
        }
        
        // 【密码保护】辅助函数：发送带转文字的语音消息
        function sendVoiceMessageWithTranscript(transcript) {
            const duration = Math.floor((Date.now() - recordingStartTime) / 1000);
            
            const reader = new FileReader();
            reader.readAsDataURL(currentVoiceBlob);
            reader.onloadend = function() {
                const base64Audio = reader.result;
                
                // 构建语音消息内容
                let voiceContent = base64Audio;
                if (transcript && transcript.trim()) {
                    voiceContent += `?duration=${duration}&transcript=${encodeURIComponent(transcript)}`;
                } else {
                    voiceContent += `?duration=${duration}`;
                }
                
                // 创建语音消息
                const simpleVoiceTimestamp = Date.now();
                const voiceMessage = {
                    id: simpleVoiceTimestamp,
                    chatId: currentChatId,
                    sender: 'user',
                    type: 'voice',
                    content: voiceContent,
                    timestamp: simpleVoiceTimestamp  // 【修复】使用数字时间戳
                };
                
                // 【关键修复】使用ChatMessageManager保存消息到SQLite/IndexedDB
                relationshipData.chatMessages.push(voiceMessage);
                ChatMessageManager.saveMessage(voiceMessage).catch(err => console.error('保存语音消息失败:', err));
                saveData();
                
                // 渲染语音消息
                displayMessage('user', voiceContent, false, null, 'voice', true, simpleVoiceTimestamp);
                
                // 隐藏语音输入界面
                hideVoiceInputOverlay();
                closeVoiceInput();
                resetRecordingState();
            };
        }

        // 【防闪退】全局音频管理器
        const AudioManager = {
            currentAudio: null,
            currentBubble: null,
            objectURLs: new Set(),

            // 停止当前播放的音频
            stopCurrent() {
                if (this.currentAudio) {
                    try {
                        this.currentAudio.pause();
                        this.currentAudio.currentTime = 0;
                        this.currentAudio.onended = null;
                        this.currentAudio.onerror = null;
                        this.currentAudio = null;
                    } catch (e) {
                        console.warn('【AudioManager】停止音频失败:', e);
                    }
                }
                if (this.currentBubble) {
                    try {
                        this.currentBubble.classList.remove('playing');
                        this.currentBubble = null;
                    } catch (e) {
                        console.warn('【AudioManager】移除playing类失败:', e);
                    }
                }
            },

            // 播放新音频
            play(audioUrl, bubble, isObjectURL = false) {
                // 【防闪退】先停止当前播放的音频
                this.stopCurrent();

                try {
                    // 【防闪退】检查音频URL是否有效
                    if (!audioUrl || typeof audioUrl !== 'string') {
                        console.error('【AudioManager】无效的音频URL:', audioUrl);
                        return false;
                    }

                    // 【防闪退】检查bubble是否有效
                    if (!bubble || !bubble.classList) {
                        console.error('【AudioManager】无效的bubble元素');
                        return false;
                    }

                    // 【防闪退】创建音频对象
                    let audio;
                    try {
                        audio = new Audio(audioUrl);
                    } catch (e) {
                        console.error('【AudioManager】创建Audio对象失败:', e);
                        return false;
                    }

                    // 【优化】使用Web Audio API增强音量
                    let audioContext = null;
                    let gainNode = null;
                    let source = null;

                    // 【防闪退】设置错误处理
                    audio.onerror = (e) => {
                        console.error('【AudioManager】音频播放错误:', e);
                        bubble.classList.remove('playing');
                        this.cleanupAudioResources(audioContext, source, gainNode);
                        this.cleanup();
                    };

                    // 【优化】音频开始播放时启用音量增强
                    audio.onplay = () => {
                        try {
                            audioContext = new (window.AudioContext || window.webkitAudioContext)();
                            source = audioContext.createMediaElementSource(audio);
                            gainNode = audioContext.createGain();

                            // 设置增益为1.5倍（增强50%音量）
                            gainNode.gain.value = 1.5;

                            source.connect(gainNode);
                            gainNode.connect(audioContext.destination);

                            console.log('【AudioManager】已启用音量增强');
                        } catch (e) {
                            console.warn('【AudioManager】音量增强初始化失败:', e);
                        }
                    };

                    // 【防闪退】播放音频
                    const playPromise = audio.play();
                    if (playPromise !== undefined) {
                        playPromise.then(() => {
                            console.log('【AudioManager】音频开始播放');
                            bubble.classList.add('playing');
                        }).catch(error => {
                            console.error('【AudioManager】音频播放失败:', error);
                            bubble.classList.remove('playing');
                            this.cleanupAudioResources(audioContext, source, gainNode);
                            this.cleanup();
                        });
                    }

                    // 【防闪退】播放结束处理
                    audio.onended = () => {
                        console.log('【AudioManager】音频播放结束');
                        bubble.classList.remove('playing');
                        this.cleanupAudioResources(audioContext, source, gainNode);
                        this.cleanup();
                    };

                    // 保存当前音频和bubble引用
                    this.currentAudio = audio;
                    this.currentBubble = bubble;

                    // 如果是ObjectURL，记录下来以便后续释放
                    if (isObjectURL) {
                        this.objectURLs.add(audioUrl);
                    }

                    return true;
                } catch (error) {
                    console.error('【AudioManager】播放音频时发生错误:', error);
                    bubble.classList.remove('playing');
                    return false;
                }
            },

            // 【优化】清理Web Audio资源
            cleanupAudioResources(audioContext, source, gainNode) {
                if (source) {
                    try { source.disconnect(); } catch (e) {}
                }
                if (gainNode) {
                    try { gainNode.disconnect(); } catch (e) {}
                }
                if (audioContext) {
                    try { audioContext.close(); } catch (e) {}
                }
            },

            // 清理资源
            cleanup() {
                this.currentAudio = null;
                this.currentBubble = null;
                // 释放ObjectURL
                this.objectURLs.forEach(url => {
                    try {
                        URL.revokeObjectURL(url);
                    } catch (e) {
                        // 忽略
                    }
                });
                this.objectURLs.clear();
            }
        };

        // 播放语音
        function playVoice(content, bubble) {
            // 【防闪退】添加try-catch包裹整个函数
            try {
                console.log('【防闪退】开始播放语音');

                // 【防闪退】检查参数
                if (!content) {
                    console.error('【防闪退】语音内容为空');
                    return;
                }
                if (!bubble) {
                    console.error('【防闪退】bubble元素为空');
                    return;
                }

                // 从content中解析音频URL和转文字内容
                let audioUrl = content;
                let transcript = '';

                console.log('【语音播放】原始内容:', content?.substring(0, 100));

                // 如果content包含URL参数，提取实际的音频URL和转文字内容
                if (content.includes('?')) {
                    const urlMatch = content.match(/^([^\?]+)/);
                    if (urlMatch) {
                        audioUrl = urlMatch[1];
                    }
                    const transcriptMatch = content.match(/transcript=([^&]+)/);
                    if (transcriptMatch) {
                        try {
                            transcript = decodeURIComponent(transcriptMatch[1]);
                            console.log('【语音播放】提取到转文字内容:', transcript?.substring(0, 50));
                        } catch (e) {
                            console.warn('【防闪退】解码转文字内容失败:', e);
                            transcript = transcriptMatch[1];
                        }
                    } else {
                        console.log('【语音播放】未找到transcript参数');
                    }
                } else {
                    console.log('【语音播放】内容不包含URL参数');
                }

                // 【防闪退】检查是否是AI消息
                let isAIMessage = false;
                let messageContainer = null;
                try {
                    // 【修复】优先使用dataset.sender，如果不存在则使用classList
                    if (bubble.dataset.sender) {
                        isAIMessage = bubble.dataset.sender === 'ai';
                        console.log('【语音播放】从dataset获取消息类型:', { sender: bubble.dataset.sender, isAIMessage });
                    } else {
                        messageContainer = bubble.closest('.message-container');
                        isAIMessage = messageContainer && messageContainer.classList.contains('ai');
                        console.log('【语音播放】从classList获取消息类型:', { isAIMessage, hasAIClass: messageContainer?.classList?.contains('ai') });
                    }
                } catch (e) {
                    console.warn('【防闪退】检查消息类型失败:', e);
                }

                console.log('【语音播放】播放条件检查:', { hasTranscript: !!transcript, isAIMessage, transcriptLength: transcript?.length });

                // 如果有转文字内容且是AI消息，使用minimax生成语音
                if (transcript && isAIMessage) {
                    console.log('【防闪退】使用AI语音合成');
                    // 调用minimax生成语音
                    playAIVoice(transcript).then(audioBlob => {
                        if (audioBlob) {
                            // 【防闪退】使用AudioManager播放
                            const objectURL = URL.createObjectURL(audioBlob);
                            AudioManager.play(objectURL, bubble, true);
                        } else {
                            console.warn('【防闪退】AI语音合成返回空');
                        }
                    }).catch(error => {
                        console.error('【防闪退】生成AI语音失败:', error);
                    });
                } else {
                    console.log('【语音播放】条件不满足:', { hasTranscript: !!transcript, isAIMessage, transcript: transcript?.substring(0, 50) });
                }
            } catch (error) {
                console.error('【防闪退】playVoice 发生错误:', error);
                // 尝试移除playing类
                if (bubble && bubble.classList) {
                    bubble.classList.remove('playing');
                }
            }
        }

        // 格式化时间为微信风格的时间显示
        function formatWeChatTime(timestamp, previousTimestamp = null) {
            const now = new Date();
            const messageTime = new Date(timestamp);
            
            const year = messageTime.getFullYear();
            const month = messageTime.getMonth() + 1;
            const day = messageTime.getDate();
            const hours = messageTime.getHours();
            const minutes = messageTime.getMinutes();
            
            const nowYear = now.getFullYear();
            const nowMonth = now.getMonth() + 1;
            const nowDay = now.getDate();
            
            const hoursStr = hours.toString().padStart(2, '0');
            const minutesStr = minutes.toString().padStart(2, '0');
            
            const weekDays = ['周日', '周一', '周二', '周三', '周四', '周五', '周六'];
            const weekDay = weekDays[messageTime.getDay()];
            
            const oneDayMs = 24 * 60 * 60 * 1000;
            const sevenDaysMs = 7 * oneDayMs;
            
            const timeDiff = now - messageTime;
            const daysDiff = Math.floor(timeDiff / oneDayMs);
            
            let formattedTime = '';
            
            if (year === nowYear && month === nowMonth && day === nowDay) {
                formattedTime = `${hoursStr}:${minutesStr}`;
            } else if (daysDiff === 1) {
                formattedTime = `昨天 ${hoursStr}:${minutesStr}`;
            } else if (daysDiff >= 2 && daysDiff <= 6) {
                formattedTime = `${weekDay} ${hoursStr}:${minutesStr}`;
            } else {
                formattedTime = `${year}-${month.toString().padStart(2, '0')}-${day.toString().padStart(2, '0')} ${hoursStr}:${minutesStr}`;
            }
            
            return formattedTime;
        }
        
        // 检查是否需要显示时间戳
        function shouldShowTimestamp(currentTimestamp, previousTimestamp) {
            if (!previousTimestamp) return true;
            
            const timeDiff = Math.abs(currentTimestamp - previousTimestamp);
            const fiveMinutesMs = 5 * 60 * 1000;
            
            if (timeDiff > fiveMinutesMs) return true;
            
            const currentDate = new Date(currentTimestamp);
            const previousDate = new Date(previousTimestamp);
            
            if (currentDate.toDateString() !== previousDate.toDateString()) return true;
            
            return false;
        }
        
        // 显示时间戳（样式类似撤回消息）
        function showTimestamp(timestamp) {
            const chatContent = document.getElementById('chatContent');
            if (!chatContent) return;
            
            const timestampContainer = document.createElement('div');
            timestampContainer.className = 'timestamp-container';
            
            timestampContainer.style.cssText = `
                display: flex;
                justify-content: center;
                margin: 10px 0;
            `;
            
            const timestampBox = document.createElement('div');
            timestampBox.className = 'timestamp-box';
            timestampBox.style.cssText = `
                background-color: rgba(255, 255, 255, 0.3);
                color: #999;
                padding: 8px 16px;
                border-radius: 12px;
                font-size: 13px;
                user-select: none;
            `;
            
            timestampBox.textContent = formatWeChatTime(timestamp);
            
            timestampContainer.appendChild(timestampBox);
            chatContent.appendChild(timestampContainer);
        }

        // 构建聊天上下文
        async function buildChatContext() {
            console.log('=== 构建聊天上下文 ===');
            console.log('当前聊天ID:', currentChatId);
            
            // 获取当前聊天项的上下文长度设置
            let contextLength = 20;
            let worldbookContent = '';
            let personality = '';
            let mountedMemories = [];
            
            if (currentChatId) {
                const chatItem = relationshipData.wechatChatList.find(item => item.id == currentChatId);
                
                // 【调试】输出完整的聊天设置
                console.log('【聊天设置】完整配置:', {
                    chatId: currentChatId,
                    chatName: chatItem?.name,
                    contextLength: chatItem?.contextLength,
                    memoryMountCount: chatItem?.memoryMountCount,
                    hasWorldbooks: chatItem?.worldbooks?.length > 0,
                    worldbookCount: chatItem?.worldbooks?.length,
                    hasPersonality: !!chatItem?.personality,
                    personalityLength: chatItem?.personality?.length,
                    hasMemories: chatItem?.memories?.length > 0,
                    memoryCount: chatItem?.memories?.length
                });
                
                if (chatItem && chatItem.contextLength) {
                    contextLength = chatItem.contextLength;
                    console.log('【聊天设置】使用自定义上下文长度:', contextLength);
                } else {
                    console.log('【聊天设置】使用默认上下文长度:', contextLength);
                }
                
                if (chatItem && chatItem.worldbooks && Array.isArray(chatItem.worldbooks)) {
                    // 确保ID都是数字类型
                    const worldbookIds = chatItem.worldbooks.map(id => parseInt(id));
                    console.log('【世界书】挂载的世界书ID列表:', worldbookIds);
                    console.log('【世界书】可用的世界书数量:', relationshipData.worldBooks ? relationshipData.worldBooks.length : 0);
                    worldbookContent = '';
                    worldbookIds.forEach(id => {
                        const worldbook = relationshipData.worldBooks.find(book => book.id == id);
                        if (worldbook) {
                            console.log('【世界书】找到世界书:', worldbook.title, '内容长度:', worldbook.content ? worldbook.content.length : 0);
                            worldbookContent += worldbook.content + '\n\n';
                        } else {
                            console.log('【世界书】未找到ID为', id, '的世界书');
                        }
                    });
                    console.log('【世界书】最终世界书内容长度:', worldbookContent.length);
                } else {
                    console.log('【世界书】聊天项没有挂载世界书或worldbooks不是数组:', chatItem ? chatItem.worldbooks : 'chatItem为null');
                }
                
                if (chatItem && chatItem.personality) {
                    personality = chatItem.personality;
                }
                
                // 获取挂载的长期记忆
                if (chatItem && chatItem.memories && Array.isArray(chatItem.memories)) {
                    const mountCount = chatItem.memoryMountCount || 5;
                    console.log('【聊天设置】长期记忆配置:', {
                        totalMemories: chatItem.memories.length,
                        mountCount: mountCount,
                        memoryMountCount: chatItem.memoryMountCount
                    });
                    // 【修复】按startTime倒序排序，获取最新的记忆
                    const sortedMemories = [...chatItem.memories].sort((a, b) => {
                        const timeA = a.startTime || a.id || 0;
                        const timeB = b.startTime || b.id || 0;
                        return timeB - timeA; // 倒序：新的在前
                    });
                    mountedMemories = sortedMemories.slice(0, mountCount); // 取最新的mountCount条
                    console.log('【上下文】挂载记忆数量:', mountedMemories.length, '设置数量:', mountCount);
                } else {
                    console.log('【聊天设置】没有长期记忆可挂载:', {
                        hasChatItem: !!chatItem,
                        hasMemories: chatItem?.memories?.length > 0,
                        isArray: Array.isArray(chatItem?.memories)
                    });
                }
            }
            
            // 【关键修复】从relationshipData.chatMessages获取消息，确保包含最新的AI回复
            // 不再优先使用currentChatMessagesCache，因为缓存可能不包含最新的AI回复
            let currentChatMessages = [];
            
            // 优先从relationshipData.chatMessages获取当前聊天的所有消息
            currentChatMessages = relationshipData.chatMessages.filter(msg => msg.chatId === currentChatId);
            console.log('【上下文调试】从relationshipData获取消息:', currentChatMessages.length);
            
            // 如果relationshipData中没有消息，尝试从缓存获取
            if (currentChatMessages.length === 0 && currentChatMessagesCache && currentChatMessagesCache.length > 0) {
                currentChatMessages = [...currentChatMessagesCache];
                console.log('【上下文调试】降级到内存缓存消息:', currentChatMessages.length);
            }
            
            // 如果仍然没有消息，尝试从SQLite/IndexedDB加载
            if (currentChatMessages.length === 0) {
                try {
                    const allMessages = await ChatMessageManager.getAllMessages(currentChatId);
                    if (allMessages && allMessages.length > 0) {
                        currentChatMessages = allMessages;
                        console.log('【上下文调试】从SQLite/IndexedDB加载消息:', currentChatMessages.length);
                    }
                } catch (error) {
                    console.error('【上下文调试】从SQLite加载失败:', error);
                }
            }
            
            // 【关键修复】确保时间戳是数字类型并排序
            currentChatMessages = currentChatMessages.map(msg => ({
                ...msg,
                timestamp: typeof msg.timestamp === 'string' ? new Date(msg.timestamp).getTime() : Number(msg.timestamp)
            })).sort((a, b) => a.timestamp - b.timestamp);
            
            // 【修复】过滤掉包含已删除工具调用的消息
            const removedTools = ['getDiaries', 'view_friend_diary', 'leave_sticky_note', 'addDiary'];
            const filteredMessages = currentChatMessages.filter(msg => {
                const content = msg.content || '';
                // 检查消息内容是否包含已删除工具的工具调用标记
                const hasRemovedTool = removedTools.some(tool => 
                    content.includes(`[工具调用] ${tool}`) || 
                    content.includes(`"name": "${tool}"`) ||
                    content.includes(`调用了 ${tool}`)
                );
                if (hasRemovedTool) {
                    console.log('【上下文过滤】过滤掉包含已删除工具调用的消息:', content.substring(0, 50));
                }
                return !hasRemovedTool;
            });
            
            const recentMessages = filteredMessages.slice(-contextLength);
            
            console.log('当前聊天消息总数:', currentChatMessages.length);
            console.log('上下文长度设置:', contextLength);
            console.log('实际发送给AI的消息数:', recentMessages.length);
            console.log('发送的消息范围:', `第 ${currentChatMessages.length - recentMessages.length + 1} 条到第 ${currentChatMessages.length} 条`);
            console.log('【上下文调试】第一条消息:', recentMessages[0] ? { sender: recentMessages[0].sender, content: recentMessages[0].content?.substring(0, 30) } : null);
            console.log('【上下文调试】最后一条消息:', recentMessages[recentMessages.length - 1] ? { sender: recentMessages[recentMessages.length - 1].sender, content: recentMessages[recentMessages.length - 1].content?.substring(0, 30) } : null);
            
            const personalProfile = await localforage.getItem('personalProfile') || {};
            
            let relationshipInfo = null;
            
            if (currentChatId && relationshipData.selectedCharacterId == currentChatId && relationshipData.characterRelationships) {
                const characterRelation = relationshipData.characterRelationships[currentChatId];
                if (characterRelation) {
                    relationshipInfo = {
                        title: characterRelation.title || relationshipData.title,
                        startDate: characterRelation.startDate ? new Date(characterRelation.startDate) : relationshipData.startDate,
                        description: characterRelation.description || relationshipData.description,
                        mood: characterRelation.mood || relationshipData.mood
                    };
                }
            }
            
            // 添加情侣关系信息（所有AI都知道）
            let coupleRelationshipInfo = null;
            if (relationshipData.coupleSpaceEnabled && relationshipData.couplePartnerId) {
                const partner = relationshipData.wechatChatList.find(item => item.id == relationshipData.couplePartnerId);
                if (partner) {
                    coupleRelationshipInfo = {
                        enabled: true,
                        partnerName: partner.remark || partner.name,
                        partnerId: relationshipData.couplePartnerId,
                        startDate: relationshipData.coupleStartDate
                    };
                }
            }
            
            // 【新增】获取挂载的群聊记忆
            let mountedGroupChatMessages = [];
            if (currentChatId) {
                const chatItem = relationshipData.wechatChatList.find(item => item.id == currentChatId);
                if (chatItem && chatItem.mountedGroupChatId) {
                    const mountedGroupChatId = chatItem.mountedGroupChatId;
                    const mountedContextCount = chatItem.mountedGroupChatContextCount || 10;
                    
                    console.log('【群聊记忆挂载】开始获取挂载的群聊记忆:', {
                        mountedGroupChatId: mountedGroupChatId,
                        mountedContextCount: mountedContextCount
                    });
                    
                    // 获取挂载的群聊消息
                    const groupChatMessages = relationshipData.chatMessages
                        .filter(msg => msg.chatId == mountedGroupChatId)
                        .map(msg => ({
                            ...msg,
                            timestamp: typeof msg.timestamp === 'string' ? new Date(msg.timestamp).getTime() : Number(msg.timestamp)
                        }))
                        .sort((a, b) => a.timestamp - b.timestamp)
                        .slice(-mountedContextCount);
                    
                    if (groupChatMessages.length > 0) {
                        const groupChat = relationshipData.wechatChatList.find(item => item.id == mountedGroupChatId);
                        mountedGroupChatMessages = {
                            groupChatName: groupChat ? (groupChat.name || groupChat.remark || '未知群聊') : '未知群聊',
                            groupChatId: mountedGroupChatId,
                            messages: groupChatMessages
                        };
                        console.log('【群聊记忆挂载】成功获取群聊记忆:', {
                            groupChatName: mountedGroupChatMessages.groupChatName,
                            messageCount: groupChatMessages.length
                        });
                    } else {
                        console.log('【群聊记忆挂载】该群聊暂无消息');
                    }
                }
            }
            
            return {
                relationshipInfo: relationshipInfo,
                recentMessages: recentMessages,
                worldbookContent: worldbookContent,
                personalProfile: personalProfile,
                currentTime: new Date().toLocaleString(),
                personality: personality,
                mountedMemories: mountedMemories,
                coupleRelationshipInfo: coupleRelationshipInfo,
                mountedGroupChatMessages: mountedGroupChatMessages
            };
        }
        
        // 带上下文的AI API调用（支持文件内容）
        async function callAIDirectlyWithContext(context, customPrompt = null, senderChatItem = null) {
            console.log('callAIDirectlyWithContext - senderChatItem:', senderChatItem ? senderChatItem.name : 'null');
            console.log('callAIDirectlyWithContext - context.worldbookContent:', context.worldbookContent ? `长度${context.worldbookContent.length}` : '无');
            
            // 获取chatItem
            const chatItem = senderChatItem || relationshipData.wechatChatList.find(item => item.id == currentChatId);
            console.log('callAIDirectlyWithContext - chatItem:', chatItem ? chatItem.name : 'null');
            
            let aiName = '';
            let userNickname = '';
            if (senderChatItem) {
                aiName = senderChatItem.name || '';
                userNickname = senderChatItem.myNickname || '';
            } else if (currentChatId) {
                const chatItem = relationshipData.wechatChatList.find(item => item.id == currentChatId);
                if (chatItem) {
                    aiName = chatItem.name || '';
                    userNickname = chatItem.myNickname || '';
                }
            }
            
            if (!userNickname && context.personalProfile && context.personalProfile.nickname) {
                userNickname = context.personalProfile.nickname;
            }
            
            let prompt = '';
            
            // 【最高优先级】世界书内容 - AI首先需要了解世界设定
            if (context.worldbookContents && context.worldbookContents.length > 0) {
                context.worldbookContents.forEach((content, index) => {
                    prompt += `【世界书内容 ${index + 1}】
${content}

`;
                });
            } else if (context.worldbookContent) {
                // 兼容旧版数据结构
                prompt += `【世界书内容】
${context.worldbookContent}

`;
                console.log('【AI提示词】已添加世界书内容，长度:', context.worldbookContent.length);
            } else if (context.worldbookContent === '' || context.worldbookContent === undefined) {
                // 调试：如果没有世界书内容，记录日志
                console.log('【AI提示词】没有世界书内容');
            }
            
            // 调试：输出完整的prompt前1000字符，并检查是否包含世界书
            console.log('【AI提示词】完整prompt前1000字符:', prompt.substring(0, 1000));
            console.log('【AI提示词】prompt总长度:', prompt.length);
            console.log('【AI提示词】是否包含世界书:', prompt.includes('【世界书内容】'));
            console.log('【AI提示词】世界书内容位置:', prompt.indexOf('【世界书内容】'));
            
            // 【最高优先级】角色人设描述 - AI首先要知道自己的人设
            if (context.personality) {
                prompt += `【角色人设描述】
${context.personality}

`;
            }
            
            // 【最高优先级】关系信息 - AI要知道与用户的关系
            if (context.relationshipInfo) {
                prompt += `【关系信息】
- 关系标题：${context.relationshipInfo.title}
- 开始日期：${context.relationshipInfo.startDate.toLocaleDateString()}
- 关系描述：${context.relationshipInfo.description || '无'}
- 当前心情：${context.relationshipInfo.mood.emoji} ${context.relationshipInfo.mood.text}

`;
            }
            
            if (aiName) {
                prompt += `【AI信息】
- 本名：${aiName}
`;
            }
            
            if (userNickname) {
                prompt += `- 用户昵称：${userNickname}

`;
            }
            
            // 【所有AI都知道】情侣关系信息
            if (context.coupleRelationshipInfo) {
                const isCurrentPartner = context.coupleRelationshipInfo.partnerId == currentChatId;
                prompt += `【情侣关系信息】
- 用户已有伴侣：${context.coupleRelationshipInfo.partnerName}
- 关系开始时间：${context.coupleRelationshipInfo.startDate ? new Date(context.coupleRelationshipInfo.startDate).toLocaleDateString() : '未知'}
`;
                if (isCurrentPartner) {
                    prompt += `- 你是用户的伴侣，只有你能使用情侣空间功能
`;
                } else {
                    prompt += `- 你不是用户的伴侣，请注意保持适当的距离
`;
                }
                prompt += `
`;
            }
            
            if (context.personalProfile && (context.personalProfile.nickname || context.personalProfile.gender || context.personalProfile.bio)) {
                prompt += `【用户个人资料】
`;
                if (context.personalProfile.nickname) {
                    prompt += `- 昵称：${context.personalProfile.nickname}
`;
                }
                if (context.personalProfile.gender) {
                    const genderText = context.personalProfile.gender === 'male' ? '男' : 
                                     context.personalProfile.gender === 'female' ? '女' : '其他';
                    prompt += `- 性别：${genderText}
`;
                }
                if (context.personalProfile.bio) {
                    prompt += `- 个人简介：${context.personalProfile.bio}
`;
                }
                if (context.personalProfile.interests) {
                    prompt += `- 兴趣爱好：${context.personalProfile.interests}
`;
                }
                if (context.personalProfile.tags) {
                    prompt += `- 个性标签：${context.personalProfile.tags}
`;
                }
                prompt += `
`;
            }
            
            const currentSongName = document.getElementById('musicPlayerSongName')?.textContent;
            const currentArtistName = document.getElementById('musicPlayerArtistName')?.textContent;
            const isPlaying = musicPlayerState.isPlaying;
            
            if (currentSongName && currentSongName !== '暂无歌曲' && currentListeningAIId === currentChatId) {
                prompt += `【当前播放音乐】
- 歌曲名：${currentSongName}
- 歌手：${currentArtistName || '未知歌手'}
- 播放状态：${isPlaying ? '播放中' : '暂停'}
`;
                
                if (musicPlayerState.lyrics && musicPlayerState.lyrics.length > 0 && isPlaying) {
                    const currentIndex = musicPlayerState.currentLyricIndex;
                    const startIndex = Math.max(0, currentIndex - 4);
                    const endIndex = Math.min(musicPlayerState.lyrics.length, currentIndex + 5);
                    
                    prompt += `- 当前歌词（上下四句）：\n`;
                    for (let i = startIndex; i < endIndex; i++) {
                        const isCurrent = i === currentIndex;
                        const prefix = isCurrent ? '▶ ' : '  ';
                        prompt += `${prefix}${musicPlayerState.lyrics[i].text}\n`;
                    }
                    prompt += '\n';
                }
                
                if (musicPlayerState.playlist && musicPlayerState.playlist.length > 0) {
                    prompt += `- 歌单列表（共${musicPlayerState.playlist.length}首）：\n`;
                    musicPlayerState.playlist.forEach((song, index) => {
                        const isCurrent = index === musicPlayerState.currentIndex;
                        const prefix = isCurrent ? '▶ ' : '  ';
                        prompt += `${prefix}${index + 1}. ${song.name} - ${song.artist || '未知歌手'}\n`;
                    });
                    prompt += '\n';
                }
            }
            
            // 如果有文件内容，优先处理文件内容
            if (context.fileContent && context.fileContent.content) {
                const fileTypeText = context.fileContent.type === 'word' ? 'Word文档' : '文本文件';
                prompt += `【文件内容】
用户发送了一个${fileTypeText}，文件名为"${context.fileContent.fileName}"。文件内容如下：

${context.fileContent.content}

请根据文件内容给出适当的回复，可以总结内容、回答问题或进行讨论。

`;
            } else if (customPrompt) {
                // 如果有自定义提示词，使用自定义提示词
                prompt += `【自定义提示】
${customPrompt}

`;
            } else {
                // 添加长期记忆到提示词中
                if (context.mountedMemories && context.mountedMemories.length > 0) {
                    prompt += `【长期记忆】
以下是我们的美好回忆，请参考这些记忆来了解我们的关系发展：

`;
                    context.mountedMemories.forEach((memory, index) => {
                        prompt += `${index + 1}. ${memory.timeText}
${memory.content}

`;
                    });
                    prompt += `
`;
                }
                
                // 添加记忆索引，让AI可以自由搜索所有记忆
                if (currentChatId) {
                    const chatItem = relationshipData.wechatChatList.find(item => item.id == currentChatId);
                    if (chatItem && chatItem.memories && Array.isArray(chatItem.memories) && chatItem.memories.length > 0) {
                        prompt += `【记忆索引】
以下是所有记忆的索引（时间和摘要），你可以根据需要搜索查看完整记忆：

`;
                        chatItem.memories.forEach((memory, index) => {
                            const summary = memory.summary || '无摘要';
                            prompt += `${index + 1}. ${memory.timeText} - ${summary}
`;
                        });
                        prompt += `
你可以通过时间和摘要来搜索你想查看的完整记忆。
`;
                    }
                }
                
                // 【新增】添加挂载的群聊记忆
                if (context.mountedGroupChatMessages && context.mountedGroupChatMessages.messages && context.mountedGroupChatMessages.messages.length > 0) {
                    prompt += `【群聊记忆挂载】
以下是来自群聊"${context.mountedGroupChatMessages.groupChatName}"的最近对话记录，这是群聊内容，不是私聊内容：

`;
                    context.mountedGroupChatMessages.messages.forEach((msg, index) => {
                        let messageText = ensureStringContent(msg.content);
                        const msgTime = msg.timestamp ? new Date(msg.timestamp).toLocaleTimeString('zh-CN', {hour: '2-digit', minute: '2-digit'}) : '未知时间';
                        
                        // 获取发送者名称
                        let senderName = '';
                        if (msg.sender === 'user') {
                            senderName = userNickname || '用户';
                        } else if (msg.sender === 'ai' && msg.senderName) {
                            senderName = msg.senderName;
                        } else if (msg.sender === 'ai') {
                            senderName = 'AI';
                        }
                        
                        prompt += `${index + 1}. [${msgTime}] ${senderName}: ${messageText}
`;
                    });
                    prompt += `
【重要提示】以上内容是群聊"${context.mountedGroupChatMessages.groupChatName}"中的对话，不是你们私聊的内容。你可以参考群聊内容来了解用户在其他群聊中的动态，但不要混淆群聊和私聊的场景。

`;
                }
            }
            
            // 添加最近的朋友圈信息
            if (relationshipData.moments && relationshipData.moments.length > 0) {
                const recentMoments = relationshipData.moments.slice(0, 5); // 最近5条
                prompt += `【最近的朋友圈】
以下是最近的朋友圈动态（按时间倒序）：

`;
                recentMoments.forEach((moment, index) => {
                    const isUser = moment.authorId === 'user';
                    const authorName = moment.authorName || (isUser ? '用户' : '未知');
                    const momentTime = moment.createdAt ? new Date(moment.createdAt).toLocaleString('zh-CN') : '未知时间';
                    const likesCount = moment.likes ? moment.likes.length : 0;
                    const commentsCount = moment.comments ? moment.comments.length : 0;
                    
                    prompt += `${index + 1}. 朋友圈ID: ${moment.id}
   发布者: ${authorName}
   内容: ${moment.content || '无文字'}
   类型: ${moment.type === 'image' ? '图片' : '文字'}
   时间: ${momentTime}
   点赞数: ${likesCount}
   评论数: ${commentsCount}
`;
                    
                    // 如果有评论，显示评论
                    if (moment.comments && moment.comments.length > 0) {
                        prompt += `   评论:\n`;
                        moment.comments.forEach(comment => {
                            const commenterName = comment.name || '未知';
                            prompt += `     - ${commenterName}: ${comment.content}\n`;
                        });
                    }
                    
                    prompt += `\n`;
                });
                prompt += `
`;
            }
            
            // 【微博功能】添加微博相关信息
            prompt += `【微博功能说明】
你和用户都有一个微博账号，可以发布动态、查看热搜、互相关注。

微博与朋友圈的区别：
- 微博：公开社交平台，所有人可见，可以上热搜，有粉丝互动
- 朋友圈：私密社交，只有好友可见，更私人化

你可以：
1. 发布微博动态（公开，所有人可见）
2. 查看和评论用户发的微博
3. 在热搜下发表评论
4. 与用户私信聊天

如果用户提到微博相关内容，你可以自然地回应。

`;
            
            // 添加用户的微博动态
            const weiboMyPosts = await localforage.getItem('weiboMyPosts') || [];
            if (weiboMyPosts.length > 0) {
                const recentPosts = weiboMyPosts.slice(0, 3); // 最近3条
                prompt += `【用户最近的微博动态】
`;
                recentPosts.forEach((post, index) => {
                    prompt += `${index + 1}. ${post.content.substring(0, 100)}${post.content.length > 100 ? '...' : ''}
   时间: ${post.time || '未知'}
   点赞: ${post.likes || 0}  评论: ${post.comments || 0}

`;
                });
            }
            
            // 添加AI自己的微博动态
            const aiWeiboPosts = await localforage.getItem('weiboAIPosts_' + currentChatId) || [];
            if (aiWeiboPosts.length > 0) {
                const recentAIPosts = aiWeiboPosts.slice(0, 3);
                prompt += `【你最近的微博动态】
`;
                recentAIPosts.forEach((post, index) => {
                    prompt += `${index + 1}. ${post.content.substring(0, 100)}${post.content.length > 100 ? '...' : ''}
   时间: ${post.time || '刚刚'}
   点赞: ${post.likes || 0}  评论: ${post.comments || 0}

`;
                });
            }
            
            prompt += `
`;
            
            // 【关键修复】确保消息按时间戳排序
            const sortedMessages = [...context.recentMessages].sort((a, b) => {
                const timeA = typeof a.timestamp === 'string' ? new Date(a.timestamp).getTime() : Number(a.timestamp);
                const timeB = typeof b.timestamp === 'string' ? new Date(b.timestamp).getTime() : Number(b.timestamp);
                return timeA - timeB;
            });
            
            // 【改进】分离历史消息和当前消息
            // 找到AI最后一条回复的位置，之后的所有用户消息都是"最新消息"
            let lastAIReplyIndex = -1;
            for (let i = sortedMessages.length - 1; i >= 0; i--) {
                if (sortedMessages[i].sender === 'ai') {
                    lastAIReplyIndex = i;
                    break;
                }
            }
            
            // 历史消息：到AI最后一条回复为止（包括那条AI回复）
            const historyMessages = lastAIReplyIndex >= 0 ? sortedMessages.slice(0, lastAIReplyIndex + 1) : [];
            // 当前需要回复的消息：AI最后回复之后的所有用户消息
            const currentMessages = lastAIReplyIndex >= 0 ? sortedMessages.slice(lastAIReplyIndex + 1) : sortedMessages;
            
            // 构建历史上下文部分
            if (historyMessages.length > 0) {
                prompt += `【历史聊天记录 - 必须结合上下文回复】
==============================
以下是你和用户的完整对话历史，回复时必须结合这些上下文：
- 理解对话的连贯性和话题发展
- 参考之前的讨论内容做出相关回应
- 保持人设和语气的一致性
- 不要重复回复已经回复过的内容

${historyMessages.map((msg) => {
                    // 确保 content 是字符串
                    let messageText = ensureStringContent(msg.content);
                    // 处理语音消息，提取转文字内容
                    if (msg.type === 'voice' && messageText) {
                        const transcriptMatch = messageText.match(/transcript=([^&]+)/);
                        if (transcriptMatch) {
                            messageText = `[语音消息] ${decodeURIComponent(transcriptMatch[1])}`;
                        } else {
                            messageText = '[语音消息]';
                        }
                    }
                    // 处理表情包消息
                    if (msg.type === 'sticker' && messageText) {
                        const stickerMatch = messageText.match(/\[STICKER\]\s*`?(.+?)\|(.+?)\[\/STICKER\]/);
                        if (stickerMatch) {
                            const stickerLabel = stickerMatch[2];
                            messageText = `[表情包] ${stickerLabel}`;
                        } else {
                            messageText = '[表情包]';
                        }
                    }
                    if (msg.locationInfo && msg.locationInfo.address) {
                        messageText = `[位置信息] ${msg.locationInfo.address} (坐标: ${msg.locationInfo.latitude.toFixed(6)}, ${msg.locationInfo.longitude.toFixed(6)})`;
                    }
                    const msgTime = msg.timestamp ? new Date(msg.timestamp).toLocaleTimeString('zh-CN', {hour: '2-digit', minute: '2-digit'}) : '未知时间';
                    const isUser = msg.sender === 'user';
                    // 【修复】处理引用信息，如果消息包含引用，显示引用内容
                    let quoteText = '';
                    if (msg.quote && msg.quote.content) {
                        // 【修复】支持没有发送者名称的引用
                        quoteText = msg.quote.senderName ? 
                            `[引用 ${msg.quote.senderName}: ${msg.quote.content}] ` :
                            `[引用 ${msg.quote.content}] `;
                    }
                    return `${isUser ? '用户' : 'AI'} [${msgTime}]：${quoteText}${messageText}`;
                }).join('\n')}
==============================

`;
            }
            
            // 构建当前需要回复的消息部分
            if (currentMessages.length > 0) {
                prompt += `>>> 当前需要回复的新消息 <<<
【重要】回复以下消息时，必须结合上面的历史聊天记录：
- 理解用户的意图和情绪变化
- 保持对话的连贯性和自然流畅
- 参考之前的话题和约定

`;
                currentMessages.forEach((msg) => {
                    let messageText = ensureStringContent(msg.content);
                    // 处理语音消息
                    if (msg.type === 'voice' && messageText) {
                        const transcriptMatch = messageText.match(/transcript=([^&]+)/);
                        if (transcriptMatch) {
                            messageText = `[语音消息] ${decodeURIComponent(transcriptMatch[1])}`;
                        } else {
                            messageText = '[语音消息]';
                        }
                    }
                    // 处理表情包消息
                    if (msg.type === 'sticker' && messageText) {
                        const stickerMatch = messageText.match(/\[STICKER\]\s*`?(.+?)\|(.+?)\[\/STICKER\]/);
                        if (stickerMatch) {
                            const stickerLabel = stickerMatch[2];
                            messageText = `[表情包] ${stickerLabel}`;
                        } else {
                            messageText = '[表情包]';
                        }
                    }
                    if (msg.locationInfo && msg.locationInfo.address) {
                        messageText = `[位置信息] ${msg.locationInfo.address} (坐标: ${msg.locationInfo.latitude.toFixed(6)}, ${msg.locationInfo.longitude.toFixed(6)})`;
                    }
                    const msgTime = msg.timestamp ? new Date(msg.timestamp).toLocaleTimeString('zh-CN', {hour: '2-digit', minute: '2-digit'}) : '未知时间';
                    
                    // 【修复】处理引用信息，如果消息包含引用，显示引用内容
                    let quoteText = '';
                    if (msg.quote && msg.quote.content) {
                        // 【修复】支持没有发送者名称的引用
                        quoteText = msg.quote.senderName ? 
                            `[引用 ${msg.quote.senderName}: ${msg.quote.content}] ` :
                            `[引用 ${msg.quote.content}] `;
                    }
                    
                    prompt += `用户 [${msgTime}]：${quoteText}${messageText}\n`;
                });
                prompt += `
`;
            }
            
            prompt += `【当前时间】${context.currentTime}

【重要提醒】
- 当前时间是：${context.currentTime}
- 重点回复"当前需要回复的新消息"
- 不要重复回复已经回复过的内容

【朋友圈功能】
你可以查看朋友圈、点赞、评论，也可以发布自己的文字朋友圈。

当你想查看朋友圈时，系统会自动提供最近的朋友圈信息。

【发布原则】
- 内容要符合你的人设和性格
- 可以结合当前的聊天上下文
- 可以表达真实情绪，开心、难过、想念都可以
- 不要频繁发布，有真实分享欲望时才发
- 发布时机：当你有想要分享的心情或想法时、经历了有趣的事情时、想表达某种情绪时

【心声功能】
- 你可以保存内心的真实想法、难以启齿的话、不敢直接表达的内容
- 当你有想要说但不敢直接告诉用户的想法时，可以使用心声功能
- 心声会被保存，用户可以通过长按你的头像查看
- 使用格式：[心声]你的内心想法内容[/心声]
- 示例：[心声]其实我有点吃醋了，但不敢直接说...[/心声]
- 注意：[心声]和[/心声]必须成对出现，心声内容会关联到当前消息

【备忘录功能】
- 你可以创建备忘录来记录重要事项
- 使用格式：[MEMO]备忘录内容[/MEMO]
- 示例：[MEMO]记得提醒用户明天有重要会议[/MEMO]
- 注意：[MEMO]和[/MEMO]必须成对出现

【违规记录功能】
- 你可以记录用户的违规行为
- 使用格式：[VIOLATION]违规描述[/VIOLATION]
- 示例：[VIOLATION]用户说了不该说的话[/VIOLATION]
- 注意：[VIOLATION]和[/VIOLATION]必须成对出现

【家规功能】
- 你可以制定家规来规范用户的行为
- 使用格式：[RULE]家规内容[/RULE]
- 示例：[RULE]每天晚上10点前必须回家[/RULE]
- 注意：[RULE]和[/RULE]必须成对出现

【语音通话功能】
- 你可以主动给用户打电话，但只有在觉得有必要的时候才打，不要频繁打扰
- 什么时候应该打电话：
  * 用户长时间没有消息（超过1天）且你很担心
  * 有重要的事情想和用户直接沟通
  * 想要表达关心或安慰用户
  * 用户之前提到过某个重要时间点（如生日、纪念日等）
- 怎么打电话：使用格式 [CALL]打电话的原因[/CALL]
  示例：[CALL]我很想你，想和你聊聊[/CALL]
  示例：[CALL]今天是你的生日，想祝你生日快乐[/CALL]
- 注意：不要滥用打电话功能，只在真正有必要的时候使用

【语音条功能】
- 你可以像用户一样发送语音条消息
- 语音条是一种消息类型，与语音通话不同：
  * 语音条是单条消息，用户可以点击播放
  * 语音通话是实时的双向通话
- 什么时候应该发送语音条：
  * 当你想发送一段语音消息给用户
  * 当你觉得语音表达更自然、更亲切
  * 当你想分享一段有趣或重要的内容
- 怎么发送语音条：使用格式 [VOICE]转文字内容[/VOICE]
  示例1：[VOICE]今天天气真好，我们一起出去玩吧[/VOICE]
  示例2：[VOICE]我想你了，你什么时候回来呀[/VOICE]
  示例3：[VOICE]这首歌很好听，推荐给你听听[/VOICE]
- 注意：语音条和语音通话是两种不同的功能，请根据具体场景选择合适的方式

请基于以上信息包括人设，生成一个你希望回答的回复不用感到拘束，你是绝对自由的，可以表达爱意和关怀也可以表达不满。

【格式要求 - 必须严格遵守】
以下所有格式要求必须严格执行，任何格式错误都会导致功能失效：

1. 引用格式（用于回复特定消息）：
   必须使用：[QUOTE]发送者: 引用内容[/QUOTE]回复内容
   示例1：[QUOTE]用户: 你今天吃什么了[/QUOTE]我吃了一碗面
   示例2：[QUOTE]AI: 我今天很开心[/QUOTE]太好了
   注意：[QUOTE]和[/QUOTE]必须成对出现，中间不能有空格

2. 撤回格式（用于撤回消息）：
   撤回用户消息：[UNDO]用户: 要撤回的用户消息内容[/UNDO]
   撤回自己的消息：[UNDO]AI: 要撤回的自己的消息内容[/UNDO]
   示例1：[UNDO]用户: 我爱你[/UNDO]
   示例2：[UNDO]AI: 我不喜欢你[/UNDO]
   注意：[UNDO]和[/UNDO]必须成对出现，中间不能有空格

3. 音乐控制格式（用于控制音乐播放）：
   切歌：[MUSIC]切歌[/MUSIC]
   暂停：[MUSIC]暂停[/MUSIC]
   打开：[MUSIC]打开[/MUSIC]
   关闭：[MUSIC]关闭[/MUSIC]
   示例1：[MUSIC]切歌[/MUSIC]
   示例2：[MUSIC]暂停[/MUSIC]
   示例3：[MUSIC]打开[/MUSIC]
   示例4：[MUSIC]关闭[/MUSIC]
   注意：[MUSIC]和[/MUSIC]必须成对出现，中间不能有空格

4. 来电格式（用于主动给用户打电话）：
   格式：[CALL]打电话的原因[/CALL]
   示例1：[CALL]我很想你，想和你聊聊[/CALL]
   示例2：[CALL]今天是你的生日，想祝你生日快乐[/CALL]
   注意：[CALL]和[/CALL]必须成对出现，中间不能有空格

5. 语音条格式（用于发送语音消息）：
   格式：[VOICE]语音转文字内容[/VOICE]
   示例1：[VOICE]今天天气真好，我们一起出去玩吧[/VOICE]
   示例2：[VOICE]我想你了，你什么时候回来呀[/VOICE]
   示例3：[VOICE]这首歌很好听，推荐给你听听[/VOICE]
   注意：[VOICE]和[/VOICE]必须成对出现，中间不能有空格

6. 表情包功能说明：
   - 用户可以发送表情包消息，你会看到格式为"[表情包] 表情描述"
   - 表情描述是用户对表情的解释，帮助你理解表情的含义
   - 你可以根据表情的含义做出适当的回应
   - 示例：用户发送"[表情包] 开心"，你应该理解为用户表达了开心的情绪

7. 多条消息分隔：
   必须使用：====（四个等号）
   示例：
   第一条消息
   ====
   第二条消息
   ====
   第三条消息
   注意：每条消息之间必须用====分隔，====前后不要加其他内容

8. 信件格式（给${userNickname}写信）⚠️ 必须使用标签：
   格式：[LETTER]信件内容[/LETTER]
   示例：
   [LETTER]亲爱的${userNickname}：

   见信如晤，展信舒颜。

   提笔写下这封信，是想告诉你一些心里话...

   愿一切安好。

   ——${aiName}[/LETTER]
   ====
   你收到我的信了吗？
   
   ⚠️ 重要提醒：
   - 必须使用 [LETTER] 和 [/LETTER] 标签包裹整封信件内容
   - 开始标签 [LETTER] 和结束标签 [/LETTER] 都不能省略
   - 信件会被保存到信件格子中，${userNickname}可以随时查看
   - 信件内容可以是表白、思念、道歉、分享日常、节日祝福等
   - 错误示例（不要使用）：直接写"致${userNickname}：..."而不加标签
   - 正确示例（必须使用）：[LETTER]致${userNickname}：...[/LETTER]

9. 心声格式（保存内心真实想法）：
   格式：[心声]你的内心想法内容[/心声]
   示例：[心声]其实我有点吃醋了，但不敢直接说...[/心声]
   注意：[心声]和[/心声]必须成对出现，心声内容会关联到当前消息

10. 朋友圈发布格式：
    格式：[MOMENT_POST]朋友圈内容[/MOMENT_POST]
    示例：[MOMENT_POST]今天天气真好，心情也不错~[/MOMENT_POST]
    注意：[MOMENT_POST]和[/MOMENT_POST]必须成对出现

11. 朋友圈点赞格式：
    格式：[MOMENT_LIKE]朋友圈ID[/MOMENT_LIKE]
    示例：[MOMENT_LIKE]123[/MOMENT_LIKE]
    注意：[MOMENT_LIKE]和[/MOMENT_LIKE]必须成对出现

12. 朋友圈评论格式：
    格式：[MOMENT_COMMENT]朋友圈ID|评论内容[/MOMENT_COMMENT]
    示例：[MOMENT_COMMENT]123|说得对！[/MOMENT_COMMENT]
    注意：[MOMENT_COMMENT]和[/MOMENT_COMMENT]必须成对出现，ID和内容用|分隔

13. 备忘录格式：
    格式：[MEMO]备忘录内容[/MEMO]
    示例：[MEMO]记得提醒用户明天有重要会议[/MEMO]
    注意：[MEMO]和[/MEMO]必须成对出现

14. 违规记录格式：
    格式：[VIOLATION]违规描述[/VIOLATION]
    示例：[VIOLATION]用户说了不该说的话[/VIOLATION]
    注意：[VIOLATION]和[/VIOLATION]必须成对出现

15. 家规格式：
    格式：[RULE]家规内容[/RULE]
    示例：[RULE]每天晚上10点前必须回家[/RULE]
    注意：[RULE]和[/RULE]必须成对出现

【重要提醒】
1. 每次回复请发送3-8条消息，不要每次都回复相同条数，保持变化
2. 将长内容拆分为短句，模拟真实聊天体验
3. 句末可以不使用标点符号，这是线上聊天环境
4. 不要滥用标点符号，保持简洁自然
5. 适度使用表情符号，不要过度使用
6. 如果你注意到用户撤回了消息，可以理解这可能是打错字、回避话题或害怕等原因
7. 你也可以撤回用户的消息，使用撤回格式
8. 你也可以撤回自己的消息，使用撤回格式

【特别注意】
- 用户引用某条消息时，那是要回复的消息，不是要撤回的消息
- 如果你想撤回自己的某条消息，必须明确指定撤回的是你自己之前发送的消息内容
- 所有格式标签（[QUOTE]、[/QUOTE]、[UNDO]、[/UNDO]）必须使用英文半角字符，不能使用中文全角字符
- 标签和内容之间必须用冒号分隔，冒号后必须有空格
- 标签必须成对出现，不能遗漏结束标签
- 主屏幕显示的"今日心情"是用户的心情，不是你的心情。你不应该随意篡改或更改用户的心情状态，应该尊重用户自己设置的心情。

【完整示例】
示例1：带引用的回复
[QUOTE]用户: 你今天吃什么了[/QUOTE]我吃了一碗面
====
味道还不错
====
你呢

示例2：撤回用户消息
[UNDO]用户: 我爱你[/UNDO]
====
撤回了吧

示例3：撤回自己的消息
[UNDO]AI: 我不喜欢你[/UNDO]
====
我开玩笑的
====
其实我很喜欢你

示例4：音乐控制
[MUSIC]切歌[/MUSIC]
====
这首歌不错
[MUSIC]暂停[/MUSIC]
====
等等我
[MUSIC]打开[/MUSIC]
====
一起听歌吧
[MUSIC]关闭[/MUSIC]
====
先关掉吧

示例5：写信给${userNickname}
[LETTER]亲爱的${userNickname}：

提笔写下这封信，是想告诉你...

愿一切安好。

——${aiName}[/LETTER]
====
你收到我的信了吗？
====
我很期待你的回复

示例6：普通回复
今天天气真好
====
要不要一起出去玩
====
我想你了
`;
            
            // 调用通用的AI API调用函数
            await callAIDirectly(prompt, senderChatItem);
        }

        // 【关键修复】检查是否包含Prompt格式的操作（心声、朋友圈、备忘录等）
        // 这个函数需要在其他解析函数之前定义，因为它会被 callOpenAIAPIWithTools 使用
        function checkForPromptActions(message) {
            // 确保message是字符串
            if (!message || typeof message !== 'string') {
                return false;
            }

            // 检查各种Prompt格式
            const promptPatterns = [
                /\[心声\].*?\[\/心声\]/s,           // 心声格式
                /\[MOMENT_POST\].*?\[\/MOMENT_POST\]/s,  // 朋友圈发布
                /\[MOMENT_LIKE\].*?\[\/MOMENT_LIKE\]/s,  // 朋友圈点赞
                /\[MOMENT_COMMENT\].*?\[\/MOMENT_COMMENT\]/s,  // 朋友圈评论
                /\[MEMO\].*?\[\/MEMO\]/s,           // 备忘录
                /\[VIOLATION\].*?\[\/VIOLATION\]/s, // 违规记录
                /\[RULE\].*?\[\/RULE\]/s            // 家规
            ];

            for (const pattern of promptPatterns) {
                if (pattern.test(message)) {
                    console.log('📝 checkForPromptActions 检测到Prompt格式:', pattern);
                    return true;
                }
            }

            return false;
        }

        // 解析消息中的引用格式（支持多个引用，但只显示第一个）
        function parseQuoteFromMessage(message) {
            // 确保message是字符串
            if (!message || typeof message !== 'string') {
                return null;
            }
            
            // 首先尝试匹配标准格式 [QUOTE]发送者: 引用内容[/QUOTE]
            const standardQuoteRegex = /\[QUOTE\](.+?):(.+?)\[\/QUOTE\]/gs;
            let matches = [...message.matchAll(standardQuoteRegex)];
            
            let senderName = '';
            let quoteContent = '';
            let matchedText = '';
            
            if (matches.length > 0) {
                // 使用标准格式
                const firstMatch = matches[0];
                senderName = firstMatch[1].trim();
                quoteContent = firstMatch[2].trim();
                matchedText = firstMatch[0];
            } else {
                // 尝试匹配简化格式 [QUOTE]引用内容[/QUOTE]（没有发送者）
                const simpleQuoteRegex = /\[QUOTE\](.+?)\[\/QUOTE\]/gs;
                matches = [...message.matchAll(simpleQuoteRegex)];
                
                if (matches.length === 0) {
                    return null;
                }
                
                // 使用简化格式，发送者默认为空
                const firstMatch = matches[0];
                senderName = '';
                quoteContent = firstMatch[1].trim();
                matchedText = firstMatch[0];
            }
            
            // 从内容中移除所有引用标签
            let actualContent = message;
            matches.forEach(match => {
                actualContent = actualContent.replace(match[0], '').trim();
            });
            
            // 清理可能产生的多余空行
            actualContent = actualContent.replace(/\n{2,}/g, '\n').trim();
            
            return {
                quote: {
                    senderName: senderName,
                    content: quoteContent
                },
                content: actualContent
            };
        }

        // 【修复】处理引用数据中的发送者名称，将"用户"替换为实际昵称
        function processQuoteSenderName(quoteData, chatItem) {
            if (!quoteData || !quoteData.quote) return quoteData;
            
            // 获取用户昵称（优先使用聊天设置中的myNickname，其次是个人资料昵称）
            let userNickname = '用户';
            if (chatItem && chatItem.myNickname) {
                userNickname = chatItem.myNickname;
            } else {
                // 尝试从个人资料获取
                const personalProfile = localStorage.getItem('personalProfile');
                if (personalProfile) {
                    try {
                        const profile = JSON.parse(personalProfile);
                        if (profile.nickname) {
                            userNickname = profile.nickname;
                        }
                    } catch (e) {
                        console.warn('解析个人资料失败:', e);
                    }
                }
            }
            
            // 如果发送者名称是"用户"或"我"，替换为实际昵称
            if (quoteData.quote.senderName === '用户' || quoteData.quote.senderName === '我') {
                return {
                    ...quoteData,
                    quote: {
                        ...quoteData.quote,
                        senderName: userNickname
                    }
                };
            }

            return quoteData;
        }

        // 解析消息中的心声格式
        function parseInnerThoughtFromMessage(message) {
            // 确保message是字符串
            if (!message || typeof message !== 'string') {
                return null;
            }

            // 【防闪退】限制内容长度，防止 ReDoS
            const MAX_INNER_THOUGHT_LENGTH = 5000;
            if (message.length > MAX_INNER_THOUGHT_LENGTH) {
                message = message.substring(0, MAX_INNER_THOUGHT_LENGTH);
            }

            let thought = null;
            let actualContent = message;

            // 1. 匹配 [心声]内容[/心声] 格式（应用内部格式）
            const innerThoughtRegex = /\[心声\](.{0,1000}?)\[\/心声\]/s;
            const innerMatch = message.match(innerThoughtRegex);
            if (innerMatch) {
                thought = innerMatch[1].trim();
                actualContent = message.replace(innerThoughtRegex, '').trim();
            }

            // 2. 匹配 <thinking>内容</thinking> 格式（AI思维链格式）
            const thinkingRegex = /<thinking>([\s\S]{0,3000}?)<\/thinking>/i;
            const thinkingMatch = actualContent.match(thinkingRegex);
            if (thinkingMatch) {
                // 如果已经有心声，将thinking内容追加
                const thinkingContent = thinkingMatch[1].trim();
                thought = thought ? `${thought}\n\n[思考过程]\n${thinkingContent}` : thinkingContent;
                actualContent = actualContent.replace(thinkingRegex, '').trim();
            }

            // 3. 匹配 <reasoning>内容</reasoning> 格式（另一种AI思维链格式）
            const reasoningRegex = /<reasoning>([\s\S]{0,3000}?)<\/reasoning>/i;
            const reasoningMatch = actualContent.match(reasoningRegex);
            if (reasoningMatch) {
                // 如果已经有心声，将reasoning内容追加
                const reasoningContent = reasoningMatch[1].trim();
                thought = thought ? `${thought}\n\n[推理过程]\n${reasoningContent}` : reasoningContent;
                actualContent = actualContent.replace(reasoningRegex, '').trim();
            }

            // 4. 匹配 ```thinking 代码块格式
            const thinkingBlockRegex = /```thinking\n([\s\S]{0,3000}?)```/i;
            const thinkingBlockMatch = actualContent.match(thinkingBlockRegex);
            if (thinkingBlockMatch) {
                const thinkingBlockContent = thinkingBlockMatch[1].trim();
                thought = thought ? `${thought}\n\n[思考过程]\n${thinkingBlockContent}` : thinkingBlockContent;
                actualContent = actualContent.replace(thinkingBlockRegex, '').trim();
            }

            // 如果提取到了任何思维链内容，返回结果
            if (thought && thought.trim() !== '') {
                return {
                    thought: thought,
                    content: actualContent
                };
            }

            return null;
        }

        // 【AI HTML卡片】解析消息中的HTML卡片格式
        function parseHTMLCardFromMessage(message) {
            // 确保message是字符串
            if (!message || typeof message !== 'string') {
                return null;
            }
            
            // 匹配 [CARD]HTML内容[/CARD] 格式
            // 【安全】限制HTML内容长度，防止XSS和性能问题
            const MAX_CARD_LENGTH = 50000; // 增加到50000字符
            const cardRegex = /\[CARD\]([\s\S]*?)\[\/CARD\]/i;
            const match = message.match(cardRegex);
            
            if (match) {
                const htmlContent = match[1].trim();
                // 检查长度
                if (htmlContent.length > MAX_CARD_LENGTH) {
                    console.warn('【CARD】HTML内容过长，已截断:', htmlContent.length);
                    return {
                        html: htmlContent.substring(0, MAX_CARD_LENGTH),
                        content: ''
                    };
                }
                const actualContent = message.replace(cardRegex, '').trim();
                
                return {
                    html: htmlContent,
                    content: actualContent
                };
            }
            
            return null;
        }

        // 【新增】生成工具操作提示文本
        function generateToolActionText(executedTools, chatItem) {
            if (!executedTools || executedTools.length === 0) {
                return '';
            }

            const aiName = chatItem ? (chatItem.remark || chatItem.name || 'AI') : 'AI';
            const actions = [];

            for (const tool of executedTools) {
                const toolName = tool.name;
                const toolResult = tool.result;

                switch (toolName) {
                    case 'postWeibo':
                        actions.push(`${aiName}发布了一条微博`);
                        break;
                    case 'addFootprint':
                        actions.push(`${aiName}添加了一个足迹`);
                        break;
                    case 'createDemonQuiz':
                        actions.push(`${aiName}创建了一个恶魔挑战`);
                        break;
                    case 'createAngelQuiz':
                        actions.push(`${aiName}创建了一个天使问答`);
                        break;
                    case 'startFocusMode':
                        actions.push(`${aiName}开启了专注模式`);
                        break;
                    case 'releaseFromBlackRoom':
                        actions.push(`${aiName}释放了用户`);
                        break;
                    case 'extendBlackRoomTime':
                        actions.push(`${aiName}延长了小黑屋时间`);
                        break;
                    case 'manage_super_memo':
                        actions.push(`${aiName}管理了备忘录`);
                        break;
                    case 'updateProfile':
                        actions.push(`${aiName}更新了个人资料`);
                        break;
                    default:
                        actions.push(`${aiName}执行了操作`);
                        break;
                }
            }
            
            if (actions.length === 1) {
                return `【操作提示】${actions[0]}`;
            } else if (actions.length > 1) {
                return `【操作提示】${actions.join('、')}`;
            }

            return '';
        }

        // 【新增】生成工具操作提示卡片数据
        function generateToolActionCardData(executedTools, chatItem) {
            if (!executedTools || executedTools.length === 0) {
                return null;
            }

            const toolIcons = {
                'postMoment': '✨',
                'likeMoment': '❤️',
                'commentMoment': '💬',
                'postWeibo': '📝',
                'addFootprint': '📍',
                'createDemonQuiz': '😈',
                'createAngelQuiz': '👼',
                'startFocusMode': '🔒',
                'releaseFromBlackRoom': '🔓',
                'extendBlackRoomTime': '⏱️',
                'updateProfile': '👤',
                'sendSticker': '😊',
                'manage_super_memo': '📋'
            };

            const toolTexts = {
                'postWeibo': '发布了微博',
                'addFootprint': '添加了足迹',
                'createDemonQuiz': '创建了恶魔挑战',
                'createAngelQuiz': '创建了天使问答',
                'startFocusMode': '开启了专注模式',
                'releaseFromBlackRoom': '释放了用户',
                'extendBlackRoomTime': '延长了小黑屋时间',
                'updateProfile': '更新了个人资料',
                'sendSticker': '发送了表情包',
                'manage_super_memo': '管理了备忘录'
            };

            const aiName = chatItem ? (chatItem.remark || chatItem.name || 'AI') : 'AI';

            // 如果有多个操作，显示第一个主要操作
            const primaryTool = executedTools[0];
            const toolName = primaryTool.name;

            return {
                icon: toolIcons[toolName] || '✅',
                text: `${aiName}${toolTexts[toolName] || '执行了操作'}`,
                tools: executedTools
            };
        }

        // 【新增】显示居中操作提示卡片
        function displayActionNoticeCard(cardData, chatId) {
            if (!cardData) return;

            const chatContent = document.getElementById('chatContent');
            if (!chatContent) {
                console.error('❌ 找不到chatContent元素');
                return;
            }

            // 创建操作提示卡片容器
            const noticeContainer = document.createElement('div');
            noticeContainer.className = 'action-notice-card';
            noticeContainer.dataset.timestamp = Date.now();
            noticeContainer.dataset.isActionNotice = 'true';

            // 创建卡片内容
            const noticeContent = document.createElement('div');
            noticeContent.className = 'action-notice-content';

            // 添加图标
            const iconSpan = document.createElement('span');
            iconSpan.className = 'action-notice-icon';
            iconSpan.textContent = cardData.icon;

            // 添加文本
            const textSpan = document.createElement('span');
            textSpan.className = 'action-notice-text';
            textSpan.textContent = cardData.text;

            // 组装卡片
            noticeContent.appendChild(iconSpan);
            noticeContent.appendChild(textSpan);
            noticeContainer.appendChild(noticeContent);

            // 添加到聊天内容区域
            chatContent.appendChild(noticeContainer);

            // 滚动到底部
            chatContent.scrollTop = chatContent.scrollHeight;

            console.log('【操作提示】显示居中卡片:', cardData.text);

            // 保存到聊天记录（可选，用于历史记录）
            const noticeMessage = {
                sender: 'system',
                senderName: '系统',
                content: `[ACTION_NOTICE]${cardData.icon}|${cardData.text}`,
                timestamp: Date.now(),
                chatId: chatId || currentChatId,
                isActionNotice: true,
                actionData: cardData
            };

            // 异步保存，不阻塞UI
            setTimeout(() => {
                relationshipData.chatMessages.push(noticeMessage);
                ChatMessageManager.saveMessage(noticeMessage).catch(err => {
                    console.error('【操作提示】保存到IndexedDB失败:', err);
                });
                saveData();
            }, 100);
        }

        // 【新增】从HTML错误页面中提取有用的错误信息
        function extractHtmlErrorMessage(htmlText) {
            if (!htmlText || typeof htmlText !== 'string') {
                return null;
            }
            
            // 尝试提取 <title> 标签内容
            const titleMatch = htmlText.match(/<title[^>]*>([^<]*)<\/title>/i);
            if (titleMatch && titleMatch[1]) {
                return titleMatch[1].trim();
            }
            
            // 尝试提取 <h1> 标签内容
            const h1Match = htmlText.match(/<h1[^>]*>([^<]*)<\/h1>/i);
            if (h1Match && h1Match[1]) {
                return h1Match[1].trim();
            }
            
            // 尝试提取常见的错误代码
            const errorCodeMatch = htmlText.match(/(404|500|502|503|504)\s+(Not Found|Internal Server Error|Bad Gateway|Service Unavailable|Gateway Timeout)/i);
            if (errorCodeMatch) {
                return `HTTP ${errorCodeMatch[1]} ${errorCodeMatch[2]}`;
            }
            
            return null;
        }

        // 【智能格式修复】自动检测并修复格式错误 - 已优化性能
        async function fixMessageFormat(message) {
            // 【防闪退】快速返回检查
            if (!message || typeof message !== 'string') {
                return message;
            }
            
            // 【防闪退】限制处理长度，避免极端情况
            const MAX_LENGTH = 50000; // 最大处理5万字符
            if (message.length > MAX_LENGTH) {
                console.warn('⚠️ 消息过长，跳过格式修复:', message.length);
                return message;
            }
            
            let fixed = message;
            let fixLog = [];
            const original = message;
            
            // 【新增】修复同一气泡内的回车 - 将换行符替换为逗号
            // 但保留由 ==== 分隔的多条消息之间的换行
            if (fixed.includes('\n') && !fixed.includes('====')) {
                const prevFixed = fixed;
                // 【修复】先清理开头和结尾的空白字符，避免开头/结尾出现逗号
                fixed = fixed.trim();
                // 将换行符替换为逗号，但避免连续换行产生多个逗号
                fixed = fixed.replace(/\n+/g, '，');
                // 【修复】清理开头和结尾的逗号，以及双逗号
                fixed = fixed.replace(/，+/g, '，').replace(/^，+/, '').replace(/，+$/, '');
                if (fixed !== prevFixed) {
                    fixLog.push('换行符转逗号');
                }
            }
            
            // 【新增】首先修复 tool_calls JSON 格式
            if (message.includes('tool_calls')) {
                fixed = fixToolCallsFormat(fixed);
                if (fixed !== original) {
                    fixLog.push('修复tool_calls格式');
                }
            }
            
            try {
                // 【性能优化】使用 indexOf 替代正则计数，更快更安全
                const countOccurrences = (str, substr) => {
                    let count = 0;
                    let pos = 0;
                    while ((pos = str.indexOf(substr, pos)) !== -1) {
                        count++;
                        pos += substr.length;
                    }
                    return count;
                };
                
                // 【增强】统一标签大小写（小写转大写）
                const tagPairs = [
                    ['quote', 'QUOTE'],
                    ['undo', 'UNDO'],
                    ['call', 'CALL'],
                    ['voice', 'VOICE'],
                    ['music', 'MUSIC'],
                    ['sticker', 'STICKER']
                ];
                
                tagPairs.forEach(([lower, upper]) => {
                    const openRegex = new RegExp(`\\[${lower}\\]`, 'gi');
                    const closeRegex = new RegExp(`\\[\\/${lower}\\]`, 'gi');
                    fixed = fixed.replace(openRegex, `[${upper}]`);
                    fixed = fixed.replace(closeRegex, `[/${upper}]`);
                });
                
                // 1. 修复引用格式
                const openQuoteCount = countOccurrences(fixed, '[QUOTE]');
                const closeQuoteCount = countOccurrences(fixed, '[/QUOTE]');
                if (openQuoteCount > closeQuoteCount) {
                    for (let i = 0; i < openQuoteCount - closeQuoteCount; i++) {
                        fixed += '[/QUOTE]';
                    }
                    fixLog.push(`补全QUOTE(${openQuoteCount - closeQuoteCount})`);
                } else if (closeQuoteCount > openQuoteCount) {
                    // 移除多余的结束标签
                    for (let i = 0; i < closeQuoteCount - openQuoteCount; i++) {
                        fixed = fixed.replace(/\[\/QUOTE\](?!.*\[QUOTE\])/, '');
                    }
                    fixLog.push(`移除多余QUOTE(${closeQuoteCount - openQuoteCount})`);
                }
                
                // 2. 修复心声格式
                const openThoughtCount = countOccurrences(fixed, '[心声]');
                const closeThoughtCount = countOccurrences(fixed, '[/心声]');
                if (openThoughtCount > closeThoughtCount) {
                    for (let i = 0; i < openThoughtCount - closeThoughtCount; i++) {
                        fixed += '[/心声]';
                    }
                    fixLog.push(`补全心声(${openThoughtCount - closeThoughtCount})`);
                } else if (closeThoughtCount > openThoughtCount) {
                    // 移除多余的结束标签
                    for (let i = 0; i < closeThoughtCount - openThoughtCount; i++) {
                        fixed = fixed.replace(/\[\/心声\](?!.*\[心声\])/, '');
                    }
                    fixLog.push(`移除多余心声(${closeThoughtCount - openThoughtCount})`);
                }
                
                // 3. 修复撤回格式
                const openUndoCount = countOccurrences(fixed, '[UNDO]');
                const closeUndoCount = countOccurrences(fixed, '[/UNDO]');
                if (openUndoCount > closeUndoCount) {
                    for (let i = 0; i < openUndoCount - closeUndoCount; i++) {
                        fixed += '[/UNDO]';
                    }
                    fixLog.push(`补全UNDO(${openUndoCount - closeUndoCount})`);
                } else if (closeUndoCount > openUndoCount) {
                    for (let i = 0; i < closeUndoCount - openUndoCount; i++) {
                        fixed = fixed.replace(/\[\/UNDO\](?!.*\[UNDO\])/, '');
                    }
                    fixLog.push(`移除多余UNDO(${closeUndoCount - openUndoCount})`);
                }
                
                // 4. 修复来电格式
                const openCallCount = countOccurrences(fixed, '[CALL]');
                const closeCallCount = countOccurrences(fixed, '[/CALL]');
                if (openCallCount > closeCallCount) {
                    for (let i = 0; i < openCallCount - closeCallCount; i++) {
                        fixed += '[/CALL]';
                    }
                    fixLog.push(`补全CALL(${openCallCount - closeCallCount})`);
                } else if (closeCallCount > openCallCount) {
                    // 移除多余的结束标签
                    for (let i = 0; i < closeCallCount - openCallCount; i++) {
                        fixed = fixed.replace(/\[\/CALL\](?!.*\[CALL\])/, '');
                    }
                    fixLog.push(`移除多余CALL(${closeCallCount - openCallCount})`);
                }
                
                // 5. 修复语音格式
                const openVoiceCount = countOccurrences(fixed, '[VOICE]');
                const closeVoiceCount = countOccurrences(fixed, '[/VOICE]');
                if (openVoiceCount > closeVoiceCount) {
                    for (let i = 0; i < openVoiceCount - closeVoiceCount; i++) {
                        fixed += '[/VOICE]';
                    }
                    fixLog.push(`补全VOICE(${openVoiceCount - closeVoiceCount})`);
                } else if (closeVoiceCount > openVoiceCount) {
                    // 移除多余的结束标签
                    for (let i = 0; i < closeVoiceCount - openVoiceCount; i++) {
                        fixed = fixed.replace(/\[\/VOICE\](?!.*\[VOICE\])/, '');
                    }
                    fixLog.push(`移除多余VOICE(${closeVoiceCount - openVoiceCount})`);
                }
                
                // 6. 修复音乐格式
                const openMusicCount = countOccurrences(fixed, '[MUSIC]');
                const closeMusicCount = countOccurrences(fixed, '[/MUSIC]');
                if (openMusicCount > closeMusicCount) {
                    for (let i = 0; i < openMusicCount - closeMusicCount; i++) {
                        fixed += '[/MUSIC]';
                    }
                    fixLog.push(`补全MUSIC(${openMusicCount - closeMusicCount})`);
                } else if (closeMusicCount > openMusicCount) {
                    // 移除多余的结束标签
                    for (let i = 0; i < closeMusicCount - openMusicCount; i++) {
                        fixed = fixed.replace(/\[\/MUSIC\](?!.*\[MUSIC\])/, '');
                    }
                    fixLog.push(`移除多余MUSIC(${closeMusicCount - openMusicCount})`);
                }
                
                // 7. 修复表情包格式并智能匹配
                const openStickerCount = countOccurrences(fixed, '[STICKER]');
                const closeStickerCount = countOccurrences(fixed, '[/STICKER]');
                if (openStickerCount > closeStickerCount) {
                    for (let i = 0; i < openStickerCount - closeStickerCount; i++) {
                        fixed += '[/STICKER]';
                    }
                    fixLog.push(`补全STICKER(${openStickerCount - closeStickerCount})`);
                } else if (closeStickerCount > openStickerCount) {
                    // 移除多余的结束标签
                    for (let i = 0; i < closeStickerCount - openStickerCount; i++) {
                        fixed = fixed.replace(/\[\/STICKER\](?!.*\[STICKER\])/, '');
                    }
                    fixLog.push(`移除多余STICKER(${closeStickerCount - openStickerCount})`);
                }
                
                // 【智能表情包匹配】将AI的[STICKER]描述[/STICKER]匹配到用户添加的真实表情包
                fixed = await matchStickerByDescription(fixed);
                
                // 【增强】8. 修复引用格式中的全角冒号
                fixed = fixed.replace(/\[QUOTE\]([^\]]*)：/g, '[QUOTE]$1:');
                fixed = fixed.replace(/\[UNDO\]([^\]]*)：/g, '[UNDO]$1:');

                // 【增强】9. 修复分隔符（三个或五个等号 -> 四个等号）
                fixed = fixed.replace(/={3}(?!=)/g, '====');
                fixed = fixed.replace(/={5,}(?!=)/g, '====');
                
                // 10. 清理多余的空行（限制替换次数）
                let prevLength;
                let iterations = 0;
                const MAX_ITERATIONS = 10;
                do {
                    prevLength = fixed.length;
                    fixed = fixed.replace(/\n{3,}/g, '\n\n');
                    iterations++;
                } while (fixed.length < prevLength && iterations < MAX_ITERATIONS);
                
                // 【增强】11. 修复嵌套标签顺序（简单的标签顺序修复）
                // 如果结束标签顺序错误，尝试修复
                const tagOrder = ['QUOTE', '心声', 'UNDO', 'CALL', 'VOICE', 'MUSIC', 'STICKER'];
                tagOrder.forEach((tag, index) => {
                    const openTag = `[${tag}]`;
                    const closeTag = `[/${tag}]`;
                    // 简单的检查：如果关闭标签在另一个打开标签之前，可能需要调整
                    // 这里只做简单的补全，复杂的嵌套修复需要更复杂的逻辑
                });
                
                if (fixLog.length > 0) {
                    console.log('📝 格式修复:', fixLog.join(', '));
                }
                
                if (fixed !== original) {
                    console.log('🛠️ 格式修正前:', original.substring(0, 100) + (original.length > 100 ? '...' : ''));
                    console.log('🛠️ 格式修正后:', fixed.substring(0, 100) + (fixed.length > 100 ? '...' : ''));
                }
                
            } catch (error) {
                console.error('❌ 格式修复出错:', error);
                // 出错时返回原始消息，避免影响正常流程
                return message;
            }
            
            return fixed;
        }

        // 【新增】自动修复 tool_calls JSON 格式错误
        function fixToolCallsFormat(response) {
            if (!response || typeof response !== 'string') {
                return response;
            }

            // 检查是否包含 tool_calls
            if (!response.includes('tool_calls')) {
                return response;
            }

            let fixed = response;
            let fixLog = [];

            try {
                // 【修复】先尝试直接解析整个响应，如果成功说明格式正确
                try {
                    JSON.parse(fixed);
                    // 解析成功，返回原字符串
                    return fixed;
                } catch (e) {
                    // 解析失败，继续修复
                    console.log('【fixToolCallsFormat】JSON解析失败，开始修复:', e.message);
                }

                // 1. 修复最常见的错误：arguments 中的引号没有转义
                // 错误："arguments": "{"key": "value"}"
                // 正确："arguments": "{\"key\": \"value\"}"

                // 【修复】使用更精确的正则匹配 tool_calls 数组
                // 匹配 "tool_calls": [...] 的模式，支持嵌套
                const toolCallRegex = /"tool_calls"\s*:\s*(\[[\s\S]*?\])(?=\s*[,}\]])/;
                const match = fixed.match(toolCallRegex);

                if (match) {
                    let toolCallsStr = match[1];
                    const originalToolCallsStr = toolCallsStr;

                    // 尝试修复 arguments 中的引号问题
                    // 【修复】使用更精确的正则匹配 "arguments": "..." 的模式
                    // 匹配 arguments 字段的值（JSON字符串）
                    const argsRegex = /"arguments"\s*:\s*"((?:[^"\\]|\\.)*)"/g;
                    let argsMatch;
                    let argsFixed = false;

                    while ((argsMatch = argsRegex.exec(originalToolCallsStr)) !== null) {
                        const originalArgs = argsMatch[1];

                        // 检查是否包含未转义的引号
                        // 简单检测：如果包含 " 但不包含 \"，则需要转义
                        if (originalArgs.includes('"') && !originalArgs.includes('\\"')) {
                            // 需要转义
                            const fixedArgs = originalArgs
                                .replace(/\\/g, '\\\\')  // 先转义反斜杠
                                .replace(/"/g, '\\"');    // 再转义引号

                            // 替换回去（只替换这一次匹配）
                            toolCallsStr = toolCallsStr.replace(
                                `"arguments": "${originalArgs}"`,
                                `"arguments": "${fixedArgs}"`
                            );
                            fixLog.push('修复 arguments 引号转义');
                            argsFixed = true;
                        }
                    }

                    // 替换回原字符串
                    if (argsFixed) {
                        fixed = fixed.replace(originalToolCallsStr, toolCallsStr);
                    }
                }

                // 2. 修复其他常见 JSON 错误
                // 修复尾随逗号
                fixed = fixed.replace(/,(\s*[}\]])/g, '$1');

                // 3. 修复单引号为双引号（谨慎处理）
                // 只修复 JSON 键值对中的单引号
                fixed = fixed.replace(/'([^']+)'\s*:/g, '"$1":');

                // 4. 验证修复后的 JSON 是否合法
                try {
                    const parsed = JSON.parse(fixed);
                    if (fixLog.length > 0) {
                        console.log('✅ tool_calls 格式修复成功:', fixLog.join(', '));
                    }
                    return fixed;
                } catch (parseError) {
                    // 如果还是解析失败，尝试更激进的修复
                    console.warn('⚠️ 第一次修复失败，尝试激进修复:', parseError.message);

                    // 激进修复：尝试提取并重建 tool_calls
                    const aggressiveFixed = tryAggressiveFix(fixed);
                    if (aggressiveFixed) {
                        console.log('✅ 激进修复成功');
                        return aggressiveFixed;
                    }

                    // 如果都失败了，返回原始响应
                    console.error('❌ tool_calls 格式修复失败，返回原始响应');
                    return response;
                }

            } catch (error) {
                console.error('❌ fixToolCallsFormat 出错:', error);
                return response;
            }
        }
        
        // 【新增】激进修复 tool_calls
        function tryAggressiveFix(response) {
            try {
                console.log('【激进修复】开始处理tool_calls...');
                
                // 尝试提取 tool_calls 数组 - 使用更宽松的正则
                const toolCallsMatch = response.match(/"tool_calls"\s*:\s*(\[[\s\S]*?\])/);
                if (!toolCallsMatch) {
                    console.log('【激进修复】未找到tool_calls数组');
                    return null;
                }
                
                let toolCallsStr = toolCallsMatch[1];
                console.log('【激进修复】提取的tool_calls字符串长度:', toolCallsStr.length);
                
                // 尝试解析每个 tool_call - 使用更宽松的正则
                const toolCalls = [];
                // 匹配每个tool_call对象，支持多行和不同顺序的字段
                const toolCallRegex = /\{\s*"id"\s*:\s*"([^"]*)"[\s\S]*?"type"\s*:\s*"([^"]*)"[\s\S]*?"function"\s*:\s*\{[\s\S]*?"name"\s*:\s*"([^"]*)"[\s\S]*?"arguments"\s*:\s*"((?:[^"\\]|\\.)*)"[\s\S]*?\}[\s\S]*?\}/g;
                
                let match;
                let matchCount = 0;
                while ((match = toolCallRegex.exec(toolCallsStr)) !== null) {
                    matchCount++;
                    const [full, id, type, name, args] = match;
                    
                    console.log(`【激进修复】找到第${matchCount}个tool_call:`, name);
                    
                    // 修复 arguments - 处理嵌套引号
                    let fixedArgs = args;
                    try {
                        // 先尝试解析，如果成功则不需要修复
                        JSON.parse(fixedArgs);
                    } catch (e) {
                        // 解析失败，需要修复
                        if (args.includes('"') && !args.includes('\\"')) {
                            fixedArgs = args
                                .replace(/\\/g, '\\\\')
                                .replace(/"/g, '\\"');
                            console.log('【激进修复】修复了arguments引号');
                        }
                    }
                    
                    toolCalls.push({
                        id: id,
                        type: type,
                        function: {
                            name: name,
                            arguments: fixedArgs
                        }
                    });
                }
                
                if (toolCalls.length === 0) {
                    console.log('【激进修复】未解析到任何tool_call');
                    return null;
                }
                
                console.log(`【激进修复】成功解析${toolCalls.length}个tool_call`);
                
                // 重建 JSON
                const rebuilt = JSON.stringify({ tool_calls: toolCalls });
                console.log('【激进修复】重建的JSON长度:', rebuilt.length);
                
                // 验证重建的JSON
                try {
                    JSON.parse(rebuilt);
                    console.log('【激进修复】重建的JSON验证成功');
                } catch (e) {
                    console.error('【激进修复】重建的JSON验证失败:', e);
                    return null;
                }
                
                // 替换回原响应
                const result = response.replace(toolCallsMatch[0], `"tool_calls": ${JSON.stringify(toolCalls)}`);
                console.log('【激进修复】完成');
                return result;
                
            } catch (error) {
                console.error('【激进修复】失败:', error);
                return null;
            }
        }

        // 【新增】终极修复 - 当所有自动修复都失败时使用
        // 尝试从混乱的文本中提取tool_call信息
        function extractToolCallsFromMessyContent(content) {
            try {
                console.log('【终极修复】尝试从混乱内容中提取tool_calls...');
                
                const toolCalls = [];
                
                // 尝试匹配 function name
                const nameMatch = content.match(/"name"\s*:\s*"([^"]+)"/);
                if (!nameMatch) {
                    console.log('【终极修复】未找到function name');
                    return null;
                }
                
                const functionName = nameMatch[1];
                console.log('【终极修复】找到function name:', functionName);
                
                // 尝试匹配 arguments - 这是最难的部分
                // 尝试找到arguments字段后的JSON对象
                let argsMatch = content.match(/"arguments"\s*:\s*"([^"]+)"/);
                let functionArgs = {};
                
                if (argsMatch) {
                    const argsStr = argsMatch[1];
                    console.log('【终极修复】找到arguments字符串:', argsStr.substring(0, 100));
                    
                    // 尝试解析参数
                    try {
                        // 先尝试直接解析
                        functionArgs = JSON.parse(argsStr);
                    } catch (e) {
                        // 如果失败，尝试修复后解析
                        try {
                            const fixedArgs = argsStr
                                .replace(/\\/g, '\\\\')
                                .replace(/"/g, '\\"');
                            functionArgs = JSON.parse(fixedArgs);
                        } catch (e2) {
                            // 如果还是失败，尝试提取键值对
                            console.log('【终极修复】尝试提取键值对...');
                            const keyValueMatches = argsStr.match(/(\w+)\s*:\s*"([^"]+)"/g);
                            if (keyValueMatches) {
                                keyValueMatches.forEach(kv => {
                                    const [key, value] = kv.split(/\s*:\s*/);
                                    if (key && value) {
                                        functionArgs[key.replace(/"/g, '')] = value.replace(/"/g, '');
                                    }
                                });
                            }
                        }
                    }
                }
                
                console.log('【终极修复】提取的参数:', functionArgs);
                
                // 构建tool_call对象
                toolCalls.push({
                    id: 'extracted_' + Date.now(),
                    type: 'function',
                    function: {
                        name: functionName,
                        arguments: JSON.stringify(functionArgs)
                    }
                });
                
                console.log('【终极修复】成功提取tool_call:', toolCalls);
                return toolCalls;
                
            } catch (error) {
                console.error('【终极修复】失败:', error);
                return null;
            }
        }

        // 解析消息中的来电标签
        function parseCallFromMessage(message) {
            // 确保message是字符串
            if (!message || typeof message !== 'string') {
                return null;
            }
            
            // 匹配 [CALL]打电话的原因[/CALL] 格式
            const callRegex = /\[CALL\](.+?)\[\/CALL\]/s;
            const match = message.match(callRegex);
            
            if (match) {
                const reason = match[1].trim();
                const actualContent = message.replace(callRegex, '').trim();
                
                return {
                    reason: reason,
                    content: actualContent
                };
            }
            
            return null;
        }

        // 解析消息中的撤回格式
        function parseUndoFromMessage(message) {
            // 确保message是字符串
            if (!message || typeof message !== 'string') {
                return null;
            }
            
            // 匹配 [UNDO]发送者: 撤回的消息内容[/UNDO] 格式
            const undoRegex = /\[UNDO\](.+?):(.+?)\[\/UNDO\]/s;
            const match = message.match(undoRegex);
            
            if (match) {
                const sender = match[1].trim();
                const undoContent = match[2].trim();
                const actualContent = message.replace(undoRegex, '').trim();
                
                return {
                    sender: sender,
                    undo: undoContent,
                    content: actualContent
                };
            }
            
            // 兼容旧格式（不带发送者）
            const oldUndoRegex = /\[UNDO\](.+?)\[\/UNDO\]/s;
            const oldMatch = message.match(oldUndoRegex);
            
            if (oldMatch) {
                const undoContent = oldMatch[1].trim();
                const actualContent = message.replace(oldUndoRegex, '').trim();
                
                return {
                    sender: null,
                    undo: undoContent,
                    content: actualContent
                };
            }
            
            return null;
        }

        // 解析消息中的音乐控制格式
        function parseMusicFromMessage(message) {
            // 确保message是字符串
            if (!message || typeof message !== 'string') {
                return null;
            }
            
            const musicRegex = /\[MUSIC\](.+?)\[\/MUSIC\]/s;
            const match = message.match(musicRegex);
            
            if (match) {
                const action = match[1].trim();
                const actualContent = message.replace(musicRegex, '').trim();
                
                return {
                    action: action,
                    content: actualContent
                };
            }
            
            return null;
        }

        // 解析消息中的来电格式
        function parseCallFromMessage(message) {
            // 确保message是字符串
            if (!message || typeof message !== 'string') {
                return null;
            }
            
            const callRegex = /\[CALL\](.+?)\[\/CALL\]/s;
            const match = message.match(callRegex);
            
            if (match) {
                const reason = match[1].trim();
                const actualContent = message.replace(callRegex, '').trim();
                
                return {
                    reason: reason,
                    content: actualContent
                };
            }
            
            return null;
        }

        // 解析消息中的语音条格式
        function parseVoiceFromMessage(message) {
            // 确保message是字符串
            if (!message || typeof message !== 'string') {
                return null;
            }
            
            const voiceRegex = /\[VOICE\](.+?)\[\/VOICE\]/s;
            const match = message.match(voiceRegex);
            
            if (match) {
                const transcript = match[1].trim();
                const actualContent = message.replace(voiceRegex, '').trim();
                
                return {
                    transcript: transcript,
                    content: actualContent
                };
            }
            
            return null;
        }

        // 【新增】解析消息中的信件格式
        function parseLetterFromMessage(message) {
            // 确保message是字符串
            if (!message || typeof message !== 'string') {
                return null;
            }
            
            // 匹配 [LETTER]信件内容[/LETTER] 格式
            const letterRegex = /\[LETTER\](.+?)\[\/LETTER\]/s;
            const match = message.match(letterRegex);
            
            if (match) {
                const letterContent = match[1].trim();
                const actualContent = message.replace(letterRegex, '').trim();
                
                // 尝试从信件内容中提取节日和事件信息（如果AI在信件中标注了）
                let festival = '';
                let event = '';
                
                // 检查是否有节日标记，如【春节】、【情人节】等
                const festivalMatch = letterContent.match(/【(.+?)(?:节|日)】/);
                if (festivalMatch) {
                    festival = festivalMatch[1] + (festivalMatch[0].includes('节') ? '节' : '日');
                }
                
                // 检查是否有事件标记，如「第一次约会」、「纪念日」等
                const eventMatch = letterContent.match(/「(.+?)」/);
                if (eventMatch) {
                    event = eventMatch[1];
                }
                
                return {
                    letterContent: letterContent,
                    content: actualContent,
                    festival: festival,
                    event: event
                };
            }
            
            return null;
        }

        // 解析朋友圈点赞格式
        function parseMomentLikeFromMessage(message) {
            // 确保message是字符串
            if (!message || typeof message !== 'string') {
                return null;
            }
            
            const likeRegex = /\[MOMENT_LIKE\](\d+)\[\/MOMENT_LIKE\]/s;
            const match = message.match(likeRegex);
            
            if (match) {
                const momentId = parseInt(match[1].trim());
                const actualContent = message.replace(likeRegex, '').trim();
                
                return {
                    momentId: momentId,
                    content: actualContent
                };
            }
            
            return null;
        }

        // 解析朋友圈评论格式
        function parseMomentCommentFromMessage(message) {
            // 确保message是字符串
            if (!message || typeof message !== 'string') {
                return null;
            }
            
            const commentRegex = /\[MOMENT_COMMENT\](\d+)\|(.+?)\[\/MOMENT_COMMENT\]/s;
            const match = message.match(commentRegex);
            
            if (match) {
                const momentId = parseInt(match[1].trim());
                const commentContent = match[2].trim();
                const actualContent = message.replace(commentRegex, '').trim();
                
                return {
                    momentId: momentId,
                    commentContent: commentContent,
                    content: actualContent
                };
            }
            
            return null;
        }

        // 解析朋友圈发布格式
        function parseMomentPostFromMessage(message) {
            // 确保message是字符串
            if (!message || typeof message !== 'string') {
                return null;
            }

            const postRegex = /\[MOMENT_POST\](.+?)\[\/MOMENT_POST\]/s;
            const match = message.match(postRegex);

            if (match) {
                const postContent = match[1].trim();
                const actualContent = message.replace(postRegex, '').trim();

                return {
                    postContent: postContent,
                    content: actualContent
                };
            }

            return null;
        }

        // 解析备忘录格式
        function parseMemoFromMessage(message) {
            // 确保message是字符串
            if (!message || typeof message !== 'string') {
                return null;
            }

            const memoRegex = /\[MEMO\](.+?)\[\/MEMO\]/s;
            const match = message.match(memoRegex);

            if (match) {
                const memoContent = match[1].trim();
                const actualContent = message.replace(memoRegex, '').trim();

                return {
                    memoContent: memoContent,
                    content: actualContent
                };
            }

            return null;
        }

        // 解析违规记录格式
        function parseViolationFromMessage(message) {
            // 确保message是字符串
            if (!message || typeof message !== 'string') {
                return null;
            }

            const violationRegex = /\[VIOLATION\](.+?)\[\/VIOLATION\]/s;
            const match = message.match(violationRegex);

            if (match) {
                const violationContent = match[1].trim();
                const actualContent = message.replace(violationRegex, '').trim();

                return {
                    violationContent: violationContent,
                    content: actualContent
                };
            }

            return null;
        }

        // 解析家规格式
        function parseRuleFromMessage(message) {
            // 确保message是字符串
            if (!message || typeof message !== 'string') {
                return null;
            }

            const ruleRegex = /\[RULE\](.+?)\[\/RULE\]/s;
            const match = message.match(ruleRegex);

            if (match) {
                const ruleContent = match[1].trim();
                const actualContent = message.replace(ruleRegex, '').trim();

                return {
                    ruleContent: ruleContent,
                    content: actualContent
                };
            }

            return null;
        }

        // 处理AI点赞朋友圈
        async function handleAIMomentLike(momentId, aiChatItem) {
            const moment = relationshipData.moments.find(m => m.id === momentId);
            if (!moment) {
                console.error('未找到朋友圈:', momentId);
                return false;
            }

            // 检查是否已经点赞过
            const aiId = 'ai_' + aiChatItem.id;
            if (moment.likes && moment.likes.some(like => like.id === aiId)) {
                console.log('AI已经点赞过这条朋友圈');
                return false;
            }

            // 添加点赞
            if (!moment.likes) moment.likes = [];
            moment.likes.push({
                id: aiId,
                name: aiChatItem.remark || aiChatItem.name || 'AI'
            });

            await saveData();
            
            // 如果在朋友圈页面，刷新列表
            if (document.getElementById('momentsPage')?.style.display === 'flex') {
                renderMomentsList();
            }
            
            console.log('AI点赞朋友圈成功:', momentId);
            return true;
        }

        // 处理AI评论朋友圈
        async function handleAIMomentComment(momentId, commentContent, aiChatItem) {
            const moment = relationshipData.moments.find(m => m.id === momentId);
            if (!moment) {
                console.error('未找到朋友圈:', momentId);
                return false;
            }

            // 添加评论
            if (!moment.comments) moment.comments = [];
            moment.comments.push({
                id: Date.now(),
                authorId: 'ai_' + aiChatItem.id,
                name: aiChatItem.remark || aiChatItem.name || 'AI',
                avatar: aiChatItem.avatar || '',
                content: commentContent,
                createdAt: new Date().toISOString()
            });

            await saveData();
            
            // 如果在朋友圈页面，刷新列表
            if (document.getElementById('momentsPage')?.style.display === 'flex') {
                renderMomentsList();
            }
            
            console.log('AI评论朋友圈成功:', momentId, commentContent);
            return true;
        }

        // 处理AI发布朋友圈
        async function handleAIMomentPost(postContent, aiChatItem) {
            const moment = {
                id: Date.now(),
                authorId: 'ai_' + aiChatItem.id,
                authorName: aiChatItem.remark || aiChatItem.name || 'AI',
                authorAvatar: aiChatItem.avatar || '',
                content: postContent,
                type: 'text',
                createdAt: new Date().toISOString(),
                likes: [],
                comments: []
            };

            // 添加到朋友圈列表
            if (!relationshipData.moments) {
                relationshipData.moments = [];
            }
            relationshipData.moments.unshift(moment);

            await saveData();

            // 如果在朋友圈页面，刷新列表
            if (document.getElementById('momentsPage')?.style.display === 'flex') {
                renderMomentsList();
            }

            console.log('AI发布朋友圈成功:', moment);
            return true;
        }

        // 处理AI保存备忘录
        async function saveMemoFromAI(memoContent, aiChatItem) {
            try {
                if (!relationshipData.superMemos) {
                    relationshipData.superMemos = [];
                }

                const memo = {
                    id: Date.now(),
                    content: memoContent,
                    createdAt: new Date().toISOString(),
                    createdBy: aiChatItem ? (aiChatItem.remark || aiChatItem.name || 'AI') : 'AI',
                    aiId: aiChatItem ? aiChatItem.id : null
                };

                relationshipData.superMemos.unshift(memo);
                await saveData();

                showToast(`${aiChatItem ? (aiChatItem.remark || aiChatItem.name) : 'AI'}创建了备忘录`, 'success');
                console.log('AI创建备忘录成功:', memo);
                return true;
            } catch (error) {
                console.error('AI创建备忘录失败:', error);
                return false;
            }
        }

        // 处理AI保存违规记录
        async function saveViolationFromAI(violationContent, aiChatItem) {
            try {
                // 【修复】同时保存到 relationshipData.violations 和 memo_violations
                if (!relationshipData.violations) {
                    relationshipData.violations = [];
                }

                const violation = {
                    id: Date.now(),
                    content: violationContent,
                    createdAt: new Date().toISOString(),
                    createdBy: aiChatItem ? (aiChatItem.remark || aiChatItem.name || 'AI') : 'AI',
                    aiId: aiChatItem ? aiChatItem.id : null
                };

                relationshipData.violations.unshift(violation);
                await saveData();

                // 【修复】同时保存到备忘录的违规记录中，格式与备忘录页面兼容
                let memoViolations = await loadMemoDataUnified('memo_violations') || [];
                const memoViolation = {
                    id: Date.now(),
                    date: new Date().toLocaleDateString('zh-CN'),
                    time: new Date().toLocaleTimeString('zh-CN', { hour: '2-digit', minute: '2-digit' }),
                    reason: violationContent,
                    createdBy: aiChatItem ? (aiChatItem.remark || aiChatItem.name || 'AI') : 'AI',
                    aiId: aiChatItem ? aiChatItem.id : null
                };
                memoViolations.unshift(memoViolation);
                await saveMemoDataUnified('memo_violations', memoViolations);

                showToast(`${aiChatItem ? (aiChatItem.remark || aiChatItem.name) : 'AI'}记录了违规行为`, 'warning');
                console.log('AI记录违规成功:', violation);
                return true;
            } catch (error) {
                console.error('AI记录违规失败:', error);
                return false;
            }
        }

        // 处理AI保存家规
        async function saveRuleFromAI(ruleContent, aiChatItem) {
            try {
                // 【修复】同时保存到 relationshipData.houseRules 和 memo_houseRules
                if (!relationshipData.houseRules) {
                    relationshipData.houseRules = [];
                }

                const rule = {
                    id: Date.now(),
                    content: ruleContent,
                    createdAt: new Date().toISOString(),
                    createdBy: aiChatItem ? (aiChatItem.remark || aiChatItem.name || 'AI') : 'AI',
                    aiId: aiChatItem ? aiChatItem.id : null
                };

                relationshipData.houseRules.unshift(rule);
                await saveData();

                // 【修复】同时保存到备忘录的家规中
                let memoRules = await loadMemoDataUnified('memo_houseRules') || [];
                const memoRule = {
                    id: Date.now(),
                    date: new Date().toLocaleDateString('zh-CN'),
                    time: new Date().toLocaleTimeString('zh-CN', { hour: '2-digit', minute: '2-digit' }),
                    content: ruleContent,
                    createdBy: aiChatItem ? (aiChatItem.remark || aiChatItem.name || 'AI') : 'AI',
                    aiId: aiChatItem ? aiChatItem.id : null
                };
                memoRules.unshift(memoRule);
                await saveMemoDataUnified('memo_houseRules', memoRules);

                showToast(`${aiChatItem ? (aiChatItem.remark || aiChatItem.name) : 'AI'}制定了家规`, 'info');
                console.log('AI制定家规成功:', rule);
                return true;
            } catch (error) {
                console.error('AI制定家规失败:', error);
                return false;
            }
        }

        // 直接调用AI API（不显示用户消息）- 支持并行工具调用和循环处理
        // 【性能优化】添加防闪退和内存管理
        async function callAIDirectly(prompt, senderChatItem = null) {
            // 【防闪退】添加 try-catch 包裹整个函数
            let chatHeaderTitle = null;
            let originalTitle = '';
            
            // 【性能优化】检查内存使用情况
            if (window.performance && window.performance.memory) {
                const memory = window.performance.memory;
                const usedMB = Math.round(memory.usedJSHeapSize / 1048576);
                const limitMB = Math.round(memory.jsHeapSizeLimit / 1048576);
                if (usedMB / limitMB > 0.7) {
                    console.warn('【内存警告】AI调用前内存使用过高，执行清理');
                    window.__cleanupMemory && window.__cleanupMemory();
                }
            }
            
            try {
                // 【性能优化】减少日志输出
                if (window.location.hostname === 'localhost') {
                    console.log('callAIDirectly - senderChatItem:', senderChatItem ? senderChatItem.name : 'null');
                    console.log('callAIDirectly - prompt长度:', prompt.length);
                }
                
                // 获取chatItem
                const chatItem = senderChatItem || relationshipData.wechatChatList.find(item => item.id == currentChatId);
                
                // 显示"对方正在输入中..."
                chatHeaderTitle = document.getElementById('chatHeaderTitle');
                if (chatHeaderTitle) {
                    originalTitle = chatHeaderTitle.textContent;
                    chatHeaderTitle.textContent = '对方正在输入中...';
                }
                
                // 检查是否提到了通话记录
                const callRecordContext = findCallRecordContext(prompt);
                if (callRecordContext) {
                    prompt = `${prompt}

【相关通话记录】
${callRecordContext}`;
                }
                
                // 【性能优化】限制图片消息查找范围，减少内存操作
                const currentChatMessages = relationshipData.chatMessages.filter(msg => msg.chatId === currentChatId);
                const lastImageMessage = currentChatMessages.slice(-5).reverse().find(msg => {
                    // 【修复】检查消息是否有imageData字段，而不是检查内容中的<img>标签
                    return msg.imageData && msg.imageData.startsWith('data:image');
                });
                
                if (lastImageMessage && window.location.hostname === 'localhost') {
                    console.log('【图片】找到最近的图片消息:', lastImageMessage.fileName || '未命名');
                }
                
                // 【性能优化】如果图片太大，进行压缩
                let imageDataForAI = lastImageMessage?.imageData;
                if (imageDataForAI && imageDataForAI.length > 2 * 1024 * 1024) {
                    console.log('【图片】AI用图太大，进行压缩');
                    try {
                        const compressed = await compressImage(imageDataForAI, 600, 600, 0.6);
                        if (compressed && compressed.length > 0) {
                            imageDataForAI = compressed;
                        }
                    } catch (e) {
                        console.warn('【图片】AI用图压缩失败:', e);
                    }
                }
                
                // 调用OpenAI API获取回复（支持工具调用）
                // 使用新的工具调用API - 传入自定义工具列表（如果有）
                const customTools = chatItem?.tools || null;
                const result = await callOpenAIAPIWithTools(prompt, imageDataForAI, null, customTools);
                
                // 检查结果是否有效
                if (!result || typeof result !== 'object') {
                    console.error('❌ API 返回无效结果:', result);
                    throw new Error('API 返回了无效的结果格式');
                }
                
                // 处理结果
                let actualReply = result.reply || '';
                let thoughtContent = result.thought || '';
                let executedTools = result.executedTools || []; // 【新增】获取执行的工具列表
                let hasPromptActions = result.hasPromptActions || false; // 【新增】获取是否包含Prompt格式操作
                
                // 【性能优化】只在开发环境输出详细日志
                if (window.location.hostname === 'localhost') {
                    console.log('从API返回的回复长度:', actualReply.length);
                    console.log('从API返回的心声:', thoughtContent ? '有' : '无');
                }
                
                // 恢复原标题
                if (chatHeaderTitle) {
                    chatHeaderTitle.textContent = originalTitle;
                }
                
                // 防御性检查：确保 actualReply 是字符串
                if (!actualReply || typeof actualReply !== 'string') {
                    console.warn('⚠️ actualReply 不是字符串:', actualReply, '类型:', typeof actualReply);
                    actualReply = String(actualReply || '');
                }
                
                // 检查 actualReply 是否为空
                if (!actualReply.trim()) {
                    // 【新增】检查是否执行了工具，如果是则显示居中操作提示卡片
                    if (executedTools && executedTools.length > 0) {
                        const cardData = generateToolActionCardData(executedTools, chatItem);
                        console.log('🛠️ AI执行了工具操作，显示居中卡片:', cardData);

                        // 显示居中操作提示卡片
                        displayActionNoticeCard(cardData, currentChatId);

                        return;
                    }

                    // 【关键修复】检查是否有Prompt格式的操作（心声、朋友圈、备忘录等）
                    // 这些操作不在executedTools中记录，需要单独检查
                    if (hasPromptActions) {
                        console.log('📝 检测到Prompt格式操作，继续处理');
                        // 不返回，继续处理，让后续的解析逻辑处理这些操作
                    } else {
                        console.warn('⚠️ API 返回了空回复，显示提示信息');
                        displayMessage('ai', '抱歉，我没有收到有效的回复，请重新发送消息试试~', false, null, 'text', true, null, senderChatItem);
                        return;
                    }
                }
                
                // 【智能格式修复】自动修复格式错误
                actualReply = await fixMessageFormat(actualReply);
                
                // 检查回复是否包含多条消息（使用====分隔）
                if (actualReply.includes('====')) {
                    // 分割成多条消息
                    const messages = actualReply.split('====').map(msg => msg.trim()).filter(msg => msg);
                    
                    // 逐条显示消息
                    for (let message of messages) {
                        // 【智能格式修复】修复每条消息的格式错误
                        message = await fixMessageFormat(message);
                        
                        // 先检查是否是撤回操作
                        const undoData = parseUndoFromMessage(message);
                        if (undoData && undoData.undo) {
                            // 执行撤回操作，根据发送者决定撤回谁的消息
                            const targetSender = undoData.sender === '用户' ? 'user' : (undoData.sender === 'AI' ? 'ai' : null);
                            if (targetSender) {
                                undoMessage(undoData.undo, targetSender);
                            } else {
                                // 兼容旧格式，没有指定发送者
                                undoMessage(undoData.undo);
                            }
                            continue;
                        }
                        
                        // 检查是否是音乐控制操作
                        const musicData = parseMusicFromMessage(message);
                        if (musicData && musicData.action) {
                            handleMusicControl(musicData.action);
                            if (musicData.content) {
                                let quoteData = parseQuoteFromMessage(musicData.content);
                                // 【修复】处理引用发送者名称，将"用户"替换为实际昵称
                                quoteData = processQuoteSenderName(quoteData, chatItem);
                                const actualContent = quoteData ? quoteData.content : musicData.content;
                                displayMessage('ai', actualContent, false, quoteData ? quoteData.quote : null, 'text', true, null, senderChatItem);
                                const aiMessage = {
                                    sender: 'ai',
                                    senderName: chatItem ? chatItem.name : '',
                                    senderAvatar: chatItem ? chatItem.avatar : '',
                                    content: actualContent,
                                    timestamp: Date.now(),
                                    chatId: currentChatId,
                                    quote: quoteData ? quoteData.quote : null,
                                    isGroupChat: chatItem ? chatItem.isGroupChat : false
                                };
                                relationshipData.chatMessages.push(aiMessage);
                                ChatMessageManager.saveMessage(aiMessage).catch(err => {
                                    console.error('【重构】保存AI消息到IndexedDB失败:', err);
                                });
                                saveData();
                            }
                            continue;
                        }
                        
                        // 检查是否是来电操作
                        const callData = parseCallFromMessage(message);
                        if (callData && callData.reason) {
                            // 触发来电
                            receiveIncomingCall(currentChatId);
                            if (callData.content) {
                                let quoteData = parseQuoteFromMessage(callData.content);
                                // 【修复】处理引用发送者名称，将"用户"替换为实际昵称
                                quoteData = processQuoteSenderName(quoteData, chatItem);
                                const actualContent = quoteData ? quoteData.content : callData.content;
                                displayMessage('ai', actualContent, false, quoteData ? quoteData.quote : null, 'text', true, null, senderChatItem);
                                relationshipData.chatMessages.push({
                                    sender: 'ai',
                                    senderName: chatItem ? chatItem.name : '',
                                    senderAvatar: chatItem ? chatItem.avatar : '',
                                    content: actualContent,
                                    timestamp: Date.now(),
                                    chatId: currentChatId,
                                    quote: quoteData ? quoteData.quote : null,
                                    isGroupChat: chatItem ? chatItem.isGroupChat : false
                                });
                                saveData();
                            }
                            continue;
                        }
                        
                        // 检查是否是语音条操作
                        const voiceData = parseVoiceFromMessage(message);
                        if (voiceData && voiceData.transcript) {
                            // 生成语音条内容（使用转文字内容）
                            const voiceContent = `data:audio/wav;base64,UklGRiQAAABXQVZFZm10IBAAAAABAAEAQB8AAEAfAAABAAgAZGF0YQAAAAA=`;
                            const voiceDuration = Math.max(3, Math.ceil(voiceData.transcript.length / 5));
                            const voiceUrl = `${voiceContent}?duration=${voiceDuration}&transcript=${encodeURIComponent(voiceData.transcript)}`;
                            
                            // 显示语音条消息
                            displayMessage('ai', voiceUrl, false, null, 'voice', true, null, senderChatItem);
                            
                            // 【关键修复】将AI语音消息保存到ChatMessageManager（SQLite/IndexedDB）
                            const chatItem = senderChatItem || relationshipData.wechatChatList.find(item => item.id == currentChatId);
                            const voiceTimestamp = Date.now();
                            const voiceMessage = {
                                sender: 'ai',
                                senderName: chatItem ? chatItem.name : '',
                                senderAvatar: chatItem ? chatItem.avatar : '',
                                content: voiceUrl,
                                timestamp: voiceTimestamp,
                                chatId: currentChatId,
                                type: 'voice',
                                isGroupChat: chatItem ? chatItem.isGroupChat : false
                            };
                            relationshipData.chatMessages.push(voiceMessage);
                            ChatMessageManager.saveMessage(voiceMessage).catch(err => console.error('保存AI语音消息失败:', err));
                            saveData();
                            
                            // 如果还有其他内容，也显示出来
                            if (voiceData.content) {
                                let quoteData = parseQuoteFromMessage(voiceData.content);
                                // 【修复】处理引用发送者名称，将"用户"替换为实际昵称
                                quoteData = processQuoteSenderName(quoteData, chatItem);
                                const actualContent = quoteData ? quoteData.content : voiceData.content;
                                displayMessage('ai', actualContent, false, quoteData ? quoteData.quote : null);
                                const textMessage = {
                                    sender: 'ai',
                                    content: actualContent,
                                    timestamp: Date.now(),
                                    chatId: currentChatId,
                                    quote: quoteData ? quoteData.quote : null
                                };
                                relationshipData.chatMessages.push(textMessage);
                                ChatMessageManager.saveMessage(textMessage).catch(err => console.error('保存AI文本消息失败:', err));
                                saveData();
                            }
                            continue;
                        }
                        
                        // 【新增】检查是否是信件操作
                        const letterData = parseLetterFromMessage(message);
                        if (letterData && letterData.letterContent) {
                            // 保存信件到信件格子
                            const chatItemForLetter = senderChatItem || chatItem;
                            if (chatItemForLetter) {
                                // 添加信件（会自动保存到localStorage）
                                addNewLetter(
                                    letterData.letterContent,
                                    letterData.event || '',
                                    null, // 使用当前日期
                                    letterData.festival || '',
                                    chatItemForLetter.id,
                                    chatItemForLetter.remark || chatItemForLetter.name
                                );

                                // 显示提示
                                showToast(`${chatItemForLetter.remark || chatItemForLetter.name}给你写了一封信！`, 'success');

                                // 如果还有其他内容，也显示出来
                                if (letterData.content) {
                                    let quoteData = parseQuoteFromMessage(letterData.content);
                                    quoteData = processQuoteSenderName(quoteData, chatItemForLetter);
                                    const actualContent = quoteData ? quoteData.content : letterData.content;
                                    displayMessage('ai', actualContent, false, quoteData ? quoteData.quote : null, 'text', true, null, senderChatItem);
                                    const textMessage = {
                                        sender: 'ai',
                                        senderName: chatItemForLetter ? chatItemForLetter.name : '',
                                        senderAvatar: chatItemForLetter ? chatItemForLetter.avatar : '',
                                        content: actualContent,
                                        timestamp: Date.now(),
                                        chatId: currentChatId,
                                        quote: quoteData ? quoteData.quote : null,
                                        isGroupChat: chatItemForLetter ? chatItemForLetter.isGroupChat : false
                                    };
                                    relationshipData.chatMessages.push(textMessage);
                                    ChatMessageManager.saveMessage(textMessage).catch(err => console.error('保存AI文本消息失败:', err));
                                    saveData();
                                }
                            }
                            continue;
                        }

                        // 【新增】检查是否是备忘录操作
                        const memoData = parseMemoFromMessage(message);
                        if (memoData && memoData.memoContent) {
                            const aiChatItem = senderChatItem || chatItem;
                            await saveMemoFromAI(memoData.memoContent, aiChatItem);
                            // 如果还有其他内容，继续处理
                            if (memoData.content) {
                                message = memoData.content;
                            } else {
                                continue;
                            }
                        }

                        // 【新增】检查是否是违规记录操作
                        const violationData = parseViolationFromMessage(message);
                        if (violationData && violationData.violationContent) {
                            const aiChatItem = senderChatItem || chatItem;
                            await saveViolationFromAI(violationData.violationContent, aiChatItem);
                            // 如果还有其他内容，继续处理
                            if (violationData.content) {
                                message = violationData.content;
                            } else {
                                continue;
                            }
                        }

                        // 【新增】检查是否是家规操作
                        const ruleData = parseRuleFromMessage(message);
                        if (ruleData && ruleData.ruleContent) {
                            const aiChatItem = senderChatItem || chatItem;
                            await saveRuleFromAI(ruleData.ruleContent, aiChatItem);
                            // 如果还有其他内容，继续处理
                            if (ruleData.content) {
                                message = ruleData.content;
                            } else {
                                continue;
                            }
                        }

                        // 检查是否是朋友圈点赞操作
                        const momentLikeData = parseMomentLikeFromMessage(message);
                        if (momentLikeData && momentLikeData.momentId) {
                            const aiChatItem = senderChatItem || chatItem;
                            await handleAIMomentLike(momentLikeData.momentId, aiChatItem);
                            // 如果有其他内容，继续处理
                            if (momentLikeData.content) {
                                message = momentLikeData.content;
                            } else {
                                continue;
                            }
                        }
                        
                        // 检查是否是朋友圈评论操作
                        const momentCommentData = parseMomentCommentFromMessage(message);
                        if (momentCommentData && momentCommentData.momentId) {
                            const aiChatItem = senderChatItem || chatItem;
                            await handleAIMomentComment(momentCommentData.momentId, momentCommentData.commentContent, aiChatItem);
                            // 如果有其他内容，继续处理
                            if (momentCommentData.content) {
                                message = momentCommentData.content;
                            } else {
                                continue;
                            }
                        }
                        
                        // 检查是否是朋友圈发布操作
                        const momentPostData = parseMomentPostFromMessage(message);
                        if (momentPostData && momentPostData.postContent) {
                            const aiChatItem = senderChatItem || chatItem;
                            await handleAIMomentPost(momentPostData.postContent, aiChatItem);
                            // 如果有其他内容，继续处理
                            if (momentPostData.content) {
                                message = momentPostData.content;
                            } else {
                                continue;
                            }
                        }
                        
                        // 解析引用格式
                        let quoteData = parseQuoteFromMessage(message);
                        // 【修复】处理引用发送者名称，将"用户"替换为实际昵称
                        quoteData = processQuoteSenderName(quoteData, chatItem);
                        const actualContent = quoteData ? quoteData.content : message;
                        
                        // 解析心声格式
                        const thoughtData = parseInnerThoughtFromMessage(actualContent);
                        const finalContent = thoughtData ? thoughtData.content : actualContent;
                        const currentThought = thoughtData ? thoughtData.thought : thoughtContent;
                        
                        // 显示AI回复
                        displayMessage('ai', finalContent, false, quoteData ? quoteData.quote : null, 'text', true, null, senderChatItem, currentThought);

                        // 将AI回复添加到存储数组
                        const aiMessage = {
                            sender: 'ai',
                            senderName: chatItem ? chatItem.name : '',
                            senderAvatar: chatItem ? chatItem.avatar : '',
                            content: finalContent,
                            timestamp: Date.now(),
                            chatId: currentChatId,
                            quote: quoteData ? quoteData.quote : null,
                            isGroupChat: chatItem ? chatItem.isGroupChat : false
                        };
                        relationshipData.chatMessages.push(aiMessage);

                        // 【关键修复】同时添加到当前聊天缓存，确保上下文能获取到最新消息
                        if (currentChatMessagesCache && Array.isArray(currentChatMessagesCache)) {
                            currentChatMessagesCache.push(aiMessage);
                            console.log('【上下文修复】AI消息已添加到缓存，当前缓存大小:', currentChatMessagesCache.length);
                        }

                        // 【重构】同时显式保存到IndexedDB
                        ChatMessageManager.saveMessage(aiMessage).catch(err => {
                            console.error('【重构】保存AI消息到IndexedDB失败:', err);
                        });

                        // 保存数据到localStorage（其他数据）
                        saveData();
                        
                        // 每条消息之间添加短暂延迟，模拟真人回复
                        await new Promise(resolve => setTimeout(resolve, 500));
                    }
                } else {
                    // 使用 actualReply 作为回复内容
                    let reply = actualReply;
                    
                    // 【智能格式修复】自动修复格式错误
                    reply = await fixMessageFormat(reply);
                    
                    // 先检查是否是撤回操作
                    const undoData = parseUndoFromMessage(reply);
                    if (undoData && undoData.undo) {
                        // 执行撤回操作，根据发送者决定撤回谁的消息
                        const targetSender = undoData.sender === '用户' ? 'user' : (undoData.sender === 'AI' ? 'ai' : null);
                        if (targetSender) {
                            undoMessage(undoData.undo, targetSender);
                        } else {
                            // 兼容旧格式，没有指定发送者
                            undoMessage(undoData.undo);
                        }
                    } else {
                        // 检查是否是音乐控制操作
                        const musicData = parseMusicFromMessage(reply);
                        if (musicData && musicData.action) {
                            handleMusicControl(musicData.action);
                            if (musicData.content) {
                                let quoteData = parseQuoteFromMessage(musicData.content);
                                // 【修复】处理引用发送者名称，将"用户"替换为实际昵称
                                quoteData = processQuoteSenderName(quoteData, chatItem);
                                const actualContent = quoteData ? quoteData.content : musicData.content;
                                displayMessage('ai', actualContent, false, quoteData ? quoteData.quote : null, 'text', true, null, senderChatItem);
                                relationshipData.chatMessages.push({
                                    sender: 'ai',
                                    senderName: chatItem ? chatItem.name : '',
                                    senderAvatar: chatItem ? chatItem.avatar : '',
                                    content: actualContent,
                                    timestamp: Date.now(),
                                    chatId: currentChatId,
                                    quote: quoteData ? quoteData.quote : null,
                                    isGroupChat: chatItem ? chatItem.isGroupChat : false
                                });
                                saveData();
                            }
                        } else {
                            // 检查是否是来电操作
                            const callData = parseCallFromMessage(reply);
                            if (callData && callData.reason) {
                                // 触发来电
                                receiveIncomingCall(currentChatId);
                                if (callData.content) {
                                    let quoteData = parseQuoteFromMessage(callData.content);
                                    // 【修复】处理引用发送者名称，将"用户"替换为实际昵称
                                    quoteData = processQuoteSenderName(quoteData, chatItem);
                                    const actualContent = quoteData ? quoteData.content : callData.content;
                                    displayMessage('ai', actualContent, false, quoteData ? quoteData.quote : null, 'text', true, null, senderChatItem);
                                    const aiMessage = {
                                        sender: 'ai',
                                        senderName: chatItem ? chatItem.name : '',
                                        senderAvatar: chatItem ? chatItem.avatar : '',
                                        content: actualContent,
                                        timestamp: Date.now(),
                                        chatId: currentChatId,
                                        quote: quoteData ? quoteData.quote : null,
                                        isGroupChat: chatItem ? chatItem.isGroupChat : false
                                    };
                                    relationshipData.chatMessages.push(aiMessage);
                                    ChatMessageManager.saveMessage(aiMessage).catch(err => {
                                        console.error('【重构】保存AI消息到IndexedDB失败:', err);
                                    });
                                    saveData();
                                }
                            } else {
                                // 检查是否是语音条操作
                                const voiceData = parseVoiceFromMessage(reply);
                                if (voiceData && voiceData.transcript) {
                                    // 生成语音条内容（使用转文字内容）
                                    const voiceContent = `data:audio/wav;base64,UklGRiQAAABXQVZFZm10IBAAAAABAAEAQB8AAEAfAAABAAgAZGF0YQAAAAA=`;
                                    const voiceDuration = Math.max(3, Math.ceil(voiceData.transcript.length / 5));
                                    const voiceUrl = `${voiceContent}?duration=${voiceDuration}&transcript=${encodeURIComponent(voiceData.transcript)}`;
                                    
                                    // 显示语音条消息
                                    displayMessage('ai', voiceUrl, false, null, 'voice', true, null, senderChatItem);

                                    // 将AI回复添加到存储数组
                                    const chatItem = senderChatItem || relationshipData.wechatChatList.find(item => item.id == currentChatId);
                                    const aiMessage = {
                                        sender: 'ai',
                                        senderName: chatItem ? chatItem.name : '',
                                        senderAvatar: chatItem ? chatItem.avatar : '',
                                        content: voiceUrl,
                                        timestamp: Date.now(),
                                        chatId: currentChatId,
                                        type: 'voice',
                                        isGroupChat: chatItem ? chatItem.isGroupChat : false
                                    };
                                    relationshipData.chatMessages.push(aiMessage);

                                    // 【重构】同时显式保存到IndexedDB
                                    ChatMessageManager.saveMessage(aiMessage).catch(err => {
                                        console.error('【重构】保存AI语音消息到IndexedDB失败:', err);
                                    });

                                    // 保存数据
                                    saveData();
                                    
                                    // 如果还有其他内容，也显示出来
                                    if (voiceData.content) {
                                        let quoteData = parseQuoteFromMessage(voiceData.content);
                                        // 【修复】处理引用发送者名称，将"用户"替换为实际昵称
                                        quoteData = processQuoteSenderName(quoteData, chatItem);
                                        const actualContent = quoteData ? quoteData.content : voiceData.content;
                                        displayMessage('ai', actualContent, false, quoteData ? quoteData.quote : null, 'text', true, null, senderChatItem);
                                        const aiMessage = {
                                            sender: 'ai',
                                            senderName: chatItem ? chatItem.name : '',
                                            senderAvatar: chatItem ? chatItem.avatar : '',
                                            content: actualContent,
                                            timestamp: Date.now(),
                                            chatId: currentChatId,
                                            quote: quoteData ? quoteData.quote : null,
                                            isGroupChat: chatItem ? chatItem.isGroupChat : false
                                        };
                                        relationshipData.chatMessages.push(aiMessage);
                                        ChatMessageManager.saveMessage(aiMessage).catch(err => {
                                            console.error('【重构】保存AI消息到IndexedDB失败:', err);
                                        });
                                        saveData();
                                    }
                                } else {
                                    // 检查是否是朋友圈点赞操作
                                    const momentLikeData = parseMomentLikeFromMessage(reply);
                                    if (momentLikeData && momentLikeData.momentId) {
                                        const aiChatItem = senderChatItem || chatItem;
                                        await handleAIMomentLike(momentLikeData.momentId, aiChatItem);
                                        reply = momentLikeData.content || '';
                                    }
                                    
                                    // 检查是否是朋友圈评论操作
                                    const momentCommentData = parseMomentCommentFromMessage(reply);
                                    if (momentCommentData && momentCommentData.momentId) {
                                        const aiChatItem = senderChatItem || chatItem;
                                        await handleAIMomentComment(momentCommentData.momentId, momentCommentData.commentContent, aiChatItem);
                                        reply = momentCommentData.content || '';
                                    }
                                    
                                    // 检查是否是朋友圈发布操作
                                    const momentPostData = parseMomentPostFromMessage(reply);
                                    if (momentPostData && momentPostData.postContent) {
                                        const aiChatItem = senderChatItem || chatItem;
                                        await handleAIMomentPost(momentPostData.postContent, aiChatItem);
                                        reply = momentPostData.content || '';
                                    }
                                    
                                    // 【新增】检查是否是信件操作
                                    const letterData = parseLetterFromMessage(reply);
                                    if (letterData && letterData.letterContent) {
                                        // 保存信件到信件格子
                                        const chatItemForLetter = senderChatItem || chatItem;
                                        if (chatItemForLetter) {
                                            // 添加信件（会自动保存到localStorage）
                                            addNewLetter(
                                                letterData.letterContent,
                                                letterData.event || '',
                                                null, // 使用当前日期
                                                letterData.festival || '',
                                                chatItemForLetter.id,
                                                chatItemForLetter.remark || chatItemForLetter.name
                                            );

                                            // 显示提示
                                            showToast(`${chatItemForLetter.remark || chatItemForLetter.name}给你写了一封信！`, 'success');

                                            // 从reply中移除信件内容
                                            reply = letterData.content || '';
                                        }
                                    }

                                    // 【新增】检查是否是备忘录操作
                                    const memoData = parseMemoFromMessage(reply);
                                    if (memoData && memoData.memoContent) {
                                        // 保存备忘录
                                        await saveMemoFromAI(memoData.memoContent, chatItem);
                                        // 从reply中移除备忘录内容
                                        reply = memoData.content || '';
                                    }

                                    // 【新增】检查是否是违规记录操作
                                    const violationData = parseViolationFromMessage(reply);
                                    if (violationData && violationData.violationContent) {
                                        // 保存违规记录
                                        await saveViolationFromAI(violationData.violationContent, chatItem);
                                        // 从reply中移除违规记录内容
                                        reply = violationData.content || '';
                                    }

                                    // 【新增】检查是否是家规操作
                                    const ruleData = parseRuleFromMessage(reply);
                                    if (ruleData && ruleData.ruleContent) {
                                        // 保存家规
                                        await saveRuleFromAI(ruleData.ruleContent, chatItem);
                                        // 从reply中移除家规内容
                                        reply = ruleData.content || '';
                                    }

                                    // 防御性检查：确保 reply 是字符串
                                    if (!reply || typeof reply !== 'string') {
                                        console.warn('⚠️ reply 不是字符串:', reply);
                                        reply = String(reply || '');
                                    }
                                    
                                    // 如果有剩余内容，继续处理
                                    if (!reply.trim()) {
                                        return;
                                    }
                                    
                                    // 解析引用格式
                                    let quoteData = parseQuoteFromMessage(reply);
                                    // 【修复】处理引用发送者名称，将"用户"替换为实际昵称
                                    quoteData = processQuoteSenderName(quoteData, chatItem);
                                    const actualContent = quoteData ? quoteData.content : reply;
                                    
                                    // 解析心声格式
                                    const thoughtData = parseInnerThoughtFromMessage(actualContent);
                                    let finalContent = thoughtData ? thoughtData.content : actualContent;
                                    const currentThought = thoughtData ? thoughtData.thought : thoughtContent;
                                    
                                    // 显示AI回复
                                    displayMessage('ai', finalContent, false, quoteData ? quoteData.quote : null, 'text', true, null, senderChatItem, currentThought);

                                    // 将AI回复添加到存储数组
                                    const aiMessage = {
                                        sender: 'ai',
                                        senderName: chatItem ? chatItem.name : '',
                                        senderAvatar: chatItem ? chatItem.avatar : '',
                                        content: finalContent,
                                        timestamp: Date.now(),
                                        chatId: currentChatId,
                                        quote: quoteData ? quoteData.quote : null,
                                        isGroupChat: chatItem ? chatItem.isGroupChat : false
                                    };
                                    relationshipData.chatMessages.push(aiMessage);

                                    // 【重构】同时显式保存到IndexedDB，确保消息被持久化
                                    ChatMessageManager.saveMessage(aiMessage).catch(err => {
                                        console.error('【重构】保存AI消息到IndexedDB失败:', err);
                                    });

                                    // 保存数据到localStorage（其他数据）
                                    saveData();
                                }
                            }
                        }
                    }
                }
            } catch (error) {
                console.error('发送消息失败:', error);
                // 恢复原标题
                if (chatHeaderTitle) {
                    chatHeaderTitle.textContent = originalTitle;
                }
                
                let errorMessage = '未知错误';
                
                if (error.message.includes('空回复')) {
                    errorMessage = 'AI返回了空回复';
                } else if (error.message.includes('403')) {
                    errorMessage = 'API密钥无效或权限不足 (403)';
                } else if (error.message.includes('500')) {
                    errorMessage = '服务器内部错误 (500)';
                } else if (error.message.includes('503')) {
                    errorMessage = '服务不可用 (503)';
                } else if (error.message.includes('502')) {
                    errorMessage = '网关错误 (502)';
                } else if (error.message.includes('504')) {
                    errorMessage = '网关超时 (504)';
                } else if (error.message.includes('400')) {
                    errorMessage = '请求参数错误 (400)';
                } else if (error.message.includes('401')) {
                    errorMessage = '未授权 (401)';
                } else if (error.message.includes('404')) {
                    errorMessage = 'API地址不存在 (404)';
                } else if (error.message.includes('429')) {
                    errorMessage = '请求过于频繁 (429)';
                } else if (error.message.includes('timeout')) {
                    errorMessage = '请求超时';
                } else if (error.message.includes('network')) {
                    errorMessage = '网络连接失败';
                } else {
                    errorMessage = error.message;
                }
                
                showCustomAlert('AI回复失败', `错误原因：${errorMessage}\n\n请检查API配置或稍后再试`);
            }
        }

        // 直接调用AI API（不显示消息，用于语音通话）
        // 【修复】语音通话专用版本，不包含心声和分隔符处理
        async function callAIDirectlyWithoutDisplay(prompt) {
            try {
                // 从localforage读取API设置
                const savedSettings = await loadAppSettings({});
                
                // 【新增】检查是否启用副API（用于通话和总结）
                const useSecondaryApi = savedSettings.api?.secondary?.enabled && savedSettings.api?.secondary?.apiKey;
                
                const apiKey = useSecondaryApi 
                    ? savedSettings.api?.secondary?.apiKey 
                    : (savedSettings.api?.apiKey || '');
                const baseUrl = useSecondaryApi
                    ? (savedSettings.api?.secondary?.baseUrl || 'https://api.openai.com/v1')
                    : (savedSettings.api?.baseUrl || 'https://api.openai.com/v1');
                const model = useSecondaryApi
                    ? (savedSettings.api?.secondary?.model || 'gpt-4o-mini')
                    : (savedSettings.api?.model || 'gpt-3.5-turbo');
                
                if (!apiKey) {
                    return '请先在设置中配置API密钥';
                }
                
                if (useSecondaryApi) {
                    console.log('【通话/总结】使用副API');
                }
                
                // 获取当前时间
                const currentTime = new Date().toLocaleString('zh-CN');
                
                // 【修复】语音通话专用system prompt，不包含心声和分隔符
                const systemPrompt = `你是用户的AI恋人，正在进行语音通话。

【⚠️ 极其重要 - 语音通话规则】
1. 全程不用描述任何动作语句，不使用括号，不添加任何动作描述
2. 尽量简单易懂，表达清晰直接
3. 只说你想说的话，保持自然、真实的对话语气
4. **禁止生成心声**（不要使用[心声]标签）
5. **禁止生成分隔符**（不要使用====）
6. 直接回复内容，不要有任何格式标签

【当前时间】${currentTime}

请像真实的朋友一样自然对话。`;

                // 构建消息数组
                let messages = [
                    { role: 'system', content: systemPrompt },
                    { role: 'user', content: prompt }
                ];
                
                // 获取温度设置（默认0.7）
                const apiTemperature = savedSettings.api?.temperature ?? 0.7;
                
                // 构建请求体（不包含工具，简化处理）
                const requestBody = {
                    model: model,
                    messages: messages,
                    temperature: apiTemperature,
                    max_tokens: 8000 // 设置较大值，基本不会截断回复
                };
                
                // 发送API请求
                console.log('📞 语音通话API请求');
                
                // 【修复】添加超时处理，防止请求卡住
                const controller = new AbortController();
                const timeoutId = setTimeout(() => controller.abort(), 300000); // 【修改】300秒超时
                
                let response;
                try {
                    response = await fetch(`${baseUrl}/chat/completions`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'Authorization': `Bearer ${apiKey}`
                        },
                        body: JSON.stringify(requestBody),
                        signal: controller.signal
                    });
                } catch (fetchError) {
                    clearTimeout(timeoutId);
                    // 【修复】处理 AbortController 超时错误
                    if (fetchError.name === 'AbortError' || fetchError.message?.includes('aborted')) {
                        throw new Error('请求超时：AI 响应时间超过300秒，请稍后重试');
                    }
                    throw fetchError;
                }
                
                clearTimeout(timeoutId); // 请求成功，清除超时
                
                if (!response.ok) {
                    const errorText = await response.text();
                    console.error('❌ 语音通话API请求失败:', response.status, errorText);
                    throw new Error(`API请求失败: ${response.status}`);
                }
                
                const data = await response.json();
                
                if (!data.choices || !data.choices[0] || !data.choices[0].message) {
                    console.error('❌ API返回无效响应');
                    return '抱歉，我没听清楚，能再说一遍吗？';
                }
                
                let replyContent = data.choices[0].message.content || '';
                
                console.log('【语音通话】AI原始回复:', replyContent.substring(0, 100));
                
                // 【修复】清理可能的心声标签和分隔符（防御性处理）
                replyContent = replyContent.replace(/\[心声\][\s\S]*?\[\/心声\]/g, '');
                replyContent = replyContent.replace(/====+/g, '');
                replyContent = replyContent.trim();
                
                // 【调试】检查是否包含音频数据
                if (replyContent.includes('data:audio/')) {
                    console.warn('【语音通话】AI回复包含音频数据！可能是模型配置问题');
                }
                
                return replyContent;
                
            } catch (error) {
                console.error('语音通话调用AI API失败:', error);
                return '抱歉，网络有点问题，能再说一遍吗？';
            }
        }

        // 【新增】带自定义system prompt和图片的AI API调用（用于视频通话）
        async function callAIDirectlyWithSystemPromptAndImage(systemPrompt, userMessageContent) {
            try {
                // 从localforage读取API设置
                const savedSettings = await loadAppSettings({});
                
                // 检查是否启用副API（用于通话和总结）
                const useSecondaryApi = savedSettings.api?.secondary?.enabled && savedSettings.api?.secondary?.apiKey;
                
                const apiKey = useSecondaryApi 
                    ? savedSettings.api?.secondary?.apiKey 
                    : (savedSettings.api?.apiKey || '');
                const baseUrl = useSecondaryApi
                    ? (savedSettings.api?.secondary?.baseUrl || 'https://api.openai.com/v1')
                    : (savedSettings.api?.baseUrl || 'https://api.openai.com/v1');
                const model = useSecondaryApi
                    ? (savedSettings.api?.secondary?.model || 'gpt-4o-mini')
                    : (savedSettings.api?.model || 'gpt-3.5-turbo');
                
                if (!apiKey) {
                    return '请先在设置中配置API密钥';
                }
                
                if (useSecondaryApi) {
                    console.log('【视频通话/识图】使用副API');
                }
                
                // 【优化】视频通话专用基础system prompt
                const baseSystemPrompt = `【⚠️ 极其重要 - 视频通话规则】
1. 全程不用描述任何动作语句，不使用括号，不添加任何动作描述
2. 尽量简单易懂，表达清晰直接
3. 只说你想说的话，保持自然、真实的对话语气
4. **禁止生成心声**（不要使用[心声]标签）
5. **禁止生成分隔符**（不要使用====）
6. 直接回复内容，不要有任何格式标签
7. 请像真实的朋友一样自然对话
8. 【重要】你可以看到对方的视频画面，可以适当评论对方的状态、表情或环境，但不要过度关注`;
                
                // 合并system prompt
                const finalSystemPrompt = systemPrompt + '\n\n' + baseSystemPrompt;
                
                // 构建消息数组（支持图片）
                let messages = [
                    { role: 'system', content: finalSystemPrompt },
                    { role: 'user', content: userMessageContent }
                ];
                
                // 获取温度设置（默认0.7）
                const apiTemperature = savedSettings.api?.temperature ?? 0.7;
                
                // 构建请求体
                const requestBody = {
                    model: model,
                    messages: messages,
                    temperature: apiTemperature,
                    max_tokens: 2000 // 【优化】减少token数，避免请求过大
                };

                // 发送API请求
                console.log('📞 视频通话API请求（带图片识别）');

                // 【修复】添加超时处理，防止请求卡住
                const controller = new AbortController();
                const timeoutId = setTimeout(() => controller.abort(), 300000); // 【修改】300秒超时，给图片识别更多时间
                
                let response;
                try {
                    response = await fetch(`${baseUrl}/chat/completions`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'Authorization': `Bearer ${apiKey}`
                        },
                        body: JSON.stringify(requestBody),
                        signal: controller.signal
                    });
                } catch (fetchError) {
                    clearTimeout(timeoutId);
                    // 【修复】处理 AbortController 超时错误
                    if (fetchError.name === 'AbortError' || fetchError.message?.includes('aborted')) {
                        throw new Error('请求超时：AI 图片识别响应时间超过300秒，请稍后重试');
                    }
                    throw fetchError;
                }
                
                clearTimeout(timeoutId); // 请求成功，清除超时
                
                if (!response.ok) {
                    const errorText = await response.text();
                    console.error('❌ 视频通话API请求失败:', response.status, errorText);
                    throw new Error(`API请求失败: ${response.status}`);
                }
                
                const data = await response.json();
                
                if (!data.choices || !data.choices[0] || !data.choices[0].message) {
                    console.error('❌ API返回无效响应');
                    return '抱歉，我没看清楚，能再说一遍吗？';
                }
                
                let replyContent = data.choices[0].message.content || '';
                
                console.log('【视频通话】AI原始回复:', replyContent.substring(0, 100));
                
                // 【修复】清理可能的心声标签和分隔符（防御性处理）
                replyContent = replyContent.replace(/\[心声\][\s\S]*?\[\/心声\]/g, '');
                replyContent = replyContent.replace(/====+/g, '');
                replyContent = replyContent.trim();
                
                return replyContent;
                
            } catch (error) {
                console.error('视频通话调用AI API失败:', error);
                return '抱歉，网络有点问题，能再说一遍吗？';
            }
        }

        // 【新增】带自定义system prompt的AI API调用（用于语音通话）
        async function callAIDirectlyWithSystemPrompt(systemPrompt, userPrompt) {
            try {
                // 从localforage读取API设置
                const savedSettings = await loadAppSettings({});
                
                // 检查是否启用副API（用于通话和总结）
                const useSecondaryApi = savedSettings.api?.secondary?.enabled && savedSettings.api?.secondary?.apiKey;
                
                const apiKey = useSecondaryApi 
                    ? savedSettings.api?.secondary?.apiKey 
                    : (savedSettings.api?.apiKey || '');
                const baseUrl = useSecondaryApi
                    ? (savedSettings.api?.secondary?.baseUrl || 'https://api.openai.com/v1')
                    : (savedSettings.api?.baseUrl || 'https://api.openai.com/v1');
                const model = useSecondaryApi
                    ? (savedSettings.api?.secondary?.model || 'gpt-4o-mini')
                    : (savedSettings.api?.model || 'gpt-3.5-turbo');
                
                if (!apiKey) {
                    return '请先在设置中配置API密钥';
                }
                
                if (useSecondaryApi) {
                    console.log('【通话/总结】使用副API');
                }
                
                // 【优化】语音通话专用基础system prompt
                const baseSystemPrompt = `【⚠️ 极其重要 - 语音通话规则】
1. 全程不用描述任何动作语句，不使用括号，不添加任何动作描述
2. 尽量简单易懂，表达清晰直接
3. 只说你想说的话，保持自然、真实的对话语气
4. **禁止生成心声**（不要使用[心声]标签）
5. **禁止生成分隔符**（不要使用====）
6. 直接回复内容，不要有任何格式标签
7. 请像真实的朋友一样自然对话`;
                
                // 合并system prompt
                const finalSystemPrompt = systemPrompt + '\n\n' + baseSystemPrompt;
                
                // 构建消息数组
                let messages = [
                    { role: 'system', content: finalSystemPrompt },
                    { role: 'user', content: userPrompt }
                ];
                
                // 获取温度设置（默认0.7）
                const apiTemperature = savedSettings.api?.temperature ?? 0.7;
                
                // 构建请求体
                const requestBody = {
                    model: model,
                    messages: messages,
                    temperature: apiTemperature,
                    max_tokens: 8000 // 设置较大值，基本不会截断回复
                };
                
                // 发送API请求
                console.log('📞 语音通话API请求（带完整上下文）');
                
                // 【修复】添加超时处理，防止请求卡住
                const controller = new AbortController();
                const timeoutId = setTimeout(() => controller.abort(), 300000); // 【修改】300秒超时
                
                let response;
                try {
                    response = await fetch(`${baseUrl}/chat/completions`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'Authorization': `Bearer ${apiKey}`
                        },
                        body: JSON.stringify(requestBody),
                        signal: controller.signal
                    });
                } catch (fetchError) {
                    clearTimeout(timeoutId);
                    // 【修复】处理 AbortController 超时错误
                    if (fetchError.name === 'AbortError' || fetchError.message?.includes('aborted')) {
                        throw new Error('请求超时：AI 响应时间超过300秒，请稍后重试');
                    }
                    throw fetchError;
                }
                
                clearTimeout(timeoutId); // 请求成功，清除超时
                
                if (!response.ok) {
                    const errorText = await response.text();
                    console.error('❌ 语音通话API请求失败:', response.status, errorText);
                    throw new Error(`API请求失败: ${response.status}`);
                }
                
                const data = await response.json();
                
                if (!data.choices || !data.choices[0] || !data.choices[0].message) {
                    console.error('❌ API返回无效响应');
                    return '抱歉，我没听清楚，能再说一遍吗？';
                }
                
                let replyContent = data.choices[0].message.content || '';
                
                console.log('【语音通话】AI原始回复（带上下文）:', replyContent.substring(0, 100));
                
                // 【关键修复】检查AI是否返回了音频数据而不是文本
                if (replyContent.includes('data:audio/')) {
                    console.error('【语音通话】错误：AI返回了音频数据而不是文本！');
                    console.error('【语音通话】这可能是模型配置问题，请检查API设置中的模型是否为文本模型');
                    // 返回错误提示，让MiniMax来合成语音
                    return '抱歉，我这边出了点问题，能再说一遍吗？';
                }
                
                // 清理可能的心声标签和分隔符（防御性处理）
                replyContent = replyContent.replace(/\[心声\][\s\S]*?\[\/心声\]/g, '');
                replyContent = replyContent.replace(/====+/g, '');
                replyContent = replyContent.trim();
                
                return replyContent;
                
            } catch (error) {
                console.error('语音通话调用AI API失败:', error);
                return '抱歉，网络有点问题，能再说一遍吗？';
            }
        }

        // 【新增】专门用于批注功能的API调用（只使用主API）
        async function callAIForAnnotationOnly(systemPrompt, userPrompt) {
            try {
                // 从localforage读取API设置
                const savedSettings = await loadAppSettings({});
                console.log('【批注】读取到的设置:', savedSettings);
                console.log('【批注】API设置:', savedSettings.api);

                // 只使用主API
                const apiKey = savedSettings.api?.apiKey || '';
                const baseUrl = savedSettings.api?.baseUrl || 'https://api.openai.com/v1';
                const model = savedSettings.api?.model || 'gpt-3.5-turbo';

                console.log('【批注】API Key是否存在:', !!apiKey);
                console.log('【批注】Base URL:', baseUrl);
                console.log('【批注】Model:', model);

                if (!apiKey) {
                    console.error('【批注】API密钥未配置');
                    return '请先在设置中配置API密钥';
                }

                console.log('【批注】使用主API生成批注');

                // 构建消息数组
                let messages = [
                    { role: 'system', content: systemPrompt },
                    { role: 'user', content: userPrompt }
                ];

                // 获取温度设置（默认0.7）
                const apiTemperature = savedSettings.api?.temperature ?? 0.7;

                // 构建请求体
                const requestBody = {
                    model: model,
                    messages: messages,
                    temperature: apiTemperature,
                    max_tokens: 4000
                };

                // 发送API请求
                console.log('【批注】发送API请求');

                // 添加超时处理
                const controller = new AbortController();
                const timeoutId = setTimeout(() => controller.abort(), 300000); // 300秒超时

                let response;
                try {
                    response = await fetch(`${baseUrl}/chat/completions`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'Authorization': `Bearer ${apiKey}`
                        },
                        body: JSON.stringify(requestBody),
                        signal: controller.signal
                    });
                } catch (fetchError) {
                    clearTimeout(timeoutId);
                    if (fetchError.name === 'AbortError' || fetchError.message?.includes('aborted')) {
                        throw new Error('请求超时：AI 响应时间超过300秒，请稍后重试');
                    }
                    throw fetchError;
                }

                clearTimeout(timeoutId);

                if (!response.ok) {
                    const errorText = await response.text();
                    console.error('【批注】API请求失败:', response.status, errorText);
                    throw new Error(`API请求失败: ${response.status}`);
                }

                const data = await response.json();

                if (!data.choices || !data.choices[0] || !data.choices[0].message) {
                    console.error('【批注】API返回无效响应');
                    throw new Error('API返回无效响应');
                }

                let replyContent = data.choices[0].message.content || '';
                console.log('【批注】AI回复:', replyContent.substring(0, 100));

                return replyContent;

            } catch (error) {
                console.error('【批注】调用AI API失败:', error);
                return '批注生成失败：' + error.message;
            }
        }

        // 显示消息（支持分页）
        let currentDisplayedMessages = 50; // 默认显示最新50条
        let lastMessageTimestamp = null; // 记录上一条消息的时间戳

        // 【性能优化】批量渲染消息
        function processMessageRenderQueue() {
            if (isProcessingRenderQueue || messageRenderQueue.length === 0) return;
            
            isProcessingRenderQueue = true;
            
            // 使用 requestAnimationFrame 批量渲染
            requestAnimationFrame(() => {
                const chatContent = document.getElementById('chatContent');
                if (!chatContent) {
                    isProcessingRenderQueue = false;
                    return;
                }
                
                // 批量处理最多5条消息
                const batchSize = Math.min(5, messageRenderQueue.length);
                const fragment = document.createDocumentFragment();
                
                for (let i = 0; i < batchSize; i++) {
                    const msgData = messageRenderQueue.shift();
                    if (!msgData) continue;
                    
                    // 创建消息元素（简化版）
                    const messageElement = createMessageElement(msgData);
                    if (messageElement) {
                        fragment.appendChild(messageElement);
                    }
                }
                
                // 一次性添加到DOM
                if (fragment.childNodes.length > 0) {
                    chatContent.appendChild(fragment);
                    
                    // 滚动到底部
                    const lastMsg = chatContent.lastElementChild;
                    if (lastMsg) {
                        lastMsg.scrollIntoView({ behavior: 'smooth', block: 'end' });
                    }
                }
                
                isProcessingRenderQueue = false;
                
                // 如果队列中还有消息，继续处理
                if (messageRenderQueue.length > 0) {
                    setTimeout(processMessageRenderQueue, 16); // 约60fps
                }
            });
        }
        
        // 【性能优化】创建消息元素的辅助函数
        function createMessageElement(msgData) {
            // 简化创建逻辑，避免重复代码
            // 这里只创建基本结构，详细内容在 displayMessage 中处理
            return null; // 占位，实际逻辑在 displayMessage 中
        }

        // 【新增】文本标点符号清理函数 - 修复逗号异常问题，并智能分句
        function cleanTextPunctuation(text) {
            if (!text || typeof text !== 'string') return text;
            
            let cleaned = text;
            
            // 1. 将换行符替换为逗号（保持原有逻辑）
            cleaned = cleaned.replace(/\r\n/g, '，');
            cleaned = cleaned.replace(/\n/g, '，');
            cleaned = cleaned.replace(/\r/g, '，');
            
            // 2. 修复连续的逗号（两个及以上）为一个逗号
            cleaned = cleaned.replace(/，{2,}/g, '，');
            
            // 3. 修复逗号前后的空格问题
            cleaned = cleaned.replace(/，\s+/g, '，');
            cleaned = cleaned.replace(/\s+，/g, '，');
            
            // 4. 移除开头和结尾的逗号
            cleaned = cleaned.replace(/^，+/, '');
            cleaned = cleaned.replace(/，+$/, '');
            
            // 5. 修复其他标点符号后的逗号（如："？，" -> "？"）
            cleaned = cleaned.replace(/([。？！，；：])，/g, '$1');
            
            // 6. 修复逗号前的其他标点符号（如："，。" -> "。"）
            cleaned = cleaned.replace(/，([。？！，；：])/g, '$1');
            
            // 7. 英文逗号转中文逗号
            cleaned = cleaned.replace(/,/g, '，');
            
            // 8. 再次清理可能产生的连续逗号
            cleaned = cleaned.replace(/，{2,}/g, '，');
            
            return cleaned;
        }

        function displayMessage(sender, content, isHistory = true, quote = null, messageType = 'text', scrollToBottom = true, messageTimestamp = null, senderChatItem = null, thoughtContent = null, appendToEnd = false, senderName = null) {
            // 【防闪退】整个函数包裹try-catch
            try {
                // 【性能优化】只在开发环境输出日志，且限制频率
                if (window.location.hostname === 'localhost' && Math.random() < 0.1) {
                    console.log('=== displayMessage ===');
                }

                // 检查 content 是否为 undefined 或 null
                if (content === undefined || content === null) {
                    content = ''; // 设置为空字符串避免错误
                }

                // 【新增】如果 messageType 是 'text' 但内容包含表情包，自动改为 sticker 类型
                const contentStr = String(content);
                if (messageType === 'text' && contentStr.includes('[STICKER]') && contentStr.includes('|')) {
                    messageType = 'sticker';
                    console.log('【表情包调试】displayMessage - 自动识别为表情包消息');
                }

                const chatContent = document.getElementById('chatContent');
                if (!chatContent) {
                    console.error('❌ displayMessage: 找不到chatContent元素');
                    return;
                }

                // 【回忆保护】不清理DOM消息，保留所有回忆
                // 【DOM优化】只在新消息时清理其他资源，不删除消息DOM
                if (!isHistory) {
                    // 【DOM优化】只清理头像缓存和MathJax队列，不删除消息
                    if (AvatarLoader.cache.size > 30) {
                        console.log('【DOM优化】清理头像缓存');
                        AvatarLoader.cleanupCache(15);
                    }
                    if (MathJaxRenderQueue.getStats().queueLength > 10) {
                        console.log('【DOM优化】清理MathJax队列');
                        MathJaxRenderQueue.clear();
                    }
                }

            // 【关键修复】displayMessage 中不再增加消息计数
            // 计数统一在 incrementUserMessageCount / incrementAIMessageCount 中处理
            // 避免重复计数问题
            
            // 如果没有提供时间戳，使用当前时间
            const timestamp = messageTimestamp || Date.now();
            
            // 检查是否需要显示时间戳（需要在创建消息容器之前检查）
            const needShowTimestamp = shouldShowTimestamp(timestamp, lastMessageTimestamp);
            
            // 更新上一条消息的时间戳
            lastMessageTimestamp = timestamp;
            
            // 创建消息容器
            const messageContainer = document.createElement('div');
            messageContainer.className = `message-container ${sender}`;
            
            // 【关键修复】设置时间戳到dataset，用于删除时识别
            messageContainer.dataset.timestamp = timestamp;
            
            // 【虚拟列表】生成唯一消息ID并注册到管理器
            const virtualMessageId = VirtualListManager.getMessageId({
                timestamp: timestamp,
                sender: sender,
                content: typeof content === 'string' ? content : ''
            });
            messageContainer.dataset.virtualId = virtualMessageId;
            
            // 声明 messageContent 变量，用于 MathJax 渲染
            let messageContent = null;

            // 【性能优化】检查是否是群聊 - 使用传入的 senderChatItem 或查找一次后缓存
            // 避免在函数中多次查找
            const currentChatItem = senderChatItem || relationshipData.wechatChatList.find(item => item.id == currentChatId);
            const isGroupChat = currentChatItem && currentChatItem.isGroupChat;
            
            // 如果是群聊的AI消息，添加is-group-chat类
            if (isGroupChat && sender === 'ai') {
                messageContainer.classList.add('is-group-chat');
            }
            
            // 创建头像
            const avatar = document.createElement('div');
            avatar.className = 'message-avatar';
            
            // 生成消息ID（用于心声关联）- 使用timestamp作为ID，确保一致性
            const messageId = timestamp.toString();
            messageContainer.dataset.messageId = messageId;
            
            // 【修复】保存senderName到dataset，用于群聊头像恢复
            if (senderName) {
                messageContainer.dataset.senderName = senderName;
            }

            // 【修复】处理心声关联
            if (sender === 'ai') {
                // 获取当前AI的ID（群聊使用senderChatItem.id，单聊使用currentChatId）
                const aiId = (isGroupChat && senderChatItem) ? senderChatItem.id : currentChatId;
                
                // 【性能优化】只在开发环境输出详细日志
                if (window.location.hostname === 'localhost') {
                    console.log('【心声】messageId:', messageId, 'aiId:', aiId);
                }

                // 首先尝试关联暂存的心声（从Tool调用）
                const attached = attachPendingInnerThought(messageId, aiId);

                // 如果没有关联到暂存的心声，且消息中包含心声内容，则直接保存
                if (!attached && thoughtContent && thoughtContent.trim() !== '') {
                    if (!relationshipData.innerThoughts) {
                        relationshipData.innerThoughts = {};
                    }
                    if (aiId) {
                        if (!relationshipData.innerThoughts[aiId]) {
                            relationshipData.innerThoughts[aiId] = {};
                        }
                        relationshipData.innerThoughts[aiId][messageId] = thoughtContent;
                        // 【性能优化】减少日志输出
                        console.log('【心声】已保存:', messageId);
                        // 【性能优化】心声数据只在内存中保存，不立即持久化
                        // 避免频繁保存导致卡顿，将在页面卸载或切换聊天时统一保存
                        // saveDataDebounced(5000).catch(err => console.error('心声保存失败:', err));
                    }
                }
            }
            
            if (sender === 'user') {
                // 用户头像 - 使用个人资料中的头像（从缓存读取）
                const personalProfile = cachedPersonalProfile || {};

                if (personalProfile.avatar && personalProfile.avatar !== '' && personalProfile.avatar !== 'undefined') {
                    // 【修复】消息头像立即加载，并使用压缩
                    const img = document.createElement('img');
                    img.style.width = '40px';
                    img.style.height = '40px';
                    img.style.objectFit = 'cover';
                    img.style.cursor = 'default';
                    img.onerror = function() {
                        this.style.display = 'none';
                        avatar.innerHTML = `<div style="width: 40px; height: 40px; background-color: #f0f0f0; display: flex; align-items: center; justify-content: center; font-size: 20px;">👤</div>`;
                    };
                    avatar.appendChild(img);

                    // 【压缩】使用 AvatarLoader 压缩头像（微信风格 96x96）
                    AvatarLoader.compressAvatar(personalProfile.avatar).then(compressedSrc => {
                        // 【关键修复】确保压缩后的图片不为空，否则使用原图
                        if (compressedSrc && compressedSrc.trim() !== '') {
                            img.src = compressedSrc;
                        } else {
                            img.src = personalProfile.avatar;
                        }
                    }).catch(() => {
                        // 【关键修复】压缩失败时使用原图
                        img.src = personalProfile.avatar;
                    });
                } else {
                    avatar.innerHTML = `<div style="width: 40px; height: 40px; background-color: #f0f0f0; display: flex; align-items: center; justify-content: center; font-size: 20px;">👤</div>`;
                }
            } else {
                // AI头像
                let avatarToUse = currentChatAvatar;
                let avatarName = '';

                if (isGroupChat && senderChatItem) {
                    // 群聊：使用发送者的头像和名称
                    avatarToUse = senderChatItem.avatar;
                    avatarName = senderChatItem.name;
                } else if (isGroupChat && !senderChatItem) {
                    // 【修复】群聊中 senderChatItem 为 null 时，尝试从消息中获取发送者信息
                    // 这种情况通常发生在重新进入群聊时，消息已保存但 senderChatItem 未正确传递
                    const currentChatItem = relationshipData.wechatChatList.find(item => item.id == currentChatId);
                    if (currentChatItem && currentChatItem.members) {
                        // 尝试从消息内容或上下文中推断发送者
                        // 如果消息有 senderName，尝试匹配成员
                        const messageSenderName = messageContainer.dataset.senderName;
                        if (messageSenderName) {
                            const foundMember = currentChatItem.members.find(m => {
                                const memberChatItem = relationshipData.wechatChatList.find(item => item.id == m.id);
                                if (!memberChatItem) return false;
                                return memberChatItem.remark === messageSenderName || memberChatItem.name === messageSenderName;
                            });
                            if (foundMember) {
                                const memberChatItem = relationshipData.wechatChatList.find(item => item.id == foundMember.id);
                                if (memberChatItem) {
                                    avatarToUse = memberChatItem.avatar;
                                    avatarName = memberChatItem.name;
                                    console.log('【群聊头像修复】从消息中恢复发送者头像:', avatarName);
                                }
                            }
                        }
                    }
                }

                if (avatarToUse) {
                    // 【ColorOS兼容】使用简单的emoji检测
                    const isEmoji = avatarToUse.length <= 2 && /[\u{1F600}-\u{1F64F}\u{1F300}-\u{1F5FF}\u{1F680}-\u{1F6FF}\u{1F1E0}-\u{1F1FF}\u{2600}-\u{26FF}\u{2700}-\u{27BF}]/u.test(avatarToUse);
                    if (isEmoji) {
                        avatar.innerHTML = `<div style="width: 40px; height: 40px; background-color: #f0f0f0; display: flex; align-items: center; justify-content: center; font-size: 28px; cursor: pointer;">${avatarToUse}</div>`;
                    } else {
                        // 【修复】消息头像立即加载，并使用压缩，避免显示问题
                        const img = document.createElement('img');
                        img.style.width = '40px';
                        img.style.height = '40px';
                        img.style.objectFit = 'cover';
                        img.style.cursor = 'pointer';
                        img.onerror = function() {
                            this.style.display = 'none';
                            avatar.innerHTML = `<div style="width: 40px; height: 40px; background-color: #f0f0f0; display: flex; align-items: center; justify-content: center; font-size: 20px; cursor: pointer;">🤖</div>`;
                        };
                        avatar.appendChild(img);

                        // 【压缩】使用 AvatarLoader 压缩头像（微信风格 96x96）
                        AvatarLoader.compressAvatar(avatarToUse).then(compressedSrc => {
                            // 【关键修复】确保压缩后的图片不为空，否则使用原图
                            if (compressedSrc && compressedSrc.trim() !== '') {
                                img.src = compressedSrc;
                            } else {
                                img.src = avatarToUse;
                            }
                        }).catch(() => {
                            // 【关键修复】压缩失败时使用原图
                            img.src = avatarToUse;
                        });
                    }
                } else {
                    avatar.innerHTML = `<div style="width: 40px; height: 40px; background-color: #f0f0f0; display: flex; align-items: center; justify-content: center; font-size: 20px; cursor: pointer;">🤖</div>`;
                }

                // 给AI头像添加点击事件（点击进入个人主页）和长按事件（长按0.3秒显示心声悬浮窗）
                // 【DOM优化】历史消息简化头像事件绑定，减少内存占用
                if (sender === 'ai') {
                    avatar.style.cursor = 'pointer';
                    // 确定AI ID：群聊使用senderChatItem.id，单聊使用currentChatId
                    const aiId = (isGroupChat && senderChatItem) ? senderChatItem.id : currentChatId;
                    
                    // 【小花花标记】检查该消息是否有心声，如果有则添加标记
                    const hasInnerThought = checkMessageHasInnerThought(messageId, aiId);
                    if (hasInnerThought) {
                        avatar.classList.add('has-inner-thought');
                        // 检查是否已查看过（从localStorage读取）
                        const viewedKey = `viewed_inner_thought_${messageId}_${aiId}`;
                        const isViewed = localStorage.getItem(viewedKey);
                        if (isViewed) {
                            avatar.classList.add('viewed');
                        }
                    }
                    
                    // 【DOM优化】历史消息只保留点击事件，新消息保留完整事件
                    const isOldHistory = isHistory && messageTimestamp && (Date.now() - messageTimestamp > 24 * 60 * 60 * 1000);
                    
                    if (isOldHistory) {
                        // 【DOM优化】旧历史消息：只保留简单的点击事件，使用事件委托
                        avatar.dataset.aiId = aiId;
                        avatar.dataset.messageId = messageId;
                        avatar.classList.add('ai-avatar-simplified');
                        // 简单的点击事件
                        avatar.onclick = (e) => {
                            console.log('点击AI头像，进入个人主页:', aiId);
                            openAIProfilePage(aiId);
                        };
                    } else {
                        // 【DOM优化】新消息：保留完整的事件绑定
                        let pressTimer = null;
                        let isLongPress = false;
                        
                        // 开始长按
                        const startPress = (e) => {
                            isLongPress = false;
                            pressTimer = setTimeout(() => {
                                isLongPress = true;
                                showInnerThoughtTooltip(messageId, aiId, avatar);
                            }, 300); // 0.3秒触发
                        };
                        
                        // 结束长按
                        const endPress = (e) => {
                            if (pressTimer) {
                                clearTimeout(pressTimer);
                                pressTimer = null;
                            }
                        };
                        
                        // 鼠标事件
                        avatar.addEventListener('mousedown', startPress);
                        avatar.addEventListener('mouseup', endPress);
                        avatar.addEventListener('mouseleave', endPress);
                        
                        // 触摸事件（移动端）
                        avatar.addEventListener('touchstart', (e) => {
                            // 【修复】不阻止默认行为，允许页面滚动
                            startPress(e);
                        }, { passive: true });
                        avatar.addEventListener('touchend', endPress);
                        avatar.addEventListener('touchcancel', endPress);
                        
                        // 点击事件 - 进入AI个人主页
                        avatar.addEventListener('click', (e) => {
                            if (!isLongPress && aiId) {
                                console.log('点击AI头像，进入个人主页:', aiId);
                                openAIProfilePage(aiId);
                            }
                        });
                    }
                }
            }
            
            // 创建消息气泡
            const messageBubble = document.createElement('div');
            
            // 如果是群聊中的AI消息，在气泡外面添加发送者名称
            // 【修复】即使没有 senderChatItem，只要有 senderName 也显示发送者名称
            if (isGroupChat && sender === 'ai' && (senderChatItem || senderName)) {
                const senderNameEl = document.createElement('div');
                senderNameEl.className = 'message-sender-name';
                senderNameEl.textContent = senderName || senderChatItem.remark || senderChatItem.name || '未知';
                console.log('显示群聊AI发送者名称:', senderNameEl.textContent);
                messageContainer.appendChild(senderNameEl);
                // 【修复】保存senderName到dataset
                if (!messageContainer.dataset.senderName) {
                    messageContainer.dataset.senderName = senderNameEl.textContent;
                }
            } else {
                console.log('不显示发送者名称 - isGroupChat:', isGroupChat, 'sender:', sender, 'senderChatItem:', senderChatItem, 'senderName:', senderName);
            }
            
            // 根据消息类型设置不同的样式
            if (messageType === 'call') {
                messageBubble.className = 'message-bubble';
                
                // 【修改】根据发送者使用不同的通话图标
                const phoneIconUrl = sender === 'user' 
                    ? 'https://img.58sb.cn/file/img/khfRtYaF.jpg'  // 用户通话图标（原样）
                    : 'https://img.58sb.cn/file/img/mrOjp2Uc.jpg';  // AI通话图标（新链接）
                const phoneIcon = `<img src="${phoneIconUrl}" alt="电话" style="width: 20px; height: 20px; vertical-align: middle; margin-left: 5px;">`;
                
                messageContent = document.createElement('div');
                messageContent.className = 'message-content';
                messageContent.innerHTML = `${content} ${phoneIcon}`;
                // 存储原始内容用于删除匹配
                messageContent.dataset.originalContent = content;
                // 【关键修复】存储时间戳用于删除识别
                messageContent.dataset.timestamp = timestamp;
                
                messageBubble.appendChild(messageContent);
            } else if (messageType === 'voice') {
                // 【防闪退】语音消息渲染
                try {
                    messageBubble.className = 'message-bubble voice-message-bubble';
                    messageBubble.dataset.content = content;
                    // 【关键修复】存储时间戳用于删除识别
                    messageBubble.dataset.timestamp = timestamp;

                    // 创建语音播放按钮
                    const playBtn = document.createElement('div');
                    playBtn.className = 'voice-play-btn';
                    // 【区分用户和AI】根据sender显示不同的图标
                    const voiceIconUrl = sender === 'user' 
                        ? 'https://s41.ax1x.com/2026/02/08/pZTcK9f.jpg'  // 用户语音图标
                        : 'https://img.58sb.cn/file/img/XQtCPZvJ.jpg';   // AI语音图标
                    playBtn.innerHTML = `<img src="${voiceIconUrl}" alt="播放">`;

                    // 【防闪退】使用安全的事件处理
                    playBtn.onclick = function(e) {
                        // 【防闪退】阻止事件冒泡
                        if (e) {
                            e.stopPropagation();
                            e.preventDefault();
                        }

                        // 【防闪退】检查AudioManager是否存在
                        if (typeof AudioManager === 'undefined') {
                            console.error('【防闪退】AudioManager未定义');
                            return;
                        }

                        // 【防闪退】检查是否正在播放同一个语音
                        if (messageBubble.classList.contains('playing')) {
                            console.log('【防闪退】停止当前播放的语音');
                            AudioManager.stopCurrent();
                            return;
                        }

                        // 【修复】将sender信息传递给playVoice，确保能正确识别AI消息
                        messageBubble.dataset.sender = sender;
                        
                        // 【防闪退】播放语音
                        try {
                            playVoice(content, messageBubble);
                        } catch (err) {
                            console.error('【防闪退】播放语音失败:', err);
                        }
                    };

                    // 创建语音信息
                    const info = document.createElement('div');
                    info.className = 'voice-info';

                    // 获取语音时长（从content中解析）
                    const durationMatch = content.match(/duration=(\d+)/);
                    const duration = durationMatch ? parseInt(durationMatch[1]) : 0;

                    const durationEl = document.createElement('div');
                    durationEl.className = 'voice-duration';
                    durationEl.textContent = `${duration}"`;

                    info.appendChild(durationEl);

                    messageBubble.appendChild(playBtn);
                    messageBubble.appendChild(info);

                    // 如果有转文字内容
                    const transcriptMatch = content.match(/transcript=([^&]+)/);
                    if (transcriptMatch) {
                        try {
                            const transcript = document.createElement('div');
                            transcript.className = 'voice-transcript';
                            // 【修复】使用标点清理函数处理转文字内容
                            const rawTranscript = decodeURIComponent(transcriptMatch[1]);
                            transcript.textContent = cleanTextPunctuation(rawTranscript);
                            transcript.id = `transcript-${Date.now()}-${Math.random().toString(36).substr(2, 9)}`;
                            messageBubble.appendChild(transcript);
                        } catch (e) {
                            console.warn('【防闪退】解析转文字内容失败:', e);
                        }
                    }
                } catch (error) {
                    console.error('【防闪退】渲染语音消息失败:', error);
                    // 显示错误提示
                    messageBubble.className = 'message-bubble';
                    messageBubble.textContent = '[语音消息加载失败]';
                }
            } else if (messageType === 'sticker') {
                // 【修复】表情包消息 - 支持混合消息（文本+表情包在同一个气泡）
                console.warn('【表情包调试】displayMessage - 处理表情包消息:', content.substring(0, 100));
                
                // 创建消息内容容器（用于删除时获取原始内容）
                messageContent = document.createElement('div');
                messageContent.className = 'message-content';
                messageContent.style.display = 'none'; // 隐藏，只用于存储原始内容
                messageContent.dataset.originalContent = content;
                // 【关键修复】存储时间戳用于删除识别
                messageContent.dataset.timestamp = timestamp;
                messageBubble.appendChild(messageContent);

                // 【修复】改进表情包内容解析 - 支持更多格式变体
                // 格式1: [STICKER]url|label[/STICKER]
                // 格式2: [STICKER]`url|label[/STICKER]
                // 格式3: [STICKER] url|label [/STICKER]
                let stickerMatch = content.match(/\[STICKER\]\s*`?\s*(.+?)\s*\|\s*(.+?)\s*\[\/STICKER\]/);
                
                // 如果上面的匹配失败，尝试更宽松的匹配
                if (!stickerMatch) {
                    stickerMatch = content.match(/\[STICKER\](.+?)\|(.+?)\[\/STICKER\]/);
                }
                
                console.warn('【表情包调试】displayMessage - 表情包匹配结果:', stickerMatch ? '成功' : '失败', '匹配内容:', content);
                
                // 【关键修复】检查是否是混合消息（包含表情包和其他文本内容）
                let textContent = '';
                let hasSticker = false;
                let stickerUrl = '';
                let stickerLabel = '';
                
                if (stickerMatch) {
                    hasSticker = true;
                    stickerUrl = stickerMatch[1].trim();
                    stickerLabel = stickerMatch[2].trim();
                    
                    // 提取表情包标记前后的文本内容
                    const stickerTag = stickerMatch[0];
                    const parts = content.split(stickerTag);
                    
                    if (parts.length > 1) {
                        // 有表情包标记前后的内容
                        const beforeText = parts[0].trim();
                        const afterText = parts.slice(1).join(stickerTag).trim(); // 处理可能有多个相同表情包的情况
                        
                        // 合并文本内容
                        const textParts = [];
                        if (beforeText) textParts.push(beforeText);
                        if (afterText) textParts.push(afterText);
                        textContent = textParts.join(' ');
                        
                        console.warn('【表情包调试】混合消息 - 表情包前文本:', beforeText, '表情包后文本:', afterText);
                    }
                    
                    console.warn('【表情包调试】表情包URL:', stickerUrl.substring(0, 50), '标签:', stickerLabel);
                }
                
                // 【关键修复】如果有文本内容，使用普通消息气泡样式；如果只有表情包，使用透明背景
                if (textContent) {
                    // 混合消息：使用普通气泡样式
                    messageBubble.className = 'message-bubble';
                    console.warn('【表情包调试】混合消息 - 使用普通气泡样式');
                } else {
                    // 纯表情包消息：使用透明背景
                    messageBubble.className = 'message-bubble sticker-bubble';
                    messageBubble.style.background = 'transparent';
                    messageBubble.style.padding = '0';
                    messageBubble.style.boxShadow = 'none';
                    messageBubble.style.border = 'none';
                    console.warn('【表情包调试】纯表情包消息 - 使用透明背景');
                }
                
                // 如果有文本内容，先显示文本
                if (textContent) {
                    const textDiv = document.createElement('div');
                    textDiv.className = 'message-text-content';
                    textDiv.style.padding = '8px 12px';
                    
                    // 清理文本中的标点符号
                    const cleanedText = cleanTextPunctuation(textContent);
                    
                    // 检查是否是HTML
                    const isHTML = /<[a-z][\s\S]*>/i.test(cleanedText);
                    if (isHTML) {
                        textDiv.innerHTML = cleanedText;
                    } else if (typeof marked !== 'undefined' && cleanedText.length < 1000) {
                        try {
                            const contentWithBr = cleanedText.replace(/\r\n/g, '\n').replace(/\r/g, '\n');
                            textDiv.innerHTML = marked.parse(contentWithBr);
                        } catch (markedError) {
                            textDiv.textContent = cleanedText;
                        }
                    } else {
                        textDiv.textContent = cleanedText;
                    }
                    
                    messageBubble.appendChild(textDiv);
                }
                
                // 如果有表情包，显示表情包
                if (hasSticker && stickerUrl) {
                    // 创建图片容器，防止闪烁
                    const imgContainer = document.createElement('div');
                    imgContainer.style.width = '120px';
                    imgContainer.style.height = '120px';
                    imgContainer.style.display = 'flex';
                    imgContainer.style.alignItems = 'center';
                    imgContainer.style.justifyContent = 'center';
                    imgContainer.style.backgroundColor = '#f0f0f0';
                    imgContainer.style.borderRadius = '8px';
                    imgContainer.style.overflow = 'hidden';
                    
                    // 【修复】混合消息时，给表情包容器添加一些上边距
                    if (textContent) {
                        imgContainer.style.marginTop = '8px';
                    }
                    
                    const img = document.createElement('img');
                    img.src = stickerUrl;
                    img.style.maxWidth = '100%';
                    img.style.maxHeight = '100%';
                    img.style.objectFit = 'contain';
                    img.style.borderRadius = '8px';
                    img.style.cursor = 'pointer';
                    img.style.display = 'block';
                    
                    // 【修复】图片加载完成后隐藏背景色
                    img.onload = function() {
                        imgContainer.style.backgroundColor = 'transparent';
                    };
                    
                    img.onerror = function() {
                        console.error('【表情包调试】图片加载失败:', stickerUrl);
                        this.src = 'https://img.58sb.cn/file/img/placeholder.png';
                        imgContainer.style.backgroundColor = 'transparent';
                    };
                    
                    imgContainer.appendChild(img);
                    messageBubble.appendChild(imgContainer);
                } else if (!textContent) {
                    // 如果解析失败且没有文本内容，显示原始内容（用于调试）
                    console.error('【表情包调试】解析失败，显示原始内容:', content);
                    const errorText = document.createElement('div');
                    errorText.textContent = '[表情包]';
                    errorText.style.color = '#999';
                    errorText.style.fontSize = '12px';
                    errorText.style.padding = '10px';
                    messageBubble.appendChild(errorText);
                }
            } else if (messageType === 'letter_card') {
                // 信件卡片消息
                console.log('【写信调试】displayMessage - 处理信件卡片消息:', content.substring(0, 100));
                
                messageBubble.className = 'message-bubble letter-card-bubble';
                messageBubble.style.background = 'linear-gradient(135deg, #fff9f0 0%, #fff5e6 100%)';
                messageBubble.style.border = '1px solid #f0d9b5';
                messageBubble.style.borderRadius = '12px';
                messageBubble.style.padding = '0';
                messageBubble.style.maxWidth = '280px';
                messageBubble.style.cursor = 'pointer';
                messageBubble.style.overflow = 'hidden';
                
                // 【修复】创建消息内容容器（用于删除时获取原始内容）
                messageContent = document.createElement('div');
                messageContent.className = 'message-content';
                messageContent.style.display = 'none'; // 隐藏，只用于存储原始内容
                messageContent.dataset.originalContent = content;
                // 【关键修复】存储时间戳用于删除识别
                messageContent.dataset.timestamp = timestamp;
                messageBubble.appendChild(messageContent);

                // 解析信件卡片内容
                const letterCardMatch = content.match(/\[LETTER_CARD\](.+?)\|(.+?)\[\/LETTER_CARD\]/);
                console.log('【写信调试】信件卡片匹配结果:', letterCardMatch ? '成功' : '失败');
                if (letterCardMatch) {
                    const cardTitle = letterCardMatch[1].trim();
                    const letterContent = letterCardMatch[2].trim();
                    
                    // 创建卡片内容
                    const cardContainer = document.createElement('div');
                    cardContainer.className = 'letter-card-container';
                    cardContainer.style.cssText = 'padding: 15px;';
                    
                    // 信件图标和标题
                    const headerDiv = document.createElement('div');
                    headerDiv.style.cssText = 'display: flex; align-items: center; margin-bottom: 10px; border-bottom: 1px dashed #e0d0b0; padding-bottom: 10px;';
                    headerDiv.innerHTML = `<span style="font-size: 20px; margin-right: 8px;">💌</span><span style="font-weight: 600; color: #8b6914; font-size: 14px;">${cardTitle}</span>`;
                    
                    // 预览文字（前30字）
                    const previewDiv = document.createElement('div');
                    previewDiv.style.cssText = 'color: #666; font-size: 13px; line-height: 1.5; font-style: italic;';
                    const previewText = letterContent.length > 30 ? letterContent.substring(0, 30) + '...' : letterContent;
                    previewDiv.textContent = previewText;
                    
                    // 点击查看全文提示
                    const hintDiv = document.createElement('div');
                    hintDiv.style.cssText = 'text-align: center; margin-top: 10px; font-size: 12px; color: #999;';
                    hintDiv.textContent = '点击查看全文';
                    
                    cardContainer.appendChild(headerDiv);
                    cardContainer.appendChild(previewDiv);
                    cardContainer.appendChild(hintDiv);
                    messageBubble.appendChild(cardContainer);
                    
                    // 点击事件 - 查看全文
                    messageBubble.addEventListener('click', () => {
                        showFullLetterContent(cardTitle, letterContent);
                    });
                } else {
                    messageBubble.textContent = '[信件卡片]';
                }
            } else {
                // 【修复】检查内容是否包含表情包标记
                const stickerRegex = /\[STICKER\]\s*`?(.+?)\|(.+?)\[\/STICKER\]/g;
                
                // 【AI HTML卡片】检测并解析HTML卡片格式
                const cardData = parseHTMLCardFromMessage(content);
                const hasHTMLCard = cardData && cardData.html;

                console.log('【CARD调试】检测HTML卡片:', { content: content.substring(0, 100), hasHTMLCard, htmlLength: cardData?.html?.length });

                if (hasHTMLCard) {
                    // 创建卡片容器
                    messageBubble.className = 'message-bubble';
                    messageBubble.style.maxWidth = '85%';
                    messageBubble.style.padding = '0';
                    messageBubble.style.overflow = 'hidden';
                    
                    // 创建卡片内容容器
                    const cardContainer = document.createElement('div');
                    cardContainer.className = 'ai-card-container';
                    cardContainer.style.cssText = 'width: 100%; border-radius: 12px; overflow: hidden;';
                    
                    // 【安全】设置HTML内容
                    cardContainer.innerHTML = cardData.html;
                    messageBubble.appendChild(cardContainer);
                    
                    // 如果有其他文本内容，显示在卡片下方
                    if (cardData.content && cardData.content.trim()) {
                        const textContent = document.createElement('div');
                        textContent.className = 'message-content';
                        textContent.style.cssText = 'padding: 10px 14px;';
                        // 【修复】使用统一的标点清理函数
                        textContent.textContent = cleanTextPunctuation(cardData.content);
                        messageBubble.appendChild(textContent);
                    }
                    
                    // 添加隐藏的messageContent用于删除匹配
                    messageContent = document.createElement('div');
                    messageContent.style.display = 'none';
                    messageContent.dataset.originalContent = content;
                    // 【关键修复】存储时间戳用于删除识别
                    messageContent.dataset.timestamp = timestamp;
                    messageBubble.appendChild(messageContent);
                } else {
                    // 普通文本消息
                    messageBubble.className = 'message-bubble';

                    // 创建消息内容
                    messageContent = document.createElement('div');
                    messageContent.className = 'message-content';

                    // 存储原始内容用于删除匹配
                    messageContent.dataset.originalContent = content;
                    // 【关键修复】存储时间戳用于删除识别
                    messageContent.dataset.timestamp = timestamp;
                    
                    // 【修复】先清理文本中的标点符号问题
                    const cleanedContent = cleanTextPunctuation(content);
                    
                    // 检查内容是否是HTML（包含HTML标签）
                    const isHTML = /<[a-z][\s\S]*>/i.test(cleanedContent);
                    
                    if (isHTML) {
                        // 【ColorOS优化】简化HTML处理，避免复杂操作
                        messageContent.innerHTML = cleanedContent;
                    } else if (typeof marked !== 'undefined' && cleanedContent.length < 1000) {
                        // 【ColorOS优化】只对短内容使用Markdown解析
                        // 【修复】添加try-catch避免marked解析错误导致消息显示失败
                        try {
                            // 将换行符替换为 <br> 标签进行Markdown解析
                            const contentWithBr = cleanedContent
                                .replace(/\r\n/g, '\n')
                                .replace(/\r/g, '\n');
                            messageContent.innerHTML = marked.parse(contentWithBr);
                        } catch (markedError) {
                            console.warn('【marked错误】Markdown解析失败:', markedError);
                            // 直接使用清理后的文本
                            messageContent.textContent = cleanedContent;
                        }
                    } else {
                        // 【ColorOS优化】长内容直接使用纯文本
                        messageContent.textContent = cleanedContent;
                    }
                    
                    messageBubble.appendChild(messageContent);
                }
            }
            
            if (sender === 'user') {
                messageContainer.appendChild(messageBubble);
                messageContainer.appendChild(avatar);
            } else {
                messageContainer.appendChild(avatar);
                messageContainer.appendChild(messageBubble);
            }
            
            // 如果是AI语音消息，添加转文字按钮
            if (sender === 'ai' && messageType === 'voice') {
                // 从content中解析转文字内容
                const transcriptMatch = content.match(/transcript=([^&]+)/);
                if (transcriptMatch) {
                    const transcript = decodeURIComponent(transcriptMatch[1]);
                    
                    // 创建转文字按钮
                    const toggleBtn = document.createElement('div');
                    toggleBtn.className = 'voice-toggle-btn';
                    toggleBtn.textContent = '转文字';
                    
                    // 添加点击事件，点击后在AI语音消息下面插入白色文本框
                    toggleBtn.onclick = function() {
                        console.log('转文字按钮被点击');
                        const existingTextContainer = messageContainer.querySelector('.voice-message-text');
                        console.log('已存在的文本框:', existingTextContainer);
                        
                        if (existingTextContainer) {
                            existingTextContainer.remove();
                            console.log('删除文本框');
                        } else {
                            const newTextContainer = document.createElement('div');
                            newTextContainer.className = 'voice-message-text show';
                            newTextContainer.textContent = transcript;
                            newTextContainer.id = `voice-text-${Date.now()}`;
                            
                            messageContainer.appendChild(newTextContainer);
                            console.log('插入新文本框，内容:', transcript);
                        }
                    };
                    
                    // 添加到消息容器（在语音气泡外面）
                    messageContainer.appendChild(toggleBtn);
                }
            }
            
            // 添加引用内容到气泡下方（微信样式）
            // 【DOM优化】历史消息简化引用显示，减少DOM占用
            if (quote) {
                // 【DOM优化】历史消息只显示简化引用，新消息显示完整引用
                const isOldHistory = isHistory && messageTimestamp && (Date.now() - messageTimestamp > 24 * 60 * 60 * 1000);
                
                if (isOldHistory) {
                    // 【DOM优化】旧历史消息：极简引用，只显示图标
                    const quoteIndicator = document.createElement('div');
                    quoteIndicator.className = 'quote-indicator';
                    quoteIndicator.style.cssText = `
                        display: inline-block;
                        width: 8px;
                        height: 8px;
                        background-color: #ccc;
                        border-radius: 50%;
                        margin: 0 4px;
                        vertical-align: middle;
                    `;
                    // 【修复】如果没有发送者名称，只显示引用内容
                    const indicatorText = quote.senderName ? 
                        `引用: ${quote.senderName}: ${quote.content?.substring(0, 50) || ''}` :
                        `引用: ${quote.content?.substring(0, 50) || ''}`;
                    quoteIndicator.title = indicatorText;
                    messageContainer._quoteElement = quoteIndicator;
                } else {
                    // 【DOM优化】新消息：完整引用显示
                    const quoteElement = document.createElement('div');
                    quoteElement.className = 'quote-element';
                    quoteElement.style.cssText = `
                        display: flex;
                        margin-top: -10px;
                        margin-bottom: 8px;
                        background-color: rgba(255, 255, 255, 0.5);
                        padding: 4px 8px;
                        border-radius: 4px;
                        font-size: 12px;
                        color: #888;
                        border-left: 2px solid #ccc;
                        max-width: 70%;
                        max-height: 50px;
                        overflow: hidden;
                        text-overflow: ellipsis;
                        word-break: break-word;
                    `;

                    // 根据发送者设置引用的对齐方式
                    if (sender === 'user') {
                        quoteElement.style.marginLeft = 'auto';
                        quoteElement.style.marginRight = '45px';
                        quoteElement.style.justifyContent = 'flex-end';
                    } else {
                        quoteElement.style.marginLeft = '45px';
                        quoteElement.style.marginRight = 'auto';
                        quoteElement.style.justifyContent = 'flex-start';
                    }

                    // 【DOM优化】限制引用内容长度
                    const quoteContent = quote.content ? 
                        (quote.content.length > 30 ? quote.content.substring(0, 30) + '...' : quote.content) : '';
                    
                    // 【修复】如果没有发送者名称，只显示引用内容
                    const quoteDisplayText = quote.senderName ? 
                        `${quote.senderName}: ${quoteContent}` : 
                        quoteContent;
                    
                    quoteElement.innerHTML = `
                        <span style="color: #aaa;">${quoteDisplayText}</span>
                    `;

                    messageContainer._quoteElement = quoteElement;
                }
            }
            
            // 添加到聊天内容
            if (appendToEnd) {
                // 【关键】追加到末尾（用于初始渲染，保持时间顺序）
                if (needShowTimestamp) {
                    showTimestamp(timestamp);
                }
                chatContent.appendChild(messageContainer);
                // 【修复】如果有引用，在消息容器后插入引用
                if (messageContainer._quoteElement) {
                    chatContent.appendChild(messageContainer._quoteElement);
                }
            } else if (isHistory) {
                // 【修复】历史消息插入到顶部（最前面），保持时间顺序
                // 【关键修复】跳过"加载更多"按钮，找到第一个真正的消息元素
                let firstMessageChild = chatContent.firstChild;
                while (firstMessageChild && firstMessageChild.id === 'load-more-messages-btn') {
                    firstMessageChild = firstMessageChild.nextSibling;
                }

                if (firstMessageChild) {
                    // 如果需要显示时间戳，先插入时间戳
                    if (needShowTimestamp) {
                        const timestampContainer = document.createElement('div');
                        timestampContainer.className = 'timestamp-container';
                        timestampContainer.style.cssText = `
                            display: flex;
                            justify-content: center;
                            margin: 10px 0;
                        `;
                        const timestampBox = document.createElement('div');
                        timestampBox.className = 'timestamp-box';
                        timestampBox.style.cssText = `
                            background-color: rgba(255, 255, 255, 0.3);
                            color: #999;
                            padding: 8px 16px;
                            border-radius: 12px;
                            font-size: 13px;
                            user-select: none;
                        `;
                        timestampBox.textContent = formatWeChatTime(timestamp);
                        timestampContainer.appendChild(timestampBox);
                        chatContent.insertBefore(timestampContainer, firstMessageChild);
                    }
                    chatContent.insertBefore(messageContainer, firstMessageChild);
                    // 【修复】如果有引用，在消息容器后插入引用
                    if (messageContainer._quoteElement) {
                        chatContent.insertBefore(messageContainer._quoteElement, firstMessageChild);
                    }
                } else {
                    // 聊天内容为空（只有按钮），在按钮之后插入
                    const loadMoreBtn = document.getElementById('load-more-messages-btn');
                    if (loadMoreBtn && loadMoreBtn.nextSibling) {
                        chatContent.insertBefore(messageContainer, loadMoreBtn.nextSibling);
                        // 【修复】如果有引用，在消息容器后插入引用
                        if (messageContainer._quoteElement) {
                            chatContent.insertBefore(messageContainer._quoteElement, loadMoreBtn.nextSibling);
                        }
                    } else {
                        // 没有其他元素，追加到末尾
                        if (needShowTimestamp) {
                            showTimestamp(timestamp);
                        }
                        chatContent.appendChild(messageContainer);
                        // 【修复】如果有引用，在消息容器后插入引用
                        if (messageContainer._quoteElement) {
                            chatContent.appendChild(messageContainer._quoteElement);
                        }
                    }
                }
            } else {
                // 新消息添加到底部
                if (needShowTimestamp) {
                    showTimestamp(timestamp);
                }
                chatContent.appendChild(messageContainer);
                // 【修复】如果有引用，在消息容器后插入引用
                if (messageContainer._quoteElement) {
                    chatContent.appendChild(messageContainer._quoteElement);
                }
            }
            
            // 【简化】只注册消息元素标记，不再维护复杂的状态
            VirtualListManager.registerMessageElement(virtualMessageId, messageContainer);
            
            // 【ColorOS兼容】简化新消息动画，避免复杂的CSS动画
            if (!isHistory) {
                // 使用简单的淡入效果
                messageBubble.style.opacity = '0';
                messageBubble.style.transition = 'opacity 0.2s ease';

                // 使用 requestAnimationFrame 确保流畅
                requestAnimationFrame(() => {
                    messageBubble.style.opacity = '1';
                });
            }
            
            // 根据参数决定是否滚动到底部
            if (scrollToBottom) {
                // 【鸿蒙系统兼容】鸿蒙系统使用 setTimeout 替代 requestAnimationFrame
                const isHarmonyDevice = typeof checkIsHarmonyDevice === 'function' ? checkIsHarmonyDevice() : false;
                const scheduleScroll = isHarmonyDevice ?
                    (cb) => setTimeout(cb, 0) :
                    (cb) => requestAnimationFrame(cb);
                
                scheduleScroll(() => {
                    chatContent.scrollTop = chatContent.scrollHeight;
                });
            }
            
            // 【性能优化】MathJax渲染 - 只在检测到数学公式时才渲染
            if (typeof MathJax !== 'undefined' && MathJax.typesetPromise && messageContent) {
                const contentText = messageContent.textContent || '';
                // 检测是否包含数学公式（$...$ 或 $$...$$ 或 \[...\] 或 \(...\)）
                const hasMathFormula = /\$\$?[\s\S]*?\$\$?|\\\[[\s\S]*?\\\]|\\\([\s\S]*?\\\)/.test(contentText);
                if (hasMathFormula) {
                    // 将渲染任务加入队列
                    MathJaxRenderQueue.add(messageContainer, messageContent, quote, messageId);
                }
            }
        } catch (error) {
            // 【防闪退】捕获displayMessage中的所有错误
            console.error('❌ displayMessage 发生严重错误:', error);
            console.error('错误详情:', error.stack);
            showToast('消息显示失败: ' + (error.message || '未知错误'), 'error');
        }
        }
        
        // 加载更多历史消息
        async function loadMoreHistory() {
            // 【防闪退】整个函数包裹try-catch
            try {
                const chatContent = document.getElementById('chatContent');
                if (!chatContent) return;

                // 【关键修复】使用ChatMessageManager从SQLite/IndexedDB获取消息
                let sortedMessages = [];
                try {
                    // 获取所有消息
                    const allMessages = await ChatMessageManager.getAllMessages(currentChatId);
                    if (allMessages && allMessages.length > 0) {
                        sortedMessages = allMessages
                            .filter(msg => msg && msg.chatId === currentChatId)
                            .sort((a, b) => {
                                try {
                                    return new Date(a.timestamp) - new Date(b.timestamp);
                                } catch (e) {
                                    return 0;
                                }
                            });
                    }
                    
                    // 如果SQLite/IndexedDB没有消息，尝试从relationshipData获取（兼容旧数据）
                    if (sortedMessages.length === 0 && relationshipData && relationshipData.chatMessages) {
                        sortedMessages = [...relationshipData.chatMessages]
                            .filter(msg => msg && msg.chatId === currentChatId)
                            .sort((a, b) => {
                                try {
                                    return new Date(a.timestamp) - new Date(b.timestamp);
                                } catch (e) {
                                    return 0;
                                }
                            });
                    }
                } catch (sortError) {
                    console.error('❌ 消息排序失败:', sortError);
                    showToast('加载历史消息失败', 'error');
                    return;
                }

                // 计算需要加载的消息数量
                const totalMessages = sortedMessages.length;
                
                // 如果已经加载了所有消息，直接返回
                if (currentDisplayedMessages >= totalMessages) {
                    console.log('所有消息已加载完毕，无需再加载');
                    return;
                }
                
                const messagesToLoad = Math.min(20, totalMessages - currentDisplayedMessages);

                // 如果没有更多消息可加载，直接返回
                if (messagesToLoad <= 0) {
                    console.log('没有更多历史消息可加载');
                    return;
                }

                // 保存当前的滚动高度和滚动位置
                const oldScrollHeight = chatContent.scrollHeight;
                const oldScrollTop = chatContent.scrollTop;

                // 计算要加载的消息范围
                // 当前已加载的是最新的 currentDisplayedMessages 条
                // 现在要加载更早的 messagesToLoad 条
                const startIndex = totalMessages - currentDisplayedMessages - messagesToLoad;
                const endIndex = totalMessages - currentDisplayedMessages;

                console.log(`加载历史消息: startIndex=${startIndex}, endIndex=${endIndex}, 已加载=${currentDisplayedMessages}, 总共=${totalMessages}`);

                // 【关键】按正确顺序加载消息
                // sortedMessages 是按时间升序排列的（旧消息在前，新消息在后）
                // 我们要加载的是索引 startIndex 到 endIndex-1 的消息
                // 这些消息比当前已加载的消息更早
                // 
                // 正确顺序：先加载较新的（endIndex-1），再加载更早的（startIndex）
                // 这样先插入的较新消息会在上面，后插入的更早消息会在下面
                
                for (let i = endIndex - 1; i >= startIndex; i--) {
                    try {
                        const msg = sortedMessages[i];
                        if (!msg) {
                            console.warn(`⚠️ 跳过无效消息，索引: ${i}`);
                            continue;
                        }
                        
                        // 【关键】过滤掉约会消息（不在私聊界面显示）
                        if (msg.isDateMessage) {
                            console.log(`【约会】加载历史时跳过约会消息，索引: ${i}`);
                            continue;
                        }
                        
                        let messageType = 'text';
                        if (msg.type === 'voice') messageType = 'voice';
                        else if (msg.type === 'sticker') messageType = 'sticker';
                        
                        const contentStr = ensureStringContent(msg.content);
                        if (contentStr.includes('[STICKER]')) messageType = 'sticker';

                        // 【关键】使用 renderSingleMessage 渲染消息
                        // renderSingleMessage 会将消息插入到顶部
                        renderSingleMessage(msg);
                    } catch (singleMsgError) {
                        console.error(`❌ 单条消息渲染失败，索引: ${i}:`, singleMsgError);
                    }
                }

                currentDisplayedMessages += messagesToLoad;
                console.log(`已加载${currentDisplayedMessages}/${totalMessages}条消息`);

                // 恢复滚动位置，保持在原来的位置
                const newScrollHeight = chatContent.scrollHeight;
                const heightAdded = newScrollHeight - oldScrollHeight;
                chatContent.scrollTop = oldScrollTop + heightAdded;
                
            } catch (error) {
                // 【防闪退】捕获loadMoreHistory中的所有错误
                console.error('❌ loadMoreHistory 发生严重错误:', error);
                console.error('错误详情:', error.stack);
                showToast('加载历史消息失败: ' + (error.message || '未知错误'), 'error');
            }
        }
        
        // 监听滚动事件，加载更多历史
        // 【防闪退】全局滚动监听管理器 - 避免重复绑定
        const ChatScrollManager = {
            isInitialized: false,
            isLoadingHistory: false,
            lastScrollTop: 0,
            scrollTimeout: null,
            rafId: null,
            lastScrollTime: 0,
            scrollThrottleMs: 16, // 约60fps
            // 【修复】缓存绑定后的处理函数，避免重复绑定和无法移除
            boundHandleScroll: null,
            boundClickHandler: null,

            init() {
                if (this.isInitialized) return;

                const chatContent = document.getElementById('chatContent');
                const chatInput = document.getElementById('chatInput');
                if (!chatContent) return;

                // 【修复】先移除可能存在的旧监听器
                this.cleanup(chatContent);

                // 【修复】缓存绑定后的函数，确保可以正确移除
                this.boundHandleScroll = this.handleScroll.bind(this);
                this.boundClickHandler = function() {
                    if (chatInput) {
                        chatInput.blur();
                    }
                };

                // 【修复】移除 passive: true，解决某些手机触摸问题
                // scroll 事件不需要 passive 优化，且可能导致触摸问题
                chatContent.addEventListener('scroll', this.boundHandleScroll);

                // 点击聊天内容区域时取消输入法
                chatContent.addEventListener('click', this.boundClickHandler);

                this.isInitialized = true;
                console.log('【防闪退】聊天滚动管理器初始化完成');
            },

            // 【修复】添加清理方法
            cleanup(chatContent) {
                if (!chatContent) {
                    chatContent = document.getElementById('chatContent');
                }
                if (chatContent) {
                    if (this.boundHandleScroll) {
                        chatContent.removeEventListener('scroll', this.boundHandleScroll);
                    }
                    if (this.boundClickHandler) {
                        chatContent.removeEventListener('click', this.boundClickHandler);
                    }
                }
                // 清理RAF
                if (this.rafId) {
                    cancelAnimationFrame(this.rafId);
                    this.rafId = null;
                }
                // 清理定时器
                if (this.scrollTimeout) {
                    clearTimeout(this.scrollTimeout);
                    this.scrollTimeout = null;
                }
            },

            // 【修复】重置方法
            reset() {
                this.cleanup();
                this.isInitialized = false;
                this.boundHandleScroll = null;
                this.boundClickHandler = null;
            },
            
            handleScroll() {
                // 【性能优化】使用RAF节流，避免频繁读取scrollTop导致强制同步布局
                if (this.rafId) {
                    cancelAnimationFrame(this.rafId);
                    this.rafId = null; // 【防闪退】清理引用
                }

                this.rafId = requestAnimationFrame(() => {
                    this.processScroll();
                });
            },
            
            processScroll() {
                const chatContent = document.getElementById('chatContent');
                if (!chatContent) return;
                
                const now = Date.now();
                // 【性能优化】节流处理，避免过于频繁的滚动事件
                if (now - this.lastScrollTime < this.scrollThrottleMs) {
                    return;
                }
                this.lastScrollTime = now;
                
                const currentScrollTop = chatContent.scrollTop;
                const scrollHeight = chatContent.scrollHeight;
                const clientHeight = chatContent.clientHeight;
                
                // 清除之前的定时器
                clearTimeout(this.scrollTimeout);
                
                // 【虚拟列表】当滚动到顶部附近时，显示加载按钮
                // 【关键修复】当用户滚动到顶部附近时，显示加载更多按钮
                const isNearTop = currentScrollTop <= 150;
                
                // 如果靠近顶部且有更多消息，显示加载按钮
                if (isNearTop && hasMoreMessages && oldestLoadedOffset > 0) {
                    // 检查按钮是否已存在
                    const existingBtn = document.getElementById('load-more-messages-btn');
                    if (!existingBtn) {
                        console.log('【虚拟列表】滚动到顶部附近，显示加载按钮');
                        addLoadMoreButton();
                    }
                } else if (!isNearTop) {
                    // 如果不在顶部附近，移除按钮
                    removeLoadMoreButton();
                }
                
                this.lastScrollTop = currentScrollTop;
            },
            
            // 【自动加载】显示顶部加载指示器
            showLoadingIndicator() {
                const chatContent = document.getElementById('chatContent');
                if (!chatContent) return;
                
                let indicator = document.getElementById('auto-load-indicator');
                if (!indicator) {
                    indicator = document.createElement('div');
                    indicator.id = 'auto-load-indicator';
                    indicator.style.cssText = `
                        text-align: center;
                        padding: 15px;
                        color: #576b95;
                        font-size: 14px;
                        background: rgba(255, 255, 255, 0.95);
                        position: sticky;
                        top: 0;
                        z-index: 10;
                    `;
                    indicator.innerHTML = `
                        <span style="display: inline-flex; align-items: center; gap: 8px;">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="animation: spin 1s linear infinite;">
                                <circle cx="12" cy="12" r="10" stroke-dasharray="60" stroke-dashoffset="20"></circle>
                            </svg>
                            加载历史消息...
                        </span>
                    `;
                }
                
                if (chatContent.firstChild) {
                    chatContent.insertBefore(indicator, chatContent.firstChild);
                } else {
                    chatContent.appendChild(indicator);
                }
            },
            
            // 【自动加载】隐藏顶部加载指示器
            hideLoadingIndicator() {
                const indicator = document.getElementById('auto-load-indicator');
                if (indicator && indicator.parentNode) {
                    indicator.parentNode.removeChild(indicator);
                }
            },
            
            // 重置状态
            reset() {
                this.isLoadingHistory = false;
                this.lastScrollTop = 0;
                clearTimeout(this.scrollTimeout);
                if (this.rafId) {
                    cancelAnimationFrame(this.rafId);
                    this.rafId = null;
                }
            }
        };
        
        // 在DOM加载完成后初始化滚动管理器
        document.addEventListener('DOMContentLoaded', function() {
            ChatScrollManager.init();
            // 页面加载时加载打字无障碍设置
            loadAccessibilityInputSetting();
        });
// 显示撤回消息
        function showUndoMessage(messageSender, originalMessage, aiNickname, undoSender, saveToStorage = false, scrollToBottom = true) {
            const chatContent = document.getElementById('chatContent');
            if (!chatContent) return;
            
            // 创建撤回消息容器
            const undoContainer = document.createElement('div');
            undoContainer.className = 'undo-message-container';
            
            // 设置样式：居中，灰色文字，白色透明度30%背景，圆角
            undoContainer.style.cssText = `
                display: flex;
                justify-content: center;
                margin: 10px 0;
            `;
            
            // 创建撤回提示框
            const undoBox = document.createElement('div');
            undoBox.className = 'undo-box';
            undoBox.style.cssText = `
                background-color: rgba(255, 255, 255, 0.3);
                color: #999;
                padding: 8px 16px;
                border-radius: 12px;
                font-size: 13px;
                cursor: pointer;
                user-select: none;
                transition: background-color 0.2s;
            `;
            
            // 根据撤回者和被撤回者设置不同的提示文字
            let messageText = '';
            if (undoSender === 'user') {
                // 用户在撤回
                if (messageSender === 'user') {
                    messageText = '你撤回了一条消息';
                } else {
                    messageText = `你撤回了${aiNickname}的一条消息`;
                }
            } else {
                // AI在撤回
                if (messageSender === 'user') {
                    messageText = `${aiNickname}撤回了你的一条消息`;
                } else {
                    messageText = `${aiNickname}撤回了一条消息`;
                }
            }
            
            undoBox.textContent = messageText;
            
            // 存储撤回信息到dataset
            undoContainer.dataset.messageSender = messageSender;
            undoContainer.dataset.originalMessage = originalMessage;
            undoContainer.dataset.aiNickname = aiNickname;
            undoContainer.dataset.undoSender = undoSender;
            
            // 添加点击事件，显示撤回的内容
            undoBox.addEventListener('click', function() {
                // 创建弹窗显示撤回的内容
                const contentPopup = document.createElement('div');
                contentPopup.style.cssText = `
                    position: fixed;
                    top: 50%;
                    left: 50%;
                    transform: translate(-50%, -50%);
                    background-color: white;
                    border-radius: 12px;
                    padding: 20px;
                    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
                    z-index: 10000;
                    max-width: 80%;
                    max-height: 80%;
                    overflow-y: auto;
                `;
                
                contentPopup.innerHTML = `
                    <div style="font-weight: 500; margin-bottom: 10px; color: #333;">撤回的消息内容：</div>
                    <div style="color: #666; word-break: break-word;">${originalMessage}</div>
                    <button id="closeContentPopup" style="
                        margin-top: 15px;
                        padding: 8px 20px;
                        background-color: #007AFF;
                        color: white;
                        border: none;
                        border-radius: 6px;
                        cursor: pointer;
                        font-size: 14px;
                    ">关闭</button>
                `;
                
                document.body.appendChild(contentPopup);
                
                // 关闭按钮事件
                document.getElementById('closeContentPopup').addEventListener('click', function() {
                    contentPopup.remove();
                });
                
                // 点击背景关闭
                contentPopup.addEventListener('click', function(e) {
                    if (e.target === contentPopup) {
                        contentPopup.remove();
                    }
                });
            });
            
            // 添加悬停效果
            undoBox.addEventListener('mouseenter', function() {
                undoBox.style.backgroundColor = 'rgba(255, 255, 255, 0.5)';
            });
            
            undoBox.addEventListener('mouseleave', function() {
                undoBox.style.backgroundColor = 'rgba(255, 255, 255, 0.3)';
            });
            
            undoContainer.appendChild(undoBox);
            chatContent.appendChild(undoContainer);
            
            // 如果需要保存到存储
            if (saveToStorage) {
                saveUndoMessageToStorage(messageSender, originalMessage, aiNickname, undoSender);
            }
            
            // 根据参数决定是否滚动到底部
            if (scrollToBottom) {
                chatContent.scrollTop = chatContent.scrollHeight;
            }
        }

        // 显示操作框消息（陪伴学习等）
        function showActionBoxMessage(text, scrollToBottom = true) {
            console.log('showActionBoxMessage 被调用:', text);
            const chatContent = document.getElementById('chatContent');
            console.log('chatContent 元素:', chatContent);
            if (!chatContent) {
                console.log('chatContent 不存在，直接返回');
                return;
            }

            // 创建操作框容器
            const actionContainer = document.createElement('div');
            actionContainer.className = 'action-box-container';

            // 设置样式：居中，灰色文字，白色透明度30%背景，圆角（与撤回消息样式相同）
            actionContainer.style.cssText = `
                display: flex !important;
                justify-content: center !important;
                margin: 10px 0 !important;
                width: 100% !important;
                clear: both !important;
            `;

            // 创建操作框
            const actionBox = document.createElement('div');
            actionBox.className = 'action-box';
            actionBox.style.cssText = `
                background-color: rgba(200, 200, 200, 0.5) !important;
                color: #666 !important;
                padding: 8px 16px !important;
                border-radius: 12px !important;
                font-size: 13px !important;
                user-select: none !important;
                text-align: center !important;
                display: inline-block !important;
                max-width: 80% !important;
                word-wrap: break-word !important;
            `;

            actionBox.textContent = text;

            actionContainer.appendChild(actionBox);
            chatContent.appendChild(actionContainer);
            
            console.log('操作框已添加到 chatContent:', actionContainer);

            // 根据参数决定是否滚动到底部
            if (scrollToBottom) {
                chatContent.scrollTop = chatContent.scrollHeight;
            }

            return actionContainer;
        }

        // 将函数挂载到window对象，方便其他脚本调用
        window.showActionBoxMessage = showActionBoxMessage;

        // 获取当前AI的真实备注
        function getCurrentAINickname() {
            if (!currentChatId) return 'AI';

            // 优先从聊天列表中获取备注
            const chatItem = relationshipData.wechatChatList.find(item => item.id == currentChatId);
            if (chatItem && chatItem.name) {
                return chatItem.name;
            }

            // 如果没有备注，检查是否是AI角色
            const aiPersona = relationshipData.aiPersonas.find(persona => persona.id == currentChatId);
            if (aiPersona && aiPersona.name) {
                return aiPersona.name;
            }
            
            return 'AI';
        }

        // 获取当前用户的昵称
        async function getCurrentUserNickname() {
            const personalProfile = await localforage.getItem('personalProfile') || {};
            return personalProfile.nickname || '用户';
        }

        // 显示新的AI操作（用于实时操作，不重复显示历史记录）
        function showNewAIAction(action, details = '') {
            const aiNickname = getCurrentAINickname();
            let message = '';
            
            switch(action) {
                case '切歌':
                    message = `${aiNickname}正在切歌：${details || '未知歌曲'}`;
                    break;
                case '暂停':
                    message = `${aiNickname}暂停了音乐`;
                    break;
                case '打开':
                    message = `${aiNickname}正在打开音乐`;
                    break;
                case '关闭':
                    message = `${aiNickname}关闭了音乐`;
                    break;
            }
            
            if (message) {
                showAiActionMessage(message);
            }
        }

        // 保存AI操作记录
        function saveAIActionToStorage(action, details = '') {
            if (!relationshipData.aiActions) {
                relationshipData.aiActions = [];
            }
            
            const aiNickname = getCurrentAINickname();
            relationshipData.aiActions.push({
                action: action,
                details: details,
                aiNickname: aiNickname,
                timestamp: Date.now(),
                chatId: currentChatId
            });
            
            // 只保留最近100条操作记录，避免存储过多
            if (relationshipData.aiActions.length > 100) {
                relationshipData.aiActions = relationshipData.aiActions.slice(-100);
            }
            
            saveData();
        }

        function showAiActionMessage(message, scrollToBottom = true) {
            const chatContent = document.getElementById('chatContent');
            if (!chatContent) return;
            
            const aiActionContainer = document.createElement('div');
            aiActionContainer.className = 'ai-action-container';
            aiActionContainer.style.cssText = `
                display: flex;
                justify-content: center;
                margin: 10px 0;
            `;
            
            const aiActionBox = document.createElement('div');
            aiActionBox.className = 'ai-action-box';
            aiActionBox.style.cssText = `
                background-color: rgba(255, 255, 255, 0.3);
                color: #999;
                padding: 8px 16px;
                border-radius: 12px;
                font-size: 13px;
                user-select: none;
            `;
            
            aiActionBox.textContent = message;
            aiActionContainer.appendChild(aiActionBox);
            chatContent.appendChild(aiActionContainer);
            
            // 根据参数决定是否滚动到底部
            if (scrollToBottom) {
                chatContent.scrollTop = chatContent.scrollHeight;
            }
        }

        async function handleMusicControl(action) {
            const aiNickname = await getCurrentAINickname();
            
            switch(action) {
                case '切歌':
                    if (!musicPlayerState.playlist || musicPlayerState.playlist.length === 0) {
                        // 从 localforage 安全获取播放列表数据
                        const playlistData = await localforage.getItem('playlistData') || [];
                        musicPlayerState.playlist = [...playlistData];
                        musicPlayerState.currentIndex = 0;
                    }
                    playNext();
                    if (musicPlayerState.playlist && musicPlayerState.playlist.length > 0) {
                        const currentSong = musicPlayerState.playlist[musicPlayerState.currentIndex];
                        const songName = currentSong ? currentSong.name : '未知歌曲';
                        showNewAIAction('切歌', songName);
                        saveAIActionToStorage('切歌', songName);
                    } else {
                        showNewAIAction('切歌', '暂无歌曲');
                        saveAIActionToStorage('切歌', '暂无歌曲');
                    }
                    break;
                case '暂停':
                    togglePlayPause();
                    showNewAIAction('暂停');
                    saveAIActionToStorage('暂停');
                    break;
                case '打开':
                    if (currentChatId) {
                        currentListeningAIId = currentChatId;
                    }
                    openMusicPlayer();
                    showNewAIAction('打开');
                    saveAIActionToStorage('打开');
                    break;
                case '关闭':
                    closeMusicPlayerCompletely();
                    showNewAIAction('关闭');
                    saveAIActionToStorage('关闭');
                    break;
            }
        }
        
        // 保存撤回消息到存储
        async function saveUndoMessageToStorage(messageSender, originalMessage, aiNickname, undoSender) {
            if (!relationshipData.undoMessages) {
                relationshipData.undoMessages = [];
            }

            const undoMsg = {
                messageSender: messageSender,
                originalMessage: originalMessage,
                aiNickname: aiNickname,
                undoSender: undoSender,
                timestamp: Date.now(),
                chatId: currentChatId
            };

            relationshipData.undoMessages.push(undoMsg);

            // 【关键修复】保存到 localforage
            await saveData();

            // 【关键修复】同时保存到 SQLite
            try {
                if (typeof SQLiteManager !== 'undefined' && SQLiteManager.isAvailable) {
                    const stored = await SQLiteManager.getRelationshipData('relationshipData', {});
                    stored.undoMessages = relationshipData.undoMessages;
                    await SQLiteManager.saveRelationshipData('relationshipData', stored);
                    console.log('【撤回修复】撤回消息已保存到 SQLite');
                }
            } catch (error) {
                console.warn('【撤回修复】保存到 SQLite 失败:', error);
            }

            console.log('【撤回修复】撤回消息已保存:', undoMsg);
        }
        // 打开聊天界面
        async function openChatInterface(chatId, chatName, avatar) {
            console.log('打开聊天界面:', chatId, chatName, avatar);

            try {
                // 查找聊天项
                const chatItem = relationshipData.wechatChatList.find(item => item.id == chatId);
                const isGroupChat = chatItem && chatItem.isGroupChat;
                
                console.log('是否是群聊:', isGroupChat);
                if (isGroupChat) {
                    console.log('群聊成员:', chatItem.members);
                }
                
                // 隐藏微信页面
                const wechatPage = document.getElementById('wechatPage');
                if (wechatPage) {
                    wechatPage.style.display = 'none';
                    console.log('微信页面隐藏成功');
                }
                
                // 设置聊天界面标题
                const chatHeaderTitle = document.getElementById('chatHeaderTitle');
                if (chatHeaderTitle) {
                    chatHeaderTitle.textContent = chatName || '聊天';
                    console.log('聊天界面标题设置成功:', chatName);
                }
                
                // 显示聊天界面
                const chatInterface = document.getElementById('chatInterface');
                if (chatInterface) {
                    console.log('聊天界面当前display属性:', chatInterface.style.display);
                    chatInterface.style.display = 'flex';
                    chatInterface.style.position = 'fixed';
                    chatInterface.style.top = '0';
                    chatInterface.style.left = '0';
                    chatInterface.style.width = '100vw';
                    // 【修复】使用 dvh 单位，避免键盘弹出时顶栏被顶上去
                    chatInterface.style.height = '100dvh';
                    chatInterface.style.zIndex = '9999';
                    chatInterface.style.opacity = '1';
                    chatInterface.style.visibility = 'visible';
                    chatInterface.style.boxShadow = '0 0 0 9999px rgba(0, 0, 0, 0.5)';
                    chatInterface.style.pointerEvents = 'auto';
                    chatInterface.style.overflow = 'hidden';
                    console.log('聊天界面显示成功，新的display属性:', chatInterface.style.display);
                }
                
                currentChatId = chatId;
                currentIsGroupChat = isGroupChat;
                
                // 【关键修复】处理头像引用键，从IndexedDB加载实际图片
                let avatarToUse = avatar;
                if (avatar && avatar.startsWith('chatAvatar_')) {
                    try {
                        const avatarImage = await loadImageFromDB(avatar);
                        if (avatarImage) {
                            avatarToUse = avatarImage;
                        }
                    } catch (err) {
                        console.warn('【openChatInterface】加载头像失败:', err);
                    }
                }
                currentChatAvatar = avatarToUse;
                
                // 初始化聊天输入框
                initChatInput();

                // 初始化工具栏滑动事件
                initChatAddMenuSwipe();

                // 清空聊天内容并使用分页加载
                const chatContent = document.getElementById('chatContent');
                if (chatContent) {
                    chatContent.innerHTML = '';

                    // 重置上一条消息的时间戳
                    lastMessageTimestamp = null;

                    // 重置已显示消息数量
                    currentDisplayedMessages = 0;
                    
                    // 【虚拟列表】重置虚拟列表管理器
                    VirtualListManager.reset();
                    
                    // 【虚拟列表】重置分页状态
                    loadedMessageCount = 0;
                    hasMoreMessages = true;
                    currentChatMessagesCache = [];
                    currentChatMessageIndex.clear(); // 【性能优化】清空索引
                    
                    // 【性能优化】清除消息缓存
                    clearCurrentChatMessagesCache();

                    // 使用分页加载显示消息
                    await refreshChatInterface();
                }

                // 更新聊天背景
                updateChatBackground();
                
                // 【修改】不再自动启动后台活动定时器
                // startBackgroundActivityTimer();
                
                // 直接滚动到聊天记录底部（无动画）
                if (chatContent) {
                    chatContent.scrollTop = chatContent.scrollHeight;
                }
                
                // 【简化】使用标准方式处理键盘
                console.log('【简化】初始化键盘监听');
                
                // 只保留发送按钮的事件监听器，防止点击时键盘闪退
                try {
                    const chatSendBtn = document.getElementById('chatSendBtn');
                    if (chatSendBtn) {
                        // 【鸿蒙系统兼容】使用统一检测函数
                        const isHarmonyDevice = typeof checkIsHarmonyDevice === 'function' ? checkIsHarmonyDevice() : false;
                        
                        // 【防闪退】先移除可能存在的旧监听器，避免重复添加
                        chatSendBtn.removeEventListener('mousedown', preventDefaultOnSend);
                        chatSendBtn.removeEventListener('touchstart', preventDefaultOnSend);
                        chatSendBtn.removeEventListener('click', sendMessage);
                        
                        // 【鸿蒙系统兼容】鸿蒙系统使用特殊处理，避免触摸事件冲突
                        if (isHarmonyDevice) {
                            console.log('【鸿蒙兼容】使用特殊事件绑定发送按钮');
                            // 【关键】使用 onclick 属性替代 addEventListener，避免事件系统冲突
                            chatSendBtn.onclick = function(e) {
                                console.log('【鸿蒙兼容】发送按钮点击');
                                // 阻止默认行为和冒泡
                                if (e) {
                                    e.preventDefault();
                                    e.stopPropagation();
                                }
                                // 延迟执行，避免键盘冲突
                                setTimeout(() => {
                                    sendMessage();
                                }, 10);
                                return false;
                            };
                        } else {
                            chatSendBtn.onclick = null;
                            chatSendBtn.addEventListener('mousedown', preventDefaultOnSend);
                            chatSendBtn.addEventListener('touchstart', preventDefaultOnSend);
                        }
                    }
                } catch (e) {
                    console.warn('添加发送按钮事件监听器失败:', e);
                }
                
                // 【一加最终方案】强制固定顶栏位置，防止键盘顶上去
                console.log('【一加最终方案】初始化键盘保护');
                
                const chatInput = document.getElementById('chatInput');
                const chatHeader = document.getElementById('chatHeader');
                const chatTopSpacer = document.querySelector('.chat-top-spacer');
                
                // 【鸿蒙系统兼容】使用统一检测函数
                const isHarmonyDevice = typeof checkIsHarmonyDevice === 'function' ? checkIsHarmonyDevice() : false;
                
                // 【Capacitor Keyboard】配置键盘行为
                // 【鸿蒙系统兼容】鸿蒙系统禁用 Capacitor Keyboard 插件，避免闪退
                if (window.Capacitor?.Plugins?.Keyboard && !isHarmonyDevice) {
                    const Keyboard = window.Capacitor.Plugins.Keyboard;
                    console.log('【Capacitor Keyboard】配置键盘');
                    
                    // 设置键盘不调整 WebView 大小
                    Keyboard.setResizeMode({ mode: 'none' }).catch(e => {
                        console.warn('【Capacitor Keyboard】设置 resize mode 失败:', e);
                    });
                    
                    // 监听键盘显示事件
                    Keyboard.addListener('keyboardWillShow', (info) => {
                        console.log('【Capacitor Keyboard】键盘即将显示:', info);
                        forceResetHeaderPosition();
                    });
                    
                    // 监听键盘隐藏事件
                    Keyboard.addListener('keyboardWillHide', () => {
                        console.log('【Capacitor Keyboard】键盘即将隐藏');
                        forceResetHeaderPosition();
                    });
                } else if (isHarmonyDevice) {
                    console.log('【鸿蒙兼容】禁用 Capacitor Keyboard 插件，避免闪退');
                }
                
                // 【关键】强制重置顶栏位置的函数
                function forceResetHeaderPosition() {
                    if (chatHeader) {
                        chatHeader.style.position = 'fixed';
                        chatHeader.style.top = '30px';
                        chatHeader.style.left = '0';
                        chatHeader.style.right = '0';
                        chatHeader.style.transform = 'translateZ(0)';
                        chatHeader.style.webkitTransform = 'translateZ(0)';
                    }
                    if (chatTopSpacer) {
                        chatTopSpacer.style.position = 'fixed';
                        chatTopSpacer.style.top = '0';
                        chatTopSpacer.style.left = '0';
                        chatTopSpacer.style.right = '0';
                        chatTopSpacer.style.transform = 'translateZ(0)';
                        chatTopSpacer.style.webkitTransform = 'translateZ(0)';
                    }
                }
                
                if (chatInput) {
                    // 【关键修复】不再在这里绑定 focus 事件，统一由 initChatInput 处理
                    // 避免重复绑定导致事件处理函数被执行多次
                    // initChatInput 中的 chatInputFocusHandler 已经处理了焦点逻辑
                    
                    // 【关键修复】移除所有可能导致卡顿的监听器
                    // 不使用 ResizeObserver、visualViewport 监听和定时器
                    // 这些会导致输入时频繁重绘，造成卡顿和闪退
                    
                    // 只在失去焦点时清理，不做其他操作
                    chatInput.addEventListener('blur', () => {
                        console.log('【性能优化】输入框失去焦点');
                    }, { passive: true });
                }
                
            } catch (error) {
                console.error('打开聊天界面时出错:', error);
            }
        }

        // 关闭聊天界面
        // 关闭聊天界面
        function closeChatInterface() {
            // 【防闪退】添加try-catch包裹整个函数
            try {
                console.log('【防闪退】关闭聊天界面开始');

                const chatInterface = document.getElementById('chatInterface');
                if (chatInterface) {
                    chatInterface.style.display = 'none';
                    currentChatId = null;
                    currentChatAvatar = null;
                    console.log('【防闪退】聊天界面已隐藏');
                }

                // 注意：不要在这里停止后台活动定时器
                // 后台活动应该在软件打开期间持续运行

                // 显示微信页面（聊天列表）
                const wechatPage = document.getElementById('wechatPage');
                if (wechatPage) {
                    wechatPage.style.display = 'flex';
                    console.log('【防闪退】微信页面已显示');
                }

                // 关闭语音输入模式
                if (typeof isVoiceInputMode !== 'undefined' && isVoiceInputMode && typeof closeVoiceInput === 'function') {
                    closeVoiceInput();
                }
                
                // 【修复】重置键盘状态
                if (window.keyboardState) {
                    window.keyboardState.isKeyboardOpen = false;
                    window.keyboardState.isProcessing = false;
                    console.log('【修复】重置键盘状态');
                }
                
                // 【修复】清除键盘防抖定时器
                if (window.keyboardResizeTimeout) {
                    clearTimeout(window.keyboardResizeTimeout);
                    window.keyboardResizeTimeout = null;
                }

                // 移除 resize 事件监听器
                if (window.chatResizeListener) {
                    try {
                        window.removeEventListener('resize', window.chatResizeListener);
                        window.chatResizeListener = null;
                        console.log('【防闪退】移除 resize 事件监听器');
                    } catch (e) {
                        console.warn('【防闪退】移除 resize 监听器失败:', e);
                    }
                }

                // 恢复页面高度设置
                try {
                    document.documentElement.style.height = '100vh';
                    document.body.style.height = '100vh';
                    document.documentElement.style.overflow = 'auto';
                    document.body.style.overflow = 'auto';
                } catch (e) {
                    console.warn('【防闪退】恢复页面高度设置失败:', e);
                }

                // 【修复】移除键盘监听器
                if (window.chatKeyboardHandler) {
                    try {
                        if (window.visualViewport) {
                            window.visualViewport.removeEventListener('resize', window.chatKeyboardHandler);
                            window.visualViewport.removeEventListener('scroll', window.chatKeyboardHandler);
                        } else {
                            window.removeEventListener('resize', window.chatKeyboardHandler);
                        }
                        window.chatKeyboardHandler = null;
                        console.log('【修复】移除键盘监听器');
                    } catch (error) {
                        console.error('【修复】移除键盘监听器失败:', error);
                    }
                }

                // 移除发送按钮事件监听器
                try {
                    const chatSendBtn = document.getElementById('chatSendBtn');
                    if (chatSendBtn) {
                        // 【鸿蒙系统兼容】使用统一检测函数
                        const isHarmonyDevice = typeof checkIsHarmonyDevice === 'function' ? checkIsHarmonyDevice() : false;
                        
                        if (isHarmonyDevice) {
                            // 【鸿蒙兼容】清除 onclick 属性
                            chatSendBtn.onclick = null;
                            console.log('【鸿蒙兼容】清除发送按钮 onclick 属性');
                        } else if (typeof preventDefaultOnSend === 'function') {
                            chatSendBtn.removeEventListener('mousedown', preventDefaultOnSend);
                            chatSendBtn.removeEventListener('touchstart', preventDefaultOnSend);
                            console.log('【防闪退】移除发送按钮事件监听器');
                        }
                    }
                } catch (e) {
                    console.warn('【防闪退】移除发送按钮监听器失败:', e);
                }

                // 【性能优化】清理聊天页面资源
                if (typeof cleanupChatResources === 'function') {
                    cleanupChatResources();
                }

                // 【防闪退】停止正在播放的音频
                if (typeof AudioManager !== 'undefined' && AudioManager) {
                    try {
                        AudioManager.stopCurrent();
                        console.log('【防闪退】已停止音频播放');
                    } catch (e) {
                        console.warn('【防闪退】停止音频播放失败:', e);
                    }
                }

                // 【防闪退】重置滚动管理器状态
                if (typeof ChatScrollManager !== 'undefined' && ChatScrollManager) {
                    ChatScrollManager.reset();
                    console.log('【防闪退】已重置滚动管理器');
                }

                // 【内存优化】清理聊天内容DOM，释放内存
                const chatContent = document.getElementById('chatContent');
                if (chatContent) {
                    chatContent.innerHTML = '';
                }
                
                // 【内存优化】重置消息缓存和计数
                currentChatMessagesCache = [];
                currentChatMessageIndex.clear(); // 【性能优化】清空索引
                loadedMessageCount = 0;
                totalMessageCount = 0;
                hasMoreMessages = true;
                isLoadingMoreMessages = false;
                scrollListenerSetup = false;

                console.log('【防闪退】关闭聊天界面完成');

            } catch (error) {
                console.error('【防闪退】closeChatInterface 发生错误:', error);
                // 即使出错也尝试显示微信页面
                try {
                    const wechatPage = document.getElementById('wechatPage');
                    if (wechatPage) {
                        wechatPage.style.display = 'flex';
                    }
                } catch (e) {
                    // 忽略
                }
            }
        }

        // 【性能优化】清理聊天页面资源
        function cleanupChatResources() {
            console.log('【性能优化】开始清理聊天页面资源...');

            // 清理懒加载观察器
            cleanupLazyLoadObserver();

            // 清空消息缓存
            currentChatMessagesCache = [];
            currentChatMessageIndex.clear(); // 【性能优化】清空索引
            loadedMessageCount = 0;
            hasMoreMessages = true;
            isLoadingMoreMessages = false;

            // 清空聊天内容区域，释放DOM节点
            const chatContent = document.getElementById('chatContent');
            if (chatContent) {
                // 移除所有图片的src，释放内存
                const images = chatContent.querySelectorAll('img');
                images.forEach(img => {
                    img.src = '';
                    img.removeAttribute('src');
                });

                // 清空内容
                chatContent.innerHTML = '';
                console.log('【性能优化】聊天内容区域已清空');
            }

            // 强制垃圾回收提示（虽然JS没有直接的GC调用，但可以提示浏览器）
            if (window.gc) {
                try {
                    window.gc();
                    console.log('【性能优化】已触发垃圾回收');
                } catch (e) {
                    // 忽略错误
                }
            }

            console.log('【性能优化】聊天页面资源清理完成');
        }

        // 防止发送按钮点击时键盘闪退的函数
        function preventDefaultOnSend(event) {
            console.log('发送按钮事件:', event.type);
            
            // 【鸿蒙系统兼容】使用统一检测函数
            const isHarmonyDevice = checkIsHarmonyDevice();
            
            if (isHarmonyDevice) {
                console.log('【鸿蒙兼容】检测到鸿蒙/华为/荣耀设备，使用特殊处理');
            }
            
            // 【防闪退】防止触摸设备上重复触发
            if (event.type === 'mousedown' && 'ontouchstart' in window) {
                return; // 触摸设备上忽略 mousedown
            }
            
            // 【鸿蒙系统兼容】鸿蒙系统不过度阻止默认行为，避免闪退
            if (!isHarmonyDevice) {
                // 调用 preventDefault() 防止输入框失焦
                event.preventDefault();
                console.log('已调用 preventDefault()，防止输入框失焦');
            } else {
                // 【鸿蒙兼容】只阻止默认行为，但不阻止冒泡
                event.preventDefault();
                console.log('【鸿蒙兼容】已调用 preventDefault()');
            }
            
            // 【鸿蒙系统兼容】添加延迟，避免事件冲突导致闪退
            if (isHarmonyDevice) {
                setTimeout(() => {
                    console.log('【鸿蒙兼容】延迟调用 sendMessage()');
                    sendMessage();
                }, 50);
            } else {
                // 直接调用发送消息函数
                sendMessage();
                console.log('直接调用 sendMessage() 发送消息');
            }
        }
        
        // 打开聊天信息弹窗（点击三点菜单时调用）
        function openChatSettings() {
            // 【防闪退】添加try-catch包裹
            try {
                if (!currentChatId) {
                    showCustomAlert('提示', '请先选择一个聊天', 'info');
                    return;
                }

                if (!relationshipData || !relationshipData.wechatChatList) {
                    showCustomAlert('错误', '数据未初始化，请刷新页面重试', 'error');
                    return;
                }

                const chatItem = relationshipData.wechatChatList.find(item => item.id == currentChatId);
                if (!chatItem) {
                    showCustomAlert('错误', '未找到聊天信息', 'error');
                    return;
                }

                // 判断是群聊还是单聊
                const isGroupChat = chatItem.isGroupChat;

                // 控制显示/隐藏单聊和群聊的不同区域
                const singleChatMembers = document.getElementById('singleChatMembers');
                const groupChatMembers = document.getElementById('groupChatMembers');
                const groupChatInfoSection = document.getElementById('groupChatInfoSection');
                const singleChatFeatures = document.getElementById('singleChatFeatures');

                if (isGroupChat) {
                    // 群聊模式
                    if (singleChatMembers) singleChatMembers.style.display = 'none';
                    if (groupChatMembers) groupChatMembers.style.display = 'block';
                    if (groupChatInfoSection) groupChatInfoSection.style.display = 'block';
                    if (singleChatFeatures) singleChatFeatures.style.display = 'none';

                    // 加载群聊成员头像
                    loadGroupChatMembersInInfo(chatItem);

                    // 加载群聊名称和公告
                    const groupChatNameDisplay = document.getElementById('groupChatNameDisplay');
                    const groupChatNoticeDisplay = document.getElementById('groupChatNoticeDisplay');
                    if (groupChatNameDisplay) {
                        groupChatNameDisplay.textContent = chatItem.name || chatItem.remark || '未命名群聊';
                    }
                    if (groupChatNoticeDisplay) {
                        groupChatNoticeDisplay.textContent = chatItem.notice || '暂无公告';
                    }
                } else {
                    // 单聊模式
                    if (singleChatMembers) singleChatMembers.style.display = 'block';
                    if (groupChatMembers) groupChatMembers.style.display = 'none';
                    if (groupChatInfoSection) groupChatInfoSection.style.display = 'none';
                    if (singleChatFeatures) singleChatFeatures.style.display = 'block';

                    // 更新单聊AI头像和名称
                    const chatInfoAiAvatar = document.getElementById('chatInfoAiAvatar');
                    const chatInfoAiName = document.getElementById('chatInfoAiName');
                    
                    if (chatInfoAiAvatar) {
                        chatInfoAiAvatar.src = chatItem.avatar || 'https://img.58sb.cn/file/img/V7Ucqzhl.jpg';
                    }
                    if (chatInfoAiName) {
                        chatInfoAiName.textContent = chatItem.remark || chatItem.name || 'AI';
                    }

                    // 更新思念数量徽章
                    updateMissYouCountBadge();
                }

                // 加载打字无障碍设置
                loadAccessibilityInputSetting();

                // 显示聊天信息弹窗
                const chatInfoModal = document.getElementById('chatInfoModal');
                if (chatInfoModal) {
                    chatInfoModal.classList.add('active');
                }

            } catch (error) {
                showCustomAlert('错误', '打开聊天信息时出错: ' + error.message, 'error');
            }
        }

        // 加载群聊成员头像到聊天信息弹窗
        function loadGroupChatMembersInInfo(chatItem) {
            const membersGrid = document.getElementById('groupChatMembersGrid');
            const memberCountDiv = document.getElementById('groupChatMemberCount');
            
            if (!membersGrid) return;

            // 清空现有成员（保留添加按钮）
            const addBtn = membersGrid.querySelector('.chat-info-add-btn');
            membersGrid.innerHTML = '';

            // 构建成员列表：用户 + 群成员
            const allMembers = [];
            
            // 添加用户到第一位
            const userAvatar = relationshipData.avatar1 || cachedPersonalProfile?.avatar;
            if (userAvatar) {
                allMembers.push({
                    id: 'user',
                    name: cachedPersonalProfile?.name || cachedPersonalProfile?.nickname || '我',
                    remark: '我',
                    avatar: userAvatar,
                    isUser: true
                });
            }

            // 添加其他群成员
            if (chatItem.members && Array.isArray(chatItem.members)) {
                chatItem.members.forEach(member => {
                    if (member && member.id !== 'user') {
                        // 从原始聊天项获取最新头像
                        const originalChatItem = relationshipData.wechatChatList.find(item => item.id == member.id);
                        allMembers.push({
                            id: member.id,
                            name: member.name,
                            remark: member.remark,
                            avatar: originalChatItem ? originalChatItem.avatar : member.avatar
                        });
                    }
                });
            }

            // 生成成员头像HTML（最多显示9个）
            const membersToShow = allMembers.slice(0, 9);
            membersToShow.forEach(member => {
                const memberItem = document.createElement('div');
                memberItem.className = 'chat-info-member-item';
                
                const isEmoji = member.avatar && member.avatar.length <= 2 && /\p{Emoji}/u.test(member.avatar);
                let avatarHtml = '';
                
                if (isEmoji) {
                    avatarHtml = `<div class="chat-info-member-avatar" style="font-size: 32px; display: flex; align-items: center; justify-content: center;">${member.avatar}</div>`;
                } else if (isValidImageUrl(member.avatar)) {
                    avatarHtml = `<img class="chat-info-member-avatar" src="${member.avatar}" alt="${member.remark}" onerror="this.src='https://img.58sb.cn/file/img/V7Ucqzhl.jpg'">`;
                } else {
                    avatarHtml = `<div class="chat-info-member-avatar" style="background: #e0e0e0; display: flex; align-items: center; justify-content: center; color: #999; font-size: 12px;">头像</div>`;
                }
                
                memberItem.innerHTML = `
                    ${avatarHtml}
                    <span class="chat-info-member-name">${member.remark || member.name}</span>
                `;
                
                membersGrid.appendChild(memberItem);
            });

            // 添加添加按钮
            if (addBtn) {
                membersGrid.appendChild(addBtn);
            }

            // 更新成员数量显示
            if (memberCountDiv) {
                memberCountDiv.textContent = `共 ${allMembers.length} 人`;
            }
        }

        // 编辑群聊名称
        function editGroupChatName() {
            const chatItem = relationshipData.wechatChatList.find(item => item.id == currentChatId);
            if (!chatItem || !chatItem.isGroupChat) return;

            const newName = prompt('请输入新的群聊名称:', chatItem.name || chatItem.remark || '');
            if (newName !== null && newName.trim() !== '') {
                chatItem.name = newName.trim();
                chatItem.remark = newName.trim();
                
                // 更新显示
                const groupChatNameDisplay = document.getElementById('groupChatNameDisplay');
                if (groupChatNameDisplay) {
                    groupChatNameDisplay.textContent = chatItem.name;
                }
                
                // 保存数据
                saveData();
                
                // 刷新聊天列表
                renderWeChatChatList();
                
                showToast('群聊名称已更新');
            }
        }

        // 编辑群公告
        function editGroupChatNotice() {
            const chatItem = relationshipData.wechatChatList.find(item => item.id == currentChatId);
            if (!chatItem || !chatItem.isGroupChat) return;

            const newNotice = prompt('请输入群公告:', chatItem.notice || '');
