        // ==================== 统一数据读写包装函数 ====================
        // 这些函数优先使用 SQLite，如果不可用则降级到 localforage/localStorage
        
        // 统一的设置保存函数
        async function saveAppSettings(settings) {
            try {
                let sqliteSuccess = false;
                let localforageSuccess = false;

                // 【优先使用 SQLite】兼容旧版本
                if (SQLiteManager.isAvailable) {
                    try {
                        sqliteSuccess = await SQLiteManager.setSetting('appSettings', settings);
                        if (sqliteSuccess) {
                            console.log('✅ 设置已保存到 SQLite');
                        }
                    } catch (e) {
                        console.warn('⚠️ SQLite保存失败:', e);
                    }
                }

                // 【关键修复】同时保存到 localforage，确保其他页面（如气运之门）能读取到
                try {
                    await localforage.setItem('appSettings', settings);
                    localforageSuccess = true;
                    console.log('✅ 设置已保存到 localforage');
                } catch (e) {
                    console.warn('⚠️ localforage保存失败:', e);
                }

                // 同时保存到 localStorage 作为后备
                try {
                    localStorage.setItem('appSettings', JSON.stringify(settings));
                    console.log('✅ 设置已保存到 localStorage');
                } catch (e) {
                    console.warn('⚠️ localStorage保存失败:', e);
                }

                // 只要有一种方式成功就返回 true
                if (sqliteSuccess || localforageSuccess) {
                    return true;
                }

                console.error('❌ 所有存储方式都失败');
                return false;

            } catch (error) {
                console.error('❌ 保存设置失败:', error);
                return false;
            }
        }

        // 统一的设置读取函数
        async function loadAppSettings(defaultValue = {}) {
            try {
                // 【优先使用 SQLite】兼容旧版本数据
                if (SQLiteManager.isAvailable) {
                    const settings = await SQLiteManager.getSetting('appSettings', null);
                    if (settings) {
                        console.log('✅ 设置已从 SQLite 加载');
                        return settings;
                    }
                }

                // 降级到 localforage
                const settings = await localforage.getItem('appSettings');
                if (settings) {
                    console.log('✅ 设置已从 localforage 加载（降级方案）');
                    return settings;
                }

                // 最后尝试 localStorage
                const localData = localStorage.getItem('appSettings');
                if (localData) {
                    console.log('✅ 设置已从 localStorage 加载（后备方案）');
                    return JSON.parse(localData);
                }

                return defaultValue;
            } catch (error) {
                console.error('❌ 加载设置失败:', error);
                return defaultValue;
            }
        }
        
        // 统一的日记数据保存函数
        async function saveDiaryDataUnified(diaryData) {
            try {
                if (SQLiteManager.isAvailable) {
                    const success = await SQLiteManager.saveDiaryData(diaryData);
                    if (success) {
                        console.log('✅ 日记数据已保存到 SQLite');
                        return true;
                    }
                }
                // 【修复】SQLite 失败时保存到 localforage，而不是递归调用
                await localforage.setItem('diaryData', diaryData);
                console.log('✅ 日记数据已保存到 localforage（降级方案）');
                return true;
            } catch (error) {
                console.error('❌ 保存日记数据失败:', error);
                return false;
            }
        }
        
        // 统一的日记数据读取函数
        async function loadDiaryDataUnified(defaultValue = []) {
            try {
                if (SQLiteManager.isAvailable) {
                    const data = await SQLiteManager.getDiaryData();
                    if (data && data.length > 0) {
                        console.log('✅ 日记数据已从 SQLite 加载');
                        return data;
                    }
                }
                // 降级方案：直接使用 localforage
                const data = await localforage.getItem('myDiaryData');
                if (data) {
                    console.log('✅ 日记数据已从 localforage 加载（降级方案）');
                    return data;
                }
                return defaultValue;
            } catch (error) {
                console.error('❌ 加载日记数据失败:', error);
                return defaultValue;
            }
        }
        
        // 统一的日记封面设置保存函数 - 仿照主屏幕背景保存机制
        async function saveDiaryCoverSettingsUnified(settings) {
            try {
                // 先保存所有自定义封面图片到 IndexedDB（像主屏幕背景一样）
                for (const key in settings) {
                    if (settings[key].cover === 'custom' && settings[key].customCoverUrl) {
                        const imageKey = `diary_cover_${key}`;
                        await saveImageToDB(imageKey, settings[key].customCoverUrl);
                    }
                }
                
                // 保存设置（包含图片引用标记）到 localforage
                // 注意：不直接保存 base64 图片数据，只保存 cover 类型和 hasCustomCover 标记
                const settingsToSave = {};
                for (const key in settings) {
                    settingsToSave[key] = {
                        cover: settings[key].cover,
                        hasCustomCover: settings[key].cover === 'custom' && !!settings[key].customCoverUrl
                    };
                }
                
                await localforage.setItem('diaryCoverSettings_v3', settingsToSave);
                
                return true;
            } catch (error) {
                console.error('❌ 保存日记封面设置失败:', error);
                return false;
            }
        }
        
        // 统一的日记封面设置读取函数 - 仿照主屏幕背景加载机制
        async function loadDiaryCoverSettingsUnified(defaultValue = {}) {
            try {
                // 从 localforage 加载设置
                let settings = await localforage.getItem('diaryCoverSettings_v3');
                
                // 如果没有 v3 版本，尝试 v2 版本
                if (!settings) {
                    settings = await localforage.getItem('diaryCoverSettings_v2');
                }
                
                // 如果没有 v2 版本，尝试旧版本
                if (!settings) {
                    settings = await localforage.getItem('diaryCoverSettings');
                    if (settings) {
                        return settings;
                    }
                }
                
                if (settings && Object.keys(settings).length > 0) {
                    // 恢复完整设置（从 IndexedDB 加载图片）
                    const fullSettings = {};
                    for (const key in settings) {
                        fullSettings[key] = {
                            cover: settings[key].cover,
                            customCoverUrl: null
                        };
                        
                        // 如果有自定义封面，从 IndexedDB 加载图片（像主屏幕背景一样）
                        if (settings[key].hasCustomCover || settings[key].customCoverUrl) {
                            const imageKey = `diary_cover_${key}`;
                            const imageData = await loadImageFromDB(imageKey);
                            if (imageData) {
                                fullSettings[key].customCoverUrl = imageData;
                            }
                        }
                    }
                    
                    return fullSettings;
                }
                
                return defaultValue;
            } catch (error) {
                console.error('❌ 加载日记封面设置失败:', error);
                return defaultValue;
            }
        }
        
        // 统一的健康记录保存函数
        async function saveHealthDataUnified(key, value) {
            try {
                let sqliteSuccess = false;

                // 1. 尝试保存到 SQLite
                if (SQLiteManager.isAvailable) {
                    sqliteSuccess = await SQLiteManager.saveHealthData(key, value);
                    if (sqliteSuccess) {
                        console.log(`✅ 健康记录 ${key} 已保存到 SQLite`);
                    }
                }

                // 2. 【修复】同时保存到 localforage，确保数据一致性
                // 这样即使 SQLite 失败或下次从 localforage 读取，也能获取到最新数据
                await localforage.setItem(key, value);
                console.log(`✅ 健康记录 ${key} 已保存到 localforage`);

                return sqliteSuccess || true;
            } catch (error) {
                console.error(`❌ 保存健康记录 ${key} 失败:`, error);
                return false;
            }
        }
        
        // 统一的健康记录读取函数
        async function loadHealthDataUnified(key, defaultValue = null) {
            try {
                if (SQLiteManager.isAvailable) {
                    const data = await SQLiteManager.getHealthData(key, null);
                    if (data !== null) {
                        console.log(`✅ 健康记录 ${key} 已从 SQLite 加载`);
                        return data;
                    }
                }
                const data = await localforage.getItem(key);
                if (data !== null) {
                    console.log(`✅ 健康记录 ${key} 已从 localforage 加载（降级方案）`);
                    return data;
                }
                return defaultValue;
            } catch (error) {
                console.error(`❌ 加载健康记录 ${key} 失败:`, error);
                return defaultValue;
            }
        }
        
