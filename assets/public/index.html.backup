        // 打开今日备忘弹窗
        function openTodayMemo() {
            const modal = document.getElementById('todayMemoModal');
            renderTodayMemoFullList();
            modal.classList.add('show');
        }

        // 关闭今日备忘弹窗
        function closeTodayMemoModal() {
            const modal = document.getElementById('todayMemoModal');
            modal.classList.remove('show');
        }

        // 渲染今日备忘完整列表
        function renderTodayMemoFullList() {
            const container = document.getElementById('todayMemoFullList');
            if (todayMemos.length === 0) {
                container.innerHTML = `
                    <div class="memo-detail-empty">
                        <div class="memo-detail-empty-icon">📝</div>
                        <div>暂无备忘</div>
                        <div style="font-size: 12px; margin-top: 8px;">点击下方按钮添加</div>
                    </div>
                `;
            } else {
                container.innerHTML = todayMemos.map(memo => `
                    <div class="memo-detail-item today-memo-item ${memo.checked ? 'checked' : ''}">
                        <input type="checkbox" class="memo-detail-checkbox" 
                            ${memo.checked ? 'checked' : ''} 
                            onchange="toggleTodayMemoFromModal(${memo.id})">
                        <div class="memo-detail-item-text">${memo.text}</div>
                    </div>
                `).join('');
            }
        }

        // 从弹窗切换备忘状态
        async function toggleTodayMemoFromModal(id) {
            const memo = todayMemos.find(m => m.id === id);
            if (memo) {
                memo.checked = !memo.checked;
                await saveMemoDataUnified('memo_today', todayMemos);
                renderTodayMemoFullList();
                updateTodayMemoList(todayMemos);
            }
        }

        // 从弹窗添加今日备忘
        async function addTodayMemoFromModal() {
            const text = prompt('请输入今日备忘：');
            if (text && text.trim()) {
                const newMemo = {
                    id: nextMemoId++,
                    text: text.trim(),
                    checked: false
                };
                todayMemos.push(newMemo);
                await saveMemoDataUnified('memo_today', todayMemos);
                await saveMemoDataUnified('memo_today_nextId', nextMemoId);
                renderTodayMemoFullList();
                updateTodayMemoList(todayMemos);
            }
        }

        // 管理超级备忘录工具 - 供AI调用
        async function manageSuperMemoTool(args) {
            try {
                const { category, action, content, id } = args;
                console.log('【管理备忘录】', category, action, content, id);

                switch (category) {
                    case 'house_rule':
                        return await manageHouseRule(action, content, id);
                    case 'today_memo':
                        return await manageTodayMemo(action, content, id);
                    case 'violation':
                        return await manageViolation(action, content, id);
                    default:
                        return { success: false, error: '未知的类别' };
                }
            } catch (error) {
                console.error('管理备忘录失败:', error);
                return { success: false, error: error.message };
            }
        }

        // 管理家规
        async function manageHouseRule(action, content, id) {
            let rules = await loadMemoDataUnified('memo_houseRules') || [];

            switch (action) {
                case 'add':
                    if (!content || !content.trim()) {
                        return { success: false, error: '家规内容不能为空' };
                    }
                    rules.push(content.trim());
                    await saveMemoDataUnified('memo_houseRules', rules);
                    // 更新UI
                    updateHouseRulesPreview(rules);
                    return { success: true, message: '家规已添加', data: rules };

                case 'delete':
                    if (id === undefined || id < 0 || id >= rules.length) {
                        return { success: false, error: '无效的家规ID' };
                    }
                    const deletedRule = rules.splice(id, 1)[0];
                    await saveMemoDataUnified('memo_houseRules', rules);
                    // 更新UI
                    updateHouseRulesPreview(rules);
                    return { success: true, message: `家规"${deletedRule}"已删除`, data: rules };

                case 'list':
                    return { success: true, data: rules };

                default:
                    return { success: false, error: '未知的操作' };
            }
        }

        // 管理今日备忘
        async function manageTodayMemo(action, content, id) {
            // 检查日期，如果是新的一天则清空
            await checkAndClearTodayMemos();

            switch (action) {
                case 'add':
                    if (!content || !content.trim()) {
                        return { success: false, error: '备忘内容不能为空' };
                    }
                    const newMemo = {
                        id: nextMemoId++,
                        text: content.trim(),
                        checked: false
                    };
                    todayMemos.push(newMemo);
                    await saveMemoDataUnified('memo_today', todayMemos);
                    await saveMemoDataUnified('memo_today_nextId', nextMemoId);
                    await saveMemoDataUnified('memo_today_date', new Date().toDateString());
                    // 更新UI
                    updateTodayMemoList(todayMemos);
                    return { success: true, message: '备忘已添加', data: todayMemos };

                case 'delete':
                    const memoIndex = todayMemos.findIndex(m => m.id === id);
                    if (memoIndex === -1) {
                        return { success: false, error: '未找到该备忘' };
                    }
                    const deletedMemo = todayMemos.splice(memoIndex, 1)[0];
                    await saveMemoDataUnified('memo_today', todayMemos);
                    // 更新UI
                    updateTodayMemoList(todayMemos);
                    return { success: true, message: `备忘"${deletedMemo.text}"已删除`, data: todayMemos };

                case 'list':
                    return { success: true, data: todayMemos };

                default:
                    return { success: false, error: '未知的操作' };
            }
        }

        // 管理违规记录
        async function manageViolation(action, content, id) {
            let violations = await loadMemoDataUnified('memo_violations') || [];

            switch (action) {
                case 'add':
                    if (!content || !content.trim()) {
                        return { success: false, error: '违规记录不能为空' };
                    }
                    const newViolation = {
                        id: Date.now(),
                        date: new Date().toLocaleDateString('zh-CN'),
                        reason: content.trim(),
                        timestamp: Date.now()
                    };
                    violations.push(newViolation);
                    await saveMemoDataUnified('memo_violations', violations);
                    // 更新UI
                    updateViolationsList(violations);
                    return { success: true, message: '违规记录已添加', data: violations };

                case 'delete':
                    const violationIndex = violations.findIndex(v => v.id === id);
                    if (violationIndex === -1) {
                        return { success: false, error: '未找到该违规记录' };
                    }
                    const deletedViolation = violations.splice(violationIndex, 1)[0];
                    await saveMemoDataUnified('memo_violations', violations);
                    // 更新UI
                    updateViolationsList(violations);
                    return { success: true, message: `违规记录"${deletedViolation.reason}"已删除`, data: violations };

                case 'list':
                    return { success: true, data: violations };

                default:
                    return { success: false, error: '未知的操作' };
            }
        }

        // 打开监护人选择器
        function openGuardianSelector() {
            const modal = document.getElementById('guardianSelectorModal');
            modal.classList.add('show');
            renderGuardianList();
        }

        // 关闭监护人选择器
        function closeGuardianSelector() {
            const modal = document.getElementById('guardianSelectorModal');
            modal.classList.remove('show');
        }

        // 渲染监护人列表
        async function renderGuardianList() {
            const container = document.getElementById('guardianList');
            container.innerHTML = '';

            // 获取当前选中的监护人
            const currentGuardian = await loadMemoDataUnified('memo_guardian_id');

            // 从微信列表获取角色
            const characters = relationshipData.wechatChatList || [];

            if (characters.length === 0) {
                container.innerHTML = '<div style="text-align: center; color: #999; padding: 20px;">暂无角色，请先添加微信角色</div>';
                return;
            }

            characters.forEach(char => {
                const item = document.createElement('div');
                item.className = 'guardian-item' + (currentGuardian === char.id.toString() ? ' selected' : '');
                item.onclick = () => selectGuardian(char);

                const avatar = char.avatar || 'https://api.dicebear.com/7.x/avataaars/svg?seed=' + char.name;

                item.innerHTML = `
                    <img src="${avatar}" alt="${char.name}" class="guardian-item-avatar">
                    <div class="guardian-item-info">
                        <div class="guardian-item-name">${char.name}</div>
                        <div class="guardian-item-remark">${char.remark || '点击选择为监护人'}</div>
                    </div>
                    <div class="guardian-item-check"></div>
                `;

                container.appendChild(item);
            });
        }

        // 选择监护人
        async function selectGuardian(character) {
            try {
                // 保存到 localforage（支持大容量存储）
                await saveMemoDataUnified('memo_guardian_id', character.id);
                await saveMemoDataUnified('memo_guardian_name', character.name);
                await saveMemoDataUnified('memo_guardian_avatar', character.avatar || '');

                // 更新UI
                updateGuardianAvatar(character);

                // 关闭弹窗
                closeGuardianSelector();

                console.log('已选择监护人:', character.name);
            } catch (error) {
                console.error('选择监护人失败:', error);
                alert('选择失败，请重试');
            }
        }

        // 更新监护人头像显示
        function updateGuardianAvatar(character) {
            const avatarImg = document.getElementById('guardianAvatarImg');
            const placeholder = document.getElementById('guardianPlaceholder');

            if (character && character.avatar) {
                avatarImg.src = character.avatar;
                avatarImg.style.display = 'block';
                placeholder.style.display = 'none';
            } else if (character) {
                // 使用默认头像
                avatarImg.src = 'https://api.dicebear.com/7.x/avataaars/svg?seed=' + character.name;
                avatarImg.style.display = 'block';
                placeholder.style.display = 'none';
            }
        }

        // 加载已保存的监护人
        async function loadGuardian() {
            try {
                const guardianId = await loadMemoDataUnified('memo_guardian_id');
                if (guardianId) {
                    const guardianName = await loadMemoDataUnified('memo_guardian_name');
                    const guardianAvatar = await loadMemoDataUnified('memo_guardian_avatar');
                    updateGuardianAvatar({
                        id: guardianId,
                        name: guardianName,
                        avatar: guardianAvatar
                    });
                }
            } catch (error) {
                console.error('加载监护人失败:', error);
            }
        }

        // ==================== 备忘录装饰功能 ====================

        // 打开装饰设置弹窗
        async function openMemoDecorateModal() {
            const modal = document.getElementById('memoDecorateModal');
            if (modal) {
                modal.classList.add('show');
                // 加载当前背景预览
                await loadMemoDecoratePreviews();
            }
        }

        // 关闭装饰设置弹窗
        function closeMemoDecorateModal() {
