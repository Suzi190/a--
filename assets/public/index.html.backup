                        flex: 1;
                        display: flex;
                        align-items: center;
                        gap: 10px;
                    }
                    .dm-avatar {
                        width: 36px;
                        height: 36px;
                        border-radius: 50%;
                        background: #f0f0f0;
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        font-size: 18px;
                        overflow: hidden;
                    }
                    .dm-name {
                        font-size: 16px;
                        font-weight: 600;
                        color: #333;
                    }
                    .dm-more-btn {
                        width: 40px;
                        height: 40px;
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        cursor: pointer;
                    }
                    .dm-more-btn svg {
                        width: 24px;
                        height: 24px;
                        fill: #666;
                    }
                    .dm-content {
                        flex: 1;
                        overflow-y: auto;
                        padding: 16px;
                        display: flex;
                        flex-direction: column;
                        gap: 16px;
                    }
                    .dm-message {
                        display: flex;
                        align-items: flex-end;
                        gap: 8px;
                        max-width: 80%;
                    }
                    .dm-message.sent {
                        align-self: flex-end;
                        flex-direction: row-reverse;
                    }
                    .dm-message.received {
                        align-self: flex-start;
                    }
                    .dm-message-content {
                        display: flex;
                        flex-direction: column;
                        max-width: calc(100% - 44px);
                    }
                    .dm-message-avatar {
                        width: 36px;
                        height: 36px;
                        border-radius: 50%;
