        onerror="window.__libsLoaded.mathjax = false; console.error('【MathJax】CDN加载失败')"></script>
    
    <!-- 【白屏检测】页面加载状态监控 -->
    <script>
        // 记录加载开始时间
        window.__appLoadStart = Date.now();
        window.__appLoadStatus = 'loading';
        
        // 白屏检测 - 如果5秒后页面没有内容，显示错误信息
        window.__whiteScreenCheck = setTimeout(function() {
            const body = document.body;
            const hasContent = body && (body.innerText || '').trim().length > 50;
            
            if (!hasContent || !window.__appLoadStatus === 'loaded') {
                // 创建错误提示界面
                const errorDiv = document.createElement('div');
                errorDiv.id = 'white-screen-error';
                errorDiv.style.cssText = 'position:fixed;top:0;left:0;width:100%;height:100%;background:#f5f7fa;z-index:99999;display:flex;flex-direction:column;justify-content:center;align-items:center;padding:20px;font-family:sans-serif;';
                errorDiv.innerHTML = 
                    '<div style="text-align:center;max-width:400px;">' +
                    '<h2 style="color:#333;margin-bottom:20px;">页面加载遇到问题</h2>' +
                    '<p style="color:#666;margin-bottom:15px;">可能是以下原因导致：</p>' +
                    '<ul style="text-align:left;color:#666;margin-bottom:20px;">' +
                    '<li>网络连接不稳定</li>' +
                    '<li>系统资源不足</li>' +
                    '<li>应用需要更新</li>' +
                    '</ul>' +
                    '<button onclick="location.reload()" style="padding:12px 30px;background:#4CAF50;color:white;border:none;border-radius:25px;font-size:16px;cursor:pointer;">重新加载</button>' +
                    '<p style="color:#999;margin-top:20px;font-size:12px;">如果问题持续，请尝试清除应用数据或重新安装</p>' +
                    '</div>';
                
                if (document.body) {
                    document.body.appendChild(errorDiv);
                } else {
                    document.addEventListener('DOMContentLoaded', function() {
                        document.body.appendChild(errorDiv);
                    });
                }
            }
        }, 8000); // 8秒后检测
        
        // 标记页面加载完成
        window.addEventListener('load', function() {
            window.__appLoadStatus = 'loaded';
            clearTimeout(window.__whiteScreenCheck);
            
            // 移除错误提示（如果存在）
            const errorDiv = document.getElementById('white-screen-error');
            if (errorDiv) {
                errorDiv.remove();
            }
        });
    </script>
    
