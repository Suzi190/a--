        function confirmRemark() {
            const remark = document.getElementById('friendRemark').value;
            if (remark) {
                // 存储备注，打开第二个弹窗
                window.friendRemark = remark;
                document.getElementById('addFriendModal').style.display = 'none';
                document.getElementById('setNameModal').style.display = 'flex';
            } else {
                alert('请输入备注');
            }
        }

        function confirmName() {
            const name = document.getElementById('friendName').value;
            if (name) {
                // 存储真名，创建角色卡片
                const remark = window.friendRemark;
                createChatItem(remark, name);
                // 关闭弹窗
                document.getElementById('setNameModal').style.display = 'none';
                // 清空输入框
                document.getElementById('friendRemark').value = '';
                document.getElementById('friendName').value = '';
                window.friendRemark = '';
            } else {
                alert('请输入真名');
            }
        }

        function createChatItem(remark, name) {
            const chatList = document.querySelector('.wechat-chat-list');
            if (!chatList) return;

            const avatar = '';
            
            // 保存到数据结构
            const chatData = {
                id: Date.now(),
                remark: remark,
                name: name,
                avatar: avatar,
                pinned: false, // 【修复】初始化置顶状态为false
                totalMessageCount: 0,
                summarizedMessageCount: 0,
                backgroundActivity: false,
                cooldown: 30,
                memories: []
            };
            relationshipData.wechatChatList.push(chatData);

            // 创建角色卡片
            const chatItem = document.createElement('div');
            chatItem.className = 'wechat-chat-item';
            chatItem.setAttribute('data-chat-id', chatData.id);
            
            // 创建名称和时间行
            const nameRowDiv = document.createElement('div');
            nameRowDiv.className = 'wechat-chat-name-row';
            nameRowDiv.style.cssText = 'display: flex; justify-content: space-between; align-items: center; margin-bottom: 2px;';
            
            const nameDiv = document.createElement('div');
            nameDiv.className = 'wechat-chat-name';
            nameDiv.textContent = remark;
            
            const timeDiv = document.createElement('div');
            timeDiv.className = 'wechat-chat-time';
            timeDiv.style.cssText = 'font-size: 11px; color: #999; flex-shrink: 0; margin-left: 8px;';
            timeDiv.textContent = '';
            
            nameRowDiv.appendChild(nameDiv);
            nameRowDiv.appendChild(timeDiv);
            
            const messageDiv = document.createElement('div');
            messageDiv.className = 'wechat-chat-message';
            messageDiv.textContent = '';
            
            const infoDiv = document.createElement('div');
            infoDiv.className = 'wechat-chat-info';
            infoDiv.appendChild(nameRowDiv);
            infoDiv.appendChild(messageDiv);
            
            const avatarDiv = document.createElement('div');
            avatarDiv.className = 'wechat-chat-avatar';
            avatarDiv.style.cssText = `width: 40px; height: 40px; border-radius: 0; display: flex; align-items: center; justify-content: center; ${avatar ? 'font-size: 28px;' : 'background-color: #e0e0e0; color: #999; font-size: 12px;'}`;
            avatarDiv.textContent = avatar || '头像';
            
            chatItem.appendChild(avatarDiv);
            chatItem.appendChild(infoDiv);

            // 长按事件相关变量
            let longPressTimer = null;
            
            // 添加鼠标按下事件监听器（长按检测）
            chatItem.addEventListener('mousedown', function() {
                longPressTimer = setTimeout(function() {
                    console.log('角色卡片被长按:', chatData.id, remark);
                    openChatCardActionModal(chatData.id);
                }, 300); // 0.3秒长按
            });
            
            // 添加鼠标释放事件监听器（取消长按）
            chatItem.addEventListener('mouseup', function() {
                if (longPressTimer) {
                    clearTimeout(longPressTimer);
                    longPressTimer = null;
                }
            });
            
            // 添加鼠标离开事件监听器（取消长按）
            chatItem.addEventListener('mouseleave', function() {
                if (longPressTimer) {
                    clearTimeout(longPressTimer);
                    longPressTimer = null;
                }
            });
            
            // 添加触摸事件监听器（移动端长按检测）
            chatItem.addEventListener('touchstart', function() {
                longPressTimer = setTimeout(function() {
                    console.log('角色卡片被长按:', chatData.id, remark);
                    openChatCardActionModal(chatData.id);
                }, 300); // 0.3秒长按
            });
            
            // 添加触摸结束事件监听器（取消长按）
            chatItem.addEventListener('touchend', function() {
                if (longPressTimer) {
                    clearTimeout(longPressTimer);
                    longPressTimer = null;
                }
            });
            
            // 添加点击事件监听器
            chatItem.addEventListener('click', function() {
                console.log('角色卡片被点击:', chatData.id, remark, name, avatar);
                openChatInterface(chatData.id, remark, avatar);
            });
            console.log('角色卡片事件监听器添加成功:', remark);

            // 添加到聊天列表
            chatList.appendChild(chatItem);

            // 添加分割线
            const divider = document.createElement('div');
            divider.className = 'wechat-divider';
            chatList.appendChild(divider);

            // 保存数据
            saveData();
        }

        // 检查是否为有效的图片URL
        function isValidImageUrl(url) {
            if (!url) return false;
            // 检查是否是有效的URL格式
            return url.startsWith('http://') || url.startsWith('https://') || url.startsWith('data:');
        }

        // 恢复角色卡片和文本框内容
        async function restoreWechatData() {
            // 恢复角色卡片
            const chatList = document.querySelector('.wechat-chat-list');
            if (chatList) {
                // 清空现有内容
                chatList.innerHTML = '';

                // 恢复保存的角色卡片
                for (const chatData of relationshipData.wechatChatList) {
                    const chatItem = document.createElement('div');
                    chatItem.className = 'wechat-chat-item';
                    chatItem.setAttribute('data-chat-id', chatData.id);
                    
                    // 【修复】设置置顶样式
                    if (chatData.pinned) {
                        chatItem.style.setProperty('background-color', '#e8e8e8', 'important');
                        chatItem.setAttribute('data-pinned', 'true');
                    }
                    
                    const isEmoji = chatData.avatar && chatData.avatar.length <= 2 && /\p{Emoji}/u.test(chatData.avatar);
                    const avatarContent = isEmoji ? chatData.avatar : (isValidImageUrl(chatData.avatar) ? `<img src="${chatData.avatar}" style="width: 40px; height: 40px; border-radius: 0; object-fit: cover;">` : '头像');
                    
                    // 创建名称和时间行
                    const nameRowDiv = document.createElement('div');
                    nameRowDiv.className = 'wechat-chat-name-row';
                    nameRowDiv.style.cssText = 'display: flex; justify-content: space-between; align-items: center; margin-bottom: 2px;';
                    
                    const nameDiv = document.createElement('div');
                    nameDiv.className = 'wechat-chat-name';
                    nameDiv.setAttribute('data-chat-id', chatData.id);
                    
                    const nameTextSpan = document.createElement('span');
                    nameTextSpan.className = 'wechat-chat-name-text';
                    nameTextSpan.textContent = chatData.remark;
                    nameDiv.appendChild(nameTextSpan);
                    
                    const timeDiv = document.createElement('div');
                    timeDiv.className = 'wechat-chat-time';
                    timeDiv.style.cssText = 'font-size: 11px; color: #999; flex-shrink: 0; margin-left: 8px;';
                    timeDiv.textContent = await getChatLastMessageTime(chatData);

                    nameRowDiv.appendChild(nameDiv);
                    nameRowDiv.appendChild(timeDiv);

                    const messageDiv = document.createElement('div');
                    messageDiv.className = 'wechat-chat-message';
                    messageDiv.textContent = await getChatLastMessage(chatData);
                    
                    const infoDiv = document.createElement('div');
                    infoDiv.className = 'wechat-chat-info';
                    infoDiv.appendChild(nameRowDiv);
                    infoDiv.appendChild(messageDiv);
                    
                    const avatarDiv = document.createElement('div');
                    avatarDiv.className = 'wechat-chat-avatar';
                    avatarDiv.style.cssText = `width: 40px; height: 40px; border-radius: 0; display: flex; align-items: center; justify-content: center; ${isEmoji ? 'font-size: 28px;' : (!chatData.avatar ? 'background-color: #e0e0e0; color: #999; font-size: 12px;' : '')}`;
                    avatarDiv.innerHTML = avatarContent;
                    
                    chatItem.appendChild(avatarDiv);
                    chatItem.appendChild(infoDiv);

                    // 长按事件相关变量
                    let longPressTimer = null;
                    
                    // 添加鼠标按下事件监听器（长按检测）
                    chatItem.addEventListener('mousedown', function() {
                        longPressTimer = setTimeout(function() {
                            console.log('恢复的角色卡片被长按:', chatData.id, chatData.remark);
                            openChatCardActionModal(chatData.id);
                        }, 300); // 0.3秒长按
                    });
                    
                    // 添加鼠标释放事件监听器（取消长按）
                    chatItem.addEventListener('mouseup', function() {
                        if (longPressTimer) {
                            clearTimeout(longPressTimer);
                            longPressTimer = null;
                        }
                    });
                    
                    // 添加鼠标离开事件监听器（取消长按）
                    chatItem.addEventListener('mouseleave', function() {
                        if (longPressTimer) {
                            clearTimeout(longPressTimer);
                            longPressTimer = null;
                        }
                    });
                    
                    // 添加触摸事件监听器（移动端长按检测）
                    chatItem.addEventListener('touchstart', function() {
                        longPressTimer = setTimeout(function() {
                            console.log('恢复的角色卡片被长按:', chatData.id, chatData.remark);
                            openChatCardActionModal(chatData.id);
                        }, 300); // 0.3秒长按
                    });
                    
                    // 添加触摸结束事件监听器（取消长按）
                    chatItem.addEventListener('touchend', function() {
                        if (longPressTimer) {
                            clearTimeout(longPressTimer);
                            longPressTimer = null;
                        }
                    });
                    
                    // 添加点击事件监听器
                    chatItem.addEventListener('click', function() {
                        console.log('恢复的角色卡片被点击:', chatData.id, chatData.remark, chatData.name, chatData.avatar);
                        openChatInterface(chatData.id, chatData.remark, chatData.avatar);
                    });
                    console.log('恢复的角色卡片事件监听器添加成功:', chatData.remark);

                    // 添加到聊天列表
                    chatList.appendChild(chatItem);

                    // 添加分割线
                    const divider = document.createElement('div');
                    divider.className = 'wechat-divider';
                    chatList.appendChild(divider);
                }

                // 添加聊天标识
                await renderChatBadgesForList();
            }

            // 恢复微信顶栏输入框内容
            const input = document.querySelector('.wechat-transparent-input');
            if (input) {
                // 从 localforage 恢复之前输入的内容
                localforage.getItem('wechatTopInputText').then(savedText => {
                    if (savedText) {
                        input.value = savedText;
                    }
                }).catch(err => {
                    console.warn('恢复顶栏输入框内容失败:', err);
                });

                // 绑定输入事件监听器（先移除旧的，避免重复绑定）
                input.removeEventListener('input', handleWechatInput);
                input.addEventListener('input', handleWechatInput);
            }
        }

        // 微信顶栏输入框处理函数
        // 【保存输入内容】保存到 localforage，刷新后不会丢失
        function handleWechatInput() {
            // 保存输入内容到 localforage
            localforage.setItem('wechatTopInputText', this.value).catch(err => {
                console.warn('保存顶栏输入框内容失败:', err);
            });
        }

        // 【已删除】handleChatInput 函数未使用，由 chatInputHandler 统一处理



        // 关闭聊天界面
        // 【新增】处理加号按钮触摸事件（移动端优化）
        function handleChatAddBtnTouch(event) {
            // 阻止默认行为，防止触发 ghost click
            // event.preventDefault();
            // 不阻止默认行为，让 click 事件正常触发
        }

        // 切换聊天加号菜单
        let isTogglingMenu = false;
        function toggleChatAddMenu() {
            // 【防重复点击】如果正在切换中，忽略此次点击
            if (isTogglingMenu) {
                return;
            }
            
            isTogglingMenu = true;
            
            const chatAddMenu = document.getElementById('chatAddMenu');
            const chatBottomBar = document.querySelector('.chat-bottom');
            const chatAddBtn = document.getElementById('chatAddBtn');
            
            if (!chatAddMenu) {
                console.error('【错误】找不到 chatAddMenu 元素');
                isTogglingMenu = false;
                return;
            }
            
            if (!chatBottomBar) {
                console.error('【错误】找不到 chatBottomBar 元素');
                isTogglingMenu = false;
                return;
            }
            
            try {
                const isShowing = chatAddMenu.classList.contains('show');
                const chatContent = document.getElementById('chatContent');
                const stickerPanel = document.getElementById('stickerPanel');
                console.log('【调试】当前菜单状态:', isShowing ? '显示中' : '已隐藏');
                
                if (isShowing) {
                    console.log('【调试】关闭菜单');
                    chatAddMenu.classList.remove('show');
                    // 【新增】移除 panel-open 类，恢复消息区域高度
                    if (chatContent) {
                        chatContent.classList.remove('panel-open');
                    }
                    // 【新增】重置工具栏到第一页
                    setTimeout(() => {
                        resetChatAddMenuPage();
                    }, 300);
                    // 【修复】移除直接修改 style.bottom 的代码，统一使用 CSS 变量方案
                    // 菜单关闭时，chat-bottom 的位置由 CSS 自动处理
                    // if (chatBottomBar.classList.contains('keyboard-visible')) {
                    //     chatBottomBar.style.bottom = '0';
                    // } else {
                    //     chatBottomBar.style.bottom = '30px';
                    // }
                } else {
                    console.log('【调试】打开菜单');
                    // 【修复】先关闭其他面板，但不移除 panel-open 类
                    if (stickerPanel && stickerPanel.classList.contains('show')) {
                        stickerPanel.classList.remove('show');
                        // 直接打开加号菜单，不要延迟，保持底栏位置
                        chatAddMenu.classList.add('show');
                        // 【修复】从表情面板切换过来时，保持 panel-open 类
                    } else {
                        chatAddMenu.classList.add('show');
                        // 【新增】添加 panel-open 类，调整消息区域高度
                        if (chatContent) {
                            chatContent.classList.add('panel-open');
                        }
                    }
                    
                    // 【新增】滚动消息列表到底部，让最新消息可见
                    scrollChatToBottom();
                }
            } catch (error) {
                console.error('【错误】切换菜单时发生错误:', error);
            } finally {
                // 300ms 后重置标志，防止快速连续点击
                setTimeout(() => {
                    isTogglingMenu = false;
                }, 300);
            }
        }

        // 聊天工具栏滑动切换相关变量
        let chatAddMenuCurrentPage = 0;
        let chatAddMenuTouchStartX = 0;
        let chatAddMenuTouchEndX = 0;

        // 初始化聊天工具栏滑动事件
        function initChatAddMenuSwipe() {
            const wrapper = document.getElementById('chatAddMenuWrapper');
            if (!wrapper) return;

            // 触摸开始
            wrapper.addEventListener('touchstart', function(e) {
                chatAddMenuTouchStartX = e.changedTouches[0].screenX;
            }, { passive: true });

            // 触摸结束
            wrapper.addEventListener('touchend', function(e) {
                chatAddMenuTouchEndX = e.changedTouches[0].screenX;
                handleChatAddMenuSwipe();
            }, { passive: true });

            // 鼠标事件（桌面端）
            wrapper.addEventListener('mousedown', function(e) {
                chatAddMenuTouchStartX = e.screenX;
            });

            wrapper.addEventListener('mouseup', function(e) {
                chatAddMenuTouchEndX = e.screenX;
                handleChatAddMenuSwipe();
            });
        }

        // 处理滑动
        function handleChatAddMenuSwipe() {
            const swipeThreshold = 50; // 滑动阈值
            const diff = chatAddMenuTouchStartX - chatAddMenuTouchEndX;

            if (Math.abs(diff) > swipeThreshold) {
                if (diff > 0 && chatAddMenuCurrentPage === 0) {
                    // 向左滑动，切换到第二页
                    switchChatAddMenuPage(1);
                } else if (diff < 0 && chatAddMenuCurrentPage === 1) {
                    // 向右滑动，切换到第一页
                    switchChatAddMenuPage(0);
                }
            }
        }

        // 切换工具栏页面
        function switchChatAddMenuPage(pageIndex) {
            const wrapper = document.getElementById('chatAddMenuWrapper');
            const dots = document.querySelectorAll('.indicator-dot');

            if (!wrapper) return;

            chatAddMenuCurrentPage = pageIndex;

            if (pageIndex === 0) {
                wrapper.classList.remove('page-2');
            } else {
                wrapper.classList.add('page-2');
            }

            // 更新指示器
            dots.forEach((dot, index) => {
                if (index === pageIndex) {
                    dot.classList.add('active');
                } else {
                    dot.classList.remove('active');
                }
            });
        }

        // 重置工具栏到第一页
        function resetChatAddMenuPage() {
            switchChatAddMenuPage(0);
        }

        function openMusicPlayer() {
            const currentAIId = currentChatId;
            
            if (currentListeningAIId && currentListeningAIId !== currentAIId) {
                const currentListeningAIName = getAINameById(currentListeningAIId);
                const currentAIName = getAINameById(currentAIId);
                
                const confirmDialog = document.createElement('div');
                confirmDialog.style.cssText = `
                    position: fixed;
                    top: 0;
                    left: 0;
                    width: 100%;
                    height: 100%;
                    background: rgba(0, 0, 0, 0.7);
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    z-index: 1000000;
                `;
                
                confirmDialog.innerHTML = `
                    <div style="background: white; padding: 30px; border-radius: 15px; max-width: 90%; width: 350px; text-align: center;">
                        <div style="font-size: 18px; font-weight: bold; margin-bottom: 15px; color: #ff6b9d;">切换听歌</div>
                        <div style="color: #333; margin-bottom: 20px; line-height: 1.6;">
                            当前正在和 <strong style="color: #ff6b9d;">${currentListeningAIName}</strong> 一起听歌<br>
                            是否要中断并和 <strong style="color: #ff6b9d;">${currentAIName}</strong> 一起听歌？
                        </div>
                        <div style="display: flex; gap: 10px;">
                            <button id="cancelSwitchMusic" style="flex: 1; padding: 12px 20px; background: #f0f0f0; border: none; border-radius: 8px; cursor: pointer; font-size: 16px; color: #333;">否</button>
                            <button id="confirmSwitchMusic" style="flex: 1; padding: 12px 20px; background: #ff6b9d; border: none; border-radius: 8px; cursor: pointer; font-size: 16px; color: white;">是</button>
                        </div>
                    </div>
                `;
                
                document.body.appendChild(confirmDialog);
                
                document.getElementById('cancelSwitchMusic').addEventListener('click', function() {
                    document.body.removeChild(confirmDialog);
                });
                
                document.getElementById('confirmSwitchMusic').addEventListener('click', function() {
                    document.body.removeChild(confirmDialog);
                    switchListeningAI(currentAIId);
                    const modal = document.getElementById('musicPlayerModal');
                    modal.classList.add('show');
                    loadMusicPlayerData();
                });
            } else {
                if (!currentListeningAIId && currentAIId) {
                    currentListeningAIId = currentAIId;
                }
                const modal = document.getElementById('musicPlayerModal');
                modal.classList.add('show');
                loadMusicPlayerData();
            }
        }

        function getAINameById(aiId) {
            const chatItem = relationshipData.wechatChatList.find(item => item.id == aiId);
            return chatItem ? chatItem.name : '未知AI';
        }

        function switchListeningAI(newAIId) {
            currentListeningAIId = newAIId;
            // 保存到 localforage
            localforage.setItem('currentListeningAIId', newAIId).catch(err => {
                console.warn('保存当前听歌AI失败:', err);
            });
            updateListenTimeDisplay();
        }

        async function handleAddMenuItem(type) {
            const chatInput = document.getElementById('chatInput');
            
            switch(type) {
                case 'album':
                    const fileInput = document.createElement('input');
                    fileInput.type = 'file';
                    fileInput.accept = 'image/*';
                    fileInput.style.display = 'none';
                    fileInput.onchange = function(e) {
                        const file = e.target.files[0];
                        if (file) {
                            // 【优化】先显示原图让用户立即看到，后台再压缩
                            const reader = new FileReader();
                            reader.onload = function(event) {
                                const imageData = event.target.result;
                                // 【优化】立即发送原图显示，提升用户体验
                                sendImageMessage(imageData, file.name);
                                
                                // 【优化】后台压缩（如果需要）
                                if (imageData.length > 2 * 1024 * 1024) {
                                    console.log('【优化】图片较大，后台压缩中...');
                                    compressImage(imageData, 800, 800, 0.8).then(compressedData => {
                                        if (compressedData && compressedData.length > 0 && compressedData.length < imageData.length) {
                                            // 更新已发送消息的图片为压缩版本
                                            updateImageMessage(file.name, compressedData);
                                        }
                                    });
                                }
                            };
                            reader.readAsDataURL(file);
                        }
                        document.body.removeChild(fileInput);
                    };
                    fileInput.oncancel = function() {
                        document.body.removeChild(fileInput);
                    };
                    document.body.appendChild(fileInput);
                    setTimeout(function() {
                        fileInput.click();
                    }, 100);
                    toggleChatAddMenu();
                    return;
                case 'camera':
                    toggleChatAddMenu();
                    
                    const cameraModal = document.createElement('div');
                    cameraModal.style.cssText = `
                        position: fixed;
                        top: 0;
                        left: 0;
                        width: 100%;
                        height: 100%;
                        background: rgba(0, 0, 0, 0.8);
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        z-index: 10000;
                    `;
                    
                    cameraModal.innerHTML = `
                        <div style="background: url('https://s41.ax1x.com/2026/02/07/pZTSX6S.png') center/contain no-repeat; background-size: 100%; position: fixed; top: 0; left: 0; width: 100%; height: 100%; display: flex; flex-direction: column; gap: 16px;">
                            <div style="flex: 1; display: flex; align-items: center; justify-content: center; min-height: 50vh; padding-right: 73px; padding-top: 104px;">
                                <video id="cameraVideo" autoplay playsinline style="width: 100%; max-width: 180px; max-height: 280px; object-fit: cover;"></video>
                            </div>
                            <div style="display: flex; gap: 12px; justify-content: center;">
                                <button id="captureBtn" style="flex: 1; padding: 12px 24px; background: #FFB7C5; color: white; border: none; border-radius: 8px; font-size: 16px; cursor: pointer; box-shadow: 0 2px 8px rgba(255,183,197,0.3);">拍照</button>
                                <button id="closeCameraBtn" style="flex: 1; padding: 12px 24px; background: rgba(255,255,255,255,0.9); color: #333; border: none; border-radius: 8px; font-size: 16px; cursor: pointer; box-shadow: 0 2px 8px rgba(0,0,0,0.2);">取消</button>
                            </div>
                        </div>
                    `;
                    
                    document.body.appendChild(cameraModal);
                    
                    let stream = null;
                    const video = document.getElementById('cameraVideo');
                    const captureBtn = document.getElementById('captureBtn');
                    const closeCameraBtn = document.getElementById('closeCameraBtn');
                    
                    async function startCamera() {
                        try {
                            console.log('开始启动摄像头...');
                            stream = await navigator.mediaDevices.getUserMedia({ 
                                video: { facingMode: 'environment' } 
                            });
                            console.log('摄像头流获取成功:', stream);
                            video.srcObject = stream;
                            
                            video.onloadedmetadata = function() {
                                console.log('视频流加载完成，尺寸:', video.videoWidth, 'x', video.videoHeight);
                                video.play();
                            };
                            
                            video.onerror = function(error) {
                                console.error('视频加载错误:', error);
                                alert('视频加载失败，请重试');
                            };
                        } catch (error) {
                            console.error('无法访问摄像头:', error);
                            alert('无法访问摄像头，请确保已授权摄像头权限');
                            document.body.removeChild(cameraModal);
                        }
                    }
                    
                    function stopCamera() {
                        if (stream) {
                            stream.getTracks().forEach(track => track.stop());
                        }
                    }
                    
                    captureBtn.onclick = async function() {
                        const canvas = document.createElement('canvas');
                        canvas.width = video.videoWidth;
                        canvas.height = video.videoHeight;
                        const ctx = canvas.getContext('2d');
                        ctx.drawImage(video, 0, 0);
                        
                        const imageData = canvas.toDataURL('image/jpeg', 0.8);
                        
                        stopCamera();
                        document.body.removeChild(cameraModal);
                        
                        const fileName = `photo_${Date.now()}.jpg`;
                        compressImage(imageData, function(compressedData) {
                            sendImageMessage(compressedData, fileName);
                        });
                    };
                    
                    closeCameraBtn.onclick = function() {
                        stopCamera();
                        document.body.removeChild(cameraModal);
                    };
                    
                    await startCamera();
                    return;
                case 'location':
                    toggleChatAddMenu();
                    
                    // 【修复】在APK环境中使用Capacitor Geolocation插件
                    async function getLocationPosition() {
                        try {
                            // 优先使用Capacitor Geolocation插件（APK环境）
                            if (window.Capacitor?.Plugins?.Geolocation) {
                                console.log('【位置】使用Capacitor Geolocation获取位置');
                                const position = await window.Capacitor.Plugins.Geolocation.getCurrentPosition({
                                    enableHighAccuracy: true,
                                    timeout: 10000
                                });
                                return {
                                    lat: position.coords.latitude,
                                    lng: position.coords.longitude
                                };
                            }
                            
                            // 降级到浏览器Geolocation API
                            if (navigator.geolocation) {
                                console.log('【位置】使用浏览器Geolocation获取位置');
                                return new Promise((resolve, reject) => {
                                    navigator.geolocation.getCurrentPosition(
                                        (position) => {
                                            resolve({
                                                lat: position.coords.latitude,
                                                lng: position.coords.longitude
                                            });
                                        },
                                        (error) => {
                                            console.error('【位置】浏览器定位失败:', error);
                                            reject(error);
                                        },
                                        { enableHighAccuracy: true, timeout: 10000 }
                                    );
                                });
                            }
                            
                            throw new Error('没有可用的定位服务');
                        } catch (error) {
                            console.error('【位置】获取位置失败:', error);
                            throw error;
                        }
                    }
                    
                    try {
                        const position = await getLocationPosition();
                        const lat = position.lat;
                        const lng = position.lng;
                        
                        console.log('【位置】获取到位置:', lat, lng);
                            
                            const savedSettings = await loadAppSettings({});
                            const mapApiKey = savedSettings.api?.mapApiKey || '';
                            const securityConfig = savedSettings.api?.amapSecurityConfig || '';
                            
                            // 【防闪退】添加 fetch 超时处理 - 统一为300秒
                            const fetchWithTimeout = (url, options = {}, timeout = 300000) => {
                                return Promise.race([
                                    fetch(url, options),
                                    new Promise((_, reject) =>
                                        setTimeout(() => reject(new Error('请求超时')), timeout)
                                    )
                                ]);
                            };

                            // 【新增】通用 API 请求工具函数（自动处理 Capacitor 环境）
                            async function apiRequest(url, options = {}) {
                                const isCapacitor = typeof window !== 'undefined' && window.Capacitor && window.Capacitor.isNative;

                                // 优先使用 Capacitor HTTP 插件（绕过 CORS 限制）
                                if (isCapacitor && window.Capacitor.Plugins && window.Capacitor.Plugins.Http) {
                                    try {
                                        console.log('【API请求】使用 Capacitor HTTP 插件:', url);
                                        const method = (options.method || 'GET').toLowerCase();
                                        const requestOptions = {
                                            url: url,
                                            headers: options.headers || {},
                                            connectTimeout: 300000,
                                            readTimeout: 300000
                                        };

                                        if (options.body) {
                                            requestOptions.data = typeof options.body === 'string' ? options.body : JSON.stringify(options.body);
                                        }

                                        const response = await window.Capacitor.Plugins.Http[method](requestOptions);

                                        return {
                                            ok: response.status >= 200 && response.status < 300,
                                            status: response.status,
                                            statusText: response.statusText || '',
                                            json: async () => typeof response.data === 'string' ? JSON.parse(response.data) : response.data,
                                            text: async () => typeof response.data === 'string' ? response.data : JSON.stringify(response.data),
                                            headers: response.headers || {}
                                        };
                                    } catch (capacitorError) {
                                        console.warn('【API请求】Capacitor HTTP 失败，回退到 fetch:', capacitorError.message);
                                    }
                                }

                                // 回退到标准 fetch
                                console.log('【API请求】使用 fetch:', url);
                                const controller = new AbortController();
                                const timeoutId = setTimeout(() => controller.abort(), 300000);

                                try {
                                    const fetchOptions = {
                                        ...options,
                                        signal: controller.signal,
                                        mode: 'cors',
                                        credentials: 'omit'
                                    };

                                    const response = await fetch(url, fetchOptions);
                                    clearTimeout(timeoutId);
                                    return response;
                                } catch (error) {
                                    clearTimeout(timeoutId);
                                    throw error;
                                }
                            }

                            // 【关键】确保高德地图JS API已加载
                            if (mapApiKey && typeof AMap === 'undefined') {
                                console.log('【位置】高德地图未加载，尝试加载...');
                                try {
                                    // 先创建安全密钥配置脚本
                                    if (securityConfig) {
                                        const securityScript = document.createElement('script');
                                        securityScript.type = 'text/javascript';
                                        securityScript.textContent = `
                                            window._AMapSecurityConfig = {
                                                securityJsCode: '${securityConfig}'
                                            };
                                        `;
                                        document.head.appendChild(securityScript);
                                        console.log('【位置】安全密钥配置已插入');
                                    }
                                    
                                    // 创建高德地图 JS API 脚本
                                    await new Promise((resolve, reject) => {
                                        const script = document.createElement('script');
                                        script.type = 'text/javascript';
                                        script.src = `https://webapi.amap.com/maps?v=2.0&key=${mapApiKey}&plugin=AMap.Geocoder`;
                                        script.async = true;
                                        script.onload = () => {
                                            console.log('【位置】高德地图 JS API 加载成功');
                                            resolve();
                                        };
                                        script.onerror = (error) => {
                                            console.error('【位置】高德地图 JS API 加载失败:', error);
                                            reject(error);
                                        };
                                        document.head.appendChild(script);
                                    });
                                } catch (e) {
                                    console.error('【位置】加载高德地图失败:', e);
                                }
                            }

                            try {
                                // 【修复】使用 await 而不是 Promise.all().then()
                                let ipData = null;
                                let mapData = null;
                                
                                try {
                                    ipData = await fetchWithTimeout('http://ip-api.com/json/?lang=zh-CN')
                                        .then(r => r.json())
                                        .catch(err => {
                                            console.warn('【防闪退】IP获取失败:', err);
                                            return null;
                                        });
                                } catch (e) {
                                    console.warn('【位置】IP定位失败:', e);
                                }
                                
                                if (mapApiKey) {
                                    try {
                                        mapData = await fetchWithTimeout(`https://restapi.amap.com/v3/geocode/regeo?output=json&location=${lng},${lat}&key=${mapApiKey}&radius=1000&extensions=base`)
                                            .then(r => r.json())
                                            .catch(() => null);
                                    } catch (e) {
                                        console.warn('【位置】高德地图API调用失败:', e);
                                    }
                                }
                                
                                console.log('【位置】IP定位数据:', ipData);
                                console.log('【位置】高德地图数据:', mapData);
                                console.log('【位置】高德地图数据状态:', mapData ? mapData.status : '无数据');
                                
                                let addressText = `${lat.toFixed(6)}, ${lng.toFixed(6)}`;
                                let detailedAddress = '';
                                
                                if (mapData) {
                                    console.log('【位置】高德地图regeocode:', mapData.regeocode);
                                    if (mapData.status === '1' && mapData.regeocode && mapData.regeocode.formatted_address) {
                                        addressText = mapData.regeocode.formatted_address;
                                        detailedAddress = mapData.regeocode.formatted_address;
                                        console.log('【位置】使用高德地图地址:', addressText);
                                    } else {
                                        console.log('【位置】高德地图数据格式不符合预期');
                                    }
                                } else {
                                    console.log('【位置】没有高德地图数据');
                                }
                                
                                if (!detailedAddress && ipData && ipData.status === 'success') {
                                    const parts = [];
                                    if (ipData.city) parts.push(ipData.city);
                                    if (ipData.regionName) parts.push(ipData.regionName);
                                    if (ipData.country) parts.push(ipData.country);
                                    
                                    if (parts.length > 0) {
                                        addressText = parts.join('');
                                        detailedAddress = parts.join('');
                                        console.log('【位置】使用IP定位地址:', addressText);
                                    }
                                }
                                
                                console.log('【位置】最终地址:', addressText);
                                
                                // 生成唯一ID用于地图容器
                                const mapContainerId = `location-map-${Date.now()}-${Math.random().toString(36).substr(2, 9)}`;
                                
                                // 【新版】使用高德JS API地图或静态地图
                                let mapHtml = '';
                                if (mapApiKey && typeof AMap !== 'undefined') {
                                    // 使用JS地图 - 初始化小地图
                                    mapHtml = `<div id="${mapContainerId}" style="width: 100%; height: 150px; cursor: pointer;" onclick="openLocationMapModal(${lat}, ${lng}, '${addressText.replace(/'/g, "\\'")}')"></div>`;
                                    
                                    // 延迟初始化小地图
                                    setTimeout(() => {
                                        try {
                                            const map = new AMap.Map(mapContainerId, {
                                                zoom: 15,
                                                center: [lng, lat],
                                                viewMode: '2D',
                                                dragEnable: false,
                                                zoomEnable: false,
                                                doubleClickZoom: false
                                            });
                                            const marker = new AMap.Marker({
                                                position: [lng, lat],
                                                title: '当前位置'
                                            });
                                            map.add(marker);
                                            console.log('【位置】小地图初始化成功');
                                        } catch (e) {
                                            console.error('【位置】初始化小地图失败:', e);
                                        }
                                    }, 300); // 【修复】增加延迟，确保DOM已渲染
                                } else {
                                    // 降级到静态地图
                                    const mapImageUrl = mapApiKey 
                                        ? `https://restapi.amap.com/v3/staticmap?location=${lng},${lat}&zoom=15&size=600*300&markers=mid,,A:${lng},${lat}&key=${mapApiKey}`
                                        : '';
                                    mapHtml = mapImageUrl ? `<img src="${mapImageUrl}" style="width: 100%; height: 150px; object-fit: cover; cursor: pointer;" onclick="openLocationMapModal(${lat}, ${lng}, '${addressText.replace(/'/g, "\\'")}')">` : '';
                                    console.log('【位置】使用静态地图');
                                }
                                
                                const locationCard = `
                                    <div style="background: white; border-radius: 12px; overflow: hidden; max-width: 300px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
                                        ${mapHtml}
                                        <div style="padding: 16px; background: #f9f9f9;">
                                            <div style="font-size: 14px; color: #666; margin-bottom: 8px; text-align: center;">当前位置</div>
                                            <div style="font-size: 16px; font-weight: bold; color: #333; text-align: center; margin-bottom: 12px; line-height: 1.5;">
                                                ${addressText}
                                            </div>
                                            <div style="font-size: 12px; color: #999; text-align: center;">
                                                ${lat.toFixed(6)}, ${lng.toFixed(6)}
                                            </div>
                                        </div>
                                    </div>
                                `;
                                
                                displayMessage('user', locationCard, false, null);

                                relationshipData.chatMessages.push({
                                    sender: 'user',
                                    content: locationCard,
                                    timestamp: Date.now(),
                                    chatId: currentChatId,
                                    locationInfo: {
                                        address: detailedAddress || addressText,
                                        latitude: lat,
                                        longitude: lng,
                                        rawIpData: ipData,
                                        rawMapData: mapData
                                    }
                                });

                                saveData();

                                // 【修复】增加用户消息计数
                                await incrementUserMessageCount();

                            } catch (error) {
                                console.error('【位置】获取地址失败:', error);

                                const locationCard = `
                                    <div style="background: white; border-radius: 12px; overflow: hidden; max-width: 300px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
                                        <div style="padding: 16px; background: #f9f9f9;">
                                            <div style="font-size: 14px; color: #666; margin-bottom: 8px; text-align: center;">当前位置</div>
                                            <div style="font-size: 16px; font-weight: bold; color: #333; text-align: center; margin-bottom: 12px; line-height: 1.5;">
                                                ${lat.toFixed(6)}, ${lng.toFixed(6)}
                                            </div>
                                        </div>
                                    </div>
                                `;

                                displayMessage('user', locationCard, false, null);

                                relationshipData.chatMessages.push({
                                    sender: 'user',
                                    content: locationCard,
                                    timestamp: Date.now(),
                                    chatId: currentChatId,
                                    locationInfo: {
                                        address: `${lat.toFixed(6)}, ${lng.toFixed(6)}`,
                                        latitude: lat,
                                        longitude: lng
                                    }
                                });

                                saveData();

                                // 【修复】增加用户消息计数
                                incrementUserMessageCount();
                            }
                        } catch (error) {
                            console.error('【位置】获取位置失败:', error);
                            alert('无法获取位置信息，请确保已授予定位权限');
                        }
                        return;

                // 【新增】打开位置地图弹窗（点击位置卡片时调用）
                function openLocationMapModal(lat, lng, address) {
                    console.log('打开位置地图弹窗:', lat, lng, address);
                    
                    // 生成唯一ID用于大地图容器
                    const modalMapId = `modal-map-${Date.now()}-${Math.random().toString(36).substr(2, 9)}`;
                    
                    // 创建弹窗
                    const modal = document.createElement('div');
                    modal.style.cssText = `
                        position: fixed;
                        top: 0;
                        left: 0;
                        width: 100%;
                        height: 100%;
                        background: rgba(0, 0, 0, 0.85);
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        z-index: 10000;
                        padding: 20px;
                        box-sizing: border-box;
                    `;
                    
                    modal.innerHTML = `
                        <div style="background: white; border-radius: 16px; overflow: hidden; width: 90%; max-width: 500px; max-height: 80vh; display: flex; flex-direction: column;">
                            <div style="padding: 16px 20px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; display: flex; justify-content: space-between; align-items: center;">
                                <div style="font-size: 16px; font-weight: bold;">📍 位置详情</div>
                                <button onclick="this.closest('.location-modal').remove()" style="background: rgba(255,255,255,0.2); border: none; color: white; width: 32px; height: 32px; border-radius: 50%; cursor: pointer; font-size: 18px; display: flex; align-items: center; justify-content: center;">×</button>
                            </div>
                            <div id="${modalMapId}" style="width: 100%; height: 300px; flex-shrink: 0;"></div>
                            <div style="padding: 20px; background: #f9f9f9; flex: 1; overflow-y: auto;">
                                <div style="font-size: 14px; color: #666; margin-bottom: 8px;">📍 详细地址</div>
                                <div style="font-size: 16px; font-weight: bold; color: #333; margin-bottom: 16px; line-height: 1.5;">${address}</div>
                                <div style="font-size: 12px; color: #999; font-family: monospace;">${parseFloat(lat).toFixed(6)}, ${parseFloat(lng).toFixed(6)}</div>
                            </div>
                        </div>
                    `;
                    
                    modal.className = 'location-modal';
                    modal.onclick = function(e) {
                        if (e.target === modal) {
                            modal.remove();
                        }
                    };
                    
                    document.body.appendChild(modal);
                    
                    // 初始化大地图
                    setTimeout(() => {
                        try {
                            if (typeof AMap !== 'undefined') {
                                const map = new AMap.Map(modalMapId, {
                                    zoom: 16,
                                    center: [lng, lat],
                                    viewMode: '2D'
                                });
                                
                                const marker = new AMap.Marker({
                                    position: [lng, lat],
                                    title: address,
                                    animation: 'AMAP_ANIMATION_DROP'
                                });
                                
                                map.add(marker);
                                
                                // 添加信息窗体
                                const infoWindow = new AMap.InfoWindow({
                                    content: `<div style="padding: 8px 12px; font-size: 14px;">${address}</div>`,
                                    offset: new AMap.Pixel(0, -30)
                                });
                                
                                marker.on('click', () => {
                                    infoWindow.open(map, marker.getPosition());
                                });
                                
                                // 自动打开信息窗体
                                infoWindow.open(map, [lng, lat]);
                            } else {
                                // 高德地图未加载，显示静态地图
                                const container = document.getElementById(modalMapId);
                                if (container) {
                                    const savedSettings = JSON.parse(localStorage.getItem('appSettings') || '{}');
                                    const mapApiKey = savedSettings.api?.mapApiKey || '';
                                    const staticMapUrl = mapApiKey 
                                        ? `https://restapi.amap.com/v3/staticmap?location=${lng},${lat}&zoom=16&size=600*400&markers=large,,A:${lng},${lat}&key=${mapApiKey}`
                                        : '';
                                    
                                    if (staticMapUrl) {
                                        container.innerHTML = `<img src="${staticMapUrl}" style="width: 100%; height: 100%; object-fit: cover;">`;
                                    } else {
                                        container.innerHTML = `
                                            <div style="width: 100%; height: 100%; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); display: flex; align-items: center; justify-content: center; color: white; flex-direction: column;">
                                                <div style="font-size: 48px; margin-bottom: 10px;">📍</div>
                                                <div style="font-size: 14px;">${address}</div>
                                            </div>
                                        `;
                                    }
                                }
                            }
                        } catch (e) {
                            console.error('初始化大地图失败:', e);
                        }
                    }, 100);
                }

                case 'music':
                    openMusicPlayer();
                    toggleChatAddMenu();
                    return;
                case 'file':
                    const fileInput2 = document.createElement('input');
                    fileInput2.type = 'file';
                    fileInput2.accept = '.doc,.docx,.txt,.pdf,.md';
                    fileInput2.style.display = 'none';
                    fileInput2.onchange = async function(e) {
                        const file = e.target.files[0];
                        if (file) {
                            try {
                                // 根据文件类型选择不同的处理方式
                                if (file.name.toLowerCase().endsWith('.docx')) {
                                    // Word文件特殊处理
                                    await handleWordFile(file);
                                } else if (file.name.toLowerCase().endsWith('.txt') || file.name.toLowerCase().endsWith('.md')) {
                                    // 文本文件直接读取
                                    await handleTextFile(file);
                                } else {
                                    // 其他文件作为普通文件发送
                                    const reader = new FileReader();
                                    reader.onload = function(event) {
                                        const fileData = event.target.result;
                                        sendFileMessage(fileData, file.name, 'file');
                                    };
                                    reader.readAsDataURL(file);
                                }
                            } catch (error) {
                                console.error('文件处理失败:', error);
                                alert('文件处理失败，请重试');
                            }
                        }
                        document.body.removeChild(fileInput2);
                    };
                    document.body.appendChild(fileInput2);
                    setTimeout(function() {
                        fileInput2.click();
                    }, 100);
                    toggleChatAddMenu();
                    return;
                case 'call':
                    toggleChatAddMenu();
                    showCallTypeModal();
                    return;
                case 'voicecall':
                    toggleChatAddMenu();
                    openVoiceCall();
                    return;
                case 'coupon':
                    console.log('【券券】点击券券菜单');
                    toggleChatAddMenu();
                    console.log('【券券】菜单已关闭，准备打开弹窗');
                    openCouponModal();
                    return;
                case 'date':
                    toggleChatAddMenu();
                    openDatePage();
                    return;
                case 'return':
                    toggleChatAddMenu();
                    // 重回功能 - 删除AI最新回复并重新请求API
                    handleReturnMessage();
                    return;
            }
        }

        // 处理重回消息功能 - 删除AI最新回复并重新请求API
        async function handleReturnMessage() {
            try {
                // 获取当前聊天的所有消息
                const chatMessages = relationshipData.chatMessages.filter(msg => msg.chatId === currentChatId);

                if (chatMessages.length === 0) {
                    showToast('没有消息可以重回');
                    return;
                }

                // 找到最后一条AI消息
                let lastAIMessageIndex = -1;
                let lastAIMessage = null;

                for (let i = chatMessages.length - 1; i >= 0; i--) {
                    if (chatMessages[i].sender === 'ai' || chatMessages[i].isUser === false) {
                        lastAIMessageIndex = i;
                        lastAIMessage = chatMessages[i];
                        break;
                    }
                }

                if (!lastAIMessage) {
                    showToast('没有找到AI的回复消息');
                    return;
                }

                // 找到AI消息前的一条用户消息（用于重新发送给AI）
                let lastUserMessage = null;
                for (let i = lastAIMessageIndex - 1; i >= 0; i--) {
                    if (chatMessages[i].sender === 'user' || chatMessages[i].isUser === true) {
                        lastUserMessage = chatMessages[i];
                        break;
                    }
                }

                if (!lastUserMessage) {
                    showToast('没有找到对应的用户消息');
                    return;
                }

                // 显示确认提示
                if (!confirm('确定要删除AI的最后回复并重新生成吗？')) {
                    return;
                }

                // 【关键修复】同时从 SQLite 和内存中删除AI的最后一条消息
                console.log('【重回】开始删除AI消息:', lastAIMessage.timestamp);

                // 1. 从 SQLite/IndexedDB 删除
                try {
                    if (typeof ChatMessageManager !== 'undefined') {
                        await ChatMessageManager.deleteMessage(currentChatId, lastAIMessage.timestamp);
                        console.log('【重回】已从 SQLite/IndexedDB 删除消息');
                    }
                } catch (error) {
                    console.warn('【重回】从 SQLite 删除消息失败:', error);
                }

                // 2. 从内存数据中删除
                const messageIndex = relationshipData.chatMessages.findIndex(
                    msg => msg.chatId === currentChatId && msg.timestamp === lastAIMessage.timestamp
                );

                if (messageIndex !== -1) {
                    relationshipData.chatMessages.splice(messageIndex, 1);
                    console.log('【重回】已从内存删除AI的最后一条消息');
                }

                // 3. 保存更新后的数据
                try {
                    await saveData();
                    console.log('【重回】已保存更新后的数据');
                } catch (error) {
                    console.warn('【重回】保存数据失败:', error);
                }

                // 4. 清除消息缓存
                clearCurrentChatMessagesCache();

                // 5. 刷新聊天界面显示
                await refreshChatInterface();

                showToast('已删除AI回复，正在重新请求...');

                // 获取聊天项信息
                const chatItem = relationshipData.wechatChatList.find(item => item.id == currentChatId);
                if (!chatItem) {
                    showToast('找不到聊天信息');
                    return;
                }

                // 重新发送用户消息给AI
                const userContent = lastUserMessage.content;

                // 延迟一下再发送，让界面先刷新
                setTimeout(async () => {
                    try {
                        // 根据是否是群聊调用不同的处理函数
                        if (chatItem.isGroupChat) {
                            // 群聊处理
                            await handleGroupChatUserMessage(userContent, chatItem);
                        } else {
                            // 单聊处理 - 模拟用户发送消息并触发AI回复
                            await resendMessageToAI(userContent, chatItem);
                        }
                    } catch (error) {
                        console.error('【重回】重新发送消息失败:', error);
                        showToast('重新请求失败，请重试');
                    }
                }, 500);

            } catch (error) {
                console.error('【重回】处理失败:', error);
                showToast('操作失败，请重试');
            }
        }

        // 重新发送消息给AI（用于重回功能）
        async function resendMessageToAI(messageContent, chatItem) {
            console.log('【重回】重新发送消息给AI:', messageContent);

            try {
                // 获取用户昵称
                const personalProfile = await localforage.getItem('personalProfile') || {};
                const userNickname = chatItem.myNickname || personalProfile.nickname || '我';
                const aiName = chatItem.remark || chatItem.name || 'AI';
                const currentTime = new Date().toLocaleString('zh-CN');

                // 【优化】构建标准 OpenAI API messages 数组格式
                const messages = [];

                // 1. 构建 system 消息（人设、世界书、规则等）
                let systemContent = `你是${aiName}，正在和用户进行微信聊天。请以自然、亲切的语气回应。\n\n`;

                // 添加人设信息
                if (chatItem.personality) {
                    systemContent += `【你的人设】\n${chatItem.personality}\n\n`;
                }

                // 添加世界书内容
                if (chatItem.worldbooks && Array.isArray(chatItem.worldbooks) && chatItem.worldbooks.length > 0) {
                    systemContent += `【⚠️ 极其重要 - 世界书设定】\n以下内容是你的核心设定，必须严格遵守：\n\n`;
                    chatItem.worldbooks.forEach((id, index) => {
                        const worldbook = relationshipData.worldBooks.find(book => book.id == id);
                        if (worldbook && worldbook.content) {
                            systemContent += `--- 世界书 ${index + 1}: ${worldbook.title || '未命名'} ---\n${worldbook.content}\n\n`;
                        }
                    });
                    systemContent += `【⚠️ 世界书设定结束】\n\n你必须始终遵循以上世界书设定。\n\n`;
                }

                // 添加长期记忆
                const memoryMountCount = chatItem.memoryMountCount || 5;
                if (chatItem.memories && Array.isArray(chatItem.memories) && chatItem.memories.length > 0) {
                    systemContent += `【长期记忆】\n以下是你和${userNickname}的美好回忆：\n\n`;
                    const recentMemories = chatItem.memories.slice(-memoryMountCount);
                    recentMemories.forEach((memory, index) => {
                        systemContent += `${index + 1}. ${memory.timeText}\n${memory.content}\n\n`;
                    });
                    systemContent += `\n`;
                }

                // 添加回复规则
                systemContent += `【回复规则】\n`;
                systemContent += `- 你是${aiName}，正在和${userNickname}进行一对一的私人对话\n`;
                systemContent += `- 当前时间：${currentTime}\n`;
                systemContent += `- 回复要自然、亲切\n`;
                systemContent += `- 记住对方昵称是"${userNickname}"\n`;
                systemContent += `- 可以使用 [QUOTE]用户名:内容[/QUOTE] 格式引用消息\n`;
                systemContent += `- 可以使用 [STICKER]描述[/STICKER] 格式发送表情包\n`;
                systemContent += `- 可以使用 [CALL]原因[/CALL] 格式主动打电话\n`;
                systemContent += `- 多条消息用 ==== 分隔\n`;
                systemContent += `- 保持真实，想说什么就说什么\n`;

                messages.push({
                    role: 'system',
                    content: systemContent
                });

                // 2. 构建对话历史（使用 contextLength 限制条数）
                const contextLength = chatItem.contextLength || 20;
                const allChatMessages = relationshipData.chatMessages
                    .filter(msg => msg.chatId == currentChatId)
                    .sort((a, b) => a.timestamp - b.timestamp);

                // 只取最近的 contextLength 条消息作为历史
                const historyMessages = allChatMessages.slice(-contextLength);

                // 将历史消息转换为 OpenAI 格式
                for (const msg of historyMessages) {
                    let contentStr = msg.content || '';
                    contentStr = contentStr.replace(/<[^>]*>/g, '');

                    // 处理语音消息
                    if (msg.type === 'voice' || contentStr.includes('transcript=')) {
                        const transcriptMatch = contentStr.match(/transcript=([^&]+)/);
                        if (transcriptMatch) {
                            contentStr = `[语音消息：${decodeURIComponent(transcriptMatch[1])}]`;
                        } else {
                            contentStr = '[语音消息]';
                        }
                    }

                    // 处理引用信息
                    if (msg.quote && msg.quote.content) {
                        const quoteText = msg.quote.senderName ?
                            `[引用 ${msg.quote.senderName}: ${msg.quote.content}] ` :
                            `[引用 ${msg.quote.content}] `;
                        contentStr = quoteText + contentStr;
                    }

                    messages.push({
                        role: msg.sender === 'user' ? 'user' : 'assistant',
                        content: contentStr,
                        name: msg.sender === 'user' ? userNickname : aiName
                    });
                }

                // 3. 添加当前用户消息
                messages.push({
                    role: 'user',
                    content: messageContent,
                    name: userNickname
                });

                console.log('【重回】使用标准 messages 数组格式，消息数:', messages.length);
                console.log('【重回】System 消息长度:', systemContent.length);
                console.log('【重回】历史消息数:', historyMessages.length);
                console.log('【重回】ContextLength 设置:', contextLength);

                // 构建兼容旧格式的 prompt（用于 callOpenAIAPIWithTools）
                let prompt = `【历史聊天记录】\n`;
                prompt += `==============================\n`;
                historyMessages.forEach(msg => {
                    let contentStr = msg.content || '';
                    contentStr = contentStr.replace(/<[^>]*>/g, '');
                    if (msg.type === 'voice' || contentStr.includes('transcript=')) {
                        const transcriptMatch = contentStr.match(/transcript=([^&]+)/);
                        if (transcriptMatch) {
                            contentStr = `[语音消息：${decodeURIComponent(transcriptMatch[1])}]`;
                        } else {
                            contentStr = '[语音消息]';
                        }
                    }
                    const sender = msg.sender === 'user' ? userNickname : aiName;
                    let quoteText = '';
                    if (msg.quote && msg.quote.content) {
                        quoteText = msg.quote.senderName ?
                            `[引用 ${msg.quote.senderName}: ${msg.quote.content}] ` :
                            `[引用 ${msg.quote.content}] `;
                    }
                    prompt += `${sender}：${quoteText}${contentStr}\n`;
                });
                prompt += `==============================\n\n`;
                prompt += `>>> 当前需要回复的消息 <<<\n`;
                prompt += `${userNickname}：${messageContent}\n\n`;
                prompt += `【当前时间】${currentTime}\n\n`;
                prompt += `请回复"当前需要回复的消息"。要求：
1. 回复要自然、亲切
2. 可以参考长期记忆和历史聊天记录
3. 记住对方昵称是"${userNickname}"
4. 直接说出回复内容，不要加任何前缀或格式
5. 【重要】消息分气泡规则：
   - 每2-3句话分成一个气泡发送
   - 用 ==== 分隔不同的气泡
   - 例如："第一句，第二句。====第三句，第四句。====第五句。"
   - 这样可以让对话更自然，像真实微信聊天一样`;


                // 显示"对方正在输入中..."
                const chatHeaderTitle = document.getElementById('chatHeaderTitle');
                const originalTitle = chatHeaderTitle ? chatHeaderTitle.textContent : '';
                if (chatHeaderTitle) {
                    chatHeaderTitle.textContent = '对方正在输入中...';
                }

                // 查找最近的图片消息
                const currentChatMessages = relationshipData.chatMessages.filter(msg => msg.chatId === currentChatId);
                const lastImageMessage = currentChatMessages.slice(-10).reverse().find(msg => {
                    // 【修复】检查消息是否有imageData字段，而不是检查内容中的<img>标签
                    return msg.imageData && msg.imageData.startsWith('data:image');
                });
                
                if (lastImageMessage) {
                    console.log('【图片】找到最近的图片消息:', lastImageMessage.fileName || '未命名');
                }

                // 【关键】使用带工具调用的API（与原始流程一致）
                const customTools = chatItem?.tools || null;
                console.log('【重回】传入的自定义工具:', customTools ? customTools.map(t => t.function?.name) : '无');
                const result = await callOpenAIAPIWithTools(prompt, lastImageMessage?.imageData, null, customTools);

                // 恢复原标题
                if (chatHeaderTitle) {
                    chatHeaderTitle.textContent = originalTitle;
                }

                // 检查结果
                if (!result || typeof result !== 'object') {
                    console.error('❌ API 返回无效结果:', result);
                    throw new Error('API 返回了无效的结果格式');
                }

                let actualReply = result.reply || '';
                let thoughtContent = result.thought || '';

                console.log('【重回】AI重新回复:', actualReply);

                // 防御性检查
                if (!actualReply || typeof actualReply !== 'string') {
                    actualReply = String(actualReply || '');
                }

                if (!actualReply.trim()) {
                    showToast('AI没有返回有效回复');
                    return;
                }

                // 【智能格式修复】
                actualReply = await fixMessageFormat(actualReply);

                // 【关键】处理分句（使用====分隔）
                if (actualReply.includes('====')) {
                    const messages = actualReply.split('====').map(msg => msg.trim()).filter(msg => msg);

                    for (let message of messages) {
                        message = await fixMessageFormat(message);

                        // 处理各种特殊格式
                        const undoData = parseUndoFromMessage(message);
                        if (undoData && undoData.undo) {
                            const targetSender = undoData.sender === '用户' ? 'user' : (undoData.sender === 'AI' ? 'ai' : null);
                            if (targetSender) {
                                undoMessage(undoData.undo, targetSender);
                            } else {
                                undoMessage(undoData.undo);
                            }
                            continue;
                        }

                        const musicData = parseMusicFromMessage(message);
                        if (musicData && musicData.action) {
                            handleMusicControl(musicData.action);
                            if (musicData.content) {
                                let quoteData = parseQuoteFromMessage(musicData.content);
                                quoteData = processQuoteSenderName(quoteData, chatItem);
                                const actualContent = quoteData ? quoteData.content : musicData.content;
                                await saveAndDisplayAIMessage(actualContent, chatItem, quoteData ? quoteData.quote : null);
                            }
                            continue;
                        }

                        const callData = parseCallFromMessage(message);
                        if (callData && callData.reason) {
                            receiveIncomingCall(currentChatId);
                            if (callData.content) {
                                let quoteData = parseQuoteFromMessage(callData.content);
                                quoteData = processQuoteSenderName(quoteData, chatItem);
                                const actualContent = quoteData ? quoteData.content : callData.content;
                                await saveAndDisplayAIMessage(actualContent, chatItem, quoteData ? quoteData.quote : null);
                            }
                            continue;
                        }

                        const voiceData = parseVoiceFromMessage(message);
                        if (voiceData && voiceData.transcript) {
                            const voiceContent = `data:audio/wav;base64,UklGRiQAAABXQVZFZm10IBAAAAABAAEAQB8AAEAfAAABAAgAZGF0YQAAAAA=`;
                            const voiceDuration = Math.max(3, Math.ceil(voiceData.transcript.length / 5));
                            const voiceUrl = `${voiceContent}?duration=${voiceDuration}&transcript=${encodeURIComponent(voiceData.transcript)}`;

                            displayMessage('ai', voiceUrl, false, null, 'voice', true, null, chatItem);

                            const voiceTimestamp = Date.now();
                            const voiceMessage = {
                                sender: 'ai',
                                senderName: chatItem ? chatItem.name : '',
                                senderAvatar: chatItem ? chatItem.avatar : '',
                                content: voiceUrl,
                                timestamp: voiceTimestamp,
                                chatId: currentChatId,
                                type: 'voice',
                                isGroupChat: chatItem ? chatItem.isGroupChat : false
                            };
                            relationshipData.chatMessages.push(voiceMessage);
                            ChatMessageManager.saveMessage(voiceMessage).catch(err => console.error('保存AI语音消息失败:', err));
                            saveData();
                            
                            // 【修复】增加AI消息计数
                            await incrementAIMessageCount(currentChatId);

                            if (voiceData.content) {
                                let quoteData = parseQuoteFromMessage(voiceData.content);
                                quoteData = processQuoteSenderName(quoteData, chatItem);
                                const actualContent = quoteData ? quoteData.content : voiceData.content;
                                await saveAndDisplayAIMessage(actualContent, chatItem, quoteData ? quoteData.quote : null);
                            }
                            continue;
                        }

                        const letterData = parseLetterFromMessage(message);
                        if (letterData && letterData.letterContent) {
                            addNewLetter(
                                letterData.letterContent,
                                letterData.event || '',
                                null,
                                letterData.festival || '',
                                chatItem.id,
                                chatItem.remark || chatItem.name
                            );
                            showToast(`${chatItem.remark || chatItem.name}给你写了一封信！`, 'success');

                            if (letterData.content) {
                                let quoteData = parseQuoteFromMessage(letterData.content);
                                quoteData = processQuoteSenderName(quoteData, chatItem);
                                const actualContent = quoteData ? quoteData.content : letterData.content;
                                await saveAndDisplayAIMessage(actualContent, chatItem, quoteData ? quoteData.quote : null);
                            }
                            continue;
                        }

                        // 解析引用和心声
                        let quoteData = parseQuoteFromMessage(message);
                        quoteData = processQuoteSenderName(quoteData, chatItem);
                        const actualContent = quoteData ? quoteData.content : message;

                        const thoughtData = parseInnerThoughtFromMessage(actualContent);
                        const finalContent = thoughtData ? thoughtData.content : actualContent;

                        await saveAndDisplayAIMessage(finalContent, chatItem, quoteData ? quoteData.quote : null, thoughtData ? thoughtData.thought : thoughtContent);
                    }
                } else {
                    // 单条消息处理
                    let quoteData = parseQuoteFromMessage(actualReply);
                    quoteData = processQuoteSenderName(quoteData, chatItem);
                    const actualContent = quoteData ? quoteData.content : actualReply;

                    const thoughtData = parseInnerThoughtFromMessage(actualContent);
                    const finalContent = thoughtData ? thoughtData.content : actualContent;

                    await saveAndDisplayAIMessage(finalContent, chatItem, quoteData ? quoteData.quote : null, thoughtData ? thoughtData.thought : thoughtContent);
                }

                showToast('AI已重新回复');

            } catch (error) {
                console.error('【重回】重新发送消息失败:', error);
                showToast('重新请求失败，请重试');
            }
        }

        // 辅助函数：保存并显示AI消息
        async function saveAndDisplayAIMessage(content, chatItem, quote = null, thought = null) {
            const aiMessage = {
                sender: 'ai',
                senderName: chatItem ? chatItem.name : '',
                senderAvatar: chatItem ? chatItem.avatar : '',
                content: content,
                timestamp: Date.now(),
                chatId: currentChatId,
                quote: quote,
                isGroupChat: chatItem ? chatItem.isGroupChat : false
            };

            relationshipData.chatMessages.push(aiMessage);
            clearCurrentChatMessagesCache();

            displayMessage('ai', content, false, quote, 'text', true, null, chatItem, thought);

            ChatMessageManager.saveMessage(aiMessage).catch(err => {
                console.error('【重回】保存AI消息失败:', err);
            });
            saveData();
            
            // 【修复】增加AI消息计数
            await incrementAIMessageCount(currentChatId);

            scrollChatToBottom();
        }

        // 显示通话选择弹窗
        function showCallTypeModal() {
            const modal = document.getElementById('callTypeModal');
            if (modal) {
                modal.classList.add('show');
            }
        }

        // 关闭通话选择弹窗
        function closeCallTypeModal(event) {
            // 如果点击的是弹窗背景或者取消按钮，则关闭
            if (!event || event.target === event.currentTarget) {
                const modal = document.getElementById('callTypeModal');
                if (modal) {
                    modal.classList.remove('show');
                }
            }
        }

        // 选择通话类型
        function selectCallType(type) {
            closeCallTypeModal();
            if (type === 'voice') {
                openVoiceCall();
            } else if (type === 'video') {
                // 进入视频通话等待接通界面
                startVideoCallConnection();
            }
        }
        
        // 视频通话连接状态
        let videoCallConnectionState = {
            isConnecting: false,
            isConnected: false,
            connectionTimer: null
        };
        
        // 开始视频通话连接（等待接通界面）
        async function startVideoCallConnection() {
            console.log('【视频通话】开始连接，当前AI ID:', currentChatId);
            
            // 检查是否有设置视频
            const settings = await localforage.getItem('videoCallSettings_' + currentChatId);
            console.log('【视频通话】加载到的设置:', settings);
            
            if (!settings || !settings.hasVideo1) {
                console.log('【视频通话】没有设置视频，打开设置页面');
                showCustomAlert('提示', '请先设置视频通话素材', 'info');
                openVideoCallSettings();
                return;
            }
            
            // 设置视频通话状态
            videoCallState.callType = 'outgoing';
            videoCallState.isActive = true;
            videoCallState.isWaiting = true;
            videoCallState.isConnected = false;
            videoCallState.startTime = Date.now();
            videoCallState.callMessages = [];
            
            // 显示等待接通页面
            const connectingPage = document.getElementById('videoCallConnectingPage');
            if (connectingPage) {
                // 显示拨出界面（我打过去）
                document.getElementById('incomingCallContainer').style.display = 'none';
                document.getElementById('outgoingCallCamera').style.display = 'block';
                document.getElementById('outgoingCallOverlay').style.display = 'flex';
                document.getElementById('outgoingCallControls').style.display = 'flex';
                
                connectingPage.classList.add('show');
            }
            
            // 初始化摄像头
            await initConnectingCamera();
            
            // 加载已保存的视频设置
            await loadVideoCallSettings();
            
            // 模拟AI接听（2-4秒随机）
            const answerDelay = 2000 + Math.random() * 2000;
            videoCallConnectionState.connectionTimer = setTimeout(() => {
                aiAnswerVideoCall();
            }, answerDelay);
        }
        
        // 初始化等待界面的摄像头
        async function initConnectingCamera() {
            try {
                const selfVideo = document.getElementById('connectingSelfVideo');
                const stream = await navigator.mediaDevices.getUserMedia({
                    video: {
                        facingMode: 'user',
                        width: { ideal: 1280, max: 1920 },
                        height: { ideal: 720, max: 1080 },
                        frameRate: { ideal: 30, max: 60 }
                    },
                    audio: false
                });

                if (selfVideo) {
                    selfVideo.srcObject = stream;
                    selfVideo.play().catch(e => console.log('摄像头播放失败:', e));
                }

                videoCallSettings.isCameraOn = true;
            } catch (error) {
                console.error('初始化摄像头失败:', error);
                showCustomAlert('错误', '无法访问摄像头', 'error');
            }
        }
        
        // AI接听视频通话
        function aiAnswerVideoCall() {
            videoCallConnectionState.isConnected = true;
            
            // 关闭等待页面
            const connectingPage = document.getElementById('videoCallConnectingPage');
            if (connectingPage) {
                connectingPage.classList.remove('show');
            }
            
            // 进入视频通话页面
            openVideoCallPage();
        }
        
        // 取消视频通话连接
        function cancelVideoCallConnection() {
            // 清除定时器
            if (videoCallConnectionState.connectionTimer) {
                clearTimeout(videoCallConnectionState.connectionTimer);
                videoCallConnectionState.connectionTimer = null;
            }
            
            // 停止摄像头
            const selfVideo = document.getElementById('connectingSelfVideo');
            if (selfVideo && selfVideo.srcObject) {
                selfVideo.srcObject.getTracks().forEach(track => track.stop());
                selfVideo.srcObject = null;
            }
            
            // 关闭等待页面
            const connectingPage = document.getElementById('videoCallConnectingPage');
            if (connectingPage) {
                connectingPage.classList.remove('show');
            }
            
            // 发送通话状态消息
            if (videoCallState.callType === 'outgoing') {
                displayCallStatusMessage('user', '已取消视频通话', 'cancel');
            }
            
            // 重置状态
            videoCallState.isActive = false;
            videoCallState.isWaiting = false;
            videoCallState.isConnected = false;
            
            videoCallConnectionState.isConnecting = false;
            videoCallConnectionState.isConnected = false;
        }
        
        // 接听AI发起的视频通话
        async function acceptIncomingVideoCall() {
            console.log('=== 接听视频通话 ===');
            
            // 停止铃声
            if (window.AndroidShell && window.AndroidShell.stopSound) {
                window.AndroidShell.stopSound();
            }
            
            // 关闭等待页面
            const connectingPage = document.getElementById('videoCallConnectingPage');
            if (connectingPage) {
                connectingPage.classList.remove('show');
            }
            
            // 设置状态
            videoCallState.isWaiting = false;
            videoCallState.isConnected = true;
            videoCallState.startTime = Date.now();
            
            // 显示AI邀请视频通话的状态提示
            displayCallStatusMessage('ai', '邀请你视频通话', 'invite');
            
            // 进入视频通话页面
            openVideoCallPage();
        }
        
        // 拒绝AI发起的视频通话
        function rejectIncomingVideoCall() {
            console.log('=== 拒绝视频通话 ===');
            
            // 停止铃声
            if (window.AndroidShell && window.AndroidShell.stopSound) {
                window.AndroidShell.stopSound();
            }
            
            // 关闭等待页面
            const connectingPage = document.getElementById('videoCallConnectingPage');
            if (connectingPage) {
                connectingPage.classList.remove('show');
            }
            
            // 发送拒绝消息
            displayCallStatusMessage('user', '已拒绝视频通话', 'reject');
            
            // 重置状态
            videoCallState.isActive = false;
            videoCallState.isWaiting = false;
            videoCallState.isConnected = false;
            videoCallState.callType = 'outgoing';
        }
        
        // AI挂断视频通话（AI主动结束通话）
        function aiEndVideoCall() {
            console.log('=== AI挂断视频通话 ===');
            
            // 停止所有视频
            for (let i = 1; i <= 4; i++) {
                if (videoLayers[i]) {
                    videoLayers[i].pause();
                    videoLayers[i].src = '';
                }
            }
            
            // 停止摄像头
            const selfVideo = document.getElementById('videoCallSelfVideo');
            if (selfVideo && selfVideo.srcObject) {
                selfVideo.srcObject.getTracks().forEach(track => track.stop());
                selfVideo.srcObject = null;
            }
            
            // 停止语音检测
            stopSpeechDetection();
            
            // 获取通话时长
            const duration = getVideoCallDuration();
            
            // AI挂断，显示通话时长
            displayCallStatusMessage('ai', `视频通话时长 ${duration}`, 'duration');
            
            // 已接通的通话需要总结
            summarizeVideoCallContent(duration);
            
            // 重置状态
            videoCallState.isActive = false;
            videoCallState.isWaiting = false;
            videoCallState.isConnected = false;
            videoCallState.callMessages = [];
            videoCallState.startTime = null;
            
            // 关闭页面
            const page = document.getElementById('videoCallPage');
            if (page) {
                page.classList.remove('show');
            }
            
            videoCallConnectionState.isConnected = false;
        }
        
        // AI取消视频通话（AI在等待时取消）
        function aiCancelVideoCall() {
            console.log('=== 取消视频通话 ===');
            
            // 停止铃声
            if (window.AndroidShell && window.AndroidShell.stopSound) {
                window.AndroidShell.stopSound();
            }
            
            // 关闭等待页面
            const connectingPage = document.getElementById('videoCallConnectingPage');
            if (connectingPage) {
                connectingPage.classList.remove('show');
            }
            
            // AI取消通话
            displayCallStatusMessage('ai', '已取消视频通话', 'cancel');
            
            // 重置状态
            videoCallState.isActive = false;
            videoCallState.isWaiting = false;
            videoCallState.isConnected = false;
            videoCallState.callType = 'outgoing';
        }
        
        // AI主动发起视频通话
        async function aiInitiateVideoCall(chatId, callReason = '') {
            console.log('=== AI发起视频通话 ===');
            console.log('Chat ID:', chatId);
            console.log('来电原因:', callReason);
            
            // 唤起APP到前台
            if (window.AndroidShell) window.AndroidShell.wakeUp();
            
            const chatItem = relationshipData.wechatChatList.find(item => item.id == chatId);
            
            if (!chatItem) {
                console.error('未找到聊天对象');
                return;
            }
            
            // 检查是否有设置视频
            const settings = await localforage.getItem('videoCallSettings_' + chatId);
            if (!settings || !settings.hasVideo1) {
                console.log('【视频通话】AI没有设置视频，无法发起视频通话');
                return;
            }
            
            // 设置当前聊天ID
            currentChatId = chatId;
            
            // 设置视频通话状态
            videoCallState.callType = 'incoming';
            videoCallState.isActive = true;
            videoCallState.isWaiting = true;
            videoCallState.isConnected = false;
            videoCallState.startTime = Date.now();
            videoCallState.callMessages = [];
            
            // 显示等待接通页面
            const connectingPage = document.getElementById('videoCallConnectingPage');
            if (connectingPage) {
                // 显示来电界面
                document.getElementById('incomingCallContainer').style.display = 'flex';
                document.getElementById('outgoingCallCamera').style.display = 'none';
                document.getElementById('outgoingCallOverlay').style.display = 'none';
                document.getElementById('outgoingCallControls').style.display = 'none';
                
                // 设置AI头像和名称
                const avatarImg = document.getElementById('incomingCallAvatar');
                const nameDiv = document.getElementById('incomingCallName');
                
                if (chatItem.avatar) {
                    avatarImg.src = chatItem.avatar;
                } else {
                    avatarImg.src = 'https://img.remit.ee/api/file/BQACAgUAAyEGAASHRsPbAAEQLr5pcaMYalRb6foPEto7azOaSLYYZAAC_RwAAr2lkFcMAvgUVejIvzgE.jpg';
                }
                nameDiv.textContent = chatItem.remark || chatItem.name || 'AI';
                
                connectingPage.classList.add('show');
            }
            
            // 播放铃声
            playVideoCallRingtone();
            
            console.log('✅ AI视频通话来电界面已显示');
        }
        
        // 播放视频通话铃声
        async function playVideoCallRingtone() {
            try {
                // 获取铃声设置
                const settings = await localforage.getItem('settings') || {};
                const ringtoneSound = settings.ringtoneSound || 'default';
                
                // 使用原生铃声
                if (window.AndroidShell && window.AndroidShell.playSound) {
                    window.AndroidShell.playSound(ringtoneSound);
                } else {
                    // 备用：使用Web Audio
                    const audio = new Audio(`sounds/${ringtoneSound}.mp3`);
                    audio.loop = true;
                    audio.play().catch(e => console.log('铃声播放失败:', e));
                }
            } catch (error) {
                console.error('播放铃声失败:', error);
            }
        }
        
        // 切换等待界面的摄像头
        function toggleConnectingCamera() {
            const selfVideo = document.getElementById('connectingSelfVideo');
            const btn = document.getElementById('connectingCameraBtn');
            
            videoCallSettings.isCameraOn = !videoCallSettings.isCameraOn;
            
            if (selfVideo && selfVideo.srcObject) {
                selfVideo.srcObject.getVideoTracks().forEach(track => {
                    track.enabled = videoCallSettings.isCameraOn;
                });
            }
            
            if (btn) {
                btn.style.opacity = videoCallSettings.isCameraOn ? '1' : '0.5';
            }
        }
        
        // 翻转等待界面的摄像头
        async function flipConnectingCamera() {
            const selfVideo = document.getElementById('connectingSelfVideo');
            if (!selfVideo || !selfVideo.srcObject) return;
            
            const currentTrack = selfVideo.srcObject.getVideoTracks()[0];
            if (!currentTrack) return;
            
            const currentSettings = currentTrack.getSettings();
            const currentFacingMode = currentSettings.facingMode;
            const newFacingMode = currentFacingMode === 'user' ? 'environment' : 'user';
            
            try {
                selfVideo.srcObject.getTracks().forEach(track => track.stop());
                
                const newStream = await navigator.mediaDevices.getUserMedia({
                    video: { facingMode: newFacingMode },
                    audio: false
                });
                
                selfVideo.srcObject = newStream;
            } catch (error) {
                console.error('翻转摄像头失败:', error);
            }
        }
        
        // 视频通话状态管理
        let videoCallState = {
            isActive: false,
            isWaiting: false,
            isConnected: false,
            callType: 'outgoing', // 'outgoing' 或 'incoming'
            startTime: null,
            callMessages: [],
            currentState: 'idle'
        };
        
        // 结束视频通话
        function endVideoCall() {
            // 停止所有视频
            for (let i = 1; i <= 4; i++) {
                if (videoLayers[i]) {
                    videoLayers[i].pause();
                    videoLayers[i].src = '';
                }
            }
            
            // 停止摄像头
            const selfVideo = document.getElementById('videoCallSelfVideo');
            if (selfVideo && selfVideo.srcObject) {
                selfVideo.srcObject.getTracks().forEach(track => track.stop());
                selfVideo.srcObject = null;
            }
            
            // 停止语音检测
            stopSpeechDetection();
            
            // 获取通话时长
            const duration = getVideoCallDuration();
            
            // 发送通话状态消息
            if (videoCallState.callType === 'outgoing') {
                // 我打过去的
                if (videoCallState.isWaiting) {
                    // 还在等待中，取消通话
                    displayCallStatusMessage('user', '已取消视频通话', 'cancel');
                } else {
                    // 已接通，显示通话时长
                    displayCallStatusMessage('user', `视频通话时长 ${duration}`, 'duration');
                    // 已接通的通话需要总结
                    summarizeVideoCallContent(duration);
                }
            } else {
                // AI打过来的
                if (videoCallState.isWaiting) {
                    // 拒绝通话
                    displayCallStatusMessage('user', '已拒绝视频通话', 'reject');
                } else {
                    // 已接通，显示通话时长
                    displayCallStatusMessage('ai', `视频通话时长 ${duration}`, 'duration');
                    // 已接通的通话需要总结
                    summarizeVideoCallContent(duration);
                }
            }
            
            // 重置状态
            videoCallState.isActive = false;
            videoCallState.isWaiting = false;
            videoCallState.isConnected = false;
            videoCallState.callMessages = [];
            videoCallState.startTime = null;
            
            // 关闭页面
            const page = document.getElementById('videoCallPage');
            if (page) {
                page.classList.remove('show');
            }
            
            videoCallConnectionState.isConnected = false;
        }
        
        // 获取视频通话时长
        function getVideoCallDuration() {
            if (!videoCallState.startTime) return '00:00';
            const duration = Math.floor((Date.now() - videoCallState.startTime) / 1000);
            const minutes = Math.floor(duration / 60);
            const seconds = duration % 60;
            return `${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}`;
        }
        
        // 总结视频通话内容
        async function summarizeVideoCallContent(duration) {
            // 检查是否有通话内容
            if (videoCallState.callMessages.length === 0) {
                console.log('没有视频通话内容需要总结');
                return;
            }
            
            // 显示正在总结的弹窗
            showSummarizingDialog();
            
            try {
                // 获取当前角色信息
                const chatItem = relationshipData.wechatChatList.find(item => item.id == currentChatId);
                const aiName = chatItem ? (chatItem.remark || chatItem.name || 'AI') : 'AI';
                const userName = '我';
                
                // 构建通话内容
                const callContent = videoCallState.callMessages.map(msg => {
                    const sender = msg.sender === 'user' ? userName : aiName;
                    const time = new Date(msg.timestamp).toLocaleTimeString('zh-CN', { hour: '2-digit', minute: '2-digit' });
                    const contentStr = ensureStringContent(msg.content);
                    return `[${time}] ${sender}: ${contentStr}`;
                }).join('\n');
                
                // 构建总结提示词
                const prompt = `你是${aiName}，请从你自己的第一人称视角总结这次视频通话的内容。

要求：
1. 用第一人称"我"来叙述，就像你自己在回忆这次通话
2. 总结要简洁，控制在50字以内
3. 要体现对话的主要内容和情感氛围
4. 不要列出时间戳，用自然的方式叙述
5. 可以适当加入一些个人感受

通话记录：
${callContent}

请用一句话总结这次视频通话：`;

                // 调用AI进行总结
                const summary = await callOpenAIAPI(prompt);
                
                // 隐藏总结弹窗
                hideSummarizingDialog();
                
                // 保存总结到聊天记录
                if (summary) {
                    addVideoCallSummaryMessage(summary, duration);
                }
                
            } catch (error) {
                console.error('视频通话总结失败:', error);
                hideSummarizingDialog();
            }
        }
        
        // 添加视频通话总结消息
        async function addVideoCallSummaryMessage(summary, duration) {
            const chatItem = relationshipData.wechatChatList.find(item => item.id == currentChatId);
            if (!chatItem) return;

            const aiName = chatItem.remark || chatItem.name || 'AI';

            // 构建总结消息
            const summaryMessage = {
                id: Date.now(),
                chatId: currentChatId,
                sender: 'ai',
                content: `[视频通话总结] ${summary}`,
                timestamp: Date.now(),
                type: 'hidden',
                isCallSummary: true,
                callDuration: duration,
                callType: 'video'
            };

            // 保存到聊天记录
            try {
                await ChatMessageManager.saveMessage(summaryMessage);
                console.log('【视频通话总结】已保存为隐藏消息');
            } catch (error) {
                console.error('【视频通话总结】保存失败:', error);
                relationshipData.chatMessages.push(summaryMessage);
                saveData();
            }

            // 添加到长期记忆
            if (!chatItem.memories) {
                chatItem.memories = [];
            }
            chatItem.memories.push({
                id: Date.now(),
                content: `视频通话总结：${summary}`,
                timestamp: Date.now()
            });
            saveData();

            // 【新增】保存到通话记录（用于通话记录页面显示）
            await saveVideoCallRecord(duration, summary);

            console.log('视频通话总结已保存:', summary);
        }

        // 【新增】保存视频通话记录
        async function saveVideoCallRecord(duration, summary) {
            const chatItem = relationshipData.wechatChatList.find(item => item.id == currentChatId);
            if (!chatItem) return;

            // 获取现有通话记录
            let callRecords = [];
            try {
                if (SQLiteManager.isAvailable) {
                    callRecords = await SQLiteManager.getCallRecordsForChat(currentChatId) || [];
                } else {
                    const callRecordsKey = `callRecords_${currentChatId}`;
                    callRecords = await localforage.getItem(callRecordsKey) || [];
                }
            } catch (e) {
                console.error('获取通话记录失败:', e);
                callRecords = [];
            }

            // 创建通话记录
            const record = {
                id: Date.now(),
                chatId: currentChatId,
                chatName: chatItem.remark || chatItem.name || 'AI',
                chatAvatar: chatItem.avatar || '',
                duration: duration,
                summary: summary,
                callDate: new Date().toLocaleDateString('zh-CN'),
                callTime: new Date().toLocaleTimeString('zh-CN', { hour: '2-digit', minute: '2-digit' }),
                timestamp: Date.now(),
                callType: 'video' // 标记为视频通话
            };

            // 添加到记录列表
            callRecords.unshift(record);

            // 保存通话记录
            let saveSuccess = false;
            if (SQLiteManager.isAvailable) {
                saveSuccess = await SQLiteManager.saveCallRecordsForChat(currentChatId, callRecords);
            }

            if (!saveSuccess) {
                const callRecordsKey = `callRecords_${currentChatId}`;
                await localforage.setItem(callRecordsKey, callRecords);
            }

            console.log('✅ 视频通话记录已保存:', record);
        }
        
        // 打开文字输入弹窗（通话中）
        function openCallTextInput() {
            const modal = document.getElementById('callTextInputModal');
            const input = document.getElementById('callTextInputField');
            if (modal) {
                modal.style.display = 'block';
                input.focus();
            }
        }
        
        // 关闭文字输入弹窗（通话中）
        function closeCallTextInput() {
            const modal = document.getElementById('callTextInputModal');
            const input = document.getElementById('callTextInputField');
            if (modal) {
                modal.style.display = 'none';
            }
            if (input) {
                input.value = '';
            }
        }
        
        // 发送文字给AI（通话中）
        async function sendCallTextToAI() {
            const input = document.getElementById('callTextInputField');
            const text = input?.value?.trim();
            
            if (!text) {
                return;
            }
            
            // 显示用户输入的文字
            setAiSpeechText('我: ' + text);
            
            // 关闭输入框
            closeCallTextInput();
            
            // 切换到准备说话状态（AI正在思考）
            switchVideoState('preparing');
            
            // 调用AI获取回复
            try {
                const aiResponse = await sendToAIForVideoCall(text);
                
                if (aiResponse) {
                    // 显示AI回复
                    setAiSpeechText(aiResponse);
                    
                    // 【关键】不在这里切换到说话状态，等待语音准备好后再切换
                    // 使用MiniMax TTS播放语音（语音准备好后会自动切换到说话视频）
                    await playAIVoiceWithVideoState(aiResponse);
                } else {
                    setAiSpeechText('抱歉，我没有听清楚');
                    switchVideoState('idle');
                }
            } catch (error) {
                console.error('【视频通话】AI调用失败:', error);
                setAiSpeechText('抱歉，我暂时无法回应');
                switchVideoState('idle');
            }
        }
        
        // 视频通话专用：发送给AI并获取回复
        // 截取视频通话中的用户画面
        async function captureVideoCallFrame() {
            try {
                const video = document.getElementById('videoCallSelfVideo');
                if (!video || !video.srcObject) {
                    console.log('【视频通话】没有视频流，无法截图');
                    return null;
                }
                
                // 创建canvas
                const canvas = document.createElement('canvas');
                canvas.width = video.videoWidth || 640;
                canvas.height = video.videoHeight || 480;
                const ctx = canvas.getContext('2d');
                
                // 水平翻转（镜像效果）
                ctx.translate(canvas.width, 0);
                ctx.scale(-1, 1);
                
                // 绘制视频帧
                ctx.drawImage(video, 0, 0, canvas.width, canvas.height);
                
                // 转换为base64
                const base64Image = canvas.toDataURL('image/jpeg', 0.8);
                console.log('【视频通话】截图成功');
                return base64Image;
            } catch (error) {
                console.error('【视频通话】截图失败:', error);
                return null;
            }
        }
        
        async function sendToAIForVideoCall(text) {
            const chatItem = relationshipData.wechatChatList.find(item => item.id == currentChatId);
            
            if (!chatItem) {
                console.error('【视频通话】找不到chatItem');
                return null;
            }
            
            try {
                // 获取用户的个人资料
                const personalProfile = await localforage.getItem('personalProfile') || {};
                const userNickname = chatItem.myNickname || personalProfile.nickname || '我';
                const aiName = chatItem.remark || chatItem.name || 'AI';
                
                // 【新增】截取用户视频画面
                const userImage = await captureVideoCallFrame();
                
                // 构建系统提示词
                let systemPrompt = `本次是视频通话，和你交流时请注意以下要求：
1. 全程不用描述任何动作语句，不使用括号，不添加任何动作描述
2. 尽量简单易懂，表达清晰直接，围绕话题沟通
3. 只说你想说的话，保持自然、真实的对话语气
4. 记住对方的昵称是"${userNickname}"，在对话中可以自然地称呼对方
5. 【重要】你可以看到对方的视频画面，可以适当评论对方的状态、表情或环境

你是${aiName}，现在正在和用户进行视频通话。请以自然、亲切的语气回应，就像真实的视频通话一样。`;
                
                // 添加人设信息
                if (chatItem.personality) {
                    systemPrompt += `\n\n【你的人设】\n${chatItem.personality}`;
                }
                
                // 添加世界书内容
                if (chatItem.worldbooks && Array.isArray(chatItem.worldbooks) && chatItem.worldbooks.length > 0) {
                    let worldbookContent = '';
                    chatItem.worldbooks.forEach(id => {
                        const worldbook = relationshipData.worldBooks.find(book => book.id == id);
                        if (worldbook && worldbook.content) {
                            worldbookContent += worldbook.content + '\n\n';
                        }
                    });
                    if (worldbookContent) {
                        systemPrompt += `\n\n【世界书设定】\n${worldbookContent.trim()}`;
                    }
                }
                
                // 构建用户提示词
                let prompt = '';
                
                // 添加长期记忆
                const memoryMountCount = chatItem.memoryMountCount || 5;
                if (chatItem.memories && Array.isArray(chatItem.memories) && chatItem.memories.length > 0) {
                    prompt += `【长期记忆 - 共${chatItem.memories.length}条，挂载最近${memoryMountCount}条】\n`;
                    const recentMemories = chatItem.memories.slice(-memoryMountCount);
                    recentMemories.forEach((memory, index) => {
                        prompt += `${index + 1}. ${memory.content}\n`;
                    });
                    prompt += '\n';
                }
                
                // 添加历史聊天记录
                const contextLength = chatItem.contextLength || 20;
                const allChatMessages = relationshipData.chatMessages
                    .filter(msg => msg.chatId == currentChatId);
                
                const historyLength = Math.min(allChatMessages.length, contextLength);
                const historyMessages = allChatMessages.slice(-historyLength);
                
                if (historyMessages.length > 0) {
                    prompt += `【历史聊天记录】\n`;
                    prompt += `==============================\n`;
                    historyMessages.forEach(msg => {
                        let contentStr = msg.content || '';
                        contentStr = contentStr.replace(/<[^>]*>/g, '');
                        contentStr = contentStr.replace(/data:audio\/[^\s]+/g, '[语音消息]');
                        const sender = msg.sender === 'user' ? userNickname : aiName;
                        
                        // 【修复】处理引用信息，如果消息包含引用，显示引用内容
                        let quoteText = '';
                        if (msg.quote && msg.quote.content) {
                            // 【修复】支持没有发送者名称的引用
                            quoteText = msg.quote.senderName ? 
                                `[引用 ${msg.quote.senderName}: ${msg.quote.content}] ` :
                                `[引用 ${msg.quote.content}] `;
                        }
                        
                        prompt += `${sender}：${quoteText}${contentStr}\n`;
                    });
                    prompt += `==============================\n\n`;
                }
                
                // 【新增】构建消息内容（支持图片）
                let userMessageContent = [];
                
                // 添加文本内容
                userMessageContent.push({
                    type: 'text',
                    text: `${userNickname}说：${text}\n\n【当前时间】${new Date().toLocaleString('zh-CN')}\n\n请回复以上内容。要求：
1. 回复要自然、亲切，就像真实视频通话一样
2. 可以参考长期记忆和历史聊天记录来保持对话连贯性
3. 记住对方昵称是"${userNickname}"，可以自然地称呼对方
4. 直接说出回复内容，不要加任何前缀或格式
5. 【重要】你可以看到对方的视频画面，可以适当评论对方的状态、表情或环境`
                });
                
                // 【新增】如果有截图，添加图片
                if (userImage) {
                    userMessageContent.push({
                        type: 'image_url',
                        image_url: {
                            url: userImage
                        }
                    });
                    console.log('【视频通话】已添加用户视频画面到AI请求');
                }
                
                // 调用支持图片的AI API
                const aiResponse = await callAIDirectlyWithSystemPromptAndImage(systemPrompt, userMessageContent);
                
                return aiResponse;
                
            } catch (error) {
                console.error('【视频通话】发送给AI失败:', error);
                return null;
            }
        }
        
        // 视频通话专用：播放AI语音并管理视频状态
        async function playAIVoiceWithVideoState(text) {
            try {
                // 获取语音设置（使用loadAppSettings，与语音通话一致）
                let settings = {};
                try {
                    settings = await loadAppSettings({});
                } catch (e) {
                    console.error('【视频通话】读取设置失败:', e);
                    settings = {};
                }
                
                const chatItem = relationshipData.wechatChatList.find(item => item.id == currentChatId);
                
                if (!chatItem || !chatItem.voiceSettings) {
                    console.log('【视频通话】未配置语音设置');
                    setTimeout(() => {
                        switchVideoState('ending');
                        setTimeout(() => {
                            switchVideoState('idle');
                        }, 2000);
                    }, 2000);
                    return;
                }
                
                const minimaxConfig = settings.minimax || {};
                
                if (!minimaxConfig.groupId || !minimaxConfig.apiKey) {
                    console.log('【视频通话】未配置MiniMax');
                    setTimeout(() => {
                        switchVideoState('ending');
                        setTimeout(() => {
                            switchVideoState('idle');
                        }, 2000);
                    }, 2000);
                    return;
                }
                
                const voiceId = chatItem.voiceSettings.voiceId || 'female-tianmei';
                const voiceSpeed = chatItem.voiceSettings.voiceSpeed || 1.0;
                const model = minimaxConfig.model || 'speech-01';
                const isNewModel = model.includes('speech-2.6') || model.includes('speech-2.8');

                // 构建请求体（根据模型版本使用不同参数）
                let requestBody;
                if (isNewModel) {
                    // 新版模型使用简化参数
                    requestBody = {
                        model: model,
                        text: text,
                        voice_id: voiceId,
                        speed: Math.min(voiceSpeed, 1.0),
                        audio_format: 'mp3'
                    };
                } else {
                    // 旧版模型使用完整参数
                    requestBody = {
                        model: model,
                        text: text,
                        voice_id: voiceId,
                        speed: Math.min(voiceSpeed, 1.0),
                        sample_rate: 32000,
                        bitrate: 128000,
                        volume: 1.0
                    };
                }
                
                const url = `${minimaxConfig.apiDomain || 'https://api.minimax.chat'}/v1/text_to_speech?GroupId=${minimaxConfig.groupId}`;
                
                // 【APK支持】检查是否使用 Cordova HTTP 插件或 XMLHttpRequest 绕过CORS
                const isCordova = typeof window.cordova !== 'undefined';
                let audioBlob;
                
                if (isCordova && window.cordova && window.cordova.plugin && window.cordova.plugin.http) {
                    console.log('【视频通话】使用 Cordova HTTP 插件');
                    
                    const response = await new Promise((resolve, reject) => {
                        window.cordova.plugin.http.sendRequest(url, {
                            method: 'POST',
                            data: requestBody,
                            headers: {
                                'Content-Type': 'application/json',
                                'Authorization': `Bearer ${minimaxConfig.apiKey}`
                            },
                            responseType: 'json'
                        }, function(response) {
                            console.log('【视频通话】Cordova HTTP 成功:', response.status);
                            resolve({
                                ok: response.status >= 200 && response.status < 300,
                                status: response.status,
                                data: response.data
                            });
                        }, function(error) {
                            console.error('【视频通话】Cordova HTTP 失败:', error);
                            reject(new Error(`HTTP ${error.status}: ${error.error}`));
                        });
                    });
                    
                    if (!response.ok) {
                        throw new Error('语音合成请求失败');
                    }
                    
                    // 解析JSON响应
                    const jsonData = response.data;
                    
                    // 提取音频数据
                    let audioBase64 = null;
                    if (jsonData.audio_base64) {
                        audioBase64 = jsonData.audio_base64;
                    } else if (jsonData.data && jsonData.data.audio) {
                        audioBase64 = jsonData.data.audio;
                    } else if (jsonData.data && jsonData.data.audio_base64) {
                        audioBase64 = jsonData.data.audio_base64;
                    } else if (jsonData.audio) {
                        audioBase64 = jsonData.audio;
                    }
                    
                    if (!audioBase64) {
                        console.error('【视频通话】未找到音频数据字段');
                        throw new Error('未找到音频数据');
                    }
                    
                    // 将base64转换为blob
                    const byteCharacters = atob(audioBase64);
                    const byteNumbers = new Array(byteCharacters.length);
                    for (let i = 0; i < byteCharacters.length; i++) {
                        byteNumbers[i] = byteCharacters.charCodeAt(i);
                    }
                    const byteArray = new Uint8Array(byteNumbers);
                    
                    let mimeType = 'audio/wav';
                    if (model.includes('speech-02') || model.includes('speech-2.6') || model.includes('speech-2.8')) {
                        mimeType = 'audio/mpeg';
                    }
                    
                    audioBlob = new Blob([byteArray], { type: mimeType });
                    
                } else if (isCordova) {
                    // 【APK备用方案】使用 XMLHttpRequest
                    console.log('【视频通话】APK环境使用 XMLHttpRequest');
                    
                    const result = await new Promise((resolve, reject) => {
                        const xhr = new XMLHttpRequest();
                        xhr.open('POST', url, true);
                        xhr.setRequestHeader('Content-Type', 'application/json');
                        xhr.setRequestHeader('Authorization', `Bearer ${minimaxConfig.apiKey}`);
                        xhr.responseType = 'arraybuffer';
                        xhr.timeout = 300000; // 【统一】300秒超时
                        
                        xhr.onload = function() {
                            console.log('【视频通话】XHR 响应:', xhr.status);
                            if (xhr.status >= 200 && xhr.status < 300) {
                                const contentType = xhr.getResponseHeader('Content-Type') || 'audio/mpeg';
                                
                                if (contentType.includes('application/json')) {
                                    const decoder = new TextDecoder('utf-8');
                                    const jsonStr = decoder.decode(xhr.response);
                                    resolve({ type: 'json', data: jsonStr });
                                } else {
                                    const blob = new Blob([xhr.response], { type: contentType });
                                    resolve({ type: 'audio', data: blob });
                                }
                            } else {
                                reject(new Error(`HTTP ${xhr.status}: ${xhr.statusText}`));
                            }
                        };
                        
                        xhr.onerror = () => {
                            console.error('【视频通话】XHR onerror 触发，尝试使用原生 HTTP');
                            // 【修复】尝试使用 Android 原生 HTTP 请求
                            if (window.AndroidShell && window.AndroidShell.httpPost) {
                                console.log('【视频通话】尝试使用原生 HTTP 请求');
                                window.handleVideoCallVoiceHttpResponse = function(statusCode, responseText) {
                                    console.log('【视频通话】原生 HTTP 响应:', statusCode);
                                    if (statusCode >= 200 && statusCode < 300) {
                                        resolve({ type: 'json', data: responseText });
                                    } else {
                                        reject(new Error('原生 HTTP 请求失败: ' + statusCode));
                                    }
                                };
                                window.AndroidShell.httpPost(url, JSON.stringify(requestBody), minimaxConfig.apiKey, 'handleVideoCallVoiceHttpResponse');
                            } else {
                                reject(new Error('XHR 请求失败'));
                            }
                        };
                        xhr.ontimeout = () => reject(new Error('XHR 请求超时'));
                        xhr.onabort = () => reject(new Error('XHR 请求被中止'));
                        
                        xhr.send(JSON.stringify(requestBody));
                    });
                    
                    if (result.type === 'json') {
                        const jsonData = JSON.parse(result.data);
                        console.log('【视频通话】JSON响应:', JSON.stringify(jsonData).substring(0, 200));
                        
                        let audioBase64 = null;
                        if (jsonData.audio_base64) {
                            audioBase64 = jsonData.audio_base64;
                        } else if (jsonData.data && jsonData.data.audio) {
                            audioBase64 = jsonData.data.audio;
                        } else if (jsonData.data && jsonData.data.audio_base64) {
                            audioBase64 = jsonData.data.audio_base64;
                        } else if (jsonData.audio) {
                            audioBase64 = jsonData.audio;
                        }
                        
                        if (!audioBase64) {
                            console.error('【视频通话】未找到音频数据字段');
                            throw new Error('未找到音频数据');
                        }
                        
                        const byteCharacters = atob(audioBase64);
                        const byteNumbers = new Array(byteCharacters.length);
                        for (let i = 0; i < byteCharacters.length; i++) {
                            byteNumbers[i] = byteCharacters.charCodeAt(i);
                        }
                        const byteArray = new Uint8Array(byteNumbers);
                        
                        let mimeType = 'audio/wav';
                        if (model.includes('speech-02') || model.includes('speech-2.6') || model.includes('speech-2.8')) {
                            mimeType = 'audio/mpeg';
                        }
                        
                        audioBlob = new Blob([byteArray], { type: mimeType });
                    } else {
                        audioBlob = result.data;
                    }
                    
                } else {
                    // 浏览器环境使用fetch（可能会有CORS问题）
                    console.log('【视频通话】浏览器环境使用fetch（可能有CORS问题）');
                    
                    const response = await fetch(url, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'Authorization': `Bearer ${minimaxConfig.apiKey}`
                        },
                        body: JSON.stringify(requestBody)
                    });
                    
                    if (!response.ok) {
                        const errorText = await response.text();
                        console.error('【视频通话】语音合成失败:', response.status, errorText);
                        throw new Error('语音合成请求失败');
                    }
                    
                    console.log('【视频通话】语音合成成功，状态:', response.status);
                    
                    const contentType = response.headers.get('content-type');
                    console.log('【视频通话】响应Content-Type:', contentType);
                    
                    // MiniMax API返回的是JSON格式，包含base64音频数据
                    if (contentType && contentType.includes('application/json')) {
                        const jsonData = await response.json();
                        console.log('【视频通话】JSON响应:', JSON.stringify(jsonData).substring(0, 200));
                        
                        // 提取音频数据
                        let audioBase64 = null;
                        
                        if (jsonData.audio_base64) {
                            audioBase64 = jsonData.audio_base64;
                        } else if (jsonData.data && jsonData.data.audio) {
                            audioBase64 = jsonData.data.audio;
                        } else if (jsonData.data && jsonData.data.audio_base64) {
                            audioBase64 = jsonData.data.audio_base64;
                        } else if (jsonData.audio) {
                            audioBase64 = jsonData.audio;
                        }
                        
                        if (!audioBase64) {
                            console.error('【视频通话】未找到音频数据字段');
                            throw new Error('未找到音频数据');
                        }
                        
                        // 将base64转换为blob
                        const byteCharacters = atob(audioBase64);
                        const byteNumbers = new Array(byteCharacters.length);
                        for (let i = 0; i < byteCharacters.length; i++) {
                            byteNumbers[i] = byteCharacters.charCodeAt(i);
                        }
                        const byteArray = new Uint8Array(byteNumbers);
                        
                        let mimeType = 'audio/wav';
                        if (model.includes('speech-02') || model.includes('speech-2.6') || model.includes('speech-2.8')) {
                            mimeType = 'audio/mpeg';
                        }
                        
                        audioBlob = new Blob([byteArray], { type: mimeType });
                    } else {
                        // 直接音频数据
                        audioBlob = await response.blob();
                    }
                }
                
                console.log('【视频通话】音频blob大小:', audioBlob.size);
                
                const audioUrl = URL.createObjectURL(audioBlob);
                
                const audio = new Audio(audioUrl);
                
                // 音频播放错误处理
                audio.onerror = (e) => {
                    console.error('【视频通话】音频播放错误:', e);
                    console.error('【视频通话】音频播放错误:', e);
                    switchVideoState('ending');
                    setTimeout(() => {
                        switchVideoState('idle');
                    }, 2000);
                };
                
                // 音频可以播放时的处理
                audio.oncanplay = () => {
                    console.log('【视频通话】音频可以播放');
                };
                
                // 音频播放结束后的处理
                audio.onended = () => {
                    console.log('【视频通话】语音播放完成');
                    switchVideoState('ending');
                    setTimeout(() => {
                        switchVideoState('idle');
                    }, 2000);
                };
                
                // 【关键】先切换到说话视频，再开始播放语音
                console.log('【视频通话】语音已准备好，切换到说话视频');
                switchVideoState('speaking');
                
                // 开始播放
                try {
                    await audio.play();
                    console.log('【视频通话】语音播放成功');
                } catch (playError) {
                    console.error('【视频通话】语音播放失败:', playError);
                    switchVideoState('ending');
                    setTimeout(() => {
                        switchVideoState('idle');
                    }, 2000);
                }
                
            } catch (error) {
                console.error('【视频通话】语音播放失败:', error);
                switchVideoState('ending');
                setTimeout(() => {
                    switchVideoState('idle');
                }, 2000);
            }
        }
        
        // 翻转通话中的摄像头
        async function flipCallCamera() {
            const selfVideo = document.getElementById('videoCallSelfVideo');
            if (!selfVideo || !selfVideo.srcObject) return;
            
            const currentTrack = selfVideo.srcObject.getVideoTracks()[0];
            if (!currentTrack) return;
            
            const currentSettings = currentTrack.getSettings();
            const currentFacingMode = currentSettings.facingMode;
            const newFacingMode = currentFacingMode === 'user' ? 'environment' : 'user';
            
            try {
                selfVideo.srcObject.getTracks().forEach(track => track.stop());
                
                const newStream = await navigator.mediaDevices.getUserMedia({
                    video: { facingMode: newFacingMode },
                    audio: true
                });
                
                selfVideo.srcObject = newStream;
            } catch (error) {
                console.error('翻转摄像头失败:', error);
            }
        }
        
        // 打开视频通话页面（接通后）
        function openVideoCallPage() {
            const page = document.getElementById('videoCallPage');
            if (page) {
                page.classList.add('show');
                
                // 设置视频通话状态
                videoCallState.isActive = true;
                videoCallState.isWaiting = false;
                videoCallState.isConnected = true;
                videoCallState.startTime = Date.now();
                videoCallState.callMessages = [];
                
                // 初始化视频层（使用视频通话页面的容器）
                initVideoLayers('.video-call-ai-area');
                
                // 预加载所有视频
                preloadAllVideos('.video-call-ai-area').then(() => {
                    // 显示并播放待机视频
                    if (videoLayers[1]) {
                        videoLayers[1].style.opacity = '1';
                        videoLayers[1].play().catch(e => console.log('待机视频播放失败:', e));
                        currentActiveLayer = 1;
                        videoCallSettings.currentState = 'idle';
                        console.log('【视频通话】开始播放待机视频');
                    }
                    
                    // 初始化自己的摄像头（小窗）
                    initSelfCameraForCall();
                    
                    // 开始语音检测和AI对话
                    startVideoCallAIChat();
                });
            }
        }
        
        // 初始化通话中的摄像头（小窗）
        async function initSelfCameraForCall() {
            try {
                const selfVideo = document.getElementById('videoCallSelfVideo');
                const stream = await navigator.mediaDevices.getUserMedia({
                    video: {
                        facingMode: 'user',
                        width: { ideal: 1280, max: 1920 },
                        height: { ideal: 720, max: 1080 },
                        frameRate: { ideal: 30, max: 60 }
                    },
                    audio: true
                });

                if (selfVideo) {
                    selfVideo.srcObject = stream;
                    selfVideo.play().catch(e => console.log('摄像头播放失败:', e));
                }
            } catch (error) {
                console.error('初始化摄像头失败:', error);
            }
        }
        
        // 开始视频通话AI对话
        function startVideoCallAIChat() {
            // 初始化音频上下文
            initAudioContext();
            
            // 开始语音检测
            startSpeechDetection();
            
            // 显示欢迎消息
            setAiSpeechText('AI已接通，开始对话吧！');
            
            // 切换到准备说话状态（等待用户输入）
            setTimeout(() => {
                switchVideoState('preparing');
            }, 2000);
        }

        // 视频通话设置相关变量
        let videoCallSettings = {
            video1Url: null,  // 待机视频（循环）
            video2Url: null,  // 准备说话视频（播放一次）
            video3Url: null,  // 说话中视频（循环）
            video4Url: null,  // 结束说话视频（播放一次）
            videoFiles: {},   // 存储文件引用，用于保存到IndexedDB
            isMicOn: true,
            isCameraOn: true,
            audioContext: null,
            analyser: null,
            speechDetectionInterval: null,
            currentState: 'idle', // idle, preparing, speaking, ending
            isSpeaking: false
        };

        // 从聊天信息弹窗打开视频通话设置
        function openVideoCallSettingsFromModal() {
            closeChatInfoModal();
            openVideoCallSettings();
        }

        // 打字无障碍功能开关状态
        let accessibilityInputEnabled = false;

        // 切换打字无障碍功能
        function toggleAccessibilityInput() {
            const toggle = document.getElementById('accessibilityInputToggle');
            accessibilityInputEnabled = toggle.checked;

            // 保存设置到本地存储
            localStorage.setItem('accessibilityInputEnabled', accessibilityInputEnabled);

            // 如果开启，显示提示
            if (accessibilityInputEnabled) {
                showCustomAlert('提示', '打字无障碍已开启，点击输入框时会弹出中央输入界面', 'info');
            }
        }

        // 加载打字无障碍设置
        function loadAccessibilityInputSetting() {
            const saved = localStorage.getItem('accessibilityInputEnabled');
            if (saved !== null) {
                accessibilityInputEnabled = saved === 'true';
                const toggle = document.getElementById('accessibilityInputToggle');
                if (toggle) {
                    toggle.checked = accessibilityInputEnabled;
                }
            }
            
            // 加载当前聊天的表情包设置
            loadChatStickerSettings();
        }

        // 加载当前聊天的表情包设置
        function loadChatStickerSettings() {
            const chatItem = relationshipData?.wechatChatList?.find(item => item.id == currentChatId);
            if (!chatItem) return;
            
            // 加载是否允许AI发表情包
            const allowSticker = chatItem.allowAISendSticker !== false; // 默认开启
            const toggle = document.getElementById('allowAISendStickerToggle');
            if (toggle) {
                toggle.checked = allowSticker;
            }
        }

        // 切换是否允许AI发表情包
        function toggleAllowAISendSticker() {
            const toggle = document.getElementById('allowAISendStickerToggle');
            if (!toggle || !currentChatId) return;
            
            const allowSticker = toggle.checked;
            
            // 更新聊天数据
            const chatItem = relationshipData.wechatChatList.find(item => item.id == currentChatId);
            if (chatItem) {
                chatItem.allowAISendSticker = allowSticker;
                
                // 保存到存储
                saveDataImmediate().then(() => {
                    if (allowSticker) {
                        showToast('已开启AI发表情包功能');
                    } else {
                        showToast('已关闭AI发表情包功能');
                    }
                });
            }
        }

        // 打开表情包库设置页面
        function openStickerLibrarySetting() {
            if (!currentChatId) {
                showToast('请先选择一个聊天');
                return;
            }
            
            const chatItem = relationshipData.wechatChatList.find(item => item.id == currentChatId);
            if (!chatItem) {
                showToast('未找到聊天信息');
                return;
            }
            
            // 关闭聊天信息弹窗
            closeChatInfoModal();
            
            // 打开表情包库设置页面
            const stickerLibraryPage = document.getElementById('stickerLibraryPage');
            if (stickerLibraryPage) {
                stickerLibraryPage.style.display = 'block';
                
                // 加载当前AI的表情包列表
                loadChatStickerLibrary(chatItem);
            }
        }

        // 加载当前AI的表情包列表
        function loadChatStickerLibrary(chatItem) {
            const stickerList = document.getElementById('chatStickerList');
            if (!stickerList) return;
            
            stickerList.innerHTML = '<div style="text-align: center; padding: 20px; color: #999;">加载中...</div>';
            
            // 获取当前AI的表情包列表
            const stickerLibrary = chatItem.stickerLibrary || [];
            
            if (stickerLibrary.length === 0) {
                stickerList.innerHTML = '<div style="text-align: center; padding: 20px; color: #999;">还没有表情包，点击下方添加</div>';
                return;
            }
            
            let html = '<div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; padding: 10px;">';
            stickerLibrary.forEach((sticker, index) => {
                html += `
                    <div style="position: relative; aspect-ratio: 1; border-radius: 8px; overflow: hidden; background: #f5f5f5;">
                        <img src="${sticker.url}" style="width: 100%; height: 100%; object-fit: cover;" 
                             onerror="this.src='https://img.58sb.cn/file/img/placeholder.png'">
                        <div style="position: absolute; bottom: 0; left: 0; right: 0; background: rgba(0,0,0,0.5); color: white; font-size: 10px; padding: 2px 4px; text-align: center; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                            ${sticker.label}
                        </div>
                        <div style="position: absolute; top: 2px; right: 2px; width: 18px; height: 18px; background: rgba(255,0,0,0.8); border-radius: 50%; color: white; font-size: 12px; display: flex; align-items: center; justify-content: center; cursor: pointer;" onclick="removeChatSticker(${index})">×</div>
                    </div>
                `;
            });
            html += '</div>';
            stickerList.innerHTML = html;
            
            // 更新标题显示数量
            const stickerCountEl = document.getElementById('chatStickerCount');
            if (stickerCountEl) {
                stickerCountEl.textContent = `(${stickerLibrary.length}个)`;
            }
        }

        // 添加表情包到当前AI的库
        function addChatSticker() {
            const urlInput = document.getElementById('stickerUrlInput');
            const labelInput = document.getElementById('stickerLabelInput');
            
            const url = urlInput?.value?.trim();
            const label = labelInput?.value?.trim();
            
            if (!url) {
                showToast('请输入表情包链接');
                return;
            }
            
            if (!label) {
                showToast('请输入表情包标签');
                return;
            }
            
            const chatItem = relationshipData.wechatChatList.find(item => item.id == currentChatId);
            if (!chatItem) {
                showToast('未找到聊天信息');
                return;
            }
            
            if (!chatItem.stickerLibrary) {
                chatItem.stickerLibrary = [];
            }
            
            // 添加表情包
            chatItem.stickerLibrary.push({ url, label });
            
            // 保存
            saveDataImmediate().then(() => {
                // 清空输入框
                if (urlInput) urlInput.value = '';
                if (labelInput) labelInput.value = '';
                
                // 重新加载列表
                loadChatStickerLibrary(chatItem);
                showToast('表情包添加成功');
            });
        }

        // 从当前AI的库中移除表情包
        function removeChatSticker(index) {
            const chatItem = relationshipData.wechatChatList.find(item => item.id == currentChatId);
            if (!chatItem || !chatItem.stickerLibrary) return;
            
            chatItem.stickerLibrary.splice(index, 1);
            
            saveDataImmediate().then(() => {
                loadChatStickerLibrary(chatItem);
                showToast('表情包已移除');
            });
        }

        // 关闭表情包库设置页面
        function closeStickerLibrarySetting() {
            const stickerLibraryPage = document.getElementById('stickerLibraryPage');
            if (stickerLibraryPage) {
                stickerLibraryPage.style.display = 'none';
            }
        }

        // 切换单个/批量添加标签
        function switchChatStickerTab(tab) {
            const singleBtn = document.getElementById('chatStickerSingleBtn');
            const batchBtn = document.getElementById('chatStickerBatchBtn');
            const singleArea = document.getElementById('chatStickerSingleArea');
            const batchArea = document.getElementById('chatStickerBatchArea');
            
            if (tab === 'single') {
                singleBtn.style.background = '#07c160';
                singleBtn.style.color = 'white';
                singleBtn.style.borderColor = '#07c160';
                batchBtn.style.background = 'white';
                batchBtn.style.color = '#666';
                batchBtn.style.borderColor = '#ddd';
                singleArea.style.display = 'block';
                batchArea.style.display = 'none';
            } else {
                batchBtn.style.background = '#07c160';
                batchBtn.style.color = 'white';
                batchBtn.style.borderColor = '#07c160';
                singleBtn.style.background = 'white';
                singleBtn.style.color = '#666';
                singleBtn.style.borderColor = '#ddd';
                batchArea.style.display = 'block';
                singleArea.style.display = 'none';
            }
        }

        // 批量添加表情包
        function batchAddChatSticker() {
            const text = document.getElementById('chatStickerBatchInput')?.value?.trim();
            if (!text) {
                showToast('请先粘贴表情包信息');
                return;
            }
            
            const chatItem = relationshipData.wechatChatList.find(item => item.id == currentChatId);
            if (!chatItem) {
                showToast('未找到聊天信息');
                return;
            }
            
            if (!chatItem.stickerLibrary) {
                chatItem.stickerLibrary = [];
            }
            
            // 解析文本
            const lines = text.split('\n');
            let addedCount = 0;
            
            lines.forEach(line => {
                line = line.trim();
                if (!line) return;
                
                let url, label;
                
                // 检查是否是 描述：URL 格式
                const colonMatch = line.match(/^(.+?)[：:]\s*(https?:\/\/\S+)$/);
                if (colonMatch) {
                    label = colonMatch[1].trim();
                    url = colonMatch[2].trim();
                } else {
                    // 检查 URL|描述 或 URL 描述 格式
                    const parts = line.split(/[\s|]+/);
                    if (parts.length >= 2) {
                        url = parts[0];
                        label = parts.slice(1).join(' ');
                        if (!url.startsWith('http')) {
                            return;
                        }
                    } else if (line.startsWith('http')) {
                        url = line;
                        label = '表情包';
                    } else {
                        return;
                    }
                }
                
                if (url) {
                    chatItem.stickerLibrary.push({ url, label: label || '表情包' });
                    addedCount++;
                }
            });
            
            if (addedCount > 0) {
                saveDataImmediate().then(() => {
                    // 清空输入框
                    const batchInput = document.getElementById('chatStickerBatchInput');
                    if (batchInput) batchInput.value = '';
                    
                    // 重新加载列表
                    loadChatStickerLibrary(chatItem);
                    showToast(`成功添加 ${addedCount} 个表情包`);
                });
            } else {
                showToast('未能解析出有效的表情包，请检查格式');
            }
        }

        // 显示打字无障碍输入框
        function showAccessibilityInput() {
            if (!accessibilityInputEnabled) return;

            const modal = document.getElementById('accessibilityInputModal');
            const inputField = document.getElementById('accessibilityInputField');
            const sendBtn = document.getElementById('accessibilityInputSendBtn');

            if (modal && inputField) {
                modal.style.display = 'flex';
                inputField.value = '';
                
                // 【鸿蒙系统兼容】绑定事件
                const isHarmonyDevice = typeof checkIsHarmonyDevice === 'function' ? checkIsHarmonyDevice() : false;
                
                // 移除旧的事件监听器
                inputField.removeEventListener('keypress', handleAccessibilityInputKeyPress);
                if (sendBtn) {
                    sendBtn.onclick = null;
                    sendBtn.removeEventListener('click', sendAccessibilityMessage);
                }
                
                // 绑定新的事件监听器
                inputField.addEventListener('keypress', handleAccessibilityInputKeyPress);
                
                if (sendBtn) {
                    if (isHarmonyDevice) {
                        // 【鸿蒙兼容】使用 onclick 属性
                        sendBtn.onclick = function(e) {
                            if (e) {
                                e.preventDefault();
                                e.stopPropagation();
                            }
                            // 延迟执行，避免键盘冲突
                            setTimeout(() => {
                                sendAccessibilityMessage();
                            }, 10);
                            return false;
                        };
                    } else {
                        sendBtn.addEventListener('click', sendAccessibilityMessage);
                    }
                }
                
                // 延迟聚焦，避免与键盘冲突
                setTimeout(() => {
                    inputField.focus();
                }, isHarmonyDevice ? 100 : 50);
            }
        }

        // 关闭打字无障碍输入框
        function closeAccessibilityInput() {
            const modal = document.getElementById('accessibilityInputModal');
            const inputField = document.getElementById('accessibilityInputField');
            const sendBtn = document.getElementById('accessibilityInputSendBtn');
            
            if (modal) {
                modal.style.display = 'none';
            }
            
            // 【鸿蒙系统兼容】移除事件监听器，避免内存泄漏
            if (inputField) {
                inputField.removeEventListener('keypress', handleAccessibilityInputKeyPress);
            }
            if (sendBtn) {
                sendBtn.onclick = null;
                sendBtn.removeEventListener('click', sendAccessibilityMessage);
            }
        }

        // 发送打字无障碍消息
        function sendAccessibilityMessage() {
            // 【鸿蒙系统兼容】添加try-catch包裹
            try {
                const inputField = document.getElementById('accessibilityInputField');
                if (!inputField) return;

                const message = inputField.value.trim();
                if (!message) {
                    showCustomAlert('提示', '请输入消息内容', 'info');
                    return;
                }

                // 【鸿蒙系统兼容】延迟关闭输入框，避免键盘冲突
                const isHarmonyDevice = typeof checkIsHarmonyDevice === 'function' ? checkIsHarmonyDevice() : false;
                const closeDelay = isHarmonyDevice ? 50 : 0;
                
                setTimeout(() => {
                    // 关闭输入框
                    closeAccessibilityInput();
                    
                    // 【鸿蒙系统兼容】延迟调用发送消息函数
                    const sendDelay = isHarmonyDevice ? 100 : 0;
                    setTimeout(() => {
                        sendMessage(message);
                    }, sendDelay);
                }, closeDelay);
            } catch (error) {
                console.error('【鸿蒙兼容】sendAccessibilityMessage 发生错误:', error);
            }
        }

        // 处理打字无障碍输入框的回车键
        function handleAccessibilityInputKeyPress(event) {
            if (event.key === 'Enter' && !event.shiftKey) {
                event.preventDefault();
                // 【鸿蒙系统兼容】阻止冒泡
                event.stopPropagation();
                sendAccessibilityMessage();
            }
        }

        // 打开视频通话设置页面
        function openVideoCallSettings() {
            const page = document.getElementById('videoCallSettingsPage');
            if (page) {
                page.classList.add('show');
                // 加载已保存的设置
                loadVideoCallSettings();
            }
        }

        // 关闭视频通话设置页面
        function closeVideoCallSettings() {
            const page = document.getElementById('videoCallSettingsPage');
            if (page) {
                page.classList.remove('show');
                // 停止视频播放
                const video = document.getElementById('videoCallMainVideo');
                if (video) {
                    video.pause();
                }
            }
        }

        // 显示保存状态
        function showSaveStatus(message, type) {
            const statusEl = document.getElementById('videoSaveStatus');
            if (statusEl) {
                statusEl.textContent = message;
                statusEl.className = 'video-save-status ' + type;
                statusEl.style.display = 'block';
                
                // 3秒后自动隐藏
                if (type !== 'loading') {
                    setTimeout(() => {
                        statusEl.style.display = 'none';
                    }, 3000);
                }
            }
        }

        // 从URL获取视频文件并保存
        async function saveVideoFromUrl(url, chatId, videoIndex) {
            try {
                showSaveStatus(`正在获取视频${videoIndex}...`, 'loading');
                
                // 从URL获取视频数据
                const response = await fetch(url);
                
                if (!response.ok) {
                    throw new Error(`HTTP错误: ${response.status}`);
                }
                
                const blob = await response.blob();
                
                if (blob.size === 0) {
                    throw new Error('视频数据为空');
                }
                
                // 创建文件对象
                const file = new File([blob], `video${videoIndex}.mp4`, { type: blob.type || 'video/mp4' });
                
                // 保存到IndexedDB
                showSaveStatus(`正在保存视频${videoIndex}...`, 'loading');
                const success = await saveVideoToDB(chatId, videoIndex, file);
                
                return success;
            } catch (error) {
                console.error('【视频通话】保存视频失败:', error);
                showSaveStatus(`视频${videoIndex}失败: ${error.message}`, 'error');
                await new Promise(resolve => setTimeout(resolve, 2000));
                return false;
            }
        }

        // 保存视频通话设置（使用base64方式，参考学习陪伴）
        async function saveVideoCallSettings() {
            try {
                showSaveStatus('正在保存视频...', 'loading');
                
                let savedCount = 0;
                const videoData = {};
                
                // 遍历所有视频
                for (let i = 1; i <= 4; i++) {
                    const file = videoCallSettings.videoFiles?.[i];
                    
                    if (file) {
                        showSaveStatus(`正在转换视频${i}...`, 'loading');
                        
                        try {
                            // 将文件转为base64
                            const base64 = await fileToBase64(file);
                            videoData[i] = base64;
                            savedCount++;
                            showSaveStatus(`视频${i}转换完成`, 'success');
                        } catch (e) {
                            showSaveStatus(`视频${i}转换失败`, 'error');
                        }
                    }
                }
                
                if (savedCount === 0) {
                    showSaveStatus('没有需要保存的视频', 'error');
                    return;
                }
                
                // 保存到localforage
                showSaveStatus('正在保存到存储...', 'loading');
                const settings = {
                    videoData: videoData,
                    hasVideo1: !!videoData[1],
                    hasVideo2: !!videoData[2],
                    hasVideo3: !!videoData[3],
                    hasVideo4: !!videoData[4],
                    savedAt: Date.now()
                };
                
                await localforage.setItem('videoCallSettings_' + currentChatId, settings);
                
                showSaveStatus(`保存成功！共保存 ${savedCount} 个视频`, 'success');
                
                setTimeout(() => {
                    closeVideoCallSettings();
                }, 1500);
            } catch (err) {
                console.error('【视频通话】保存失败:', err);
                showSaveStatus('保存失败: ' + err.message, 'error');
            }
        }

        // 加载视频通话设置（从base64加载，参考学习陪伴）
        async function loadVideoCallSettings() {
            try {
                showSaveStatus('正在加载视频...', 'loading');
                
                const settings = await localforage.getItem('videoCallSettings_' + currentChatId);
                
                if (settings && settings.videoData) {
                    let loadedCount = 0;
                    
                    // 从 videoData 加载base64视频
                    for (let i = 1; i <= 4; i++) {
                        const base64Data = settings.videoData[i];
                        
                        if (base64Data) {
                            // 将base64转为URL
                            const videoUrl = base64Data;
                            
                            // 保存URL到设置
                            switch(i) {
                                case 1: videoCallSettings.video1Url = videoUrl; break;
                                case 2: videoCallSettings.video2Url = videoUrl; break;
                                case 3: videoCallSettings.video3Url = videoUrl; break;
                                case 4: videoCallSettings.video4Url = videoUrl; break;
                            }
                            
                            // 更新UI预览
                            const previewVideo = document.getElementById('video' + i + 'Preview');
                            const placeholder = document.getElementById('video' + i + 'Placeholder');
                            
                            if (previewVideo) {
                                previewVideo.src = videoUrl;
                                previewVideo.style.display = 'block';
                                previewVideo.play().catch(e => console.log('预览播放失败:', e));
                            }
                            if (placeholder) {
                                placeholder.style.display = 'none';
                            }
                            
                            // 视频1同时设置为主视频
                            if (i === 1) {
                                const mainVideo = document.getElementById('videoCallMainVideo');
                                mainVideo.src = videoUrl;
                                mainVideo.play().catch(e => console.log('主视频播放失败:', e));
                            }
                            
                            loadedCount++;
                        }
                    }
                    
                    if (loadedCount > 0) {
                        showSaveStatus(`加载成功！共加载 ${loadedCount} 个视频`, 'success');
                    } else {
                        showSaveStatus('没有找到保存的视频', 'error');
                    }
                } else {
                    showSaveStatus('没有找到保存的设置', 'error');
                }
            } catch (err) {
                console.error('【视频通话】加载失败:', err);
                showSaveStatus('加载失败: ' + err.message, 'error');
            }
        }

        // IndexedDB 数据库名称和版本
        const VIDEO_DB_NAME = 'VideoCallDB';
        const VIDEO_DB_VERSION = 1;
        const VIDEO_STORE_NAME = 'videos';
        
        // 打开 IndexedDB 数据库
        function openVideoDB() {
            return new Promise((resolve, reject) => {
                const request = indexedDB.open(VIDEO_DB_NAME, VIDEO_DB_VERSION);
                
                request.onerror = () => reject(request.error);
                request.onsuccess = () => resolve(request.result);
                
                request.onupgradeneeded = (event) => {
                    const db = event.target.result;
                    if (!db.objectStoreNames.contains(VIDEO_STORE_NAME)) {
                        db.createObjectStore(VIDEO_STORE_NAME, { keyPath: 'id' });
                    }
                };
            });
        }
        
        // 保存视频文件到 IndexedDB
        async function saveVideoToDB(chatId, videoIndex, file) {
            try {
                console.log('【视频通话】开始保存视频到IndexedDB:', file.name);
                
                const db = await openVideoDB();
                const transaction = db.transaction([VIDEO_STORE_NAME], 'readwrite');
                const store = transaction.objectStore(VIDEO_STORE_NAME);
                
                // 读取文件为 ArrayBuffer
                const arrayBuffer = await file.arrayBuffer();
                console.log('【视频通话】文件已读取为ArrayBuffer，大小:', arrayBuffer.byteLength);
                
                const videoData = {
                    id: `video_${chatId}_${videoIndex}`,
                    chatId: chatId,
                    videoIndex: videoIndex,
                    data: arrayBuffer,
                    type: file.type,
                    name: file.name,
                    size: file.size,
                    timestamp: Date.now()
                };
                
                // 等待 transaction 完成
                await new Promise((resolve, reject) => {
                    transaction.oncomplete = () => {
                        console.log('【视频通话】Transaction 完成');
                        resolve();
                    };
                    transaction.onerror = () => {
                        console.error('【视频通话】Transaction 错误:', transaction.error);
                        reject(transaction.error);
                    };
                    
                    const request = store.put(videoData);
                    request.onsuccess = () => {
                        console.log('【视频通话】Put 操作成功');
                    };
                    request.onerror = () => {
                        console.error('【视频通话】Put 操作错误:', request.error);
                        reject(request.error);
                    };
                });
                
                console.log('【视频通话】视频已保存到IndexedDB:', file.name, '大小:', (file.size / 1024 / 1024).toFixed(2), 'MB');
                return true;
            } catch (error) {
                console.error('【视频通话】保存视频失败:', error);
                return false;
            }
        }
        
        // 从 IndexedDB 加载视频文件
        async function loadVideoFromDB(chatId, videoIndex) {
            try {
                console.log('【视频通话】开始从IndexedDB加载视频:', chatId, videoIndex);
                
                const db = await openVideoDB();
                const transaction = db.transaction([VIDEO_STORE_NAME], 'readonly');
                const store = transaction.objectStore(VIDEO_STORE_NAME);
                
                const videoData = await new Promise((resolve, reject) => {
                    const request = store.get(`video_${chatId}_${videoIndex}`);
                    request.onsuccess = () => {
                        console.log('【视频通话】Get 操作成功:', request.result ? '找到数据' : '未找到数据');
                        resolve(request.result);
                    };
                    request.onerror = () => {
                        console.error('【视频通话】Get 操作错误:', request.error);
                        reject(request.error);
                    };
                });
                
                if (videoData && videoData.data) {
                    console.log('【视频通话】视频数据大小:', videoData.data.byteLength);
                    // 将 ArrayBuffer 转换回 Blob
                    const blob = new Blob([videoData.data], { type: videoData.type });
                    const url = URL.createObjectURL(blob);
                    console.log('【视频通话】视频已从IndexedDB加载:', videoData.name);
                    return url;
                }
                console.log('【视频通话】未找到视频数据');
                return null;
            } catch (error) {
                console.error('【视频通话】加载视频失败:', error);
                return null;
            }
        }
        
        // 删除 IndexedDB 中的视频
        async function deleteVideoFromDB(chatId, videoIndex) {
            try {
                const db = await openVideoDB();
                const transaction = db.transaction([VIDEO_STORE_NAME], 'readwrite');
                const store = transaction.objectStore(VIDEO_STORE_NAME);
                
                await new Promise((resolve, reject) => {
                    const request = store.delete(`video_${chatId}_${videoIndex}`);
                    request.onsuccess = () => resolve();
                    request.onerror = () => reject(request.error);
                });
                
                console.log('【视频通话】视频已从IndexedDB删除');
                return true;
            } catch (error) {
                console.error('【视频通话】删除视频失败:', error);
                return false;
            }
        }

        // 点击上传视频
        function uploadVideo(index) {
            const input = document.getElementById('videoInput' + index);
            if (input) {
                input.click();
            }
        }

        // 处理视频选择
        async function handleVideoSelect(event, index) {
            const file = event.target.files[0];
            if (file) {
                // 保存文件引用，用于后续保存到IndexedDB
                if (!videoCallSettings.videoFiles) {
                    videoCallSettings.videoFiles = {};
                }
                videoCallSettings.videoFiles[index] = file;
                
                // 显示文件已选择提示
                showSaveStatus(`视频${index}已选择: ${file.name} (${(file.size/1024/1024).toFixed(2)}MB)`, 'success');
                
                const url = URL.createObjectURL(file);
                
                // 保存视频URL
                switch(index) {
                    case 1: videoCallSettings.video1Url = url; break;
                    case 2: videoCallSettings.video2Url = url; break;
                    case 3: videoCallSettings.video3Url = url; break;
                    case 4: videoCallSettings.video4Url = url; break;
                }
                
                // 更新预览
                const previewVideo = document.getElementById('video' + index + 'Preview');
                const placeholder = document.getElementById('video' + index + 'Placeholder');
                
                if (previewVideo) {
                    previewVideo.src = url;
                    previewVideo.style.display = 'block';
                    previewVideo.play().catch(e => console.log('预览视频播放失败:', e));
                }
                
                if (placeholder) {
                    placeholder.style.display = 'none';
                }
                
                // 如果是第一个视频（待机），同时设置为主视频
                if (index === 1) {
                    const mainVideo = document.getElementById('videoCallMainVideo');
                    mainVideo.src = url;
                    mainVideo.play().catch(e => console.log('主视频播放失败:', e));
                }
                
                console.log('【视频通话】已上传视频' + index + ':', file.name);
            }
        }

        // 视频层管理 - 预加载但不播放，切换时再播放
        let videoLayers = {};
        let currentActiveLayer = null;
        let preloadedVideos = {}; // 记录已预加载的视频
        
        // 初始化视频层
        function initVideoLayers(containerSelector) {
            const container = document.querySelector(containerSelector);
            if (!container) {
                console.error('【视频通话】找不到视频容器:', containerSelector);
                return;
            }
            
            // 创建4个视频层
            for (let i = 1; i <= 4; i++) {
                let layer = document.getElementById('videoLayer' + i);
                if (!layer) {
                    layer = document.createElement('video');
                    layer.id = 'videoLayer' + i;
                    layer.className = 'video-call-layer';
                    layer.style.cssText = 'position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity 0.8s cubic-bezier(0.4, 0, 0.2, 1); z-index: ' + i + ';';
                    container.appendChild(layer);
                }
                videoLayers[i] = layer;
                preloadedVideos[i] = false;
            }
        }
        
        // 预加载所有视频（只加载，不播放）
        async function preloadAllVideos(containerSelector) {
            // 如果没有传入容器，使用默认的预览页面容器
            if (!containerSelector) {
                containerSelector = '.video-call-preview-area-full';
            }
            initVideoLayers(containerSelector);
            
            const loadPromises = [];
            for (let i = 1; i <= 4; i++) {
                const url = videoCallSettings['video' + i + 'Url'];
                if (url && videoLayers[i]) {
                    const promise = new Promise((resolve) => {
                        const video = videoLayers[i];
                        video.src = url;
                        video.loop = (i === 1 || i === 3); // 待机(1)和说话(3)循环
                        video.muted = true;
                        video.preload = 'auto';
                        
                        // 只加载，不播放
                        video.onloadeddata = () => {
                            console.log('【视频通话】视频' + i + '预加载完成');
                            preloadedVideos[i] = true;
                            // 暂停在开头
                            video.pause();
                            video.currentTime = 0;
                            resolve(true);
                        };
                        video.onerror = () => {
                            console.log('【视频通话】视频' + i + '预加载失败');
                            resolve(false);
                        };
                        
                        video.load();
                    });
                    loadPromises.push(promise);
                }
            }
            
            await Promise.all(loadPromises);
            console.log('【视频通话】所有视频预加载完成');
        }
        
        // 切换视频状态（切换时才播放，但已预加载确保流畅）
        function switchVideoState(newState) {
            const oldState = videoCallSettings.currentState;
            if (oldState === newState) return;
            
            console.log('【视频通话】状态切换:', oldState, '->', newState);
            videoCallSettings.currentState = newState;
            
            let targetLayer = 0;
            
            switch(newState) {
                case 'idle': targetLayer = 1; break;
                case 'preparing': targetLayer = 2; break;
                case 'speaking': targetLayer = 3; break;
                case 'ending': targetLayer = 4; break;
            }
            
            if (targetLayer > 0 && videoLayers[targetLayer]) {
                const targetVideo = videoLayers[targetLayer];
                
                // 确保视频从头开始播放
                targetVideo.currentTime = 0;
                
                // 先显示（透明度变化）
                targetVideo.style.opacity = '1';
                
                // 再播放（已经预加载，所以不会卡顿）
                const playPromise = targetVideo.play();
                if (playPromise) {
                    playPromise.catch(e => console.log('视频播放失败:', e));
                }
                
                // 隐藏之前的层
                if (currentActiveLayer && videoLayers[currentActiveLayer]) {
                    const prevVideo = videoLayers[currentActiveLayer];
                    prevVideo.style.opacity = '0';
                    // 暂停之前的视频，节省资源（等待过渡完成后再暂停）
                    setTimeout(() => {
                        if (currentActiveLayer !== targetLayer) {
                            prevVideo.pause();
                        }
                    }, 800);
                }
                
                currentActiveLayer = targetLayer;
                console.log('【视频通话】切换到视频层:', targetLayer);
                
                // 对于非循环视频，监听结束事件
                const shouldLoop = (targetLayer === 1 || targetLayer === 3);
                if (!shouldLoop) {
                    targetVideo.onended = () => {
                        if (newState === 'preparing') {
                            // 准备视频播放完，暂停在最后一帧，等待语音准备好
                            console.log('【视频通话】准备视频播放完，暂停等待语音');
                            targetVideo.pause();
                            // 不自动切换到说话状态，等待语音准备好后手动切换
                        } else if (newState === 'ending') {
                            switchVideoState('idle');
                        }
                    };
                } else {
                    targetVideo.onended = null;
                }
            }
        }

        // 开始语音检测和自动切换视频（4视频流程）
        function startSpeechDetection() {
            if (!videoCallSettings.video1Url || !videoCallSettings.video3Url) {
                console.log('【视频通话】至少需要上传待机视频和说话视频');
                return;
            }
            
            // 初始化音频分析
            initAudioAnalysis();
            
            // 重置状态为待机
            videoCallSettings.currentState = 'idle';
            switchVideoState('idle');
            
            // 检测说话状态
            videoCallSettings.speechDetectionInterval = setInterval(() => {
                const volume = getAudioVolume();
                const isSpeaking = volume > 15;
                
                if (isSpeaking !== videoCallSettings.isSpeaking) {
                    videoCallSettings.isSpeaking = isSpeaking;
                    
                    if (isSpeaking) {
                        // 开始说话 - 如果有准备视频，先播放准备视频
                        if (videoCallSettings.video2Url) {
                            switchVideoState('preparing');
                        } else {
                            // 没有准备视频，直接切换到说话
                            switchVideoState('speaking');
                        }
                    } else {
                        // 停止说话 - 如果有结束视频，播放结束视频
                        if (videoCallSettings.video4Url) {
                            switchVideoState('ending');
                        } else {
                            // 没有结束视频，直接回到待机
                            switchVideoState('idle');
                        }
                    }
                }
            }, 200);
        }

        // 停止语音检测
        function stopSpeechDetection() {
            if (videoCallSettings.speechDetectionInterval) {
                clearInterval(videoCallSettings.speechDetectionInterval);
                videoCallSettings.speechDetectionInterval = null;
            }
            videoCallSettings.currentState = 'idle';
        }

        // 初始化音频分析
        function initAudioAnalysis() {
            if (!videoCallSettings.audioContext) {
                try {
                    videoCallSettings.audioContext = new (window.AudioContext || window.webkitAudioContext)();
                    navigator.mediaDevices.getUserMedia({ audio: true }).then(stream => {
                        const source = videoCallSettings.audioContext.createMediaStreamSource(stream);
                        videoCallSettings.analyser = videoCallSettings.audioContext.createAnalyser();
                        videoCallSettings.analyser.fftSize = 256;
                        source.connect(videoCallSettings.analyser);
                    }).catch(e => {
                        console.log('无法获取麦克风权限:', e);
                    });
                } catch (e) {
                    console.log('音频分析初始化失败:', e);
                }
            }
        }

        // 获取音频音量
        function getAudioVolume() {
            if (!videoCallSettings.analyser) return 0;
            
            const dataArray = new Uint8Array(videoCallSettings.analyser.frequencyBinCount);
            videoCallSettings.analyser.getByteFrequencyData(dataArray);
            
            let sum = 0;
            for (let i = 0; i < dataArray.length; i++) {
                sum += dataArray[i];
            }
            return sum / dataArray.length;
        }

        // 打开视频通话预览页面
        async function openVideoCallPreview() {
            if (!videoCallSettings.video1Url) {
                showCustomAlert('提示', '请先上传视频1（待机视频）', 'info');
                return;
            }
            
            const page = document.getElementById('videoCallPreviewPage');
            if (page) {
                page.classList.add('show');
                
                // 预加载所有视频
                await preloadAllVideos();
                
                // 显示待机视频（视频层1）
                if (videoLayers[1]) {
                    videoLayers[1].style.opacity = '1';
                    currentActiveLayer = 1;
                }
                
                // 初始化自己的摄像头
                initSelfCamera();
                
                // 延迟开始语音检测
                setTimeout(() => {
                    startSpeechDetection();
                }, 500);
            }
        }

        // 关闭视频通话预览页面
        function closeVideoCallPreview() {
            const page = document.getElementById('videoCallPreviewPage');
            if (page) {
                page.classList.remove('show');
                
                // 停止语音检测
                stopSpeechDetection();
                
                // 停止所有视频层
                for (let i = 1; i <= 4; i++) {
                    if (videoLayers[i]) {
                        videoLayers[i].pause();
                        videoLayers[i].src = '';
                    }
                }
                currentActiveLayer = null;
                
                // 停止自己的摄像头
                const selfVideo = document.getElementById('videoCallSelfVideo');
                if (selfVideo && selfVideo.srcObject) {
                    selfVideo.srcObject.getTracks().forEach(track => track.stop());
                    selfVideo.srcObject = null;
                }
            }
        }

        // 初始化自己的摄像头
        function initSelfCamera() {
            const selfVideo = document.getElementById('videoCallSelfVideo');
            if (selfVideo && navigator.mediaDevices) {
                navigator.mediaDevices.getUserMedia({ video: true, audio: false }).then(stream => {
                    selfVideo.srcObject = stream;
                }).catch(e => {
                    console.log('无法获取摄像头:', e);
                });
            }
        }

        // 移动嘴部位置
        function moveMouth(direction) {
            const step = 0.5; // 移动步长（百分比），改为0.5%让移动更精细
            switch (direction) {
                case 'up':
                    videoCallSettings.mouthPosition.y = Math.max(5, videoCallSettings.mouthPosition.y - step);
                    break;
                case 'down':
                    videoCallSettings.mouthPosition.y = Math.min(95, videoCallSettings.mouthPosition.y + step);
                    break;
                case 'left':
                    videoCallSettings.mouthPosition.x = Math.max(5, videoCallSettings.mouthPosition.x - step);
                    break;
                case 'right':
                    videoCallSettings.mouthPosition.x = Math.min(95, videoCallSettings.mouthPosition.x + step);
                    break;
            }
            
            // 更新预览页面的嘴部位置
            const mouthPreview = document.getElementById('videoCallMouthPreview');
            if (mouthPreview) {
                mouthPreview.style.left = videoCallSettings.mouthPosition.x + '%';
                mouthPreview.style.top = videoCallSettings.mouthPosition.y + '%';
            }
        }

        // 缩放嘴部
        function scaleMouth(delta) {
            videoCallSettings.mouthScale = Math.max(0.5, Math.min(2.0, videoCallSettings.mouthScale + delta));
            
            // 更新预览页面的嘴部缩放
            const mouthPreview = document.getElementById('videoCallMouthPreview');
            if (mouthPreview) {
                mouthPreview.style.transform = `translate(-50%, -50%) scale(${videoCallSettings.mouthScale})`;
            }
            
            // 更新缩放显示
            const scaleValue = document.getElementById('mouthScaleValue');
            if (scaleValue) {
                scaleValue.textContent = Math.round(videoCallSettings.mouthScale * 100) + '%';
            }
        }

        // 切换麦克风
        function toggleVideoCallMic() {
            videoCallSettings.isMicOn = !videoCallSettings.isMicOn;
            const micBtn = document.getElementById('videoCallMicBtn');
            const micStatus = document.getElementById('micStatus');
            if (micBtn) {
                micBtn.style.opacity = videoCallSettings.isMicOn ? '1' : '0.5';
            }
            if (micStatus) {
                micStatus.textContent = videoCallSettings.isMicOn ? '已开启' : '已关闭';
            }
        }

        // 切换摄像头
        function toggleVideoCallCamera() {
            videoCallSettings.isCameraOn = !videoCallSettings.isCameraOn;
            const cameraBtn = document.getElementById('videoCallCameraBtn');
            const cameraStatus = document.getElementById('cameraStatus');
            const selfView = document.querySelector('.video-call-self-view');
            
            if (cameraBtn) {
                cameraBtn.style.opacity = videoCallSettings.isCameraOn ? '1' : '0.5';
            }
            if (cameraStatus) {
                cameraStatus.textContent = videoCallSettings.isCameraOn ? '已开启' : '已关闭';
            }
            
            // 显示/隐藏右上角小窗
            if (selfView) {
                selfView.style.display = videoCallSettings.isCameraOn ? 'block' : 'none';
            }
            
            const selfVideo = document.getElementById('videoCallSelfVideo');
            if (selfVideo && selfVideo.srcObject) {
                selfVideo.srcObject.getVideoTracks().forEach(track => {
                    track.enabled = videoCallSettings.isCameraOn;
                });
            }
        }

        // 翻转摄像头
        async function flipCamera() {
            const selfVideo = document.getElementById('videoCallSelfVideo');
            if (!selfVideo) return;
            
            // 获取当前使用的摄像头
            const currentTrack = selfVideo.srcObject?.getVideoTracks()[0];
            if (!currentTrack) {
                showCustomAlert('提示', '摄像头未启动', 'info');
                return;
            }
            
            // 获取当前设置
            const currentSettings = currentTrack.getSettings();
            const currentFacingMode = currentSettings.facingMode;
            
            // 切换前后摄像头
            const newFacingMode = currentFacingMode === 'user' ? 'environment' : 'user';
            
            try {
                // 停止当前视频流
                selfVideo.srcObject.getTracks().forEach(track => track.stop());
                
                // 获取新的视频流
                const newStream = await navigator.mediaDevices.getUserMedia({
                    video: { facingMode: newFacingMode },
                    audio: false
                });
                
                // 设置新的视频流
                selfVideo.srcObject = newStream;
                
                console.log('【视频通话】摄像头已翻转:', newFacingMode);
            } catch (error) {
                console.error('【视频通话】翻转摄像头失败:', error);
                showCustomAlert('错误', '无法切换摄像头', 'error');
            }
        }

        // 设置AI说话文本
        function setAiSpeechText(text) {
            const textElement = document.getElementById('aiSpeechText');
            if (!textElement) return;

            textElement.textContent = text;

            // 移除滚动动画类
            textElement.classList.remove('scrolling');
        }

        // 清除AI说话文本
        function clearAiSpeechText() {
            const textElement = document.getElementById('aiSpeechText');
            if (textElement) {
                textElement.textContent = '';
                textElement.classList.remove('scrolling');
            }
        }

        // 打开文字输入弹窗
        function openTextInput() {
            const modal = document.getElementById('textInputModal');
            const input = document.getElementById('textInputField');
            if (modal) {
                modal.style.display = 'block';
                input.focus();
            }
        }

        // 关闭文字输入弹窗
        function closeTextInput() {
            const modal = document.getElementById('textInputModal');
            const input = document.getElementById('textInputField');
            if (modal) {
                modal.style.display = 'none';
            }
            if (input) {
                input.value = '';
            }
        }

        // 发送文字给AI
        async function sendTextToAI() {
            const input = document.getElementById('textInputField');
            const text = input?.value?.trim();
            
            if (!text) {
                return;
            }
            
            console.log('【视频通话】发送文字给AI:', text);
            
            // 显示用户输入的文字在AI文本框
            setAiSpeechText('我: ' + text);
            
            // 关闭输入框
            closeTextInput();
            
            // TODO: 这里调用AI接口发送文字
            // 示例：await sendMessageToAI(text);
            
            // 模拟AI回复
            setTimeout(() => {
                setAiSpeechText('AI收到你的消息: ' + text);
            }, 500);
        }

        // 监听回车键发送
        document.addEventListener('DOMContentLoaded', function() {
            const input = document.getElementById('textInputField');
            if (input) {
                input.addEventListener('keypress', function(e) {
                    if (e.key === 'Enter') {
                        sendTextToAI();
                    }
                });
            }
        });

        // 切换AI文本框可见性
        let isAiTextVisible = true;
        function toggleAiTextVisibility() {
            const container = document.getElementById('aiSpeechContainer');
            const btn = document.querySelector('.toggle-ai-text-btn');
            
            isAiTextVisible = !isAiTextVisible;
            
            if (container) {
                container.style.display = isAiTextVisible ? 'flex' : 'none';
            }
            
            if (btn) {
                if (isAiTextVisible) {
                    btn.classList.remove('hidden-state');
                } else {
                    btn.classList.add('hidden-state');
                }
            }
            
            console.log('【视频通话】AI文本框' + (isAiTextVisible ? '显示' : '隐藏'));
        }

        // 说话测试相关变量
        let speechTestInterval = null;

        // 播放完整视频流程测试（等待视频播放完再切换）
        async function playFullVideoFlow() {
            if (!videoCallSettings.video1Url || !videoCallSettings.video3Url) {
                showCustomAlert('提示', '请先上传视频1（待机）和视频3（说话中）', 'info');
                return;
            }
            
            const btn = document.getElementById('speechTestBtn');
            if (btn) {
                btn.disabled = true;
                btn.classList.add('testing');
                btn.textContent = '播放中...';
            }
            
            // 停止语音检测
            stopSpeechDetection();
            
            // 构建流程步骤
            const steps = [];
            steps.push({ state: 'idle', name: '待机', layer: 1 });
            if (videoCallSettings.video2Url) {
                steps.push({ state: 'preparing', name: '准备说话', layer: 2 });
            }
            steps.push({ state: 'speaking', name: '说话中', layer: 3 });
            if (videoCallSettings.video4Url) {
                steps.push({ state: 'ending', name: '结束说话', layer: 4 });
            }
            steps.push({ state: 'idle', name: '回到待机', layer: 1 });
            
            // 执行每个步骤
            for (let i = 0; i < steps.length; i++) {
                const step = steps[i];
                console.log('【视频通话】测试流程步骤', i + 1, ':', step.name);
                
                // 更新按钮文字
                if (btn) {
                    btn.textContent = step.name + '...';
                }
                
                // 切换状态
                switchVideoState(step.state);
                
                // 等待视频播放完（非循环视频）或播放3秒（循环视频）
                const isLoopVideo = (step.layer === 1 || step.layer === 3);
                
                if (isLoopVideo) {
                    // 循环视频播放3秒
                    await new Promise(resolve => setTimeout(resolve, 3000));
                } else {
                    // 非循环视频等待播放完
                    await waitForVideoEnd(step.layer);
                }
            }
            
            // 流程结束
            if (btn) {
                btn.disabled = false;
                btn.classList.remove('testing');
                btn.textContent = '点击测试完整流程';
            }
            // 重新开始语音检测
            startSpeechDetection();
        }
        
        // 等待视频播放完成
        function waitForVideoEnd(layerIndex) {
            return new Promise((resolve) => {
                const video = videoLayers[layerIndex];
                if (!video) {
                    resolve();
                    return;
                }
                
                // 如果视频已经播放完，立即返回
                if (video.ended) {
                    resolve();
                    return;
                }
                
                // 监听视频结束事件
                const onEnded = () => {
                    video.removeEventListener('ended', onEnded);
                    resolve();
                };
                video.addEventListener('ended', onEnded);
                
                // 设置最大等待时间（10秒），防止视频卡住
                setTimeout(() => {
                    video.removeEventListener('ended', onEnded);
                    resolve();
                }, 10000);
            });
        }

        // 语音通话相关变量
        let voiceCallState = {
            isActive: false,
            isWaiting: false,
            isConnected: false,
            isMicOn: false,
            isTextInputVisible: false,
            mediaRecorder: null,
            audioChunks: [],
            silenceTimer: null,
            lastSpeechTime: 0,
            audioContext: null,
            analyser: null,
            startTime: null,
            timerInterval: null,
            callType: 'outgoing', // 'outgoing' or 'incoming'
            responseTimer: null, // AI回复显示的定时器
            callMessages: [] // 通话中的对话记录
        };

        // 打开语音通话
        function openVoiceCall() {
            const voiceCallPage = document.getElementById('voiceCallPage');
            const chatItem = relationshipData.wechatChatList.find(item => item.id == currentChatId);
            
            if (!chatItem) {
                alert('请先选择一个聊天对象');
                return;
            }
            
            // 设置AI头像和备注
            const avatar = document.getElementById('voiceCallAvatar');
            const remark = document.getElementById('voiceCallRemark');
            
            if (chatItem.avatar) {
                avatar.src = chatItem.avatar;
            } else {
                avatar.src = 'https://img.remit.ee/api/file/BQACAgUAAyEGAASHRsPbAAEQLr5pcaMYalRb6foPEto7azOaSLYYZAAC_RwAAr2lkFcMAvgUVejIvzgE.jpg';
            }
            
            remark.textContent = chatItem.remark || chatItem.name || 'AI';
            
            // 重置状态
            voiceCallState.isActive = true;
            voiceCallState.isWaiting = true;
            voiceCallState.isConnected = false;
            voiceCallState.isMicOn = false;
            voiceCallState.isTextInputVisible = false;
            voiceCallState.callType = 'outgoing';
            voiceCallState.callMessages = []; // 清空通话消息记录
            
            // 显示呼出模式界面
            document.getElementById('callWaitingText').classList.remove('hidden');
            document.getElementById('incomingCallText').style.display = 'none';
            document.getElementById('outgoingControls').style.display = 'flex';
            document.getElementById('incomingControls').style.display = 'none';
            document.getElementById('aiResponseOverlay').classList.remove('show');
            document.getElementById('textInputArea').style.display = 'none';
            document.getElementById('micBtn').classList.remove('active');
            document.getElementById('callTimer').classList.remove('show');
            
            // 显示页面
            voiceCallPage.style.display = 'flex';
            
            // 开始计时（但不显示计时器）
            startCallTimer();
            
            // 发送通话邀请
            sendCallInvitation();
        }

        // 接收来电
        function receiveIncomingCall(chatId, callReason = '') {
            console.log('=== 接收来电 ===');
            console.log('聊天ID:', chatId);
            console.log('来电原因:', callReason);

            // 唤起APP到前台
            if(window.AndroidShell) window.AndroidShell.wakeUp();
            
            const voiceCallPage = document.getElementById('voiceCallPage');
            const chatItem = relationshipData.wechatChatList.find(item => item.id == chatId);
            
            if (!chatItem) {
                console.error('未找到聊天对象');
                return;
            }
            
            console.log('聊天对象:', chatItem.name);
            
            // 检查用户是否在聊天页面
            const chatInterface = document.getElementById('chatInterface');
            const isOnChatPage = chatInterface && chatInterface.style.display === 'flex';
            
            console.log('用户是否在聊天页面:', isOnChatPage);
            
            // 设置AI头像和备注
            const avatar = document.getElementById('voiceCallAvatar');
            const remark = document.getElementById('voiceCallRemark');
            
            if (chatItem.avatar) {
                avatar.src = chatItem.avatar;
            } else {
                avatar.src = 'https://img.remit.ee/api/file/BQACAgUAAyEGAASHRsPbAAEQLr5pcaMYalRb6foPEto7azOaSLYYZAAC_RwAAr2lkFcMAvgUVejIvzgE.jpg';
            }
            
            remark.textContent = chatItem.remark || chatItem.name || 'AI';
            
            // 重置状态
            voiceCallState.isActive = true;
            voiceCallState.isWaiting = true;
            voiceCallState.isConnected = false;
            voiceCallState.isMicOn = false;
            voiceCallState.isTextInputVisible = false;
            voiceCallState.callType = 'incoming';
            voiceCallState.callMessages = []; // 清空通话消息记录
            voiceCallState.callReason = callReason; // 【新增】保存来电原因
            
            // 显示来电模式界面
            document.getElementById('callWaitingText').classList.add('hidden');
            document.getElementById('incomingCallText').style.display = 'block';
            document.getElementById('outgoingControls').style.display = 'none';
            document.getElementById('incomingControls').style.display = 'flex';
            document.getElementById('aiResponseOverlay').classList.remove('show');
            document.getElementById('textInputArea').style.display = 'none';
            document.getElementById('callTimer').classList.remove('show');
            
            // 显示页面
            voiceCallPage.style.display = 'flex';
            
            // 如果用户不在聊天页面，显示全屏来电通知
            if (!isOnChatPage) {
                console.log('用户不在聊天页面，显示全屏来电通知');
                showIncomingCallNotification(chatItem);
            }
            
            console.log('✅ 来电界面已显示');
        }

        // 接听来电
        function acceptIncomingCall() {
            console.log('=== 接听来电 ===');

            // 停止原生铃声
            if (window.AndroidShell && window.AndroidShell.stopSound) {
                window.AndroidShell.stopSound();
            }

            voiceCallState.isWaiting = false;
            voiceCallState.isConnected = true;
            
            // 隐藏来电文本
            document.getElementById('incomingCallText').style.display = 'none';
            
            // 显示计时器
            document.getElementById('callTimer').classList.add('show');
            
            // 切换到呼出模式的控制按钮
            document.getElementById('incomingControls').style.display = 'none';
            document.getElementById('outgoingControls').style.display = 'flex';
            
            // 开始计时（从接通开始算）
            startCallTimer();
            
            // 【优化】直接使用AI打语音时的callReason作为开场白，不再单独请求API
            const callReason = voiceCallState.callReason || '想和你聊聊';
            
            // 记录AI开场白到通话记录
            voiceCallState.callMessages.push({
                sender: 'ai',
                content: callReason,
                timestamp: Date.now()
            });
            
            // 显示AI开场白并自动播放语音
            showAIResponse(callReason);
            
            // 在聊天界面显示通话状态
            displayCallStatusMessage('ai', '已接通', 'connected');
            
            // 跳转到聊天页面（如果不在聊天页面）
            const chatInterface = document.getElementById('chatInterface');
            const mainPage = document.getElementById('mainPage');
            
            if (mainPage && mainPage.style.display !== 'none') {
                mainPage.style.display = 'none';
            }
            if (chatInterface && chatInterface.style.display !== 'flex') {
                chatInterface.style.display = 'flex';
            }
            
            console.log('✅ 来电已接听，已跳转到聊天页面');
        }

        // 拒绝来电
        function rejectIncomingCall() {
            console.log('=== 拒绝来电 ===');

            // 停止原生铃声
            if (window.AndroidShell && window.AndroidShell.stopSound) {
                window.AndroidShell.stopSound();
            }

            // 在聊天界面显示通话状态
            displayCallStatusMessage('user', '已拒绝通话', 'reject');
            
            // 关闭通话页面
            document.getElementById('voiceCallPage').style.display = 'none';
            
            // 重置状态
            voiceCallState.isActive = false;
            voiceCallState.isWaiting = false;
            voiceCallState.isConnected = false;
            voiceCallState.isMicOn = false;
            voiceCallState.isTextInputVisible = false;
            voiceCallState.startTime = null;
            
            // 跳转到聊天页面
            const chatInterface = document.getElementById('chatInterface');
            const mainPage = document.getElementById('mainPage');
            
            if (mainPage) {
                mainPage.style.display = 'none';
            }
            if (chatInterface) {
                chatInterface.style.display = 'flex';
            }
            
            console.log('✅ 来电已拒绝，已跳转到聊天页面');
        }

        // 显示全屏来电通知
        function showIncomingCallNotification(chatItem) {
            console.log('=== 显示全屏来电通知 ===');
            console.log('聊天对象:', chatItem.name);
            
            // 使用 Capacitor 通知插件
            if (window.Capacitor && window.Capacitor.Plugins && window.Capacitor.Plugins.LocalNotifications) {
                console.log('使用 Capacitor 通知插件');
                
                const LocalNotifications = window.Capacitor.Plugins.LocalNotifications;
                
                // 获取来电铃声
                getRingtoneSound('call').then(ringtoneSound => {
                    console.log('使用来电铃声:', ringtoneSound);
                    
                    // 创建高优先级通知渠道
                    LocalNotifications.createChannel({
                        id: 'high_priority_call',
                        name: '高优先级来电',
                        description: '用于显示来电通知',
                        importance: 5,
                        visibility: 1,
                        lights: true,
                        lightColor: '#FF0000',
                        vibration: true,
                        sound: ringtoneSound
                    }).then(() => {
                        console.log('✅ 高优先级通知渠道已创建');
                    }).catch(error => {
                        console.error('❌ 创建通知渠道失败:', error);
                    });
                    
                    LocalNotifications.schedule({
                        notifications: [
                            {
                                title: `${chatItem.remark || chatItem.name || 'AI'} 来电`,
                                body: '点击接听或拒绝通话',
                                id: Date.now(),
                                schedule: { at: new Date() },
                                sound: ringtoneSound,
                                smallIcon: 'ic_stat_notify',
                                largeIcon: chatItem.avatar || 'icon',
                                attachments: null,
                                actionTypeId: '',
                                channelId: 'high_priority_call',
                                extra: {
                                    type: 'incoming_call',
                                    chatId: chatItem.id
                                }
                            }
                        ]
                    }).then(() => {
                        console.log('✅ 来电通知已发送');
                    }).catch(error => {
                        console.error('❌ 来电通知发送失败:', error);
                    });
                });
                
                // 监听通知点击事件
                LocalNotifications.addListener('localNotificationActionPerformed', (notificationAction) => {
                    console.log('通知被点击:', notificationAction);
                    
                    // 聚焦窗口并跳转到聊天页面
                    if (window.Capacitor.Plugins.App) {
                        window.Capacitor.Plugins.App.launchApp();
                    }
                    
                    // 跳转到聊天页面
                    const chatInterface = document.getElementById('chatInterface');
                    const mainPage = document.getElementById('mainPage');
                    
                    if (mainPage) {
                        mainPage.style.display = 'none';
                    }
                    if (chatInterface) {
                        chatInterface.style.display = 'flex';
                    }
                });
            } else {
                console.log('使用浏览器通知');
                
                // 浏览器环境
                if ('Notification' in window && Notification.permission === 'granted') {
                    const notification = new Notification(`${chatItem.remark || chatItem.name || 'AI'} 来电`, {
                        body: '点击接听或拒绝通话',
                        icon: chatItem.avatar || '/icon.png',
                        tag: `incoming_call_${chatItem.id}_${Date.now()}`,
                        requireInteraction: true
                    });
                    
                    notification.onclick = function() {
                        console.log('通知被点击');
                        window.focus();
                        notification.close();
                        
                        // 跳转到聊天页面
                        const chatInterface = document.getElementById('chatInterface');
                        const mainPage = document.getElementById('mainPage');
                        
                        if (mainPage) {
                            mainPage.style.display = 'none';
                        }
                        if (chatInterface) {
                            chatInterface.style.display = 'flex';
                        }
                    };
                    
                    console.log('✅ 浏览器来电通知已显示');
                }
            }
        }

        // 开始通话计时
        function startCallTimer() {
            voiceCallState.startTime = Date.now();
            updateCallTimer();
            voiceCallState.timerInterval = setInterval(updateCallTimer, 1000);
        }

        // 更新通话计时显示
        function updateCallTimer() {
            if (!voiceCallState.startTime) return;
            
            const elapsed = Date.now() - voiceCallState.startTime;
            const minutes = Math.floor(elapsed / 60000);
            const seconds = Math.floor((elapsed % 60000) / 1000);
            
            const timerElement = document.getElementById('callTimer');
            if (timerElement) {
                timerElement.textContent = `${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}`;
            }
        }

        // 停止通话计时
        function stopCallTimer() {
            if (voiceCallState.timerInterval) {
                clearInterval(voiceCallState.timerInterval);
                voiceCallState.timerInterval = null;
            }
        }

        // 获取通话时长
        function getCallDuration() {
            if (!voiceCallState.startTime) return '00:00';
            
            const elapsed = Date.now() - voiceCallState.startTime;
            const minutes = Math.floor(elapsed / 60000);
            const seconds = Math.floor((elapsed % 60000) / 1000);
            
            return `${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}`;
        }

        // 发送通话邀请
        async function sendCallInvitation() {
            const chatItem = relationshipData.wechatChatList.find(item => item.id == currentChatId);
            if (!chatItem) return;
            
            // 等待2秒，让用户看到等待状态
            await new Promise(resolve => setTimeout(resolve, 2000));
            
            // 检查通话是否还在等待中（用户可能已经挂断了）
            if (!voiceCallState.isWaiting || !voiceCallState.isActive) {
                return;
            }
            
            // 构建提示词（语音通话专用）
            const prompt = `你是${chatItem.remark || chatItem.name || 'AI'}，现在用户正在给你打电话。

请按照以下格式回复：
1. 如果你想接听，请先回复："接听"，然后写你想说的话
2. 如果你想拒绝，请回复："拒绝"

例如：
- 接听：你好，很高兴接到你的电话！有什么我可以帮你的吗？
- 拒绝：我现在不方便接电话

用户正在给你打电话...`;

            try {
                // 调用API让AI决定是否接听（不自动显示消息）
                const aiResponse = await callAIDirectlyWithoutDisplay(prompt);
                
                console.log('AI对通话邀请的回复:', aiResponse);
                
                // 检查AI是否接受
                const lowerResponse = aiResponse.toLowerCase();
                const acceptKeywords = ['接听', '接', '好', '来', '接起'];
                const rejectKeywords = ['拒绝', '不接', '忙', '不方便', '不', '没空'];
                
                let isAccepted = false;
                let isRejected = false;
                
                // 检查接听关键词
                for (const keyword of acceptKeywords) {
                    if (lowerResponse.includes(keyword)) {
                        isAccepted = true;
                        break;
                    }
                }
                
                // 检查拒绝关键词
                for (const keyword of rejectKeywords) {
                    if (lowerResponse.includes(keyword)) {
                        isRejected = true;
                        break;
                    }
                }
                
                if (isAccepted) {
                    // AI接受通话，提取"接听"之后的内容
                    let actualResponse = aiResponse;
                    for (const keyword of acceptKeywords) {
                        if (lowerResponse.includes(keyword)) {
                            const index = lowerResponse.indexOf(keyword);
                            actualResponse = aiResponse.substring(index + keyword.length).trim();
                            // 移除可能的冒号、空格等
                            actualResponse = actualResponse.replace(/^[:：\s]+/, '');
                            break;
                        }
                    }
                    
                    // 如果提取后内容为空，使用默认问候
                    if (!actualResponse) {
                        actualResponse = '你好，很高兴接到你的电话！';
                    }
                    
                    console.log('AI接听后的真实回复:', actualResponse);
                    acceptVoiceCall(actualResponse);
                } else if (isRejected) {
                    // AI拒绝通话
                    declineVoiceCall();
                } else {
                    // AI没有明确表达，默认接受
                    console.log('AI回复不明确，默认接受通话');
                    acceptVoiceCall(aiResponse);
                }
            } catch (error) {
                console.error('发送通话邀请失败:', error);
                // 默认接受
                acceptVoiceCall('你好，很高兴接到你的电话！');
            }
        }

        // AI接受通话
        function acceptVoiceCall(aiResponse) {
            voiceCallState.isWaiting = false;
            voiceCallState.isConnected = true;
            
            // 隐藏等待文本
            document.getElementById('callWaitingText').classList.add('hidden');
            
            // 显示计时器
            document.getElementById('callTimer').classList.add('show');
            
            // 重新开始计时（从接通开始算）
            stopCallTimer();
            startCallTimer();
            
            // 显示AI的真实回复在通话界面
            showAIResponse(aiResponse);
        }

        // AI拒绝通话
        function declineVoiceCall() {
            alert('对方拒绝了通话');
            endVoiceCall();
        }

        // 【新增】显示思考状态
        function showThinkingStatus() {
            const overlay = document.getElementById('aiResponseOverlay');
            const responseText = document.getElementById('aiResponseText');
            
            // 清除之前的定时器
            if (voiceCallState.responseTimer) {
                clearTimeout(voiceCallState.responseTimer);
            }
            
            responseText.textContent = '对方正在思考...';
            responseText.style.fontStyle = 'italic';
            responseText.style.color = '#999';
            overlay.classList.add('show');
        }
        
        // 【新增】隐藏思考状态
        function hideThinkingStatus() {
            const responseText = document.getElementById('aiResponseText');
            responseText.style.fontStyle = '';
            responseText.style.color = '';
            // 不隐藏overlay，因为马上要显示AI回复
        }

        // 显示AI回复
        function showAIResponse(text) {
            const overlay = document.getElementById('aiResponseOverlay');
            const responseText = document.getElementById('aiResponseText');

            // 清除之前的定时器
            if (voiceCallState.responseTimer) {
                clearTimeout(voiceCallState.responseTimer);
            }

            // 【关键修复】检查AI返回的是否包含音频数据
            if (text && text.includes('data:audio/')) {
                console.log('【语音通话】AI返回包含音频数据');
                
                // 【修复】分离文本和音频数据
                const audioIndex = text.indexOf('data:audio/');
                const textPart = text.substring(0, audioIndex).trim();
                const audioPart = text.substring(audioIndex).match(/(data:audio\/[^\s]+)/)?.[1];
                
                console.log('【语音通话】文本部分:', textPart);
                console.log('【语音通话】音频部分:', audioPart?.substring(0, 50));
                
                // 显示文本部分
                responseText.textContent = textPart || '[AI正在说话...]';
                overlay.classList.add('show');
                
                // 如果有音频数据，播放它
                if (audioPart) {
                    playBase64Audio(audioPart).then(() => {
                        console.log('【语音通话】base64音频播放完成');
                    }).catch(error => {
                        console.error('【语音通话】播放base64音频失败:', error);
                    });
                } else {
                    // 没有音频数据，使用MiniMax合成
                    playAIVoice(textPart).then(audioBlob => {
                        if (audioBlob) {
                            const objectURL = URL.createObjectURL(audioBlob);
                            const audio = new Audio(objectURL);
                            audio.volume = 1.0;
                            audio.preload = 'auto';
                            audio.play().catch(error => {
                                console.error('【语音通话】播放AI语音失败:', error);
                            });
                        }
                    });
                }
                return;
            }

            responseText.textContent = text;
            overlay.classList.add('show');

            // 播放AI语音
            playAIVoice(text).then(audioBlob => {
                if (audioBlob) {
                    const objectURL = URL.createObjectURL(audioBlob);
                    const audio = new Audio(objectURL);
                    // 【优化】设置音量为最大，避免声音虚
                    audio.volume = 1.0;
                    // 【优化】预加载音频以获得更好的播放质量
                    audio.preload = 'auto';

                    // 【优化】使用Web Audio API增强音量（解决打电话时声音虚的问题）
                    let audioContext = null;
                    let gainNode = null;
                    let source = null;

                    audio.onplay = () => {
                        try {
                            // 创建音频上下文和增益节点来增强音量
                            audioContext = new (window.AudioContext || window.webkitAudioContext)();
                            source = audioContext.createMediaElementSource(audio);
                            gainNode = audioContext.createGain();

                            // 设置增益为1.5倍（增强50%音量）
                            gainNode.gain.value = 1.5;

                            // 连接节点: source -> gainNode -> destination
                            source.connect(gainNode);
                            gainNode.connect(audioContext.destination);

                            console.log('【语音播放】已启用音量增强');
                        } catch (e) {
                            console.warn('【语音播放】音量增强初始化失败:', e);
                        }
                    };

                    audio.play().catch(error => {
                        console.error('【防闪退】播放AI语音失败:', error);
                    });

                    // 【防闪退】音频播放完成后释放资源
                    audio.onended = () => {
                        URL.revokeObjectURL(objectURL);
                        // 清理Web Audio资源
                        if (source) {
                            try { source.disconnect(); } catch (e) {}
                        }
                        if (gainNode) {
                            try { gainNode.disconnect(); } catch (e) {}
                        }
                        if (audioContext) {
                            try { audioContext.close(); } catch (e) {}
                        }
                    };
                    audio.onerror = () => {
                        URL.revokeObjectURL(objectURL);
                        // 清理Web Audio资源
                        if (source) {
                            try { source.disconnect(); } catch (e) {}
                        }
                        if (gainNode) {
                            try { gainNode.disconnect(); } catch (e) {}
                        }
                        if (audioContext) {
                            try { audioContext.close(); } catch (e) {}
                        }
                    };
                }
            }).catch(error => {
                console.error('【防闪退】生成AI语音失败:', error);
            });

            // 不自动隐藏，保持显示直到下一句话出现
        }

        // 【新增】直接播放base64音频数据
        async function playBase64Audio(base64Audio) {
            return new Promise((resolve, reject) => {
                try {
                    // 解析base64数据
                    const match = base64Audio.match(/^data:audio\/(\w+);base64,(.+)$/);
                    if (!match) {
                        reject(new Error('无效的base64音频格式'));
                        return;
                    }

                    const mimeType = `audio/${match[1]}`;
                    const base64Data = match[2];

                    // 将base64转换为blob
                    const byteCharacters = atob(base64Data);
                    const byteNumbers = new Array(byteCharacters.length);
                    for (let i = 0; i < byteCharacters.length; i++) {
                        byteNumbers[i] = byteCharacters.charCodeAt(i);
                    }
                    const byteArray = new Uint8Array(byteNumbers);
                    const audioBlob = new Blob([byteArray], { type: mimeType });

                    console.log('【语音通话】base64音频转换成功, 大小:', audioBlob.size, '类型:', mimeType);

                    // 创建音频对象并播放
                    const objectURL = URL.createObjectURL(audioBlob);
                    const audio = new Audio(objectURL);
                    audio.volume = 1.0;
                    audio.preload = 'auto';

                    // 使用Web Audio API增强音量
                    let audioContext = null;
                    let gainNode = null;
                    let source = null;

                    audio.onplay = () => {
                        try {
                            audioContext = new (window.AudioContext || window.webkitAudioContext)();
                            source = audioContext.createMediaElementSource(audio);
                            gainNode = audioContext.createGain();
                            gainNode.gain.value = 1.5;
                            source.connect(gainNode);
                            gainNode.connect(audioContext.destination);
                            console.log('【语音通话】base64音频播放已启用音量增强');
                        } catch (e) {
                            console.warn('【语音通话】base64音频音量增强初始化失败:', e);
                        }
                    };

                    audio.onended = () => {
                        URL.revokeObjectURL(objectURL);
                        if (source) try { source.disconnect(); } catch (e) {}
                        if (gainNode) try { gainNode.disconnect(); } catch (e) {}
                        if (audioContext) try { audioContext.close(); } catch (e) {}
                        resolve();
                    };

                    audio.onerror = (error) => {
                        URL.revokeObjectURL(objectURL);
                        if (source) try { source.disconnect(); } catch (e) {}
                        if (gainNode) try { gainNode.disconnect(); } catch (e) {}
                        if (audioContext) try { audioContext.close(); } catch (e) {}
                        reject(error);
                    };

                    audio.play().catch(error => {
                        console.error('【语音通话】播放base64音频失败:', error);
                        reject(error);
                    });

                } catch (error) {
                    console.error('【语音通话】处理base64音频失败:', error);
                    reject(error);
                }
            });
        }

        // 清除AI回复显示（在下一句话出现时调用）
        function clearAIResponse() {
            const overlay = document.getElementById('aiResponseOverlay');
            if (overlay) {
                overlay.classList.remove('show');
            }
        }

        // 播放AI语音（使用minimax语音接口）
        // 【防闪退】AI语音合成
        async function playAIVoice(text) {
            // 【防闪退】添加try-catch包裹
            try {
                console.log('【防闪退】开始AI语音合成，文本:', text?.substring(0, 50));
                console.log('【调试】currentChatId:', currentChatId);
                console.log('【调试】relationshipData:', !!relationshipData);

                // 【防闪退】检查参数
                if (!text || typeof text !== 'string') {
                    console.warn('【防闪退】文本内容无效:', text);
                    return null;
                }

                // 【防闪退】检查currentChatId
                if (!currentChatId) {
                    console.warn('【防闪退】currentChatId为空');
                    return null;
                }

                // 【防闪退】检查relationshipData
                if (!relationshipData || !relationshipData.wechatChatList) {
                    console.warn('【防闪退】relationshipData未初始化');
                    return null;
                }

                let settings = {};
                try {
                    settings = await loadAppSettings({});
                    console.log('【调试】已加载设置:', !!settings);
                } catch (e) {
                    console.warn('【防闪退】读取设置失败:', e);
                    settings = {};
                }

                const chatItem = relationshipData.wechatChatList.find(item => item.id == currentChatId);
                console.log('【调试】找到chatItem:', !!chatItem, 'voiceSettings:', !!chatItem?.voiceSettings);

                if (!chatItem || !chatItem.voiceSettings) {
                    console.log('【防闪退】未配置语音设置，跳过语音播放');
                    return null;
                }

                const minimaxConfig = settings.minimax || {};
                console.log('【调试】MiniMax配置:', {
                    hasGroupId: !!minimaxConfig.groupId,
                    hasApiKey: !!minimaxConfig.apiKey,
                    model: minimaxConfig.model,
                    apiDomain: minimaxConfig.apiDomain
                });
                
                if (!minimaxConfig.groupId || !minimaxConfig.apiKey) {
                    console.log('【防闪退】未配置minimax语音接口，跳过语音播放');
                    return null;
                }

                const voiceId = chatItem.voiceSettings.voiceId || 'female-tianmei';
                const voiceSpeed = chatItem.voiceSettings.voiceSpeed || 1.0;
                const voiceLanguage = chatItem.voiceSettings.voiceLanguage || 'zh-CN';

                console.log('【语音合成】配置信息:', {
                    groupId: minimaxConfig.groupId ? '已设置' : '未设置',
                    apiKey: minimaxConfig.apiKey ? '已设置' : '未设置',
                    model: minimaxConfig.model || 'speech-01',
                    voiceId: voiceId,
                    voiceSpeed: voiceSpeed,
                    apiDomain: minimaxConfig.apiDomain || 'https://api.minimax.chat'
                });

                // 使用 voice_id，保持用户设置的格式
                let minimaxVoiceId = voiceId;
                console.log('【语音合成】使用 voice_id:', minimaxVoiceId);

                // 【APK支持】检查是否使用 Cordova HTTP 插件
                const isCordova = typeof window.cordova !== 'undefined';

                // 【防闪退】添加超时处理
                const controller = new AbortController();
                const timeoutId = setTimeout(() => controller.abort(), 300000); // 【修改】300秒超时

                try {
                    // 【优化】使用MiniMax T2A API，添加高质量音频参数
                    const model = minimaxConfig.model || 'speech-01';
                    const isNewModel = model.includes('speech-2.6') || model.includes('speech-2.8');

                    // 根据模型版本构建请求体
                    // 【修复】所有模型都使用高质量音频参数
                    let requestBody = {
                        model: model,
                        text: text,
                        voice_id: voiceId,
                        speed: Math.min(voiceSpeed, 1.0),
                        sample_rate: 32000,  // 高采样率，保证音质
                        bitrate: 128000,     // 高比特率，保证音质
                        volume: 1.0          // 正常音量
                    };
                    
                    // 新版模型可能需要不同的参数格式
                    if (isNewModel) {
                        // 新版模型可能需要额外的音频格式参数
                        requestBody.audio_format = 'mp3';  // 明确指定音频格式
                    }
                    console.log('【语音合成】请求体:', JSON.stringify(requestBody, null, 2));

                    const url = `${minimaxConfig.apiDomain || 'https://api.minimax.chat'}/v1/text_to_speech?GroupId=${minimaxConfig.groupId}`;
                    let response;

                    // 【修复】优先使用原生 HTTP 请求（绕过 CapacitorHttp 插件的拦截）
                    if (isCordova && window.AndroidShell && window.AndroidShell.httpPost) {
                        console.log('【语音合成】使用 Android 原生 HTTP 请求（绕过 CapacitorHttp）');
                        
                        const result = await new Promise((resolve, reject) => {
                            // 设置全局回调函数
                            window.handleChatVoiceHttpResponse = function(statusCode, responseText) {
                                console.log('【语音合成】原生 HTTP 响应:', statusCode);
                                if (statusCode >= 200 && statusCode < 300) {
                                    resolve({ type: 'json', data: responseText });
                                } else {
                                    reject(new Error('原生 HTTP 请求失败: ' + statusCode));
                                }
                            };
                            
                            // 调用原生 HTTP 请求
                            window.AndroidShell.httpPost(url, JSON.stringify(requestBody), minimaxConfig.apiKey, 'handleChatVoiceHttpResponse');
                            
                            // 设置超时
                            setTimeout(() => {
                                reject(new Error('原生 HTTP 请求超时'));
                            }, 300000); // 300秒超时
                        });
                        
                        if (result.type === 'json') {
                            // 解析JSON，提取base64音频
                            const jsonData = JSON.parse(result.data);
                            console.log('【语音合成】解析的JSON:', JSON.stringify(jsonData, null, 2));

                            // 检查是否有音频数据字段 - 支持多种可能的字段名
                            let audioBase64 = null;
                            let audioHex = null;

                            // 尝试各种可能的音频数据字段
                            if (jsonData.audio_base64) {
                                audioBase64 = jsonData.audio_base64;
                                console.log('【防闪退】找到音频数据字段: audio_base64');
                            } else if (jsonData.data && jsonData.data.audio) {
                                audioBase64 = jsonData.data.audio;
                                console.log('【防闪退】找到音频数据字段: data.audio');
