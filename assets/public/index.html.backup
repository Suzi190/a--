                    });
                    // 插入新数据
                    for (const chat of chatList) {
                        await CapacitorSQLite.run({
                            database: 'chat_messages.db',
                            statement: `INSERT INTO chat_list (id, data, updated_at) VALUES (?, ?, ?)`,
                            values: [chat.id, JSON.stringify(chat), Date.now()]
                        });
                    }
                    return true;
                } catch (error) {
                    console.error('【SQLite】保存聊天列表失败:', error);
                    return false;
                }
            },
            
            // 【统一存储】获取聊天列表
            async getChatList() {
                if (!this.isAvailable) return [];
                try {
                    const { CapacitorSQLite } = window.Capacitor.Plugins;
                    const result = await CapacitorSQLite.query({
                        database: 'chat_messages.db',
                        statement: `SELECT data FROM chat_list ORDER BY updated_at DESC`
                    });
                    // 【修复】安全解析聊天列表数据
                    return result.values.map(row => {
                        try {
                            return JSON.parse(row.data);
                        } catch (e) {
                            console.warn('【SQLite】getChatList: 数据解析失败:', row.data);
                            return null;
                        }
                    }).filter(item => item !== null);
                } catch (error) {
                    console.error('【SQLite】获取聊天列表失败:', error);
                    return [];
                }
            },
            
