                                <span>+ 记录</span>
                            </button>
                        </div>
                        <div class="measurement-tabs">
                            <button class="measurement-tab active" data-type="waist" onclick="switchMeasurementTab('waist')">腰围</button>
                            <button class="measurement-tab" data-type="chest" onclick="switchMeasurementTab('chest')">胸围</button>
                            <button class="measurement-tab" data-type="hip" onclick="switchMeasurementTab('hip')">臀围</button>
                            <button class="measurement-tab" data-type="arm" onclick="switchMeasurementTab('arm')">臂围</button>
                            <button class="measurement-tab" data-type="thigh" onclick="switchMeasurementTab('thigh')">大腿</button>
                            <button class="measurement-tab" data-type="calf" onclick="switchMeasurementTab('calf')">小腿</button>
                        </div>
                        <div class="chart-container">
                            <canvas id="measurementChart"></canvas>
                        </div>
                    </div>
                </div>
            `;
            document.body.appendChild(page);

            // 初始化图表
            setTimeout(() => {
                initWeightChart(weightHistory);
                initFastingChart(fastingStats.history);
                initMeasurementChart(measurementsHistory, 'waist');
            }, 100);
        }

        // 关闭数据页面
        function closeDataPage() {
            const page = document.getElementById('dataPage');
            if (page) page.remove();
        }

        // 计算BMI
        function calculateBMI(weight, height) {
            const heightInM = height / 100;
            return (weight / (heightInM * heightInM)).toFixed(1);
        }

        // 获取BMI状态
        function getBMIStatus(bmi) {
            if (bmi < 18.5) return '偏瘦';
            if (bmi < 24) return '正常';
            if (bmi < 28) return '偏胖';
            return '肥胖';
        }

        // 计算体脂率（基于BMI的估算公式）
        function calculateBodyFat(bmi, age, gender) {
            // 使用Deurenberg公式估算
            const genderFactor = gender === 'female' ? 1 : 0;
            const bodyFat = (1.2 * bmi) + (0.23 * age) - (10.8 * genderFactor) - 5.4;
            return Math.max(5, Math.min(50, bodyFat)).toFixed(1);
        }

        // 计算基础代谢率（Mifflin-St Jeor公式）
        function calculateBMR(weight, height, age, gender) {
            let bmr;
            if (gender === 'female') {
                bmr = (10 * weight) + (6.25 * height) - (5 * age) - 161;
            } else {
                bmr = (10 * weight) + (6.25 * height) - (5 * age) + 5;
            }
            return Math.round(bmr);
        }

        // 初始化体重图表
        function initWeightChart(weightHistory) {
            const canvas = document.getElementById('weightChart');
            if (!canvas) return;

            const ctx = canvas.getContext('2d');
            const dpr = window.devicePixelRatio || 1;
            const rect = canvas.parentElement.getBoundingClientRect();
            canvas.width = rect.width * dpr;
            canvas.height = 200 * dpr;
            ctx.scale(dpr, dpr);

            const width = rect.width;
            const height = 200;

            // 清空画布
            ctx.clearRect(0, 0, width, height);

            if (weightHistory.length < 2) {
                ctx.font = '14px sans-serif';
                ctx.fillStyle = '#999';
                ctx.textAlign = 'center';
                ctx.fillText('数据不足，请继续记录体重', width / 2, height / 2);
                return;
            }

            // 计算数据范围
            const weights = weightHistory.map(d => d.weight);
            const minWeight = Math.min(...weights) - 2;
            const maxWeight = Math.max(...weights) + 2;
            const weightRange = maxWeight - minWeight;

            // 绘制网格线
            ctx.strokeStyle = '#f0f0f0';
            ctx.lineWidth = 1;
            for (let i = 0; i <= 4; i++) {
                const y = 30 + (height - 60) * i / 4;
                ctx.beginPath();
                ctx.moveTo(40, y);
                ctx.lineTo(width - 20, y);
                ctx.stroke();
            }

            // 绘制折线
            ctx.strokeStyle = '#ff6b9d';
            ctx.lineWidth = 3;
            ctx.beginPath();

            weightHistory.forEach((data, index) => {
                const x = 40 + (width - 60) * index / (weightHistory.length - 1);
                const y = 30 + (height - 60) * (maxWeight - data.weight) / weightRange;

                if (index === 0) {
                    ctx.moveTo(x, y);
                } else {
                    ctx.lineTo(x, y);
                }
            });
            ctx.stroke();

            // 绘制数据点
            weightHistory.forEach((data, index) => {
                const x = 40 + (width - 60) * index / (weightHistory.length - 1);
                const y = 30 + (height - 60) * (maxWeight - data.weight) / weightRange;

                // 外圈
                ctx.fillStyle = '#ff6b9d';
                ctx.beginPath();
                ctx.arc(x, y, 6, 0, Math.PI * 2);
                ctx.fill();

                // 内圈
                ctx.fillStyle = 'white';
                ctx.beginPath();
                ctx.arc(x, y, 3, 0, Math.PI * 2);
                ctx.fill();

                // 显示数值
                ctx.font = '12px sans-serif';
                ctx.fillStyle = '#333';
                ctx.textAlign = 'center';
                ctx.fillText(data.weight + 'kg', x, y - 10);

                // 显示日期
                const date = new Date(data.date);
                const dateStr = `${date.getMonth() + 1}/${date.getDate()}`;
                ctx.fillStyle = '#999';
                ctx.fillText(dateStr, x, height - 10);
            });
        }

        // 初始化断食图表
        function initFastingChart(fastingHistory) {
            const canvas = document.getElementById('fastingChart');
            if (!canvas) return;

            const ctx = canvas.getContext('2d');
            const dpr = window.devicePixelRatio || 1;
            const rect = canvas.parentElement.getBoundingClientRect();
            canvas.width = rect.width * dpr;
            canvas.height = 200 * dpr;
            ctx.scale(dpr, dpr);

            const width = rect.width;
            const height = 200;

            // 清空画布
            ctx.clearRect(0, 0, width, height);

            if (fastingHistory.length < 2) {
                ctx.font = '14px sans-serif';
                ctx.fillStyle = '#999';
                ctx.textAlign = 'center';
                ctx.fillText('数据不足，请继续断食', width / 2, height / 2);
                return;
            }

            // 计算数据范围
            const durations = fastingHistory.map(d => d.duration);
            const minDuration = Math.min(...durations) - 2;
            const maxDuration = Math.max(...durations) + 2;
            const durationRange = maxDuration - minDuration;

            // 绘制网格线
            ctx.strokeStyle = '#f0f0f0';
            ctx.lineWidth = 1;
            for (let i = 0; i <= 4; i++) {
                const y = 30 + (height - 60) * i / 4;
                ctx.beginPath();
                ctx.moveTo(40, y);
                ctx.lineTo(width - 20, y);
                ctx.stroke();
            }

            // 绘制折线
            ctx.strokeStyle = '#ff6b9d';
            ctx.lineWidth = 3;
            ctx.beginPath();

            fastingHistory.forEach((data, index) => {
                const x = 40 + (width - 60) * index / (fastingHistory.length - 1);
                const y = 30 + (height - 60) * (maxDuration - data.duration) / durationRange;

                if (index === 0) {
                    ctx.moveTo(x, y);
                } else {
                    ctx.lineTo(x, y);
                }
            });
            ctx.stroke();

            // 绘制数据点
            fastingHistory.forEach((data, index) => {
                const x = 40 + (width - 60) * index / (fastingHistory.length - 1);
                const y = 30 + (height - 60) * (maxDuration - data.duration) / durationRange;

                // 外圈
                ctx.fillStyle = '#ff6b9d';
                ctx.beginPath();
                ctx.arc(x, y, 6, 0, Math.PI * 2);
                ctx.fill();

                // 内圈
                ctx.fillStyle = 'white';
                ctx.beginPath();
                ctx.arc(x, y, 3, 0, Math.PI * 2);
                ctx.fill();

                // 显示时长
                ctx.font = '12px sans-serif';
                ctx.fillStyle = '#333';
                ctx.textAlign = 'center';
                ctx.fillText(data.duration + 'h', x, y - 10);

                // 显示日期
                const date = new Date(data.date);
                const dateStr = `${date.getMonth() + 1}/${date.getDate()}`;
                ctx.fillStyle = '#999';
                ctx.fillText(dateStr, x, height - 10);
            });
        }

        // 编辑身体数据
        async function editBodyData(field, currentValue) {
            const fieldNames = {
                initialWeight: '初始体重',
                currentWeight: '当前体重',
                targetWeight: '目标体重',
                height: '身高'
            };

            const units = {
                initialWeight: 'kg',
                currentWeight: 'kg',
                targetWeight: 'kg',
                height: 'cm'
            };

            const newValue = prompt(`请输入${fieldNames[field]} (${units[field]}):`, currentValue > 0 ? currentValue : '');

            if (newValue === null) return; // 用户取消

            const numValue = parseFloat(newValue);
            if (isNaN(numValue) || numValue <= 0) {
                showBodyManagerToast(`请输入有效的${fieldNames[field]}数值`);
                return;
            }

            // 身高合理性检查
            if (field === 'height' && (numValue < 50 || numValue > 250)) {
                showBodyManagerToast('请输入合理的身高数值 (50-250cm)');
                return;
            }

            // 获取现有数据
            let bodyData = await localforage.getItem('body_data') || {};

            // 更新数据
            bodyData[field] = numValue;

            // 如果是当前体重，添加到历史记录
            if (field === 'currentWeight') {
                const weightHistory = await localforage.getItem('weight_history') || [];
                weightHistory.push({
                    date: new Date().toISOString().split('T')[0],
                    weight: numValue
                });
                await localforage.setItem('weight_history', weightHistory);
            }

            // 保存数据
            await localforage.setItem('body_data', bodyData);

            // 更新显示
            updateDataPageDisplay(bodyData);

            showBodyManagerToast(`${fieldNames[field]}已更新为 ${numValue}kg`);
        }

        // 更新数据页面显示
        async function updateDataPageDisplay(bodyData) {
            // 如果没有传入bodyData，从存储获取
            if (!bodyData) {
                bodyData = await localforage.getItem('body_data') || {};
            }

            const hasData = bodyData.currentWeight && bodyData.initialWeight;

            // 更新体重显示
            const initialDisplay = document.getElementById('initialWeightDisplay');
            const currentDisplay = document.getElementById('currentWeightDisplay');
            const targetDisplay = document.getElementById('targetWeightDisplay');
            const heightDisplay = document.getElementById('heightDisplay');

            if (initialDisplay) {
                initialDisplay.textContent = `${bodyData.initialWeight || '--'}${bodyData.initialWeight ? 'kg' : ''}`;
            }
            if (currentDisplay) {
                currentDisplay.textContent = `${bodyData.currentWeight || '--'}${bodyData.currentWeight ? 'kg' : ''}`;
            }
            if (targetDisplay) {
                targetDisplay.textContent = `${bodyData.targetWeight || '--'}${bodyData.targetWeight ? 'kg' : ''}`;
            }
            if (heightDisplay) {
                heightDisplay.textContent = `${bodyData.height || '--'}${bodyData.height ? 'cm' : ''}`;
            }

            // 更新累计减重
            const lossNumber = document.querySelector('.loss-number');
            const lossUnit = document.querySelector('.loss-unit');
            if (lossNumber && lossUnit) {
                if (hasData) {
                    const totalLoss = (bodyData.initialWeight - bodyData.currentWeight).toFixed(1);
                    lossNumber.textContent = `${totalLoss > 0 ? '-' : ''}${totalLoss}`;
                    lossUnit.textContent = 'kg';
                } else {
                    lossNumber.textContent = '--';
                    lossUnit.textContent = '';
                }
            }

            // 重新计算并更新BMI、体脂率、基础代谢
            if (hasData) {
                const bmi = calculateBMI(bodyData.currentWeight, bodyData.height || 170);
                const bodyFat = calculateBodyFat(bmi, bodyData.age || 25, bodyData.gender || 'female');
                const bmr = calculateBMR(bodyData.currentWeight, bodyData.height || 170, bodyData.age || 25, bodyData.gender || 'female');

                // 更新显示
                const metricValues = document.querySelectorAll('.metric-value');
                const metricStatuses = document.querySelectorAll('.metric-status');

                if (metricValues[0]) metricValues[0].textContent = bmi;
                if (metricStatuses[0]) metricStatuses[0].textContent = getBMIStatus(bmi);

                if (metricValues[1]) metricValues[1].textContent = bodyFat + '%';

                if (metricValues[2]) metricValues[2].textContent = bmr;
            }

            // 更新图表
            const weightHistory = await localforage.getItem('weight_history') || [];
            initWeightChart(weightHistory);
        }

        // 切换围度统计标签
        function switchMeasurementTab(type) {
            // 更新标签样式
            document.querySelectorAll('.measurement-tab').forEach(tab => {
                tab.classList.remove('active');
                if (tab.dataset.type === type) {
                    tab.classList.add('active');
                }
            });

            // 重新加载图表
            localforage.getItem('measurements_history').then(history => {
                initMeasurementChart(history || [], type);
            });
        }

        // 记录围度数据 - 使用美观的弹窗
        function recordMeasurement() {
            const measurementNames = {
                waist: { name: '腰围', icon: '👗' },
                chest: { name: '胸围', icon: '👔' },
                hip: { name: '臀围', icon: '🍑' },
                arm: { name: '臂围', icon: '💪' },
                thigh: { name: '大腿围', icon: '🦵' },
                calf: { name: '小腿围', icon: '🦶' }
            };

            // 创建弹窗
            const modal = document.createElement('div');
            modal.id = 'measurementModal';
            modal.className = 'measurement-modal';
            modal.innerHTML = `
                <div class="measurement-modal-overlay" onclick="closeMeasurementModal()"></div>
                <div class="measurement-modal-content">
                    <div class="measurement-modal-header">
                        <h3>📏 记录围度</h3>
                        <button class="modal-close-btn" onclick="closeMeasurementModal()">✕</button>
                    </div>
                    <div class="measurement-modal-body">
                        <div class="measurement-date">
                            <span class="date-label">📅 日期</span>
                            <span class="date-value">${new Date().toLocaleDateString('zh-CN')}</span>
                        </div>
                        <div class="measurement-inputs">
                            ${Object.entries(measurementNames).map(([key, data]) => `
                                <div class="measurement-input-item">
                                    <label class="input-label">
                                        <span class="input-icon">${data.icon}</span>
                                        <span class="input-name">${data.name}</span>
                                    </label>
                                    <div class="input-wrapper">
                                        <input type="number" 
                                               class="measurement-input" 
                                               data-type="${key}" 
                                               placeholder="--"
                                               min="1"
                                               max="200"
                                               step="0.1">
                                        <span class="input-unit">cm</span>
                                    </div>
                                </div>
                            `).join('')}
                        </div>
                    </div>
                    <div class="measurement-modal-footer">
                        <button class="btn-cancel" onclick="closeMeasurementModal()">取消</button>
                        <button class="btn-save" onclick="saveMeasurementData()">💾 保存记录</button>
                    </div>
                </div>
            `;
            document.body.appendChild(modal);

            // 动画显示
            setTimeout(() => {
                modal.classList.add('show');
            }, 10);
        }

        // 关闭围度记录弹窗
        function closeMeasurementModal() {
            const modal = document.getElementById('measurementModal');
            if (modal) {
                modal.classList.remove('show');
                setTimeout(() => {
                    modal.remove();
                }, 300);
            }
        }

        // 保存围度数据
        async function saveMeasurementData() {
            const inputs = document.querySelectorAll('.measurement-input');
            const newRecord = {
                date: new Date().toISOString().split('T')[0],
                timestamp: Date.now()
            };

            inputs.forEach(input => {
                const value = parseFloat(input.value);
                if (!isNaN(value) && value > 0) {
                    newRecord[input.dataset.type] = value;
                }
            });

            // 检查是否输入了任何数据
            const hasData = Object.keys(newRecord).some(key => key !== 'date' && key !== 'timestamp');
            if (!hasData) {
                showBodyManagerToast('请至少输入一项围度数据');
                return;
            }

            // 获取历史记录并添加新记录
            const history = await localforage.getItem('measurements_history') || [];
            history.push(newRecord);
            await localforage.setItem('measurements_history', history);

            // 关闭弹窗
            closeMeasurementModal();

            // 更新图表
            const activeTab = document.querySelector('.measurement-tab.active');
            const currentType = activeTab ? activeTab.dataset.type : 'waist';
            initMeasurementChart(history, currentType);

            showBodyManagerToast('围度记录已保存 ✓');
        }

        // 初始化围度图表
        function initMeasurementChart(measurementsHistory, type) {
            const canvas = document.getElementById('measurementChart');
            if (!canvas) return;

            const ctx = canvas.getContext('2d');
            const dpr = window.devicePixelRatio || 1;
            const rect = canvas.parentElement.getBoundingClientRect();
            canvas.width = rect.width * dpr;
            canvas.height = 200 * dpr;
            ctx.scale(dpr, dpr);

            const width = rect.width;
            const height = 200;

            // 清空画布
            ctx.clearRect(0, 0, width, height);

            // 筛选指定类型的数据
            const typeData = measurementsHistory
                .filter(d => d[type] !== undefined && d[type] !== null)
                .sort((a, b) => new Date(a.date) - new Date(b.date));

            if (typeData.length < 2) {
                ctx.font = '14px sans-serif';
                ctx.fillStyle = '#999';
                ctx.textAlign = 'center';
                ctx.fillText('数据不足，请继续记录围度', width / 2, height / 2);
                return;
            }

            // 计算数据范围
            const values = typeData.map(d => d[type]);
            const minValue = Math.min(...values) - 2;
            const maxValue = Math.max(...values) + 2;
            const valueRange = maxValue - minValue;

            // 绘制网格线
            ctx.strokeStyle = '#f0f0f0';
            ctx.lineWidth = 1;
            for (let i = 0; i <= 4; i++) {
                const y = 30 + (height - 60) * i / 4;
                ctx.beginPath();
                ctx.moveTo(40, y);
                ctx.lineTo(width - 20, y);
                ctx.stroke();
            }

            // 绘制折线
            ctx.strokeStyle = '#ff6b9d';
            ctx.lineWidth = 3;
            ctx.beginPath();

            typeData.forEach((data, index) => {
                const x = 40 + (width - 60) * index / (typeData.length - 1);
                const y = 30 + (height - 60) * (maxValue - data[type]) / valueRange;

                if (index === 0) {
                    ctx.moveTo(x, y);
                } else {
                    ctx.lineTo(x, y);
                }
            });
            ctx.stroke();

            // 绘制数据点
            typeData.forEach((data, index) => {
                const x = 40 + (width - 60) * index / (typeData.length - 1);
                const y = 30 + (height - 60) * (maxValue - data[type]) / valueRange;

                // 外圈
                ctx.fillStyle = '#ff6b9d';
                ctx.beginPath();
                ctx.arc(x, y, 6, 0, Math.PI * 2);
                ctx.fill();

                // 内圈
                ctx.fillStyle = 'white';
                ctx.beginPath();
                ctx.arc(x, y, 3, 0, Math.PI * 2);
                ctx.fill();

                // 显示数值
                ctx.font = '12px sans-serif';
                ctx.fillStyle = '#333';
                ctx.textAlign = 'center';
                ctx.fillText(data[type] + 'cm', x, y - 10);

                // 显示日期
                const date = new Date(data.date);
                const dateStr = `${date.getMonth() + 1}/${date.getDate()}`;
                ctx.fillStyle = '#999';
                ctx.fillText(dateStr, x, height - 10);
            });
        }

        // 显示食谱菜单
        async function showRecipeMenu() {
            // 获取已保存的信息
            const savedInfo = await localforage.getItem('recipe_cooking_info') || {};
            
