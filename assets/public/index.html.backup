                    <p>饮食方面，冬季宜温补，可以多吃羊肉、牛肉、核桃等温热性食物。同时也要注意补充维生素，多吃新鲜蔬果。</p>
                    <p>运动方面，虽然天气寒冷，但还是要坚持适度运动。建议选择室内运动，如瑜伽、游泳等。</p>
                    <p>医生特别提醒，冬季是流感高发季节，要注意个人卫生，勤洗手、戴口罩，预防疾病。</p>`,
                    source: '健康时报',
                    sourceAvatar: '💊',
                    time: new Date().toLocaleString(),
                    image: 'https://images.unsplash.com/photo-1505576399279-565b52d4ac71?w=400&h=300&fit=crop',
                    likes: 7200
                }
            };
            
            // 智能匹配新闻 - 提取关键词进行匹配
            const titleLower = title.toLowerCase();
            
            // 按关键词长度从长到短排序，确保精确匹配优先
            const keywords = Object.keys(realNewsDatabase).sort((a, b) => b.length - a.length);
            
            for (const key of keywords) {
                if (titleLower.includes(key.toLowerCase()) || key.toLowerCase().includes(titleLower.split(' ')[0].toLowerCase())) {
                    return realNewsDatabase[key];
                }
            }
            
            // 如果完全没有匹配，返回一个默认的真实新闻格式（不用模板套话）
            return {
                title: title,
                content: `<p>关于"${title}"的最新消息引起了广泛关注。据相关媒体报道，这一事件/话题在社交媒体上引发了大量讨论。</p>
                    <p>众多网友积极参与讨论，表达了自己的看法。有支持的，也有持不同意见的，各种观点交织在一起，形成了热烈的讨论氛围。</p>
                    <p>业内人士分析认为，这一事件/话题具有较高的关注度和话题性，预计会在未来一段时间内持续发酵。</p>
                    <p>我们将持续关注此事进展，为大家带来最新报道。也欢迎大家在评论区留言，分享你的看法。</p>`,
                source: '综合报道',
                sourceAvatar: '📰',
                time: new Date().toLocaleString(),
                image: `https://picsum.photos/400/300?random=${Date.now()}`,
                likes: Math.floor(Math.random() * 5000) + 1000
            };
        };

        // 生成文章内容（备用）
        window.weiboGenerateArticleContent = function(title) {
            return `<p>暂无详细内容</p>`;
        };

        // 生成AI评论
        // 生成AI评论（热搜和新闻详情页使用）
        window.weiboGenerateAIComments = async function(title, content = '') {
            // 首先检查是否有缓存的评论
            const cacheKey = 'weiboComments_' + title.replace(/\s+/g, '_').substring(0, 50);
            const cachedComments = await localforage.getItem(cacheKey);
            if (cachedComments && cachedComments.length > 0) {
                console.log('使用缓存的评论:', title);
                return cachedComments;
            }

            // 尝试使用AI生成评论
            try {
                const savedSettings = await loadAppSettings({});
                const apiUrl = savedSettings.api?.baseUrl || 'https://api.openai.com/v1';
                const apiKey = savedSettings.api?.apiKey || '';
                const model = savedSettings.api?.model || 'gpt-3.5-turbo';
                
                if (!apiKey) {
                    console.log('【AI评论】未配置API，使用默认评论');
                    return weiboGetDefaultComments(title);
                }
                
                // 收集上下文数据
                const contextData = await weiboCollectContextData();
                
                // 构建提示词
                const prompt = weiboBuildHotSearchCommentPrompt(title, content, contextData);
                
                const response = await fetch(`${apiUrl}/chat/completions`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${apiKey}`
                    },
                    body: JSON.stringify({
                        model: model,
                        messages: [
                            { role: 'system', content: '你是一个微博评论生成助手。根据热搜/新闻标题，生成5条真实微博风格的评论。' },
                            { role: 'user', content: prompt }
                        ],
                        temperature: 0.9,
                        max_tokens: 1500
                    })
                });
                
                if (!response.ok) {
                    throw new Error(`API请求失败: ${response.status}`);
                }
                
                const result = await response.json();
                const aiContent = result.choices[0].message.content;
                
                // 解析评论
                const comments = weiboParseAICommentsResponse(aiContent);
                
                // 添加元数据
                const commentsWithMeta = comments.map((c, index) => ({
                    ...c,
                    id: 'comment_' + Date.now() + '_' + index,
                    timestamp: Date.now(),
                    likes: Math.floor(Math.random() * 100) + 1,
                    time: ['刚刚', '1分钟前', '3分钟前', '5分钟前'][Math.floor(Math.random() * 4)]
                }));
                
                // 保存到缓存
                await localforage.setItem(cacheKey, commentsWithMeta);
                
                return commentsWithMeta;
            } catch (error) {
                console.error('【AI评论】生成失败:', error);
                return weiboGetDefaultComments(title);
            }
        };
        
        // 构建热搜/新闻评论生成提示词
        window.weiboBuildHotSearchCommentPrompt = function(title, content, contextData) {
            let prompt = `热搜/新闻标题："${title}"\n\n`;
            if (content) {
                prompt += `内容摘要："${content.substring(0, 200)}"\n\n`;
            }
            
            // 添加世界观背景
            if (contextData.worldbooks.length > 0) {
                prompt += '【世界观背景】\n';
                contextData.worldbooks.forEach(book => {
                    prompt += `${book.name}: ${book.content.substring(0, 200)}\n`;
                });
                prompt += '\n';
            }
            
            prompt += '【微博吃瓜群众角色库】（AI根据这些类型自由创作网名）：\n';
            prompt += '用户类型1：吃瓜路人 - 看热闹不嫌事大，喜欢调侃\n';
            prompt += '用户类型2：热心网友 - 喜欢分享看法，语气亲切\n';
            prompt += '用户类型3：理性分析帝 - 喜欢分析事情本质，语气冷静\n';
            prompt += '用户类型4：情感共鸣者 - 容易被感动，表达共情\n';
            prompt += '用户类型5：段子手 - 喜欢讲段子，幽默风趣\n';
            prompt += '用户类型6：质疑者 - 喜欢提出不同看法\n';
            prompt += '用户类型7：支持者 - 坚定支持，正能量满满\n';
            prompt += '用户类型8：细节控 - 关注细节，喜欢抠字眼\n';
            prompt += '用户类型9：转发狂魔 - 喜欢@朋友来看\n';
            prompt += '用户类型10：老司机 - 经验丰富，语重心长\n\n';
            
            prompt += '【网名创作要求】\n';
            prompt += '1. 为每个用户创作一个独特的微博网名（2-8个字），风格要符合用户类型\n';
            prompt += '2. 网名示例：吃瓜小能手、深夜冲浪人、理性吃瓜中、暴躁小饼干、温柔一刀\n';
            prompt += '3. 网名要有网感，像真实微博用户\n\n';
            
            prompt += '【评论要求】\n';
            prompt += '1. 生成5条评论，格式为JSON数组\n';
            prompt += '2. 每条包含：name(AI创作的网名), text(评论内容，15-40字), type(用户类型描述)\n';
            prompt += '3. 不要avatar字段，不需要头像\n';
            prompt += '4. 评论风格要真实，像微博真实用户发的，口语化、网络化\n';
            prompt += '5. 可以结合世界观背景进行评论\n';
            prompt += '6. 使用微博常用语："哈哈哈"、"绝了"、"确实"、"不懂就问"、"@朋友来看"、"笑死"、"真实"等\n';
            prompt += '7. 返回纯JSON格式，不要其他文字\n';
            prompt += '8. 示例：[{"name":"吃瓜小能手","text":"哈哈哈这也太真实了吧","type":"吃瓜路人"},{"name":"深夜冲浪人","text":"@闺蜜 快来看这个","type":"转发狂魔"}]';
            
            return prompt;
        };
        
        // 获取默认评论（AI失败时使用）
        window.weiboGetDefaultComments = function(title) {
            const defaultComments = [
                { name: '吃瓜路人', text: '这也太精彩了吧，持续关注！', type: '吃瓜群众', likes: 23 },
                { name: '热心网友', text: '不懂就问，这是真的吗？', type: '吃瓜群众', likes: 15 },
                { name: '理性分析', text: '从多个角度来看，这件事确实值得深思', type: '吃瓜群众', likes: 45 },
                { name: '段子手小王', text: '哈哈哈笑死我了', type: '吃瓜群众', likes: 67 },
                { name: '深夜emo人', text: '看到这件事，我陷入了沉思...', type: '吃瓜群众', likes: 12 }
            ];
            
            return defaultComments.map((c, index) => ({
                ...c,
                id: 'comment_default_' + index,
                timestamp: Date.now(),
                time: ['刚刚', '1分钟前', '3分钟前', '5分钟前'][Math.floor(Math.random() * 4)]
            }));
        };
        
        // 加载更多热搜/新闻评论
        window.weiboLoadMoreHotComments = async function(title) {
            const btn = document.getElementById('weiboLoadMoreBtn');
            if (btn) {
                btn.textContent = '生成中...';
                btn.disabled = true;
            }
            
            try {
                const cacheKey = 'weiboComments_' + title.replace(/\s+/g, '_').substring(0, 50);
                const existingComments = await localforage.getItem(cacheKey) || [];
                
                // 生成新评论
                const savedSettings = await loadAppSettings({});
                const apiUrl = savedSettings.api?.baseUrl || 'https://api.openai.com/v1';
                const apiKey = savedSettings.api?.apiKey || '';
                const model = savedSettings.api?.model || 'gpt-3.5-turbo';
                
                if (apiKey) {
                    const contextData = await weiboCollectContextData();
                    const prompt = weiboBuildHotSearchCommentPrompt(title, '', contextData) + '\n\n【已有评论】\n' + 
                        existingComments.slice(-3).map(c => `${c.name}: ${c.text}`).join('\n') + 
                        '\n\n请生成5条新的评论，可以参考已有评论进行回复或发表新看法。';
                    
                    const response = await fetch(`${apiUrl}/chat/completions`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'Authorization': `Bearer ${apiKey}`
                        },
                        body: JSON.stringify({
                            model: model,
                            messages: [
                                { role: 'system', content: '你是一个微博评论生成助手。' },
                                { role: 'user', content: prompt }
                            ],
                            temperature: 0.9,
                            max_tokens: 1500
                        })
                    });
                    
                    if (response.ok) {
                        const result = await response.json();
                        const newComments = weiboParseAICommentsResponse(result.choices[0].message.content);
                        
                        const commentsWithMeta = newComments.map((c, index) => ({
                            ...c,
                            id: 'comment_' + Date.now() + '_' + index,
                            timestamp: Date.now(),
                            likes: Math.floor(Math.random() * 100) + 1,
                            time: '刚刚'
                        }));
                        
                        const allComments = [...existingComments, ...commentsWithMeta];
                        await localforage.setItem(cacheKey, allComments);
                        
                        // 刷新详情页
                        await weiboOpenDetailPage(title);
                    }
                }
            } catch (error) {
                console.error('加载更多评论失败:', error);
            }
            
            if (btn) {
                btn.textContent = '加载更多评论';
                btn.disabled = false;
            }
        };

        // 点赞功能
        window.weiboToggleLike = function(el) {
            el.classList.toggle('active');
            const countSpan = el.querySelector('span');
            let count = parseInt(countSpan.textContent);
            if (el.classList.contains('active')) {
                count++;
            } else {
                count--;
            }
            countSpan.textContent = count;
        };

        // 分享功能
        // 分享功能 - 选择微信角色
        window.weiboShareDetail = async function() {
            // 创建角色选择弹窗
            let shareModal = document.getElementById('weiboShareModal');
            if (!shareModal) {
                shareModal = document.createElement('div');
                shareModal.id = 'weiboShareModal';
                shareModal.style.cssText = 'position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 10002; display: none; align-items: center; justify-content: center;';
                shareModal.innerHTML = `
                    <div style="background: #fff; width: 90%; max-width: 400px; border-radius: 12px; overflow: hidden; max-height: 80vh; display: flex; flex-direction: column;">
                        <div style="padding: 16px; border-bottom: 1px solid #f0f0f0; display: flex; justify-content: space-between; align-items: center;">
                            <span style="font-size: 16px; font-weight: 600;">选择分享对象</span>
                            <span onclick="weiboCloseShareModal()" style="cursor: pointer; font-size: 20px; color: #999;">✕</span>
                        </div>
                        <div id="weiboShareContactList" style="overflow-y: auto; padding: 12px; flex: 1;">
                            <!-- 角色列表 -->
                        </div>
                    </div>
                `;
                document.body.appendChild(shareModal);
            }
            
            // 加载微信角色列表
            await weiboLoadShareContacts();
            
            // 显示弹窗
            shareModal.style.display = 'flex';
        };
        
        // 加载分享联系人列表
        window.weiboLoadShareContacts = async function() {
            const listEl = document.getElementById('weiboShareContactList');
            listEl.innerHTML = '';
            
            // 获取微信联系人
            let contacts = [];
            if (relationshipData.wechatChatList && Array.isArray(relationshipData.wechatChatList)) {
                contacts = relationshipData.wechatChatList;
            }
            
            if (contacts.length === 0) {
                listEl.innerHTML = '<div style="padding: 40px; text-align: center; color: #999;">暂无联系人</div>';
                return;
            }
            
            contacts.forEach(contact => {
                const avatarContent = contact.avatar && contact.avatar.length <= 2 ? contact.avatar : 
                    (contact.avatar ? `<img src="${contact.avatar}" style="width: 100%; height: 100%; object-fit: cover;">` : '👤');
                
                const item = document.createElement('div');
                item.style.cssText = 'display: flex; align-items: center; padding: 12px; border-bottom: 1px solid #f5f5f5; cursor: pointer; hover: background: #f8f8f8;';
                item.onclick = function() {
                    weiboShareToContact(contact);
                };
                
                item.innerHTML = `
                    <div style="width: 44px; height: 44px; border-radius: 50%; overflow: hidden; background: #f0f0f0; display: flex; align-items: center; justify-content: center; margin-right: 12px; flex-shrink: 0;">
                        ${avatarContent}
                    </div>
                    <div style="flex: 1;">
                        <div style="font-size: 15px; color: #333; font-weight: 500;">${contact.remark || contact.name || '联系人'}</div>
                        <div style="font-size: 13px; color: #999; margin-top: 2px;">${contact.description || '微信好友'}</div>
                    </div>
                    <div style="color: #ff6b6b; font-size: 14px;">分享</div>
                `;
                
                listEl.appendChild(item);
            });
        };
        
        // 关闭分享弹窗
        window.weiboCloseShareModal = function() {
            const modal = document.getElementById('weiboShareModal');
            if (modal) {
                modal.style.display = 'none';
            }
        };
        
        // 分享给指定联系人
        window.weiboShareToContact = async function(contact) {
            weiboCloseShareModal();
            weiboCloseDetailPage();
            
            // 准备分享内容
            const shareData = {
                title: currentDetailData?.title || '微博热点',
                type: currentDetailData?.type || 'news',
                content: await weiboGetShareContent(),
                timestamp: Date.now()
            };
            
            // 保存分享数据
            await localforage.setItem('weiboShareData', shareData);
            await localforage.setItem('weiboShareTarget', contact.id);
            
            // 跳转到微信聊天
            weiboNavigateToChat(contact);
        };
        
        // 获取分享内容
        window.weiboGetShareContent = async function() {
            let content = '';
            
            if (currentDetailData?.type === 'hot') {
                // 从热搜数据获取内容
                const hotItem = weiboHotData.find(h => h.title === currentDetailData.title);
                content = hotItem?.content || currentDetailData.title;
            } else if (currentDetailData?.type === 'news') {
                // 从新闻数据获取内容
                const newsItem = weiboNewsData.find(n => n.title === currentDetailData.title);
                content = newsItem?.content || newsItem?.description || currentDetailData.title;
            }
            
            return content;
        };
        
        // 跳转到微信聊天
        window.weiboNavigateToChat = function(contact) {
            // 关闭微博页面
            closeWeiboPage();

            // 设置当前聊天对象
            currentChatId = contact.id;

            // 打开微信聊天界面
            openChatInterface(contact.id, contact.remark || contact.name, contact.avatar);

            // 延迟发送分享卡片
            setTimeout(() => {
                weiboSendShareCard(contact);
            }, 500);
        };
        
        // 发送分享卡片
        window.weiboSendShareCard = async function(contact) {
            const shareData = await localforage.getItem('weiboShareData');
            if (!shareData) return;

            // 构建分享卡片HTML（用户看到的精美卡片）
            const cardHtml = weiboBuildShareCard(shareData);

            // 构建纯文本内容（保存用于后续AI调用，不含样式）
            const plainText = weiboBuildShareText(shareData);

            // 添加到聊天界面 - 使用微信聊天消息格式
            const chatContent = document.getElementById('chatContent');
            if (chatContent) {
                // 获取用户头像
                const personalProfile = await localforage.getItem('personalProfile') || {};
                const userAvatar = personalProfile.avatar || '👤';

                const messageDiv = document.createElement('div');
                messageDiv.className = 'message user';
                messageDiv.style.cssText = 'display: flex; justify-content: flex-end; margin-bottom: 15px; padding: 0 15px;';

                messageDiv.innerHTML = `
                    <div style="display: flex; flex-direction: row-reverse; align-items: flex-start; max-width: 80%;">
                        <div style="width: 40px; height: 40px; border-radius: 6px; overflow: hidden; background: #f0f0f0; display: flex; align-items: center; justify-content: center; margin-left: 10px; flex-shrink: 0; font-size: 24px;">
                            ${userAvatar.length <= 2 ? userAvatar : `<img src="${userAvatar}" style="width: 100%; height: 100%; object-fit: cover;">`}
                        </div>
                        <div style="background: #95ec69; padding: 10px; border-radius: 8px; word-wrap: break-word; max-width: calc(100% - 50px);">
                            ${cardHtml}
                        </div>
                    </div>
                `;

                chatContent.appendChild(messageDiv);
                chatContent.scrollTop = chatContent.scrollHeight;

                // 保存消息到聊天记录
                await weiboSaveShareMessage(contact.id, cardHtml, plainText);

                // 不自动调用AI回复，让用户手动点击爱心图标来调取API
                console.log('分享卡片已发送，等待用户手动调取API');
            } else {
                console.error('找不到聊天内容容器 chatContent');
            }
        };
        
        // 构建分享卡片（精美的HTML卡片，用户看到的）
        window.weiboBuildShareCard = function(shareData) {
            // 根据类型选择颜色
            const isHot = shareData.type === 'hot';
            const gradient = isHot 
                ? 'linear-gradient(135deg, #ff6b6b 0%, #ff8e8e 100%)' 
                : 'linear-gradient(135deg, #4a90d9 0%, #5ba3e8 100%)';
            const shadowColor = isHot ? 'rgba(255,107,107,0.3)' : 'rgba(74,144,217,0.3)';
            const label = isHot ? '微博热搜' : '实时热点';
            const icon = isHot 
                ? '<path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>'
                : '<path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"/>';

            return `
                <div style="background: ${gradient}; border-radius: 12px; padding: 16px; color: #fff; max-width: 280px; box-shadow: 0 4px 15px ${shadowColor}; cursor: pointer;" onclick="weiboShowShareDetailModal('${shareData.title}', '${shareData.type}')">
                    <div style="display: flex; align-items: center; margin-bottom: 12px;">
                        <div style="width: 32px; height: 32px; background: rgba(255,255,255,0.2); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-right: 10px;">
                            <svg viewBox="0 0 24 24" fill="currentColor" style="width: 20px; height: 20px;">
                                ${icon}
                            </svg>
                        </div>
                        <div style="font-size: 14px; font-weight: 600;">${label}</div>
                    </div>
                    <div style="font-size: 16px; font-weight: 600; line-height: 1.4;">${shareData.title}</div>
                    <div style="margin-top: 12px; padding-top: 12px; border-top: 1px solid rgba(255,255,255,0.2); display: flex; align-items: center; font-size: 12px; opacity: 0.8;">
                        <svg viewBox="0 0 24 24" fill="currentColor" style="width: 14px; height: 14px; margin-right: 4px;">
                            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
                        </svg>
                        点击查看详情
                    </div>
                </div>
            `;
        };

        // 显示分享详情弹窗
        window.weiboShowShareDetailModal = async function(title, type) {
            // 查找内容
            let content = '';
            if (type === 'hot') {
                const item = weiboHotData.find(h => h.title === title);
                content = item?.content || title;
            } else {
                const item = weiboNewsData.find(n => n.title === title);
                content = item?.content || item?.description || title;
            }

            // 创建弹窗
            let modal = document.getElementById('weiboShareDetailModal');
            if (!modal) {
                modal = document.createElement('div');
                modal.id = 'weiboShareDetailModal';
                modal.style.cssText = 'position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.6); z-index: 10003; display: none; align-items: center; justify-content: center; padding: 20px; box-sizing: border-box;';
                document.body.appendChild(modal);
            }

            const gradient = type === 'hot'
                ? 'linear-gradient(135deg, #ff6b6b 0%, #ff8e8e 100%)'
                : 'linear-gradient(135deg, #4a90d9 0%, #5ba3e8 100%)';
            const label = type === 'hot' ? '微博热搜' : '实时热点';

            modal.innerHTML = `
                <div style="background: #fff; width: 100%; max-width: 400px; border-radius: 16px; overflow: hidden; max-height: 80vh; display: flex; flex-direction: column;">
                    <div style="background: ${gradient}; padding: 20px; color: #fff;">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                            <span style="font-size: 14px; opacity: 0.9;">${label}</span>
                            <span onclick="weiboCloseShareDetailModal()" style="cursor: pointer; font-size: 20px; opacity: 0.8;">✕</span>
                        </div>
                        <div style="font-size: 20px; font-weight: 600; line-height: 1.4;">${title}</div>
                    </div>
                    <div style="padding: 20px; overflow-y: auto; flex: 1;">
                        <div style="font-size: 15px; line-height: 1.8; color: #333;">${content}</div>
                    </div>
                    <div style="padding: 16px 20px; border-top: 1px solid #f0f0f0;">
                        <button onclick="weiboCloseShareDetailModal()" style="width: 100%; padding: 12px; background: #f5f5f5; border: none; border-radius: 8px; font-size: 15px; color: #333; cursor: pointer;">关闭</button>
                    </div>
                </div>
            `;

            modal.style.display = 'flex';
        };

        // 关闭分享详情弹窗
        window.weiboCloseShareDetailModal = function() {
            const modal = document.getElementById('weiboShareDetailModal');
            if (modal) {
                modal.style.display = 'none';
            }
        };

        // 构建分享文本（纯文本，发送给AI的，不含样式）
        window.weiboBuildShareText = function(shareData) {
            const label = shareData.type === 'hot' ? '微博热搜' : '实时热点';
            return `[分享${label}]\n标题：${shareData.title}\n内容：${shareData.content}`;
        };
        
        // 保存分享消息到聊天记录
        window.weiboSaveShareMessage = async function(contactId, cardHtml, plainText) {
            const message = {
                id: 'msg_' + Date.now(),
                chatId: contactId,
                sender: 'user',
                content: cardHtml, // 保存HTML卡片用于显示
                plainContent: plainText, // 保存纯文本用于AI理解
                type: 'share',
                timestamp: Date.now()
            };

            // 使用现有的addChatMessage函数保存（支持IndexedDB持久化）
            await addChatMessage(message);
            console.log('分享消息已保存:', message.id);
        };
        
        // 获取AI回复 - 集成到微信聊天系统
        window.weiboGetAIReply = async function(contact, plainText) {
            console.log('发送给AI的内容（纯文本）:', plainText);
            console.log('联系人:', contact);
            
            // 构建AI提示词
            const prompt = await weiboBuildAIChatPrompt(contact, plainText);
            
            // 调用现有的AI回复函数
            try {
                // 显示AI正在输入
                showAIThinkingIndicator();
                
                // 调用AI
                const aiResponse = await callAIDirectlyWithContext(prompt, null, contact);
                
                // 隐藏输入指示器
                hideAIThinkingIndicator();
                
                if (aiResponse) {
                    // 显示AI回复
                    const aiMessage = {
                        sender: 'ai',
                        content: aiResponse,
                        timestamp: Date.now(),
                        chatId: contact.id
                    };
                    
                    // 添加到聊天记录
                    relationshipData.chatMessages.push(aiMessage);
                    
                    // 【修复】增加AI消息计数
                    await incrementAIMessageCount(contact.id);
                    
                    // 显示消息
                    appendNewMessage(aiMessage);
                    
                    // 滚动到底部
                    const chatContent = document.getElementById('chatContent');
                    if (chatContent) {
                        chatContent.scrollTop = chatContent.scrollHeight;
                    }
                }
            } catch (error) {
                console.error('AI回复失败:', error);
                hideAIThinkingIndicator();
            }
        };
        
        // 构建AI聊天提示词
        window.weiboBuildAIChatPrompt = async function(contact, plainText) {
            let prompt = '';
            
            // 添加角色人设
            if (contact.description) {
                prompt += `【你的人设】\n${contact.description}\n\n`;
            }
            
            // 添加世界观（世界书）
            if (contact.worldbooks && Array.isArray(contact.worldbooks) && contact.worldbooks.length > 0) {
                prompt += '【世界观设定】\n';
                contact.worldbooks.forEach(id => {
                    const worldbook = relationshipData.worldBooks.find(book => book.id == id);
                    if (worldbook && worldbook.content) {
                        prompt += `${worldbook.name}: ${worldbook.content.substring(0, 500)}\n\n`;
                    }
                });
            }
            
            // 添加聊天记录上下文（最近10条）
            const recentMessages = relationshipData.chatMessages
                .filter(m => m.chatId == contact.id)
                .slice(-10);
            
            if (recentMessages.length > 0) {
                prompt += '【最近聊天记录】\n';
                recentMessages.forEach(m => {
                    const sender = m.sender === 'user' ? '用户' : '你';
                    prompt += `${sender}: ${m.content}\n`;
                });
                prompt += '\n';
            }
            
            // 添加当前消息
            prompt += `【用户分享了一个微博内容】\n${plainText}\n\n`;
            
            // 添加回复要求
            prompt += '【回复要求】\n';
            prompt += '1. 根据你的人设和世界观，自然地回应用户分享的内容\n';
            prompt += '2. 可以表达你的看法、感受或提出相关问题\n';
            prompt += '3. 语气要符合你的角色设定\n';
            prompt += '4. 回复要简洁自然，像真实对话一样\n';
            prompt += '5. 不要提及你是AI或机器人\n';
            
            return prompt;
        };
        
        // 显示AI正在输入指示器
        window.showAIThinkingIndicator = function() {
            const chatContent = document.getElementById('chatContent');
            if (!chatContent) return;
            
            const indicator = document.createElement('div');
            indicator.id = 'aiThinkingIndicator';
            indicator.className = 'message ai';
            indicator.innerHTML = `
                <div class="message-content" style="display: flex; align-items: center; gap: 8px; padding: 12px 16px; background: #f0f0f0; border-radius: 18px; color: #666; font-size: 14px;">
                    <div style="display: flex; gap: 4px;">
                        <span style="width: 8px; height: 8px; background: #999; border-radius: 50%; animation: weiboBounce 1s infinite 0s;"></span>
                        <span style="width: 8px; height: 8px; background: #999; border-radius: 50%; animation: weiboBounce 1s infinite 0.2s;"></span>
                        <span style="width: 8px; height: 8px; background: #999; border-radius: 50%; animation: weiboBounce 1s infinite 0.4s;"></span>
                    </div>
                    正在输入...
                </div>
            `;
            chatContent.appendChild(indicator);
            chatContent.scrollTop = chatContent.scrollHeight;
        };
        
        // 隐藏AI正在输入指示器
        window.hideAIThinkingIndicator = function() {
            const indicator = document.getElementById('aiThinkingIndicator');
            if (indicator) {
                indicator.remove();
            }
        };

        // 发表评论
        window.weiboPostComment = function() {
            const input = document.getElementById('weiboCommentInput');
            const text = input.value.trim();
            
            if (!text) return;
            
            // 添加新评论到列表
            const commentsList = document.querySelector('.weibo-detail-comments-list');
            const newComment = document.createElement('div');
            newComment.className = 'weibo-detail-comment';
            newComment.innerHTML = `
                <div class="weibo-detail-comment-avatar">😀</div>
                <div class="weibo-detail-comment-content">
                    <div class="weibo-detail-comment-name">我</div>
                    <div class="weibo-detail-comment-text">${text}</div>
                    <div class="weibo-detail-comment-time">刚刚</div>
                    <div class="weibo-detail-comment-actions">
                        <div class="weibo-detail-comment-action">
                            <svg viewBox="0 0 24 24" fill="currentColor" width="14" height="14">
                                <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                            </svg>
                            <span>0</span>
                        </div>
                        <div class="weibo-detail-comment-action">回复</div>
                    </div>
                </div>
            `;
            
            commentsList.insertBefore(newComment, commentsList.firstChild);
            input.value = '';
            
            // 更新评论数
            const countEl = document.querySelector('.weibo-detail-comments-count');
            const currentCount = parseInt(countEl.textContent);
            countEl.textContent = (currentCount + 1) + '条';
        };
    </script>

    <!-- 公益说明弹窗 -->
    <div id="donationModal" class="donation-modal" style="display: none;">
        <div class="donation-modal-overlay" onclick="closeDonationModal()"></div>
        <div class="donation-modal-content">
            <div class="donation-modal-header">
                <h3>公益赞助</h3>
                <span class="donation-modal-close" onclick="closeDonationModal()">&times;</span>
            </div>
            <div class="donation-modal-body">
                <div class="donation-text">
                    <p>之前一直是我自己一个人去做公益，每次都只能送几本书这样子，所以突发奇想可以让支持公益的人和我一起做公益，这也是我做小手机的初心。</p>
                    <p>本账号长期致力于公益帮扶行动，聚焦福利院物资补给、敬老院暖心关怀、公益课程师资支持及公益相关APP日常维护运营，所有善举均以公开透明为原则，全程记录、真实公示。</p>
                    <p>现开放公益赞助通道，所有赞助资金/物资将专款专用，定向用于：</p>
                    <ol>
                        <li>福利院儿童生活、学习、暖心物资采购与配送</li>
                        <li>敬老院老人生活用品、健康物资、节日慰问</li>
                        <li>公益解答老师劳务补贴</li>
                        <li>公益服务APP日常维护、功能优化与稳定运营</li>
                    </ol>
                    <p>每一笔赞助都会在小红书平台以视频、图文形式实时公示，接受大家监督。点滴善意汇聚成光，感谢每一位愿意与我们同行的朋友，让温暖真正抵达需要的人身边。</p>
                </div>
            </div>
            <div class="donation-modal-footer">
                <button class="donation-btn cancel" onclick="closeDonationModal()">否</button>
                <button class="donation-btn confirm" onclick="openDonationCodePage()">是</button>
            </div>
        </div>
    </div>

