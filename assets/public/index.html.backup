    <!-- 心情选择弹窗 -->
    <!-- 心声弹窗 -->
    <div id="innerThoughtModal" class="modal inner-thought-modal">
        <div class="modal-content inner-thought-content" style="background: url('https://s41.ax1x.com/2026/01/30/pZfGivj.png') center/cover; background-size: cover; background-repeat: no-repeat; background-color: transparent;">
            <div class="modal-body" style="padding: 0; margin-top: 50px;">
                <div class="inner-thought-title">那些没有说出口的</div>
                <div id="innerThoughtText" class="form-control" style="background: transparent; color: #000; height: 150px; overflow-y: auto; margin-left: 15px; border: none; outline: none; font-family: 'PING FANG CHANG AN', sans-serif; font-size: 18px; line-height: 1.5; padding: 5px 0; text-align: left;">AI还没有写下心声...</div>
            </div>
            <div class="modal-footer">
                <button onclick="closeInnerThoughtModal()" class="btn btn-cancel" style="background: rgba(255,255,255,0.9); margin: 0 auto;">✕ 关闭</button>
            </div>
        </div>
    </div>

    <!-- 心声悬浮窗（长按头像显示） -->
    <div id="innerThoughtTooltip" class="inner-thought-tooltip" style="display: none;">
        <div class="tooltip-content">
            <div class="tooltip-title">💭 心声</div>
            <div class="tooltip-text" id="tooltipThoughtText">AI还没有写下心声...</div>
            <div class="tooltip-arrow"></div>
        </div>
    </div>

    <script>
        // 全局缓存个人资料，用于聊天头像显示
        let cachedPersonalProfile = null;

        // 恶魔挑战全局变量
        let currentQuizQuestions = [];
        let currentQuestionIndex = 0;
        let currentDemonQuizAnswers = [];
        let currentDemonQuizCorrectAnswers = [];
        let currentViewingQuizId = null;
        let currentUserDemonQuizAnswers = [];
        let isRenderingDemonCards = false;  // 防止重复渲染标志

        // 天使问答全局变量
        let currentAngelQuestions = [];
        let currentAngelQuestionIndex = 0;
        let currentViewingAngelQuizId = null;
        let isRenderingAngelCards = false;  // 防止重复渲染标志

        // 小黑屋状态（必须在函数定义之前初始化）
        let blackRoomState = {
            isActive: false,
            endTime: null,
            mouseClickCount: 0,
            lastMouseClickTime: 0,
            timerInterval: null
        };



        // 小黑屋默认暗号
        const DEFAULT_BLACK_ROOM_CODE = 'love_husband';

        // 【防闪退】全局资源管理器
        const ResourceManager = {
            // 存储所有活动的定时器
            timers: new Set(),
            // 存储所有活动的事件监听器
            listeners: new Set(),
            // 存储所有活动的观察器
            observers: new Set(),

            // 添加定时器
            addTimer(timerId, type = 'timeout') {
                this.timers.add({ id: timerId, type });
                return timerId;
            },

            // 移除定时器
            removeTimer(timerId) {
                this.timers.forEach(timer => {
                    if (timer.id === timerId) {
                        if (timer.type === 'interval') {
                            clearInterval(timerId);
                        } else {
                            clearTimeout(timerId);
                        }
                        this.timers.delete(timer);
                    }
                });
            },

            // 清理所有定时器
            clearAllTimers() {
                console.log('【ResourceManager】清理所有定时器，数量:', this.timers.size);
                this.timers.forEach(timer => {
                    if (timer.type === 'interval') {
                        clearInterval(timer.id);
                    } else {
                        clearTimeout(timer.id);
                    }
                });
                this.timers.clear();
            },

            // 添加观察器
            addObserver(observer) {
                this.observers.add(observer);
                return observer;
            },

            // 移除观察器
            removeObserver(observer) {
                if (observer && observer.disconnect) {
                    observer.disconnect();
                    this.observers.delete(observer);
                }
            },

            // 清理所有观察器
            clearAllObservers() {
                console.log('【ResourceManager】清理所有观察器，数量:', this.observers.size);
                this.observers.forEach(observer => {
                    if (observer && observer.disconnect) {
                        observer.disconnect();
                    }
                });
                this.observers.clear();
            },

            // 清理所有资源
            cleanupAll() {
                console.log('【ResourceManager】开始清理所有资源...');
                this.clearAllTimers();
                this.clearAllObservers();
                console.log('【ResourceManager】资源清理完成');
            }
        };

        // 【防闪退】内存监控和自动清理系统
        const MemoryMonitor = {
            // 【关键修复】缩短检查间隔，更快发现和解决问题
            CHECK_INTERVAL: isVivo ? 3 * 1000 : 5 * 1000, // Vivo手机3秒，其他5秒
            // 【关键修复】大幅降低消息数量警告阈值，更积极清理
            MESSAGE_WARNING_THRESHOLD: isVivo ? 80 : 120, // 从150/250降到80/120
            // 【关键修复】降低DOM元素警告阈值
            DOM_WARNING_THRESHOLD: isVivo ? 20 : 30, // 从25/35降到20/30
            // 【关键修复】降低MathJax队列警告阈值
            MATHJAX_QUEUE_THRESHOLD: isVivo ? 3 : 5, // 从5/10降到3/5
            // 定时器ID
            monitorTimer: null,
            // 是否正在运行
            isRunning: false,
            // 【关键修复】缩短冷却时间，允许更频繁的清理
            lastCleanupTime: 0,
            CLEANUP_COOLDOWN: 2000, // 从3秒降到2秒
            // 【关键修复】降低连续警告阈值，更快触发清理
            warningCount: { message: 0, dom: 0, mathjax: 0 },
            // 【关键修复】降低警告阈值，连续1次警告就执行清理
            WARNING_THRESHOLD: 1, // 从2降到1

            // 启动监控
            start() {
                if (this.isRunning) return;
                this.isRunning = true;

                console.log('【内存监控】启动自动监控');

                // 立即执行一次检查
                this.check();

                // 定期执行检查
                this.monitorTimer = setInterval(() => {
                    this.check();
                }, this.CHECK_INTERVAL);

                ResourceManager.addTimer(this.monitorTimer, 'interval');
            },

            // 停止监控
            stop() {
                if (this.monitorTimer) {
                    clearInterval(this.monitorTimer);
                    this.monitorTimer = null;
                }
                this.isRunning = false;
                console.log('【内存监控】已停止');
            },

            // 执行内存检查
            check() {
                try {
                    const stats = this.getStats();

                    // 【防闪退】检查消息数量
                    if (stats.totalMessages > this.MESSAGE_WARNING_THRESHOLD) {
                        this.warningCount.message++;
                        if (this.warningCount.message >= this.WARNING_THRESHOLD) {
                            console.warn(`【内存监控】警告：消息数量 ${stats.totalMessages} 超过阈值 ${this.MESSAGE_WARNING_THRESHOLD}`);
                            this.performCleanup('message');
                            this.warningCount.message = 0;
                        }
                    } else {
                        this.warningCount.message = 0;
                    }

                    // 【防闪退】检查DOM元素数量
                    if (stats.domElements > this.DOM_WARNING_THRESHOLD) {
                        this.warningCount.dom++;
                        if (this.warningCount.dom >= this.WARNING_THRESHOLD) {
                            console.warn(`【内存监控】警告：DOM元素数量 ${stats.domElements} 超过阈值 ${this.DOM_WARNING_THRESHOLD}`);
                            this.performCleanup('dom');
                            this.warningCount.dom = 0;
                        }
                    } else {
                        this.warningCount.dom = 0;
                    }

                    // 【防闪退】检查头像缓存
                    if (stats.avatarCacheSize > 20) { // 【防闪退】从30降到20
                        console.warn(`【内存监控】警告：头像缓存 ${stats.avatarCacheSize} 过大`);
                        AvatarLoader.cleanupCache(10); // 【防闪退】清理数量从15降到10
                    }

                    // 【防闪退】检查MathJax队列
                    if (stats.mathJaxQueueLength > this.MATHJAX_QUEUE_THRESHOLD) {
                        this.warningCount.mathjax++;
                        if (this.warningCount.mathjax >= this.WARNING_THRESHOLD) {
                            console.warn(`【内存监控】警告：MathJax队列 ${stats.mathJaxQueueLength} 超过阈值`);
                            MathJaxRenderQueue.clear();
                            this.warningCount.mathjax = 0;
                        }
                    } else {
                        this.warningCount.mathjax = 0;
                    }

                    // 【防闪退】定期清理虚拟列表缓存
                    VirtualListManager.cleanupUnloadedCache();
                    VirtualListManager.cleanupStaleReferences();

                    // 【关键修复】定期清理内存中的消息数组，防止内存泄漏
                    // 即使消息数量没有超过阈值，也定期清理旧消息
                    if (relationshipData.chatMessages.length > 50) {
                        const removeCount = relationshipData.chatMessages.length - 50;
                        relationshipData.chatMessages.splice(0, removeCount);
                        console.log(`【内存优化】定期清理${removeCount}条旧消息，当前保留50条`);
                    }

                    // 【防闪退】输出内存统计（每5次检查输出一次）
                    if (Math.random() < 0.2) {
                        console.log('【内存监控】当前状态:', stats);
                    }

                } catch (error) {
                    console.error('【内存监控】检查失败:', error);
                }
            },

            // 获取内存统计
            getStats() {
                const chatContent = document.getElementById('chatContent');
                const domElements = chatContent ? chatContent.children.length : 0;

                return {
                    totalMessages: relationshipData.chatMessages.length,
                    domElements: domElements,
                    avatarCacheSize: AvatarLoader.cache.size,
                    messageStoreSize: MessageStore.size(),
                    virtualListEnabled: VirtualListManager.enabled,
                    mathJaxQueueLength: MathJaxRenderQueue.getStats().queueLength
                };
            },

            // 执行清理
            performCleanup(type) {
                // 【防闪退】检查冷却时间，避免过于频繁清理
                const now = Date.now();
                if (now - this.lastCleanupTime < this.CLEANUP_COOLDOWN) {
                    console.log(`【内存监控】清理冷却中，跳过此次${type}清理`);
                    return;
                }
                this.lastCleanupTime = now;

                console.log(`【内存监控】执行 ${type} 清理...`);

                switch(type) {
                    case 'message':
                        // 【回忆保护】不清理消息数据，只清理缓存
                        console.log('【内存监控】【回忆保护】保留所有消息，只清理缓存');
                        cleanupMessageCache();
                        break;
                    case 'dom':
                        // 【回忆保护】不清理DOM消息，只清理其他资源
                        console.log('【内存监控】【回忆保护】保留所有消息DOM，清理其他资源');
                        // 清理头像缓存
                        if (AvatarLoader.cache.size > 20) {
                            AvatarLoader.cleanupCache(10);
                        }
                        // 清理MathJax队列
                        if (MathJaxRenderQueue.getStats().queueLength > 5) {
                            MathJaxRenderQueue.clear();
                        }
                        break;
                }
            },
            
            // 强制完整清理（用户可手动触发）
            forceCleanup() {
                console.log('【内存监控】执行强制完整清理...');
                
                // 清理消息缓存
                cleanupMessageCache();
                
                // 清理头像缓存
                AvatarLoader.clearAllCache();
                
                // 清理消息存储
                MessageStore.clear();
                
                // 重置虚拟列表
                VirtualListManager.reset();
                
                // 触发垃圾回收建议（如果浏览器支持）
                if (window.gc) {
                    try {
                        window.gc();
                        console.log('【内存监控】已建议垃圾回收');
                    } catch (e) {
                        // 忽略错误
                    }
                }
                
                console.log('【内存监控】强制清理完成，当前状态:', this.getStats());
            },
            
            // 【防闪退】头像降级模式
            enableAvatarFallbackMode() {
                console.log('【内存监控】启用头像降级模式');
                AvatarLoader.renderMode = 'none'; // 禁用头像图片，只使用emoji/占位符
                
                // 将当前所有头像替换为emoji
                const chatContent = document.getElementById('chatContent');
                if (chatContent) {
                    const userAvatars = chatContent.querySelectorAll('.message-container.user .message-avatar');
                    const aiAvatars = chatContent.querySelectorAll('.message-container.ai .message-avatar');
                    
                    userAvatars.forEach(avatar => {
                        avatar.innerHTML = `<div style="width: 40px; height: 40px; background-color: #f0f0f0; display: flex; align-items: center; justify-content: center; font-size: 20px;">👤</div>`;
                    });
                    
                    aiAvatars.forEach(avatar => {
                        avatar.innerHTML = `<div style="width: 40px; height: 40px; background-color: #f0f0f0; display: flex; align-items: center; justify-content: center; font-size: 20px; cursor: pointer;">🤖</div>`;
                    });
                }
                
                // 清理所有头像缓存
                AvatarLoader.clearAllCache();
                
                console.log('【内存监控】头像降级模式已启用');
            },
            
            // 【防闪退】恢复头像正常模式
            async disableAvatarFallbackMode() {
                console.log('【内存监控】恢复头像正常模式');
                AvatarLoader.renderMode = 'lazy';
                // 刷新聊天界面以重新加载头像
                await refreshChatInterface();
            }
        };

        // 【防闪退】安全的DOM操作函数
        function safeGetElement(id) {
            const element = document.getElementById(id);
            if (!element) {
                console.warn(`【防闪退】元素不存在: ${id}`);
                return null;
            }
            return element;
        }

        function safeSetText(id, text) {
            const element = safeGetElement(id);
            if (element) {
                element.textContent = text;
            }
        }

        function safeSetValue(id, value) {
            const element = safeGetElement(id);
            if (element) {
                element.value = value;
            }
        }

        function safeSetDisplay(id, display) {
            const element = safeGetElement(id);
            if (element) {
                element.style.display = display;
            }
        }

        function safeSetInnerHTML(id, html) {
            const element = safeGetElement(id);
            if (element) {
                element.innerHTML = html;
            }
        }

        // 【性能优化】头像懒加载和缓存管理器
        const AvatarLoader = {
            // 头像图片缓存
            cache: new Map(),
            // 正在加载的图片
            loadingImages: new Set(),
            // 懒加载观察器
            observer: null,
            // 占位图
            placeholderSrc: 'data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%2240%22 height=%2240%22%3E%3Crect width=%2240%22 height=%2240%22 fill=%22%23e0e0e0%22/%3E%3Ctext x=%2250%25%22 y=%2250%25%22 dominant-baseline=%22middle%22 text-anchor=%22middle%22 fill=%22%23999%22 font-size=%2216%22%3E👤%3C/text%3E%3C/svg%3E',
            // 压缩后的头像尺寸（微信聊天列表小头像）
            compressedSize: 120, // 压缩到120x120像素，更高清晰度
            // 【防闪退】头像渲染模式
            renderMode: 'lazy', // 'lazy' | 'immediate' | 'none'
            // 【防闪退】消息头像统一使用同一个元素（减少DOM数量）
            useUnifiedAvatar: false,
            // 【防闪退】每批加载数量限制
            batchSize: 5,
            // 【防闪退】加载队列
            loadQueue: [],
            // 【防闪退】是否正在处理队列
            isProcessingQueue: false,
            
            // 初始化观察器
            initObserver() {
                if (this.observer) return this.observer;

                // 【ColorOS兼容】检查 IntersectionObserver 支持
                if (!('IntersectionObserver' in window)) {
                    console.log('IntersectionObserver 不支持，使用直接加载');
                    this.renderMode = 'immediate';
                    return null;
                }

                this.observer = new IntersectionObserver((entries) => {
                    entries.forEach(entry => {
                        if (entry.isIntersecting) {
                            const img = entry.target;
                            const src = img.dataset.avatarSrc;
                            if (src) {
                                // 【防闪退】加入队列而不是立即加载
                                this.addToQueue(img, src);
                                this.observer.unobserve(img);
                            }
                        }
                    });
                }, {
                    root: null,
                    rootMargin: '100px', // 【防闪退】增加预加载区域
                    threshold: 0.01
                });
                
                return this.observer;
            },
            
            // 【防闪退】添加到加载队列
            addToQueue(imgElement, src) {
                this.loadQueue.push({ imgElement, src });
                this.processQueue();
            },
            
            // 【防闪退】批量处理加载队列
            async processQueue() {
                if (this.isProcessingQueue || this.loadQueue.length === 0) return;
                
                this.isProcessingQueue = true;
                
                // 分批处理，避免同时加载过多图片
                const batch = this.loadQueue.splice(0, this.batchSize);
                
                // 并行加载当前批次
                await Promise.all(batch.map(({ imgElement, src }) => 
                    this.loadImageInternal(imgElement, src)
                ));
                
                this.isProcessingQueue = false;
                
                // 如果队列中还有，继续处理
                if (this.loadQueue.length > 0) {
                    // 使用 requestAnimationFrame 让出主线程
                    requestAnimationFrame(() => this.processQueue());
                }
            },
            
            // 【防闪退】内部加载方法
            async loadImageInternal(imgElement, src) {
                // 检查缓存
                if (this.cache.has(src)) {
                    imgElement.src = this.cache.get(src);
                    imgElement.classList.add('avatar-loaded');
                    return;
                }
                
                // 避免重复加载
                if (this.loadingImages.has(src)) {
                    // 等待加载完成
                    let checkCount = 0;
                    const checkLoaded = setInterval(() => {
                        if (this.cache.has(src)) {
                            imgElement.src = this.cache.get(src);
                            imgElement.classList.add('avatar-loaded');
                            clearInterval(checkLoaded);
                        }
                        checkCount++;
                        if (checkCount > 50) { // 5秒超时
                            clearInterval(checkLoaded);
                        }
                    }, 100);
                    return;
                }
                
                this.loadingImages.add(src);
                
                try {
                    // 【不压缩头像】直接使用原图，保持最高清晰度
                    let finalSrc = src;
                    
                    // 注意：头像压缩已关闭，使用原图以获得最佳清晰度
                    // 如果内存占用过高，可以重新开启压缩
                    
                    this.cache.set(src, finalSrc);
                    this.loadingImages.delete(src);
                    imgElement.src = finalSrc;
                    imgElement.classList.add('avatar-loaded');
                    
                    // 清理过大的缓存
                    this.cleanupCache(30); // 【防闪退】降低缓存上限到30
                } catch (error) {
                    this.loadingImages.delete(src);
                    imgElement.src = this.placeholderSrc;
                    imgElement.classList.add('avatar-error');
                }
            },
            
            // 【防闪退】压缩头像为更小的尺寸（微信风格 96x96）
            compressAvatar(src) {
                return new Promise((resolve) => {
                    // 【关键修复】检查 src 是否有效
                    if (!src || typeof src !== 'string') {
                        console.warn('【AvatarLoader】compressAvatar: 无效的 src:', src);
                        resolve(''); // 返回空字符串避免错误
                        return;
                    }
                    
                    const img = new Image();
                    img.onload = () => {
                        // 如果图片已经很小，直接返回
                        if (img.width <= 96 && img.height <= 96) {
                            resolve(src);
                            return;
                        }
                        
                        const canvas = document.createElement('canvas');
                        const ctx = canvas.getContext('2d');
                        
                        // 【微信风格】压缩到96x96，平衡清晰度与性能
                        canvas.width = 96;
                        canvas.height = 96;
                        
                        ctx.imageSmoothingEnabled = true;
                        ctx.imageSmoothingQuality = 'medium'; // 使用中等质量，平衡性能
                        ctx.drawImage(img, 0, 0, 96, 96);
                        
                        // 【微信风格】使用0.85质量，类似微信头像压缩
                        const compressed = canvas.toDataURL('image/jpeg', 0.85);
                        resolve(compressed);
                    };
                    img.onerror = () => resolve(src); // 失败时返回原图
                    img.src = src;
                });
            },
            
            // 压缩图片
            compressImage(src, maxSize = this.compressedSize) {
                return new Promise((resolve, reject) => {
                    const img = new Image();
                    img.crossOrigin = 'anonymous';
                    img.onload = () => {
                        // 如果图片已经很小，直接返回原图
                        if (img.width <= maxSize && img.height <= maxSize && !src.startsWith('data:image')) {
                            resolve(src);
                            return;
                        }
                        
                        // 创建canvas进行压缩
                        const canvas = document.createElement('canvas');
                        const ctx = canvas.getContext('2d');
                        
                        // 计算压缩后的尺寸
                        let { width, height } = img;
                        if (width > height) {
                            if (width > maxSize) {
                                height *= maxSize / width;
                                width = maxSize;
                            }
                        } else {
                            if (height > maxSize) {
                                width *= maxSize / height;
                                height = maxSize;
                            }
                        }
                        
                        canvas.width = width;
                        canvas.height = height;
                        
                        // 使用高质量缩放
                        ctx.imageSmoothingEnabled = true;
                        ctx.imageSmoothingQuality = 'high';
                        ctx.drawImage(img, 0, 0, width, height);
                        
                        // 转换为压缩后的DataURL（使用0.92质量，更高清晰度）
                        const compressedSrc = canvas.toDataURL('image/jpeg', 0.92);
                        resolve(compressedSrc);
                    };
                    img.onerror = () => reject(new Error('图片加载失败'));
                    img.src = src;
                });
            },
            
            // 加载图片（带缓存和压缩）
            async loadImage(imgElement, src) {
                // 检查缓存
                if (this.cache.has(src)) {
                    imgElement.src = this.cache.get(src);
                    imgElement.classList.add('avatar-loaded');
                    return;
                }
                
                // 避免重复加载
                if (this.loadingImages.has(src)) {
                    // 等待加载完成
                    let checkCount = 0;
                    const checkLoaded = setInterval(() => {
                        if (this.cache.has(src)) {
                            imgElement.src = this.cache.get(src);
                            imgElement.classList.add('avatar-loaded');
                            clearInterval(checkLoaded);
                        }
                        checkCount++;
                        if (checkCount > 50) { // 5秒超时
                            clearInterval(checkLoaded);
                            console.warn('【AvatarLoader】头像加载超时:', src);
                        }
                    }, 100);
                    return;
                }
                
                this.loadingImages.add(src);

                try {
                    // 【ColorOS优化】跳过图片压缩，直接加载原图
                    // 压缩操作可能导致卡顿，使用原图更流畅
                    let finalSrc = src;

                    this.cache.set(src, finalSrc);
                    this.loadingImages.delete(src);
                    imgElement.src = finalSrc;
                    imgElement.classList.add('avatar-loaded');

                    // 清理过大的缓存
                    this.cleanupCache(100);
                } catch (error) {
                    this.loadingImages.delete(src);
                    imgElement.src = this.placeholderSrc;
                    imgElement.classList.add('avatar-error');
                }
            },
            
            // 创建懒加载头像
            createLazyAvatar(src, size = 40, className = '') {
                // 【防闪退】检查是否为降级模式
                if (this.renderMode === 'none') {
                    // 返回emoji占位符而不是图片
                    const placeholder = document.createElement('div');
                    placeholder.style.width = `${size}px`;
                    placeholder.style.height = `${size}px`;
                    placeholder.style.backgroundColor = '#f0f0f0';
                    placeholder.style.display = 'flex';
                    placeholder.style.alignItems = 'center';
                    placeholder.style.justifyContent = 'center';
                    placeholder.style.fontSize = `${size * 0.5}px`;
                    placeholder.textContent = '👤';
                    return placeholder;
                }
                
                const img = document.createElement('img');
                img.dataset.avatarSrc = src;
                img.src = this.placeholderSrc;
                img.style.width = `${size}px`;
                img.style.height = `${size}px`;
                img.style.borderRadius = '0';
                img.style.objectFit = 'cover';
                img.style.transition = 'opacity 0.3s ease';
                img.className = `lazy-avatar ${className}`;

                // 【ColorOS兼容】检查观察器是否可用
                const observer = this.initObserver();
                if (observer && this.renderMode === 'lazy') {
                    observer.observe(img);
                } else {
                    // 不支持 IntersectionObserver 或立即模式，直接加载图片
                    this.loadImage(img, src);
                }

                return img;
            },
            
            // 清理缓存（当缓存过大时）
            cleanupCache(maxSize = 50) { // 【防闪退】降低缓存上限
                if (this.cache.size > maxSize) {
                    // 【防闪退】使用LRU策略：清理最旧的50%缓存
                    const entriesToDelete = Math.floor(this.cache.size * 0.5);
                    const keys = Array.from(this.cache.keys()).slice(0, entriesToDelete);
                    keys.forEach(key => this.cache.delete(key));
                    console.log('【头像缓存】LRU清理完成，删除:', entriesToDelete, '当前缓存数:', this.cache.size);
                }
            },
            
            // 【防闪退】强制清理所有缓存
            clearAllCache() {
                this.cache.clear();
                this.loadingImages.clear();
                console.log('【头像缓存】已强制清理所有缓存');
            },

            // 【防闪退】清理观察器
            cleanup() {
                if (this.observer) {
                    this.observer.disconnect();
                    this.observer = null;
                }
                this.loadingImages.clear();
            }
        };

        // 【防闪退】全局图片错误处理
        function setupGlobalImageErrorHandler() {
            // 使用事件委托处理图片加载错误
            document.addEventListener('error', function(event) {
                const target = event.target;
                if (target.tagName === 'IMG') {
                    console.warn('【防闪退】图片加载失败:', target.src);
                    // 防止重复触发
                    if (target.dataset.errorHandled) return;
                    target.dataset.errorHandled = 'true';

                    // 【修复】如果是Base64图片（聊天图片），不处理，因为Base64图片已经在内存中
                    // 所谓的"加载失败"通常是误报或者内存问题，不需要显示错误提示
                    if (target.src && target.src.startsWith('data:image')) {
                        console.log('【防闪退】Base64图片，跳过错误处理');
                        // 清除错误标记，让图片保持原样
                        target.dataset.errorHandled = '';
                        return;
                    }

                    // 设置默认占位图（仅用于非Base64图片，如网络图片）
                    target.src = 'data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%22100%22 height=%22100%22%3E%3Crect width=%22100%22 height=%22100%22 fill=%22%23f0f0f0%22/%3E%3Ctext x=%2250%25%22 y=%2250%25%22 dominant-baseline=%22middle%22 text-anchor=%22middle%22 fill=%22%23999%22 font-size=%2214%22%3E📷%3C/text%3E%3C/svg%3E';
                    target.style.opacity = '1';
                }
            }, true);
        }

        // 页面加载完成后设置图片错误处理
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', setupGlobalImageErrorHandler);
        } else {
            setupGlobalImageErrorHandler();
        }

        // 【防闪退】页面切换时自动清理所有资源
        window.addEventListener('beforeunload', () => {
            // 清理资源管理器
            if (typeof ResourceManager !== 'undefined') {
                ResourceManager.cleanupAll();
            }
            
            // 清理头像加载器观察器
            if (typeof AvatarLoader !== 'undefined') {
                AvatarLoader.cleanup();
            }
            
            // 清理内存监控定时器
            if (window.memoryMonitorInterval) {
                clearInterval(window.memoryMonitorInterval);
                window.memoryMonitorInterval = null;
            }
            
            // 清理所有后台活动定时器
            if (typeof backgroundActivityTimer !== 'undefined' && backgroundActivityTimer) {
                clearInterval(backgroundActivityTimer);
                backgroundActivityTimer = null;
            }
            if (typeof backgroundActivityTimeout !== 'undefined' && backgroundActivityTimeout) {
                clearTimeout(backgroundActivityTimeout);
                backgroundActivityTimeout = null;
            }
            if (typeof pendingMessagesInterval !== 'undefined' && pendingMessagesInterval) {
                clearInterval(pendingMessagesInterval);
                pendingMessagesInterval = null;
            }
            if (typeof autoStopCheckInterval !== 'undefined' && autoStopCheckInterval) {
                clearInterval(autoStopCheckInterval);
                autoStopCheckInterval = null;
            }
            if (typeof daysUpdateInterval !== 'undefined' && daysUpdateInterval) {
                clearInterval(daysUpdateInterval);
                daysUpdateInterval = null;
            }
            
            // 停止内存监控
            if (typeof MemoryMonitor !== 'undefined') {
                MemoryMonitor.stop();
            }
        });

        // ==========================================
        // 【完全独立】主屏幕头像管理系统
        // 使用独立的存储键，避免与其他功能冲突
        // ==========================================
        const MainScreenAvatars = {
            // 存储键名 - 使用独特的键名避免冲突
            KEYS: {
                AVATAR1: 'mainscreen_avatar_left_v2',
                AVATAR2: 'mainscreen_avatar_right_v2'
            },
            
            // 默认头像
            DEFAULTS: {
                AVATAR1: 'https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=cartoon%20avatar%20of%20a%20boy%2C%20cute%2C%20simple%20style&image_size=square',
                AVATAR2: 'https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=cartoon%20avatar%20of%20a%20girl%2C%20cute%2C%20simple%20style&image_size=square'
            },
            
            // 缓存数据
            _cache: {
                avatar1: null,
                avatar2: null
            },
            
            // 【核心】保存头像 - 完全独立的保存逻辑
            async save(avatarType, data) {
                const key = this.KEYS[avatarType === 'avatar1' ? 'AVATAR1' : 'AVATAR2'];
                try {
                    await saveImageToDB(key, data);
                    this._cache[avatarType] = data;
                    console.log(`【主屏幕头像】${avatarType} 已保存到 IndexedDB，键名: ${key}`);
                    return true;
                } catch (err) {
                    console.error(`【主屏幕头像】保存 ${avatarType} 失败:`, err);
                    return false;
                }
            },
            
            // 【核心】加载头像 - 完全独立的加载逻辑
            async load(avatarType) {
                const key = this.KEYS[avatarType === 'avatar1' ? 'AVATAR1' : 'AVATAR2'];
                try {
                    const data = await loadImageFromDB(key);
                    if (data) {
                        this._cache[avatarType] = data;
                        console.log(`【主屏幕头像】${avatarType} 已从 IndexedDB 加载，键名: ${key}，长度: ${data.length}`);
                        return data;
                    }
                } catch (err) {
                    console.error(`【主屏幕头像】加载 ${avatarType} 失败:`, err);
                }
                // 返回默认值
                return this.DEFAULTS[avatarType === 'avatar1' ? 'AVATAR1' : 'AVATAR2'];
            },
            
            // 【核心】加载所有头像
            async loadAll() {
                console.log('【主屏幕头像】开始加载所有头像...');
                const avatar1 = await this.load('avatar1');
                const avatar2 = await this.load('avatar2');
                
                // 检查是否相同
                if (avatar1 === avatar2) {
                    console.error('【主屏幕头像】警告：两个头像数据相同！');
                }
                
                // 同步到 relationshipData 以兼容旧代码
                relationshipData.avatar1 = avatar1;
                relationshipData.avatar2 = avatar2;
                
                return { avatar1, avatar2 };
            },
            
            // 【核心】更新显示
            updateDisplay() {
                const avatarElements = document.querySelectorAll('.avatar img');
                if (avatarElements.length < 2) {
                    console.warn('【主屏幕头像】找不到头像元素');
                    return;
                }
                
                const avatar1 = this._cache.avatar1 || this.DEFAULTS.AVATAR1;
                const avatar2 = this._cache.avatar2 || this.DEFAULTS.AVATAR2;
                
                console.log('【主屏幕头像】更新显示');
                console.log('【主屏幕头像】avatar1 长度:', avatar1.length);
                console.log('【主屏幕头像】avatar2 长度:', avatar2.length);
                console.log('【主屏幕头像】是否相同:', avatar1 === avatar2);
                
                // 确保不相同才更新
                if (avatar1 !== avatar2) {
                    avatarElements[0].src = avatar1;
                    avatarElements[1].src = avatar2;
                    console.log('【主屏幕头像】显示更新完成');
                } else {
                    console.error('【主屏幕头像】拒绝更新：两个头像相同！');
                    // 使用默认值
                    avatarElements[0].src = this.DEFAULTS.AVATAR1;
                    avatarElements[1].src = this.DEFAULTS.AVATAR2;
                }
            },
            
            // 【核心】处理文件上传
            async handleUpload(file, avatarType) {
                return new Promise((resolve) => {
                    if (!file) {
                        resolve(false);
                        return;
                    }
                    
                    const reader = new FileReader();
                    reader.onload = async (e) => {
                        try {
                            const data = e.target.result;
                            console.log(`【主屏幕头像】${avatarType} 文件读取完成，长度: ${data.length}`);
                            
                            // 保存到独立存储
                            await this.save(avatarType, data);
                            
                            // 同步到 relationshipData
                            relationshipData[avatarType] = data;
                            
                            // 更新显示
                            this.updateDisplay();
                            
                            resolve(true);
                        } catch (err) {
                            console.error(`【主屏幕头像】${avatarType} 上传失败:`, err);
                            resolve(false);
                        }
                    };
                    reader.onerror = () => {
                        console.error(`【主屏幕头像】${avatarType} 文件读取失败`);
                        resolve(false);
                    };
                    reader.readAsDataURL(file);
                });
            }
        };

        // 初始化恋爱卡片数据
        let relationshipData = {
            title: '我们在一起已经',
            startDate: new Date('2024-01-01'),
            cardBg: '',
            // 【注意】avatar1 和 avatar2 现在由 MainScreenAvatars 管理
            // 这里保留默认值以兼容旧代码
            avatar1: MainScreenAvatars.DEFAULTS.AVATAR1,
            avatar2: MainScreenAvatars.DEFAULTS.AVATAR2,
            topCardBg: '',
            dynamicImage: '',
            leftBubbleText: '我的灵魂是只褪色的纸船',
            rightBubbleText: '但你眼里有让它航行的海',
            leftBubbleAvatar: '',
            rightBubbleAvatar: '',
            selectedCharacterId: null,
            characterRelationships: {},
            // 外观设置相关数据
            theme: {
                mainBg: '',
                appIcons: {
                    wechat: '',
                    worldbook: '',
                    note: '',
                    study: '',
                    couple: '',
                    diary: '',
                    theme: '',
                    settings: '',
                    accounting: '',
                    health: '',
                    // 第二屏幕应用图标
                    admin: '',
                    body: '',
                    postoffice: '',
                    games: '',
                    weibo: '',
                    ball: '',
                    library: '',
                    luckgate: '',
                    // 新增图标
                    railway: '',
                    beauty: '',
                    declutter: '',
                    pet: '',
                    coinFront: '',
                    coinBack: ''
                }
            },
            // 心情相关数据
            mood: {
                type: 'happy',
                emoji: '😊',
                text: '开心',
                customImage: '',
                timestamp: Date.now()
            },
            // 心声相关数据
            innerThoughts: {},
            // 微信相关数据
            wechatChatList: [],
            wechatInputText: '',
            // 【重构】聊天消息存储 - 使用IndexedDB，内存中只保留当前聊天的部分消息
            // 注意：chatMessages数组仍然保留用于兼容旧代码，但数据实际存储在IndexedDB
            chatMessages: new Proxy([], {
                // 跳过保存的标志（用于批量加载时避免重复保存）
                _skipSave: false,
                
                // 拦截所有操作
                get(target, property) {
                    const value = target[property];
                    // 如果是数组方法，需要特殊处理
                    if (typeof value === 'function') {
                        // 拦截push方法
                        if (property === 'push') {
                            return function(...items) {
                                // 【关键修复】限制内存中数组大小，防止内存泄漏
                                const MAX_MEMORY_MESSAGES = 100; // 内存中最多保留100条消息
                                if (target.length + items.length > MAX_MEMORY_MESSAGES) {
                                    // 计算需要移除的消息数量
                                    const removeCount = target.length + items.length - MAX_MEMORY_MESSAGES;
                                    // 移除最旧的消息（从数组开头移除）
                                    target.splice(0, removeCount);
                                    console.log(`【内存优化】Proxy自动清理${removeCount}条旧消息，当前内存中保留${target.length}条`);
                                }

                                const result = target.push(...items);
                                // 【关键修复】如果设置了跳过保存标志，则不保存到IndexedDB
                                if (!this._skipSave) {
                                    console.log(`【重构】Proxy拦截到push操作，${items.length}条新消息`);
                                    items.forEach(item => {
                                        if (item && item.chatId) {
                                            ChatMessageManager.saveMessage(item).then(() => {
                                                console.log('【重构】消息已保存到IndexedDB:', item.chatId, item.content?.substring(0, 20));
                                            }).catch(err => {
                                                console.error('【重构】Proxy自动保存消息失败:', err);
                                            });
                                        }
                                    });
                                }
                                return result;
                            };
                        }
                        // 拦截splice方法
                        if (property === 'splice') {
                            return function(...args) {
                                return target.splice(...args);
                            };
                        }
                        // 其他方法直接绑定
                        return value.bind(target);
                    }
                    return value;
                },
                set(target, property, value) {
                    target[property] = value;
                    return true;
                }
            }),
            // 【内存优化】内存中最多加载的消息数（防止卡顿）
            _maxLoadedMessages: 50, // 【修改】改为50条，加快进入聊天界面的速度
            // 【内存优化】消息分页加载配置
            _messagePageSize: 50, // 每次加载50条消息
            // 世界书相关数据
            worldBooks: [],
            // 挂载的世界书
            mountedWorldBooks: [],
            // NPC列表
            npcList: [],
            // 朋友圈封面
            momentsCover: '',
            // 朋友圈列表
            moments: [],
            // 情侣空间相关数据
            coupleSpaceEnabled: false,
            couplePartnerId: null,
            couplePartnerName: '',
            coupleStartDate: null,
            coupleWallBackground: '',
            coupleCardBackground: '',
            coupleAvatars: {
                top: '',
                left: '',
                right: ''
            },
            // 情侣空间颜色设置
            coupleHeaderColor: '',
            coupleFooterColor: '',
            coupleHeaderTextStroke: '',
            // 卡片背景设置
            coupleCardHeaderBg: '',
            coupleCardHeaderStroke: '',
            coupleCardFooterBg: '',
            // 按钮文本颜色
            footprintTextColor: '',
            blackroomTextColor: '',
            // 旋转木马显示设置
            coupleCarouselVisible: true,
            // 爱人动态记录
            coupleActivityLogs: [],
            // 描述字段（用于角色关系）
            description: '',
            // 拍立得照片相关字段
            polaroidImage: null,
            polaroidText: '',
            polaroidRotation: null
        };

        // 当前选择的头像类型
        let currentAvatarType = '';

        // 【内存优化】消息存储管理器 - 按需加载和清理消息内容
        const MessageStore = {
            // 存储消息内容
            store: new Map(),
            // 访问顺序记录（用于LRU清理）
            accessOrder: [],
            // 最大缓存数量
            maxSize: 200,
            
            // 获取消息内容
            get(messageId) {
                if (this.store.has(messageId)) {
                    // 更新访问顺序
                    this.updateAccessOrder(messageId);
                    return this.store.get(messageId);
                }
                return null;
            },
            
            // 设置消息内容
            set(messageId, content) {
                // 如果超过最大容量，清理最旧的消息
                if (this.store.size >= this.maxSize && !this.store.has(messageId)) {
                    this.cleanupOldest();
                }
                
                this.store.set(messageId, content);
                this.updateAccessOrder(messageId);
            },
            
            // 更新访问顺序
            updateAccessOrder(messageId) {
                const index = this.accessOrder.indexOf(messageId);
                if (index > -1) {
                    this.accessOrder.splice(index, 1);
                }
                this.accessOrder.push(messageId);
            },
            
            // 清理最旧的消息
            cleanupOldest() {
                const toRemove = Math.floor(this.maxSize * 0.2); // 清理20%
                for (let i = 0; i < toRemove && this.accessOrder.length > 0; i++) {
                    const oldestId = this.accessOrder.shift();
                    this.store.delete(oldestId);
                }
                console.log(`【内存优化】清理了 ${toRemove} 条旧消息缓存`);
            },
            
            // 清空所有缓存
            clear() {
                this.store.clear();
                this.accessOrder = [];
            },
            
            // 获取当前缓存大小
            size() {
                return this.store.size;
            }
        };

        // 【内存优化】将消息内容转换为影子格式（移除大字段）
        function createMessageShadow(message) {
            if (!message) return null;
            
            const shadow = {
                id: message.timestamp || Date.now(), // 使用时间戳作为ID
                sender: message.sender,
                chatId: message.chatId,
                timestamp: message.timestamp,
                type: message.type || 'text',
                hasContent: !!message.content,
                hasQuote: !!message.quote,
                isGroupChat: message.isGroupChat,
                senderName: message.senderName,
                // 【内存优化】如果内容包含Base64图片，标记为图片类型但不存储完整数据
                isImageContent: isImageContent(message.content),
                contentPreview: getContentPreview(message.content)
            };
            
            // 【内存优化】如果消息包含大内容，存储到MessageStore，影子只保留引用
            if (message.content && typeof message.content === 'string' && message.content.length > 100) {
                MessageStore.set(shadow.id, message.content);
                shadow._contentRef = shadow.id; // 标记内容存储位置
            }
            
            return shadow;
        }
        
        // 【内存优化】检查内容是否包含Base64图片
        function isImageContent(content) {
            if (!content || typeof content !== 'string') return false;
            return content.includes('data:image') || content.includes('base64');
        }
        
        // 【内存优化】获取内容预览
        function getContentPreview(content) {
            if (!content) return '';
            if (typeof content !== 'string') return String(content).substring(0, 50);
            
            // 如果是Base64图片，返回预览标记
            if (content.includes('data:image') || content.includes('base64')) {
                return '【图片】';
            }
            
            // 返回前50个字符
            return content.substring(0, 50) + (content.length > 50 ? '...' : '');
        }
        
        // 【内存优化】从影子恢复完整消息
        function restoreMessageFromShadow(shadow) {
            if (!shadow) return null;
            
            const fullMessage = {
                sender: shadow.sender,
                chatId: shadow.chatId,
                timestamp: shadow.timestamp,
                type: shadow.type,
                isGroupChat: shadow.isGroupChat,
                senderName: shadow.senderName
            };
            
            // 恢复内容
            if (shadow._contentRef) {
                const content = MessageStore.get(shadow._contentRef);
                if (content) {
                    fullMessage.content = content;
                } else {
                    // 内容已被清理，从数据库重新加载
                    console.warn('【内存优化】消息内容已被清理，需要从数据库重新加载');
                    fullMessage.content = shadow.contentPreview;
                }
            } else {
                fullMessage.content = shadow.contentPreview;
            }
            
            return fullMessage;
        }
        
        // 【内存优化】批量转换消息为影子格式
        function convertMessagesToShadows(messages) {
            if (!Array.isArray(messages)) return [];
            return messages.map(msg => createMessageShadow(msg));
        }
        
        // 【内存优化】清理所有消息缓存（用于页面切换时）
        function cleanupMessageCache() {
            MessageStore.clear();
            console.log('【内存优化】已清理所有消息缓存');
        }
        
        // 【防闪退】清理消息元素的事件监听器和引用
        function cleanupMessageElement(element) {
            if (!element) return;
            
            try {
                // 清理头像上的事件监听器
                const avatar = element.querySelector('.message-avatar');
                if (avatar) {
                    // 克隆节点以移除所有事件监听器
                    const newAvatar = avatar.cloneNode(true);
                    if (avatar.parentNode) {
                        avatar.parentNode.replaceChild(newAvatar, avatar);
                    }
                }
                
                // 清理语音播放按钮上的事件
                const voiceBtn = element.querySelector('.voice-play-btn');
                if (voiceBtn) {
                    voiceBtn.onclick = null;
                }
                
                // 清理消息内容中的图片加载事件
                const images = element.querySelectorAll('img');
                images.forEach(img => {
                    img.onload = null;
                    img.onerror = null;
                });
                
                // 清理自定义数据属性
                if (element.dataset) {
                    // 保留必要的标识属性，清理可能占用内存的数据
                    const keepKeys = ['timestamp', 'messageId', 'virtualId', 'senderName'];
                    Object.keys(element.dataset).forEach(key => {
                        if (!keepKeys.includes(key)) {
                            delete element.dataset[key];
                        }
                    });
                }
                
                // 清理内部元素的数据
                const allElements = element.querySelectorAll('*');
                allElements.forEach(el => {
                    if (el.dataset && el.dataset.originalContent) {
                        delete el.dataset.originalContent;
                    }
                });
                
            } catch (e) {
                console.warn('【内存优化】清理消息元素时出错:', e);
            }
        }

        // 【重构】消息数量管理器 - 消息存储在IndexedDB，不再限制数量
        const MessageLimitManager = {
            // 【回忆保护】不自动清理消息，保留所有回忆
            // 只保留手动清理功能供用户需要时使用
            MAX_MESSAGES_PER_CHAT: 100000,
            MAX_TOTAL_MESSAGES: 500000,
            RETAIN_RATIO: 0.9,
            
            // 添加消息前的检查和处理（不再自动清理）
            beforeAddMessage(message) {
                if (!message || !message.chatId) return message;
                // 【回忆保护】不自动清理消息，保留所有回忆
                return message;
            },
            
            // 清理单个聊天的旧消息
            cleanupOldMessages(chatId) {
                const chatMessages = relationshipData.chatMessages.filter(m => m.chatId === chatId);
                const retainCount = Math.floor(this.MAX_MESSAGES_PER_CHAT * this.RETAIN_RATIO);
                const removeCount = chatMessages.length - retainCount;
                
                if (removeCount > 0) {
                    // 找出最旧的消息（保留最新的）
                    const sortedMessages = chatMessages.sort((a, b) => a.timestamp - b.timestamp);
                    const messagesToRemove = sortedMessages.slice(0, removeCount);
                    const idsToRemove = new Set(messagesToRemove.map(m => m.timestamp));
                    
                    // 从主数组中移除
                    relationshipData.chatMessages = relationshipData.chatMessages.filter(
                        m => m.chatId !== chatId || !idsToRemove.has(m.timestamp)
                    );
                    
                    // 【重要】不减少totalMessageCount和summarizedMessageCount，保留美好记忆统计
                    console.log(`【防闪退】已清理聊天 ${chatId} 的 ${removeCount} 条旧消息，保留 ${retainCount} 条（美好记忆统计不变）`);
                }
            },
            
            // 清理全局消息（从最旧的聊天开始）
            cleanupGlobalMessages() {
                const retainCount = Math.floor(this.MAX_TOTAL_MESSAGES * this.RETAIN_RATIO);
                const removeCount = relationshipData.chatMessages.length - retainCount;
                
                if (removeCount > 0) {
                    // 按时间排序，移除最旧的消息
                    const sortedMessages = relationshipData.chatMessages.sort((a, b) => a.timestamp - b.timestamp);
                    const messagesToRemove = sortedMessages.slice(0, removeCount);
                    const idsToRemove = new Set(messagesToRemove.map(m => m.timestamp + '_' + m.chatId));
                    
                    relationshipData.chatMessages = relationshipData.chatMessages.filter(
                        m => !idsToRemove.has(m.timestamp + '_' + m.chatId)
                    );
                    
                    // 【重要】不减少totalMessageCount和summarizedMessageCount，保留美好记忆统计
                    console.log(`【防闪退】已清理全局 ${removeCount} 条旧消息，保留 ${retainCount} 条（美好记忆统计不变）`);
                }
            },
            
            // 获取当前消息统计
            getStats() {
                const total = relationshipData.chatMessages.length;
                const byChat = {};
                relationshipData.chatMessages.forEach(m => {
                    byChat[m.chatId] = (byChat[m.chatId] || 0) + 1;
                });
                return { total, byChat };
            },
            
            // 【手动清理】强制清理消息到限制范围内
            forceCleanup() {
                console.log('【手动清理】开始强制清理消息...');
                const stats = this.getStats();
                console.log('【手动清理】当前消息统计:', stats);
                
                // 先清理超出限制的单聊天
                Object.entries(stats.byChat).forEach(([chatId, count]) => {
                    if (count > this.MAX_MESSAGES_PER_CHAT) {
                        console.log(`【手动清理】聊天 ${chatId} 消息数 ${count} 超过限制 ${this.MAX_MESSAGES_PER_CHAT}`);
                        this.cleanupOldMessages(parseInt(chatId));
                    }
                });
                
                // 再清理全局消息
                if (stats.total > this.MAX_TOTAL_MESSAGES) {
                    console.log(`【手动清理】全局消息数 ${stats.total} 超过限制 ${this.MAX_TOTAL_MESSAGES}`);
                    this.cleanupGlobalMessages();
                }
                
                const newStats = this.getStats();
                console.log('【手动清理】清理完成，新统计:', newStats);
                
                // 保存数据
                saveDataDebounced(1000);
                
                return {
                    before: stats,
                    after: newStats,
                    removed: stats.total - newStats.total
                };
            }
        };

        // 【重构】统一添加消息函数 - 使用IndexedDB存储
        async function addChatMessage(message) {
            if (!message) return null;

            // 检查消息数量限制
            MessageLimitManager.beforeAddMessage(message);

            // 【重构】保存到IndexedDB
            try {
                await ChatMessageManager.saveMessage(message);
                console.log('【重构】消息已保存到IndexedDB:', message.chatId);
            } catch (error) {
                console.error('【重构】保存消息到IndexedDB失败:', error);
                // 降级：保存到内存（兼容旧数据）
                relationshipData.chatMessages.push(message);
            }

            return message;
        }

