    <!-- 修改信纸背景弹窗 -->
    <div id="letterBgModal" class="modal letter-test-modal">
        <div class="modal-content">
            <div class="modal-header">
                <h3>修改信纸背景</h3>
                <span class="close-btn" onclick="closeLetterBgModal()">&times;</span>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label>信纸背景图片：</label>
                    <input type="file" id="letterBgImage" accept="image/*" class="form-control" onchange="previewLetterBg(this)">
                    <small class="settings-description">选择一张图片作为信纸背景，建议使用信纸纹理或温馨风格的图片</small>
                </div>
                <div class="form-group" id="letterBgPreviewGroup" style="display: none;">
                    <label>预览：</label>
                    <div id="letterBgPreview" style="width: 100%; height: 150px; background-size: cover; background-position: center; border-radius: 8px; border: 1px solid #ddd;"></div>
                </div>
                <div class="form-group">
                    <label>或输入图片链接：</label>
                    <input type="text" id="letterBgUrl" class="form-control" placeholder="https://example.com/paper-bg.jpg" oninput="previewLetterBgFromUrl()">
                </div>
                <div class="form-group">
                    <label>背景模糊度：</label>
                    <input type="range" id="letterBgBlur" class="form-control" min="0" max="20" value="0" oninput="updateLetterBgPreview()">
                    <small class="settings-description">拖动调整背景模糊程度，0为清晰，20为最大模糊</small>
                </div>
                <div class="form-group">
                    <label>背景暗度：</label>
                    <input type="range" id="letterBgDarkness" class="form-control" min="0" max="80" value="0" oninput="updateLetterBgPreview()">
                    <small class="settings-description">拖动调整背景暗度，0为原图，80为最暗</small>
                </div>
            </div>
            <div class="modal-footer">
                <button onclick="closeLetterBgModal()" class="btn btn-cancel">取消</button>
                <button onclick="saveLetterBg()" class="btn btn-save">保存设置</button>
            </div>
        </div>
    </div>

    <!-- 信件内容查看弹窗（信纸背景） -->
    <div id="letterPaperModal" class="letter-paper-modal">
