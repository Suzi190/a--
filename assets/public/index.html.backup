        async function clearAccountingData() {
            if (confirm('确定要清空所有记账数据吗？')) {
                try {
                    await localforage.removeItem('accountingData');
                    await localforage.removeItem('accountingAIEvaluator');
                    accountingData = {
                        totalBudget: 5000,
                        remainingBudget: 3200,
                        totalRewards: 150,
                        records: [],
                        currentRange: 'week',
                        weekFlowers: 0,
                        lightningCount: 0,
                        aiEvaluator: null,
                        lastComment: '',
                        lastCommentTime: null
                    };
                    alert('记账数据已清空');
                    await refreshDebugData();
                } catch (error) {
                    alert('清空失败: ' + error.message);
                }
            }
        }

        // 添加API调用日志
        function addApiCallLog(type, data) {
            const log = {
                time: new Date().toLocaleString(),
                type: type,
                data: data
            };
            apiCallLogs.unshift(log);
            // 只保留最近20条
            if (apiCallLogs.length > 20) apiCallLogs = apiCallLogs.slice(0, 20);
            updateApiLogDisplay();
        }

        // 更新API日志显示
        function updateApiLogDisplay() {
            const contentEl = document.getElementById('debugApiContent');
            if (!contentEl) return;

            if (apiCallLogs.length === 0) {
                contentEl.textContent = '暂无API调用记录';
                return;
            }

            let html = '';
            apiCallLogs.forEach((log, index) => {
                html += `\n=== 调用 #${apiCallLogs.length - index} [${log.time}] ===\n`;
                html += `类型: ${log.type}\n`;
                html += `数据:\n${JSON.stringify(log.data, null, 2)}\n`;
            });
            contentEl.textContent = html;
        }

        // 清空API日志
        function clearApiLogs() {
            apiCallLogs = [];
            updateApiLogDisplay();
        }

