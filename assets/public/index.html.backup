                            let mimeType = audioBlob.type;
                            if (!mimeType || mimeType === 'application/octet-stream') {
                                if (model.includes('speech-02') || model.includes('speech-2.6') || model.includes('speech-2.8')) {
                                    mimeType = 'audio/mpeg';
                                } else {
                                    mimeType = 'audio/wav';
                                }
                            }
                            
                            const audioBlobWithType = new Blob([audioBlob], { type: mimeType });
                            return audioBlobWithType;
                        }
                    } else {
                        // 【修复】添加详细的错误日志
                        const errorText = await response.text();
                        console.error('【防闪退】语音合成失败:', response.status, response.statusText);
