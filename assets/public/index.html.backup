                                for (let i = 0; i < byteCharacters.length; i++) {
                                    byteNumbers[i] = byteCharacters.charCodeAt(i);
                                }
                                const byteArray = new Uint8Array(byteNumbers);

                                // 根据模型推断格式
                                let mimeType = 'audio/wav';
                                if (model.includes('speech-02') || model.includes('speech-2.6') || model.includes('speech-2.8')) {
                                    mimeType = 'audio/mpeg';
                                }

                                const audioBlob = new Blob([byteArray], { type: mimeType });
                                console.log('【防闪退】AI语音合成成功, base64转blob, 大小:', audioBlob.size);
                                return audioBlob;
                            } else {
                                console.error('【防闪退】JSON响应中没有找到音频数据，完整响应:', JSON.stringify(jsonData));
                                return null;
                            }
                        }
                    } else if (isCordova) {
                        // 【APK备用方案】使用 XMLHttpRequest，支持音频和JSON两种格式
                        console.log('【语音合成】APK环境使用 XMLHttpRequest');

                        const result = await new Promise((resolve, reject) => {
                            const xhr = new XMLHttpRequest();
                            xhr.open('POST', url, true);
                            xhr.setRequestHeader('Content-Type', 'application/json');
                            xhr.setRequestHeader('Authorization', `Bearer ${minimaxConfig.apiKey}`);
                            xhr.responseType = 'arraybuffer';
                            xhr.timeout = 300000; // 【统一】300秒超时

                            xhr.onload = function() {
                                console.log('【语音合成】XHR 响应:', xhr.status, xhr.statusText);
                                if (xhr.status >= 200 && xhr.status < 300) {
                                    const contentType = xhr.getResponseHeader('Content-Type') || 'audio/mpeg';
                                    console.log('【语音合成】音频 Content-Type:', contentType);
                                    
                                    // 检查是否是JSON格式
                                    if (contentType.includes('application/json')) {
                                        // 将 arraybuffer 转为字符串
                                        const decoder = new TextDecoder('utf-8');
                                        const jsonStr = decoder.decode(xhr.response);
                                        console.log('【语音合成】JSON响应:', jsonStr);
                                        resolve({ type: 'json', data: jsonStr });
                                    } else {
                                        // 直接音频数据
                                        const blob = new Blob([xhr.response], { type: contentType });
                                        resolve({ type: 'audio', data: blob });
                                    }
                                } else {
                                    reject(new Error(`HTTP ${xhr.status}: ${xhr.statusText}`));
                                }
                            };

                            xhr.onerror = () => {
                                console.error('【语音合成】XHR onerror 触发，尝试使用原生 HTTP');
                                // 【修复】尝试使用 Android 原生 HTTP 请求
