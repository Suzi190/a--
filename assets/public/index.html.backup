<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>佳景</title>
    
    <!-- 【一加兼容】禁止自动调整字体大小 -->
    <meta name="wap-font-scale" content="no">
    <!-- 【一加兼容】QQ浏览器禁止缩放 -->
    <meta name="x5-fullscreen" content="true">
    <meta name="x5-page-mode" content="app">
    <!-- 【一加兼容】UC浏览器全屏 -->
    <meta name="full-screen" content="yes">
    <meta name="browsermode" content="application">
    <!-- 【一加兼容】360浏览器全屏 -->
    <meta name="x5-orientation" content="portrait">
    <!-- 构建时间: 2026-01-26 15:30:00 -->
    
    <!-- PWA Meta 标签 -->
    <meta name="theme-color" content="#f8f8f8">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <meta name="apple-mobile-web-app-title" content="模拟手机界面">
    <meta name="description" content="一个模拟手机界面的聊天应用">
    <link rel="icon" type="image/png" sizes="192x192" href="https://img.58sb.cn/file/img/V7Ucqzhl.jpg">
    <link rel="apple-touch-icon" href="https://img.58sb.cn/file/img/V7Ucqzhl.jpg">
    
    <!-- 平方长安体字体 -->
    <link href="https://fontsapi.zeoseven.com/492/main/result.css" rel="stylesheet">

    <!-- ============================================
         【性能优化 - 防闪退核心配置】
         ============================================ -->
    <script>
        // 【防闪退】全局性能监控和内存管理
        window.__performanceConfig = {
            // 内存限制配置
            memoryLimit: {
                maxImageSize: 2 * 1024 * 1024, // 2MB - 图片显示限制
                maxStorageImageSize: 5 * 1024 * 1024, // 5MB - 存储限制
                maxBase64Length: 10 * 1024 * 1024, // 10MB - base64处理限制
                maxMessagesInMemory: 30, // 内存中最多保留的消息数
            },
            // 节流配置
            throttle: {
                inputDelay: 150, // 输入框节流延迟
                scrollDelay: 100, // 滚动节流
                resizeDelay: 200, // 窗口调整节流
            },
            // 防抖配置
            debounce: {
                saveData: 2000, // 保存数据防抖
                renderMessages: 100, // 渲染消息防抖
                search: 300, // 搜索防抖
            },
            // 性能标记
            marks: {
                lastInputTime: 0,
                lastRenderTime: 0,
                renderCount: 0,
            },
            // 【性能优化】日志控制 - 关闭以减少性能开销
            debug: false // 设置为 true 开启调试日志
        };

        // 【性能优化】重写 console 方法，根据配置控制日志输出
        (function() {
            const originalLog = console.log;
            const originalWarn = console.warn;
            const originalError = console.error;

            console.log = function(...args) {
                if (window.__performanceConfig && window.__performanceConfig.debug) {
                    originalLog.apply(console, args);
                }
            };

            console.warn = function(...args) {
                // 警告日志始终输出，但可以通过配置关闭
                if (window.__performanceConfig && window.__performanceConfig.debug) {
                    originalWarn.apply(console, args);
                }
            };

            // 错误日志始终输出，确保能捕获问题
            console.error = function(...args) {
                originalError.apply(console, args);
            };
        })();

        // 【防闪退】全局错误捕获
        window.addEventListener('error', function(e) {
            console.error('【全局错误捕获】', e.message, e.filename, e.lineno);
            // 【防闪退】针对图片处理错误的特殊处理
            if (e.message && (
                e.message.includes('Image') || 
                e.message.includes('canvas') || 
                e.message.includes('blob') ||
                e.message.includes('memory')
            )) {
                console.warn('【全局错误捕获】检测到图片/内存相关错误，尝试清理资源...');
                // 尝试清理可能的内存泄漏
                if (window.__cleanupMemory) {
                    window.__cleanupMemory();
                }
                showToast('图片处理出现问题，请重试');
            }
            // 防止错误导致闪退
            e.preventDefault();
        }, true);

        window.addEventListener('unhandledrejection', function(e) {
            console.error('【未处理Promise错误】', e.reason);
            // 【防闪退】针对图片处理Promise错误的特殊处理
            if (e.reason && e.reason.message && (
                e.reason.message.includes('图片') ||
                e.reason.message.includes('Image') ||
                e.reason.message.includes('timeout') ||
                e.reason.message.includes('内存')
            )) {
                console.warn('【未处理Promise错误】检测到图片处理错误，已自动处理');
                // 图片处理超时已自动降级使用原图，不需要显示错误提示
            }
            e.preventDefault();
        });

        // 【性能优化】内存使用监控 - 【优化】降低检查频率，减少性能开销
        if (window.performance && window.performance.memory) {
            setInterval(function() {
                const memory = window.performance.memory;
                const usedMB = Math.round(memory.usedJSHeapSize / 1048576);
                const limitMB = Math.round(memory.jsHeapSizeLimit / 1048576);
                
                // 当内存使用超过85%时发出警告（降低阈值提前预警）
                if (usedMB / limitMB > 0.85) {
                    console.warn('【内存警告】内存使用过高:', usedMB + 'MB / ' + limitMB + 'MB');
                    // 触发内存清理
                    if (window.__cleanupMemory) {
                        window.__cleanupMemory();
                    }
                }
            }, 30000); // 【优化】每30秒检查一次，减少性能开销
        }

        // 【防闪退】内存清理函数
        window.__cleanupMemory = function() {
            console.log('【内存清理】开始清理内存...');
            
            // 清理Canvas元素
            const canvases = document.querySelectorAll('canvas');
            canvases.forEach(canvas => {
                try {
                    canvas.width = 0;
                    canvas.height = 0;
                } catch (e) {}
            });
            
            // 清理图片元素的src（非显示中的图片）
            const images = document.querySelectorAll('img:not([id="anniversaryBgImage"]):not([id="avatar1"]):not([id="avatar2"])');
            images.forEach(img => {
                if (!img.isConnected || img.offsetParent === null) {
                    try {
                        img.src = '';
                    } catch (e) {}
                }
            });
            
            // 提示垃圾回收（如果可用）
            if (window.gc) {
                try {
                    window.gc();
                } catch (e) {}
            }
            
            console.log('【内存清理】清理完成');
        };

        // 【防闪退】防止快速连续点击
        window.__preventRapidClick = function(element, delay) {
            if (!element) return;
            if (element._clickDisabled) return false;
            
            element._clickDisabled = true;
            setTimeout(function() {
                element._clickDisabled = false;
            }, delay || 500);
            return true;
        };

        // 【关键修复】页面可见性API - 处理后台切换
        (function() {
            // 标记应用状态
            window.__appInBackground = false;
            
            // 处理页面可见性变化
            function handleVisibilityChange() {
                if (document.hidden) {
                    // 页面进入后台
                    window.__appInBackground = true;
                    console.log('【页面可见性】应用进入后台');
                    
                    // 触发自定义事件
                    if (typeof onAppPause === 'function') {
                        onAppPause();
                    }
                } else {
                    // 页面回到前台
                    window.__appInBackground = false;
                    console.log('【页面可见性】应用回到前台');
                    
                    // 触发自定义事件
                    if (typeof onAppResume === 'function') {
                        onAppResume();
                    }
                    
                    // 【关键】确保输入框可以正常使用
                    setTimeout(function() {
                        // 重置所有输入框的状态
                        document.querySelectorAll('input, textarea').forEach(function(input) {
                            input.disabled = false;
                            input.style.pointerEvents = 'auto';
                        });
                    }, 100);
                }
            }
            
            // 监听可见性变化
            document.addEventListener('visibilitychange', handleVisibilityChange);
            
            // 监听页面显示事件（兼容旧浏览器）
            window.addEventListener('pageshow', function(e) {
                if (e.persisted) {
                    // 页面从缓存恢复
                    console.log('【pageshow】页面从缓存恢复');
                    window.__appInBackground = false;
                    setTimeout(function() {
                        document.querySelectorAll('input, textarea').forEach(function(input) {
                            input.disabled = false;
                            input.style.pointerEvents = 'auto';
                        });
                    }, 100);
                }
            });
            
            // 监听页面隐藏事件
            window.addEventListener('pagehide', function() {
                window.__appInBackground = true;
                console.log('【pagehide】页面隐藏');
            });
        })();
    </script>

    <!-- ============================================
         【输入框兼容性修复 - 支持所有机型】
         解决软键盘弹出遮挡输入框问题
         ============================================ -->
    <script>
        (function() {
            'use strict';
            
            // 配置
            const CONFIG = {
                debug: true,
                scrollDelay: 100,
                resizeThrottle: 50,
                supportList: ['iOS', 'Android', 'HarmonyOS']
            };
            
            // 日志
            function log(...args) {
                if (CONFIG.debug) console.log('[输入框修复]', ...args);
            }
            
            // 检测平台
            function detectPlatform() {
                const ua = navigator.userAgent;
                if (/iPad|iPhone|iPod/.test(ua)) return 'iOS';
                if (/Android/.test(ua)) return 'Android';
                if (/HarmonyOS/.test(ua)) return 'HarmonyOS';
                return 'other';
            }
            
            // 检测手机品牌
            function detectBrand() {
                const ua = navigator.userAgent;
                if (/OnePlus|ONEPLUS/.test(ua)) return 'oneplus';
                if (/OPPO|oppo/.test(ua)) return 'oppo';
                if (/vivo|VIVO/.test(ua)) return 'vivo';
                if (/Xiaomi|MI\s|Redmi/.test(ua)) return 'xiaomi';
                if (/HUAWEI|HONOR/.test(ua)) return 'huawei';
                if (/Samsung|SAMSUNG/.test(ua)) return 'samsung';
                if (/Meizu|MEIZU/.test(ua)) return 'meizu';
                return 'other';
            }
            
            const platform = detectPlatform();
            const brand = detectBrand();
            log('检测到平台:', platform, '品牌:', brand);
            
            // 给 body 添加品牌类名，用于 CSS 针对性适配
            document.body.classList.add(brand);
            document.body.classList.add(platform.toLowerCase());
            
            // 存储原始视口高度
            let originalWindowHeight = window.innerHeight;
            let keyboardHeight = 0;
            let isKeyboardVisible = false;
            let currentFocusElement = null;
            
            // 获取元素在视口中的位置
            function getElementViewportPosition(element) {
                const rect = element.getBoundingClientRect();
                return {
                    top: rect.top,
                    bottom: rect.bottom,
                    height: rect.height,
                    center: rect.top + rect.height / 2
                };
            }
            
            // 滚动元素到可视区域
            function scrollElementIntoView(element) {
                if (!element) return;
                
                const pos = getElementViewportPosition(element);
                const visibleHeight = window.innerHeight - keyboardHeight;
                
                log('元素位置:', pos, '可视高度:', visibleHeight);
                
                // 如果元素被键盘遮挡
                if (pos.bottom > visibleHeight - 20) {
                    const scrollOffset = pos.bottom - visibleHeight + 100; // 额外留出空间
                    
                    // 平滑滚动
                    window.scrollBy({
                        top: scrollOffset,
                        behavior: 'smooth'
                    });
                    
                    // 同时滚动父容器
                    let parent = element.parentElement;
                    while (parent) {
                        if (parent.scrollHeight > parent.clientHeight) {
                            parent.scrollTop += scrollOffset;
                        }
                        parent = parent.parentElement;
                    }
                    
                    log('滚动偏移:', scrollOffset);
                }
            }
            
            // iOS 专用处理
            // 【性能优化】简化处理，避免在聊天输入框上触发复杂的滚动逻辑
            function handleIOSInput() {
                let scrollTimer = null;
                
                document.addEventListener('focusin', (e) => {
                    if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') {
                        // 【性能优化】跳过聊天输入框，避免输入延迟
                        if (e.target.id === 'chatInput' || e.target.closest('.chat-bottom')) {
                            return;
                        }
                        
                        currentFocusElement = e.target;
                        
                        // 延迟滚动，等待键盘弹出
                        clearTimeout(scrollTimer);
                        scrollTimer = setTimeout(() => {
                            scrollElementIntoView(e.target);
                        }, CONFIG.scrollDelay);
                    }
                });
                
                // 处理键盘收起
                document.addEventListener('focusout', () => {
                    currentFocusElement = null;
                    // 恢复页面位置
                    setTimeout(() => {
                        window.scrollTo({ top: 0, behavior: 'smooth' });
                    }, 100);
                });
            }
            
            // Android 专用处理
            function handleAndroidInput() {
                let resizeTimer = null;
                
                // 使用 Visual Viewport API（现代浏览器）
                if (window.visualViewport) {
                    window.visualViewport.addEventListener('resize', () => {
                        clearTimeout(resizeTimer);
                        resizeTimer = setTimeout(() => {
                            const newHeight = window.visualViewport.height;
                            keyboardHeight = window.innerHeight - newHeight;
                            isKeyboardVisible = keyboardHeight > 100;
                            
                            log('键盘高度:', keyboardHeight, '是否可见:', isKeyboardVisible);
                            
                            if (isKeyboardVisible && currentFocusElement) {
                                scrollElementIntoView(currentFocusElement);
                            }
                        }, CONFIG.resizeThrottle);
                    });
                } else {
                    // 降级方案：监听窗口 resize
                    window.addEventListener('resize', () => {
                        clearTimeout(resizeTimer);
                        resizeTimer = setTimeout(() => {
                            const newHeight = window.innerHeight;
                            keyboardHeight = Math.max(0, originalWindowHeight - newHeight);
                            isKeyboardVisible = keyboardHeight > 100;
                            
                            log('窗口变化，键盘高度:', keyboardHeight);
                            
                            if (isKeyboardVisible && currentFocusElement) {
                                scrollElementIntoView(currentFocusElement);
                            }
                        }, CONFIG.resizeThrottle);
                    });
                }
                
                // 监听焦点
                document.addEventListener('focusin', (e) => {
                    if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') {
                        // 【性能优化】跳过聊天输入框，避免输入延迟
                        if (e.target.id === 'chatInput' || e.target.closest('.chat-bottom')) {
                            return;
                        }
                        
                        currentFocusElement = e.target;
                        originalWindowHeight = window.innerHeight;
                        
                        // 延迟检查键盘
                        setTimeout(() => {
                            if (window.visualViewport) {
                                keyboardHeight = window.innerHeight - window.visualViewport.height;
                                isKeyboardVisible = keyboardHeight > 100;
                            }
                            scrollElementIntoView(e.target);
                        }, CONFIG.scrollDelay);
                    }
                });
                
                document.addEventListener('focusout', () => {
                    currentFocusElement = null;
                    keyboardHeight = 0;
                    isKeyboardVisible = false;
                });
            }
            
            // 通用增强 - 【优化】简化事件处理，避免冲突
            // 【性能优化】跳过聊天输入框，避免影响输入性能
            function enhanceAllInputs() {
                const inputs = document.querySelectorAll('input, textarea');
                
                inputs.forEach(input => {
                    // 【性能优化】跳过聊天输入框，避免重复添加事件监听器
                    if (input.id === 'chatInput' || input.closest('.chat-bottom')) {
                        return;
                    }
                    
                    // 添加自动完成属性
                    input.setAttribute('autocomplete', 'off');
                    input.setAttribute('autocorrect', 'off');
                    input.setAttribute('autocapitalize', 'off');
                    input.setAttribute('spellcheck', 'false');
                    
                    // 确保输入框可以被点击和聚焦
                    input.style.pointerEvents = 'auto';
                    input.style.cursor = 'text';
                    
                    // 【优化】移除复杂的事件处理，只保留必要的
                    // 防止快速失焦
                    input.addEventListener('blur', (e) => {
                        setTimeout(() => {
                            if (document.activeElement !== e.target) {
                                document.body.classList.remove('keyboard-open');
                            }
                        }, 200);
                    });
                    
                    // 聚焦时添加标记
                    input.addEventListener('focus', () => {
                        document.body.classList.add('keyboard-open');
                        currentFocusElement = input;
                    });
                });
                
                log('已增强', inputs.length, '个输入框');
            }
            
            // 特殊处理：修复某些 Android 机型输入框无法点击的问题
            function fixAndroidInputClick() {
                if (platform !== 'Android') return;
                
                // 为所有输入框的父元素添加点击穿透
                document.querySelectorAll('input, textarea').forEach(input => {
                    let parent = input.parentElement;
                    while (parent && parent !== document.body) {
                        const style = window.getComputedStyle(parent);
                        if (style.position === 'fixed' || style.position === 'absolute') {
                            parent.style.pointerEvents = 'auto';
                        }
                        parent = parent.parentElement;
                    }
                });
                
                log('已修复 Android 输入框点击问题');
            }
            
            // 【优化】简化第三方键盘处理
            function fixThirdPartyKeyboard() {
                // 【性能优化】移除 compositionend 事件监听，避免每次输入后触发滚动导致延迟
                // 输入延迟问题主要由此引起，scrollElementIntoView 会执行复杂的滚动计算
                // document.addEventListener('compositionend', (e) => {
                //     if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') {
                //         // 确保输入完成后输入框可见
                //         setTimeout(() => scrollElementIntoView(e.target), 100);
                //     }
                // });
            }
            
            // 【优化】简化防止页面缩放处理
            function preventZoom() {
                // 只禁止多指缩放
                document.addEventListener('touchstart', (e) => {
                    if (e.touches.length > 1) {
                        e.preventDefault();
                    }
                }, { passive: false });
            }
            
            // 初始化
            function init() {
                log('初始化输入框兼容性修复...');
                
                if (platform === 'iOS') {
                    handleIOSInput();
                } else if (platform === 'Android' || platform === 'HarmonyOS') {
                    handleAndroidInput();
                }
                
                enhanceAllInputs();
                fixAndroidInputClick();
                fixThirdPartyKeyboard();
                preventZoom();
                
                // 【性能优化】监听 DOM 变化，但只在必要时处理
                // 使用 debounce 避免频繁调用 enhanceAllInputs
                let enhanceTimeout = null;
                const observer = new MutationObserver((mutations) => {
                    // 检查是否真的有新的输入框被添加
                    let hasNewInput = false;
                    mutations.forEach((mutation) => {
                        mutation.addedNodes.forEach((node) => {
                            if (node.nodeType === 1) { // Element
                                if (node.tagName === 'INPUT' || node.tagName === 'TEXTAREA') {
                                    hasNewInput = true;
                                }
                                // 检查子元素
                                const inputs = node.querySelectorAll?.('input, textarea');
                                if (inputs?.length > 0) {
                                    hasNewInput = true;
                                }
                            }
                        });
                    });
                    
                    // 只有在有输入框被添加时才执行 enhanceAllInputs
                    if (hasNewInput) {
                        clearTimeout(enhanceTimeout);
                        enhanceTimeout = setTimeout(() => {
                            enhanceAllInputs();
                        }, 100);
                    }
                });
                
                observer.observe(document.body, {
                    childList: true,
                    subtree: true
                });
                
                log('初始化完成！');
            }
            
            // DOM 就绪后初始化
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', init);
            } else {
                init();
            }
            
            // 暴露全局 API
            window.InputFix = {
                scrollToInput: scrollElementIntoView,
                getKeyboardHeight: () => keyboardHeight,
                isKeyboardVisible: () => isKeyboardVisible,
                platform: platform
            };
            
        })();
    </script>

    <!-- 【CORS网关和网络预检配置】-->
    <script>
        // ============================================
        // 【安全绕过预检配置】
        // ============================================
        window.__securityConfig = {
            // 是否启用调试模式（绕过部分安全限制）
            debugMode: true,
            // 是否允许自签名证书（仅调试）
            allowSelfSignedCerts: true,
            // 是否允许明文HTTP
            allowCleartext: true,
            // 是否绕过CORS检查
            bypassCORS: true,
            // 请求重试次数
            retryCount: 3,
            // 请求超时（毫秒）
            timeout: 300000
        };

        // ============================================
        // 【CORS代理网关配置】
        // ============================================
        window.__corsGateway = {
            // 公共CORS代理列表
            proxies: [
                { name: 'allorigins', url: 'https://api.allorigins.win/raw?url=' },
                { name: 'corsproxy', url: 'https://corsproxy.io/?' },
                { name: 'thingproxy', url: 'https://thingproxy.freeboard.io/fetch/' }
            ],
            // 当前使用的代理索引
            currentProxyIndex: 0,

            // 获取当前代理URL
            getCurrentProxy: function() {
                return this.proxies[this.currentProxyIndex];
            },

            // 切换到下一个代理
            switchToNextProxy: function() {
                this.currentProxyIndex = (this.currentProxyIndex + 1) % this.proxies.length;
                console.log('【CORS网关】切换到代理:', this.getCurrentProxy().name);
                return this.getCurrentProxy();
            },

            // 包装URL通过代理
            wrapUrl: function(targetUrl) {
                // 如果URL已经是HTTPS且同源，不需要代理
                if (this.isSameOrigin(targetUrl)) {
                    return targetUrl;
                }
                const proxy = this.getCurrentProxy();
                return proxy.url + encodeURIComponent(targetUrl);
            },

            // 检查是否同源
            isSameOrigin: function(url) {
                try {
                    const urlObj = new URL(url);
                    return urlObj.origin === window.location.origin;
                } catch (e) {
                    return true; // 相对路径视为同源
                }
            },

            // 检查URL是否需要代理
            needsProxy: function(url) {
                // 如果是相对路径，不需要代理
                if (url.startsWith('/')) return false;

                try {
                    const urlObj = new URL(url);
                    // 如果是IP地址或localhost，可能需要代理
                    const isIP = /^\d+\.\d+\.\d+\.\d+$/.test(urlObj.hostname);
                    const isLocalhost = urlObj.hostname === 'localhost' || urlObj.hostname === '127.0.0.1';

                    // 同源不需要代理
                    if (urlObj.origin === window.location.origin) return false;

                    // 如果是IP地址或localhost，可能需要代理（取决于目标服务器CORS配置）
                    if (isIP || isLocalhost) return true;

                    // 跨域需要代理
                    return true;
                } catch (e) {
                    return false;
                }
            }
        };

        // ============================================
        // 【网络请求预检和诊断】
        // ============================================
        window.__networkPreCheck = {
            // 预检缓存
            preflightCache: new Map(),

            // 执行预检请求
            async preflight(url, options = {}) {
                const cacheKey = `${url}_${JSON.stringify(options.headers || {})}`;

                // 检查缓存
                if (this.preflightCache.has(cacheKey)) {
                    const cached = this.preflightCache.get(cacheKey);
                    if (Date.now() - cached.time < 300000) { // 5分钟缓存
                        return cached.result;
                    }
                }

                console.log('【网络预检】开始预检:', url);

                const results = {
                    url: url,
                    timestamp: Date.now(),
                    checks: {}
                };

                try {
                    // 1. 检查URL格式
                    try {
                        new URL(url);
                        results.checks.urlFormat = { status: 'ok', message: 'URL格式正确' };
                    } catch (e) {
                        results.checks.urlFormat = { status: 'error', message: 'URL格式错误: ' + e.message };
                        return results;
                    }

                    // 2. 检查协议
                    const urlObj = new URL(url);
                    if (urlObj.protocol === 'http:') {
                        results.checks.protocol = { status: 'warning', message: '使用HTTP协议，在Android 9+可能需要配置' };
                    } else {
                        results.checks.protocol = { status: 'ok', message: '使用HTTPS协议' };
                    }

                    // 3. 测试HEAD请求（快速检查连通性）
                    try {
                        const controller = new AbortController();
                        const timeoutId = setTimeout(() => controller.abort(), 10000);

                        const response = await fetch(url, {
                            method: 'HEAD',
                            mode: 'no-cors',
                            signal: controller.signal
                        });

                        clearTimeout(timeoutId);
                        results.checks.connectivity = { status: 'ok', message: '服务器可连接' };
                    } catch (e) {
                        results.checks.connectivity = { status: 'warning', message: 'HEAD请求失败: ' + e.message };
                    }

                    // 4. 检查CORS支持
                    try {
                        const controller = new AbortController();
                        const timeoutId = setTimeout(() => controller.abort(), 10000);

                        const response = await fetch(url, {
                            method: 'OPTIONS',
                            mode: 'cors',
                            signal: controller.signal
                        });

                        clearTimeout(timeoutId);
                        results.checks.cors = { status: 'ok', message: 'CORS预检成功' };
                    } catch (e) {
                        results.checks.cors = { status: 'warning', message: 'CORS可能受限: ' + e.message };
                    }

                    results.status = 'completed';

                } catch (error) {
                    results.status = 'error';
                    results.error = error.message;
                }

                // 缓存结果
                this.preflightCache.set(cacheKey, {
                    result: results,
                    time: Date.now()
                });

                console.log('【网络预检】预检完成:', results);
                return results;
            },

            // 快速检查URL是否可用
            async quickCheck(url) {
                try {
                    const controller = new AbortController();
                    const timeoutId = setTimeout(() => controller.abort(), 5000);

                    await fetch(url, {
                        method: 'HEAD',
                        mode: 'no-cors',
                        signal: controller.signal
                    });

                    clearTimeout(timeoutId);
                    return { available: true, message: 'URL可访问' };
                } catch (e) {
                    return { available: false, message: e.message };
                }
            }
        };

        // ============================================
        // 【增强版Fetch - 自动处理CORS和重试】
        // ============================================
        window.__enhancedFetch = async function(url, options = {}) {
            const maxRetries = options.__retryCount || window.__securityConfig.retryCount;
            let lastError = null;

            // 预检（如果启用）
            if (options.__preflight !== false) {
                await window.__networkPreCheck.preflight(url);
            }

            for (let attempt = 0; attempt < maxRetries; attempt++) {
                try {
                    console.log(`【增强Fetch】尝试 ${attempt + 1}/${maxRetries}: ${url}`);

                    let fetchUrl = url;
                    let fetchOptions = { ...options };

                    // 删除内部选项
                    delete fetchOptions.__retryCount;
                    delete fetchOptions.__preflight;
                    delete fetchOptions.__useProxy;

                    // 如果需要使用代理
                    if (options.__useProxy !== false && window.__corsGateway.needsProxy(url)) {
                        fetchUrl = window.__corsGateway.wrapUrl(url);
                        console.log('【增强Fetch】使用代理:', fetchUrl);
                    }

                    // 设置超时
                    const controller = new AbortController();
                    const timeoutId = setTimeout(() => controller.abort(), window.__securityConfig.timeout);

                    fetchOptions.signal = controller.signal;

                    // 执行请求
                    const response = await fetch(fetchUrl, fetchOptions);

                    clearTimeout(timeoutId);

                    // 如果成功，返回响应
                    if (response.ok || response.status === 0) { // status 0 可能是 opaque 响应
                        console.log('【增强Fetch】请求成功');
                        return response;
                    }

                    // 如果收到CORS错误，尝试使用代理
                    if (response.status === 0 && attempt < maxRetries - 1) {
                        console.warn('【增强Fetch】可能是CORS错误，尝试使用代理');
                        window.__corsGateway.switchToNextProxy();
                        continue;
                    }

                    return response;

                } catch (error) {
                    lastError = error;
                    console.warn(`【增强Fetch】尝试 ${attempt + 1} 失败:`, error.message);

                    // 如果是CORS错误，尝试切换代理
                    if (error.message.includes('CORS') || error.message.includes('Failed to fetch')) {
                        if (attempt < maxRetries - 1) {
                            window.__corsGateway.switchToNextProxy();
                            console.log('【增强Fetch】切换到下一个代理重试');
                            continue;
                        }
                    }

                    // 如果不是最后一次尝试，等待后重试
                    if (attempt < maxRetries - 1) {
                        const delay = Math.pow(2, attempt) * 1000; // 指数退避
                        console.log(`【增强Fetch】等待 ${delay}ms 后重试...`);
                        await new Promise(resolve => setTimeout(resolve, delay));
                    }
                }
            }

            // 所有重试都失败
            console.error('【增强Fetch】所有尝试都失败');
            throw lastError || new Error('请求失败，请检查网络连接');
        };

        // ============================================
        // 【网络诊断工具】
        // ============================================
        window.__networkDiagnostics = {
            async runFullDiagnostics() {
                console.log('╔════════════════════════════════════════╗');
                console.log('║     网络连接全面诊断开始               ║');
                console.log('╚════════════════════════════════════════╝');

                const results = {
                    timestamp: new Date().toISOString(),
                    userAgent: navigator.userAgent,
                    tests: []
                };

                // 测试1: 基础网络连接
                try {
                    const start = Date.now();
                    await fetch('https://www.baidu.com', { mode: 'no-cors', cache: 'no-cache' });
                    results.tests.push({
                        name: '基础网络连接',
                        status: 'success',
                        duration: Date.now() - start,
                        message: '网络连接正常'
                    });
                } catch (e) {
                    results.tests.push({
                        name: '基础网络连接',
                        status: 'error',
                        message: '网络连接失败: ' + e.message
                    });
                }

                // 测试2: HTTPS连接
                try {
                    const start = Date.now();
                    await fetch('https://httpbin.org/get', { mode: 'cors', cache: 'no-cache' });
                    results.tests.push({
                        name: 'HTTPS CORS连接',
                        status: 'success',
                        duration: Date.now() - start,
                        message: 'HTTPS CORS正常'
                    });
                } catch (e) {
                    results.tests.push({
                        name: 'HTTPS CORS连接',
                        status: 'warning',
                        message: 'HTTPS CORS受限: ' + e.message
                    });
                }

                // 测试3: CORS代理可用性
                for (const proxy of window.__corsGateway.proxies) {
                    try {
                        const start = Date.now();
                        const testUrl = proxy.url + encodeURIComponent('https://httpbin.org/get');
                        await fetch(testUrl, { mode: 'cors', cache: 'no-cache' });
                        results.tests.push({
                            name: `CORS代理: ${proxy.name}`,
                            status: 'success',
                            duration: Date.now() - start,
                            message: '代理可用'
                        });
                    } catch (e) {
                        results.tests.push({
                            name: `CORS代理: ${proxy.name}`,
                            status: 'error',
                            message: '代理不可用: ' + e.message
                        });
                    }
                }

                // 测试4: Capacitor环境检测
                const isCapacitor = typeof window !== 'undefined' && window.Capacitor && window.Capacitor.isNative;
                results.tests.push({
                    name: 'Capacitor环境',
                    status: isCapacitor ? 'success' : 'info',
                    message: isCapacitor ? '运行在Capacitor原生环境' : '运行在浏览器环境'
                });

                // 测试5: HTTP插件检测
                if (isCapacitor && window.Capacitor.Plugins && window.Capacitor.Plugins.Http) {
                    results.tests.push({
                        name: 'Capacitor HTTP插件',
                        status: 'success',
                        message: 'HTTP插件已加载'
                    });
                } else if (isCapacitor) {
                    results.tests.push({
                        name: 'Capacitor HTTP插件',
                        status: 'warning',
                        message: 'HTTP插件未加载，将使用fetch'
                    });
                }

                console.log('╔════════════════════════════════════════╗');
                console.log('║     网络连接全面诊断完成               ║');
                console.log('╚════════════════════════════════════════╝');
                console.table(results.tests);

                return results;
            }
        };

        // 页面加载完成后自动运行诊断
        window.addEventListener('load', function() {
            setTimeout(() => {
                window.__networkDiagnostics.runFullDiagnostics();
            }, 2000);
        });
    </script>

    <!-- 【CDN加载失败降级方案】-->
    <script>
        // 标记关键库加载状态
        window.__libsLoaded = {
            marked: false,
            localforage: false,
            papaparse: false,
            mathjax: false
        };

        // 降级方案：如果CDN加载失败，使用本地存储替代
        window.__storageFallback = {
            getItem: function(key) { return localStorage.getItem(key); },
            setItem: function(key, value) { localStorage.setItem(key, value); },
            removeItem: function(key) { localStorage.removeItem(key); },
            keys: function() { return Object.keys(localStorage); }
        };
    </script>

