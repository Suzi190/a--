        }

        .cute-cat-icon {
            font-size: 50px;
            margin-bottom: 10px;
            animation: catBounce 2s ease-in-out infinite;
        }

        @keyframes catBounce {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-5px); }
        }

        .fasting-intro-text {
            font-size: 14px;
            color: #666;
            line-height: 1.5;
        }

        /* 断食计划分区 */
        .fasting-section {
            margin-bottom: 25px;
        }

        .fasting-section-title {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 16px;
            font-weight: 700;
            color: #333;
            margin-bottom: 15px;
            padding-left: 5px;
        }

        .section-icon {
            font-size: 20px;
        }

        /* 断食卡片 */
        .fasting-cards {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 12px;
        }

        .fasting-cards-single {
            grid-template-columns: 1fr;
        }

        .fasting-card {
            background: white;
            border-radius: 18px;
            padding: 15px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
            cursor: pointer;
            transition: all 0.3s ease;
            border: 2px solid transparent;
        }

        .fasting-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(255, 107, 157, 0.2);
            border-color: #ffb6c1;
        }

        .fasting-card-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 10px;
        }

        .fasting-time {
            font-size: 20px;
            font-weight: 800;
            color: #ff6b9d;
        }

        .fasting-level {
            font-size: 11px;
            padding: 4px 10px;
            border-radius: 10px;
            font-weight: 600;
        }

        .fasting-level.easy {
            background: #d4edda;
            color: #155724;
        }

        .fasting-level.medium {
            background: #fff3cd;
            color: #856404;
        }

        .fasting-level.hard {
            background: #f8d7da;
            color: #721c24;
        }

        .fasting-card-body {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .fasting-desc {
            font-size: 12px;
            color: #666;
            line-height: 1.4;
        }

        .fasting-cat {
            font-size: 11px;
            color: #ff9eb5;
            font-weight: 500;
        }

        .fasting-schedule {
            display: flex;
            gap: 4px;
            margin: 5px 0;
        }

        .schedule-day {
            width: 24px;
            height: 24px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 10px;
            font-weight: 600;
        }

        .schedule-day.normal {
            background: #e8f5e9;
            color: #2e7d32;
        }

        .schedule-day.fast {
            background: #ffebee;
            color: #c62828;
        }
    </style>

    <!-- 专属定制页面脚本 -->
    <script>
        // 打开专属定制页面
        window.openCustomPlanPage = function() {
            const page = document.getElementById('customPlanPage');
            page.classList.add('active');
            document.body.style.overflow = 'hidden';
        };

        // 关闭专属定制页面
        window.closeCustomPlanPage = function() {
            const page = document.getElementById('customPlanPage');
            page.classList.remove('active');
            document.body.style.overflow = '';
        };

        // 打开计划封面上传
        window.openPlanImageUpload = function() {
            const input = document.createElement('input');
            input.type = 'file';
            input.accept = 'image/*';
            input.onchange = function(e) {
                const file = e.target.files[0];
                if (!file) return;
                
                const reader = new FileReader();
                reader.onload = function(event) {
                    const imageData = event.target.result;
                    
                    // 保存到 IndexedDB
                    saveNPCImage('plan_cover', imageData);
                    
                    // 更新显示
                    const container = document.getElementById('planImageContainer');
                    container.classList.add('has-image');
                    container.innerHTML = `<img src="${imageData}" alt="计划封面">`;
                    
                    showBodyManagerToast('计划封面上传成功！');
                };
                reader.readAsDataURL(file);
            };
            input.click();
        };

        // 加载计划封面
        async function loadPlanCover() {
            const cover = await getNPCImage('plan_cover');
            if (cover) {
                const container = document.getElementById('planImageContainer');
                container.classList.add('has-image');
                container.innerHTML = `<img src="${cover}" alt="计划封面">`;
            }
        }

        // 打开轻断食计划页面
        window.openFastingPlanPage = function() {
            const page = document.getElementById('fastingPlanPage');
            page.classList.add('active');
        };

        // 关闭轻断食计划页面
        window.closeFastingPlanPage = function() {
            const page = document.getElementById('fastingPlanPage');
            page.classList.remove('active');
        };

        // 选择断食计划 - 进入追踪页面
        window.selectFastingPlan = async function(planType) {
            // 保存选择的计划
            await localforage.setItem('bodyManager_selected_plan', {
                type: planType,
                name: planType,
                startDate: new Date().toISOString()
            });

            // 初始化断食状态
            currentFastingPlan = planType;
            isFasting = false;
            eatingStartTime = new Date();
            fastingStartTime = null;
            await saveFastingState();

            // 立即更新黑板显示
            updateBlackboardDisplay();
            updatePlanButton();

            // 显示提示
            showBodyManagerToast(`已选择 ${planType} 计划！`);

            // 关闭轻断食计划页面
            closeFastingPlanPage();
            closeCustomPlanPage();

            // 打开追踪页面
            setTimeout(() => {
                openFastingTracker(planType);
            }, 300);
        };

        // 打开定制计划详情页面
        window.openCustomPlanDetailPage = function() {
            openCustomFastingPlanPage();
        };

        // 页面加载时加载封面
        loadPlanCover();
    </script>

    <!-- ==================== 定制计划页面脚本 ==================== -->
    <script>
        // 当前选中的计划师
        let currentPlanner = null;

        // 打开定制计划页面
        window.openCustomFastingPlanPage = function() {
            const page = document.getElementById('customFastingPlanPage');
            page.classList.add('active');
            document.body.style.overflow = 'hidden';
            
            // 加载已保存的计划师
            loadSavedPlanner();
        };

        // 关闭定制计划页面
        window.closeCustomFastingPlanPage = function() {
            const page = document.getElementById('customFastingPlanPage');
            page.classList.remove('active');
            document.body.style.overflow = '';
        };

        // 加载已保存的计划师
        async function loadSavedPlanner() {
            const savedPlanner = await localforage.getItem('customFastingPlanner');
            if (savedPlanner) {
                currentPlanner = savedPlanner;
                updatePlannerDisplay();
                // 启用生成计划按钮
                enableGeneratePlanButton();
            }
            
            // 加载已保存的专属计划
            await loadSavedExclusivePlan();
            
            // 加载已保存的UP主推荐
            await loadSavedFitnessUPs();
        }
        
        // 启用生成计划按钮
        function enableGeneratePlanButton() {
            const btn = document.getElementById('generatePlanBtn');
            if (btn) {
                btn.disabled = false;
                btn.querySelector('.btn-text').textContent = '生成专属计划';
            }
        }
        
        // 加载已保存的专属计划
        async function loadSavedExclusivePlan() {
            const savedPlan = await localforage.getItem('customExclusivePlan');
            if (savedPlan && savedPlan.plannerId === currentPlanner?.id) {
                // 如果有保存的计划且计划师匹配，显示保存的计划
                renderSavedPlan(savedPlan);
            }
        }
        
        // 渲染保存的计划
        function renderSavedPlan(savedPlan) {
            const container = document.getElementById('exclusivePlanContainer');
            const plannerName = savedPlan.plannerName || currentPlanner?.name || '计划师';
            const plans = savedPlan.planData;
            
            container.innerHTML = `
                <div class="exclusive-plan-content">
                    <div class="plan-welcome">
                        <div class="plan-welcome-text">
                            <span class="plan-welcome-name">${plannerName}</span> 为你定制的专属计划
                            <span style="font-size: 12px; color: #999; margin-left: 10px;">(${new Date(savedPlan.timestamp).toLocaleDateString()}生成)</span>
                        </div>
                    </div>
                    <div class="plan-details">
                        <div class="plan-detail-item">
                            <div class="plan-detail-icon">⏰</div>
                            <div class="plan-detail-content">
                                <div class="plan-detail-title">断食时间</div>
                                <div class="plan-detail-desc">${plans.fastingTime}</div>
                            </div>
                        </div>
                        <div class="plan-detail-item">
                            <div class="plan-detail-icon">🍽️</div>
                            <div class="plan-detail-content">
                                <div class="plan-detail-title">饮食建议</div>
                                <div class="plan-detail-desc">${plans.dietAdvice}</div>
                            </div>
                        </div>
                        <div class="plan-detail-item">
                            <div class="plan-detail-icon">💪</div>
                            <div class="plan-detail-content">
                                <div class="plan-detail-title">运动配合</div>
                                <div class="plan-detail-desc">${plans.exercise}</div>
                            </div>
                        </div>
                        <div class="plan-detail-item">
                            <div class="plan-detail-icon">💡</div>
                            <div class="plan-detail-content">
                                <div class="plan-detail-title">特别提醒</div>
                                <div class="plan-detail-desc">${plans.tips}</div>
                            </div>
                        </div>
                    </div>
                    <button class="plan-action-btn" onclick="startCustomFastingPlan()">
                        开始执行计划
                    </button>
                </div>
            `;
        }
        
        // 保存专属计划
        async function saveExclusivePlan(planData) {
            const planToSave = {
                plannerId: currentPlanner?.id,
                plannerName: currentPlanner?.name,
                planData: planData,
                timestamp: new Date().toISOString()
            };
            await localforage.setItem('customExclusivePlan', planToSave);
        }
        
        // 加载已保存的UP主推荐
        async function loadSavedFitnessUPs() {
            const savedUPs = await localforage.getItem('customFitnessUPs');
            if (savedUPs && savedUPs.ups && savedUPs.ups.length > 0) {
                // 检查是否过期（7天）
                const savedTime = new Date(savedUPs.timestamp);
                const now = new Date();
                const daysDiff = (now - savedTime) / (1000 * 60 * 60 * 24);
                
                if (daysDiff < 7) {
                    // 未过期，显示保存的UP主
                    currentUPs = savedUPs.ups;
                    renderUPList(currentUPs);
                }
            }
        }
        
        // 保存UP主推荐
        async function saveFitnessUPs(ups) {
            const upsToSave = {
                ups: ups,
                timestamp: new Date().toISOString()
            };
            await localforage.setItem('customFitnessUPs', upsToSave);
        }

        // 打开计划师选择弹窗
        window.openPlannerSelection = function() {
            const modal = document.createElement('div');
            modal.className = 'planner-selection-modal';
            modal.id = 'plannerSelectionModal';
            
            // 获取所有可选择的角色（微信联系人 + NPC）
            let characters = [];
            
            // 添加微信联系人
            if (relationshipData.wechatChatList && relationshipData.wechatChatList.length > 0) {
                relationshipData.wechatChatList.forEach(char => {
                    characters.push({
                        id: char.id,
                        name: char.remark || char.name,
                        avatar: char.avatar,
                        type: 'wechat',
                        isGroup: char.isGroupChat
                    });
                });
            }
            
            // 添加NPC
            if (relationshipData.npcList && relationshipData.npcList.length > 0) {
                relationshipData.npcList.forEach(npc => {
                    characters.push({
                        id: `npc_${npc.id}`,
                        name: npc.name,
                        avatar: npc.avatar,
                        type: 'npc'
                    });
                });
            }
            
            // 生成角色列表HTML
            let charactersHTML = '';
            if (characters.length === 0) {
                charactersHTML = '<div style="text-align: center; padding: 40px; color: #999;">暂无角色，请先添加微信联系人或NPC</div>';
            } else {
                charactersHTML = characters.map(char => {
                    let avatarHTML = '👤';
                    if (char.avatar && (char.avatar.startsWith('http') || char.avatar.startsWith('data:'))) {
                        avatarHTML = `<img src="${char.avatar}" style="width: 100%; height: 100%; border-radius: 50%; object-fit: cover;">`;
                    } else if (char.avatar && char.avatar.length <= 2) {
                        avatarHTML = char.avatar;
                    }
                    
                    const typeLabel = char.type === 'npc' ? 'NPC' : (char.isGroup ? '群聊' : '联系人');
                    
                    return `
                        <div class="planner-list-item" onclick="selectPlanner('${char.id}', '${char.name}', '${char.avatar || ''}', '${char.type}')">
                            <div class="planner-list-avatar">${avatarHTML}</div>
                            <div class="planner-list-info">
                                <div class="planner-list-name">${char.name}</div>
                                <div class="planner-list-type">${typeLabel}</div>
                            </div>
                        </div>
                    `;
                }).join('');
            }
            
            modal.innerHTML = `
                <div class="planner-selection-content">
                    <div class="planner-selection-title">选择计划师 👤</div>
                    <div class="planner-list">
                        ${charactersHTML}
                    </div>
                    <div class="planner-list-actions">
                        <button class="planner-list-btn cancel" onclick="document.getElementById('plannerSelectionModal').remove()">取消</button>
                    </div>
                </div>
            `;
            
            modal.addEventListener('click', (e) => {
                if (e.target === modal) modal.remove();
            });
            
            document.body.appendChild(modal);
        };

        // 选择计划师
        window.selectPlanner = async function(charId, charName, charAvatar, charType) {
            const modal = document.getElementById('plannerSelectionModal');
            if (modal) modal.remove();
            
            // 保存选择的计划师
            currentPlanner = {
                id: charId,
                name: charName,
                avatar: charAvatar,
                type: charType
            };
            await localforage.setItem('customFastingPlanner', currentPlanner);
            
            // 更新显示
            updatePlannerDisplay();
            
            // 启用生成计划按钮
            enableGeneratePlanButton();
            
            showBodyManagerToast(`已选择计划师：${charName}，点击"生成专属计划"按钮开始制定计划`);
        };

        // 更新计划师显示
        function updatePlannerDisplay() {
            const container = document.getElementById('plannerCardsContainer');
            if (!currentPlanner) return;
            
            let avatarHTML = '👤';
            if (currentPlanner.avatar && (currentPlanner.avatar.startsWith('http') || currentPlanner.avatar.startsWith('data:'))) {
                avatarHTML = `<img src="${currentPlanner.avatar}" alt="${currentPlanner.name}">`;
            } else if (currentPlanner.avatar && currentPlanner.avatar.length <= 2) {
                avatarHTML = currentPlanner.avatar;
            }
            
            container.innerHTML = `
                <div class="planner-card selected" onclick="openPlannerSelection()">
                    <div class="planner-avatar">${avatarHTML}</div>
                    <div class="planner-name">${currentPlanner.name}</div>
                    <div class="planner-role">专属计划师</div>
                    <button class="planner-action-btn" onclick="event.stopPropagation(); generateExclusivePlan()">重新生成计划</button>
                </div>
                <div class="planner-card empty" onclick="openPlannerSelection()">
                    <div class="planner-avatar">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#87CEEB" stroke-width="2">
                            <path d="M12 5v14M5 12h14"/>
                        </svg>
                    </div>
                    <div class="planner-name">更换</div>
                    <div class="planner-role">点击更换</div>
                    <button class="planner-action-btn" onclick="event.stopPropagation(); openPlannerSelection()">申请定制计划</button>
                </div>
            `;
        }

        // 生成专属计划
        async function generateExclusivePlan() {
            if (!currentPlanner) return;
            
            const container = document.getElementById('exclusivePlanContainer');
            const plannerName = currentPlanner.name;
            
            // 显示加载状态
            container.innerHTML = `
                <div class="exclusive-plan-empty">
                    <div class="empty-icon">⏳</div>
                    <div class="empty-text">AI正在根据你的情况制定专属计划...</div>
                </div>
            `;
            
            // 收集所有数据
            const userData = await collectUserData();
            
            // 生成AI提示词
            const aiPrompt = generateAIPrompt(userData, plannerName);
            
            // 调用AI生成计划（这里使用模拟数据，实际应调用AI接口）
            const plans = await callAIGeneratePlan(aiPrompt, userData, plannerName);
            
            // 保存生成的计划
            await saveExclusivePlan(plans);
            
            // 显示计划（带生成时间）
            renderSavedPlan({
                plannerName: plannerName,
                planData: plans,
                timestamp: new Date().toISOString()
            });
        }

        // 收集用户数据
        async function collectUserData() {
            const userData = {
                // 计划师信息
                planner: currentPlanner,
                
                // 我的信息（从微信列表找"我"的角色）
                myProfile: null,
                myMemories: [],
                
                // 体重数据
                weight: null,
                targetWeight: null,
                
                // 饮食目标和当前情况
                dietGoals: '',
                dietSituation: '',
                
                // 上下文记忆
                recentContext: [],
                
                // 对方（计划师）信息
                plannerProfile: null,
                plannerMemories: []
            };
            
            // 1. 获取"我"的人设和长期记忆
            // 在微信列表中找备注为"我"或名字包含"我"的联系人
            if (relationshipData.wechatChatList) {
                const meContact = relationshipData.wechatChatList.find(c => 
                    c.remark === '我' || c.name === '我' || c.remark?.includes('我') || c.name?.includes('我')
                );
                
                if (meContact) {
                    userData.myProfile = {
                        name: meContact.name,
                        remark: meContact.remark,
                        personality: meContact.personality || '暂无设定'
                    };
                    
                    // 获取长期记忆（最近5条）
                    if (meContact.memories && Array.isArray(meContact.memories)) {
                        userData.myMemories = meContact.memories.slice(-5).map(m => m.content || m);
                    }
                    
                    // 获取最近10条上下文（从聊天记录）
                    if (relationshipData.chatMessages) {
                        const myMessages = relationshipData.chatMessages
                            .filter(m => m.chatId === meContact.id)
                            .slice(-10);
                        userData.recentContext = myMessages.map(m => ({
                            role: m.role || 'assistant',
                            content: m.content,
                            timestamp: m.timestamp
                        }));
                    }
                }
            }
            
            // 1.5 获取"对方"（计划师）的人设和长期记忆
            if (currentPlanner && relationshipData.wechatChatList) {
                // 根据计划师ID查找对应的联系人
                const plannerContact = relationshipData.wechatChatList.find(c => 
                    c.id === currentPlanner.id || c.id === currentPlanner.id?.replace('npc_', '')
                );
                
                if (plannerContact) {
                    userData.plannerProfile = {
                        name: plannerContact.name,
                        remark: plannerContact.remark,
                        personality: plannerContact.personality || '暂无设定'
                    };
                    
                    // 获取对方的长期记忆（最近5条）
                    if (plannerContact.memories && Array.isArray(plannerContact.memories)) {
                        userData.plannerMemories = plannerContact.memories.slice(-5).map(m => m.content || m);
                    }
                }
            }
            
            // 2. 获取体重数据
            try {
                const waterData = await loadHealthDataUnified('waterData');
                if (waterData) {
                    userData.weight = waterData.weight || 50;
                    // 目标体重默认设为当前体重的90%或根据健康标准
                    userData.targetWeight = waterData.targetWeight || Math.round(userData.weight * 0.9);
                }
            } catch (e) {
                console.log('获取体重数据失败:', e);
            }
            
            // 3. 获取饮食目标和当前情况
            try {
                const recipeInfo = await localforage.getItem('recipe_cooking_info');
                if (recipeInfo) {
                    userData.dietGoals = recipeInfo.goals || '';
                    userData.dietSituation = recipeInfo.situation || '';
                }
            } catch (e) {
                console.log('获取饮食数据失败:', e);
            }
            
            return userData;
        }

        // 生成AI提示词
        function generateAIPrompt(userData, plannerName) {
            const { myProfile, myMemories, weight, targetWeight, dietGoals, dietSituation, recentContext, plannerProfile, plannerMemories } = userData;
            
            let prompt = `请为以下用户制定一个专属的健身计划，包括断食时间、运动配合、饮食建议、特别提醒。

【计划制定者】${plannerName}
`;

            // 添加对方（计划师）的人设
            if (plannerProfile) {
                prompt += `
【对方人设】（计划制定者）
- 名字：${plannerProfile.remark || plannerProfile.name}
`;
                if (plannerProfile.personality && plannerProfile.personality !== '暂无设定') {
                    prompt += `- 人设：${plannerProfile.personality}
`;
                }
            }
            
            // 添加对方的长期记忆
            if (plannerMemories && plannerMemories.length > 0) {
                prompt += `
【对方长期记忆（最近5条）】
`;
                plannerMemories.forEach((memory, index) => {
                    prompt += `${index + 1}. ${memory}
`;
                });
            }
            
            prompt += `
【用户信息】
`;

            // 添加我的人设
            if (myProfile) {
                prompt += `- 我的名字：${myProfile.remark || myProfile.name}
`;
                if (myProfile.personality && myProfile.personality !== '暂无设定') {
                    prompt += `- 我的人设：${myProfile.personality}
`;
                }
            }
            
            // 添加我的长期记忆
            if (myMemories && myMemories.length > 0) {
                prompt += `
【我的长期记忆（最近5条）】
`;
                myMemories.forEach((memory, index) => {
                    prompt += `${index + 1}. ${memory}
`;
                });
            }
            
            // 添加上下文
            if (recentContext && recentContext.length > 0) {
                prompt += `
【最近对话上下文（最近10条）】
`;
                recentContext.forEach((msg, index) => {
                    const role = msg.role === 'user' ? '我' : '对方';
                    prompt += `${role}: ${msg.content}
`;
                });
            }
            
            // 添加体重数据
            if (weight) {
                prompt += `
【体重数据】
- 当前体重：${weight}kg
- 目标体重：${targetWeight}kg
- 需减重：${weight - targetWeight}kg
`;
            }
            
            // 添加饮食目标和当前情况
            if (dietGoals || dietSituation) {
                prompt += `
【饮食信息】
`;
                if (dietGoals) {
                    prompt += `- 饮食目标：${dietGoals}
`;
                }
                if (dietSituation) {
                    prompt += `- 当前情况：${dietSituation}
`;
                }
            }
            
            prompt += `
请根据以上信息，制定一个个性化的健身计划。要求：
1. 断食时间要适合用户的体重目标和当前情况
2. 饮食建议要结合用户的饮食目标和当前情况
3. 运动配合要考虑用户的体重和减重目标
4. 特别提醒要基于用户的长期记忆和上下文
5. 语气要亲切，像${plannerName}在对我说话一样

请以JSON格式返回：
{
  "fastingTime": "断食时间建议",
  "dietAdvice": "饮食建议",
  "exercise": "运动配合建议",
  "tips": "特别提醒"
}`;

            console.log('【AI提示词】', prompt);
            return prompt;
        }

        // 调用AI生成计划（使用真实API）
        async function callAIGeneratePlan(aiPrompt, userData, plannerName) {
            try {
                // 加载API设置
                const savedSettings = await loadAppSettings({});
                const apiKey = savedSettings.api?.apiKey || '';
                const baseUrl = savedSettings.api?.baseUrl || 'https://api.openai.com/v1';
                const model = savedSettings.api?.model || 'gpt-3.5-turbo';
                const apiTemperature = savedSettings.api?.temperature ?? 0.7;
                
                if (!apiKey) {
                    throw new Error('请先在"呼叫爱人"设置中配置API地址和密钥');
                }
                
                console.log('【生成计划】调用AI API:', baseUrl);
                console.log('【生成计划】模型:', model);
                
                // 添加系统提示词
                const systemPrompt = `你是一位专业的健身教练和营养师，擅长根据用户的个人情况制定个性化的健身计划。请根据提供的信息，制定一个详细、实用、个性化的健身计划。语气要亲切友好，像一位贴心的朋友在给出建议。`;
                
                // 添加超时处理
                const controller = new AbortController();
                const timeoutId = setTimeout(() => controller.abort(), 300000); // 【统一】300秒超时
                
                const response = await fetch(`${baseUrl}/chat/completions`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${apiKey}`
                    },
                    body: JSON.stringify({
                        model: model,
                        messages: [
                            {
                                role: 'system',
                                content: systemPrompt
                            },
                            {
                                role: 'user',
                                content: aiPrompt
                            }
                        ],
                        temperature: apiTemperature,
                        max_tokens: 2000
                    }),
                    signal: controller.signal
                });
                
                clearTimeout(timeoutId);
                
                if (!response.ok) {
                    const errorText = await response.text();
                    throw new Error(`API请求失败: ${response.status} ${response.statusText} - ${errorText}`);
                }
                
                // 解析API响应
                let data;
                try {
                    const responseText = await response.text();
                    if (!responseText || responseText.trim() === '') {
                        throw new Error('API返回空响应');
                    }
                    data = JSON.parse(responseText);
                } catch (parseError) {
                    console.error('【生成计划】API响应JSON解析失败:', parseError);
                    throw new Error('API响应JSON解析失败: ' + parseError.message);
                }
                
                if (!data.choices || !data.choices[0] || !data.choices[0].message) {
                    throw new Error('API返回数据异常');
                }
                
                const content = data.choices[0].message.content;
                console.log('【生成计划】AI返回内容:', content);
                
                // 尝试解析JSON格式的计划
                let plan;
                try {
                    // 尝试直接解析JSON
                    plan = JSON.parse(content);
                } catch (e) {
                    // 如果不是纯JSON，尝试提取JSON部分
                    const jsonMatch = content.match(/\{[\s\S]*\}/);
                    if (jsonMatch) {
                        try {
                            plan = JSON.parse(jsonMatch[0]);
                        } catch (e2) {
                            // 提取失败，使用文本解析
                            plan = parsePlanFromText(content);
                        }
                    } else {
                        plan = parsePlanFromText(content);
                    }
                }
                
                // 确保所有字段都存在
                plan.fastingTime = plan.fastingTime || '16:8 轻断食模式 - 每天16小时断食，8小时进食窗口';
                plan.dietAdvice = plan.dietAdvice || '进食期间以高蛋白、低碳水为主，多吃蔬菜和优质脂肪';
                plan.exercise = plan.exercise || '断食期间可进行轻度有氧运动，进食后1小时再进行力量训练';
                plan.tips = plan.tips || '多喝水，可以喝黑咖啡或茶。如果感到头晕，请适当补充电解质';
                plan.greeting = `${plannerName}根据你的情况，为你制定了以下专属计划，让我们一起努力吧！`;
                
                return plan;
                
            } catch (error) {
                console.error('【生成计划】API调用失败:', error);
                showBodyManagerToast('AI生成计划失败: ' + error.message);
                
                // 返回默认计划作为fallback
                return generateFallbackPlan(userData, plannerName);
            }
        }
        
        // 从文本中解析计划（当AI返回非JSON格式时使用）
        function parsePlanFromText(text) {
            const plan = {
                fastingTime: '',
                dietAdvice: '',
                exercise: '',
                tips: ''
            };
            
            // 尝试提取各个部分
            const fastingMatch = text.match(/断食时间[：:]\s*([^\n]+)/i);
            if (fastingMatch) plan.fastingTime = fastingMatch[1].trim();
            
            const dietMatch = text.match(/饮食建议[：:]\s*([^\n]+)/i);
            if (dietMatch) plan.dietAdvice = dietMatch[1].trim();
            
            const exerciseMatch = text.match(/运动配合[：:]\s*([^\n]+)/i);
            if (exerciseMatch) plan.exercise = exerciseMatch[1].trim();
            
            const tipsMatch = text.match(/特别提醒[：:]\s*([^\n]+)/i);
            if (tipsMatch) plan.tips = tipsMatch[1].trim();
            
            // 如果没有匹配到，使用整个文本作为tips
            if (!plan.fastingTime && !plan.dietAdvice && !plan.exercise) {
                plan.tips = text.substring(0, 200);
            }
            
            return plan;
        }
        
        // 生成默认计划（API失败时的fallback）
        function generateFallbackPlan(userData, plannerName) {
            const { weight, targetWeight, dietGoals, dietSituation, myMemories } = userData;
            const weightDiff = weight && targetWeight ? weight - targetWeight : 0;
            
            let plan = {
                fastingTime: '16:8 轻断食模式 - 每天16小时断食，8小时进食窗口（12:00-20:00进食）',
                dietAdvice: '进食期间以高蛋白、低碳水为主，多吃蔬菜和优质脂肪，避免精制糖和油炸食品',
                exercise: '断食期间可进行轻度有氧运动如快走，进食后1小时再进行力量训练',
                tips: '多喝水，可以喝黑咖啡或茶。如果感到头晕，请适当补充电解质',
                greeting: `${plannerName}为你制定了以下专属计划（默认方案），让我们一起努力吧！`
            };
            
            // 根据体重数据调整
            if (weightDiff > 10) {
                plan.fastingTime = '18:6 进阶断食 - 每天18小时断食，6小时进食窗口（12:00-18:00进食）';
                plan.dietAdvice += '。建议控制每日热量摄入在1200-1500千卡之间';
                plan.exercise = '每天45分钟有氧运动（快走/慢跑/跳绳），每周3次力量训练';
            } else if (weightDiff > 0) {
                plan.fastingTime = '16:8 标准断食 - 每天16小时断食，8小时进食窗口（11:00-19:00进食）';
                plan.dietAdvice += '。建议控制每日热量摄入在1500-1800千卡之间';
            }
            
            // 根据饮食目标调整
            if (dietGoals) {
                if (dietGoals.includes('减脂') || dietGoals.includes('减肥')) {
                    plan.dietAdvice = '严格控制碳水化合物摄入，增加蛋白质比例，多吃绿叶蔬菜，晚餐尽量清淡';
                    plan.exercise += '，空腹有氧燃脂效果更佳';
                } else if (dietGoals.includes('增肌')) {
                    plan.fastingTime = '14:10 温和断食 - 每天14小时断食，10小时进食窗口（8:00-18:00进食）';
                    plan.dietAdvice = '保证充足的蛋白质摄入（每公斤体重1.5-2g），训练后及时补充碳水';
                    plan.exercise = '以力量训练为主，每周4-5次，配合适量有氧';
                }
            }
            
            return plan;
        }

        // 开始执行定制计划
        window.startCustomFastingPlan = async function() {
            if (!currentPlanner) {
                showBodyManagerToast('请先选择计划师');
                return;
            }
            
            // 保存计划信息
            const customPlan = {
                type: 'custom',
                name: `${currentPlanner.name}的定制计划`,
                planner: currentPlanner,
                startDate: new Date().toISOString()
            };
            await localforage.setItem('bodyManager_selected_plan', customPlan);
            
            // 初始化断食状态
            currentFastingPlan = '16-8'; // 默认使用16:8模式
            isFasting = false;
            eatingStartTime = new Date();
            fastingStartTime = null;
            await saveFastingState();
            
            showBodyManagerToast(`已开始 ${currentPlanner.name} 的定制计划！`);
            
            // 关闭页面并打开追踪页面
            closeCustomFastingPlanPage();
            closeCustomPlanPage();
            
            setTimeout(() => {
                openFastingTracker('16-8');
            }, 300);
        };

        // ==================== AI推荐健身UP主功能 ====================
        
        // 当前UP主列表
        let currentUPs = [];
        let upSearchKeywords = ['健身', '减肥', '运动', 'HIIT', '瑜伽', '普拉提'];
        let currentKeywordIndex = 0;

        // 加载健身UP主
        window.loadFitnessUPs = async function() {
            const container = document.getElementById('fitnessUPContainer');
            container.innerHTML = `
                <div class="fitness-video-empty">
                    <div class="empty-icon">⏳</div>
                    <div class="empty-text">AI正在为您推荐优质健身UP主...</div>
                </div>
            `;
            
            try {
                // 根据计划师选择不同的搜索词
                const keyword = getSmartKeyword();
                const ups = await searchBilibiliUPs(keyword);
                
                if (ups && ups.length > 0) {
                    currentUPs = ups;
                    renderUPList(ups);
                    // 保存UP主推荐
                    await saveFitnessUPs(ups);
                } else {
                    container.innerHTML = `
                        <div class="fitness-video-empty">
                            <div class="empty-icon">😅</div>
                            <div class="empty-text">暂时没有找到相关UP主，请稍后再试</div>
                            <button class="load-videos-btn" onclick="loadFitnessUPs()">重新加载</button>
                        </div>
                    `;
                }
            } catch (error) {
                console.error('加载UP主失败:', error);
                container.innerHTML = `
                    <div class="fitness-video-empty">
                        <div class="empty-icon">😅</div>
                        <div class="empty-text">加载UP主失败，请检查网络连接</div>
                        <button class="load-videos-btn" onclick="loadFitnessUPs()">重新加载</button>
                    </div>
                `;
            }
        };

        // 刷新UP主列表
        window.refreshFitnessUPs = function() {
            currentKeywordIndex = (currentKeywordIndex + 1) % upSearchKeywords.length;
            loadFitnessUPs();
        };

        // 获取智能搜索关键词
        function getSmartKeyword() {
            // 如果有计划师，根据计划师特点选择关键词
            if (currentPlanner) {
                const name = currentPlanner.name;
                // 根据名字特点选择不同的运动类型
                if (name.includes('猫') || name.includes('萌') || name.includes('软')) {
                    return '瑜伽';
                } else if (name.includes('虎') || name.includes('猛') || name.includes('强')) {
                    return 'HIIT';
                } else if (name.includes('仙') || name.includes('美') || name.includes('雅')) {
                    return '普拉提';
                }
            }
            return upSearchKeywords[currentKeywordIndex];
        }

        // 搜索B站UP主
        async function searchBilibiliUPs(keyword) {
            // 使用B站搜索API搜索UP主
            const searchUrl = `https://api.bilibili.com/x/web-interface/search/type?keyword=${encodeURIComponent(keyword + ' 健身')}&search_type=bili_user&page=1&pagesize=6&order=fans`;
            
            try {
                // 尝试直接调用B站API
                const response = await fetch(searchUrl, {
                    method: 'GET',
                    headers: {
                        'Accept': 'application/json',
                        'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36'
                    }
                });
                
                if (!response.ok) {
                    throw new Error(`API请求失败: ${response.status}`);
                }
                
                const data = await response.json();
                
                if (data.code !== 0 || !data.data || !data.data.result) {
                    throw new Error('API返回数据异常');
                }
                
                // 解析B站UP主数据
                const ups = data.data.result.map(item => ({
                    mid: item.mid,
                    name: item.uname,
                    desc: item.usign || '暂无简介',
                    avatar: item.upic.startsWith('http') ? item.upic : `https:${item.upic}`,
                    fans: item.fans || 0,
                    tag: 'AI推荐'
                }));
                
                return ups.slice(0, 6); // 只返回前6个
                
            } catch (error) {
                console.error('【B站API】搜索UP主失败:', error);
                console.log('【B站API】切换到备用方案 - 使用知名健身UP主列表');
                // 如果API调用失败，使用预定义的知名健身UP主列表
                return getRealFitnessUPs(keyword);
            }
        }
        
        // 获取知名健身UP主列表（使用真实的mid）
        function getRealFitnessUPs(keyword) {
            // 这些是知名的B站健身UP主，使用真实的mid
            const upDatabase = {
