                        font-size: 40px;
                        margin-bottom: 10px;
                    }
                    .npc-upload-text {
                        font-size: 14px;
                        color: #666;
                    }
                    .npc-upload-hint {
                        font-size: 12px;
                        color: #999;
                        margin-top: 8px;
                    }
                    .npc-upload-close {
                        padding: 12px 30px;
                        background: #f5f5f5;
                        border: none;
                        border-radius: 20px;
                        font-size: 14px;
                        color: #666;
                        cursor: pointer;
                        transition: all 0.3s ease;
                    }
                    .npc-upload-close:hover {
                        background: #eee;
                    }
                    @keyframes fadeIn {
                        from { opacity: 0; }
                        to { opacity: 1; }
                    }
                    @keyframes slideUp {
                        from { transform: translateY(30px); opacity: 0; }
                        to { transform: translateY(0); opacity: 1; }
                    }
                </style>
                <div class="npc-upload-content">
                    <div class="npc-upload-title">设置${npcNames[npcType]}形象</div>
                    <div class="npc-upload-subtitle">长按人物即可更换图片</div>
                    <div class="npc-upload-area" onclick="document.getElementById('npcFileInput_${npcType}').click()">
                        <div class="npc-upload-icon">📷</div>
                        <div class="npc-upload-text">点击上传图片</div>
                        <div class="npc-upload-hint">支持透明背景PNG</div>
                    </div>
                    <input type="file" id="npcFileInput_${npcType}" accept="image/*" style="display: none;" onchange="handleNPCImageUpload(this, '${npcType}')">
                    <button class="npc-upload-close" onclick="this.closest('.npc-upload-modal').remove()">取消</button>
