                        chatSettingsPage.style.display = 'flex';
                        loadChatSettings();
                        if (typeof updateWorldbookCardFromData === 'function') {
                            updateWorldbookCardFromData();
                        }
                    }
                }
            } catch (error) {
                showCustomAlert('错误', '打开聊天设置时出错: ' + error.message, 'error');
            }
        }

