            // 打开邮局页面
            window.openPostOffice = function() {
                const postOfficePage = document.getElementById('postOfficePage');
                postOfficePage.classList.add('active');
                document.body.style.overflow = 'hidden';
            };

            // 关闭邮局页面
            window.closePostOffice = function() {
                const postOfficePage = document.getElementById('postOfficePage');
                postOfficePage.classList.remove('active');
                document.body.style.overflow = '';
            };

            // 打开信件内容页面
            window.openLetterContent = function() {
                const letterContentPage = document.getElementById('letterContentPage');
                letterContentPage.classList.add('active');
                document.body.style.overflow = 'hidden';
            };

            // 关闭信件内容页面
            window.closeLetterContent = function() {
                const letterContentPage = document.getElementById('letterContentPage');
                letterContentPage.classList.remove('active');
                document.body.style.overflow = '';
            };

            // 打开信件格子页面
            window.openLetterGridPage = function() {
                const letterGridPage = document.getElementById('letterGridPage');
                const flyingEnvelope = document.getElementById('flyingEnvelope');
                const letterBtn1 = document.getElementById('letterBtn1');
                
                // 计算按钮位置作为动画起点
                const btnRect = letterBtn1.getBoundingClientRect();
                const centerX = window.innerWidth / 2;
                const centerY = window.innerHeight / 2;
                const startX = btnRect.left + btnRect.width / 2 - centerX;
                const startY = btnRect.top + btnRect.height / 2 - centerY;
                
                // 设置CSS变量
                flyingEnvelope.style.setProperty('--start-x', startX + 'px');
                flyingEnvelope.style.setProperty('--start-y', startY + 'px');
                flyingEnvelope.style.left = centerX + 'px';
                flyingEnvelope.style.top = centerY + 'px';
                
                // 显示页面
                letterGridPage.classList.add('active');
                document.body.style.overflow = 'hidden';
                
                // 触发动画
                setTimeout(() => {
                    flyingEnvelope.classList.add('fly-to-center');
                    
                    // 动画结束后隐藏飞行信封并生成格子
                    setTimeout(() => {
                        flyingEnvelope.classList.remove('fly-to-center');
                        generateLetterGrid();
                    }, 1000);
                }, 100);
            };

            // 关闭信件格子页面
            window.closeLetterGridPage = function() {
                const letterGridPage = document.getElementById('letterGridPage');
                letterGridPage.classList.remove('active');
                document.body.style.overflow = '';

                // 清空格子
                const container = document.getElementById('letterGridContainer');
                container.innerHTML = '';

                // 退出编辑模式
                exitLetterEditMode();
            };

            // 信件编辑模式状态
            let isLetterEditMode = false;

            // 切换信件编辑模式
            window.toggleLetterEditMode = function() {
                isLetterEditMode = !isLetterEditMode;
                const editBtn = document.getElementById('letterEditBtn');
                const gridItems = document.querySelectorAll('.letter-grid-item.has-letter');

                if (isLetterEditMode) {
                    // 进入编辑模式
                    editBtn.textContent = '✓ 完成';
                    editBtn.classList.add('active');
                    gridItems.forEach(item => item.classList.add('editing'));
                } else {
                    // 退出编辑模式
                    exitLetterEditMode();
                }
            };

            // 退出信件编辑模式
            function exitLetterEditMode() {
                isLetterEditMode = false;
                const editBtn = document.getElementById('letterEditBtn');
                if (editBtn) {
                    editBtn.textContent = '✏️ 编辑信件';
                    editBtn.classList.remove('active');
                }
                const gridItems = document.querySelectorAll('.letter-grid-item.editing');
                gridItems.forEach(item => item.classList.remove('editing'));
            }

            // 删除信件
            window.deleteLetter = function(event, slotIndex) {
                event.stopPropagation();

                // 确认删除
                if (!confirm('确定要删除这封信件吗？删除后无法恢复。')) {
                    return;
                }

                try {
                    // 获取信件数据
                    let letters = JSON.parse(localStorage.getItem('aiLetters') || '[]');

                    // 找到并删除指定信件
                    const letterIndex = letters.findIndex(l => l.slotIndex === slotIndex);
                    if (letterIndex !== -1) {
                        letters.splice(letterIndex, 1);

                        // 保存到本地存储
                        localStorage.setItem('aiLetters', JSON.stringify(letters));

                        // 刷新格子显示
                        generateLetterGrid();

                        // 如果还在编辑模式，重新添加编辑样式
                        if (isLetterEditMode) {
                            const gridItems = document.querySelectorAll('.letter-grid-item.has-letter');
                            gridItems.forEach(item => item.classList.add('editing'));
                        }

                        showToast('信件已删除');
                    }
                } catch (error) {
                    console.error('删除信件失败:', error);
                    showToast('删除失败，请重试');
                }
            };

            // 生成信件格子 - 支持无限信件，使用虚拟滚动优化
            function generateLetterGrid() {
                const container = document.getElementById('letterGridContainer');
                container.innerHTML = '';

                // 获取信件数据
                const letters = JSON.parse(localStorage.getItem('aiLetters') || '[]');

                // 计算需要的格子数：信件数量 + 4个空格子（用于添加新信件）
                // 最少显示8个格子（2行），无上限
                const letterCount = letters.length;
                let totalSlots = Math.max(8, letterCount + 4);
                // 确保是4的倍数（整齐排列）
                totalSlots = Math.ceil(totalSlots / 4) * 4;

                // 按slotIndex排序信件
                letters.sort((a, b) => a.slotIndex - b.slotIndex);

                // 使用文档片段优化性能
                const fragment = document.createDocumentFragment();

                for (let i = 0; i < totalSlots; i++) {
                    const gridItem = document.createElement('div');
                    gridItem.className = 'letter-grid-item';
                    gridItem.dataset.index = i;

                    const letter = letters.find(l => l.slotIndex === i);

                    if (letter) {
                        // 有信件
                        gridItem.classList.add('has-letter');
                        gridItem.innerHTML = `
                            <img src="https://s41.ax1x.com/2026/02/16/pZLLVbQ.png" class="grid-item-envelope" alt="信件">
                            <span class="long-press-hint">长按查看</span>
                            <button class="letter-delete-btn" onclick="deleteLetter(event, ${letter.slotIndex})" title="删除信件">×</button>
                        `;
                        // 点击显示日期（编辑模式下不触发）
                        gridItem.onclick = (e) => {
                            if (!gridItem.classList.contains('editing')) {
                                showLetterDate(letter);
                            }
                        };
                        // 长按0.3秒查看内容（编辑模式下不触发）
                        addLongPressHandler(gridItem, letter);
                    } else {
                        // 空格子
                        gridItem.innerHTML = '<span class="grid-item-empty">未存信件</span>';
                        gridItem.onclick = () => showEmptySlot();
                    }

                    fragment.appendChild(gridItem);
                }

                // 一次性添加到容器，提高性能
                container.appendChild(fragment);
            }

            // 显示信件日期
            function showLetterDate(letter) {
                const dateBar = document.getElementById('letterDateBar');
                const dateText = dateBar.querySelector('.letter-date-text');

                const date = new Date(letter.date);
                const dateStr = `${date.getFullYear()}年${date.getMonth() + 1}月${date.getDate()}日`;

                // 优先使用自定义节日，否则自动检测
                const festival = letter.festival || getFestival(date);
                const event = letter.event || '';

                let html = dateStr;
                if (festival) {
                    html += `<span class="festival">${festival}</span>`;
                }
                if (event) {
                    html += `<span class="event">${event}</span>`;
                }

                dateText.innerHTML = html;
            }

            // 显示空格子提示
            function showEmptySlot() {
                const dateBar = document.getElementById('letterDateBar');
                const dateText = dateBar.querySelector('.letter-date-text');
                dateText.textContent = '暂无信件';
            }

            // 长按处理函数 - 0.3秒后查看信件内容（带滑动检测）
            function addLongPressHandler(element, letter) {
                let pressTimer;
                let isLongPress = false;
                let startX = 0;
                let startY = 0;
                const longPressDuration = 300; // 0.3秒
                const moveThreshold = 10; // 移动阈值（超过此值视为滑动）

                // 开始按压
                const startPress = (e) => {
                    isLongPress = false;
                    // 记录起始位置
                    if (e.touches && e.touches[0]) {
                        startX = e.touches[0].clientX;
                        startY = e.touches[0].clientY;
                    } else if (e.clientX !== undefined) {
                        startX = e.clientX;
                        startY = e.clientY;
                    }

                    pressTimer = setTimeout(() => {
                        isLongPress = true;
                        showLetterPaperModal(letter);
                    }, longPressDuration);
                };

                // 检测移动
                const checkMove = (e) => {
                    if (!pressTimer) return;

                    let currentX, currentY;
                    if (e.touches && e.touches[0]) {
                        currentX = e.touches[0].clientX;
                        currentY = e.touches[0].clientY;
                    } else if (e.clientX !== undefined) {
                        currentX = e.clientX;
                        currentY = e.clientY;
                    } else {
                        return;
                    }

                    // 计算移动距离
                    const deltaX = Math.abs(currentX - startX);
                    const deltaY = Math.abs(currentY - startY);

                    // 如果移动超过阈值，取消长按
                    if (deltaX > moveThreshold || deltaY > moveThreshold) {
                        clearTimeout(pressTimer);
                        pressTimer = null;
                    }
                };

                // 结束按压
                const endPress = (e) => {
                    if (pressTimer) {
                        clearTimeout(pressTimer);
                        pressTimer = null;
                    }
                };

                // 触摸事件
                element.addEventListener('touchstart', startPress, { passive: true });
                element.addEventListener('touchmove', checkMove, { passive: true });
                element.addEventListener('touchend', endPress);
                element.addEventListener('touchcancel', endPress);

                // 鼠标事件
                element.addEventListener('mousedown', startPress);
                element.addEventListener('mousemove', checkMove);
                element.addEventListener('mouseup', endPress);
                element.addEventListener('mouseleave', endPress);

                // 阻止右键菜单
                element.addEventListener('contextmenu', (e) => {
                    e.preventDefault();
                });
            }

            // 打开信纸弹窗
            window.showLetterPaperModal = function(letter) {
                const modal = document.getElementById('letterPaperModal');
                const textContainer = document.getElementById('letterPaperText');

                // 获取作者字体
                let authorFont = '';
                let authorName = letter.authorName || '未知角色';

                if (letter.authorId) {
                    // 从聊天列表查找作者信息
                    const chatItem = relationshipData.wechatChatList.find(c => c.id === letter.authorId);
                    if (chatItem && chatItem.letterFont) {
                        authorFont = chatItem.letterFont;
                    }
                }

                // 处理字体设置
                let finalFont = authorFont || "'PING FANG CHANG AN', 'Microsoft YaHei', sans-serif";
                
                if (authorFont) {
                    // 检查是否是 URL|字体名 格式
                    if (authorFont.includes('|')) {
                        const parts = authorFont.split('|');
                        const fontUrl = parts[0].trim();
                        const fontFamily = parts[1].trim();
                        
                        if (fontUrl.startsWith('http://') || fontUrl.startsWith('https://')) {
                            // 动态加载字体CSS
                            const linkId = 'letter-font-' + letter.authorId;
                            let existingLink = document.getElementById(linkId);
                            if (!existingLink) {
                                const link = document.createElement('link');
                                link.id = linkId;
                                link.rel = 'stylesheet';
                                link.href = fontUrl;
                                document.head.appendChild(link);
                            }
                            finalFont = `"${fontFamily}", 'PING FANG CHANG AN', 'Microsoft YaHei', sans-serif`;
                        }
                    }
                    // 检查是否是纯URL（字体链接）
                    else if (authorFont.startsWith('http://') || authorFont.startsWith('https://')) {
                        // 尝试从Google Fonts URL中提取字体名
                        let fontFamily = '';
                        if (authorFont.includes('fonts.googleapis.com') && authorFont.includes('family=')) {
                            const match = authorFont.match(/family=([^&:]+)/);
                            if (match) {
                                fontFamily = match[1].replace(/\+/g, ' ');
                            }
                        }
                        
                        // 动态加载字体CSS
                        const linkId = 'letter-font-' + letter.authorId;
                        let existingLink = document.getElementById(linkId);
                        if (!existingLink) {
                            const link = document.createElement('link');
                            link.id = linkId;
                            link.rel = 'stylesheet';
                            link.href = authorFont;
                            document.head.appendChild(link);
                        }
                        
                        if (fontFamily) {
                            finalFont = `"${fontFamily}", 'PING FANG CHANG AN', 'Microsoft YaHei', sans-serif`;
                        } else {
                            finalFont = "'Custom Letter Font', 'PING FANG CHANG AN', 'Microsoft YaHei', sans-serif";
                        }
                    }
                    // 否则直接使用CSS字体族
                    else {
                        finalFont = authorFont;
                    }
                }

                // 设置字体样式
                textContainer.style.fontFamily = finalFont;

                // 设置信件内容（带作者名字）
                const content = letter.content || '（无内容）';
                textContainer.innerHTML = `<div class="letter-author-name">—— ${authorName}</div><div class="letter-content-text">${content}</div>`;

                // 应用自定义信纸背景
                applyLetterPaperBackground();

                // 显示弹窗
                modal.classList.add('active');
            };

            // 关闭信纸弹窗
            window.closeLetterPaperModal = function() {
                const modal = document.getElementById('letterPaperModal');
                modal.classList.remove('active');
            };

            // 显示信件全文（用于信件卡片点击查看）
            window.showFullLetterContent = async function(title, content) {
                const modal = document.getElementById('letterPaperModal');
                const textContainer = document.getElementById('letterPaperText');
                
                // 应用信纸背景
                await applyLetterPaperBackground();
                
                // 设置字体样式（使用默认字体）
                textContainer.style.fontFamily = "'PING FANG CHANG AN', 'Microsoft YaHei', sans-serif";
                
                // 设置信件内容（带标题）
                textContainer.innerHTML = `<div class="letter-author-name">—— ${title}</div><div class="letter-content-text">${content}</div>`;
                
                // 显示弹窗
                modal.classList.add('active');
            };

            // 获取节日
            function getFestival(date) {
                const month = date.getMonth() + 1;
                const day = date.getDate();
                
                const festivals = {
                    '1-1': '元旦',
                    '2-14': '情人节',
                    '3-8': '妇女节',
                    '4-1': '愚人节',
                    '5-1': '劳动节',
                    '6-1': '儿童节',
                    '7-7': '七夕',
                    '9-10': '教师节',
                    '10-1': '国庆节',
                    '12-25': '圣诞节'
                };
                
                const key = `${month}-${day}`;
                return festivals[key] || '';
            }

            // 添加新信件（AI发送信件时调用）- 新信件插入到最前面
            window.addNewLetter = function(content, event = '', date = null, festival = '', authorId = null, authorName = null) {
                let letters = JSON.parse(localStorage.getItem('aiLetters') || '[]');

                // 所有信件slotIndex后移一位（为新信件腾出位置0）
                letters.forEach(letter => {
                    letter.slotIndex++;
                });

                // 获取作者信息
                let authorInfo = {
                    id: authorId,
                    name: authorName
                };

                // 如果没有提供作者信息，尝试从当前聊天获取
                if (!authorId && currentChatId) {
                    const chatItem = relationshipData.wechatChatList.find(c => c.id === currentChatId);
                    if (chatItem) {
                        authorInfo.id = chatItem.id;
                        authorInfo.name = chatItem.remark || chatItem.name || '未知角色';
                    }
                }

                const newLetter = {
                    slotIndex: 0, // 新信件总是在最前面
                    content: content,
                    date: date ? new Date(date).toISOString() : new Date().toISOString(),
                    event: event,
                    festival: festival,
                    authorId: authorInfo.id,
                    authorName: authorInfo.name
                };

                // 插入到数组最前面
                letters.unshift(newLetter);

                localStorage.setItem('aiLetters', JSON.stringify(letters));

                // 如果在格子页面，刷新显示
                const letterGridPage = document.getElementById('letterGridPage');
                if (letterGridPage.classList.contains('active')) {
                    generateLetterGrid();
                }

                return true;
            };

            // 打开测试弹窗
            window.openLetterTestModal = function() {
                const modal = document.getElementById('letterTestModal');
                modal.style.display = 'flex';
                // 设置默认日期为今天
                document.getElementById('testLetterDate').valueAsDate = new Date();
            };

            // 关闭测试弹窗
            window.closeLetterTestModal = function() {
                const modal = document.getElementById('letterTestModal');
                modal.style.display = 'none';
                // 清空表单
                document.getElementById('testLetterContent').value = '';
                document.getElementById('testLetterDate').value = '';
                document.getElementById('testLetterFestival').value = '';
                document.getElementById('testLetterEvent').value = '';
            };

            // 添加测试信件
            window.addTestLetter = function() {
                const content = document.getElementById('testLetterContent').value;
                const date = document.getElementById('testLetterDate').value;
                const festival = document.getElementById('testLetterFestival').value;
                const event = document.getElementById('testLetterEvent').value;

                if (!content) {
                    alert('请输入信件内容');
                    return;
                }

                // 添加信件（新信件在最前面）
                addNewLetter(content, event, date, festival);

                // 关闭弹窗
                closeLetterTestModal();

                // 显示提示
                alert('信件添加成功！');
            };

            // ==================== 信纸背景设置功能 ====================
            
            // 打开信纸背景弹窗
            window.openLetterBgModal = async function() {
                const modal = document.getElementById('letterBgModal');
                modal.style.display = 'flex';
                
                // 加载已保存的设置（从localforage）
                try {
                    const savedBg = await localforage.getItem('letterPaperBackground');
                    if (savedBg) {
                        if (savedBg.url) {
                            document.getElementById('letterBgUrl').value = savedBg.url;
                            previewLetterBgFromUrl();
                        }
                        if (savedBg.blur !== undefined) {
                            document.getElementById('letterBgBlur').value = savedBg.blur;
                        }
                        if (savedBg.darkness !== undefined) {
                            document.getElementById('letterBgDarkness').value = savedBg.darkness;
                        }
                    }
                } catch (error) {
                    console.error('加载信纸背景设置失败:', error);
                }
            };

            // 关闭信纸背景弹窗
            window.closeLetterBgModal = function() {
                const modal = document.getElementById('letterBgModal');
                modal.style.display = 'none';
                // 清空预览
                document.getElementById('letterBgPreviewGroup').style.display = 'none';
                document.getElementById('letterBgImage').value = '';
            };

            // 预览本地选择的背景图片
            window.previewLetterBg = function(input) {
                if (input.files && input.files[0]) {
                    const reader = new FileReader();
                    reader.onload = function(e) {
                        const previewDiv = document.getElementById('letterBgPreview');
                        const previewGroup = document.getElementById('letterBgPreviewGroup');
                        previewDiv.style.backgroundImage = `url(${e.target.result})`;
                        previewGroup.style.display = 'block';
                        // 清空URL输入
                        document.getElementById('letterBgUrl').value = '';
                        updateLetterBgPreview();
                    };
                    reader.readAsDataURL(input.files[0]);
                }
            };

            // 从URL预览背景图片
            window.previewLetterBgFromUrl = function() {
                const url = document.getElementById('letterBgUrl').value.trim();
                if (url) {
                    const previewDiv = document.getElementById('letterBgPreview');
                    const previewGroup = document.getElementById('letterBgPreviewGroup');
                    previewDiv.style.backgroundImage = `url(${url})`;
                    previewGroup.style.display = 'block';
                    updateLetterBgPreview();
                }
            };

            // 更新背景预览效果（模糊度和暗度）
            window.updateLetterBgPreview = function() {
                const previewDiv = document.getElementById('letterBgPreview');
                const blur = document.getElementById('letterBgBlur').value;
                const darkness = document.getElementById('letterBgDarkness').value;
                
                let filterStyle = '';
                if (blur > 0) {
                    filterStyle += `blur(${blur}px) `;
                }
                if (darkness > 0) {
                    filterStyle += `brightness(${100 - darkness}%) `;
                }
                
                previewDiv.style.filter = filterStyle.trim();
            };

            // 保存信纸背景设置
            window.saveLetterBg = async function() {
                const fileInput = document.getElementById('letterBgImage');
                const urlInput = document.getElementById('letterBgUrl').value.trim();
                const blur = document.getElementById('letterBgBlur').value;
                const darkness = document.getElementById('letterBgDarkness').value;
                
                let bgData = {
                    blur: parseInt(blur),
                    darkness: parseInt(darkness)
                };
                
                // 优先使用本地文件，其次使用URL
                if (fileInput.files && fileInput.files[0]) {
                    const reader = new FileReader();
                    reader.onload = async function(e) {
                        bgData.url = e.target.result;
                        bgData.type = 'dataurl';
                        try {
                            await localforage.setItem('letterPaperBackground', bgData);
                            showToast('信纸背景设置已保存！', 'success');
                            closeLetterBgModal();
                        } catch (error) {
                            console.error('保存信纸背景失败:', error);
                            showToast('保存失败，请重试', 'error');
                        }
                    };
                    reader.readAsDataURL(fileInput.files[0]);
                } else if (urlInput) {
                    bgData.url = urlInput;
                    bgData.type = 'url';
                    try {
                        await localforage.setItem('letterPaperBackground', bgData);
                        showToast('信纸背景设置已保存！', 'success');
                        closeLetterBgModal();
                    } catch (error) {
                        console.error('保存信纸背景失败:', error);
                        showToast('保存失败，请重试', 'error');
                    }
                } else {
                    // 没有图片，只保存效果设置
                    try {
                        await localforage.setItem('letterPaperBackground', bgData);
                        showToast('信纸背景设置已保存！', 'success');
                        closeLetterBgModal();
                    } catch (error) {
                        console.error('保存信纸背景失败:', error);
                        showToast('保存失败，请重试', 'error');
                    }
                }
            };

            // 应用信纸背景到弹窗
            async function applyLetterPaperBackground() {
                try {
                    const bgData = await localforage.getItem('letterPaperBackground');
                    if (bgData) {
                        const bgElement = document.querySelector('.letter-paper-bg');
                        if (bgElement && bgData.url) {
                            bgElement.style.backgroundImage = `url(${bgData.url})`;
                            
                            let filterStyle = '';
                            if (bgData.blur > 0) {
                                filterStyle += `blur(${bgData.blur}px) `;
                            }
                            if (bgData.darkness > 0) {
                                filterStyle += `brightness(${100 - bgData.darkness}%) `;
                            }
                            if (filterStyle) {
                                bgElement.style.filter = filterStyle.trim();
                            }
                        }
                    }
                } catch (error) {
                    console.error('应用信纸背景失败:', error);
                }
            }

            // ==================== 写信页面功能 ====================

            // 打开写信页面
            window.openWriteLetterPage = async function() {
                const page = document.getElementById('writeLetterPage');
                
                // 加载收件人列表
                await loadWriteLetterRecipients();
                
                // 应用信纸背景
                await applyWriteLetterBackground();
                
                // 清空表单
                document.getElementById('writeLetterRecipient').value = '';
                document.getElementById('writeLetterEvent').value = '';
                document.getElementById('writeLetterContent').value = '';
                
                // 显示页面
                page.classList.add('active');
            };

            // 关闭写信页面
            window.closeWriteLetterPage = function() {
                const page = document.getElementById('writeLetterPage');
                page.classList.remove('active');
            };

            // 加载收件人列表（微信角色列表）
            async function loadWriteLetterRecipients() {
                const select = document.getElementById('writeLetterRecipient');
                // 保留第一个默认选项
                select.innerHTML = '<option value="">选择收件人</option>';
                
                // 从 relationshipData 获取角色列表
                if (relationshipData && relationshipData.wechatChatList) {
                    relationshipData.wechatChatList.forEach(chat => {
                        const option = document.createElement('option');
                        option.value = chat.id;
                        option.textContent = chat.remark || chat.name;
                        select.appendChild(option);
                    });
                }
            }

            // 应用信纸背景到写信页面
            async function applyWriteLetterBackground() {
                try {
                    const bgData = await localforage.getItem('letterPaperBackground');
                    const bgElement = document.querySelector('.write-letter-bg');
                    if (bgElement) {
                        if (bgData && bgData.url) {
                            bgElement.style.backgroundImage = `url(${bgData.url})`;
                            
                            let filterStyle = '';
                            if (bgData.blur > 0) {
                                filterStyle += `blur(${bgData.blur}px) `;
                            }
                            if (bgData.darkness > 0) {
                                filterStyle += `brightness(${100 - bgData.darkness}%) `;
                            }
                            if (filterStyle) {
                                bgElement.style.filter = filterStyle.trim();
                            }
                        } else {
                            // 使用默认背景
                            bgElement.style.backgroundImage = "url('https://img.58sb.cn/file/img/jDzihtlg.jpg')";
                            bgElement.style.filter = '';
                        }
                    }
                } catch (error) {
                    console.error('应用写信页面背景失败:', error);
                }
            }

            // 发送信件
            window.sendLetter = async function() {
                console.log('【写信】开始发送信件...');
                
                try {
                    const recipientId = document.getElementById('writeLetterRecipient').value;
                    const event = document.getElementById('writeLetterEvent').value.trim();
                    const content = document.getElementById('writeLetterContent').value.trim();
                    
                    console.log('【写信】收件人ID:', recipientId, '事件:', event, '内容长度:', content.length);
                    
                    if (!recipientId) {
                        showToast('请选择收件人', 'error');
                        return;
                    }
                    
                    if (!content) {
                        showToast('请输入信件内容', 'error');
                        return;
                    }
                    
                    // 获取收件人信息
                    const recipient = relationshipData.wechatChatList.find(c => c.id == recipientId);
                    if (!recipient) {
                        showToast('收件人不存在', 'error');
                        return;
                    }
                    
                    console.log('【写信】找到收件人:', recipient.remark || recipient.name);
                    
                    // 【关键】先设置currentChatId，确保消息保存到正确的聊天
                    const numericRecipientId = parseInt(recipientId, 10);
                    currentChatId = numericRecipientId;
                    console.log('【写信】设置currentChatId:', currentChatId);
                    
                    // 获取当前日期
                    const now = new Date();
                    const dateStr = `${now.getFullYear()}.${now.getMonth() + 1}.${now.getDate()}`;
                    
                    // 创建信件卡片消息
                    const cardTitle = event ? `${dateStr} ${event}` : dateStr;
                    const cardMessage = `[LETTER_CARD]${cardTitle}|${content}[/LETTER_CARD]`;
                    
                    console.log('【写信】信件卡片消息:', cardMessage.substring(0, 100) + '...');
                    
                    // 发送消息到对应角色
                    await sendLetterCardToChat(numericRecipientId, cardMessage, content, event);
                    console.log('【写信】信件已保存到聊天记录');
                    
                    // 关闭写信页面
                    closeWriteLetterPage();
                    
                    // 跳转到对应角色的聊天页面
                    console.log('【写信】准备跳转到聊天页面:', recipient.remark || recipient.name);
                    // 显示微信页面
                    const wechatPage = document.getElementById('wechatPage');
                    if (wechatPage) {
                        wechatPage.style.display = 'flex';
                    }
                    // 然后打开对应角色的聊天
                    setTimeout(() => {
                        openChatInterface(recipient.id, recipient.remark || recipient.name, recipient.avatar);
                    }, 300);
                    
                    showToast(`信件已发送给 ${recipient.remark || recipient.name}！`, 'success');
                } catch (error) {
                    console.error('【写信】发送信件失败:', error);
                    showToast('发送失败，请重试', 'error');
                }
            };

            // 发送信件卡片到聊天
            async function sendLetterCardToChat(chatId, cardMessage, letterContent, event) {
                console.log('【写信】sendLetterCardToChat 开始执行，chatId:', chatId, '类型:', typeof chatId);
                
                // 【修复】将chatId转为数字进行比较
                const numericChatId = parseInt(chatId, 10);
                console.log('【写信】转换后的chatId:', numericChatId);
                
                const chatItem = relationshipData.wechatChatList.find(c => c.id === numericChatId || c.id == chatId);
                if (!chatItem) {
                    console.error('【写信】找不到聊天项，chatId:', chatId);
                    throw new Error('找不到收件人');
                }
                
                console.log('【写信】找到聊天项:', chatItem.remark || chatItem.name);
                
                // 保存消息到聊天记录
                const message = {
                    sender: 'user',
                    content: cardMessage,
                    timestamp: Date.now(),
                    chatId: chatId,
                    type: 'letter_card',
                    letterContent: letterContent,
                    letterEvent: event,
                    isGroupChat: chatItem.isGroupChat
                };
                
                console.log('【写信】准备保存消息:', message);
                
                try {
                    // 【修复】先保存到IndexedDB
                    await ChatMessageManager.saveMessage(message);
                    console.log('【写信】消息已保存到IndexedDB');
                    
                    // 再添加到内存数组
                    relationshipData.chatMessages.push(message);
                    console.log('【写信】消息已添加到内存，当前消息数:', relationshipData.chatMessages.length);
                    
                    await saveData();
                    console.log('【写信】数据已保存');
                } catch (error) {
                    console.error('【写信】保存消息失败:', error);
                    throw error;
                }
                
                // 注意：消息会在打开聊天时通过 loadChatMessages 加载显示
                // 这里不需要立即显示，因为我们会跳转到聊天页面
            }

            // 信封飞走并打开信件
            window.flyEnvelopeAndOpen = function() {
                const envelope = document.getElementById('postOfficeEnvelope');
                
                // 添加飞走动画类
                envelope.classList.add('flying-away');
                
                // 动画结束后打开信件内容页面
                setTimeout(() => {
                    openLetterContent();
                    // 重置信封状态（以便下次使用）
                    setTimeout(() => {
                        envelope.classList.remove('flying-away');
                    }, 300);
                }, 800);
            };

            // 初始化邮局页面滑动检测
            function initPostOfficeSwipe() {
                const envelope = document.getElementById('postOfficeEnvelope');
                if (!envelope) return;
                
                let startY = 0;
                let startTime = 0;
                let isFlying = false;
                
                envelope.addEventListener('touchstart', function(e) {
                    startY = e.touches[0].clientY;
                    startTime = Date.now();
                    isFlying = false;
                }, { passive: true });
                
                envelope.addEventListener('touchmove', function(e) {
                    if (isFlying) return;
                    
                    const currentY = e.touches[0].clientY;
                    const deltaY = startY - currentY;
                    const deltaTime = Date.now() - startTime;
                    
                    // 向上滑动超过 50px 且速度较快时触发飞走
                    if (deltaY > 50 && deltaTime < 300) {
                        isFlying = true;
                        flyEnvelopeAndOpen();
                    }
                }, { passive: true });
                
                // 鼠标滑动支持（桌面端）
                let isMouseDown = false;
                
                envelope.addEventListener('mousedown', function(e) {
                    startY = e.clientY;
                    startTime = Date.now();
                    isMouseDown = true;
                    isFlying = false;
                });
                
                envelope.addEventListener('mousemove', function(e) {
                    if (!isMouseDown || isFlying) return;
                    
                    const currentY = e.clientY;
                    const deltaY = startY - currentY;
                    const deltaTime = Date.now() - startTime;
                    
                    if (deltaY > 50 && deltaTime < 300) {
                        isFlying = true;
                        isMouseDown = false;
                        flyEnvelopeAndOpen();
                    }
                });
                
                envelope.addEventListener('mouseup', function() {
                    isMouseDown = false;
                });
                
                envelope.addEventListener('mouseleave', function() {
                    isMouseDown = false;
                });
                
                // 点击也触发飞走（方便测试）
                envelope.addEventListener('click', function(e) {
                    if (!isFlying) {
                        flyEnvelopeAndOpen();
                    }
                });
            }
            
            // 页面加载完成后初始化滑动检测
            document.addEventListener('DOMContentLoaded', function() {
                initPostOfficeSwipe();
            });

            // 第二行功能图标 - 点击功能
            window.screen2SecondAction = function(type) {
                switch(type) {
                    case 'weibo':
                        openWeiboPage();
                        break;
                    case 'ball':
                        openCompanionBallModal();
                        break;
                    case 'gate':
                        alert('气运之门功能开发中...');
                        break;
                }
            };

            // 加载功能卡片图片
            async function loadFeatureCardImage() {
                const savedImage = await localforage.getItem('screen2FeatureImage');
                if (savedImage) {
                    const img = document.getElementById('screen2FeatureImg');
