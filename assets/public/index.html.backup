            overflow-y: auto;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        /* 图片上传框 */
        .plan-image-upload {
            width: 100%;
            max-width: 300px;
            margin-bottom: 30px;
        }

        .plan-image-container {
            width: 100%;
            aspect-ratio: 16/9;
            background: rgba(255, 255, 255, 0.9);
