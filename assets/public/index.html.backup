            // ==================== API 设置 ====================

            // 【新增】API连接测试函数 - 用于手机端诊断
            async testAPIConnection(apiUrl, apiKey, model) {
                const results = {
                    timestamp: new Date().toISOString(),
                    userAgent: navigator.userAgent,
                    isCapacitor: !!window.Capacitor,
                    tests: []
                };

                // 测试1: 基础网络连通性
                try {
                    console.log('【API测试】测试基础网络连通性...');
                    const startTime = Date.now();
                    const testResponse = await fetch('https://www.baidu.com', {
                        method: 'HEAD',
                        mode: 'no-cors',
                        cache: 'no-cache'
                    });
                    results.tests.push({
                        name: '基础网络',
                        status: 'success',
                        duration: Date.now() - startTime,
                        message: '可以访问互联网'
                    });
                } catch (e) {
                    results.tests.push({
                        name: '基础网络',
                        status: 'failed',
                        error: e.message,
                        message: '无法访问互联网'
                    });
                }

                // 测试2: API地址可达性
                if (apiUrl) {
                    try {
                        console.log('【API测试】测试API地址可达性:', apiUrl);
                        const startTime = Date.now();
                        const apiTestResponse = await fetch(apiUrl.replace('/v1', '').replace('/chat/completions', ''), {
                            method: 'HEAD',
                            mode: 'no-cors',
                            cache: 'no-cache'
                        });
                        results.tests.push({
                            name: 'API地址可达性',
                            status: 'success',
                            duration: Date.now() - startTime,
                            message: 'API地址可以访问'
                        });
                    } catch (e) {
                        results.tests.push({
                            name: 'API地址可达性',
                            status: 'warning',
                            error: e.message,
                            message: 'API地址可能无法直接访问（这可能是正常的）'
                        });
                    }
                }

                // 测试3: 实际API调用
                if (apiUrl && apiKey) {
                    try {
                        console.log('【API测试】测试实际API调用...');
                        const startTime = Date.now();
                        const controller = new AbortController();
                        const timeoutId = setTimeout(() => controller.abort(), 300000); // 【修改】300秒测试超时

                        const response = await fetch(`${apiUrl}/chat/completions`, {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'Authorization': `Bearer ${apiKey}`
                            },
                            body: JSON.stringify({
                                model: model || 'gpt-3.5-turbo',
                                messages: [{ role: 'user', content: 'Hi' }],
                                max_tokens: 5
                            }),
                            signal: controller.signal
                        });

                        clearTimeout(timeoutId);

                        if (response.ok) {
                            results.tests.push({
                                name: 'API调用',
                                status: 'success',
                                duration: Date.now() - startTime,
                                message: 'API调用成功'
                            });
                        } else {
                            const errorText = await response.text();
                            results.tests.push({
                                name: 'API调用',
                                status: 'failed',
                                httpStatus: response.status,
                                error: errorText,
                                message: `API返回错误: ${response.status}`
                            });
                        }
                    } catch (e) {
                        results.tests.push({
                            name: 'API调用',
                            status: 'failed',
                            error: e.message,
                            errorName: e.name,
                            message: `API调用失败: ${e.message}`
                        });
                    }
                } else {
                    results.tests.push({
                        name: 'API调用',
                        status: 'skipped',
                        message: '未提供API地址或密钥'
                    });
                }

                console.log('【API测试结果】', results);
                return results;
            },

