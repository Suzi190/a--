        // 清空聊天记录
        function clearChatRecords() {
            showCustomConfirm('确认清空', '确定要清空所有聊天记录吗？此操作不可恢复。', async function(confirmed) {
                if (confirmed) {
                    try {
                        if (currentChatId && relationshipData) {
                            // 【关键修复】先清空 SQLite/IndexedDB 中的消息
                            console.log('【清空记录】开始清空存储层消息:', currentChatId);
                            
                            // 1. 清空 SQLite 中的消息
                            if (SQLiteManager.isAvailable) {
                                await SQLiteManager.clearChatMessages(currentChatId);
                            }
                            
                            // 2. 清空 IndexedDB 中的消息（兼容旧版本）
                            try {
                                const db = await openDB();
                                const transaction = db.transaction('chatMessages', 'readwrite');
                                const store = transaction.objectStore('chatMessages');
                                const index = store.index('chatId');
                                const request = index.openCursor(IDBKeyRange.only(currentChatId));
                                
                                request.onsuccess = function(event) {
                                    const cursor = event.target.result;
                                    if (cursor) {
                                        store.delete(cursor.primaryKey);
                                        cursor.continue();
                                    }
                                };
                                
                                await new Promise((resolve, reject) => {
                                    transaction.oncomplete = () => {
                                        console.log('【清空记录】IndexedDB消息已清空');
                                        resolve();
                                    };
                                    transaction.onerror = () => reject(transaction.error);
                                });
                            } catch (idbError) {
                                console.warn('【清空记录】清空IndexedDB失败（可能不存在）:', idbError);
                            }
                            
                            // 3. 清空 ChatMessageManager 的内存缓存
                            if (ChatMessageManager && ChatMessageManager.currentChatCache) {
                                // 删除当前聊天的所有缓存消息
                                for (const [key, value] of ChatMessageManager.currentChatCache) {
                                    if (value.chatId == currentChatId) {
                                        ChatMessageManager.currentChatCache.delete(key);
                                    }
                                }
                                console.log('【清空记录】内存缓存已清空');
                            }
                            
                            // 4. 清空 chatItem.messages（内存中的数据）
                            if (relationshipData.wechatChatList) {
                                const chatItem = relationshipData.wechatChatList.find(item => item.id == currentChatId);
                                if (chatItem) {
                                    chatItem.messages = [];
                                }
                            }
                            
                            // 5. 清空 relationshipData.chatMessages 中当前聊天的消息
                            if (relationshipData.chatMessages) {
                                relationshipData.chatMessages = relationshipData.chatMessages.filter(
                                    msg => msg.chatId != currentChatId
                                );
                            }
                            
                            // 【关键修复】6. 清空撤回消息 (undoMessages)
                            if (relationshipData.undoMessages) {
                                const beforeCount = relationshipData.undoMessages.length;
                                relationshipData.undoMessages = relationshipData.undoMessages.filter(
                                    msg => msg.chatId != currentChatId
                                );
                                console.log('【清空记录】撤回消息已清空:', beforeCount - relationshipData.undoMessages.length, '条');
                            }
                            
                            // 7. 清空消息缓存
                            if (typeof clearCurrentChatMessagesCache === 'function') {
                                clearCurrentChatMessagesCache();
                            }
                            
                            await saveData();
                            
                            // 8. 清空当前聊天界面
                            const chatContent = document.getElementById('chatContent');
                            if (chatContent) {
                                chatContent.innerHTML = '';
                            }
                            
                            console.log('【清空记录】聊天记录清空完成:', currentChatId);
                            showCustomAlert('成功', '聊天记录已清空', 'success');
                            closeChatInfoModal();
                        }
                    } catch (error) {
                        console.error('【清空记录】清空聊天记录时出错:', error);
                        showCustomAlert('错误', '清空聊天记录时出错: ' + error.message, 'error');
                    }
                }
            });
        }

        // 显示确认对话框
        function showCustomConfirm(title, message, callback) {
            // 创建确认对话框
            const confirmModal = document.createElement('div');
            confirmModal.id = 'customConfirmModal';
            confirmModal.style.cssText = `
                position: fixed;
                top: 0;
                left: 0;
                right: 0;
                bottom: 0;
                background: rgba(0, 0, 0, 0.5);
                z-index: 20000;
                display: flex;
                align-items: center;
                justify-content: center;
            `;
            
            const modalContent = document.createElement('div');
            modalContent.style.cssText = `
                background: #fff;
                border-radius: 12px;
                width: 280px;
                max-width: 90%;
                overflow: hidden;
            `;
            
            modalContent.innerHTML = `
                <div style="padding: 20px; text-align: center;">
                    <div style="font-size: 17px; font-weight: 600; margin-bottom: 8px; color: #000;">${title}</div>
                    <div style="font-size: 14px; color: #666; line-height: 1.5;">${message}</div>
                </div>
                <div style="display: flex; border-top: 1px solid #e0e0e0;">
                    <button id="confirmCancelBtn" style="flex: 1; padding: 12px; border: none; background: #fff; font-size: 16px; color: #007aff; cursor: pointer; border-right: 1px solid #e0e0e0;">取消</button>
                    <button id="confirmOkBtn" style="flex: 1; padding: 12px; border: none; background: #fff; font-size: 16px; color: #ff3b30; cursor: pointer; font-weight: 600;">确定</button>
                </div>
            `;
            
            confirmModal.appendChild(modalContent);
            document.body.appendChild(confirmModal);
            
            // 绑定事件
            document.getElementById('confirmCancelBtn').addEventListener('click', function() {
                document.getElementById('customConfirmModal').remove();
                if (callback) callback(false);
            });
            
            document.getElementById('confirmOkBtn').addEventListener('click', function() {
                document.getElementById('customConfirmModal').remove();
                if (callback) callback(true);
            });
        }
        
        function updateWorldbookCardFromData() {
            // 【防闪退】添加try-catch和安全检查
            try {
                const cardText = document.getElementById('worldbookCardText');
                if (!cardText) {
                    console.warn('【防闪退】worldbookCardText元素不存在');
                    return;
                }

                selectedWorldbookIds = [];

                if (currentChatId && relationshipData && relationshipData.wechatChatList) {
                    const chatItem = relationshipData.wechatChatList.find(item => item.id == currentChatId);
                    if (chatItem && chatItem.worldbooks && Array.isArray(chatItem.worldbooks)) {
                        // 确保ID都是数字类型
                        selectedWorldbookIds = chatItem.worldbooks.map(id => parseInt(id));
                        console.log('【加载设置】世界书ID:', selectedWorldbookIds);
                    }
                }

                if (selectedWorldbookIds.length === 0) {
                    cardText.textContent = '点击选择世界书';
                } else {
                    cardText.textContent = `已关联 ${selectedWorldbookIds.length} 个世界书`;
                }
            } catch (error) {
                console.error('【防闪退】updateWorldbookCardFromData 发生错误:', error);
            }
        }

        // 关闭群聊设置页面
        function closeGroupChatSettings() {
            const groupChatSettingsPage = document.getElementById('groupChatSettingsPage');
            if (groupChatSettingsPage) {
                groupChatSettingsPage.style.display = 'none';
            }
        }

        // 加载群聊设置
        async function loadGroupChatSettings() {
            const chatItem = relationshipData.wechatChatList.find(item => item.id == currentChatId);
            if (!chatItem) return;
            
            console.log('加载群聊设置:', chatItem);
            
            // 加载群聊名称
            const nameInput = document.getElementById('groupChatSettingsName');
            if (nameInput) {
                nameInput.value = chatItem.name || '';
            }
            
            // 加载群聊头像
            const avatarImg = document.getElementById('groupChatAvatarImg');
            const avatarPlaceholder = document.getElementById('groupChatAvatarPlaceholder');
            
            if (avatarImg && avatarPlaceholder) {
                let avatarUrl = chatItem.avatar;
                
                // 如果没有头像，尝试从IndexedDB加载
                if (!avatarUrl) {
                    try {
                        avatarUrl = await loadImageFromDB(`groupChatAvatar_${chatItem.id}`);
                        if (avatarUrl) {
                            chatItem.avatar = avatarUrl;
                        }
                    } catch (e) {
                        console.warn('从IndexedDB加载群聊头像失败:', e);
                    }
                }
                
                if (avatarUrl && isValidImageUrl(avatarUrl)) {
                    avatarImg.src = avatarUrl;
                    avatarImg.style.display = 'block';
                    avatarPlaceholder.style.display = 'none';
                } else {
                    avatarImg.style.display = 'none';
                    avatarPlaceholder.style.display = 'flex';
                }
            }
            
            // 清空临时头像变量
            currentGroupChatAvatar = null;
            
            // 加载群聊成员
            const membersList = document.getElementById('groupChatSettingsMembers');
            if (membersList) {
                membersList.innerHTML = '';
                
                // 构建完整成员列表：用户放在第一位
                const allMembers = [];
                
                // 添加用户到第一位
                const userAvatar = relationshipData.avatar1 || cachedPersonalProfile?.avatar;
                const userName = cachedPersonalProfile?.name || cachedPersonalProfile?.nickname || '我';
                allMembers.push({
                    id: 'user',
                    name: userName,
                    remark: '我',
                    avatar: userAvatar,
                    isUser: true
                });
                
                // 添加其他群成员（排除用户自己，避免重复）
                if (chatItem.members && Array.isArray(chatItem.members)) {
                    chatItem.members.forEach(member => {
                        if (member && member.id !== 'user') {
                            allMembers.push(member);
                        }
                    });
                }
                
                allMembers.forEach(member => {
                    // 获取成员头像：用户直接使用缓存，其他成员从原始聊天项获取
                    let memberAvatar = member.avatar;
                    if (!member.isUser) {
                        const originalChatItem = relationshipData.wechatChatList.find(item => item.id == member.id);
                        memberAvatar = originalChatItem ? originalChatItem.avatar : member.avatar;
                    }
                    
                    const memberItem = document.createElement('div');
                    memberItem.className = 'group-chat-member-item';
                    memberItem.setAttribute('data-member-id', member.id);
                    memberItem.style.cursor = 'pointer';
                    
                    const isEmoji = memberAvatar && memberAvatar.length <= 2 && /\p{Emoji}/u.test(memberAvatar);
                    const avatarContent = isEmoji ? memberAvatar : (isValidImageUrl(memberAvatar) ? `<img src="${memberAvatar}" style="width: 40px; height: 40px; border-radius: 0; object-fit: cover;">` : '头像');
                    
                    // 显示身份标识（群主/我）
                    let nameDisplay = member.remark || member.name;
                    if (member.isUser) {
                        nameDisplay += ' (我)';
                        if (chatItem.owner === 'user') {
                            nameDisplay += ' [群主]';
                        }
                    }
                    
                    memberItem.innerHTML = `
                        <div class="group-chat-member-avatar" style="width: 40px; height: 40px; border-radius: 0; display: flex; align-items: center; justify-content: center; ${isEmoji ? 'font-size: 28px;' : (!memberAvatar ? 'background-color: #e0e0e0; color: #999; font-size: 12px;' : '')}">${avatarContent}</div>
                        <div class="group-chat-member-name">${nameDisplay}</div>
                    `;
                    
                    memberItem.onclick = function() {
                        openGroupMemberActionModal(member);
                    };
                    
                    membersList.appendChild(memberItem);
                });
            }
            
            // 加载记忆挂载设置
            loadGroupChatMemoryMounts(chatItem);
        }
        
        // 加载群聊记忆挂载设置
        function loadGroupChatMemoryMounts(chatItem) {
            const memoryMountList = document.getElementById('groupChatMemoryMountList');
            if (!memoryMountList) return;
            
            memoryMountList.innerHTML = '';
            
            // 确保群聊有记忆挂载配置
            if (!chatItem.memoryMounts) {
                chatItem.memoryMounts = {};
            }
            
            if (chatItem.members && Array.isArray(chatItem.members)) {
                chatItem.members.forEach(member => {
                    // 跳过用户自己（用户不需要记忆挂载）
                    if (member.id === 'user' || member.isUser) return;
                    
                    const originalChatItem = relationshipData.wechatChatList.find(item => item.id == member.id);
                    if (!originalChatItem) return;
                    
                    const memberId = member.id;
                    const mountConfig = chatItem.memoryMounts[memberId] || {
                        enabled: false,
                        contextLength: 10,
                        memoryCount: 5
                    };
                    
                    const mountItem = document.createElement('div');
                    mountItem.className = 'memory-mount-item';
                    mountItem.setAttribute('data-member-id', memberId);
                    
                    const isEmoji = originalChatItem.avatar && originalChatItem.avatar.length <= 2 && /\p{Emoji}/u.test(originalChatItem.avatar);
                    const avatarHtml = isEmoji 
                        ? `<div style="font-size: 28px;">${originalChatItem.avatar}</div>`
                        : (isValidImageUrl(originalChatItem.avatar) 
                            ? `<img src="${originalChatItem.avatar}" class="memory-mount-avatar">`
                            : `<div style="width: 40px; height: 40px; border-radius: 50%; background: #e0e0e0; display: flex; align-items: center; justify-content: center; color: #999; font-size: 12px;">头像</div>`);
                    
                    mountItem.innerHTML = `
                        <div class="memory-mount-header">
                            ${avatarHtml}
                            <span class="memory-mount-name">${originalChatItem.remark || originalChatItem.name}</span>
                        </div>
                        <div class="memory-mount-toggle">
                            <input type="checkbox" id="mountEnabled_${memberId}" ${mountConfig.enabled ? 'checked' : ''}>
                            <label for="mountEnabled_${memberId}">挂载该成员的私聊记忆</label>
                        </div>
                        <div class="memory-mount-settings">
                            <div class="memory-mount-setting">
                                <label>上下文条数</label>
                                <input type="number" id="contextLength_${memberId}" value="${mountConfig.contextLength}" min="0" max="50" placeholder="10">
                            </div>
                            <div class="memory-mount-setting">
                                <label>长期记忆条数</label>
                                <input type="number" id="memoryCount_${memberId}" value="${mountConfig.memoryCount}" min="0" max="20" placeholder="5">
                            </div>
                        </div>
                    `;
                    
                    memoryMountList.appendChild(mountItem);
                });
            }

            // 加载世界书挂载设置
            loadGroupChatWorldbookSettings(chatItem);

            // 加载群聊长期记忆设置
            loadGroupChatMemorySettings(chatItem);
        }

        // 加载群聊世界书挂载设置
        function loadGroupChatWorldbookSettings(chatItem) {
            const worldbookNamesSpan = document.getElementById('groupChatWorldbookNames');
            if (!worldbookNamesSpan) return;

            // 确保群聊有世界书挂载配置
            if (!chatItem.worldbooks) {
                chatItem.worldbooks = [];
            }

            if (chatItem.worldbooks.length > 0) {
                // 获取世界书名称
                const worldbookNames = chatItem.worldbooks.map(id => {
                    const wb = relationshipData.worldBooks.find(w => w.id === parseInt(id) || w.id === id || w.id == id);
                    // 【修复】使用 title 属性，如果不存在则使用 name 或显示'未命名'
                    return wb ? (wb.title || wb.name || '未命名') : '未知世界书';
                });
                worldbookNamesSpan.textContent = worldbookNames.join(', ');
            } else {
                worldbookNamesSpan.textContent = '点击选择世界书';
            }
        }

        // 加载群聊长期记忆设置
        function loadGroupChatMemorySettings(chatItem) {
            // 确保群聊有长期记忆配置
            if (!chatItem.memorySettings) {
                chatItem.memorySettings = {
                    autoSummarizeEnabled: false,
                    autoSummarizeCount: 50,
                    contextLength: 20,
                    memoryMountCount: 5
                };
            }

            const enabledCheckbox = document.getElementById('groupChatAutoSummarizeEnabled');
            const countInput = document.getElementById('groupChatAutoSummarizeCount');
            const contextInput = document.getElementById('groupChatContextLength');
            const memoryMountCountInput = document.getElementById('groupChatMemoryMountCount');
            const memoryCountSpan = document.getElementById('groupChatMemoryCount');

            if (enabledCheckbox) {
                enabledCheckbox.checked = chatItem.memorySettings.autoSummarizeEnabled || false;
            }
            if (countInput) {
                countInput.value = chatItem.memorySettings.autoSummarizeCount || 50;
            }
            if (contextInput) {
                contextInput.value = chatItem.memorySettings.contextLength || 20;
            }
            if (memoryMountCountInput) {
                memoryMountCountInput.value = chatItem.memorySettings.memoryMountCount || 5;
            }
            if (memoryCountSpan) {
                const memoryCount = chatItem.longTermMemories ? chatItem.longTermMemories.length : 0;
                memoryCountSpan.textContent = memoryCount > 0 ? `${memoryCount} 条记忆` : '暂无记忆';
            }
        }

        // 查看群聊长期记忆
        function viewGroupChatLongTermMemories() {
            const chatItem = relationshipData.wechatChatList.find(item => item.id == currentChatId);
            if (!chatItem || !chatItem.isGroupChat) return;

            const modal = document.getElementById('groupChatMemoryModal');
            const memoryList = document.getElementById('groupChatMemoryList');

            if (!modal || !memoryList) return;

            // 确保有长期记忆数组
            if (!chatItem.longTermMemories) {
                chatItem.longTermMemories = [];
            }

            // 【修复】确保所有记忆都有id字段（与私聊记忆格式一致）
            chatItem.longTermMemories.forEach((memory, index) => {
                if (!memory.id) {
                    memory.id = Date.now() + index;
                }
            });

            // 生成记忆列表HTML
            if (chatItem.longTermMemories.length === 0) {
                memoryList.innerHTML = `
                    <div class="group-chat-memory-empty">
                        <div class="group-chat-memory-empty-icon">📝</div>
                        <div class="group-chat-memory-empty-text">暂无长期记忆</div>
                        <div class="group-chat-memory-empty-hint">群聊消息达到设置条数后会自动总结为长期记忆</div>
                    </div>
                `;
            } else {
                // 【修复】按时间倒序排序，最新的在前
                const sortedMemories = [...chatItem.longTermMemories].sort((a, b) => b.timestamp - a.timestamp);
                
                memoryList.innerHTML = sortedMemories.map((memory, index) => `
                    <div class="group-chat-memory-item" data-memory-id="${memory.id}">
                        <div class="group-chat-memory-header">
                            <span class="group-chat-memory-index">#${index + 1}</span>
                            <span class="group-chat-memory-time">${formatTimestamp(memory.timestamp)}</span>
                        </div>
                        <div class="group-chat-memory-content">${memory.content}</div>
                        <div class="group-chat-memory-actions">
                            <button onclick="deleteGroupChatMemoryById(${memory.id})" class="group-chat-memory-delete">删除</button>
                        </div>
                    </div>
                `).join('');
            }

            modal.style.display = 'flex';
        }

        // 关闭群聊长期记忆弹窗
        function closeGroupChatMemoryModal() {
            const modal = document.getElementById('groupChatMemoryModal');
            if (modal) {
                modal.style.display = 'none';
            }
        }

        // 删除群聊长期记忆（通过索引，兼容旧代码）
        async function deleteGroupChatMemory(index) {
            const chatItem = relationshipData.wechatChatList.find(item => item.id == currentChatId);
            if (!chatItem || !chatItem.longTermMemories) return;

            if (confirm('确定要删除这条长期记忆吗？')) {
                chatItem.longTermMemories.splice(index, 1);
                await saveData();
                viewGroupChatLongTermMemories(); // 刷新列表
                loadGroupChatMemorySettings(chatItem); // 更新计数
                showToast('记忆已删除');
            }
        }

        // 删除群聊长期记忆（通过ID，新方式）
        async function deleteGroupChatMemoryById(memoryId) {
            const chatItem = relationshipData.wechatChatList.find(item => item.id == currentChatId);
            if (!chatItem || !chatItem.longTermMemories) return;

            if (confirm('确定要删除这条长期记忆吗？')) {
                // 通过ID查找并删除
                const index = chatItem.longTermMemories.findIndex(m => m.id === memoryId);
                if (index !== -1) {
                    chatItem.longTermMemories.splice(index, 1);
                    await saveData();
                    viewGroupChatLongTermMemories(); // 刷新列表
                    loadGroupChatMemorySettings(chatItem); // 更新计数
                    showToast('记忆已删除');
                }
            }
        }

        // 格式化时间戳
        function formatTimestamp(timestamp) {
            if (!timestamp) return '未知时间';
            const date = new Date(timestamp);
            return date.toLocaleString('zh-CN', {
                year: 'numeric',
                month: '2-digit',
                day: '2-digit',
                hour: '2-digit',
                minute: '2-digit'
            });
        }

        // 选择群聊世界书
        function selectGroupChatWorldbooks() {
            const chatItem = relationshipData.wechatChatList.find(item => item.id == currentChatId);
            if (!chatItem || !chatItem.isGroupChat) return;

            // 确保有世界书数组
            if (!chatItem.worldbooks) {
                chatItem.worldbooks = [];
            }

            // 创建世界书选择弹窗
            const modal = document.createElement('div');
            modal.id = 'groupChatWorldbookSelector';
            modal.className = 'worldbook-selector-modal';
            modal.style.cssText = `
                position: fixed;
                top: 0;
                left: 0;
                right: 0;
                bottom: 0;
                background: rgba(0, 0, 0, 0.5);
                z-index: 10000;
                display: flex;
                align-items: center;
                justify-content: center;
            `;

            // 获取所有世界书
            const worldBooks = relationshipData.worldBooks || [];

            let worldbookListHtml = '';
            if (worldBooks.length === 0) {
                worldbookListHtml = '<div style="padding: 20px; text-align: center; color: #999;">暂无世界书，请先创建世界书</div>';
            } else {
                worldbookListHtml = worldBooks.map(wb => {
                    const isChecked = chatItem.worldbooks.includes(wb.id) || chatItem.worldbooks.includes(wb.id.toString());
                    return `
                        <div class="worldbook-selector-item" onclick="toggleGroupChatWorldbook(${wb.id}, this)" data-id="${wb.id}">
                            <input type="checkbox" ${isChecked ? 'checked' : ''} onchange="event.stopPropagation()">
                            <span class="worldbook-selector-name">${wb.title || wb.name || '未命名'}</span>
                        </div>
                    `;
                }).join('');
            }

            modal.innerHTML = `
                <div class="worldbook-selector-content" style="
                    background: #fff;
                    border-radius: 12px;
                    width: 320px;
                    max-width: 90%;
                    max-height: 70vh;
                    display: flex;
                    flex-direction: column;
                ">
                    <div class="worldbook-selector-header" style="
                        padding: 15px 20px;
                        border-bottom: 1px solid #eee;
                        display: flex;
                        justify-content: space-between;
                        align-items: center;
                    ">
                        <h3 style="margin: 0; font-size: 17px; font-weight: 600;">选择世界书</h3>
                        <span onclick="closeGroupChatWorldbookSelector()" style="
                            font-size: 24px;
                            color: #999;
                            cursor: pointer;
                        ">&times;</span>
                    </div>
                    <div class="worldbook-selector-body" style="
                        padding: 10px;
                        overflow-y: auto;
                        flex: 1;
                    ">
                        ${worldbookListHtml}
                    </div>
                    <div class="worldbook-selector-footer" style="
                        padding: 15px 20px;
                        border-top: 1px solid #eee;
                        display: flex;
                        gap: 10px;
                    ">
                        <button onclick="closeGroupChatWorldbookSelector()" style="
                            flex: 1;
                            padding: 10px;
                            border: 1px solid #ddd;
                            background: #fff;
                            border-radius: 6px;
                            font-size: 14px;
                            cursor: pointer;
                        ">取消</button>
                        <button onclick="saveGroupChatWorldbookSelection()" style="
                            flex: 1;
                            padding: 10px;
                            border: none;
                            background: #07c160;
                            color: #fff;
                            border-radius: 6px;
                            font-size: 14px;
                            cursor: pointer;
                        ">确定</button>
                    </div>
                </div>
            `;

            document.body.appendChild(modal);

            // 存储临时选择的世界书
            window.tempGroupChatWorldbooks = [...chatItem.worldbooks];
        }

        // 切换群聊世界书选择
        function toggleGroupChatWorldbook(worldbookId, itemElement) {
            const checkbox = itemElement.querySelector('input[type="checkbox"]');
            checkbox.checked = !checkbox.checked;

            if (!window.tempGroupChatWorldbooks) {
                window.tempGroupChatWorldbooks = [];
            }

            const index = window.tempGroupChatWorldbooks.indexOf(worldbookId);
            if (checkbox.checked && index === -1) {
                window.tempGroupChatWorldbooks.push(worldbookId);
            } else if (!checkbox.checked && index !== -1) {
                window.tempGroupChatWorldbooks.splice(index, 1);
            }
        }

        // 关闭群聊世界书选择器
        function closeGroupChatWorldbookSelector() {
            const modal = document.getElementById('groupChatWorldbookSelector');
            if (modal) {
                modal.remove();
            }
            window.tempGroupChatWorldbooks = null;
        }

        // 保存群聊世界书选择
        function saveGroupChatWorldbookSelection() {
            const chatItem = relationshipData.wechatChatList.find(item => item.id == currentChatId);
            if (!chatItem) return;

            // 保存选择的世界书
            chatItem.worldbooks = window.tempGroupChatWorldbooks || [];

            // 更新显示
            loadGroupChatWorldbookSettings(chatItem);

            // 关闭选择器
            closeGroupChatWorldbookSelector();

            // 保存数据
            saveData();

            showToast('世界书挂载已更新');
        }

        // 当前选择的群聊头像（临时存储）
        let currentGroupChatAvatar = null;

        // 处理群聊头像更改
        async function handleGroupChatAvatarChange(event) {
            const file = event.target.files[0];
            if (!file) return;

            try {
                // 读取文件为DataURL
                const reader = new FileReader();
                reader.onload = async function(e) {
                    const avatarDataUrl = e.target.result;
                    
                    // 压缩头像
                    const compressedAvatar = await AvatarLoader.compressAvatar(avatarDataUrl);
                    
                    // 更新预览
                    const avatarImg = document.getElementById('groupChatAvatarImg');
                    const avatarPlaceholder = document.getElementById('groupChatAvatarPlaceholder');
                    
                    if (avatarImg) {
                        avatarImg.src = compressedAvatar;
                        avatarImg.style.display = 'block';
                    }
                    if (avatarPlaceholder) {
                        avatarPlaceholder.style.display = 'none';
                    }
                    
                    // 保存到临时变量
                    currentGroupChatAvatar = compressedAvatar;
                    
                    showToast('头像已选择，点击完成保存');
                };
                reader.readAsDataURL(file);
            } catch (error) {
                console.error('处理群聊头像失败:', error);
                showToast('头像处理失败，请重试');
            }
        }

        // 保存群聊设置
        async function saveGroupChatSettings() {
            const chatItem = relationshipData.wechatChatList.find(item => item.id == currentChatId);
            if (!chatItem) return;
            
            console.log('保存群聊设置');
            
            // 保存群聊名称
            const nameInput = document.getElementById('groupChatSettingsName');
            if (nameInput) {
                chatItem.name = nameInput.value.trim();
                chatItem.remark = nameInput.value.trim();
            }
            
            // 保存群聊头像
            if (currentGroupChatAvatar) {
                chatItem.avatar = currentGroupChatAvatar;
                console.log('群聊头像已保存');
                
                // 保存头像到IndexedDB
                try {
                    await saveImageToDB(`groupChatAvatar_${chatItem.id}`, currentGroupChatAvatar);
                    console.log('群聊头像已保存到IndexedDB');
                } catch (e) {
                    console.warn('保存群聊头像到IndexedDB失败:', e);
                }
                
                // 清空临时变量
                currentGroupChatAvatar = null;
            }
            
            // 保存记忆挂载设置
            if (!chatItem.memoryMounts) {
                chatItem.memoryMounts = {};
            }
            
            if (chatItem.members && Array.isArray(chatItem.members)) {
                chatItem.members.forEach(member => {
                    const memberId = member.id;
                    const enabledCheckbox = document.getElementById(`mountEnabled_${memberId}`);
                    const contextLengthInput = document.getElementById(`contextLength_${memberId}`);
                    const memoryCountInput = document.getElementById(`memoryCount_${memberId}`);
                    
                    if (enabledCheckbox && contextLengthInput && memoryCountInput) {
                        chatItem.memoryMounts[memberId] = {
                            enabled: enabledCheckbox.checked,
                            contextLength: parseInt(contextLengthInput.value) || 10,
                            memoryCount: parseInt(memoryCountInput.value) || 5
                        };
                    }
                });
            }
            
            console.log('记忆挂载设置已保存:', chatItem.memoryMounts);

            // 保存群聊长期记忆设置
            if (!chatItem.memorySettings) {
                chatItem.memorySettings = {};
            }
            const autoSummarizeEnabled = document.getElementById('groupChatAutoSummarizeEnabled');
            const autoSummarizeCount = document.getElementById('groupChatAutoSummarizeCount');
            const contextLengthInput = document.getElementById('groupChatContextLength');
            const memoryMountCountInput = document.getElementById('groupChatMemoryMountCount');
            if (autoSummarizeEnabled) {
                chatItem.memorySettings.autoSummarizeEnabled = autoSummarizeEnabled.checked;
            }
            if (autoSummarizeCount) {
                chatItem.memorySettings.autoSummarizeCount = parseInt(autoSummarizeCount.value) || 50;
            }
            if (contextLengthInput) {
                chatItem.memorySettings.contextLength = parseInt(contextLengthInput.value) || 20;
            }
            if (memoryMountCountInput) {
                chatItem.memorySettings.memoryMountCount = parseInt(memoryMountCountInput.value) || 5;
            }
            console.log('群聊长期记忆设置已保存:', chatItem.memorySettings);
            
            // 保存数据
            await saveData();

            // 更新聊天界面标题
            const chatHeaderTitle = document.getElementById('chatHeaderTitle');
            if (chatHeaderTitle) {
                chatHeaderTitle.textContent = chatItem.name;
            }

            // 更新聊天列表
            await renderWeChatChatList();
            
            // 关闭设置页面
            closeGroupChatSettings();
            
            console.log('✅ 群聊设置已保存');
        }

        // 打开群成员操作弹窗
        function openGroupMemberActionModal(member) {
            console.log('打开群成员操作弹窗:', member);
            currentSelectedGroupMember = member;
            
            // 如果是用户自己，显示提示而不是操作弹窗
            if (member.id === 'user' || member.isUser) {
                showToast('这是你自己，不能对自己进行操作');
                return;
            }
            
            const actionText = document.getElementById('groupMemberActionText');
            actionText.textContent = `选择对 ${member.remark} 的操作`;
            
            const modal = document.getElementById('groupMemberActionModal');
            if (modal) {
                modal.style.display = 'flex';
            }
        }

        // 设为群主
        function setGroupMemberAsOwner() {
            if (!currentSelectedGroupMember) return;
            
            currentGroupMemberAction = 'setOwner';
            const confirmText = document.getElementById('groupMemberConfirmText');
            confirmText.textContent = `确定要将 ${currentSelectedGroupMember.remark} 设为群主吗？转让后你将不再是群主。`;
            
            // 关闭操作弹窗，打开确认弹窗
            document.getElementById('groupMemberActionModal').style.display = 'none';
            document.getElementById('groupMemberConfirmModal').style.display = 'flex';
        }

        // 设为管理员
        function setGroupMemberAsAdmin() {
            if (!currentSelectedGroupMember) return;
            
            currentGroupMemberAction = 'setAdmin';
            const confirmText = document.getElementById('groupMemberConfirmText');
            confirmText.textContent = `确定要将 ${currentSelectedGroupMember.remark} 设为管理员吗？`;
            
            // 关闭操作弹窗，打开确认弹窗
            document.getElementById('groupMemberActionModal').style.display = 'none';
            document.getElementById('groupMemberConfirmModal').style.display = 'flex';
        }

        // 移出群聊
        function removeGroupMember() {
            if (!currentSelectedGroupMember) return;
            
            currentGroupMemberAction = 'remove';
            const confirmText = document.getElementById('groupMemberConfirmText');
            confirmText.textContent = `确定要将 ${currentSelectedGroupMember.remark} 移出群聊吗？`;
            
            // 关闭操作弹窗，打开确认弹窗
            document.getElementById('groupMemberActionModal').style.display = 'none';
            document.getElementById('groupMemberConfirmModal').style.display = 'flex';
        }

        // 关闭群成员确认弹窗
        function closeGroupMemberConfirmModal() {
            document.getElementById('groupMemberConfirmModal').style.display = 'none';
            currentSelectedGroupMember = null;
            currentGroupMemberAction = null;
        }

        // 确认群成员操作
        function confirmGroupMemberAction() {
            if (!currentSelectedGroupMember || !currentGroupMemberAction) return;
            
            const chatItem = relationshipData.wechatChatList.find(item => item.id == currentChatId);
            if (!chatItem) return;
            
            console.log('执行群成员操作:', currentGroupMemberAction, '成员:', currentSelectedGroupMember);
            
            // 初始化群聊的管理字段
            if (!chatItem.owner) {
                chatItem.owner = 'user';
            }
            if (!chatItem.admins) {
                chatItem.admins = [];
            }
            
            let actionMessage = '';
            
            switch (currentGroupMemberAction) {
                case 'setOwner':
                    // 转让群主
                    chatItem.owner = currentSelectedGroupMember.id;
                    actionMessage = `群主已转让给 ${currentSelectedGroupMember.remark}`;
                    break;
                    
                case 'setAdmin':
                    // 设为管理员
                    if (!chatItem.admins.includes(currentSelectedGroupMember.id)) {
                        chatItem.admins.push(currentSelectedGroupMember.id);
                        actionMessage = `${currentSelectedGroupMember.remark} 已被设为管理员`;
                    }
                    break;
                    
                case 'remove':
                    // 移出群聊
                    chatItem.members = chatItem.members.filter(m => m.id !== currentSelectedGroupMember.id);
                    actionMessage = `${currentSelectedGroupMember.remark} 已被移出群聊`;
                    break;
            }
            
            // 保存数据
            saveData();
            
            // 在聊天界面显示操作消息
            if (actionMessage) {
                displayGroupActionMessage(actionMessage);
            }
            
            // 重新加载群聊设置
            loadGroupChatSettings();
            
            // 关闭确认弹窗
            closeGroupMemberConfirmModal();
            
            console.log('✅ 群成员操作已完成');
        }

        // 显示群操作消息
        function displayGroupActionMessage(message) {
            const chatContent = document.getElementById('chatContent');
            if (!chatContent) return;
            
            const actionDiv = document.createElement('div');
            actionDiv.className = 'group-action-message';
            actionDiv.textContent = message;
            
            chatContent.appendChild(actionDiv);
            
            // 滚动到底部
            chatContent.scrollTop = chatContent.scrollHeight;
        }
        
        // 关闭聊天设置页面
        // 关闭聊天设置页面
        function closeChatSettings() {
            // 【防闪退】添加try-catch包裹
            try {
                console.log('【防闪退】关闭聊天设置');

                const chatSettingsPage = document.getElementById('chatSettingsPage');
                if (chatSettingsPage) {
                    chatSettingsPage.style.display = 'none';
                    console.log('【防闪退】聊天设置页面已关闭');
                }

                // 同时关闭群聊设置页面
                const groupChatSettingsPage = document.getElementById('groupChatSettingsPage');
                if (groupChatSettingsPage) {
                    groupChatSettingsPage.style.display = 'none';
                    console.log('【防闪退】群聊设置页面已关闭');
                }

                // 清理可能打开的选择器弹窗
                const worldbookSelectorModal = document.getElementById('worldbookSelectorModal');
                if (worldbookSelectorModal) {
                    worldbookSelectorModal.style.display = 'none';
                }

                const groupChatSelectorModal = document.getElementById('groupChatSelectorModal');
                if (groupChatSelectorModal) {
                    groupChatSelectorModal.style.display = 'none';
                }

                // 【关键修复】清空文件输入框，防止切换到其他角色时残留文件
                const avatarInput = document.getElementById('chatSettingsAvatar');
                const backgroundInput = document.getElementById('chatSettingsBackground');
                if (avatarInput) avatarInput.value = '';
                if (backgroundInput) backgroundInput.value = '';
            } catch (error) {
                console.error('【防闪退】closeChatSettings 发生错误:', error);
            }
        }
        
        // 加载聊天设置 - 【大改】从独立的 IndexedDB 存储加载
        async function loadChatSettings() {
            // 【防闪退】添加try-catch包裹整个函数
            try {
                // 【关键修复】先清空文件输入框，防止残留之前角色的文件
                const avatarInput = document.getElementById('chatSettingsAvatar');
                const backgroundInput = document.getElementById('chatSettingsBackground');
                if (avatarInput) avatarInput.value = '';
                if (backgroundInput) backgroundInput.value = '';

                if (!currentChatId) {
                    return;
                }

                // 找到当前聊天项
                const chatItem = relationshipData.wechatChatList.find(item => item.id == currentChatId);
                if (!chatItem) {
                    return;
                }

                // 【新方案】尝试从 IndexedDB 加载设置
                let settings = null;
                if (window.chatSettingsDB) {
                    try {
                        settings = await window.chatSettingsDB.loadChatSettings(currentChatId);
                        if (settings) {
                            // 合并设置到 chatItem
                            Object.assign(chatItem, settings);
                        }
                    } catch (dbError) {
                        console.warn('【ChatSettings】从 IndexedDB 加载设置失败:', dbError);
                    }
                }

                // 检查是否是情侣关系
                const isCouplePartner = relationshipData.coupleSpaceEnabled &&
                                       relationshipData.couplePartnerId == currentChatId;

                // 显示或隐藏爱人状态区域
                const loverSection = document.getElementById('loverSection');
                if (loverSection) {
                    if (isCouplePartner) {
                        loverSection.style.display = 'block';
                        const loverPartnerName = document.getElementById('loverPartnerName');
                        if (loverPartnerName) {
                            loverPartnerName.textContent =
                                `与 ${chatItem.remark || chatItem.name} 是伴侣关系`;
                        }
                    } else {
                        loverSection.style.display = 'none';
                    }
                }

                // 【简化】安全设置表单值
                const safeSetValue = (id, value) => {
                    const element = document.getElementById(id);
                    if (element) {
                        element.value = value || '';
                    }
                };

                const safeSetChecked = (id, checked) => {
                    const element = document.getElementById(id);
                    if (element) {
                        element.checked = !!checked;
                    }
                };

                // 【关键】加载上下文条数和记忆挂载数量等核心设置
                safeSetValue('chatSettingsRemark', chatItem.remark);
                safeSetValue('chatSettingsName', chatItem.name);
                safeSetValue('chatSettingsMyNickname', chatItem.myNickname);
                safeSetChecked('chatSettingsBackgroundActivity', chatItem.backgroundActivity);
                safeSetValue('chatSettingsCooldown', chatItem.cooldown || '30');
                safeSetValue('chatSettingsContextLength', chatItem.contextLength || '20');
                safeSetValue('chatSettingsPersonality', chatItem.personality);
                safeSetValue('memorySummaryFrequency', chatItem.memorySummaryFrequency || 20);
                safeSetValue('memoryMountCount', chatItem.memoryMountCount || 5);
                safeSetValue('chatSettingsLetterFont', chatItem.letterFont || '');

                // 加载定时设置
                safeSetChecked('chatSettingsAutoStopBackground', chatItem.autoStopBackground || false);
                safeSetValue('chatSettingsAutoStopTime', chatItem.autoStopTime || '23:00');
                safeSetChecked('chatSettingsAutoStartBackground', chatItem.autoStartBackground || false);
                safeSetValue('chatSettingsAutoStartTime', chatItem.autoStartTime || '08:00');

                // 加载语音设置
                const voiceSettings = chatItem.voiceSettings || {
                    voiceId: 'female-tianmei',
                    voiceLanguage: 'zh-CN',
                    voiceSpeed: 1.0
                };
                safeSetValue('voiceSettingsVoiceId', voiceSettings.voiceId);
                safeSetValue('voiceSettingsVoiceLanguage', voiceSettings.voiceLanguage);
                safeSetValue('voiceSettingsVoiceSpeed', voiceSettings.voiceSpeed);
                const voiceSpeedValue = document.getElementById('voiceSettingsVoiceSpeedValue');
                if (voiceSpeedValue) {
                    voiceSpeedValue.textContent = voiceSettings.voiceSpeed.toFixed(1) + 'x';
                }

                // 加载世界书设置
                if (chatItem.worldbooks) {
                    selectedWorldbookIds = chatItem.worldbooks;
                    updateWorldbookCard();
                }
                
                // 【关键修复】加载头像预览
                const avatarPreview = document.getElementById('chatAvatarPreview');
                if (avatarPreview && chatItem.avatar) {
                    try {
                        let avatarSrc = chatItem.avatar;
                        // 如果头像是引用键，从IndexedDB加载
                        if (chatItem.avatar.startsWith('chatAvatar_')) {
                            const avatarImage = await loadImageFromDB(chatItem.avatar);
                            if (avatarImage) {
                                avatarSrc = avatarImage;
                            }
                        }
                        // 显示头像预览
                        if (avatarSrc && (avatarSrc.startsWith('http') || avatarSrc.startsWith('data:'))) {
                            avatarPreview.innerHTML = `<img src="${avatarSrc}" style="width: 100%; height: 100%; border-radius: 50%; object-fit: cover;">`;
                        } else if (avatarSrc && avatarSrc.length <= 2) {
                            // Emoji 头像
                            avatarPreview.innerHTML = `<div style="font-size: 40px; display: flex; align-items: center; justify-content: center; height: 100%;">${avatarSrc}</div>`;
                        } else {
                            avatarPreview.innerHTML = '<span>预览</span>';
                        }
                    } catch (err) {
                        console.warn('【ChatSettings】加载头像预览失败:', err);
                        avatarPreview.innerHTML = '<span>预览</span>';
                    }
                } else if (avatarPreview) {
                    avatarPreview.innerHTML = '<span>预览</span>';
                }
                
                // 【关键修复】加载背景预览
                const backgroundPreview = document.getElementById('chatBackgroundPreview');
                if (backgroundPreview && chatItem.background) {
                    try {
                        let backgroundSrc = chatItem.background;
                        // 如果背景是引用键，从IndexedDB加载
                        if (chatItem.background.startsWith('chatBackground_')) {
                            const bgImage = await loadImageFromDB(chatItem.background);
                            if (bgImage) {
                                backgroundSrc = bgImage;
                            }
                        }
                        // 显示背景预览
                        if (backgroundSrc && (backgroundSrc.startsWith('http') || backgroundSrc.startsWith('data:'))) {
                            backgroundPreview.style.backgroundImage = `url(${backgroundSrc})`;
                            backgroundPreview.style.backgroundSize = 'cover';
                            backgroundPreview.style.backgroundPosition = 'center';
                            backgroundPreview.innerHTML = '';
                        } else {
                            backgroundPreview.style.backgroundImage = 'none';
                            backgroundPreview.style.backgroundColor = '#f0f0f0';
                            backgroundPreview.innerHTML = '<span>预览</span>';
                        }
                    } catch (err) {
                        console.warn('【ChatSettings】加载背景预览失败:', err);
                        backgroundPreview.style.backgroundImage = 'none';
                        backgroundPreview.style.backgroundColor = '#f0f0f0';
                        backgroundPreview.innerHTML = '<span>预览</span>';
                    }
                } else if (backgroundPreview) {
                    backgroundPreview.style.backgroundImage = 'none';
                    backgroundPreview.style.backgroundColor = '#f0f0f0';
                    backgroundPreview.innerHTML = '<span>预览</span>';
                }

                console.log('【ChatSettings】设置加载完成');

            } catch (error) {
                console.error('【ChatSettings】loadChatSettings 发生错误:', error);
            }
        }
        
        // 检查并显示管理者模式卡片
        function checkAndShowAdminModeCard() {
            const adminModeSection = document.getElementById('adminModeSection');
            if (!adminModeSection) return;
            
            // 获取当前接管AI的ID
            const controllerAIId = localStorage.getItem('notificationControllerAI');
            
            // 如果当前聊天AI是接管AI，则显示管理者模式卡片
            if (controllerAIId && currentChatId && controllerAIId == currentChatId) {
                adminModeSection.style.display = 'block';
            } else {
                adminModeSection.style.display = 'none';
            }
        }
        
        // 从设置页面打开通知管理器
        window.openNotificationManagerFromSettings = function() {
            closeChatSettings();
            setTimeout(() => {
                openNotificationManagerPage();
            }, 300);
        };
        
        // 从设置页面解除管理者模式
        window.removeAdminModeFromSettings = function() {
            if (!confirm('确定要解除此AI的通知接管权限吗？')) return;
            
            // 清除接管设置
            localStorage.removeItem('notificationControllerAI');
            
            // 隐藏卡片
            const adminModeSection = document.getElementById('adminModeSection');
            if (adminModeSection) {
                adminModeSection.style.display = 'none';
            }
            
            // 显示提示
            showToast('已解除管理者模式');
        };
        
        // 世界书选择器相关函数
        let selectedWorldbookIds = [];

        function openWorldbookSelector() {
            const modal = document.getElementById('worldbookSelectorModal');
            const body = document.getElementById('worldbookSelectorBody');
            
            // 清空现有内容
            body.innerHTML = '';
            
            // 获取当前选中的世界书
            selectedWorldbookIds = [];
            if (currentChatId) {
                const chatItem = relationshipData.wechatChatList.find(item => item.id == currentChatId);
                if (chatItem && chatItem.worldbooks && Array.isArray(chatItem.worldbooks)) {
                    // 确保ID都是数字类型
                    selectedWorldbookIds = chatItem.worldbooks.map(id => parseInt(id));
                    console.log('【世界书选择器】加载的世界书ID:', selectedWorldbookIds);
                }
            }
            
            // 生成世界书选项
            if (relationshipData.worldBooks && relationshipData.worldBooks.length > 0) {
                relationshipData.worldBooks.forEach(book => {
                    const option = document.createElement('div');
                    option.className = 'worldbook-option';
                    
                    const checkbox = document.createElement('input');
                    checkbox.type = 'checkbox';
                    checkbox.id = `worldbook_option_${book.id}`;
                    checkbox.value = book.id;
                    checkbox.checked = selectedWorldbookIds.includes(book.id);
                    
                    const label = document.createElement('label');
                    label.htmlFor = `worldbook_option_${book.id}`;
                    label.textContent = book.title;
                    
                    option.appendChild(checkbox);
                    option.appendChild(label);
                    body.appendChild(option);
                    
                    // 点击整个选项切换复选框
                    option.addEventListener('click', function(e) {
                        if (e.target !== checkbox && e.target !== label) {
                            checkbox.checked = !checkbox.checked;
                        }
                    });
                });
            } else {
                body.innerHTML = '<p style="text-align: center; color: #999; padding: 20px;">暂无世界书</p>';
            }
            
            // 显示弹窗
            modal.style.display = 'block';
        }

        function closeWorldbookSelector() {
            document.getElementById('worldbookSelectorModal').style.display = 'none';
        }

        function confirmWorldbookSelection() {
            const checkboxes = document.querySelectorAll('#worldbookSelectorBody input[type="checkbox"]:checked');
            selectedWorldbookIds = Array.from(checkboxes).map(cb => parseInt(cb.value));
            
            console.log('【世界书选择】选中的世界书ID:', selectedWorldbookIds);
            
            // 更新卡片显示
            updateWorldbookCard();
            
            // 关闭弹窗
            closeWorldbookSelector();
        }

        function updateWorldbookCard() {
            const cardText = document.getElementById('worldbookCardText');
            if (selectedWorldbookIds.length === 0) {
                cardText.textContent = '点击选择世界书';
            } else {
                cardText.textContent = `已关联 ${selectedWorldbookIds.length} 个世界书`;
            }
        }

        // 加载群聊记忆挂载设置
        function loadMountedGroupChatSettings(chatItem) {
            const select = document.getElementById('mountedGroupChatSelect');
            const contextCountItem = document.getElementById('mountedGroupChatContextCountItem');
            const contextCountInput = document.getElementById('mountedGroupChatContextCount');
            const previewDiv = document.getElementById('mountedGroupChatPreview');

            // 清空并重新填充群聊列表
            select.innerHTML = '<option value="">不挂载</option>';

            // 获取所有群聊
            const groupChats = relationshipData.wechatChatList.filter(item => item.isGroupChat);
            groupChats.forEach(groupChat => {
                const option = document.createElement('option');
                option.value = groupChat.id;
                option.textContent = groupChat.name;
                select.appendChild(option);
            });

            // 加载已保存的设置
            if (chatItem.mountedGroupChatId) {
                select.value = chatItem.mountedGroupChatId;
                contextCountItem.style.display = 'block';
                previewDiv.style.display = 'block';
                contextCountInput.value = chatItem.mountedGroupChatContextCount || 10;
                updateMountedGroupChatPreview(chatItem.mountedGroupChatId);
            } else {
                select.value = '';
                contextCountItem.style.display = 'none';
                previewDiv.style.display = 'none';
            }
        }

        // 群聊选择变化时
        function onMountedGroupChatChange() {
            const select = document.getElementById('mountedGroupChatSelect');
            const contextCountItem = document.getElementById('mountedGroupChatContextCountItem');
            const previewDiv = document.getElementById('mountedGroupChatPreview');
            const groupChatId = select.value;

            if (groupChatId) {
                contextCountItem.style.display = 'block';
                previewDiv.style.display = 'block';
                updateMountedGroupChatPreview(groupChatId);
            } else {
                contextCountItem.style.display = 'none';
                previewDiv.style.display = 'none';
            }
        }

        // 更新群聊记忆预览
        function updateMountedGroupChatPreview(groupChatId) {
            const previewContent = document.getElementById('mountedGroupChatPreviewContent');
            const contextCount = parseInt(document.getElementById('mountedGroupChatContextCount').value) || 10;

            if (!groupChatId) {
                previewContent.innerHTML = '<span>选择群聊后可预览记忆内容</span>';
                return;
            }

            // 获取该群聊的最近消息
            const groupMessages = relationshipData.chatMessages
                .filter(msg => msg.chatId == groupChatId)
                .slice(-contextCount);

            if (groupMessages.length === 0) {
                previewContent.innerHTML = '<span>该群聊暂无消息</span>';
                return;
            }

            // 构建预览内容
            let previewHtml = '';
            groupMessages.forEach(msg => {
                const senderName = msg.senderName || (msg.sender === 'user' ? '用户' : 'AI');
                const time = new Date(msg.timestamp).toLocaleTimeString('zh-CN', { hour: '2-digit', minute: '2-digit' });
                // 确保 content 是字符串
                const contentStr = ensureStringContent(msg.content);
                const content = contentStr.length > 50 ? contentStr.substring(0, 50) + '...' : contentStr;
                previewHtml += `<div style="margin-bottom: 5px; border-bottom: 1px solid #eee; padding-bottom: 5px;">
                    <strong>${senderName}</strong> <span style="color: #999; font-size: 10px;">${time}</span><br>
                    ${content}
                </div>`;
            });

            previewContent.innerHTML = previewHtml;
        }

        // 上下文条数变化时更新预览
        function onMountedGroupChatContextCountChange() {
            const select = document.getElementById('mountedGroupChatSelect');
            const groupChatId = select.value;
            if (groupChatId) {
                updateMountedGroupChatPreview(groupChatId);
            }
        }

        // 保存聊天设置 - 【大改】使用独立的 IndexedDB 存储，避免 SQLite 闪退
        async function saveChatSettings() {
            // 【防闪退】添加try-catch包裹整个函数
            try {
                if (!currentChatId) {
                    console.warn('【ChatSettings】当前没有选中的聊天');
                    return;
                }
                
                // 【新方案】直接从表单读取设置，不依赖复杂的数据处理
                const settings = {
                    remark: document.getElementById('chatSettingsRemark')?.value || '',
                    name: document.getElementById('chatSettingsName')?.value || '',
                    myNickname: document.getElementById('chatSettingsMyNickname')?.value || '',
                    worldbooks: selectedWorldbookIds || [],
                    backgroundActivity: document.getElementById('chatSettingsBackgroundActivity')?.checked || false,
                    cooldown: parseInt(document.getElementById('chatSettingsCooldown')?.value) || 30,
                    contextLength: parseInt(document.getElementById('chatSettingsContextLength')?.value) || 20,
                    personality: document.getElementById('chatSettingsPersonality')?.value || '',
                    memorySummaryFrequency: parseInt(document.getElementById('memorySummaryFrequency')?.value) || 20,
                    memoryMountCount: parseInt(document.getElementById('memoryMountCount')?.value) || 5,
                    letterFont: document.getElementById('chatSettingsLetterFont')?.value || '',
                    autoStopBackground: document.getElementById('chatSettingsAutoStopBackground')?.checked || false,
                    autoStopTime: document.getElementById('chatSettingsAutoStopTime')?.value || '23:00',
                    autoStartBackground: document.getElementById('chatSettingsAutoStartBackground')?.checked || false,
                    autoStartTime: document.getElementById('chatSettingsAutoStartTime')?.value || '08:00',
                    voiceSettings: {
                        voiceId: document.getElementById('voiceSettingsVoiceId')?.value || 'female-tianmei',
                        voiceLanguage: document.getElementById('voiceSettingsVoiceLanguage')?.value || 'zh-CN',
                        voiceSpeed: parseFloat(document.getElementById('voiceSettingsVoiceSpeed')?.value) || 1.0
                    },
                    mountedGroupChatId: document.getElementById('mountedGroupChatSelect')?.value || null,
                    mountedGroupChatContextCount: parseInt(document.getElementById('mountedGroupChatContextCount')?.value) || 10
                };
                
                // 【关键修复】保存头像和背景
                const chatItem = relationshipData.wechatChatList.find(item => item.id == currentChatId);
                
                // 处理头像上传
                const avatarInput = document.getElementById('chatSettingsAvatar');
                if (avatarInput && avatarInput.files && avatarInput.files[0]) {
                    try {
                        const avatarData = await readFileAsDataURL(avatarInput.files[0]);
                        const avatarKey = `chatAvatar_${currentChatId}`;
                        await saveImageToDB(avatarKey, avatarData);
                        settings.avatar = avatarKey; // 保存引用键
                        if (chatItem) chatItem.avatar = avatarKey;
                        console.log('【ChatSettings】头像已保存到 IndexedDB:', avatarKey);
                    } catch (err) {
                        console.error('【ChatSettings】保存头像失败:', err);
                    }
                } else if (chatItem && chatItem.avatar) {
                    // 保留原有头像设置
                    settings.avatar = chatItem.avatar;
                }
                
                // 处理背景上传
                const backgroundInput = document.getElementById('chatSettingsBackground');
                if (backgroundInput && backgroundInput.files && backgroundInput.files[0]) {
                    try {
                        const backgroundData = await readFileAsDataURL(backgroundInput.files[0]);
                        const backgroundKey = `chatBackground_${currentChatId}`;
                        await saveImageToDB(backgroundKey, backgroundData);
                        settings.background = backgroundKey; // 保存引用键
                        if (chatItem) chatItem.background = backgroundKey;
                        console.log('【ChatSettings】背景已保存到 IndexedDB:', backgroundKey);
                    } catch (err) {
                        console.error('【ChatSettings】保存背景失败:', err);
                    }
                } else if (chatItem && chatItem.background) {
                    // 保留原有背景设置
                    settings.background = chatItem.background;
                }
                
                // 【关键】先更新内存中的数据
                if (chatItem) {
                    Object.assign(chatItem, settings);
                }

                // 【新方案】使用独立的 IndexedDB 存储设置
                if (window.chatSettingsDB) {
                    await window.chatSettingsDB.saveChatSettings(currentChatId, settings);
                }

                // 【关键修复】立即保存关系数据，确保头像引用键被持久化
                // 防止用户更换头像后立即退出导致头像丢失
                try {
                    await saveDataImmediate();
                    console.log('【ChatSettings】关系数据已立即保存');
                } catch (saveErr) {
                    console.error('【ChatSettings】保存关系数据失败:', saveErr);
                }

                // 【关键修复】更新角色卡片头像和聊天界面
                await updateRoleCardAvatar();
                updateChatInterfaceAvatar();
                await updateChatBackground();
                
                // 【关键修复】刷新聊天列表显示
                if (typeof renderWeChatChatList === 'function') {
                    await renderWeChatChatList();
                }
                
                // 【关键修复】根据后台活动设置启动或停止定时器
                if (settings.backgroundActivity) {
                    // 启用了后台活动，启动定时器
                    console.log('【ChatSettings】启用了后台主动询问，启动定时器');
                    // 清除手动关闭标志
                    chatItem.manuallyStoppedBackground = false;
                    startBackgroundActivityTimer();
                } else {
                    // 关闭了后台活动，停止定时器
                    console.log('【ChatSettings】关闭了后台主动询问，停止定时器');
                    // 【关键】设置手动关闭标志，防止自动开启逻辑重新启动
                    chatItem.manuallyStoppedBackground = true;
                    console.log('【ChatSettings】已设置手动关闭标志');
                    stopBackgroundActivityTimer();
                }
                
                // 【简化】立即关闭设置页面，不等待其他操作
                closeChatSettings();
                
                // 【简化】只更新必要的界面元素
                const chatHeaderTitle = document.getElementById('chatHeaderTitle');
                if (chatHeaderTitle) {
                    chatHeaderTitle.textContent = settings.remark || settings.name || '聊天';
                }
                
            } catch (error) {
                console.error('【ChatSettings】保存聊天设置时发生错误:', error);
                // 即使出错也关闭设置页面，避免卡住
                closeChatSettings();
            }
        }
        
        // 辅助函数：将文件读取为 DataURL
        function readFileAsDataURL(file) {
            return new Promise((resolve, reject) => {
                const reader = new FileReader();
                reader.onload = (e) => resolve(e.target.result);
                reader.onerror = (e) => reject(e);
                reader.readAsDataURL(file);
            });
        }

        // 更新聊天界面中的头像
        // 更新聊天界面中的头像
        async function updateChatInterfaceAvatar() {
            if (currentChatId) {
                const chatItem = relationshipData.wechatChatList.find(item => item.id == currentChatId);
                if (chatItem && chatItem.avatar) {
                    let avatarSrc = chatItem.avatar;
                    
                    // 如果头像是引用键，从IndexedDB加载
                    if (chatItem.avatar.startsWith('chatAvatar_')) {
                        try {
                            const avatarImage = await loadImageFromDB(chatItem.avatar);
                            if (avatarImage) {
                                avatarSrc = avatarImage;
                            }
                        } catch (err) {
                            console.warn('【ChatSettings】加载聊天界面头像失败:', err);
                        }
                    }
                    
                    currentChatAvatar = avatarSrc;
                }
            }
        }

        // ==================== 聊天记录搜索功能 ====================

        let chatSearchTimeout = null;

        // 防抖搜索
        function debounceSearchChat() {
            if (chatSearchTimeout) {
                clearTimeout(chatSearchTimeout);
            }
            chatSearchTimeout = setTimeout(() => {
                searchChatHistory();
            }, 300); // 300ms 防抖延迟
        }

        // 搜索聊天记录（从数据库加载所有历史消息）
        async function searchChatHistory() {
            const keyword = document.getElementById('chatSearchInput').value.trim();
            const resultsContainer = document.getElementById('chatSearchResults');
            const countDisplay = document.getElementById('chatSearchResultCount');

            if (!keyword) {
                resultsContainer.innerHTML = '<span style="color: #999; font-size: 14px;">输入关键词开始搜索...</span>';
                countDisplay.textContent = '';
                return;
            }

            // 显示加载状态
            resultsContainer.innerHTML = '<span style="color: #666; font-size: 14px;">🔍 搜索中...</span>';

            // 【防闪退】使用 setTimeout 让出主线程
            await new Promise(resolve => setTimeout(resolve, 0));

            try {
                if (!currentChatId) {
                    resultsContainer.innerHTML = '<span style="color: #999; font-size: 14px;">请先选择一个聊天</span>';
                    return;
                }

                // 【关键修改】从数据库加载所有消息，而不是只搜索内存中的消息
                let allMessages = [];
                
                // 首先尝试从内存中获取
                const memoryMessages = relationshipData.chatMessages.filter(msg => msg.chatId == currentChatId);
                allMessages = [...memoryMessages];
                
                // 然后尝试从数据库加载更多消息
                try {
                    // 获取消息总数
                    const totalCount = await ChatMessageManager.getMessageCount(currentChatId);
                    
                    if (totalCount > memoryMessages.length) {
                        // 从数据库加载所有消息（使用较大的limit）
                        const dbMessages = await ChatMessageManager.getMessages(currentChatId, 0, 10000);
                        
                        // 合并内存和数据库的消息，去重
                        const existingTimestamps = new Set(allMessages.map(m => m.timestamp));
                        for (const msg of dbMessages) {
                            if (!existingTimestamps.has(msg.timestamp)) {
                                allMessages.push(msg);
                            }
                        }
                    }
                } catch (dbError) {
                    console.warn('从数据库加载消息失败，使用内存中的消息:', dbError);
                }

                if (!allMessages || allMessages.length === 0) {
                    resultsContainer.innerHTML = '<span style="color: #999; font-size: 14px;">暂无聊天记录</span>';
                    countDisplay.textContent = '';
                    return;
                }

                // 【防闪退】分批搜索，避免阻塞
                const results = [];
                const batchSize = 100; // 每批处理100条消息
                const keywordLower = keyword.toLowerCase();

                for (let i = 0; i < allMessages.length; i += batchSize) {
                    const batch = allMessages.slice(i, i + batchSize);

                    for (const msg of batch) {
                        if (msg.content && msg.content.toLowerCase().includes(keywordLower)) {
                            results.push({
                                sender: msg.sender === 'user' ? '我' : (msg.senderName || 'AI'),
                                content: msg.content,
                                timestamp: msg.timestamp,
                                senderType: msg.sender
                            });
                        }
                    }

                    // 每处理一批让出主线程
                    if (i + batchSize < allMessages.length) {
                        await new Promise(resolve => setTimeout(resolve, 0));
                    }
                }

                // 按时间倒序排列（最新的在前面）
                results.sort((a, b) => b.timestamp - a.timestamp);

                // 显示结果数量
                countDisplay.textContent = `找到 ${results.length} 条相关消息（共搜索 ${allMessages.length} 条记录）`;

                // 渲染结果
                if (results.length === 0) {
                    resultsContainer.innerHTML = '<span style="color: #999; font-size: 14px;">未找到包含该关键词的消息</span>';
                } else {
                    renderSearchResults(results, keyword);
                }

            } catch (error) {
                console.error('搜索聊天记录失败:', error);
                resultsContainer.innerHTML = '<span style="color: #f44336; font-size: 14px;">搜索失败，请重试</span>';
            }
        }

        // 渲染搜索结果
        function renderSearchResults(results, keyword) {
            const container = document.getElementById('chatSearchResults');
            const keywordLower = keyword.toLowerCase();

            let html = '';

            // 只显示前 20 条结果，避免过多渲染
            const displayResults = results.slice(0, 20);

            for (const result of displayResults) {
                const date = new Date(result.timestamp);
                const timeStr = `${date.getMonth() + 1}/${date.getDate()} ${date.getHours().toString().padStart(2, '0')}:${date.getMinutes().toString().padStart(2, '0')}`;

                // 高亮关键词
                const highlightedContent = highlightKeyword(result.content, keyword);

                // 截断过长的内容
                const maxLength = 100;
                let displayContent = highlightedContent;
                if (result.content.length > maxLength) {
                    // 找到关键词位置
                    const keywordIndex = result.content.toLowerCase().indexOf(keywordLower);
                    if (keywordIndex > -1) {
                        // 显示关键词周围的内容
                        const start = Math.max(0, keywordIndex - 30);
                        const end = Math.min(result.content.length, keywordIndex + keyword.length + 30);
                        displayContent = (start > 0 ? '...' : '') +
                                        highlightKeyword(result.content.substring(start, end), keyword) +
                                        (end < result.content.length ? '...' : '');
                    }
                }

                const senderColor = result.senderType === 'user' ? '#4CAF50' : '#2196F3';

                html += `
                    <div style="padding: 10px; border-bottom: 1px solid #eee; font-size: 14px; line-height: 1.5;">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 5px;">
                            <span style="color: ${senderColor}; font-weight: 500;">${escapeHtml(result.sender)}</span>
                            <span style="color: #999; font-size: 12px;">${timeStr}</span>
                        </div>
                        <div style="color: #333; word-break: break-word;">${displayContent}</div>
                    </div>
                `;
            }

            if (results.length > 20) {
                html += `<div style="text-align: center; padding: 10px; color: #999; font-size: 12px;">还有 ${results.length - 20} 条结果未显示</div>`;
            }

            container.innerHTML = html;
        }

        // 高亮关键词
        function highlightKeyword(text, keyword) {
            if (!keyword) return escapeHtml(text);
            const keywordLower = keyword.toLowerCase();
            const regex = new RegExp(`(${escapeRegExp(keyword)})`, 'gi');
            return escapeHtml(text).replace(regex, '<mark style="background: #ffeb3b; padding: 0 2px; border-radius: 2px;">$1</mark>');
        }

        // 转义正则表达式特殊字符
        function escapeRegExp(string) {
            return string.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
        }

        // ==================== 导入回忆备份功能 ====================
        
        // 处理导入的回忆备份文件
        async function handleImportMemoryFile(input) {
            const file = input.files[0];
            if (!file) return;
            
            console.log('=== 开始导入回忆备份 ===');
            console.log('文件名:', file.name);
            console.log('文件大小:', (file.size / 1024 / 1024).toFixed(2), 'MB');
            
            // 显示状态区域
            const statusDiv = document.getElementById('importMemoryStatus');
            const statusText = document.getElementById('importMemoryStatusText');
            const progressFill = document.getElementById('importMemoryProgressFill');
            const detailsDiv = document.getElementById('importMemoryDetails');
            
            statusDiv.style.display = 'block';
            statusText.textContent = '正在读取文件...';
            progressFill.style.width = '10%';
            
            try {
                // 读取文件内容
                const fileContent = await readFileAsText(file);
                statusText.textContent = '正在解析 JSON...';
                progressFill.style.width = '30%';
                
                // 解析 JSON
                let backupData;
                try {
                    backupData = JSON.parse(fileContent);
                } catch (e) {
                    throw new Error('JSON 解析失败，请检查文件格式是否正确');
                }
                
                console.log('备份数据结构:', Object.keys(backupData));
                
                // 检测文件格式并提取数据
                let messages = [];
                let memories = [];
                let importStats = { totalMessages: 0, totalMemories: 0 };
                
                // 格式1: 新格式 (chat_backup_import.json)
                if (backupData.version && backupData.messages && Array.isArray(backupData.messages)) {
                    console.log('检测到新格式备份文件');
                    messages = backupData.messages;
                    memories = backupData.memories || [];
                    importStats = backupData.stats || { totalMessages: messages.length, totalMemories: memories.length };
                }
                // 格式2: 旧格式 (EPhone格式，有 chatData.history)
                else if (backupData.chatData && backupData.chatData.history) {
                    console.log('检测到旧格式备份文件 (EPhone格式)');
                    messages = convertEPhoneFormat(backupData.chatData.history);
                }
                // 格式3: 纯消息数组格式
                else if (Array.isArray(backupData)) {
                    console.log('检测到纯消息数组格式');
                    messages = backupData;
                }
                else {
                    throw new Error('无法识别的备份文件格式');
                }
                
                console.log(`找到 ${messages.length} 条消息记录`);
                if (memories.length > 0) {
                    console.log(`找到 ${memories.length} 条长期记忆`);
                }
                
                statusText.textContent = `找到 ${messages.length} 条消息，正在处理...`;
                progressFill.style.width = '50%';
                detailsDiv.textContent = `消息数量: ${messages.length} 条${memories.length > 0 ? ', 记忆: ' + memories.length + ' 条' : ''}`;
                
                // 【修复】确认导入，添加选项让用户选择是否总结历史消息
                const confirmMessage = 
                    `检测到备份文件包含 ${messages.length} 条消息记录${memories.length > 0 ? '和 ' + memories.length + ' 条长期记忆' : ''}。\n\n` +
                    `导入将：\n` +
                    `1. 将这些消息添加到当前聊天记录\n` +
                    (memories.length > 0 ? '2. 导入已有的长期记忆\n' : '2. 不自动提取长期记忆（避免处理大量历史消息）\n') +
                    `\n【重要】导入大量历史消息时：\n` +
                    `• 系统不会自动总结这些历史消息\n` +
                    `• 只会总结导入后新发送的消息\n` +
                    `• 如需总结历史消息，请使用"立即总结记忆"功能\n` +
                    `\n是否继续导入？`;
                
                const confirmed = confirm(confirmMessage);
                
                if (!confirmed) {
                    statusText.textContent = '已取消导入';
                    progressFill.style.width = '0%';
                    input.value = '';
                    return;
                }
                
                statusText.textContent = '正在导入消息...';
                progressFill.style.width = '70%';
                
                // 导入消息
                const importResult = await importChatHistoryV2(messages);
                
                statusText.textContent = memories.length > 0 ? '正在导入长期记忆...' : '正在提取长期记忆...';
                progressFill.style.width = '90%';
                
                // 导入长期记忆（如果备份中有）
                let memoryResult = { memoryCount: 0 };
                if (memories.length > 0) {
                    memoryResult = await importMemories(memories);
                }
                // 注意：不再自动从消息中提取长期记忆
                
                progressFill.style.width = '100%';
                statusText.textContent = '导入完成！';
                document.getElementById('importMemoryStatusIcon').textContent = '✅';
                
                detailsDiv.innerHTML = `
                    <div style="color: #4caf50;">
                        ✅ 成功导入 ${importResult.importedCount} 条消息<br>
                        ✅ ${memories.length > 0 ? '导入' : '提取'} ${memoryResult.memoryCount} 条长期记忆
                    </div>
                `;

                // 刷新聊天界面
                await refreshChatInterface();

                // 显示成功提示
                showToast(`成功导入 ${importResult.importedCount} 条消息和 ${memoryResult.memoryCount} 条记忆！`);
                
                console.log('=== 导入回忆备份完成 ===');
                
            } catch (error) {
                console.error('导入失败:', error);
                statusText.textContent = '导入失败';
                document.getElementById('importMemoryStatusIcon').textContent = '❌';
                detailsDiv.innerHTML = `<div style="color: #f44336;">错误: ${error.message}</div>`;
                showToast('导入失败: ' + error.message, 'error');
            } finally {
                input.value = '';
            }
        }
        
        // 读取文件为文本
        function readFileAsText(file) {
            return new Promise((resolve, reject) => {
                const reader = new FileReader();
                reader.onload = (e) => resolve(e.target.result);
                reader.onerror = (e) => reject(new Error('文件读取失败'));
                reader.readAsText(file);
            });
        }
        
        // 导入聊天记录
        async function importChatHistory(history) {
            if (!currentChatId) {
                throw new Error('请先选择一个聊天');
            }
            
            const chatItem = relationshipData.wechatChatList.find(item => item.id == currentChatId);
            if (!chatItem) {
                throw new Error('当前聊天不存在');
            }
            
            // 确保消息数组存在
            if (!chatItem.messages) {
                chatItem.messages = [];
            }
            
            let importedCount = 0;
            const existingTimestamps = new Set(chatItem.messages.map(m => m.timestamp));
            
            // 转换并添加消息
            for (const msg of history) {
                // 跳过系统消息和隐藏消息
                if (msg.role === 'system' || msg.isHidden) continue;
                
                // 转换消息格式
                const convertedMsg = convertBackupMessage(msg);
                if (!convertedMsg) continue;
                
                // 检查是否已存在（通过时间戳）
                if (existingTimestamps.has(convertedMsg.timestamp)) continue;
                
                chatItem.messages.push(convertedMsg);
                importedCount++;
            }
            
            // 按时间戳排序
            chatItem.messages.sort((a, b) => a.timestamp - b.timestamp);
            
            // 同时添加到全局 chatMessages
            if (!relationshipData.chatMessages) {
                relationshipData.chatMessages = [];
            }
            
            for (const msg of chatItem.messages) {
                const globalMsg = {
                    ...msg,
                    chatId: currentChatId,
                    chatName: chatItem.name || '未知聊天'
                };
                
                // 检查全局消息是否已存在
                const exists = relationshipData.chatMessages.some(
                    m => m.timestamp === msg.timestamp && m.chatId === currentChatId
                );
                
                if (!exists) {
                    relationshipData.chatMessages.push(globalMsg);
                }
            }
            
            // 保存数据
            await saveData();
            
            return { importedCount };
        }
        
        // 转换备份消息格式为应用格式
        function convertBackupMessage(msg) {
            if (!msg.content) return null;
            
            // 确定发送者
            let sender, senderName;
            if (msg.role === 'user') {
                sender = 'user';
                senderName = '我';
            } else if (msg.role === 'assistant') {
                sender = 'other';
                senderName = msg.senderName || 'AI';
            } else {
                return null; // 跳过其他角色
            }
            
            // 确保 content 是字符串
            let contentStr = ensureStringContent(msg.content);
            
            // 如果内容为空，跳过
            if (!contentStr || contentStr.trim() === '') return null;
            
            // 【修复】保留原始消息的所有重要字段
            return {
                id: 'msg_' + Date.now() + '_' + Math.random().toString(36).substr(2, 9),
                content: contentStr,
                sender: sender,
                senderName: senderName,
                timestamp: msg.timestamp || Date.now(),
                type: msg.type || 'text',
                avatar: sender === 'other' ? currentChatAvatar : currentUserAvatar,
                // 【修复】保留引用信息
                quote: msg.quote || null,
                // 【修复】保留语音消息的转文字内容
                transcript: msg.transcript || null,
                // 【修复】保留其他可能的字段
                isGroupChat: msg.isGroupChat || false,
                senderAvatar: msg.senderAvatar || null
            };
        }
        
        // 提取并保存长期记忆
        async function extractAndSaveMemories(history) {
            if (!currentChatId) return { memoryCount: 0 };
            
            // 先处理所有消息，确保 content 是字符串
            const processedHistory = history.map(msg => ({
                ...msg,
                content: ensureStringContent(msg.content)
            }));
            
            // 过滤出有效的对话消息
            const validMessages = processedHistory.filter(msg => 
                (msg.role === 'user' || msg.role === 'assistant') && 
                msg.content && 
                typeof msg.content === 'string' &&
                !msg.isHidden &&
                msg.content.trim().length > 5
            );
            
            if (validMessages.length === 0) {
                return { memoryCount: 0 };
            }
            
            // 按时间分组（每10条消息为一组记忆）
            const memoryGroups = [];
            const groupSize = 10;
            
            for (let i = 0; i < validMessages.length; i += groupSize) {
                const group = validMessages.slice(i, i + groupSize);
                const firstMsg = group[0];
                const lastMsg = group[group.length - 1];
                
                // 生成记忆摘要
                const summary = generateMemorySummary(group);
                
                memoryGroups.push({
                    id: 'memory_' + Date.now() + '_' + i,
                    chatId: currentChatId,
                    timestamp: lastMsg.timestamp || Date.now(),
                    summary: summary,
                    detail: group.map(m => `${m.senderName || m.role}: ${m.content}`).join('\n'),
                    messageCount: group.length,
                    startTime: firstMsg.timestamp,
                    endTime: lastMsg.timestamp
                });
            }
            
            // 确保记忆数组存在
            if (!relationshipData.memories) {
                relationshipData.memories = [];
            }
            
            // 添加记忆（避免重复）
            let addedCount = 0;
            for (const memory of memoryGroups) {
                // 检查是否已存在相似记忆
                const exists = relationshipData.memories.some(m => 
                    m.chatId === currentChatId && 
                    Math.abs(m.timestamp - memory.timestamp) < 60000 // 1分钟内视为重复
                );
                
                if (!exists) {
                    relationshipData.memories.push(memory);
                    addedCount++;
                }
            }
            
            // 保存数据
            if (addedCount > 0) {
                await saveData();
            }
            
            return { memoryCount: addedCount };
        }
        
        // 生成记忆摘要
        function generateMemorySummary(messages) {
            // 提取关键词和主题
            const contents = messages.map(m => m.content).join(' ');
            
            // 简单的摘要生成逻辑
            let summary = '';
            
            // 检查是否有约会记录
            if (contents.includes('约会') || contents.includes('见面')) {
                summary += '愉快的约会时光';
            } else if (contents.includes('医院') || contents.includes('手术')) {
                summary += '关心健康的话题';
            } else if (contents.includes('想') || contents.includes('爱') || contents.includes('喜欢')) {
                summary += '表达思念和爱意';
            } else if (contents.includes('晚安') || contents.includes('早安')) {
                summary += '日常问候';
            } else {
                summary += '日常对话交流';
            }
            
            // 添加时间信息
            const firstMsg = messages[0];
            if (firstMsg && firstMsg.timestamp) {
                const date = new Date(firstMsg.timestamp);
                summary += ` (${date.getMonth() + 1}月${date.getDate()}日)`;
            }
            
            return summary;
        }
        
        // ==================== 新的导入功能函数 ====================
        
        // 转换 EPhone 格式为新格式
        function convertEPhoneFormat(history) {
            return history
                .filter(msg => msg.role !== 'system' && !msg.isHidden)
                .map((msg, index) => {
                    let sender, senderName;
                    if (msg.role === 'user') {
                        sender = 'user';
                        senderName = '我';
                    } else if (msg.role === 'assistant') {
                        sender = 'ai';
                        senderName = msg.senderName || 'AI';
                    } else {
                        return null;
                    }
                    
                    // 确保 content 是字符串（使用 ensureStringContent 逻辑）
                    let contentStr;
                    if (typeof msg.content === 'string') {
                        contentStr = msg.content;
                    } else if (Array.isArray(msg.content)) {
                        const texts = [];
                        for (const item of msg.content) {
                            if (typeof item === 'string') {
                                texts.push(item);
                            } else if (typeof item === 'object' && item !== null) {
                                if (item.type === 'text' && item.text) {
                                    texts.push(item.text);
                                }
                            }
                        }
                        contentStr = texts.join('\n');
                    } else if (typeof msg.content === 'object' && msg.content !== null) {
                        if (msg.content.text) {
                            contentStr = msg.content.text;
                        } else {
                            contentStr = JSON.stringify(msg.content);
                        }
                    } else {
                        contentStr = String(msg.content || '');
                    }
                    
                    // 【修复】保留原始消息的类型和引用信息
                    const msgType = msg.type || 'message';
                    
                    return {
                        id: `msg_import_${index}`,
                        sender: sender,
                        senderName: senderName,
                        senderAvatar: msg.senderAvatar || '',
                        content: contentStr,
                        timestamp: msg.timestamp || Date.now(),
                        chatId: currentChatId,
                        chatName: '导入的聊天记录',
                        type: msgType,
                        isGroupChat: msg.isGroupChat || false,
                        quote: msg.quote || null,
                        transcript: msg.transcript || null
                    };
                })
                .filter(msg => msg !== null);
        }
        
        // 确保 content 是字符串
        function ensureStringContent(content) {
            if (typeof content === 'string') {
                return content;
            }
            if (Array.isArray(content)) {
                // 提取数组中的文本内容
                const texts = [];
                for (const item of content) {
                    if (typeof item === 'string') {
                        texts.push(item);
                    } else if (typeof item === 'object' && item !== null) {
                        if (item.type === 'text' && item.text) {
                            texts.push(item.text);
                        }
                    }
                }
                return texts.join('\n');
            }
            if (typeof content === 'object' && content !== null) {
                if (content.text) {
                    return content.text;
                }
                return JSON.stringify(content);
            }
            return String(content || '');
        }
        
        // 新版导入聊天记录（支持新格式）
        async function importChatHistoryV2(messages) {
            if (!currentChatId) {
                throw new Error('请先选择一个聊天');
            }
            
            const chatItem = relationshipData.wechatChatList.find(item => item.id == currentChatId);
            if (!chatItem) {
                throw new Error('当前聊天不存在');
            }
            
            // 确保消息数组存在
            if (!relationshipData.chatMessages) {
                relationshipData.chatMessages = [];
            }
            
            let importedCount = 0;
            const existingTimestamps = new Set(
                relationshipData.chatMessages
                    .filter(m => m.chatId === currentChatId)
                    .map(m => m.timestamp)
            );
            
            // 转换并添加消息
            for (const msg of messages) {
                // 跳过无效消息
                if (!msg.content) continue;
                
                // 转换消息格式（如果是旧格式）
                let convertedMsg;
                if (msg.role && !msg.sender) {
                    // 需要转换（旧格式）
                    convertedMsg = convertBackupMessage(msg);
                    if (!convertedMsg) continue;
                } else {
                    // 【修复】新格式，保留所有原始字段
                    convertedMsg = { ...msg };
                }
                
                // 确保 content 是字符串
                convertedMsg.content = ensureStringContent(convertedMsg.content);
                
                // 如果转换后内容为空，跳过
                if (!convertedMsg.content || convertedMsg.content.trim() === '') continue;
                
                // 【修复】确保关键字段存在
                convertedMsg.type = convertedMsg.type || 'text';
                convertedMsg.quote = convertedMsg.quote || null;
                convertedMsg.transcript = convertedMsg.transcript || null;
                
                // 更新 chatId 为当前聊天
                convertedMsg.chatId = currentChatId;
                convertedMsg.chatName = chatItem.name || '导入的聊天记录';
                
                // 检查是否已存在（通过时间戳）
                if (existingTimestamps.has(convertedMsg.timestamp)) continue;
                
                // 添加到全局消息列表
                relationshipData.chatMessages.push(convertedMsg);
                importedCount++;
            }
            
            // 按时间戳排序
            relationshipData.chatMessages.sort((a, b) => a.timestamp - b.timestamp);
            
            // 【修复】更新totalMessageCount，避免导入大量消息后触发一次性总结
            if (importedCount > 0) {
                if (typeof chatItem.totalMessageCount !== 'number') {
                    chatItem.totalMessageCount = 0;
                }
                chatItem.totalMessageCount += importedCount;
                console.log(`【导入】更新totalMessageCount: +${importedCount}, 当前总数: ${chatItem.totalMessageCount}`);
                
                // 【修复】改进导入时的计数逻辑：
                // 1. 如果导入的消息数量很大（>50条），将summarizedMessageCount设置为与totalMessageCount相同
                // 2. 如果已经有summarizedMessageCount，也同步更新，保持两者一致
                // 这样可以避免导入历史消息后触发大量自动总结
                if (importedCount > 50) {
                    // 导入大量历史消息，将这些消息视为已总结
                    chatItem.summarizedMessageCount = chatItem.totalMessageCount;
                    console.log(`【导入】导入大量消息(${importedCount}条)，设置summarizedMessageCount=${chatItem.summarizedMessageCount}，这些历史消息不会触发自动总结`);
                } else if (typeof chatItem.summarizedMessageCount !== 'number') {
                    // 如果没有summarizedMessageCount，初始化为0
                    chatItem.summarizedMessageCount = 0;
                    console.log(`【导入】初始化summarizedMessageCount为0`);
                }
                // 注意：如果导入少量消息（<=50条）且已有summarizedMessageCount，保持原值
                // 这样新导入的消息会被正常计数，可能触发总结
            }
            
            // 保存数据
            await saveData();
            
            return { importedCount };
        }
        
        // 导入长期记忆（新格式）
        async function importMemories(memories) {
            if (!currentChatId) return { memoryCount: 0 };
            
            // 确保记忆数组存在
            if (!relationshipData.memories) {
                relationshipData.memories = [];
            }
            
            let addedCount = 0;
            
            for (const memory of memories) {
                // 更新 chatId 为当前聊天
                const newMemory = {
                    ...memory,
                    chatId: currentChatId
                };
                
                // 检查是否已存在相似记忆
                const exists = relationshipData.memories.some(m => 
                    m.chatId === currentChatId && 
                    Math.abs(m.timestamp - newMemory.timestamp) < 60000
                );
                
                if (!exists) {
                    relationshipData.memories.push(newMemory);
                    addedCount++;
                }
            }
            
            // 保存数据
            if (addedCount > 0) {
                await saveData();
            }
            
            return { memoryCount: addedCount };
        }
        
        // 新版提取长期记忆（支持新格式）
        async function extractAndSaveMemoriesV2(messages) {
            if (!currentChatId) return { memoryCount: 0 };
            
            // 先确保所有消息的 content 都是字符串
            const processedMessages = messages.map(msg => ({
                ...msg,
                content: ensureStringContent(msg.content)
            }));
            
            // 过滤出有效的对话消息
            const validMessages = processedMessages.filter(msg => 
                (msg.sender === 'user' || msg.sender === 'ai') && 
                msg.content && 
                typeof msg.content === 'string' &&
                msg.content.trim().length > 5
            );
            
            if (validMessages.length === 0) {
                return { memoryCount: 0 };
            }
            
            // 按时间分组（每20条消息为一组记忆）
            const memoryGroups = [];
            const groupSize = 20;
            
            for (let i = 0; i < validMessages.length; i += groupSize) {
                const group = validMessages.slice(i, i + groupSize);
                const firstMsg = group[0];
                const lastMsg = group[group.length - 1];
                
                // 生成记忆摘要
                const summary = generateMemorySummaryV2(group);
                
                memoryGroups.push({
                    id: 'memory_' + Date.now() + '_' + i,
                    chatId: currentChatId,
                    timestamp: lastMsg.timestamp || Date.now(),
                    summary: summary,
                    detail: group.map(m => `${m.senderName || m.sender}: ${m.content}`).join('\n'),
                    messageCount: group.length,
                    startTime: firstMsg.timestamp,
                    endTime: lastMsg.timestamp
                });
            }
            
            // 确保记忆数组存在
            if (!relationshipData.memories) {
                relationshipData.memories = [];
            }
            
            // 添加记忆（避免重复）
            let addedCount = 0;
            for (const memory of memoryGroups) {
                const exists = relationshipData.memories.some(m => 
                    m.chatId === currentChatId && 
                    Math.abs(m.timestamp - memory.timestamp) < 60000
                );
                
                if (!exists) {
                    relationshipData.memories.push(memory);
                    addedCount++;
                }
            }
            
            // 保存数据
            if (addedCount > 0) {
                await saveData();
            }
            
            return { memoryCount: addedCount };
        }
        
        // 新版生成记忆摘要
        function generateMemorySummaryV2(messages) {
            const contents = messages.map(m => m.content).join(' ');
            let summary = '';
            
            if (contents.includes('约会') || contents.includes('见面') || contents.includes('吃饭')) {
                summary = '愉快的约会时光';
            } else if (contents.includes('医院') || contents.includes('手术') || contents.includes('病')) {
                summary = '关心健康的话题';
            } else if (contents.includes('想') || contents.includes('爱') || contents.includes('喜欢') || contents.includes('老公') || contents.includes('老婆')) {
                summary = '甜蜜的对话';
            } else if (contents.includes('晚安') || contents.includes('早安') || contents.includes('睡')) {
                summary = '日常问候';
            } else if (contents.includes('工作') || contents.includes('忙')) {
                summary = '工作生活交流';
            } else {
                summary = '日常对话';
            }
            
            const firstMsg = messages[0];
            if (firstMsg && firstMsg.timestamp) {
                const date = new Date(firstMsg.timestamp);
                summary += ` (${date.getMonth() + 1}月${date.getDate()}日)`;
            }
            
            return summary;
        }
        
        // 更新角色卡片中的头像
        async function updateRoleCardAvatar() {
            if (currentChatId) {
                const chatItems = document.querySelectorAll('.wechat-chat-item');
                for (const item of chatItems) {
                    const chatId = parseInt(item.getAttribute('data-chat-id'));
                    if (chatId == currentChatId) {
                        const chatItem = relationshipData.wechatChatList.find(c => c.id == currentChatId);
                        if (chatItem && chatItem.avatar) {
                            const avatarElement = item.querySelector('.wechat-chat-avatar');
                            if (avatarElement) {
                                let avatarSrc = chatItem.avatar;
                                let loadedFromDB = false;

                                // 如果头像是引用键，从IndexedDB加载
                                if (chatItem.avatar.startsWith('chatAvatar_')) {
                                    try {
                                        const avatarImage = await loadImageFromDB(chatItem.avatar);
                                        if (avatarImage) {
                                            avatarSrc = avatarImage;
                                            loadedFromDB = true;
                                        }
                                    } catch (err) {
                                        console.warn(`加载头像失败: ${chatItem.avatar}`, err);
                                    }
                                }

                                // 检查是否是emoji
                                const isEmoji = avatarSrc.length <= 2 && /\p{Emoji}/u.test(avatarSrc);

                                // 【关键修复】如果是引用键且从IndexedDB加载失败，显示加载中状态
                                const isReferenceKey = avatarSrc.startsWith('chatAvatar_');

                                let avatarContent;
                                if (isEmoji) {
                                    avatarContent = avatarSrc;
                                } else if (isValidImageUrl(avatarSrc)) {
                                    avatarContent = `<img src="${avatarSrc}" style="width: 40px; height: 40px; border-radius: 0; object-fit: cover;">`;
                                } else if (isReferenceKey && !loadedFromDB) {
                                    // 引用键但加载失败，显示占位符并尝试重新加载
                                    avatarContent = `<div style="width: 40px; height: 40px; background-color: #e0e0e0; display: flex; align-items: center; justify-content: center; font-size: 20px;">⏳</div>`;
                                    // 延迟重新加载
                                    setTimeout(() => updateRoleCardAvatar(), 500);
                                } else {
                                    avatarContent = '头像';
                                }

                                avatarElement.innerHTML = avatarContent;
                                avatarElement.style = `width: 40px; height: 40px; border-radius: 0; display: flex; align-items: center; justify-content: center; ${isEmoji ? 'font-size: 28px;' : (!avatarSrc || (isReferenceKey && !loadedFromDB) ? 'background-color: #e0e0e0; color: #999; font-size: 12px;' : '')}`;
                            }
                        }
                    }
                }
            }
        }
        
        // 更新聊天背景
        async function updateChatBackground() {
            if (currentChatId) {
                const chatItem = relationshipData.wechatChatList.find(item => item.id == currentChatId);
                const chatContent = document.getElementById('chatContent');
                if (chatItem && chatItem.background && chatContent) {
                    let bgSrc = chatItem.background;
                    
                    // 如果背景是引用键，从IndexedDB加载
                    if (chatItem.background.startsWith('chatBackground_')) {
                        try {
                            const bgImage = await loadImageFromDB(chatItem.background);
                            if (bgImage) {
                                bgSrc = bgImage;
                            }
                        } catch (err) {
                            console.warn(`加载背景失败: ${chatItem.background}`, err);
                        }
                    }
                    
                    chatContent.style.backgroundImage = `url(${bgSrc})`;
                    chatContent.style.backgroundSize = 'cover';
                    chatContent.style.backgroundPosition = 'center';
                    chatContent.style.backgroundRepeat = 'no-repeat';
                } else if (chatContent) {
                    // 如果没有设置背景，使用默认灰色
                    chatContent.style.backgroundImage = 'none';
                    chatContent.style.backgroundColor = '#f5f5f5';
                }
            }
        }
        
        // 计算Token值
        function calculateTokenEstimate() {
            // 获取各部分内容
            const personality = document.getElementById('chatSettingsPersonality').value;
            
            // 计算各部分的Token值（1 token ≈ 4 个字符）
            const tokenPersonality = Math.ceil(personality.length / 4);
            
            // 根据实际选中的世界书内容计算token值
            let tokenWorldbook = 0;
            if (currentChatId) {
                const chatItem = relationshipData.wechatChatList.find(item => item.id == currentChatId);
                if (chatItem && chatItem.worldbooks && Array.isArray(chatItem.worldbooks)) {
                    chatItem.worldbooks.forEach(id => {
                        const selectedWorldbook = relationshipData.worldBooks.find(book => book.id == id);
                        if (selectedWorldbook && selectedWorldbook.content) {
                            tokenWorldbook += Math.ceil(selectedWorldbook.content.length / 4);
                        }
                    });
                }
            }
            
            // 计算长期记忆的Token值
            let tokenMemory = 0;
            if (currentChatId) {
                const chatItem = relationshipData.wechatChatList.find(item => item.id == currentChatId);
                if (chatItem && chatItem.memories && Array.isArray(chatItem.memories)) {
                    const mountCount = chatItem.memoryMountCount || 5;
                    const mountedMemories = chatItem.memories.slice(-mountCount);
                    mountedMemories.forEach(memory => {
                        tokenMemory += Math.ceil(memory.content.length / 4);
                    });
                }
            }
            
            // 计算实际上下文消息的Token值
            let tokenContext = 0;
            if (currentChatId && relationshipData.chatMessages) {
                const currentMessages = relationshipData.chatMessages.filter(msg => msg.chatId === currentChatId);
                if (currentMessages.length > 0) {
                    // 只计算最新的20条消息（默认上下文长度）
                    const recentMessages = currentMessages.slice(-20);
                    const contextText = recentMessages.map(msg => ensureStringContent(msg.content)).join(' ');
                    tokenContext = Math.ceil(contextText.length / 4);
                }
            }
            
            const tokenTotal = tokenPersonality + tokenWorldbook + tokenMemory + tokenContext;
            
            // 更新页面显示
            document.getElementById('tokenPersonality').textContent = tokenPersonality;
            document.getElementById('tokenWorldbook').textContent = tokenWorldbook;
            document.getElementById('tokenMemory').textContent = tokenMemory;
            document.getElementById('tokenContext').textContent = tokenContext;
            document.getElementById('tokenTotal').textContent = tokenTotal;
        }
        

        
        // 预览聊天头像
        function previewChatAvatar(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    const avatarPreview = document.getElementById('chatAvatarPreview');
                    avatarPreview.innerHTML = `<img src="${e.target.result}" style="width: 100%; height: 100%; border-radius: 50%; object-fit: cover;">`;
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        // 预览信件字体
        function previewLetterFont() {
            const fontInput = document.getElementById('chatSettingsLetterFont');
            const previewDiv = document.getElementById('letterFontPreview');
            const previewText = document.getElementById('letterFontPreviewText');
            const fontValue = fontInput.value.trim();

            if (fontValue) {
                previewDiv.style.display = 'block';
                
                // 检查是否是 URL|字体名 格式
                if (fontValue.includes('|')) {
                    const parts = fontValue.split('|');
                    const fontUrl = parts[0].trim();
                    const fontFamily = parts[1].trim();
                    
                    if (fontUrl.startsWith('http://') || fontUrl.startsWith('https://')) {
                        // 动态加载字体CSS
                        const linkId = 'preview-font-link';
                        let existingLink = document.getElementById(linkId);
                        if (existingLink) {
                            existingLink.href = fontUrl;
                        } else {
                            const link = document.createElement('link');
                            link.id = linkId;
                            link.rel = 'stylesheet';
                            link.href = fontUrl;
                            document.head.appendChild(link);
                        }
                        previewText.style.fontFamily = `"${fontFamily}", sans-serif`;
                    }
                }
                // 检查是否是纯URL（字体链接）
                else if (fontValue.startsWith('http://') || fontValue.startsWith('https://')) {
                    // 尝试从Google Fonts URL中提取字体名
                    let fontFamily = '';
                    if (fontValue.includes('fonts.googleapis.com') && fontValue.includes('family=')) {
                        const match = fontValue.match(/family=([^&:]+)/);
                        if (match) {
                            fontFamily = match[1].replace(/\+/g, ' ');
                        }
                    }
                    
                    // 动态加载字体CSS
                    const linkId = 'preview-font-link';
                    let existingLink = document.getElementById(linkId);
                    if (existingLink) {
                        existingLink.href = fontValue;
                    } else {
                        const link = document.createElement('link');
                        link.id = linkId;
                        link.rel = 'stylesheet';
                        link.href = fontValue;
                        document.head.appendChild(link);
                    }
                    
                    if (fontFamily) {
                        previewText.style.fontFamily = `"${fontFamily}", sans-serif`;
                    } else {
                        // 无法提取字体名，使用默认方式
                        previewText.style.fontFamily = "'Custom Font', 'PING FANG CHANG AN', sans-serif";
                    }
                } else {
                    // 直接使用CSS字体族
                    previewText.style.fontFamily = fontValue;
                }
            } else {
                previewDiv.style.display = 'none';
            }
        }
        
        // 预览聊天背景
        function previewChatBackground(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    const backgroundPreview = document.getElementById('chatBackgroundPreview');
                    backgroundPreview.style.backgroundImage = `url(${e.target.result})`;
                    backgroundPreview.style.backgroundSize = 'cover';
                    backgroundPreview.style.backgroundPosition = 'center';
                    backgroundPreview.innerHTML = '';
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        // 初始化所有内容功能
        async function initializeAll() {
            if (confirm('确定要初始化所有内容吗？此操作将删除所有数据，不可恢复。')) {
                try {
                    // 清空localforage
                    await localforage.clear();
                    
                    // 清空IndexedDB中的所有图片
                    await clearImageDB();
                    
                    // 重置relationshipData
                    relationshipData = {
                        title: '我们在一起已经',
                        startDate: new Date('2024-01-01'),
                        cardBg: '',
                        avatar1: 'https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=cartoon%20avatar%20of%20a%20boy%2C%20cute%2C%20simple%20style&image_size=square',
                        avatar2: 'https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=cartoon%20avatar%20of%20a%20girl%2C%20cute%2C%20simple%20style&image_size=square',
                        topCardBg: '',
                        dynamicImage: '',
                        leftBubbleText: '你好',
                        rightBubbleText: '你好',
                        leftBubbleAvatar: '',
                        rightBubbleAvatar: '',
                        theme: {
                            mainBg: '',
                            appIcons: {
                                wechat: '',
                                worldbook: '',
                                note: '',
                                study: '',
                                couple: '',
                                diary: '',
                                theme: '',
                                settings: '',
                                accounting: '',
                                footprint: ''
                            }
                        },
                        mood: {
                            type: 'happy',
                            emoji: '😊',
                            text: '开心',
                            customImage: '',
                            timestamp: Date.now()
                        },
                        // 情侣空间相关数据
                        coupleSpaceEnabled: false,
                        couplePartnerId: null,
                        couplePartnerName: '',
                        coupleStartDate: null,
                        coupleWallBackground: '',
                        coupleCardBackground: '',
                        coupleAvatars: {
                            top: '',
                            left: '',
                            right: ''
                        },
                        // 情侣空间颜色设置
                        coupleHeaderColor: '',
                        coupleFooterColor: '',
                        coupleHeaderTextStroke: '',
                        // 卡片背景设置
                        coupleCardHeaderBg: '',
                        coupleCardHeaderStroke: '',
                        coupleCardFooterBg: '',
                        // 按钮文本颜色
                        footprintTextColor: '',
                        moodTextColor: '',
                        blackroomTextColor: '',
                        // 旋转木马显示设置
                        coupleCarouselVisible: true,
                        // 爱人动态记录
                        coupleActivityLogs: []
                    };
                    
                    // 保存重置后的数据
                    saveData();
                    
                    // 重新加载设置
                    loadSettings();
                    updatePresetSelect();
                    
                    alert('初始化完成，所有数据已重置');
                } catch (error) {
                    console.error('初始化失败:', error);
                    alert('初始化失败，请稍后再试');
                }
            }
        }

        // 当前选中的邀请对象
        let currentInviteCharacterId = null;
        let currentInviteCharacterName = null;

        // 打开情侣空间入口（判断是邀请还是直接进入）
        function openCoupleSpace() {
            // 检查是否已开启情侣空间
            if (relationshipData.coupleSpaceEnabled && relationshipData.couplePartnerId) {
                // 已开启，直接进入
                enterCoupleSpacePage();
            } else {
                // 未开启，显示邀请弹窗
                showCoupleInviteModal();
            }
        }

        // 进入情侣空间页面
        function enterCoupleSpacePage() {
            // 检查是否有权限（只有伴侣才能进入）
            if (!relationshipData.coupleSpaceEnabled || !relationshipData.couplePartnerId) {
                showToast('请先开启情侣空间');
                return;
            }
            
            // 检查当前聊天是否是伴侣
            if (currentChatId && currentChatId != relationshipData.couplePartnerId) {
                showToast('只有你的伴侣才能进入情侣空间');
                return;
            }
            
            const coupleSpacePage = document.getElementById('coupleSpacePage');
            coupleSpacePage.style.display = 'flex';
            
            // 加载照片墙壁纸
            const polaroidWall = document.getElementById('polaroidWall');
            if (polaroidWall && relationshipData.coupleWallBackground) {
                polaroidWall.style.background = `url(${relationshipData.coupleWallBackground}) center/cover`;
            }
            
            // 加载头像
            loadCoupleSpaceAvatars();
            
            // 启动时间更新
            startTimeUpdate();
            
            // 加载按钮图标
            loadButtonIcons();
            
            // 初始化拍立得随机排列
            initPolaroidRandomLayout();
            
            // 【修复】加载拍立得数据
            loadPolaroidData();
            
            // 加载恶魔问卷
            loadDemonQuiz();
        }

        // 显示邀请弹窗
        function showCoupleInviteModal() {
            const modal = document.getElementById('coupleInviteModal');
            modal.style.display = 'flex';
            loadInviteCharacterList();
        }

        // 关闭邀请弹窗
        function closeCoupleInviteModal() {
            document.getElementById('coupleInviteModal').style.display = 'none';
        }

        // 调试入口：绕过邀请直接进入情侣空间
        async function debugEnterCoupleSpace() {
            console.log('=== 调试入口：直接进入情侣空间 ===');
            
            // 关闭邀请弹窗
            closeCoupleInviteModal();
            
            // 设置一个默认的伴侣（用于测试）
            const defaultLover = {
                id: 'debug_lover',
                name: '测试伴侣',
                avatar: 'https://api.dicebear.com/7.x/avataaars/svg?seed=lover',
                isDebug: true
            };
            
            // 保存到本地存储
            await localforage.setItem('coupleLover', defaultLover);
            await localforage.setItem('coupleSpaceEnabled', true);
            await localforage.setItem('coupleStartDate', new Date().toISOString());
            
            console.log('已设置测试伴侣:', defaultLover);
            
            // 更新 relationshipData
            relationshipData.coupleSpaceEnabled = true;
            relationshipData.couplePartnerId = defaultLover.id;
            relationshipData.couplePartnerName = defaultLover.name;
            relationshipData.couplePartnerAvatar = defaultLover.avatar;
            
            // 直接进入情侣空间
            enterCoupleSpacePage();
            
            // 显示提示
            showToast('调试模式：已进入情侣空间（测试数据）');
        }

        // 加载可邀请的AI角色列表
        function loadInviteCharacterList() {
            const container = document.getElementById('coupleInviteCharacterList');
            container.innerHTML = '';
            
            // 获取所有聊天角色（排除群聊）
            const allCharacters = relationshipData.wechatChatList.filter(chat => !chat.isGroup);
            
            if (allCharacters.length === 0) {
                container.innerHTML = '<p style="text-align: center; color: #999;">暂无角色，请先在微信聊天列表创建角色</p>';
                return;
            }
            
            allCharacters.forEach(character => {
                const item = document.createElement('div');
                item.className = 'couple-invite-character-item';
                item.onclick = () => selectCharacterForInvite(character);
                
                // 处理头像显示
                let avatarContent = '';
                if (character.avatar) {
                    const isEmoji = character.avatar.length <= 2 && /\p{Emoji}/u.test(character.avatar);
                    if (isEmoji) {
                        avatarContent = `<div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; font-size: 28px;">${character.avatar}</div>`;
                    } else {
                        avatarContent = `<img src="${character.avatar}" alt="${character.remark || character.name}" style="width: 100%; height: 100%; object-fit: cover;">`;
                    }
                } else {
                    avatarContent = `<div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; background: #e0e0e0; color: #999; font-size: 12px;">头像</div>`;
                }
                
                item.innerHTML = `
                    <div class="couple-invite-avatar">
                        ${avatarContent}
                    </div>
                    <div class="couple-invite-info">
                        <div class="couple-invite-name">${character.remark || character.name}</div>
                    </div>
                    <div class="couple-invite-arrow">›</div>
                `;
                
                container.appendChild(item);
            });
        }

        // 选择角色发送邀请
        let isInviteSending = false; // 防止重复发送的标志
        
        function selectCharacterForInvite(character) {
            // 防止重复发送
            if (isInviteSending) {
                console.log('邀请正在发送中，跳过重复请求');
                return;
            }
            
            currentInviteCharacterId = character.id;
            currentInviteCharacterName = character.remark || character.name;
            
            // 关闭选择弹窗
            closeCoupleInviteModal();
            
            // 跳转到该角色的聊天界面
            openChatInterface(character.id, currentInviteCharacterName, character.avatar);
            
            // 设置发送标志
            isInviteSending = true;
            
            // 等待聊天界面完全加载后再发送邀请
            // 使用较长的延迟确保DOM完全渲染
            setTimeout(() => {
                // 再次检查聊天界面是否已显示
                const chatInterface = document.getElementById('chatInterface');
                const chatContent = document.getElementById('chatContent');
                
                if (chatInterface && chatInterface.style.display === 'flex' && chatContent) {
                    console.log('聊天界面已加载，开始发送邀请');
                    sendCoupleInviteMessage(character);
                } else {
                    console.log('聊天界面未完全加载，继续等待...');
                    // 如果还没加载好，再等待一段时间
                    setTimeout(() => {
                        sendCoupleInviteMessage(character);
                    }, 800);
                }
                
                // 重置发送标志（在发送完成后）
                setTimeout(() => {
                    isInviteSending = false;
                }, 3000);
            }, 1200);
        }

        // 显示情侣空间邀请信封
        function showCoupleInviteEnvelope(character) {
            const envelope = document.getElementById('coupleInviteEnvelope');
            const senderName = document.getElementById('inviteSenderName');
            
            if (envelope && senderName) {
                senderName.textContent = character.remark || character.name;
                envelope.style.display = 'flex';
                
                // 保存当前邀请信息
                relationshipData.pendingCoupleInvite = {
                    characterId: character.id,
                    characterName: character.remark || character.name,
                    characterAvatar: character.avatar,
                    timestamp: Date.now()
                };
            }
        }

        // 关闭情侣空间邀请信封
        function closeCoupleInviteEnvelope() {
            const envelope = document.getElementById('coupleInviteEnvelope');
            if (envelope) {
                envelope.style.display = 'none';
            }
        }

        // 接受情侣空间邀请
        async function acceptCoupleInvite() {
            console.log('用户接受了情侣空间邀请');
            
            if (!relationshipData.pendingCoupleInvite) {
                showCustomAlert('提示', '邀请已过期', 'warning');
                closeCoupleInviteEnvelope();
                return;
            }
            
            const invite = relationshipData.pendingCoupleInvite;
            
            // 保存情侣空间信息
            relationshipData.coupleSpaceEnabled = true;
            relationshipData.couplePartnerId = invite.characterId;
            relationshipData.couplePartnerName = invite.characterName;
            relationshipData.couplePartnerAvatar = invite.characterAvatar || '';
            relationshipData.coupleStartDate = new Date().toISOString();
            
            // 清除待处理邀请
            delete relationshipData.pendingCoupleInvite;
            
            await saveData();
            
            closeCoupleInviteEnvelope();
            
            showCustomAlert('💕 情侣空间已开启', `你和 ${invite.characterName} 已成为伴侣！`, 'success');
            
            // 进入情侣空间
            enterCoupleSpacePage();
        }

        // 拒绝情侣空间邀请
        async function rejectCoupleInvite() {
            console.log('用户拒绝了情侣空间邀请');
            
            // 清除待处理邀请
            delete relationshipData.pendingCoupleInvite;
            
            await saveData();
            
            closeCoupleInviteEnvelope();
            
            showCustomAlert('提示', '已拒绝邀请', 'info');
        }

        // 发送情侣空间邀请消息
        async function sendCoupleInviteMessage(character) {
            console.log('=== 开始发送情侣空间邀请 ===');
            console.log('角色:', character.remark || character.name);
            
            // 检查是否已经发送过邀请（避免重复发送）
            if (relationshipData.pendingCoupleInvite && 
                relationshipData.pendingCoupleInvite.characterId == character.id) {
                console.log('已经向该角色发送过邀请，跳过重复发送');
                return;
            }
            
            const userName = cachedPersonalProfile?.name || '我';
            const userAvatar = cachedPersonalProfile?.avatar || '';
            
            // 构建精美的HTML邀请卡片
            const inviteHTML = `
                <div class="couple-invite-card">
                    <div class="couple-invite-header">
                        <span class="couple-invite-title">情侣空间邀请</span>
                        <div class="couple-invite-heart">
                            <svg viewBox="0 0 24 24" class="heart-icon">
                                <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                            </svg>
                        </div>
                    </div>
                    <div class="couple-invite-body">
                        <p class="couple-invite-text">我想邀请你成为我的专属伴侣</p>
                        <p class="couple-invite-subtext">一起开启属于我们的情侣空间</p>
                        <div class="couple-invite-features">
                            <div class="feature-item">
                                <span class="feature-icon">👣</span>
                                <span class="feature-text">记录生活足迹</span>
                            </div>
                            <div class="feature-item">
                                <span class="feature-icon">💕</span>
                                <span class="feature-text">发送甜蜜问卷</span>
                            </div>
                            <div class="feature-item">
                                <span class="feature-icon">🔒</span>
                                <span class="feature-text">开启小黑屋模式</span>
                            </div>
                        </div>
                    </div>
                    <div class="couple-invite-footer">
                        <span class="couple-invite-question">你愿意接受我的邀请吗？</span>
                    </div>
                </div>
            `;
            
            try {
                // 检查聊天界面是否准备好
                const chatContent = document.getElementById('chatContent');
                if (!chatContent) {
                    console.error('聊天界面未准备好，无法显示邀请卡片');
                    return;
                }
                
                // 先显示消息，再保存（确保用户能立即看到）
                console.log('正在显示邀请卡片...');
                displayHTMLMessage('user', inviteHTML, userAvatar);
                console.log('邀请卡片显示完成');
                
                // 创建用户消息
                const userMessage = {
                    chatId: character.id,
                    sender: 'user',
                    content: inviteHTML,
                    timestamp: Date.now(),
                    avatar: userAvatar,
                    isCoupleInvite: true, // 标记为情侣空间邀请消息
                    isHTML: true // 标记为HTML内容
                };
                
                // 保存消息
                if (!relationshipData.chatMessages) {
                    relationshipData.chatMessages = [];
                }
                relationshipData.chatMessages.push(userMessage);
                await saveData();
                console.log('邀请消息已保存');
                
                // 保存邀请状态
                relationshipData.pendingCoupleInvite = {
                    characterId: character.id,
                    characterName: character.remark || character.name,
                    timestamp: Date.now(),
                    messageId: userMessage.timestamp
                };
                await saveData();
                console.log('邀请状态已保存');
                
                // 调用AI回复
                console.log(`向 ${character.remark || character.name} 发送情侣空间邀请`);
                
                // 延迟后自动触发AI回复
                setTimeout(async () => {
                    try {
                        await triggerCoupleInviteAIResponse(character, '情侣空间邀请');
                    } catch (error) {
                        console.error('触发AI回复失败:', error);
                    }
                }, 1000);
            } catch (error) {
                console.error('发送邀请消息失败:', error);
            }
            
            console.log('=== 发送情侣空间邀请完成 ===');
        }

        // 显示HTML消息（使用普通消息气泡样式）
        function displayHTMLMessage(sender, htmlContent, avatar) {
            const chatContent = document.getElementById('chatContent');
            if (!chatContent) {
                console.error('chatContent 元素不存在');
                return;
            }
            
            console.log('显示HTML消息:', sender, htmlContent.substring(0, 100) + '...');
            
            // 创建消息容器（使用和普通消息相同的类名）
            const messageContainer = document.createElement('div');
            messageContainer.className = `message-container ${sender}`;
            messageContainer.style.opacity = '0';
            messageContainer.style.transition = 'opacity 0.3s ease';
            
            // 创建头像（使用和普通消息相同的样式）
            const avatarDiv = document.createElement('div');
            avatarDiv.className = 'message-avatar';
            
            if (sender === 'user') {
                // 用户头像 - 使用个人资料中的头像
                const personalProfile = cachedPersonalProfile || {};
                if (personalProfile.avatar && personalProfile.avatar !== '' && personalProfile.avatar !== 'undefined') {
                    avatarDiv.innerHTML = `<img src="${personalProfile.avatar}" style="width: 40px; height: 40px; border-radius: 0; object-fit: cover;" onerror="this.onerror=null; this.parentElement.innerHTML='<div style=\'width: 40px; height: 40px; background-color: #f0f0f0; display: flex; align-items: center; justify-content: center; font-size: 20px;\'>👤</div>'">`;
                } else {
                    avatarDiv.innerHTML = `<div style="width: 40px; height: 40px; background-color: #f0f0f0; display: flex; align-items: center; justify-content: center; font-size: 20px;">👤</div>`;
                }
            } else {
                // AI头像
                if (avatar) {
                    const isEmoji = avatar.length <= 2 && /\p{Emoji}/u.test(avatar);
                    if (isEmoji) {
                        avatarDiv.innerHTML = `<div style="width: 40px; height: 40px; background-color: #f0f0f0; display: flex; align-items: center; justify-content: center; font-size: 28px;">${avatar}</div>`;
                    } else {
                        avatarDiv.innerHTML = `<img src="${avatar}" style="width: 40px; height: 40px; border-radius: 0; object-fit: cover;">`;
                    }
                } else {
                    avatarDiv.innerHTML = `<div style="width: 40px; height: 40px; background-color: #f0f0f0; display: flex; align-items: center; justify-content: center; font-size: 20px;">🤖</div>`;
                }
            }
            
            // 创建消息气泡（使用和普通消息相同的类名）
            const messageBubble = document.createElement('div');
            messageBubble.className = 'message-bubble';
            messageBubble.style.padding = '0'; // 移除内边距，让卡片填满气泡
            messageBubble.style.overflow = 'hidden'; // 防止卡片溢出
            messageBubble.innerHTML = htmlContent;
            
            // 组装消息（用户消息：气泡在左，头像在右）
            if (sender === 'user') {
                messageContainer.appendChild(messageBubble);
                messageContainer.appendChild(avatarDiv);
            } else {
                messageContainer.appendChild(avatarDiv);
                messageContainer.appendChild(messageBubble);
            }
            
            chatContent.appendChild(messageContainer);
            
            // 使用 requestAnimationFrame 确保DOM更新后再显示
            requestAnimationFrame(() => {
                messageContainer.style.opacity = '1';
            });
            
            chatContent.scrollTop = chatContent.scrollHeight;
            console.log('HTML消息已添加到聊天界面');
        }

        // 触发情侣空间邀请的AI回复
        async function triggerCoupleInviteAIResponse(character, inviteContent) {
            console.log('=== 触发情侣空间邀请AI回复 ===');
            
            // 设置当前聊天ID
            currentChatId = character.id;
            
            // 显示"对方正在输入中..."
            const chatHeaderTitle = document.getElementById('chatHeaderTitle');
            let originalTitle = '';
            if (chatHeaderTitle) {
                originalTitle = chatHeaderTitle.textContent;
                chatHeaderTitle.textContent = '对方正在输入中...';
            }
            
            // 构建专门针对情侣邀请的提示词
            const prompt = buildCoupleInvitePrompt(character, inviteContent);
            
            try {
                console.log('开始调用API获取AI回复...');
                const response = await callOpenAIAPI(prompt);
                console.log('AI回复:', response);
                
                // 恢复原标题
                if (chatHeaderTitle) {
                    chatHeaderTitle.textContent = originalTitle;
                }
                
                // 处理AI回复
                await handleCoupleInviteResponse(response, character);
                
            } catch (error) {
                console.error('获取AI回复失败:', error);
                
                // 恢复原标题
                if (chatHeaderTitle) {
                    chatHeaderTitle.textContent = originalTitle;
                }
            }
        }

        // 构建情侣空间邀请的提示词
        function buildCoupleInvitePrompt(character, inviteContent) {
            const userName = cachedPersonalProfile?.name || '用户';
            const aiName = character.remark || character.name;
            const currentTime = new Date().toLocaleString('zh-CN');
            
            let prompt = '';
            
            // 添加人设
            if (character.personality) {
                prompt += `【你的人设】
${character.personality}

`;
            }
            
            prompt += `【重要说明】
${userName} 向你发送了情侣空间邀请，想邀请你成为TA的专属伴侣。

【情侣空间功能说明】
情侣空间是一个专属功能，开启后：
• 你们将成为彼此的专属伴侣
• 可以记录生活足迹
• 可以发送问卷
• 可以开启小黑屋模式
• 其他AI角色会知道你们的关系

【当前时间】${currentTime}

【用户发送的邀请】
${inviteContent}

【你的任务】
请根据你的人设和与${userName}的关系，真诚地回复这个邀请。

回复要求：
1. 明确表达你的决定（接受或拒绝）
2. 如果接受，请用明确的词语如"我愿意"、"同意"、"我接受"等
3. 如果拒绝，请委婉地说明原因
4. 回复要符合你的角色性格
5. 可以直接说出你想说的话，不需要添加任何格式标签
6. 如果你想分多条消息发送，请使用 ====（四个等号）作为分隔符
   示例：
   哇，真的吗？
   ====
   我很开心你能邀请我
   ====
   我愿意接受你的邀请

请直接回复：`;
            
            return prompt;
        }

        // 处理AI对情侣邀请的回复
        async function handleCoupleInviteResponse(response, character) {
            // 处理API返回的对象格式
            let actualReply = response;
            if (typeof response === 'object' && response.reply !== undefined) {
                actualReply = response.reply;
                console.log('从API返回对象中提取回复:', actualReply);
            }
            
            // 确保是字符串
            if (typeof actualReply !== 'string') {
                console.error('AI回复不是字符串:', actualReply);
                return;
            }
            
            const content = actualReply.trim();
            
            // 发送AI消息到聊天界面
            await sendAIMessage(content, character);
            
            // 判断是否同意
            const agreeKeywords = ['同意', '我愿意', '接受', '好啊', '好的', '没问题', '荣幸', '开心', '愿意', '我接受'];
            const rejectKeywords = ['拒绝', '不行', '不要', '抱歉', '对不起', '不能', '不想', '不合适'];
            
            let isAgree = false;
            let isReject = false;
            
            // 检查同意关键词
            for (const keyword of agreeKeywords) {
                if (content.includes(keyword)) {
                    isAgree = true;
                    break;
                }
            }
            
            // 检查拒绝关键词
            for (const keyword of rejectKeywords) {
                if (content.includes(keyword)) {
                    isReject = true;
                    break;
                }
            }
            
            // 如果AI明确同意
            if (isAgree && !isReject) {
                console.log('AI同意了情侣空间邀请');
                
                // 保存情侣空间信息
                relationshipData.coupleSpaceEnabled = true;
                relationshipData.couplePartnerId = character.id;
                relationshipData.couplePartnerName = character.remark || character.name;
                relationshipData.couplePartnerAvatar = character.avatar || '';
                relationshipData.coupleStartDate = new Date().toISOString();
                
                // 清除待处理邀请
                delete relationshipData.pendingCoupleInvite;
                
                await saveData();
                
                // 延迟显示成功提示
                setTimeout(() => {
                    showCustomAlert('💕 情侣空间已开启', `${character.remark || character.name} 接受了你的邀请，你们已成为伴侣！`, 'success');
                    
                    // 广播给所有AI
                    broadcastCoupleRelationshipToAllAI();
                }, 1500);
                
                return;
            }
            
            // 如果AI明确拒绝
            if (isReject) {
                console.log('AI拒绝了情侣空间邀请');
                
                // 清除待处理邀请
                delete relationshipData.pendingCoupleInvite;
                await saveData();
                
                // 延迟显示提示
                setTimeout(() => {
                    showCustomAlert('邀请被拒绝', `${character.remark || character.name} 暂时不想开启情侣空间。`, 'info');
                }, 1500);
                
                return;
            }
            
            // 如果AI回复不明确，默认视为拒绝
            console.log('AI回复不明确，视为拒绝');
            delete relationshipData.pendingCoupleInvite;
            await saveData();
        }

        // 处理AI对情侣邀请的回复


        // 广播情侣关系到所有AI
        async function broadcastCoupleRelationshipToAllAI() {
            const partnerName = relationshipData.couplePartnerName;
            const userName = cachedPersonalProfile?.name || '用户';
            
            // 构建广播消息
            const broadcastMessage = `[SYSTEM]通知：${userName} 和 ${partnerName} 已经开启了情侣空间，成为彼此的专属伴侣。所有AI角色都应该知道这个消息。`;
            
            // 向所有AI角色发送通知
            const aiChats = relationshipData.wechatChatList.filter(chat => chat.type === 'ai');
            
            for (const chat of aiChats) {
                // 添加到每个AI的上下文中
                if (!chat.systemContext) {
                    chat.systemContext = [];
                }
                
                chat.systemContext.push({
                    type: 'couple_notification',
                    content: `${userName} 和 ${partnerName} 是情侣关系`,
                    timestamp: Date.now()
                });
            }
            
            await saveData();
            console.log('情侣关系已广播给所有AI');
        }

        // 检查是否是伴侣AI
        function isCouplePartner(characterId) {
            return relationshipData.coupleSpaceEnabled && 
                   relationshipData.couplePartnerId == characterId;
        }

        function closeCoupleSpace() {
            const coupleSpacePage = document.getElementById('coupleSpacePage');
            coupleSpacePage.style.display = 'none';
            
            // 停止时间更新
            stopTimeUpdate();
            
        }

        // ==================== 解绑情侣空间功能 ====================
        
        // 显示解绑确认弹窗
        function showUnbindModal() {
            const modal = document.getElementById('unbindCoupleModal');
            const partnerNameEl = document.getElementById('unbindPartnerName');
            
            // 设置伴侣名称
            if (partnerNameEl) {
                partnerNameEl.textContent = relationshipData.couplePartnerName || '伴侣';
            }
            
            modal.style.display = 'flex';
        }
        
        // 关闭解绑确认弹窗
        function closeUnbindModal() {
            const modal = document.getElementById('unbindCoupleModal');
            modal.style.display = 'none';
        }
        
        // 显示解绑成功提示
        function showUnbindSuccess() {
            const modal = document.getElementById('unbindSuccessModal');
            modal.style.display = 'flex';
            
            // 2秒后自动关闭
            setTimeout(() => {
                modal.style.display = 'none';
            }, 2000);
        }
        
        // 生成解绑卡片HTML
        function generateUnbindCardHTML() {
            return `
                <div style="background: linear-gradient(135deg, #e0e0e0 0%, #f5f5f5 100%); border-radius: 16px; padding: 25px 20px; text-align: center; box-shadow: 0 4px 15px rgba(0,0,0,0.1); border: 1px solid #d0d0d0; max-width: 280px; margin: 0 auto;">
                    <div style="font-size: 56px; margin-bottom: 15px; filter: grayscale(100%); opacity: 0.7;">💔</div>
                    <div style="font-size: 18px; font-weight: 600; color: #888; margin-bottom: 8px; letter-spacing: 2px;">情侣空间已解绑</div>
                    <div style="font-size: 13px; color: #aaa; margin-top: 10px;">你们的关系已结束</div>
                    <div style="width: 40px; height: 2px; background: linear-gradient(90deg, transparent, #ccc, transparent); margin: 15px auto 0;"></div>
                </div>
            `;
        }
        
        // 告知AI并解除绑定
        async function unbindCoupleWithNotify() {
            const partnerId = relationshipData.couplePartnerId;
            const partnerName = relationshipData.couplePartnerName;
            
            // 关闭确认弹窗
            closeUnbindModal();
            
            // 先关闭情侣空间页面
            closeCoupleSpace();
            
            // 执行解绑
            await performUnbind();
            
            // 向AI发送解绑消息并跳转聊天页面
            if (partnerId) {
                // 找到伴侣的聊天数据
                const partnerChat = relationshipData.wechatChatList.find(chat => chat.id == partnerId);
                if (partnerChat) {
                    // 发送解绑系统消息
                    const unbindMessage = {
                        id: Date.now(),
                        sender: 'system',
                        content: `[SYSTEM]${partnerName}，我们解除情侣空间关系了。`,
                        time: new Date().toLocaleTimeString('zh-CN', { hour: '2-digit', minute: '2-digit' }),
                        type: 'text'
                    };
                    
                    if (!partnerChat.messages) {
                        partnerChat.messages = [];
                    }
                    partnerChat.messages.push(unbindMessage);
                    
                    // 发送HTML卡片消息
                    const cardMessage = {
                        id: Date.now() + 1,
                        sender: 'system',
                        content: `[CARD]${generateUnbindCardHTML()}[/CARD]`,
                        time: new Date().toLocaleTimeString('zh-CN', { hour: '2-digit', minute: '2-digit' }),
                        type: 'html'
                    };
                    partnerChat.messages.push(cardMessage);
                    
                    // 保存数据
                    await saveData();
                    
                    // 打开聊天页面
                    setTimeout(() => {
                        openChatInterface(partnerId, partnerChat.remark || partnerChat.name, partnerChat.avatar);
                    }, 500);
                }
            }
            
            // 显示解绑成功提示
            showUnbindSuccess();
        }
        
        // 不告知直接解除绑定
        async function unbindCoupleWithoutNotify() {
            // 关闭确认弹窗
            closeUnbindModal();
            
            // 关闭情侣空间页面
            closeCoupleSpace();
            
            // 执行解绑
            await performUnbind();
            
            // 显示解绑成功提示
            showUnbindSuccess();
        }
        
        // 执行解绑操作（清除数据）
        async function performUnbind() {
            // 保存伴侣ID用于后续操作
            const partnerId = relationshipData.couplePartnerId;
            
            // 清除情侣空间数据
            relationshipData.coupleSpaceEnabled = false;
            relationshipData.couplePartnerId = null;
            relationshipData.couplePartnerName = '';
            relationshipData.couplePartnerAvatar = '';
            relationshipData.coupleStartDate = null;
            relationshipData.coupleActivityLogs = [];
            
            // 清除待处理邀请
            delete relationshipData.pendingCoupleInvite;
            
            // 保存数据
            await saveData();
            
            console.log('情侣空间已解绑');
            
            // 更新设置页面的爱人状态显示
            updateLoverStatusInSettings();
        }
        
        // 更新设置页面的爱人状态
        function updateLoverStatusInSettings() {
            const loverStatusText = document.querySelector('.lover-status-text');
            const loverSection = document.querySelector('.settings-section.lover-section');
            const loverPartnerName = document.getElementById('loverPartnerName');
            
            if (loverStatusText) {
                if (relationshipData.coupleSpaceEnabled) {
                    loverStatusText.textContent = '情侣空间已开启';
                } else {
                    loverStatusText.textContent = '暂无伴侣';
                }
            }
            
            // 更新伴侣名称显示
            if (loverPartnerName) {
                if (relationshipData.coupleSpaceEnabled && relationshipData.couplePartnerName) {
                    loverPartnerName.textContent = `与 ${relationshipData.couplePartnerName} 是伴侣关系`;
                } else {
                    loverPartnerName.textContent = '暂无伴侣关系';
                }
            }
            
            // 控制爱人区域的显示/隐藏
            if (loverSection) {
                loverSection.style.display = relationshipData.coupleSpaceEnabled ? 'block' : 'none';
            }
        }

        // 加载情侣空间头像和背景
        function loadCoupleSpaceAvatars() {
            const leftAvatar = document.getElementById('leftAvatarImg');
            const rightAvatar = document.getElementById('rightAvatarImg');
            const partnerAvatar = document.getElementById('partnerAvatarImg');
            const glassCard = document.getElementById('coupleGlassCard');
            
            // 左侧头像（独立）
            const leftAvatarUrl = relationshipData.coupleLeftAvatar || 'https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=cartoon%20avatar%20of%20a%20boy%2C%20cute%2C%20simple%20style&image_size=square';
            if (leftAvatar) leftAvatar.src = leftAvatarUrl;
            
            // 右侧头像（独立）
            const rightAvatarUrl = relationshipData.coupleRightAvatar || 'https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=cartoon%20avatar%20of%20a%20girl%2C%20cute%2C%20pink%20style&image_size=square';
            if (rightAvatar) rightAvatar.src = rightAvatarUrl;
            
            // 底栏伴侣头像（使用当前爱人的真实头像）
            if (partnerAvatar) {
                let partnerAvatarUrl = rightAvatarUrl; // 默认使用右侧头像
                
                // 如果有couplePartnerId，从wechatChatList中获取爱人的真实头像
                if (relationshipData.couplePartnerId) {
                    const partner = relationshipData.wechatChatList.find(item => item.id == relationshipData.couplePartnerId);
                    if (partner && partner.avatar) {
                        partnerAvatarUrl = partner.avatar;
                        // 同步更新 couplePartnerAvatar
                        relationshipData.couplePartnerAvatar = partner.avatar;
                        console.log('加载爱人真实头像:', partnerAvatarUrl);
                    }
                }
                
                partnerAvatar.src = partnerAvatarUrl;
            }
            
            // 加载动态记录
            loadCoupleActivityLog();
            
            // 加载卡片背景
            if (relationshipData.coupleBackground && glassCard) {
                glassCard.style.backgroundImage = `url(${relationshipData.coupleBackground})`;
                glassCard.style.backgroundSize = 'cover';
                glassCard.style.backgroundPosition = 'center';
                glassCard.style.backgroundColor = 'rgba(255, 107, 157, 0.3)';
            } else if (glassCard) {
                // 恢复默认毛玻璃背景
                glassCard.style.backgroundImage = '';
                glassCard.style.backgroundColor = 'rgba(255, 107, 157, 0.3)';
            }
            
            // 应用自定义颜色设置
            console.log('应用颜色设置:', {
                coupleHeaderColor: relationshipData.coupleHeaderColor,
                coupleFooterColor: relationshipData.coupleFooterColor,
                coupleHeaderTextStroke: relationshipData.coupleHeaderTextStroke,
                coupleSignatureTextStroke: relationshipData.coupleSignatureTextStroke
            });
            
            if (relationshipData.coupleHeaderColor) {
                const header = document.querySelector('.glass-card-header');
                if (header) {
                    header.style.background = `linear-gradient(135deg, ${relationshipData.coupleHeaderColor} 0%, ${adjustBrightness(relationshipData.coupleHeaderColor, -20)} 100%)`;
                    console.log('已应用顶栏颜色:', relationshipData.coupleHeaderColor);
                }
            }
            
            if (relationshipData.coupleFooterColor) {
                const footer = document.querySelector('.glass-card-footer');
                if (footer) {
                    footer.style.background = `linear-gradient(135deg, ${relationshipData.coupleFooterColor} 0%, ${adjustBrightness(relationshipData.coupleFooterColor, -20)} 100%)`;
                }
            }
            
            if (relationshipData.coupleHeaderTextStroke) {
                const headerTexts = document.querySelectorAll('.glass-card-header .candy-text');
                headerTexts.forEach(text => {
                    text.style.webkitTextStroke = `2px ${relationshipData.coupleHeaderTextStroke}`;
                    text.style.textShadow = `
                        0 0 10px ${relationshipData.coupleHeaderTextStroke},
                        0 0 20px ${relationshipData.coupleHeaderTextStroke},
                        0 0 30px ${relationshipData.coupleHeaderTextStroke},
                        2px 2px 4px rgba(0,0,0,0.3)
                    `;
                });
            }
            
            // 应用旋转木马显示设置
            const carouselVisible = relationshipData.coupleCarouselVisible !== false;
            const carousel = document.querySelector('.carousel-container');
            if (carousel) {
                // 使用visibility保持布局空间
                carousel.style.visibility = carouselVisible ? 'visible' : 'hidden';
                carousel.style.opacity = carouselVisible ? '1' : '0';
            }
            
            // 应用按钮文本颜色
            if (relationshipData.footprintTextColor) {
                const footprintText = document.querySelector('.couple-function-bar .function-item:nth-child(1) .function-text');
                if (footprintText) footprintText.style.color = relationshipData.footprintTextColor;
            }
            if (relationshipData.blackroomTextColor) {
                const blackroomText = document.querySelector('.couple-function-bar .function-item:nth-child(5) .function-text');
                if (blackroomText) blackroomText.style.color = relationshipData.blackroomTextColor;
            }

            // 应用新的设置项
            // 卡片背景
            if (relationshipData.coupleCardBackground) {
                const glassCard = document.getElementById('coupleGlassCard');
                if (glassCard) {
                    glassCard.style.backgroundImage = `url(${relationshipData.coupleCardBackground})`;
                    glassCard.style.backgroundSize = 'cover';
                    glassCard.style.backgroundPosition = 'center';
                }
            }

            // 照片墙背景
            if (relationshipData.coupleWallBackground) {
                const polaroidWall = document.getElementById('polaroidWall');
                if (polaroidWall) {
                    polaroidWall.style.backgroundImage = `url(${relationshipData.coupleWallBackground})`;
                    polaroidWall.style.backgroundSize = 'cover';
                    polaroidWall.style.backgroundPosition = 'center';
                }
            }

            // 卡片顶栏背景颜色
            if (relationshipData.coupleCardHeaderBg) {
                const cardHeader = document.querySelector('.glass-card-header');
                if (cardHeader) {
                    cardHeader.style.background = `linear-gradient(135deg, ${relationshipData.coupleCardHeaderBg} 0%, ${adjustBrightness(relationshipData.coupleCardHeaderBg, -20)} 100%)`;
                }
            }

            // 卡片顶栏时间描边颜色
            if (relationshipData.coupleCardHeaderStroke) {
                const headerTexts = document.querySelectorAll('.glass-card-header .candy-text');
                headerTexts.forEach(text => {
                    text.style.webkitTextStroke = `2px ${relationshipData.coupleCardHeaderStroke}`;
                    text.style.textShadow = `
                        0 0 10px ${relationshipData.coupleCardHeaderStroke},
                        0 0 20px ${relationshipData.coupleCardHeaderStroke},
                        0 0 30px ${relationshipData.coupleCardHeaderStroke},
                        2px 2px 4px rgba(0,0,0,0.3)
                    `;
                });
            }

            // 卡片底栏背景颜色
            if (relationshipData.coupleCardFooterBg) {
                const cardFooter = document.querySelector('.glass-card-footer');
                if (cardFooter) {
                    cardFooter.style.background = `linear-gradient(135deg, ${relationshipData.coupleCardFooterBg} 0%, ${adjustBrightness(relationshipData.coupleCardFooterBg, -20)} 100%)`;
                }
            }

            // 功能按钮文本颜色（新设置）
            if (relationshipData.coupleFootprintTextColor) {
                const footprintText = document.querySelector('.couple-function-bar .function-item:nth-child(1) .function-text');
                if (footprintText) footprintText.style.color = relationshipData.coupleFootprintTextColor;
            }
            if (relationshipData.coupleMoodTextColor) {
                const moodText = document.querySelector('.couple-function-bar .function-item:nth-child(3) .function-text');
                if (moodText) moodText.style.color = relationshipData.coupleMoodTextColor;
            }
            if (relationshipData.coupleBlackroomTextColor) {
                const blackroomText = document.querySelector('.couple-function-bar .function-item:nth-child(5) .function-text');
                if (blackroomText) blackroomText.style.color = relationshipData.coupleBlackroomTextColor;
            }

            // 旋转木马显示（使用已声明的变量）
            if (carousel) {
                carousel.style.display = carouselVisible ? 'block' : 'none';
            }
        }

        // 头像点击动效
        function animateAvatar() {
            const avatar = document.getElementById('coupleSpaceAvatar');
            avatar.style.animation = 'none';
            setTimeout(() => {
                avatar.style.animation = 'avatarBounce 0.5s ease';
            }, 10);
        }

        function animateGlassAvatar(side) {
            const avatar = document.getElementById(side + 'Avatar');
            avatar.classList.remove('animate');
            setTimeout(() => {
                avatar.classList.add('animate');
            }, 10);
            
            // 动画结束后移除类
            setTimeout(() => {
                avatar.classList.remove('animate');
            }, 500);
        }

        // 时间更新
        let timeUpdateInterval = null;

        function startTimeUpdate() {
            updateTimeDisplay();
            timeUpdateInterval = setInterval(updateTimeDisplay, 1000);
        }

        function stopTimeUpdate() {
            if (timeUpdateInterval) {
                clearInterval(timeUpdateInterval);
                timeUpdateInterval = null;
            }
        }

        function updateTimeDisplay() {
            const now = new Date();
            
            // 日期：1月31日
            const month = now.getMonth() + 1;
            const date = now.getDate();
            document.getElementById('glassCardDate').textContent = `${month}月${date}日`;
            
            // 时间：14:30
            const hours = String(now.getHours()).padStart(2, '0');
            const minutes = String(now.getMinutes()).padStart(2, '0');
            document.getElementById('glassCardTime').textContent = `${hours}:${minutes}`;
            
            // 星期：星期五
            const weekDays = ['星期日', '星期一', '星期二', '星期三', '星期四', '星期五', '星期六'];
            document.getElementById('glassCardWeek').textContent = weekDays[now.getDay()];
        }

        // 更换头像/背景弹窗
        let currentAvatarSelection = null;

        function openChangeAvatarModal() {
            document.getElementById('changeAvatarModal').style.display = 'flex';
            loadAvatarPreviews();
        }

        function closeChangeAvatarModal() {
            document.getElementById('changeAvatarModal').style.display = 'none';
        }

        function loadAvatarPreviews() {
            // 加载当前头像到预览
            const leftAvatar = document.getElementById('leftAvatarImg').src;
            const rightAvatar = document.getElementById('rightAvatarImg').src;
            
            if (leftAvatar) {
                document.getElementById('previewLeftAvatar').src = leftAvatar;
                document.getElementById('previewLeftAvatar').style.display = 'block';
            }
            if (rightAvatar) {
                document.getElementById('previewRightAvatar').src = rightAvatar;
                document.getElementById('previewRightAvatar').style.display = 'block';
            }
            
            // 加载照片墙壁纸预览
            if (relationshipData.coupleWallBackground) {
                document.getElementById('previewWallBackground').src = relationshipData.coupleWallBackground;
                document.getElementById('previewWallBackground').style.display = 'block';
            }
            
            // 加载颜色设置
            if (relationshipData.coupleHeaderColor) {
                document.getElementById('headerColorPicker').value = relationshipData.coupleHeaderColor;
                document.getElementById('headerColorText').value = relationshipData.coupleHeaderColor;
            }
            if (relationshipData.coupleFooterColor) {
                document.getElementById('footerColorPicker').value = relationshipData.coupleFooterColor;
                document.getElementById('footerColorText').value = relationshipData.coupleFooterColor;
            }
            if (relationshipData.coupleHeaderTextStroke) {
                document.getElementById('headerTextStrokePicker').value = relationshipData.coupleHeaderTextStroke;
                document.getElementById('headerTextStrokeText').value = relationshipData.coupleHeaderTextStroke;
            }
            // 加载旋转木马开关状态
            const carouselVisible = relationshipData.coupleCarouselVisible !== false;
            document.getElementById('carouselToggle').checked = carouselVisible;
            
            // 加载按钮文本颜色设置
            if (relationshipData.footprintTextColor) {
                document.getElementById('footprintTextColorPicker').value = relationshipData.footprintTextColor;
                document.getElementById('footprintTextColorText').value = relationshipData.footprintTextColor;
            }
            if (relationshipData.blackroomTextColor) {
                document.getElementById('blackroomTextColorPicker').value = relationshipData.blackroomTextColor;
                document.getElementById('blackroomTextColorText').value = relationshipData.blackroomTextColor;
            }
        }

        // 更新顶栏颜色
        function updateHeaderColor(color) {
            if (!color) return;
            relationshipData.coupleHeaderColor = color;
            document.getElementById('headerColorPicker').value = color;
            document.getElementById('headerColorText').value = color;
            
            const header = document.querySelector('.glass-card-header');
            if (header) {
                header.style.background = `linear-gradient(135deg, ${color} 0%, ${adjustBrightness(color, -20)} 100%)`;
            }
            saveData();
        }

        // 更新底栏颜色
        function updateFooterColor(color) {
            if (!color) return;
            relationshipData.coupleFooterColor = color;
            document.getElementById('footerColorPicker').value = color;
            document.getElementById('footerColorText').value = color;
            
            const footer = document.querySelector('.glass-card-footer');
            if (footer) {
                footer.style.background = `linear-gradient(135deg, ${color} 0%, ${adjustBrightness(color, -20)} 100%)`;
            }
            saveData();
        }

        // 更新顶栏文本描边颜色
        function updateHeaderTextStroke(color) {
            if (!color) return;
            relationshipData.coupleHeaderTextStroke = color;
            document.getElementById('headerTextStrokePicker').value = color;
            document.getElementById('headerTextStrokeText').value = color;
            
            const headerTexts = document.querySelectorAll('.glass-card-header .candy-text');
            headerTexts.forEach(text => {
                text.style.webkitTextStroke = `2px ${color}`;
                text.style.textShadow = `
                    0 0 10px ${color},
                    0 0 20px ${color},
                    0 0 30px ${color},
                    2px 2px 4px rgba(0,0,0,0.3)
                `;
            });
            saveData();
        }

        // 切换旋转木马显示/隐藏
        function toggleCarousel(show) {
            relationshipData.coupleCarouselVisible = show;
            const carousel = document.querySelector('.carousel-container');
            if (carousel) {
                // 使用visibility代替display，保持布局空间
                carousel.style.visibility = show ? 'visible' : 'hidden';
                carousel.style.opacity = show ? '1' : '0';
            }
            saveData();
        }

        // 记录爱人动态
        function logCoupleActivity(activityType, detail = '') {
            if (!relationshipData.coupleActivityLogs) {
                relationshipData.coupleActivityLogs = [];
            }
            
            const now = new Date();
            const timeStr = now.toLocaleTimeString('zh-CN', { hour: '2-digit', minute: '2-digit' });
            
            let activityText = '';
            switch(activityType) {
                case 'footprint':
                    activityText = `${timeStr} 查看了你的位置`;
                    break;
                case 'footprint_history':
                    activityText = `${timeStr} 查看了你的足迹历史`;
                    break;
                case 'mood':
                    activityText = `${timeStr} 查看了你的心情`;
                    break;
                case 'blackroom':
                    activityText = `${timeStr} 查看了小黑屋`;
                    break;
                case 'photo':
                    activityText = `${timeStr} 查看了照片墙`;
                    break;
                case 'chat':
                    activityText = `${timeStr} 发送了消息`;
                    break;
                default:
                    activityText = `${timeStr} ${detail}`;
            }
            
            // 添加到记录开头（最新的在前）
            relationshipData.coupleActivityLogs.unshift({
                type: activityType,
                text: activityText,
                timestamp: now.getTime()
            });
            
            // 只保留最近10条记录
            if (relationshipData.coupleActivityLogs.length > 10) {
                relationshipData.coupleActivityLogs = relationshipData.coupleActivityLogs.slice(0, 10);
            }
            
            saveData();
            
            // 如果当前在情侣空间页面，立即更新显示
            const coupleSpacePage = document.getElementById('coupleSpacePage');
            if (coupleSpacePage && coupleSpacePage.classList.contains('show')) {
                loadCoupleActivityLog();
            }
        }

        // 加载爱人动态记录到UI
        function loadCoupleActivityLog() {
            const logElement = document.getElementById('coupleActivityLog');
            if (!logElement) return;
            
            const logs = relationshipData.coupleActivityLogs || [];
            
            if (logs.length === 0) {
                logElement.textContent = '暂无新动态';
                return;
            }
            
            // 显示最新的动态
            logElement.textContent = logs[0].text;
            
            // 添加滚动动画效果
            logElement.style.animation = 'none';
            setTimeout(() => {
                logElement.style.animation = 'fadeIn 0.5s ease';
            }, 10);
        }

