                        align-items: center;
                        justify-content: center;
                    }
                    .dm-send-btn:disabled {
                        background: #ccc;
                        cursor: not-allowed;
                    }
                    .dm-send-btn.loading {
                        background: #ccc;
                        pointer-events: none;
                    }
                    .dm-welcome {
                        text-align: center;
                        padding: 20px;
                        color: #999;
                        font-size: 13px;
                    }
                    .dm-typing {
                        display: flex;
                        align-items: center;
                        gap: 4px;
                        padding: 10px 14px;
                        background: #fff;
                        border-radius: 18px;
                        border-bottom-left-radius: 4px;
                        box-shadow: 0 1px 2px rgba(0,0,0,0.1);
                        align-self: flex-start;
                    }
                    .dm-typing-dot {
                        width: 8px;
                        height: 8px;
                        background: #999;
                        border-radius: 50%;
                        animation: typing 1.4s infinite;
                    }
                    .dm-typing-dot:nth-child(2) { animation-delay: 0.2s; }
                    .dm-typing-dot:nth-child(3) { animation-delay: 0.4s; }
                    @keyframes typing {
                        0%, 60%, 100% { transform: translateY(0); }
                        30% { transform: translateY(-10px); }
                    }
                </style>
                <div class="dm-top-spacer"></div>
                <div class="dm-header">
                    <div class="dm-back-btn" onclick="weiboCloseDMPage()">
                        <svg viewBox="0 0 24 24"><path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/></svg>
                    </div>
                    <div class="dm-user-info">
                        <div class="dm-avatar">${avatarContent}</div>
                        <div class="dm-name">${contact.remark || contact.name}</div>
                    </div>
                    <div class="dm-more-btn" onclick="weiboDMShowOptions('${contactId}')">
                        <svg viewBox="0 0 24 24"><path d="M12 8c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm0 2c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm0 6c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z"/></svg>
                    </div>
                </div>
                <div class="dm-content" id="dmContent">
                    <div class="dm-welcome">开始和 ${contact.remark || contact.name} 聊天吧</div>
                </div>
                <div class="dm-input-area">
                    <div class="dm-input-toolbar">
                        <div class="dm-tool-btn">🎙️</div>
                        <div class="dm-input-wrapper">
                            <textarea class="dm-input" id="dmInput" placeholder="发送私信..." rows="1"></textarea>
                        </div>
                        <button class="dm-send-btn" id="dmSendBtn" onclick="weiboDMSendMessage('${contactId}')">发送</button>
                    </div>
                </div>
            `;

            dmPage.style.display = 'flex';
            document.body.style.overflow = 'hidden';

            // 加载历史消息
            weiboDMLoadMessages(contactId);

            // 设置输入框自动调整高度
            const input = document.getElementById('dmInput');
            const sendBtn = document.getElementById('dmSendBtn');

            input.addEventListener('input', function() {
                this.style.height = 'auto';
                this.style.height = Math.min(this.scrollHeight, 100) + 'px';
                sendBtn.disabled = this.value.trim() === '';
            });

            input.addEventListener('keydown', function(e) {
                if (e.key === 'Enter' && !e.shiftKey) {
                    e.preventDefault();
                    if (this.value.trim()) {
                        weiboDMSendMessage(contactId);
                    }
                }
            });

            // 初始禁用发送按钮
            sendBtn.disabled = true;

            // 聚焦输入框
            setTimeout(() => input.focus(), 100);
        };

        // 关闭私信页面
        window.weiboCloseDMPage = function() {
            const dmPage = document.getElementById('weiboDMPage');
            if (dmPage) {
                dmPage.style.display = 'none';
            }
            document.body.style.overflow = '';
        };

        // 加载私信消息
        window.weiboDMLoadMessages = async function(contactId) {
            const content = document.getElementById('dmContent');
            const contact = relationshipData.wechatChatList.find(c => c.id == contactId);
            if (!contact) return;

            // 从微博私信记录中加载消息
            const dmChatKey = `weibo_dm_${contactId}`;
            const messages = await localforage.getItem(dmChatKey) || [];

            if (messages.length === 0) {
                content.innerHTML = `<div class="dm-welcome">开始和 ${contact.remark || contact.name} 聊天吧</div>`;
                return;
            }

            const avatarContent = contact.avatar && contact.avatar.length <= 2 ? contact.avatar :
                (contact.avatar ? `<img src="${contact.avatar}" style="width: 100%; height: 100%; object-fit: cover; border-radius: 50%;">` : '👤');

            // 获取微博用户头像
            const weiboUserAvatar = await localforage.getItem('weiboProfileAvatar') || '😀';
            const userAvatar = weiboUserAvatar && weiboUserAvatar.length <= 2 ? weiboUserAvatar :
                (weiboUserAvatar ? `<img src="${weiboUserAvatar}" style="width: 100%; height: 100%; object-fit: cover; border-radius: 50%;">` : '😀');

            content.innerHTML = messages.map(msg => {
                const isSent = msg.sender === 'user' || msg.isMe;
                const time = new Date(msg.timestamp || msg.time || Date.now()).toLocaleTimeString('zh-CN', { hour: '2-digit', minute: '2-digit' });
                const messageContent = (msg.content || msg.text || '').replace(/\n/g, '<br>');
                return `
                    <div class="dm-message ${isSent ? 'sent' : 'received'}">
                        <div class="dm-message-avatar">${isSent ? userAvatar : avatarContent}</div>
                        <div class="dm-message-content">
                            <div class="dm-message-bubble">${messageContent}</div>
                            <div class="dm-message-time">${time}</div>
                        </div>
                    </div>
                `;
            }).join('');

            // 滚动到底部
            content.scrollTop = content.scrollHeight;
        };

        // 构建微博私信上下文
        async function buildWeiboDMContext(contactId) {
            const contact = relationshipData.wechatChatList.find(c => c.id == contactId);
            if (!contact) return null;

            // 获取上下文长度设置
            let contextLength = contact.contextLength || 20;
            let worldbookContent = '';
            let personality = '';
            let mountedMemories = [];

            // 获取世界书内容
            if (contact.worldbooks && Array.isArray(contact.worldbooks)) {
                const worldbookIds = contact.worldbooks.map(id => parseInt(id));
                worldbookIds.forEach(id => {
                    const worldbook = relationshipData.worldBooks.find(book => book.id == id);
                    if (worldbook) {
                        worldbookContent += worldbook.content + '\n\n';
                    }
                });
            }

            // 获取人设
            if (contact.personality) {
                personality = contact.personality;
            }

            // 获取挂载的长期记忆
            if (contact.memories && Array.isArray(contact.memories)) {
                const mountCount = contact.memoryMountCount || 5;
                const sortedMemories = [...contact.memories].sort((a, b) => {
                    const timeA = a.startTime || a.id || 0;
                    const timeB = b.startTime || b.id || 0;
                    return timeB - timeA;
                });
                mountedMemories = sortedMemories.slice(0, mountCount);
            }

            // 获取微博私信历史消息
            const dmChatKey = `weibo_dm_${contactId}`;
            let dmMessages = await localforage.getItem(dmChatKey) || [];

            // 获取微信聊天历史消息（作为上下文，但不在微博显示）
            const wechatChatKey = `chat_${contactId}`;
            let wechatMessages = await localforage.getItem(wechatChatKey) || [];

            // 合并消息并按时间排序
            const allMessages = [
                ...wechatMessages.map(m => ({ ...m, source: 'wechat', hidden: true })),
                ...dmMessages.map(m => ({ ...m, source: 'weibo', hidden: false }))
            ].sort((a, b) => (a.timestamp || 0) - (b.timestamp || 0));

            // 获取最近的消息
            const recentMessages = allMessages.slice(-contextLength);

            // 获取个人资料
            const personalProfile = await localforage.getItem('personalProfile') || {};

            // 获取关系信息
            let relationshipInfo = null;
            if (relationshipData.selectedCharacterId == contactId && relationshipData.characterRelationships) {
                const characterRelation = relationshipData.characterRelationships[contactId];
                if (characterRelation) {
                    relationshipInfo = {
                        title: characterRelation.title || relationshipData.title,
                        startDate: characterRelation.startDate ? new Date(characterRelation.startDate) : relationshipData.startDate,
                        description: characterRelation.description || relationshipData.description,
                        mood: characterRelation.mood || relationshipData.mood
                    };
                }
            }

            return {
                worldbookContent,
                personality,
                mountedMemories,
                recentMessages,
                personalProfile,
                relationshipInfo,
                contact,
                currentTime: new Date().toLocaleString('zh-CN')
            };
        }

        // 发送私信消息
        window.weiboDMSendMessage = async function(contactId) {
            const input = document.getElementById('dmInput');
            const content = input.value.trim();
            if (!content) return;

            const contact = relationshipData.wechatChatList.find(c => c.id == contactId);
            if (!contact) return;

            const dmChatKey = `weibo_dm_${contactId}`;
            let messages = await localforage.getItem(dmChatKey) || [];

            // 添加用户消息
            const userMsg = {
                sender: 'user',
                content: content,
                timestamp: Date.now(),
                isMe: true,
                source: 'weibo'
            };
            messages.push(userMsg);
            await localforage.setItem(dmChatKey, messages);

            // 同时同步到微信聊天记录（作为隐藏消息）
            const wechatChatKey = `chat_${contactId}`;
            let wechatMessages = await localforage.getItem(wechatChatKey) || [];
            wechatMessages.push({
                ...userMsg,
                hidden: true,
                source: 'weibo_sync',
                note: '来自微博私信'
            });
            await localforage.setItem(wechatChatKey, wechatMessages);

            // 清空输入框
            input.value = '';
            input.style.height = 'auto';
            const sendBtn = document.getElementById('dmSendBtn');
            sendBtn.disabled = true;

            // 重新加载消息显示
            await weiboDMLoadMessages(contactId);

            // 显示输入中提示
            weiboShowTypingIndicator(contactId);

            // 调用AI生成回复
            await weiboDMGenerateReply(contactId, content);
        };

        // 显示输入中提示
        window.weiboShowTypingIndicator = function(contactId) {
            const content = document.getElementById('dmContent');
            const contact = relationshipData.wechatChatList.find(c => c.id == contactId);
            const avatarContent = contact && contact.avatar && contact.avatar.length <= 2 ? contact.avatar : '👤';

            const typingDiv = document.createElement('div');
            typingDiv.id = 'dmTypingIndicator';
            typingDiv.className = 'dm-typing';
            typingDiv.innerHTML = `
                <div class="dm-message-avatar" style="width: 36px; height: 36px; margin-right: 8px; flex-shrink: 0;">
                    ${avatarContent}
                </div>
                <div style="display: flex; align-items: center; gap: 4px;">
                    <div class="dm-typing-dot"></div>
                    <div class="dm-typing-dot"></div>
                    <div class="dm-typing-dot"></div>
                </div>
            `;
            content.appendChild(typingDiv);
            content.scrollTop = content.scrollHeight;
        };

        // 隐藏输入中提示
        window.weiboHideTypingIndicator = function() {
            const indicator = document.getElementById('dmTypingIndicator');
            if (indicator) {
                indicator.remove();
            }
        };

        // AI回复私信 - 完整API调用
        window.weiboDMGenerateReply = async function(contactId, userMessage) {
            const contact = relationshipData.wechatChatList.find(c => c.id == contactId);
            if (!contact) return;

            try {
                // 构建上下文
                const context = await buildWeiboDMContext(contactId);
                if (!context) {
                    weiboHideTypingIndicator();
                    return;
                }

                // 构建提示词
                let prompt = '';

                // 世界书内容
                if (context.worldbookContent) {
                    prompt += `【世界书内容】\n${context.worldbookContent}\n\n`;
                }

                // 角色人设
                if (context.personality) {
                    prompt += `【角色人设描述】\n${context.personality}\n\n`;
                }

                // 关系信息
                if (context.relationshipInfo) {
                    prompt += `【关系信息】\n- 关系标题：${context.relationshipInfo.title}\n- 开始日期：${context.relationshipInfo.startDate?.toLocaleDateString()}\n- 关系描述：${context.relationshipInfo.description || '无'}\n- 当前心情：${context.relationshipInfo.mood?.emoji} ${context.relationshipInfo.mood?.text}\n\n`;
                }

                // AI信息
                prompt += `【AI信息】\n- 本名：${contact.name}\n- 用户昵称：${contact.myNickname || context.personalProfile.nickname || '用户'}\n\n`;

                // 用户个人资料
                if (context.personalProfile.nickname || context.personalProfile.bio) {
                    prompt += `【用户个人资料】\n`;
                    if (context.personalProfile.nickname) prompt += `- 昵称：${context.personalProfile.nickname}\n`;
                    if (context.personalProfile.gender) {
                        const genderText = context.personalProfile.gender === 'male' ? '男' : context.personalProfile.gender === 'female' ? '女' : '其他';
                        prompt += `- 性别：${genderText}\n`;
                    }
                    if (context.personalProfile.bio) prompt += `- 个人简介：${context.personalProfile.bio}\n`;
                    if (context.personalProfile.interests) prompt += `- 兴趣爱好：${context.personalProfile.interests}\n`;
                    prompt += `\n`;
                }

                // 长期记忆
                if (context.mountedMemories && context.mountedMemories.length > 0) {
                    prompt += `【长期记忆】\n以下是我们的美好回忆，请参考这些记忆来了解我们的关系发展：\n\n`;
                    context.mountedMemories.forEach((memory, index) => {
                        prompt += `${index + 1}. ${memory.timeText}\n${memory.content}\n\n`;
                    });
                    prompt += `\n`;
                }

                // 重要提示：这是在微博上聊天
                prompt += `【重要提示】\n这是在微博上进行的私信聊天。微博是一个公开的社交平台，语气可以更加轻松、随意。请记住这是在微博私信中回复用户。\n\n`;

                // 历史消息（包括微信聊天的上下文）
                if (context.recentMessages && context.recentMessages.length > 0) {
                    prompt += `【历史对话记录】\n==============================\n`;
                    context.recentMessages.forEach(msg => {
                        let messageText = msg.content || msg.text || '';
                        const msgTime = msg.timestamp ? new Date(msg.timestamp).toLocaleTimeString('zh-CN', {hour: '2-digit', minute: '2-digit'}) : '未知时间';
                        const isUser = msg.sender === 'user' || msg.isMe;
                        const sourceTag = msg.source === 'wechat' ? '[微信]' : '[微博]';
                        prompt += `${isUser ? '用户' : 'AI'} ${sourceTag} [${msgTime}]：${messageText}\n`;
                    });
                    prompt += `==============================\n\n`;
                }

                prompt += `【当前时间】${context.currentTime}\n\n`;

                prompt += `【格式要求】\n1. 直接回复内容，不要使用任何特殊格式标记\n2. 回复要自然、符合你的人设\n3. 这是微博私信，语气可以更轻松随意\n4. 可以表达爱意、关怀或任何真实情感\n\n【重要】关于分句发送：\n- 能用逗号、句号连接的句子，尽量放在一条消息里\n- 只有在真正需要停顿、转换话题或强调时，才使用 ====（四个等号）分隔符分句发送\n- 不要过度分句，避免把完整的句子拆成多条消息\n\n正确示例（分句合理）：\n今天天气真好，要不要一起出去玩？\n====\n我想你了\n\n错误示例（过度分句）：\n今天天气真好\n====\n要不要一起出去玩\n====\n我想你了\n\n请生成回复：`;

                // 获取API配置
                const appSettings = await localforage.getItem('appSettings') || {};
                const apiConfig = {
                    apiUrl: appSettings.api?.baseUrl || 'https://api.openai.com/v1',
                    apiKey: appSettings.api?.apiKey || '',
                    modelName: appSettings.api?.model || 'gpt-4o-mini'
                };

                console.log('【微博私信API配置】apiUrl:', apiConfig.apiUrl);
                console.log('【微博私信API配置】apiKey:', apiConfig.apiKey ? apiConfig.apiKey.substring(0, 10) + '...' : 'empty');
                console.log('【微博私信API配置】modelName:', apiConfig.modelName);

                if (!apiConfig.apiKey) {
                    weiboHideTypingIndicator();
                    alert('请先配置API密钥');
                    return;
                }

                // 调用API
                const response = await fetch(`${apiConfig.apiUrl}/chat/completions`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${apiConfig.apiKey}`
                    },
                    body: JSON.stringify({
                        model: apiConfig.modelName,
                        messages: [
                            { role: 'system', content: '你是' + (contact.name || 'AI助手') + '，正在微博私信中与用户聊天。请根据人设自然回复。' },
                            { role: 'user', content: prompt }
                        ],
                        temperature: 0.8,
                        max_tokens: 500
                    })
                });

                console.log('【微博私信API响应】status:', response.status);

                if (!response.ok) {
                    throw new Error('API请求失败');
                }

                const data = await response.json();
                let reply = data.choices?.[0]?.message?.content || '抱歉，我现在有点忙，稍后再聊～';

                // 隐藏输入中提示
                weiboHideTypingIndicator();

                // 【关键】处理分句（使用====分隔）
                const dmChatKey = `weibo_dm_${contactId}`;
                let dmMessages = await localforage.getItem(dmChatKey) || [];
                const wechatChatKey = `chat_${contactId}`;
                let wechatMessages = await localforage.getItem(wechatChatKey) || [];

                if (reply.includes('====')) {
                    // 分句发送
                    const messages = reply.split('====').map(msg => msg.trim()).filter(msg => msg);
                    for (let i = 0; i < messages.length; i++) {
                        const msgContent = messages[i];
                        const aiMsg = {
                            sender: 'ai',
                            content: msgContent,
                            timestamp: Date.now() + i * 1000, // 每条消息间隔1秒
                            isMe: false,
                            source: 'weibo'
                        };
                        dmMessages.push(aiMsg);
                        wechatMessages.push({
                            ...aiMsg,
                            hidden: true,
                            source: 'weibo_sync',
                            note: '来自微博私信'
                        });
                    }
                } else {
                    // 单条消息
                    const aiMsg = {
                        sender: 'ai',
                        content: reply,
                        timestamp: Date.now(),
                        isMe: false,
                        source: 'weibo'
                    };
                    dmMessages.push(aiMsg);
                    wechatMessages.push({
                        ...aiMsg,
                        hidden: true,
                        source: 'weibo_sync',
                        note: '来自微博私信'
                    });
                }

                await localforage.setItem(dmChatKey, dmMessages);
                await localforage.setItem(wechatChatKey, wechatMessages);

                // 重新加载消息显示
                await weiboDMLoadMessages(contactId);

            } catch (error) {
                console.error('【微博私信AI回复失败】', error);
                weiboHideTypingIndicator();

                // 显示错误信息在消息中
                const errorMsg = {
                    sender: 'ai',
                    content: `[系统消息] API调用失败: ${error.message}。请检查API设置。`,
                    timestamp: Date.now(),
                    isMe: false,
                    source: 'weibo',
                    isError: true
                };

                const dmChatKey = `weibo_dm_${contactId}`;
                let dmMessages = await localforage.getItem(dmChatKey) || [];
                dmMessages.push(errorMsg);
                await localforage.setItem(dmChatKey, dmMessages);

                // 同步到微信
                const wechatChatKey = `chat_${contactId}`;
                let wechatMessages = await localforage.getItem(wechatChatKey) || [];
                wechatMessages.push({
                    ...errorMsg,
                    hidden: true,
                    source: 'weibo_sync'
                });
                await localforage.setItem(wechatChatKey, wechatMessages);

                await weiboDMLoadMessages(contactId);
            }
        };

        // 显示私信选项菜单
        window.weiboDMShowOptions = function(contactId) {
            const choice = prompt('选择操作:\n1. 查看主页\n2. 清空聊天记录\n3. 举报\n4. 屏蔽');

            if (choice === '1' || choice === '查看主页') {
                weiboCloseDMPage();
                const contact = relationshipData.wechatChatList.find(c => c.id == contactId);
                if (contact) {
                    weiboOpenAIProfile(contact);
                }
            } else if (choice === '2' || choice === '清空聊天记录') {
                if (confirm('确定要清空聊天记录吗？')) {
                    const dmChatKey = `weibo_dm_${contactId}`;
                    localforage.removeItem(dmChatKey);
                    weiboDMLoadMessages(contactId);
                }
            } else if (choice === '3' || choice === '举报') {
                alert('举报功能开发中...');
            } else if (choice === '4' || choice === '屏蔽') {
                alert('屏蔽功能开发中...');
            }
        };

        // 编辑AI粉丝数
        window.weiboEditAIFollowers = async function(contactId) {
            // 直接从relationshipData中获取索引
            const index = relationshipData.wechatChatList.findIndex(c => c.id == contactId);
            if (index === -1) return;
            
            const contact = relationshipData.wechatChatList[index];
            const currentFollowers = contact.weiboStats?.followers || 0;
            const newFollowers = prompt('设置粉丝数:', currentFollowers);
            
            if (newFollowers !== null && !isNaN(newFollowers)) {
                // 直接修改relationshipData中的数据
                if (!contact.weiboStats) {
                    contact.weiboStats = {
                        followers: parseInt(newFollowers),
                        following: 1,
                        posts: 0
                    };
                } else {
                    contact.weiboStats.followers = parseInt(newFollowers);
                }
                
                // 保存到localforage
                await localforage.setItem('wechatChatList', relationshipData.wechatChatList);
                
                // 更新显示
                const followersEl = document.getElementById('weiboAIFollowers_' + contactId);
                if (followersEl) {
                    followersEl.textContent = newFollowers;
                }
                
                console.log('AI粉丝数已更新:', contactId, newFollowers);
            }
        };

        // 打开草稿
        window.weiboOpenDrafts = function() {
            alert('草稿箱功能开发中...');
        };

        // 创建发布弹窗
        window.weiboCreatePostModal = function() {
            let modal = document.getElementById('weiboPostModal');
            if (!modal) {
                modal = document.createElement('div');
                modal.id = 'weiboPostModal';
                modal.className = 'weibo-post-modal';
                modal.innerHTML = `
                    <div class="weibo-post-backdrop" onclick="weiboClosePostModal()"></div>
                    <div class="weibo-post-content">
                        <div class="weibo-post-header">
                            <span onclick="weiboClosePostModal()" style="font-size: 20px; cursor: pointer;">✕</span>
                            <span style="font-weight: 600;">发布动态</span>
                            <button class="weibo-post-send-btn" onclick="weiboSendPost()">发送</button>
                        </div>
                        <div class="weibo-post-body">
                            <textarea id="weiboPostText" placeholder="分享新鲜事..." style="width: 100%; height: 150px; border: none; resize: none; font-size: 16px; outline: none;"></textarea>
                            <div id="weiboPostImages" style="display: flex; flex-wrap: wrap; gap: 8px; margin-top: 10px;"></div>
                        </div>
                        <div class="weibo-post-tools">
                            <span onclick="weiboAddImage()">📷</span>
                            <span onclick="weiboAddEmoji()">😊</span>
                            <span onclick="weiboAddLocation()">📍</span>
                            <span onclick="weiboAddTopic()">#</span>
                            <span onclick="weiboAddMention()">@</span>
                        </div>
                    </div>
                `;
                document.body.appendChild(modal);
                
                // 添加样式
                const styles = document.createElement('style');
                styles.textContent = `
                    .weibo-post-modal {
                        position: fixed;
                        top: 0;
                        left: 0;
                        width: 100%;
                        height: 100%;
                        z-index: 10003;
                        display: none;
                        align-items: flex-end;
                        justify-content: center;
                    }
                    .weibo-post-modal.active {
                        display: flex;
                    }
                    .weibo-post-backdrop {
                        position: absolute;
                        top: 0;
                        left: 0;
                        width: 100%;
                        height: 100%;
                        background: rgba(0,0,0,0.5);
                    }
                    .weibo-post-content {
                        position: relative;
                        width: 100%;
                        max-height: 90%;
                        background: #fff;
                        border-radius: 20px 20px 0 0;
                        overflow: hidden;
                        display: flex;
                        flex-direction: column;
                    }
                    .weibo-post-header {
                        display: flex;
                        justify-content: space-between;
                        align-items: center;
                        padding: 16px;
                        border-bottom: 1px solid #f0f0f0;
                    }
                    .weibo-post-send-btn {
                        padding: 8px 20px;
                        background: #ff6b6b;
                        color: #fff;
                        border: none;
                        border-radius: 20px;
                        font-size: 14px;
                        cursor: pointer;
                    }
                    .weibo-post-send-btn:disabled {
                        background: #ccc;
                    }
                    .weibo-post-body {
                        padding: 16px;
                        flex: 1;
                        overflow-y: auto;
                    }
                    .weibo-post-tools {
                        display: flex;
                        justify-content: space-around;
                        padding: 12px;
                        border-top: 1px solid #f0f0f0;
                        font-size: 24px;
                    }
                    .weibo-post-tools span {
                        cursor: pointer;
                        padding: 8px;
                    }
                    .weibo-post-image {
                        width: 80px;
                        height: 80px;
                        object-fit: cover;
                        border-radius: 8px;
                    }
                `;
                document.head.appendChild(styles);
            }
            
            modal.classList.add('active');
        };

        window.weiboClosePostModal = function() {
            const modal = document.getElementById('weiboPostModal');
            if (modal) {
                const text = document.getElementById('weiboPostText').value.trim();
                const images = [];
                document.querySelectorAll('#weiboPostImages .weibo-post-image').forEach(img => {
                    images.push(img.src);
                });

                // 如果有内容，保存为草稿
                if (text || images.length > 0) {
                    weiboSaveDraft(text, images);
                }

                modal.classList.remove('active');
                // 清空内容
                document.getElementById('weiboPostText').value = '';
                document.getElementById('weiboPostImages').innerHTML = '';
            }
        };

        // 保存草稿
        window.weiboSaveDraft = async function(text, images) {
            const drafts = await localforage.getItem('weiboDrafts') || [];
            const draft = {
                id: 'draft_' + Date.now(),
                content: text,
                images: images,
                createdAt: Date.now()
            };
            drafts.unshift(draft);
            await localforage.setItem('weiboDrafts', drafts);
            console.log('【微博】草稿已保存:', draft.id);
        };

        // 打开草稿箱
        window.weiboOpenDrafts = async function() {
            const drafts = await localforage.getItem('weiboDrafts') || [];

            // 创建草稿箱页面
            let draftsPage = document.getElementById('weiboDraftsPage');
            if (!draftsPage) {
                draftsPage = document.createElement('div');
                draftsPage.id = 'weiboDraftsPage';
                document.body.appendChild(draftsPage);
            }

            const userAvatar = await localforage.getItem('weiboProfileAvatar') || '😀';
            const avatarContent = userAvatar && userAvatar.length <= 2 ? userAvatar :
                (userAvatar ? `<img src="${userAvatar}" style="width: 100%; height: 100%; object-fit: cover; border-radius: 50%;">` : '😀');

            draftsPage.innerHTML = `
                <style>
                    #weiboDraftsPage {
                        position: fixed;
                        top: 0;
                        left: 0;
                        right: 0;
                        bottom: 0;
                        background: #f5f5f5;
                        z-index: 10001;
                        display: flex;
                        flex-direction: column;
                        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
                    }
                    .drafts-top-spacer {
                        height: 30px;
                        background: #fff;
                        flex-shrink: 0;
                    }
                    .drafts-header {
                        display: flex;
                        align-items: center;
                        padding: 12px 16px;
                        background: #fff;
                        border-bottom: 1px solid #e5e5e5;
                    }
                    .drafts-back-btn {
                        width: 40px;
                        height: 40px;
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        cursor: pointer;
                        font-size: 20px;
                    }
                    .drafts-title {
                        flex: 1;
                        text-align: center;
                        font-size: 16px;
                        font-weight: 600;
                        color: #333;
                    }
                    .drafts-content {
                        flex: 1;
                        overflow-y: auto;
                        padding: 16px;
                    }
                    .draft-item {
                        background: #fff;
                        border-radius: 8px;
                        padding: 16px;
                        margin-bottom: 12px;
                        cursor: pointer;
                        position: relative;
                    }
                    .draft-item-content {
                        font-size: 14px;
                        color: #333;
                        line-height: 1.5;
                        margin-bottom: 8px;
                        white-space: pre-wrap;
                        word-break: break-word;
                        max-height: 60px;
                        overflow: hidden;
                    }
                    .draft-item-images {
                        display: flex;
                        gap: 8px;
                        flex-wrap: wrap;
                        margin-top: 8px;
                    }
                    .draft-item-image {
                        width: 60px;
                        height: 60px;
                        object-fit: cover;
                        border-radius: 4px;
                    }
                    .draft-item-time {
                        font-size: 12px;
                        color: #999;
                    }
                    .draft-delete-btn {
                        position: absolute;
                        top: 10px;
                        right: 10px;
                        width: 24px;
                        height: 24px;
                        border: none;
                        background: rgba(0,0,0,0.1);
                        border-radius: 50%;
                        cursor: pointer;
                        font-size: 14px;
                        display: flex;
                        align-items: center;
                        justify-content: center;
                    }
                    .drafts-empty {
                        text-align: center;
                        padding: 60px 20px;
                        color: #999;
                        font-size: 14px;
                    }
                </style>
                <div class="drafts-top-spacer"></div>
                <div class="drafts-header">
                    <div class="drafts-back-btn" onclick="weiboCloseDrafts()">←</div>
                    <div class="drafts-title">草稿箱</div>
                    <div style="width: 40px;"></div>
                </div>
                <div class="drafts-content" id="draftsContent">
                    ${drafts.length === 0 ?
                        '<div class="drafts-empty">暂无草稿</div>' :
                        drafts.map(draft => `
                            <div class="draft-item" onclick="weiboEditDraft('${draft.id}')">
                                <button class="draft-delete-btn" onclick="event.stopPropagation(); weiboDeleteDraft('${draft.id}')">✕</button>
                                <div class="draft-item-content">${draft.content || '暂无文字内容'}</div>
                                ${draft.images && draft.images.length > 0 ? `
                                    <div class="draft-item-images">
                                        ${draft.images.map(img => `<img class="draft-item-image" src="${img}">`).join('')}
                                    </div>
                                ` : ''}
                                <div class="draft-item-time">${new Date(draft.createdAt).toLocaleString('zh-CN')}</div>
                            </div>
                        `).join('')
                    }
                </div>
            `;

            draftsPage.style.display = 'block';
            document.body.style.overflow = 'hidden';
        };

        // 关闭草稿箱
        window.weiboCloseDrafts = function() {
            const draftsPage = document.getElementById('weiboDraftsPage');
            if (draftsPage) {
                draftsPage.style.display = 'none';
            }
            document.body.style.overflow = '';
        };

        // 编辑草稿
        window.weiboEditDraft = async function(draftId) {
            const drafts = await localforage.getItem('weiboDrafts') || [];
            const draft = drafts.find(d => d.id === draftId);
            if (!draft) return;

            // 打开发布弹窗并填充内容
            weiboCreatePostModal();
            document.getElementById('weiboPostText').value = draft.content || '';

            // 添加图片
            const imagesContainer = document.getElementById('weiboPostImages');
            if (draft.images && draft.images.length > 0) {
                draft.images.forEach(src => {
                    const img = document.createElement('img');
                    img.src = src;
                    img.className = 'weibo-post-image';
                    imagesContainer.appendChild(img);
                });
            }

            // 删除该草稿
            await weiboDeleteDraft(draftId);

            // 关闭草稿箱
            weiboCloseDrafts();
        };

        // 删除草稿
        window.weiboDeleteDraft = async function(draftId) {
            if (!confirm('确定删除这条草稿吗？')) return;

            const drafts = await localforage.getItem('weiboDrafts') || [];
            const newDrafts = drafts.filter(d => d.id !== draftId);
            await localforage.setItem('weiboDrafts', newDrafts);

            // 刷新草稿箱显示
            weiboOpenDrafts();
        };

        window.weiboAddImage = function() {
            const input = document.createElement('input');
            input.type = 'file';
            input.accept = 'image/*';
            input.onchange = function(e) {
                const file = e.target.files[0];
                if (file) {
                    const reader = new FileReader();
                    reader.onload = function(evt) {
                        const img = document.createElement('img');
                        img.src = evt.target.result;
                        img.className = 'weibo-post-image';
                        document.getElementById('weiboPostImages').appendChild(img);
                    };
                    reader.readAsDataURL(file);
                }
            };
            input.click();
        };

        window.weiboAddEmoji = function() {
            const emojis = ['😀', '😂', '😍', '🤔', '😢', '😮', '🤯', '🥳', '😎', '🤩'];
            const emoji = emojis[Math.floor(Math.random() * emojis.length)];
            document.getElementById('weiboPostText').value += emoji;
        };

        window.weiboAddLocation = function() {
            document.getElementById('weiboPostText').value += '📍定位';
        };

        window.weiboAddTopic = function() {
            document.getElementById('weiboPostText').value += '#话题#';
        };

        window.weiboAddMention = function() {
            document.getElementById('weiboPostText').value += '@';
        };

        // 发送动态
        window.weiboSendPost = async function() {
            const text = document.getElementById('weiboPostText').value.trim();
            if (!text && document.getElementById('weiboPostImages').children.length === 0) {
                alert('请输入内容或添加图片');
                return;
            }
            
            // 获取图片
            const images = [];
            document.querySelectorAll('#weiboPostImages .weibo-post-image').forEach(img => {
                images.push(img.src);
            });
            
            // 获取用户信息
            const userName = await localforage.getItem('weiboProfileName') || '我';
            const userAvatar = await localforage.getItem('weiboProfileAvatar') || '😀';
            
            // 获取粉丝数并计算点赞数（基于粉丝数的随机波动）
            const followersCount = await localforage.getItem('weiboFollowersCount') || 0;
            const likeRate = 0.05 + Math.random() * 0.15; // 5%-20%的点赞率
            const generatedLikes = Math.floor(followersCount * likeRate * (0.8 + Math.random() * 0.4));
            
            // 创建动态对象
            const post = {
                id: 'post_' + Date.now(),
                userId: 'self',
                userName: userName,
                userAvatar: userAvatar,
                content: text,
                images: images,
                timestamp: Date.now(),
                time: weiboFormatTime(Date.now()),
                likes: generatedLikes,
                comments: 5, // 先生成5条评论
                isMyPost: true
            };
            
            // 保存到本地存储
            let myPosts = await localforage.getItem('weiboMyPosts') || [];
            myPosts.unshift(post);
            await localforage.setItem('weiboMyPosts', myPosts);
            
            // 关闭弹窗
            weiboClosePostModal();
            
            // 显示成功
            alert('发布成功！');
            
            // 刷新动态列表
            weiboLoadNews();
            
            // 异步生成AI评论（基于世界观）
            weiboGenerateCommentsForPost(post);
            
            // 异步生成NPC私信（1-3个NPC）
            setTimeout(() => {
                weiboGenerateNPCMessages(post);
            }, 2000);
        };
        
        // 生成NPC私信（使用随机网友名字，不是角色）
        window.weiboGenerateNPCMessages = async function(post) {
            try {
                // 获取API配置
                const savedSettings = await loadAppSettings({});
                const apiUrl = savedSettings.api?.baseUrl || 'https://api.openai.com/v1';
                const apiKey = savedSettings.api?.apiKey || '';
                const model = savedSettings.api?.model || 'gpt-3.5-turbo';

                if (!apiKey) {
                    console.log('【NPC私信】未配置API，跳过生成');
                    return;
                }

                // 随机选择1-3个NPC（使用随机网友名字）
                const npcCount = Math.floor(Math.random() * 3) + 1;
                const selectedNPCs = [];

                // 随机网友名字库
                const randomNames = [
                    '小明同学', '吃瓜群众', '热心市民', '深夜冲浪', '理性分析',
                    '情感博主', '段子手', '科技宅', '萌新用户', '普通网友',
                    '隔壁老王', '围观群众', '打卡达人', '分享酱', '日常君'
                ];

                // 随机头像
                const randomAvatars = ['👤', '🧑', '👀', '🍉', '✨', '💫', '🌟', '🙋', '💬', '📢'];

                const npcDescriptions = [
                    '喜欢点赞评论的普通网友',
                    '喜欢看热闹的围观群众',
                    '一直关注你的忠实粉丝',
                    '偶尔路过的吃瓜群众',
                    '喜欢分享看法的网友'
                ];

                for (let i = 0; i < npcCount; i++) {
                    const randomName = randomNames[Math.floor(Math.random() * randomNames.length)];
                    const randomAvatar = randomAvatars[Math.floor(Math.random() * randomAvatars.length)];
                    const description = npcDescriptions[Math.floor(Math.random() * npcDescriptions.length)];

                    selectedNPCs.push({
                        name: randomName,
                        description: description,
                        avatar: randomAvatar
                    });
                }

                // 为每个NPC生成私信
                for (const npc of selectedNPCs) {
                    await weiboGenerateNPCMessage(npc, post, {});
                }

            } catch (error) {
                console.error('【NPC私信】生成失败:', error);
            }
        };
        
        // 为单个NPC生成私信
        window.weiboGenerateNPCMessage = async function(npc, post, contextData) {
            try {
                const savedSettings = await loadAppSettings({});
                const apiUrl = savedSettings.api?.baseUrl || 'https://api.openai.com/v1';
                const apiKey = savedSettings.api?.apiKey || '';
                const model = savedSettings.api?.model || 'gpt-3.5-turbo';
                
                // 构建提示词
                const prompt = `你扮演的角色：${npc.name}
角色人设：${npc.description || '普通网友'}

用户刚发布的动态内容："${post.content}"

请根据你的人设，写一条私信给发布者。私信可以是：
- 赞美、夸奖
- 提问、好奇
- 共鸣、同感
- 调侃、玩笑
- 建议、想法

要求：
1. 语气要符合角色人设
2. 内容要针对这条动态
3. 字数20-50字
4. 像真实网友发的私信
5. 直接返回私信内容，不要其他文字`;

                const response = await fetch(`${apiUrl}/chat/completions`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${apiKey}`
                    },
                    body: JSON.stringify({
                        model: model,
                        messages: [
                            { role: 'system', content: '你是一个角色扮演助手，根据人设写私信。' },
                            { role: 'user', content: prompt }
                        ],
                        temperature: 0.8,
                        max_tokens: 200
                    })
                });
                
                if (!response.ok) {
                    throw new Error(`API请求失败: ${response.status}`);
                }
                
                const result = await response.json();
                const messageContent = result.choices[0].message.content.trim();
                
                // 保存私信
                const message = {
                    id: 'npc_msg_' + Date.now() + '_' + Math.random().toString(36).substr(2, 9),
                    npcId: npc.id || npc.name,
                    npcName: npc.name,
                    npcAvatar: npc.avatar || (npc.name.length <= 2 ? npc.name : '👤'),
                    content: messageContent,
                    postId: post.id,
                    postContent: post.content,
                    timestamp: Date.now(),
                    read: false,
                    replied: false
                };
                
                // 保存到NPC私信列表
                let npcMessages = await localforage.getItem('weiboNPCMessages') || [];
                npcMessages.unshift(message);
                await localforage.setItem('weiboNPCMessages', npcMessages);
                
                console.log('【NPC私信】生成成功:', message);
                
                // 显示通知
                weiboShowNPCMessageNotification(message);
                
            } catch (error) {
                console.error('【NPC私信】生成失败:', error);
            }
        };
        
        // 显示NPC私信通知（添加到消息列表）
        window.weiboShowNPCMessageNotification = function(message) {
            // 刷新消息列表显示
            weiboRefreshMessageList();

            // 同时显示一个简短的通知
            const notification = document.createElement('div');
            notification.id = 'weiboNPCNotification_' + message.id;
            notification.style.cssText = 'position: fixed; top: 60px; right: 10px; background: #fff; border-radius: 12px; padding: 12px 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.15); z-index: 10000; max-width: 280px; cursor: pointer; animation: weiboSlideIn 0.3s ease;';
            notification.onclick = function() {
                weiboOpenNPCChat(message);
                notification.remove();
            };

            notification.innerHTML = `
                <div style="display: flex; align-items: flex-start; gap: 10px;">
                    <div style="width: 40px; height: 40px; border-radius: 50%; background: #f0f0f0; display: flex; align-items: center; justify-content: center; font-size: 20px; flex-shrink: 0;">
                        ${message.npcAvatar}
                    </div>
                    <div style="flex: 1; min-width: 0;">
                        <div style="font-size: 15px; font-weight: 600; color: #333; margin-bottom: 4px;">${message.npcName}</div>
                        <div style="font-size: 14px; color: #666; line-height: 1.4; overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;">${message.content}</div>
                        <div style="font-size: 12px; color: #999; margin-top: 6px;">点击查看回复</div>
                    </div>
                </div>
            `;
            
            document.body.appendChild(notification);
            
            // 5秒后自动消失
            setTimeout(() => {
                if (notification.parentNode) {
                    notification.style.animation = 'weiboSlideOut 0.3s ease';
                    setTimeout(() => notification.remove(), 300);
                }
            }, 5000);
        };

        // 打开NPC私信聊天页面
        window.weiboOpenNPCChat = async function(message) {
            // 标记为已读
            let npcMessages = await localforage.getItem('weiboNPCMessages') || [];
            const msgIndex = npcMessages.findIndex(m => m.id === message.id);
            if (msgIndex !== -1) {
                npcMessages[msgIndex].read = true;
                await localforage.setItem('weiboNPCMessages', npcMessages);
            }

            // 创建聊天页面
            let chatPage = document.getElementById('weiboNPCChatPage');
            if (!chatPage) {
                chatPage = document.createElement('div');
                chatPage.id = 'weiboNPCChatPage';
                chatPage.style.cssText = 'position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: #f5f5f5; z-index: 10001; display: none; flex-direction: column;';
                document.body.appendChild(chatPage);
            }

            // 获取用户头像
            const personalProfile = await localforage.getItem('personalProfile') || {};
            const userAvatar = personalProfile.avatar || '👤';

            chatPage.innerHTML = `
                <div style="background: #fff; padding: 12px 16px; display: flex; align-items: center; border-bottom: 1px solid #f0f0f0;">
                    <div style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; cursor: pointer; margin-right: 10px;" onclick="weiboCloseNPCChat()">
                        <svg viewBox="0 0 24 24" fill="currentColor" style="width: 24px; height: 24px;">
                            <path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/>
                        </svg>
                    </div>
                    <div style="flex: 1; text-align: center; font-size: 17px; font-weight: 600;">${message.npcName}</div>
                    <div style="width: 40px;"></div>
                </div>
                <div id="weiboNPCChatContent" style="flex: 1; overflow-y: auto; padding: 15px;">
                    <!-- 聊天记录 -->
                </div>
                <div style="background: #fff; padding: 10px 15px; border-top: 1px solid #f0f0f0; display: flex; gap: 10px;">
                    <input type="text" id="weiboNPCChatInput" placeholder="回复..." style="flex: 1; padding: 10px 15px; border: 1px solid #e0e0e0; border-radius: 20px; outline: none; font-size: 15px;">
                    <button onclick="weiboSendNPCReply('${message.id}', '${message.npcId}', '${message.npcName}', '${message.npcAvatar}')" style="padding: 10px 20px; background: #ff6b6b; color: #fff; border: none; border-radius: 20px; font-size: 15px; cursor: pointer;">发送</button>
                </div>
            `;

            // 显示聊天页面
            chatPage.style.display = 'flex';
            document.body.style.overflow = 'hidden';

            // 加载聊天记录
            await weiboLoadNPCChatHistory(message.id, message.npcAvatar, userAvatar);
        };

        // 加载NPC聊天历史
        window.weiboLoadNPCChatHistory = async function(messageId, npcAvatar, userAvatar) {
            const chatContent = document.getElementById('weiboNPCChatContent');
            if (!chatContent) return;

            chatContent.innerHTML = '';

            // 获取所有与该NPC的聊天记录
            let npcMessages = await localforage.getItem('weiboNPCMessages') || [];
            let chatHistory = await localforage.getItem('weiboNPCChatHistory') || {};
            const history = chatHistory[messageId] || [];

            // 找到初始消息
            const initialMsg = npcMessages.find(m => m.id === messageId);
            if (initialMsg) {
                // 显示NPC初始消息
                chatContent.innerHTML += `
                    <div style="display: flex; margin-bottom: 15px;">
                        <div style="width: 36px; height: 36px; border-radius: 50%; background: #f0f0f0; display: flex; align-items: center; justify-content: center; margin-right: 10px; font-size: 18px; flex-shrink: 0;">
                            ${npcAvatar}
                        </div>
                        <div style="background: #fff; padding: 10px 14px; border-radius: 12px; max-width: 70%; word-wrap: break-word; font-size: 15px; color: #333; box-shadow: 0 1px 2px rgba(0,0,0,0.1);">
                            ${initialMsg.content}
                        </div>
                    </div>
                `;
            }

            // 显示后续聊天记录
            history.forEach(msg => {
                if (msg.sender === 'user') {
                    chatContent.innerHTML += `
                        <div style="display: flex; justify-content: flex-end; margin-bottom: 15px;">
                            <div style="background: #95ec69; padding: 10px 14px; border-radius: 12px; max-width: 70%; word-wrap: break-word; font-size: 15px; color: #333;">
                                ${msg.content}
                            </div>
                            <div style="width: 36px; height: 36px; border-radius: 50%; background: #f0f0f0; display: flex; align-items: center; justify-content: center; margin-left: 10px; font-size: 18px; flex-shrink: 0;">
                                ${userAvatar.length <= 2 ? userAvatar : `<img src="${userAvatar}" style="width: 100%; height: 100%; object-fit: cover;">`}
                            </div>
                        </div>
                    `;
                } else {
                    chatContent.innerHTML += `
                        <div style="display: flex; margin-bottom: 15px;">
                            <div style="width: 36px; height: 36px; border-radius: 50%; background: #f0f0f0; display: flex; align-items: center; justify-content: center; margin-right: 10px; font-size: 18px; flex-shrink: 0;">
                                ${npcAvatar}
                            </div>
                            <div style="background: #fff; padding: 10px 14px; border-radius: 12px; max-width: 70%; word-wrap: break-word; font-size: 15px; color: #333; box-shadow: 0 1px 2px rgba(0,0,0,0.1);">
                                ${msg.content}
                            </div>
                        </div>
                    `;
                }
            });

            // 滚动到底部
            chatContent.scrollTop = chatContent.scrollHeight;
        };

        // 发送回复给NPC
        window.weiboSendNPCReply = async function(messageId, npcId, npcName, npcAvatar) {
            const input = document.getElementById('weiboNPCChatInput');
            const content = input.value.trim();
            if (!content) return;

            // 清空输入框
            input.value = '';

            // 获取用户头像
            const personalProfile = await localforage.getItem('personalProfile') || {};
            const userAvatar = personalProfile.avatar || '👤';

            // 添加用户消息到界面
            const chatContent = document.getElementById('weiboNPCChatContent');
            chatContent.innerHTML += `
                <div style="display: flex; justify-content: flex-end; margin-bottom: 15px;">
                    <div style="background: #95ec69; padding: 10px 14px; border-radius: 12px; max-width: 70%; word-wrap: break-word; font-size: 15px; color: #333;">
                        ${content}
                    </div>
                    <div style="width: 36px; height: 36px; border-radius: 50%; background: #f0f0f0; display: flex; align-items: center; justify-content: center; margin-left: 10px; font-size: 18px; flex-shrink: 0;">
                        ${userAvatar.length <= 2 ? userAvatar : `<img src="${userAvatar}" style="width: 100%; height: 100%; object-fit: cover;">`}
                    </div>
                </div>
            `;
            chatContent.scrollTop = chatContent.scrollHeight;

            // 保存用户消息
            let chatHistory = await localforage.getItem('weiboNPCChatHistory') || {};
            if (!chatHistory[messageId]) {
                chatHistory[messageId] = [];
            }
            chatHistory[messageId].push({
                sender: 'user',
                content: content,
                timestamp: Date.now()
            });
            await localforage.setItem('weiboNPCChatHistory', chatHistory);

            // 显示NPC正在输入
            const typingId = 'weiboNPCTyping_' + Date.now();
            chatContent.innerHTML += `
                <div id="${typingId}" style="display: flex; margin-bottom: 15px;">
                    <div style="width: 36px; height: 36px; border-radius: 50%; background: #f0f0f0; display: flex; align-items: center; justify-content: center; margin-right: 10px; font-size: 18px; flex-shrink: 0;">
                        ${npcAvatar}
                    </div>
                    <div style="background: #fff; padding: 12px 16px; border-radius: 12px; display: flex; align-items: center; gap: 4px; box-shadow: 0 1px 2px rgba(0,0,0,0.1);">
                        <span style="width: 8px; height: 8px; background: #999; border-radius: 50%; animation: weiboBounce 1s infinite 0s;"></span>
                        <span style="width: 8px; height: 8px; background: #999; border-radius: 50%; animation: weiboBounce 1s infinite 0.2s;"></span>
                        <span style="width: 8px; height: 8px; background: #999; border-radius: 50%; animation: weiboBounce 1s infinite 0.4s;"></span>
                    </div>
                </div>
            `;
            chatContent.scrollTop = chatContent.scrollHeight;

            // 延迟后生成NPC回复
            setTimeout(async () => {
                await weiboGenerateNPCReply(messageId, npcId, npcName, npcAvatar, content, typingId);
            }, 1500 + Math.random() * 1500);
        };

        // 生成NPC回复
        window.weiboGenerateNPCReply = async function(messageId, npcId, npcName, npcAvatar, userContent, typingId) {
            try {
                const savedSettings = await loadAppSettings({});
                const apiUrl = savedSettings.api?.baseUrl || 'https://api.openai.com/v1';
                const apiKey = savedSettings.api?.apiKey || '';
                const model = savedSettings.api?.model || 'gpt-3.5-turbo';

                // 获取聊天记录上下文
                let chatHistory = await localforage.getItem('weiboNPCChatHistory') || {};
                const history = chatHistory[messageId] || [];

                // 获取NPC信息
                let npcMessages = await localforage.getItem('weiboNPCMessages') || [];
                const initialMsg = npcMessages.find(m => m.id === messageId);

                // 构建提示词
                const prompt = `你是${npcName}，正在和用户私信聊天。

你的初始私信："${initialMsg?.content || ''}"

聊天记录：
${history.slice(-5).map(m => `${m.sender === 'user' ? '用户' : '你'}: ${m.content}`).join('\n')}

用户刚刚回复："${userContent}"

请根据你的角色人设，自然地回复用户。要求：
1. 语气要符合你的角色
2. 回复要针对用户的话
3. 字数20-50字
4. 像真实聊天一样自然
5. 直接返回回复内容，不要其他文字`;

                let replyContent = '收到！谢谢你的回复~';

                if (apiKey) {
                    const response = await fetch(`${apiUrl}/chat/completions`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'Authorization': `Bearer ${apiKey}`
                        },
                        body: JSON.stringify({
                            model: model,
                            messages: [
                                { role: 'system', content: '你是一个角色扮演助手，在私信聊天中自然回复。' },
                                { role: 'user', content: prompt }
                            ],
                            temperature: 0.8,
                            max_tokens: 150
                        })
                    });

                    if (response.ok) {
                        const result = await response.json();
                        replyContent = result.choices[0].message.content.trim();
                    }
                }

                // 移除正在输入
                const typingEl = document.getElementById(typingId);
                if (typingEl) typingEl.remove();

                // 添加NPC回复到界面
                const chatContent = document.getElementById('weiboNPCChatContent');
                chatContent.innerHTML += `
                    <div style="display: flex; margin-bottom: 15px;">
                        <div style="width: 36px; height: 36px; border-radius: 50%; background: #f0f0f0; display: flex; align-items: center; justify-content: center; margin-right: 10px; font-size: 18px; flex-shrink: 0;">
                            ${npcAvatar}
                        </div>
                        <div style="background: #fff; padding: 10px 14px; border-radius: 12px; max-width: 70%; word-wrap: break-word; font-size: 15px; color: #333; box-shadow: 0 1px 2px rgba(0,0,0,0.1);">
                            ${replyContent}
                        </div>
                    </div>
                `;
                chatContent.scrollTop = chatContent.scrollHeight;

                // 保存NPC回复
                chatHistory[messageId].push({
                    sender: 'npc',
                    content: replyContent,
                    timestamp: Date.now()
                });
                await localforage.setItem('weiboNPCChatHistory', chatHistory);

            } catch (error) {
                console.error('生成NPC回复失败:', error);
                // 移除正在输入
                const typingEl = document.getElementById(typingId);
                if (typingEl) typingEl.remove();
            }
        };

        // 关闭NPC聊天页面
        window.weiboCloseNPCChat = function() {
            const chatPage = document.getElementById('weiboNPCChatPage');
            if (chatPage) {
                chatPage.style.display = 'none';
            }
            document.body.style.overflow = '';
        };

        // 为动态生成AI评论
        // 生成评论（支持首次生成和加载更多）
        window.weiboGenerateCommentsForPost = async function(post, isLoadMore = false) {
            try {
                // 获取API配置
                const savedSettings = await loadAppSettings({});
                const apiUrl = savedSettings.api?.baseUrl || 'https://api.openai.com/v1';
                const apiKey = savedSettings.api?.apiKey || '';
                const model = savedSettings.api?.model || 'gpt-3.5-turbo';
                
                if (!apiKey) {
                    console.log('【AI评论】未配置API，跳过生成');
                    return;
                }
                
                // 获取已有评论
                let existingComments = await localforage.getItem('weiboComments_' + post.id) || [];
                
                // 收集上下文数据
                const contextData = await weiboCollectContextData();
                
                // 构建提示词（传入已有评论作为上下文）
                const prompt = weiboBuildCommentPrompt(post.content, contextData, existingComments);
                
                const response = await fetch(`${apiUrl}/chat/completions`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${apiKey}`
                    },
                    body: JSON.stringify({
                        model: model,
                        messages: [
                            { role: 'system', content: '你是一个微博评论生成助手。根据动态的【实际内容】生成评论，评论要围绕动态具体说什么来讨论，不要过度联想世界观。生成5条真实微博风格的评论，像吃瓜群众发的，口语化、网络化，多评论动态中提到的具体事情。' },
                            { role: 'user', content: prompt }
                        ],
                        temperature: 0.9,
                        max_tokens: 2000
                    })
                });
                
                if (!response.ok) {
                    throw new Error(`API请求失败: ${response.status}`);
                }
                
                const result = await response.json();
                const content = result.choices[0].message.content;
                
                // 解析评论
                const newComments = weiboParseAICommentsResponse(content);
                
                // 合并评论
                if (newComments && newComments.length > 0) {
                    // 为每条新评论添加唯一ID和时间戳
                    const commentsWithMeta = newComments.map((c, index) => ({
                        ...c,
                        id: 'comment_' + Date.now() + '_' + index,
                        timestamp: Date.now(),
                        likes: Math.floor(Math.random() * 50) + 1,
                        replies: [],
                        replyTo: c.replyTo || null
                    }));
                    
                    const allComments = [...existingComments, ...commentsWithMeta];
                    await localforage.setItem('weiboComments_' + post.id, allComments);
                    console.log('【AI评论】生成成功:', commentsWithMeta);
                    
                    // 更新动态的评论数
                    post.comments = allComments.length;
                    
                    // 刷新显示
                    if (isLoadMore) {
                        // 如果是在详情页加载更多，刷新详情页
                        weiboRefreshPostDetail(post.id);
                    } else {
                        weiboLoadNews();
                    }
                }
            } catch (error) {
                console.error('【AI评论】生成失败:', error);
                alert('评论生成失败，请重试');
            }
        };
        
        // 刷新详情页评论
        window.weiboRefreshPostDetail = async function(postId) {
            const myPosts = await localforage.getItem('weiboMyPosts') || [];
            const post = myPosts.find(p => p.id === postId);
            if (post) {
                await weiboOpenMyPostDetail(post);
            }
        };
        
        // 加载更多评论
        window.weiboLoadMoreComments = async function(postId) {
            const myPosts = await localforage.getItem('weiboMyPosts') || [];
            const post = myPosts.find(p => p.id === postId);
            if (post) {
                // 显示加载中
                const btn = document.getElementById('weiboLoadMoreBtn');
                if (btn) {
                    btn.textContent = '生成中...';
                    btn.disabled = true;
                }
                
                await weiboGenerateCommentsForPost(post, true);
                
                if (btn) {
                    btn.textContent = '加载更多评论';
                    btn.disabled = false;
                }
            }
        };
        
        // 构建评论生成提示词
        window.weiboBuildCommentPrompt = function(postContent, contextData, existingComments = []) {
            let prompt = `动态内容："${postContent}"\n\n`;

            // 只添加日期和节日信息，不要过度提及世界观
            if (contextData.dateInfo) {
                prompt += `【当前日期】${contextData.dateInfo.date} ${contextData.dateInfo.weekday}\n`;
                if (contextData.dateInfo.festival) {
                    prompt += `【节日】${contextData.dateInfo.festival}\n`;
                }
                prompt += '\n';
            }

            // 如果已有评论，添加上下文
            if (existingComments.length > 0) {
                prompt += '【已有评论】\n';
                existingComments.slice(-5).forEach((c, i) => {
                    prompt += `${i + 1}. ${c.user}: ${c.content}\n`;
                });
                prompt += '\n';
            }
            
            prompt += '【微博用户类型参考】（AI根据这些类型自由创作网名和评论风格）：\n';
            prompt += '用户类型1：吃瓜路人 - 看热闹不嫌事大，喜欢调侃，常用头像：🍉🍈🥤\n';
            prompt += '用户类型2：热心网友 - 喜欢分享看法，语气亲切，常用头像：👀✨🌟\n';
            prompt += '用户类型3：理性分析帝 - 喜欢分析事情本质，语气冷静，常用头像：🧠📊🔍\n';
            prompt += '用户类型4：情感共鸣者 - 容易被感动，表达共情，常用头像：💝🌸💫\n';
            prompt += '用户类型5：段子手 - 喜欢讲段子，幽默风趣，常用头像：😂🤣🎭\n';
            prompt += '用户类型6：质疑者 - 喜欢提出不同看法，略带质疑，常用头像：🤔❓💭\n';
            prompt += '用户类型7：支持者 - 坚定支持，正能量满满，常用头像：👍💪🔥\n';
            prompt += '用户类型8：细节控 - 关注细节，喜欢抠字眼，常用头像：🔍📝🔎\n';
            prompt += '用户类型9：转发狂魔 - 喜欢@朋友来看，常用头像：📢🔊📣\n';
            prompt += '用户类型10：老司机 - 经验丰富，语重心长，常用头像：🎓🚗🛣️\n';
            prompt += '用户类型11：深夜党 - 深夜感性，容易emo，常用头像：🌙🌃🦉\n';
            prompt += '用户类型12：暴躁老哥 - 脾气火爆，直来直去，常用头像：😤💢🔥\n';
            prompt += '用户类型13：温柔系 - 说话温柔，善解人意，常用头像：🌸🐰💕\n';
            prompt += '用户类型14：科技宅 - 懂技术，喜欢科普，常用头像：💻🤖⚡\n';
            prompt += '用户类型15：萌妹子 - 可爱风格，喜欢卖萌，常用头像：🐱🌸✨\n\n';
            
            prompt += '【网名创作要求】\n';
            prompt += '1. 为每个用户创作一个独特的微博网名（2-8个字），风格要符合用户类型\n';
            prompt += '2. 网名示例：吃瓜小能手、深夜冲浪人、理性吃瓜中、暴躁小饼干、温柔一刀、科技宅小明\n';
            prompt += '3. 网名要有网感，像真实微博用户，可以用：小XX、XX酱、XX君、XX同学、爱XX的XX等格式\n';
            prompt += '4. 避免使用上面列出的固定网名，要创作新的\n\n';
            
            prompt += '【评论要求】\n';
            prompt += '1. 生成5条评论，格式为JSON数组\n';
            prompt += '2. 每条包含：user(AI创作的网名), content(评论内容，15-40字), avatar(从对应类型中选一个emoji), type(用户类型描述), replyTo(可选，如果要回复上面的评论，填写被回复者的网名)\n';
            prompt += '3. 评论风格要真实，像微博真实用户发的，口语化、网络化\n';
            prompt += '4. 重点围绕动态【实际内容】进行评论，不要过度联想到世界观\n';
            prompt += '5. 评论要有互动感：\n';
            prompt += '   - 第1条：直接评论动态内容\n';
            prompt += '   - 第2-5条：可以选择回复上面的某条评论（使用replyTo字段），也可以直接评论动态\n';
            prompt += '   - 回复格式示例：replyTo: "吃瓜小能手"，content: "你说得对！我也这么觉得"\n';
            prompt += '6. 使用微博常用语："哈哈哈"、"绝了"、"确实"、"不懂就问"、"@朋友来看"、"笑死"、"真实"、"我悟了"、"你说得对"、"附议"等\n';
            prompt += '7. 返回纯JSON格式，不要其他文字\n';
            prompt += '8. 示例：[{"user":"吃瓜小能手","content":"哈哈哈这也太真实了吧","avatar":"🍉","type":"吃瓜路人"},{"user":"深夜冲浪人","content":"你说得对！","avatar":"🌙","type":"支持者","replyTo":"吃瓜小能手"}]';
            
            return prompt;
        };
        
        // 解析AI评论
        window.weiboParseAICommentsResponse = function(content) {
            try {
                // 尝试直接解析JSON
                return JSON.parse(content);
            } catch (e) {
                // 尝试从文本中提取JSON
                const jsonMatch = content.match(/\[[\s\S]*\]/);
                if (jsonMatch) {
                    return JSON.parse(jsonMatch[0]);
                }
                throw new Error('无法解析AI返回的内容');
            }
        };

        // 格式化时间显示
        window.weiboFormatTime = function(timestamp) {
            const now = Date.now();
            const diff = now - timestamp;
            
            const minute = 60 * 1000;
            const hour = 60 * minute;
            const day = 24 * hour;
            
            if (diff < minute) {
                return '刚刚';
            } else if (diff < hour) {
                return Math.floor(diff / minute) + '分钟前';
            } else if (diff < day) {
                return Math.floor(diff / hour) + '小时前';
            } else {
                const date = new Date(timestamp);
                return (date.getMonth() + 1) + '月' + date.getDate() + '日';
            }
        };

        // 打开设置 - 挂载世界书
        window.weiboOpenSettings = function() {
            // 创建世界书选择弹窗
            let modal = document.getElementById('weiboWorldbookModal');
            if (!modal) {
                modal = document.createElement('div');
                modal.id = 'weiboWorldbookModal';
                modal.style.cssText = 'position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 10004; display: none; align-items: center; justify-content: center;';
                modal.innerHTML = `
                    <div style="background: #fff; width: 90%; max-width: 400px; border-radius: 12px; overflow: hidden;">
                        <div style="padding: 16px; border-bottom: 1px solid #f0f0f0; display: flex; justify-content: space-between; align-items: center;">
                            <span style="font-size: 16px; font-weight: 600;">挂载世界书</span>
                            <span onclick="weiboCloseWorldbookModal()" style="cursor: pointer; font-size: 20px;">✕</span>
                        </div>
                        <div id="weiboWorldbookList" style="max-height: 400px; overflow-y: auto; padding: 12px;">
                            <!-- 世界书列表 -->
                        </div>
                        <div style="padding: 12px; border-top: 1px solid #f0f0f0; display: flex; gap: 10px;">
                            <button onclick="weiboCloseWorldbookModal()" style="flex: 1; padding: 12px; border: 1px solid #ddd; background: #fff; border-radius: 8px; cursor: pointer;">取消</button>
                            <button onclick="weiboSaveWorldbook()" style="flex: 1; padding: 12px; border: none; background: #ff6b6b; color: #fff; border-radius: 8px; cursor: pointer;">保存</button>
                        </div>
                    </div>
                `;
                document.body.appendChild(modal);
            }
            
            // 加载世界书列表
            weiboLoadWorldbookList();
            
            // 显示弹窗
            modal.style.display = 'flex';
        };
        
        // 关闭世界书选择弹窗
        window.weiboCloseWorldbookModal = function() {
            const modal = document.getElementById('weiboWorldbookModal');
            if (modal) {
                modal.style.display = 'none';
            }
        };
        
        // 加载世界书列表
        window.weiboLoadWorldbookList = async function() {
            const listEl = document.getElementById('weiboWorldbookList');
            listEl.innerHTML = '';
            
            // 获取已挂载的世界书
            const mountedBooks = await localforage.getItem('weiboMountedWorldbooks') || [];
            
            if (!relationshipData.worldBooks || relationshipData.worldBooks.length === 0) {
                listEl.innerHTML = '<div style="padding: 40px; text-align: center; color: #999;">暂无世界书，请先创建</div>';
                return;
            }
            
            relationshipData.worldBooks.forEach(book => {
                const isMounted = mountedBooks.includes(book.id);
                
                const item = document.createElement('div');
                item.style.cssText = 'display: flex; align-items: center; padding: 12px; border-bottom: 1px solid #f5f5f5; cursor: pointer;';
                item.onclick = function(e) {
                    if (e.target.type !== 'checkbox') {
                        const cb = this.querySelector('input[type="checkbox"]');
                        cb.checked = !cb.checked;
                    }
                };
                
                item.innerHTML = `
                    <input type="checkbox" value="${book.id}" ${isMounted ? 'checked' : ''} style="margin-right: 12px; width: 18px; height: 18px; cursor: pointer;">
                    <div style="flex: 1;">
                        <div style="font-size: 15px; color: #333; font-weight: 500;">${book.title || book.name || '未命名世界书'}</div>
                        <div style="font-size: 13px; color: #999; margin-top: 2px;">${book.content ? book.content.substring(0, 30) + '...' : '暂无内容'}</div>
                    </div>
                `;
                
                listEl.appendChild(item);
            });
        };
        
        // 保存挂载的世界书
        window.weiboSaveWorldbook = async function() {
            const checkboxes = document.querySelectorAll('#weiboWorldbookList input[type="checkbox"]:checked');
            const selectedIds = Array.from(checkboxes).map(cb => parseInt(cb.value));
            
            await localforage.setItem('weiboMountedWorldbooks', selectedIds);
            
            weiboCloseWorldbookModal();
            alert('世界书挂载成功！');
        };

        // 保存个人资料
        document.addEventListener('DOMContentLoaded', function() {
            const nameEl = document.getElementById('weiboProfileName');
            const bioEl = document.getElementById('weiboProfileBio');
            
            if (nameEl) {
                nameEl.addEventListener('blur', async function() {
                    await localforage.setItem('weiboProfileName', this.textContent);
                });
            }
            
            if (bioEl) {
                bioEl.addEventListener('blur', async function() {
                    await localforage.setItem('weiboProfileBio', this.textContent);
                });
            }
        });

        // ==================== 详情页面功能 ====================
        let currentDetailData = null;

        // 打开热搜详情（等待数据加载完成）
        window.weiboOpenHotDetail = async function(title) {
            const decodedTitle = decodeURIComponent(title);

            // 如果没有数据，提示用户先加载
            if (!weiboHotData || weiboHotData.length === 0) {
                alert('请先点击刷新按钮加载热搜数据');
                return;
            }

            // 检查当前标题是否存在于数据中
            const exists = weiboHotData.some(hot => hot.title === decodedTitle);
            if (!exists) {
                alert('请先点击刷新按钮加载最新热搜数据');
                return;
            }

            console.log('打开热搜详情:', decodedTitle);
            currentDetailData = { type: 'hot', title: decodedTitle };
            await weiboOpenDetailPage(decodedTitle);
        };

        // 打开新闻详情（等待数据加载完成）
        window.weiboOpenNewsDetail = async function(title) {
            const decodedTitle = decodeURIComponent(title);

            // 如果没有数据，提示用户先加载
            if (!weiboNewsData || weiboNewsData.length === 0) {
                alert('请先点击刷新按钮加载热点数据');
                return;
            }

            // 检查当前标题是否存在于数据中
            const exists = weiboNewsData.some(news => news.title === decodedTitle);
            if (!exists) {
                alert('请先点击刷新按钮加载最新热点数据');
                return;
            }

            console.log('打开新闻详情:', decodedTitle);
            currentDetailData = { type: 'news', title: decodedTitle };
            await weiboOpenDetailPage(decodedTitle);
        };

        // 打开详情页面
        window.weiboOpenDetailPage = async function(title) {
            // 创建详情页面
            let detailPage = document.getElementById('weiboDetailPage');
            if (!detailPage) {
                detailPage = document.createElement('div');
                detailPage.id = 'weiboDetailPage';
                detailPage.className = 'weibo-detail-page';
                detailPage.innerHTML = `
                    <div style="height: 30px; background: #fff; flex-shrink: 0;"></div>
                    <div class="weibo-detail-header">
                        <div class="weibo-detail-back" onclick="weiboCloseDetailPage()">
                            <svg viewBox="0 0 24 24" fill="currentColor">
                                <path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/>
                            </svg>
                        </div>
                        <div class="weibo-detail-title">详情</div>
                        <div class="weibo-detail-more" onclick="weiboShareDetail()">
                            <svg viewBox="0 0 24 24" fill="currentColor">
                                <path d="M18 16.08c-.76 0-1.44.3-1.96.77L8.91 12.7c.05-.23.09-.46.09-.7s-.04-.47-.09-.7l7.05-4.11c.54.5 1.25.81 2.04.81 1.66 0 3-1.34 3-3s-1.34-3-3-3-3 1.34-3 3c0 .24.04.47.09.7L8.04 9.81C7.5 9.31 6.79 9 6 9c-1.66 0-3 1.34-3 3s1.34 3 3 3c.79 0 1.5-.31 2.04-.81l7.12 4.16c-.05.21-.08.43-.08.65 0 1.61 1.31 2.92 2.92 2.92 1.61 0 2.92-1.31 2.92-2.92s-1.31-2.92-2.92-2.92z"/>
                            </svg>
                        </div>
                    </div>
                    <div class="weibo-detail-content" id="weiboDetailContent">
                        <div class="weibo-detail-loading">
                            <div class="weibo-detail-spinner"></div>
                            <p>正在加载内容...</p>
                        </div>
                    </div>
                `;
                document.body.appendChild(detailPage);
                
                // 添加详情页面样式
                const detailStyles = document.createElement('style');
                detailStyles.textContent = `
                    .weibo-detail-page {
                        position: fixed;
                        top: 0;
                        left: 0;
                        width: 100%;
                        height: 100%;
                        background: #f5f5f5;
                        z-index: 10001;
                        display: none;
                        flex-direction: column;
                        overflow: hidden;
                    }
                    
                    .weibo-detail-page.active {
                        display: flex;
                    }
                    
                    .weibo-detail-header {
                        background: #fff;
                        padding: 12px 16px;
                        display: flex;
                        justify-content: space-between;
                        align-items: center;
                        border-bottom: 1px solid #f0f0f0;
                        position: relative;
                        z-index: 10;
                    }
                    
                    .weibo-detail-back, .weibo-detail-more {
                        width: 36px;
                        height: 36px;
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        color: #666;
                        cursor: pointer;
                    }
                    
                    .weibo-detail-back svg, .weibo-detail-more svg {
                        width: 24px;
                        height: 24px;
                    }
                    
                    .weibo-detail-title {
                        font-size: 18px;
                        font-weight: 600;
                        color: #333;
                        flex: 1;
                        text-align: center;
                    }
                    
                    .weibo-detail-content {
                        flex: 1;
                        overflow-y: auto;
                        overflow-x: hidden;
                        -webkit-overflow-scrolling: touch;
                        padding-bottom: 20px;
                    }
                    
                    .weibo-detail-loading {
                        display: flex;
                        flex-direction: column;
                        align-items: center;
                        justify-content: center;
                        padding: 60px 20px;
                    }
                    
                    .weibo-detail-spinner {
                        width: 40px;
                        height: 40px;
                        border: 3px solid #f0f0f0;
                        border-top-color: #ff6b6b;
                        border-radius: 50%;
                        animation: weiboDetailSpin 1s linear infinite;
                        margin-bottom: 16px;
                    }
                    
                    @keyframes weiboDetailSpin {
                        to { transform: rotate(360deg); }
                    }
                    
                    .weibo-detail-article {
                        background: #fff;
                        padding: 20px;
                        margin-bottom: 10px;
                    }
                    
                    .weibo-detail-article-title {
                        font-size: 20px;
                        font-weight: 600;
                        color: #333;
                        line-height: 1.4;
                        margin-bottom: 12px;
                    }
                    
                    .weibo-detail-article-meta {
                        display: flex;
                        align-items: center;
                        gap: 12px;
                        font-size: 13px;
                        color: #999;
                        margin-bottom: 16px;
                    }
                    
                    .weibo-detail-article-source {
                        display: flex;
                        align-items: center;
                        gap: 6px;
                    }
                    
                    .weibo-detail-article-source-avatar {
                        width: 24px;
                        height: 24px;
                        border-radius: 50%;
                        background: linear-gradient(135deg, #ff6b6b, #ee5a5a);
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        font-size: 12px;
                    }
                    
                    .weibo-detail-article-content {
                        font-size: 15px;
                        color: #333;
                        line-height: 1.8;
                    }
                    
                    .weibo-detail-article-content p {
                        margin-bottom: 12px;
                    }

                    .weibo-detail-actions {
                        display: flex;
                        justify-content: space-around;
                        padding: 16px 0;
                        border-top: 1px solid #f0f0f0;
                        margin-top: 20px;
                    }
                    
                    .weibo-detail-action {
                        display: flex;
                        align-items: center;
                        gap: 6px;
                        color: #666;
                        font-size: 14px;
                        cursor: pointer;
                    }
                    
                    .weibo-detail-action svg {
                        width: 20px;
                        height: 20px;
                    }
                    
                    .weibo-detail-action.active {
                        color: #ff6b6b;
                    }
                    
                    .weibo-detail-comments {
                        background: #fff;
                        padding: 16px 20px;
                    }
                    
                    .weibo-detail-comments-header {
                        font-size: 16px;
                        font-weight: 600;
                        color: #333;
                        margin-bottom: 16px;
                        display: flex;
                        justify-content: space-between;
                        align-items: center;
                    }
                    
                    .weibo-detail-comments-count {
                        font-size: 13px;
                        color: #999;
                        font-weight: normal;
                    }
                    
                    .weibo-detail-comment {
                        display: flex;
                        gap: 12px;
                        padding: 16px 0;
                        border-bottom: 1px solid #f5f5f5;
                    }
                    
                    .weibo-detail-comment:last-child {
                        border-bottom: none;
                    }
                    
                    .weibo-detail-comment-avatar {
                        width: 40px;
                        height: 40px;
                        border-radius: 50%;
                        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        font-size: 16px;
                        flex-shrink: 0;
                    }
                    
                    .weibo-detail-comment-content {
                        flex: 1;
                    }
                    
                    .weibo-detail-comment-name {
                        font-size: 14px;
                        color: #ff6b6b;
                        margin-bottom: 4px;
                    }
                    
                    .weibo-detail-comment-text {
                        font-size: 14px;
                        color: #333;
                        line-height: 1.5;
                        margin-bottom: 8px;
                    }
                    
                    .weibo-detail-comment-time {
                        font-size: 12px;
                        color: #999;
                    }
                    
                    .weibo-detail-comment-actions {
                        display: flex;
                        gap: 16px;
                        margin-top: 8px;
                    }
                    
                    .weibo-detail-comment-action {
                        display: flex;
                        align-items: center;
                        gap: 4px;
                        font-size: 12px;
                        color: #999;
                        cursor: pointer;
                    }
                    
                    .weibo-detail-comment-input-bar {
                        position: fixed;
                        bottom: 0;
                        left: 0;
                        right: 0;
                        background: #fff;
                        padding: 10px 16px calc(10px + env(safe-area-inset-bottom, 0));
                        border-top: 1px solid #f0f0f0;
                        display: flex;
                        gap: 12px;
                        align-items: center;
                        z-index: 100;
                    }
                    
                    .weibo-detail-comment-input {
                        flex: 1;
                        background: #f5f5f5;
                        border: none;
                        border-radius: 20px;
                        padding: 10px 16px;
                        font-size: 14px;
                        outline: none;
                    }
                    
                    .weibo-detail-comment-send {
                        background: #ff6b6b;
                        color: #fff;
                        border: none;
                        padding: 8px 20px;
                        border-radius: 20px;
                        font-size: 14px;
                        cursor: pointer;
                    }
                    
                    .weibo-detail-comment-send:disabled {
                        background: #ccc;
                    }
                `;
                document.head.appendChild(detailStyles);
            }
            
            detailPage.style.display = 'flex';
            detailPage.classList.add('active');
            document.body.style.overflow = 'hidden';
            
            // 加载内容
            await weiboLoadDetailContent(title);
        };

        // 关闭详情页面
        window.weiboCloseDetailPage = function() {
            const detailPage = document.getElementById('weiboDetailPage');
            if (detailPage) {
                detailPage.style.display = 'none';
                document.body.style.overflow = '';
            }
        };

        // 加载详情内容
        window.weiboLoadDetailContent = async function(title) {
            const contentEl = document.getElementById('weiboDetailContent');
            
            try {
                // 1. 先从热搜数据中查找（AI生成的内容）
                let articleData = null;
                
                // 在热搜数据中查找匹配
                for (const hot of weiboHotData) {
                    if (hot.title === title) {
                        articleData = {
                            title: hot.title,
                            content: hot.content || weiboGenerateArticleContent(hot.title),
                            source: '微博热搜',
                            sourceAvatar: '🔥',
                            time: '刚刚',
                            image: '',
                            likes: Math.floor(Math.random() * 5000) + 500
                        };
                        break;
                    }
                }
                
                // 2. 从新闻列表中查找
                if (!articleData) {
                    for (const news of weiboNewsData) {
                        if (news.title && (news.title.includes(title.split(' ')[0]) || title.split(' ')[0].includes(news.title.substring(0, 4)))) {
                            articleData = {
                                title: news.title,
                                content: news.content || news.description || weiboGenerateArticleContent(news.title),
                                source: news.source || '新闻来源',
                                sourceAvatar: '📰',
                                time: news.time || '刚刚',
                                image: news.image || '',
                                likes: Math.floor(Math.random() * 5000) + 500
                            };
                            break;
                        }
                    }
                }
                
                // 3. 如果没找到，从预置数据库查找
                if (!articleData) {
                    articleData = weiboGetBackupNews(title);
                }
                
                // 生成AI评论
                const comments = await weiboGenerateAIComments(title);
                
                // 渲染页面（不显示图片）
                contentEl.innerHTML = `
                    <div class="weibo-detail-article">
                        <div class="weibo-detail-article-title">${articleData.title}</div>
                        <div class="weibo-detail-article-meta">
                            <div class="weibo-detail-article-source">
                                <div class="weibo-detail-article-source-avatar">${articleData.sourceAvatar}</div>
                                <span>${articleData.source}</span>
                            </div>
                            <span>${articleData.time}</span>
                        </div>
                        <div class="weibo-detail-article-content">
                            ${articleData.content}
                        </div>
                        <div class="weibo-detail-actions">
                            <div class="weibo-detail-action" onclick="weiboToggleLike(this)">
                                <svg viewBox="0 0 24 24" fill="currentColor">
                                    <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                                </svg>
                                <span>${articleData.likes}</span>
                            </div>
                            <div class="weibo-detail-action">
                                <svg viewBox="0 0 24 24" fill="currentColor">
                                    <path d="M21.99 4c0-1.1-.89-2-1.99-2H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h14l4 4-.01-18z"/>
                                </svg>
                                <span>${comments.length}</span>
                            </div>
                            <div class="weibo-detail-action" onclick="weiboShareDetail()">
                                <svg viewBox="0 0 24 24" fill="currentColor">
                                    <path d="M18 16.08c-.76 0-1.44.3-1.96.77L8.91 12.7c.05-.23.09-.46.09-.7s-.04-.47-.09-.7l7.05-4.11c.54.5 1.25.81 2.04.81 1.66 0 3-1.34 3-3s-1.34-3-3-3-3 1.34-3 3c0 .24.04.47.09.7L8.04 9.81C7.5 9.31 6.79 9 6 9c-1.66 0-3 1.34-3 3s1.34 3 3 3c.79 0 1.5-.31 2.04-.81l7.12 4.16c-.05.21-.08.43-.08.65 0 1.61 1.31 2.92 2.92 2.92 1.61 0 2.92-1.31 2.92-2.92s-1.31-2.92-2.92-2.92z"/>
                                </svg>
                                <span>分享</span>
                            </div>
                        </div>
                    </div>
                    
                    <div class="weibo-detail-comments">
                        <div class="weibo-detail-comments-header">
                            <span>评论 <span class="weibo-detail-comments-count">${comments.length}条</span></span>
                        </div>
                        <div class="weibo-detail-comments-list">
                            ${comments.map(comment => `
                                <div class="weibo-detail-comment" style="display: flex; padding: 12px 0; border-bottom: 1px solid #f0f0f0;">
                                    <div class="weibo-detail-comment-content" style="flex: 1;">
                                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
                                            <div class="weibo-detail-comment-name" style="color: #576b95; font-size: 14px; font-weight: 500;">${comment.name}</div>
                                            <div style="font-size: 12px; color: #999;">${comment.likes || 0}赞</div>
                                        </div>
                                        <div class="weibo-detail-comment-text" style="font-size: 15px; color: #333; line-height: 1.5; margin-bottom: 6px;">${comment.text}</div>
                                        <div style="display: flex; justify-content: space-between; align-items: center;">
                                            <div class="weibo-detail-comment-time" style="font-size: 12px; color: #999;">${comment.time || '刚刚'}</div>
                                            <div class="weibo-detail-comment-actions" style="display: flex; gap: 15px; font-size: 12px; color: #666;">
                                                <span style="cursor: pointer; display: flex; align-items: center; gap: 4px;">
                                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="width: 14px; height: 14px;">
                                                        <path d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
                                                    </svg>
                                                    点赞
                                                </span>
                                                <span style="cursor: pointer; display: flex; align-items: center; gap: 4px;">
                                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="width: 14px; height: 14px;">
                                                        <path d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
                                                    </svg>
                                                    回复
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            `).join('')}
                        </div>
                        
                        <!-- 加载更多评论按钮 -->
                        <div style="padding: 20px; text-align: center;">
                            <button id="weiboLoadMoreBtn" onclick="weiboLoadMoreHotComments('${title}')" style="padding: 10px 30px; border: 1px solid #ff6b6b; background: #fff; color: #ff6b6b; border-radius: 20px; cursor: pointer; font-size: 14px;">
                                加载更多评论
                            </button>
                        </div>
                    </div>
                    
                    <div style="height: 70px;"></div>
                    
                    <div class="weibo-detail-comment-input-bar">
                        <input type="text" class="weibo-detail-comment-input" placeholder="写评论..." id="weiboCommentInput">
                        <button class="weibo-detail-comment-send" onclick="weiboPostComment()">发送</button>
                    </div>
                `;
                
                // 添加输入框事件
                const input = document.getElementById('weiboCommentInput');
                if (input) {
                    input.addEventListener('keypress', function(e) {
                        if (e.key === 'Enter') {
                            weiboPostComment();
                        }
                    });
                }
                
            } catch (error) {
                contentEl.innerHTML = `
                    <div class="weibo-detail-loading">
                        <p>加载失败，请重试</p>
                        <button onclick="weiboLoadDetailContent('${title}')" style="margin-top: 16px; padding: 10px 30px; background: #ff6b6b; color: #fff; border: none; border-radius: 20px; cursor: pointer;">重新加载</button>
                    </div>
                `;
            }
        };

        // 获取真实新闻数据
        window.weiboFetchRealNews = async function(title) {
            try {
                // 尝试从多个新闻API获取数据
                // API 1: 使用NewsAPI (需要API key，这里使用备用方案)
                // API 2: 使用GNews API
                // API 3: 使用Currents API
                
                // 由于浏览器CORS限制，我们使用以下策略：
                // 1. 首先尝试从本地存储获取缓存的真实新闻
                // 2. 如果没有缓存，使用预置的真实新闻数据
                // 3. 定期更新缓存
                
                const cachedNews = await localforage.getItem('weiboRealNews_' + title);
                if (cachedNews && Date.now() - cachedNews.timestamp < 3600000) {
                    return cachedNews.data;
                }
                
                // 尝试获取实时新闻
                const realNews = await weiboTryFetchNewsAPI(title);
                if (realNews) {
                    await localforage.setItem('weiboRealNews_' + title, {
                        data: realNews,
                        timestamp: Date.now()
                    });
                    return realNews;
                }
                
                return null;
            } catch (error) {
                console.log('获取真实新闻失败:', error);
                return null;
            }
        };

        // 尝试从API获取新闻
        window.weiboTryFetchNewsAPI = async function(title) {
            try {
                // 使用NewsAPI的免费端点（有CORS限制，需要代理）
                // 这里使用一个公开的CORS代理服务
                const searchQuery = encodeURIComponent(title);
                
                // 尝试多个新闻源
                const apis = [
                    // 使用WorldNewsAPI (免费额度)
                    `https://api.worldnewsapi.com/search-news?text=${searchQuery}&api-key=demo`,
                    // 使用NewsData.io
                    `https://newsdata.io/api/1/news?apikey=pub_0&country=cn&language=zh&q=${searchQuery}`,
                ];
                
                for (const apiUrl of apis) {
                    try {
                        const response = await fetch(apiUrl, { 
                            method: 'GET',
                            headers: { 'Accept': 'application/json' }
                        });
                        
                        if (response.ok) {
                            const data = await response.json();
                            if (data.news && data.news.length > 0) {
                                const news = data.news[0];
                                return {
                                    title: news.title || title,
                                    content: news.text ? `<p>${news.text.replace(/\n/g, '</p><p>')}</p>` : weiboGenerateArticleContent(title),
                                    source: news.source || '新闻来源',
                                    sourceAvatar: '📰',
                                    time: news.publish_date ? new Date(news.publish_date).toLocaleString() : new Date().toLocaleString(),
                                    image: news.image || `https://picsum.photos/400/300?random=${Date.now()}`,
                                    likes: Math.floor(Math.random() * 5000) + 100
                                };
                            }
                        }
                    } catch (e) {
                        continue;
                    }
                }
                
                return null;
            } catch (error) {
                return null;
            }
        };

        // 获取备用新闻数据（预置的真实新闻）
        window.weiboGetBackupNews = function(title) {
            // 预置大量真实新闻内容 - 每个标题都有对应内容
            const realNewsDatabase = {
