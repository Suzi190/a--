    <!-- 信件内容页面 -->
    <div id="letterContentPage" class="letter-content-page">
        <div class="letter-content-bg"></div>
        <button class="letter-content-close" onclick="closeLetterContent()">✕</button>
        <div class="letter-content-area">
            <!-- 中间按钮区域 -->
            <div class="letter-buttons-container">
                <div class="letter-buttons-bg">
                    <img src="https://s41.ax1x.com/2026/02/16/pZLLVbQ.png" class="letter-btn" id="letterBtn1" alt="按钮1" onclick="openLetterGridPage()">
                    <img src="https://s41.ax1x.com/2026/02/16/pZLqLjO.png" class="letter-btn" id="letterBtn2" alt="按钮2" onclick="openWriteLetterPage()">
                </div>
            </div>
        </div>
