            // 【统一存储】保存聊天列表
            async saveChatList(chatList) {
                if (!this.isAvailable) return false;
                try {
                    const { CapacitorSQLite } = window.Capacitor.Plugins;
                    // 清空旧数据
                    await CapacitorSQLite.run({
