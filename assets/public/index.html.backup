                    { mid: '327280445', name: '瑜伽大师', desc: '睡前瑜伽，10分钟放松身心', avatar: 'https://i0.hdslb.com/bfs/face/9.jpg', fans: 2200000, tag: '实用' },
                    { mid: '327280456', name: '瑜伽达人', desc: '晨间瑜伽，唤醒身体活力', avatar: 'https://i0.hdslb.com/bfs/face/10.jpg', fans: 1800000, tag: 'AI推荐' },
                    { mid: '327280467', name: '健康瑜伽', desc: '办公室瑜伽，缓解颈椎疲劳', avatar: 'https://i0.hdslb.com/bfs/face/11.jpg', fans: 1500000, tag: '实用' },
                    { mid: '327280478', name: '塑形瑜伽', desc: '30天身材改造计划', avatar: 'https://i0.hdslb.com/bfs/face/12.jpg', fans: 1200000, tag: 'AI推荐' },
