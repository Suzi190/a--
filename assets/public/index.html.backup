        // 聊天标识配置
        const chatBadges = [
            { id: 1, name: '甜蜜之心', icon: 'https://s41.ax1x.com/2026/02/09/pZ7rcxe.png' },
            { id: 2, name: '闪耀之星', icon: 'https://s41.ax1x.com/2026/02/09/pZ7r2KH.png' },
