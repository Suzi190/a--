            'sports': { name: '体育', icon: '⚽', color: '#5856d6', keywords: '体育 足球 篮球 奥运' },
            'game': { name: '游戏', icon: '🎮', color: '#ff2d55', keywords: '游戏 电竞 手游' },
            'food': { name: '美食', icon: '🍜', color: '#ff6b6b', keywords: '美食 餐厅 食谱' },
