            const lunch = await localforage.getItem('recipe_today_lunch');
            const dinner = await localforage.getItem('recipe_today_dinner');
            
            if (breakfast) updateMealDisplay('breakfast', breakfast);
            if (lunch) updateMealDisplay('lunch', lunch);
            if (dinner) updateMealDisplay('dinner', dinner);
            
            updateTodayTotal();
