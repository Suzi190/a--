            'anime': { name: '动漫', icon: '🎬', color: '#ff6b35', keywords: '动漫 二次元' }
        };

        // 平台来源配置
        const weiboPlatformConfig = {
            'weibo': { name: '微博', icon: '🐚', color: '#ff8200' },
            'zhihu': { name: '知乎', icon: '💬', color: '#0084ff' },
            'bilibili': { name: 'B站', icon: '📺', color: '#00a1d6' },
            'toutiao': { name: '头条', icon: '📰', color: '#ff0000' },
            'baidu': { name: '百度', icon: '🔍', color: '#2932e1' },
