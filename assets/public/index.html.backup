        // 确认发布图片朋友圈
        async function confirmPostImage() {
            const content = document.getElementById('postImageTextInput').value.trim();
            const imageDesc = document.getElementById('postImageDescInput').value.trim();

            if (!currentMomentImage) {
                showCustomAlert('提示', '请选择图片');
                return;
            }

            // 创建朋友圈对象
            const moment = {
                id: Date.now(),
                authorId: 'user',
                authorName: cachedPersonalProfile?.name || '我',
                authorAvatar: cachedPersonalProfile?.avatar || '',
                content: content,
                type: 'image',
                image: currentMomentImage,
                imageDesc: imageDesc, // AI理解的图片描述
                createdAt: new Date().toISOString(),
                likes: [],
                comments: []
            };

            // 添加到朋友圈列表
            if (!relationshipData.moments) {
                relationshipData.moments = [];
            }
            relationshipData.moments.unshift(moment);

            // 保存数据
            await saveData();

            // 关闭弹窗并刷新列表
            closePostImageModal();
            renderMomentsList();

            // 【NPC自动评论】触发NPC对用户朋友圈的评论
            triggerNPCComments(moment, 'user');

            console.log('图片朋友圈发布成功:', moment);
        }

        // 【NPC自动评论】触发NPC对朋友圈的评论 - 群聊格式统一管理
        async function triggerNPCComments(moment, authorType) {
            try {
                // 获取所有可用的NPC（从通讯录中）
                const npcList = relationshipData.npcList || [];
                if (npcList.length === 0) {
                    console.log('【NPC评论】没有可用的NPC');
                    return;
                }

                // 随机选择2-4个NPC进行评论
                const numComments = Math.floor(Math.random() * 3) + 2; // 2-4个
                const shuffled = [...npcList].sort(() => 0.5 - Math.random());
                const selectedNPCs = shuffled.slice(0, Math.min(numComments, npcList.length));

                console.log(`【NPC评论】选择了 ${selectedNPCs.length} 个NPC进行评论`);

                // 【群聊格式】一次性生成所有NPC的评论
                const npcComments = await generateNPCCommentsBatch(selectedNPCs, moment, authorType);
                
                // 逐个显示评论（带延迟）
                for (let i = 0; i < npcComments.length; i++) {
                    const { npc, comment } = npcComments[i];
                    
                    // 延迟显示（每条间隔1-3秒）
                    const delay = Math.floor(Math.random() * 2000) + 1000;
                    await new Promise(resolve => setTimeout(resolve, delay));
                    
                    if (comment) {
                        addCommentToMoment(moment.id, {
                            authorId: 'npc_' + npc.id,
                            authorName: npc.name,
                            authorAvatar: npc.avatar,
                            content: comment,
                            createdAt: new Date().toISOString()
                        });
                        console.log(`【NPC评论】${npc.name}: ${comment}`);
                    }
                }

                // 随机点赞（50%概率）
                for (const npc of npcList) {
                    if (Math.random() < 0.5) {
                        const likeDelay = Math.floor(Math.random() * 3000) + 500;
                        await new Promise(resolve => setTimeout(resolve, likeDelay));
                        
                        addLikeToMoment(moment.id, {
                            authorId: 'npc_' + npc.id,
                            authorName: npc.name,
                            authorAvatar: npc.avatar
                        });
                        
                        console.log(`【NPC点赞】${npc.name} 点赞了朋友圈`);
                    }
                }

            } catch (error) {
                console.error('【NPC评论】触发评论失败:', error);
            }
        }

        // 【NPC评论】批量生成所有NPC的评论 - 群聊格式
        async function generateNPCCommentsBatch(selectedNPCs, moment, authorType) {
            try {
                // 获取API设置
                const savedSettings = await loadAppSettings({});
                const apiKey = savedSettings.api?.apiKey || '';
                const baseUrl = savedSettings.api?.baseUrl || 'https://api.openai.com/v1';
                const model = savedSettings.api?.model || 'gpt-3.5-turbo';

                if (!apiKey) {
                    console.warn('【NPC评论】未配置API密钥，使用默认评论');
                    return selectedNPCs.map(npc => ({ npc, comment: getDefaultNPCComment(npc) }));
                }

                // 构建朋友圈内容描述
                let momentContent = moment.content || '';
                if (moment.type === 'image') {
                    momentContent += ' [图片]';
                    if (moment.imageDesc) {
                        momentContent += ` 图片描述：${moment.imageDesc}`;
                    }
                }

                // 获取作者名称
                const authorName = authorType === 'user' ? 
                    (cachedPersonalProfile?.name || '用户') : 
                    (moment.authorName || 'AI');

                // 【群聊格式】构建所有NPC的人设信息
                const npcsInfo = selectedNPCs.map(npc => 
                    `- ${npc.name}：${npc.personality || '一个普通人'}`
                ).join('\n');

                // 【群聊格式】System Prompt
                const systemPrompt = `你是一个朋友圈评论生成器。以下是${selectedNPCs.length}个朋友：

${npcsInfo}

请根据朋友圈内容，为每个人生成一条评论。
规则：
1. 每个人的评论要符合其人设性格
2. 要针对朋友圈的具体内容，不要通用回复
3. 要自然、真实，像朋友一样说话
4. 每个人评论10-30字
5. 使用以下格式输出（严格遵循）：

[姓名1]: 评论内容
====
[姓名2]: 评论内容
====
[姓名3]: 评论内容

注意：
- 必须包含所有${selectedNPCs.length}个人
- 每个人一行，用====分隔
- 不要加引号
- 不要有多余的解释文字`;

                const userPrompt = `朋友圈作者：${authorName}
朋友圈内容：${momentContent}

请为所有朋友生成评论：`;

                // 调用AI API
                // 【修复】添加超时处理，防止请求卡住
                const controller = new AbortController();
                const timeoutId = setTimeout(() => controller.abort(), 300000); // 【修改】300秒超时
                
                const response = await fetch(`${baseUrl}/chat/completions`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${apiKey}`
                    },
                    body: JSON.stringify({
                        model: model,
                        messages: [
                            { role: 'system', content: systemPrompt },
                            { role: 'user', content: userPrompt }
                        ],
                        temperature: 0.8,
                        max_tokens: 300
                    }),
                    signal: controller.signal
                });
                
                clearTimeout(timeoutId); // 请求成功，清除超时

                if (!response.ok) {
                    throw new Error(`API请求失败: ${response.status}`);
                }

                const data = await response.json();
                const aiResponse = data.choices?.[0]?.message?.content?.trim();

                if (!aiResponse) {
                    throw new Error('AI返回空内容');
                }

                console.log('【NPC评论】AI原始响应:', aiResponse);

                // 解析AI响应
                return parseNPCCommentsResponse(aiResponse, selectedNPCs);

            } catch (error) {
                console.error('【NPC评论】批量生成失败:', error);
                // 降级：使用默认评论
                return selectedNPCs.map(npc => ({ npc, comment: getDefaultNPCComment(npc) }));
            }
        }

        // 【NPC评论】解析AI的群聊格式响应
        function parseNPCCommentsResponse(aiResponse, selectedNPCs) {
            const result = [];
            
            // 按====分割每个人的评论
            const parts = aiResponse.split('====').map(p => p.trim()).filter(p => p);
            
            for (const part of parts) {
                // 匹配 [姓名]: 评论内容 或 姓名: 评论内容
                const match = part.match(/^\[?([^\]:]+)\]?:\s*(.+)$/s);
                if (match) {
                    const name = match[1].trim();
                    const comment = match[2].trim().replace(/^["']|["']$/g, '');
                    
                    // 找到对应的NPC
                    const npc = selectedNPCs.find(n => n.name === name);
                    if (npc && comment) {
                        result.push({ npc, comment });
                    }
                }
            }

            // 如果解析失败，为未匹配的NPC使用默认评论
            const matchedNames = new Set(result.map(r => r.npc.name));
            for (const npc of selectedNPCs) {
                if (!matchedNames.has(npc.name)) {
                    result.push({ npc, comment: getDefaultNPCComment(npc) });
                }
            }

            return result;
        }

        // 【NPC评论】获取默认评论（AI失败时使用）
        function getDefaultNPCComment(npc) {
            if (npc.personality) {
                const personality = npc.personality.toLowerCase();
                if (personality.includes('温柔') || personality.includes('体贴')) {
                    return '真的很棒呢，为你感到开心~';
                } else if (personality.includes('活泼') || personality.includes('开朗')) {
                    return '哇塞！这也太赞了吧！';
                } else if (personality.includes('冷静') || personality.includes('沉稳')) {
                    return '不错。';
                } else if (personality.includes('幽默') || personality.includes('搞笑')) {
                    return '哈哈哈，这波操作我给满分！';
                }
            }
            return '支持支持！';
        }

        // 【NPC评论】添加评论到朋友圈
        function addCommentToMoment(momentId, comment) {
            const moment = relationshipData.moments?.find(m => m.id === momentId);
            if (!moment) return;

            if (!moment.comments) {
                moment.comments = [];
            }

            // 检查是否已评论过
            const existingComment = moment.comments.find(c => c.authorId === comment.authorId);
            if (existingComment) return;

            moment.comments.push(comment);
            saveData();

            // 如果在朋友圈页面，刷新显示
            if (document.getElementById('momentsPage')?.style.display === 'flex') {
                renderMomentsList();
            }
        }

        // 【NPC评论】添加点赞到朋友圈
        function addLikeToMoment(momentId, like) {
            const moment = relationshipData.moments?.find(m => m.id === momentId);
            if (!moment) return;

            if (!moment.likes) {
                moment.likes = [];
            }

            // 检查是否已点赞过
            const existingLike = moment.likes.find(l => l.authorId === like.authorId);
            if (existingLike) return;

            moment.likes.push(like);
            saveData();

            // 如果在朋友圈页面，刷新显示
            if (document.getElementById('momentsPage')?.style.display === 'flex') {
                renderMomentsList();
            }
        }

        // 渲染朋友圈列表
        function renderMomentsList() {
            const listContainer = document.getElementById('momentsList');
            const moments = relationshipData.moments || [];

            if (moments.length === 0) {
                listContainer.innerHTML = '<div class="moments-empty">暂无朋友圈内容</div>';
                return;
            }

            listContainer.innerHTML = moments.map(moment => createMomentCardHTML(moment)).join('');
        }

        // 创建朋友圈卡片HTML
        function createMomentCardHTML(moment) {
            const isUser = moment.authorId === 'user';
            
            // 【修复】实时获取最新的头像和名称
            let avatar = moment.authorAvatar;
            let name = moment.authorName;
            
            if (isUser) {
                // 用户自己：使用当前设置的头像和名称
                avatar = cachedPersonalProfile?.avatar || moment.authorAvatar || 'https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=cartoon%20avatar%20of%20a%20boy%2C%20cute%2C%20simple%20style&image_size=square';
                name = cachedPersonalProfile?.name || moment.authorName || '我';
            } else if (moment.authorId && moment.authorId.startsWith('ai_')) {
                // AI角色：从wechatChatList中获取最新的头像和名称
                const aiId = moment.authorId.replace('ai_', '');
                const aiChatItem = relationshipData.wechatChatList.find(item => item.id == aiId);
                if (aiChatItem) {
                    avatar = aiChatItem.avatar || moment.authorAvatar || 'https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=cartoon%20avatar%20of%20a%20boy%2C%20cute%2C%20simple%20style&image_size=square';
                    name = aiChatItem.remark || aiChatItem.name || moment.authorName || 'AI';
                } else {
                    avatar = moment.authorAvatar || 'https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=cartoon%20avatar%20of%20a%20boy%2C%20cute%2C%20simple%20style&image_size=square';
                    name = moment.authorName || 'AI';
                }
            } else {
                // 其他情况（如NPC等）
                avatar = moment.authorAvatar || 'https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=cartoon%20avatar%20of%20a%20boy%2C%20cute%2C%20simple%20style&image_size=square';
                name = moment.authorName || '未知';
            }

            // 点赞区域
            let likesHTML = '';
            if (moment.likes && moment.likes.length > 0) {
                const likeNames = moment.likes.map(like => like.name).join('，');
                likesHTML = `
                    <div class="moment-likes">
                        <span class="moment-likes-icon">❤️</span>
                        <span class="moment-likes-names">${likeNames}</span>
                    </div>
                `;
            }

            // 评论区域
            let commentsHTML = '';
            if (moment.comments && moment.comments.length > 0) {
                commentsHTML = `
                    <div class="moment-comments">
                        ${moment.comments.map(comment => {
                            // 【修复】实时获取评论者最新的头像和名称
                            let commentAvatar = comment.avatar;
                            let commentName = comment.name;
                            
                            if (comment.id === 'user') {
                                // 用户自己
                                commentAvatar = cachedPersonalProfile?.avatar || comment.avatar || 'https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=cartoon%20avatar%20of%20a%20boy%2C%20cute%2C%20simple%20style&image_size=square';
                                commentName = cachedPersonalProfile?.name || comment.name || '我';
                            } else if (comment.id && comment.id.startsWith('ai_')) {
                                // AI角色
                                const commentAiId = comment.id.replace('ai_', '');
                                const commentAiItem = relationshipData.wechatChatList.find(item => item.id == commentAiId);
                                if (commentAiItem) {
                                    commentAvatar = commentAiItem.avatar || comment.avatar || 'https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=cartoon%20avatar%20of%20a%20boy%2C%20cute%2C%20simple%20style&image_size=square';
                                    commentName = commentAiItem.remark || commentAiItem.name || comment.name || 'AI';
                                } else {
                                    commentAvatar = comment.avatar || 'https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=cartoon%20avatar%20of%20a%20boy%2C%20cute%2C%20simple%20style&image_size=square';
                                    commentName = comment.name || 'AI';
                                }
                            } else {
                                // 其他情况
                                commentAvatar = comment.avatar || 'https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=cartoon%20avatar%20of%20a%20boy%2C%20cute%2C%20simple%20style&image_size=square';
                                commentName = comment.name || '未知';
                            }
                            
                            return `
                            <div class="moment-comment-item">
                                <div class="moment-comment-avatar">
                                    <img src="${commentAvatar}" alt="">
                                </div>
                                <div class="moment-comment-content">
                                    <span class="moment-comment-name">${commentName}</span>：${comment.content}
                                </div>
                            </div>
                        `}).join('')}
                    </div>
                `;
            }

            // 图片区域
            let imageHTML = '';
            if (moment.type === 'image' && moment.image) {
                imageHTML = `
                    <div class="moment-image">
                        <img src="${moment.image}" alt="朋友圈图片">
                    </div>
                `;
            }

            // 互动区域
            const interactionsHTML = (likesHTML || commentsHTML) ? `
                <div class="moment-interactions">
                    ${likesHTML}
                    ${commentsHTML}
                </div>
            ` : '';

            return `
                <div class="moment-card" data-moment-id="${moment.id}" 
                     onmousedown="startMomentLongPress(${moment.id}, event)" 
                     ontouchstart="startMomentLongPress(${moment.id}, event)"
                     onmouseup="cancelMomentLongPress()"
                     ontouchend="cancelMomentLongPress()"
                     onmouseleave="cancelMomentLongPress()"
                     ontouchcancel="cancelMomentLongPress()"
                     oncontextmenu="return false;">
                    <div class="moment-card-header">
                        <div class="moment-avatar">
                            <img src="${avatar}" alt="">
                        </div>
                        <div class="moment-info">
                            <div class="moment-name">${name}</div>
                            <div class="moment-content">${moment.content}</div>
                            ${imageHTML}
                        </div>
                    </div>
                    <div class="moment-actions">
                        <div class="moment-more-btn" onclick="event.stopPropagation(); showMomentActions(${moment.id})">•••</div>
                    </div>
                    ${interactionsHTML}
                </div>
            `;
        }

        // 当前操作的朋友圈ID
        let currentMomentId = null;

        // 【新增】长按删除相关变量
        let momentLongPressTimer = null;
        const MOMENT_LONG_PRESS_DURATION = 800; // 长按触发时间（毫秒）

        // 【新增】开始长按
        function startMomentLongPress(momentId, event) {
            // 阻止默认行为和冒泡
            if (event) {
                event.preventDefault();
                event.stopPropagation();
            }
            
            // 清除之前的定时器
            if (momentLongPressTimer) {
                clearTimeout(momentLongPressTimer);
                momentLongPressTimer = null;
            }
            
            // 设置新的定时器
            momentLongPressTimer = setTimeout(() => {
                momentLongPressTimer = null;
                // 触发删除确认
                confirmDeleteMoment(momentId);
            }, MOMENT_LONG_PRESS_DURATION);
        }

        // 【新增】取消长按
        function cancelMomentLongPress() {
            if (momentLongPressTimer) {
                clearTimeout(momentLongPressTimer);
                momentLongPressTimer = null;
            }
        }

        // 【新增】确认删除朋友圈
        function confirmDeleteMoment(momentId) {
            const moment = relationshipData.moments.find(m => m.id === momentId);
            if (!moment) return;
            
            // 检查是否有权限删除（只能删除自己的朋友圈）
            const isUser = moment.authorId === 'user';
            const isAI = moment.authorId && moment.authorId.startsWith('ai_');
            
            // 构建确认消息
            let confirmMessage = '';
            if (isUser) {
                confirmMessage = '确定要删除这条朋友圈吗？';
            } else if (isAI) {
                const aiId = moment.authorId.replace('ai_', '');
                const aiChatItem = relationshipData.wechatChatList.find(item => item.id == aiId);
                const aiName = aiChatItem ? (aiChatItem.remark || aiChatItem.name) : 'AI';
                confirmMessage = `确定要删除${aiName}的这条朋友圈吗？`;
            } else {
                confirmMessage = '确定要删除这条朋友圈吗？';
            }
            
            if (confirm(confirmMessage)) {
                deleteMoment(momentId);
            }
        }

        // 【新增】删除朋友圈
        async function deleteMoment(momentId) {
            try {
                const momentIndex = relationshipData.moments.findIndex(m => m.id === momentId);
                if (momentIndex === -1) {
                    showToast('朋友圈不存在', 'error');
                    return;
                }
                
                // 删除朋友圈
                relationshipData.moments.splice(momentIndex, 1);
                
                // 保存数据
                await saveData();
                
                // 刷新列表
                renderMomentsList();
                
                showToast('删除成功', 'success');
                console.log('朋友圈删除成功:', momentId);
            } catch (error) {
                console.error('删除朋友圈失败:', error);
                showToast('删除失败: ' + error.message, 'error');
            }
        }

        // 显示朋友圈操作菜单
        function showMomentActions(momentId) {
            currentMomentId = momentId;
            const moment = relationshipData.moments.find(m => m.id === momentId);
            if (!moment) return;

            // 检查是否已点赞
            const hasLiked = moment.likes && moment.likes.some(like => like.id === 'user');
            document.getElementById('likeActionText').textContent = hasLiked ? '取消点赞' : '点赞';

            document.getElementById('momentActionModal').style.display = 'flex';
        }

        // 关闭操作菜单
        function closeMomentActions() {
            document.getElementById('momentActionModal').style.display = 'none';
            // 不要在这里清空currentMomentId，因为后续操作可能还需要用到
        }

        // 关闭操作菜单并清空ID（用于点赞后）
        function closeMomentActionsAndClear() {
            closeMomentActions();
            currentMomentId = null;
        }

        // 点赞/取消点赞当前朋友圈
        async function likeCurrentMoment() {
            if (!currentMomentId) return;

            const moment = relationshipData.moments.find(m => m.id === currentMomentId);
            if (!moment) return;

            if (!moment.likes) moment.likes = [];

            const userLikeIndex = moment.likes.findIndex(like => like.id === 'user');

            if (userLikeIndex > -1) {
                // 取消点赞
                moment.likes.splice(userLikeIndex, 1);
            } else {
                // 点赞
                moment.likes.push({
                    id: 'user',
                    name: cachedPersonalProfile?.name || '我'
                });
            }

            await saveData();
            renderMomentsList();
            closeMomentActionsAndClear();
        }

        // 评论当前朋友圈
        function commentCurrentMoment() {
            console.log('commentCurrentMoment 被调用');
            console.log('currentMomentId:', currentMomentId);
            closeMomentActions();
            document.getElementById('commentModal').style.display = 'flex';
            document.getElementById('commentInput').value = '';
            document.getElementById('commentInput').focus();
        }

        // 关闭评论弹窗
        function closeCommentModal() {
            document.getElementById('commentModal').style.display = 'none';
        }

        // 评论弹窗背景点击
        function onCommentModalBackgroundClick(event) {
            if (event.target === document.getElementById('commentModal')) {
                closeCommentModal();
            }
        }

        // 确认发送评论
        async function confirmComment() {
            console.log('confirmComment 被调用');
            console.log('currentMomentId:', currentMomentId);
            
            // 保存currentMomentId的副本
            const targetMomentId = currentMomentId;
            
            const content = document.getElementById('commentInput').value.trim();
            console.log('评论内容:', content);
            
            if (!content) {
                showCustomAlert('提示', '请输入评论内容');
                return;
            }

            if (!targetMomentId) {
                console.error('targetMomentId 为空');
                return;
            }

            const moment = relationshipData.moments.find(m => m.id === targetMomentId);
            console.log('找到的朋友圈:', moment);
            
            if (!moment) {
                console.error('未找到朋友圈');
                return;
            }

            if (!moment.comments) moment.comments = [];

            const newComment = {
                id: Date.now(),
                authorId: 'user',
                name: cachedPersonalProfile?.name || '我',
                avatar: cachedPersonalProfile?.avatar || '',
                content: content,
                createdAt: new Date().toISOString()
            };
            
            console.log('新评论:', newComment);

            moment.comments.push(newComment);

            try {
                await saveData();
                console.log('数据保存成功');
                renderMomentsList();
                closeCommentModal();
                currentMomentId = null; // 清空ID
                console.log('评论发送完成');
            } catch (error) {
                console.error('保存失败:', error);
                showCustomAlert('错误', '发送失败，请重试');
            }
        }

        // 点击弹窗背景关闭
        document.addEventListener('DOMContentLoaded', () => {
            const postOptionsModal = document.getElementById('postOptionsModal');
            if (postOptionsModal) {
                postOptionsModal.addEventListener('click', (e) => {
                    if (e.target === postOptionsModal) {
                        closePostOptions();
                    }
                });
            }

            const momentActionModal = document.getElementById('momentActionModal');
            if (momentActionModal) {
                momentActionModal.addEventListener('click', (e) => {
                    if (e.target === momentActionModal) {
                        closeMomentActions();
                    }
                });
            }

        });

        // ==================== 朋友圈功能结束 ====================

        // 加载NPC列表
        function loadNPCList() {
            const npcList = document.getElementById('contactsNPCList');
            npcList.innerHTML = '';

            // 确保npcList数组存在
            if (!relationshipData.npcList) {
                relationshipData.npcList = [];
            }

            if (relationshipData.npcList.length === 0) {
                npcList.innerHTML = '<div style="text-align: center; padding: 40px; color: #999;">暂无NPC，点击右上角+添加</div>';
                return;
            }

            relationshipData.npcList.forEach(npc => {
                const npcItem = document.createElement('div');
                npcItem.className = 'contacts-npc-item';
                npcItem.dataset.npcId = npc.id;

                // 单击打开详情
                npcItem.onclick = () => openNPCDetail(npc.id);

                // 获取关联角色名称（排除群聊）
                const relationNames = npc.relations ? npc.relations.map(id => {
                    const char = relationshipData.wechatChatList.find(c => c.id == id && !c.isGroupChat);
                    return char ? (char.remark || char.name) : null;
                }).filter(name => name !== null).join('、') || '无关联角色' : '无关联角色';

                // 【修复】检查头像是否有效
                let npcAvatar = '👤';
                if (npc.avatar && typeof npc.avatar === 'string') {
                    if (npc.avatar.startsWith('http') || npc.avatar.startsWith('data:')) {
                        npcAvatar = `<img src="${npc.avatar}" style="width: 100%; height: 100%; border-radius: 10px; object-fit: cover;">`;
                    } else if (!npc.avatar.startsWith('chatAvatar_') && npc.avatar.length <= 2) {
                        npcAvatar = npc.avatar;
                    }
                }

                npcItem.innerHTML = `
                    <div class="contacts-npc-avatar">${npcAvatar}</div>
                    <div class="contacts-npc-info">
                        <div class="contacts-npc-name">${npc.name}</div>
                        <div class="contacts-npc-relations">关联: ${relationNames}</div>
                    </div>
                `;

                npcList.appendChild(npcItem);
            });
        }

        // 显示删除NPC确认弹窗
        function showDeleteNPCConfirm(npcId, npcName) {
            showCustomAlert('删除NPC', `确定要删除NPC "${npcName}" 吗？`, 'confirm', async () => {
                await deleteNPC(npcId);
            });
        }

        // 删除NPC
        async function deleteNPC(npcId) {
            const npcIndex = relationshipData.npcList.findIndex(n => n.id === npcId);
            if (npcIndex === -1) return;

            const npc = relationshipData.npcList[npcIndex];

            // 从关联角色的characterNPCs中移除
            if (npc.relations && npc.relations.length > 0) {
                npc.relations.forEach(charId => {
                    const char = relationshipData.wechatChatList.find(c => c.id == charId);
                    if (char && char.characterNPCs) {
                        char.characterNPCs = char.characterNPCs.filter(n => n.id !== npcId);
                        console.log(`角色 ${char.name} 不再认识NPC: ${npc.name}`);
                    }
                });
            }

            // 从列表中删除
            relationshipData.npcList.splice(npcIndex, 1);

            // 保存数据
            await saveData();

            console.log('NPC删除成功:', npc.name);

            // 刷新列表
            loadNPCList();
        }

        // 打开添加NPC弹窗
        function openAddNPCModal() {
            const modal = document.getElementById('addNPCModal');
            modal.style.display = 'block';

            // 清空表单
            document.getElementById('npcNameInput').value = '';
            document.getElementById('npcPersonalityInput').value = '';

            // 加载AI角色列表供选择
            loadNPCRelationsSelect();
        }

        // 关闭添加NPC弹窗
        function closeAddNPCModal() {
            const modal = document.getElementById('addNPCModal');
            modal.style.display = 'none';
        }

        // 加载关联角色选择列表
        function loadNPCRelationsSelect() {
            const container = document.getElementById('npcRelationsSelect');
            container.innerHTML = '';

            // 获取所有AI角色（排除群聊）
            const aiCharacters = (relationshipData.wechatChatList || []).filter(char => !char.isGroupChat);

            if (aiCharacters.length === 0) {
                container.innerHTML = '<div style="color: #999; font-size: 13px;">暂无AI角色，请先创建角色</div>';
                return;
            }

            aiCharacters.forEach(char => {
                const tag = document.createElement('div');
                tag.className = 'npc-relation-tag';
                tag.dataset.charId = char.id;
                tag.onclick = () => toggleNPCRelation(tag);

                // 【修复】检查头像是否有效（URL 或 emoji）
                let avatar = '👤';
                if (char.avatar && typeof char.avatar === 'string') {
                    // 如果是 URL（以 http 开头或是 base64）
                    if (char.avatar.startsWith('http') || char.avatar.startsWith('data:')) {
                        avatar = `<img src="${char.avatar}" style="width: 24px; height: 24px; border-radius: 50%; object-fit: cover;">`;
                    }
                    // 如果是 emoji 或普通字符串（不是 key）
                    else if (!char.avatar.startsWith('chatAvatar_') && char.avatar.length <= 2) {
                        avatar = char.avatar;
                    }
                }

                const name = char.remark || char.name || '未命名';

                tag.innerHTML = `
                    <span>${avatar}</span>
                    <span>${name}</span>
                `;

                container.appendChild(tag);
            });
        }

        // 切换关联角色选择
        function toggleNPCRelation(tag) {
            tag.classList.toggle('selected');
        }

        // 确认添加NPC
        async function confirmAddNPC() {
            const name = document.getElementById('npcNameInput').value.trim();
            const personality = document.getElementById('npcPersonalityInput').value.trim();

            if (!name) {
                alert('请输入NPC名字');
                return;
            }

            // 获取选中的关联角色
            const selectedTags = document.querySelectorAll('.npc-relation-tag.selected');
            const relations = Array.from(selectedTags).map(tag => parseInt(tag.dataset.charId));

            // 创建NPC对象
            const npc = {
                id: Date.now(),
                name: name,
                personality: personality,
                relations: relations,
                createdAt: new Date().toISOString()
            };

            // 确保npcList数组存在
            if (!relationshipData.npcList) {
                relationshipData.npcList = [];
            }

            // 添加到列表
            relationshipData.npcList.push(npc);
            console.log('NPC已添加到列表:', npc);
            console.log('当前NPC列表:', relationshipData.npcList);

            // 更新关联角色的NPC认知
            await updateCharacterNPCAwareness(npc);

            // 保存数据
            await saveData();
            console.log('NPC数据已保存到存储');

            // 关闭弹窗并刷新列表
            closeAddNPCModal();
            loadNPCList();
        }

        // 更新角色对NPC的认知（互相关联）
        async function updateCharacterNPCAwareness(npc) {
            if (!npc.relations || npc.relations.length === 0) return;

            // 为每个关联角色添加对这个NPC的认知
            npc.relations.forEach(charId => {
                const char = relationshipData.wechatChatList.find(c => c.id == charId);
                if (char) {
                    // 确保characterNPCs数组存在
                    if (!char.characterNPCs) {
                        char.characterNPCs = [];
                    }

                    // 检查是否已存在
                    const exists = char.characterNPCs.find(n => n.id === npc.id);
                    if (!exists) {
                        char.characterNPCs.push({
                            id: npc.id,
                            name: npc.name,
                            personality: npc.personality
                        });
                        console.log(`角色 ${char.name} 现在认识NPC: ${npc.name}`);
                    }
                }
            });
        }

        // 打开NPC详情
        // 当前查看的NPC ID
        let currentViewingNPCId = null;

        function openNPCDetail(npcId) {
            const npc = relationshipData.npcList.find(n => n.id === npcId);
            if (!npc) return;

            // 保存当前查看的NPC ID
            currentViewingNPCId = npcId;

            document.getElementById('npcDetailName').textContent = npc.name;
            document.getElementById('npcDetailPersonality').textContent = npc.personality || '暂无描述';

            // 【修复】检查头像是否有效
            const avatarElement = document.getElementById('npcDetailAvatar');
            let npcAvatar = '👤';
            if (npc.avatar && typeof npc.avatar === 'string') {
                if (npc.avatar.startsWith('http') || npc.avatar.startsWith('data:')) {
                    avatarElement.innerHTML = `<img src="${npc.avatar}" style="width: 100%; height: 100%; border-radius: 12px; object-fit: cover;">`;
                } else if (!npc.avatar.startsWith('chatAvatar_') && npc.avatar.length <= 2) {
                    avatarElement.textContent = npc.avatar;
                } else {
                    avatarElement.textContent = '👤';
                }
            } else {
                avatarElement.textContent = '👤';
            }

            // 显示关联角色
            const relationsContainer = document.getElementById('npcDetailRelations');
            relationsContainer.innerHTML = '';

            if (npc.relations && npc.relations.length > 0) {
                npc.relations.forEach(charId => {
                    const char = relationshipData.wechatChatList.find(c => c.id == charId);
                    if (char) {
                        const item = document.createElement('div');
                        item.className = 'npc-detail-relation-item';
                        item.textContent = char.remark || char.name;
                        relationsContainer.appendChild(item);
                    }
                });
            } else {
                relationsContainer.innerHTML = '<span style="color: #999;">无关联角色</span>';
            }

            document.getElementById('npcDetailModal').style.display = 'block';
        }

        // 关闭NPC详情弹窗
        function closeNPCDetailModal() {
            document.getElementById('npcDetailModal').style.display = 'none';
            currentViewingNPCId = null;
        }

        // 删除当前查看的NPC
        async function deleteCurrentNPC() {
            if (!currentViewingNPCId) return;

            const npc = relationshipData.npcList.find(n => n.id === currentViewingNPCId);
            if (!npc) return;

            showCustomAlert('删除NPC', `确定要删除NPC "${npc.name}" 吗？`, 'confirm', async () => {
                await deleteNPC(currentViewingNPCId);
                closeNPCDetailModal();
            });
        }

        // ==================== 通讯录功能结束 ====================

        // 初始化AI人设列表
        function initAIList() {
            const aiList = document.querySelector('.wechat-ai-list');
            if (!aiList) return;
            
            // 清空列表
            aiList.innerHTML = '';
            
            // 示例AI人设数据
            const aiPersonas = [
                {
                    id: 1,
                    name: '小助手',
                    avatar: '🤖',
                    preview: '你好！我是你的AI助手，有什么可以帮你的吗？',
                    time: '10:30'
                },
                {
                    id: 2,
                    name: '心理咨询师',
                    avatar: '🧠',
                    preview: '最近心情怎么样？',
                    time: '昨天'
                },
                {
                    id: 3,
                    name: '学习导师',
                    avatar: '📚',
                    preview: '今天学习了什么新知识？',
                    time: '周一'
                }
            ];
            
            // 添加AI人设项
            aiPersonas.forEach(persona => {
                const aiItem = document.createElement('div');
                aiItem.className = 'wechat-ai-item';
                aiItem.onclick = () => openAIChat(persona.id, persona);
                
                aiItem.innerHTML = `
                    <div class="wechat-ai-avatar">${persona.avatar}</div>
                    <div class="wechat-ai-info">
                        <div class="wechat-ai-name">${persona.name}</div>
                        <div class="wechat-ai-preview">${persona.preview}</div>
                    </div>
                    <div class="wechat-ai-time">${persona.time}</div>
                `;
                
                aiList.appendChild(aiItem);
            });
        }

        // 打开AI聊天
        function openAIChat(aiId, persona) {
            console.log('打开AI聊天:', aiId, persona);
            // 打开聊天界面
            openChatInterface(aiId, persona.name, persona.avatar);
        }

        function openWorldBook() {
            console.log('打开世界书');
            const worldBookPage = document.getElementById('worldBookPage');
            worldBookPage.style.display = 'flex';
            renderWorldBookCards();
        }

        function closeWorldBook() {
            console.log('关闭世界书');
            const worldBookPage = document.getElementById('worldBookPage');
            worldBookPage.style.display = 'none';
            // 清空输入框
            document.getElementById('worldBookTitle').value = '';
            document.getElementById('worldBookContent').value = '';
        }

        function saveWorldBook() {
            const title = document.getElementById('worldBookTitle').value.trim();
            const content = document.getElementById('worldBookContent').value.trim();

            if (!title || !content) {
                alert('请输入标题和内容');
                return;
            }

            // 创建新的世界书
            const newWorldBook = {
                id: Date.now(),
                title: title,
                content: content,
                createdAt: new Date().toISOString()
            };

            // 添加到世界书列表
            relationshipData.worldBooks.push(newWorldBook);

            // 保存数据
            saveData().then(async () => {
                // 渲染世界书卡片
                renderWorldBookCards();
                // 清空输入框
                document.getElementById('worldBookTitle').value = '';
                document.getElementById('worldBookContent').value = '';
                // 调试：打印保存后的世界书数据
                console.log('保存后的世界书数据:', relationshipData.worldBooks);
                // 调试：打印localforage中的数据
                const savedData = await localforage.getItem('relationshipData');
                let parsedData = savedData;
                if (typeof savedData === 'string') {
                    parsedData = JSON.parse(savedData);
                }
                console.log('localforage中的世界书数据:', parsedData.worldBooks);
                alert('保存成功');
            });
        }

        function renderWorldBookCards() {
            const cardsContainer = document.getElementById('worldBookCards');
            cardsContainer.innerHTML = '';

            relationshipData.worldBooks.forEach(book => {
                const card = document.createElement('div');
                card.className = 'world-book-card';
                card.innerHTML = `
                    <div class="world-book-card-title">${book.title}</div>
                    <div class="world-book-card-content">${book.content}</div>
                    <div class="world-book-card-actions">
                        <div class="world-book-card-edit" onclick="editWorldBook(${book.id})">编辑</div>
                        <div class="world-book-card-delete" onclick="deleteWorldBook(${book.id})">删除</div>
                    </div>
                `;
                cardsContainer.appendChild(card);
            });
        }

        function editWorldBook(id) {
            const book = relationshipData.worldBooks.find(b => b.id === id);
            if (book) {
                document.getElementById('worldBookTitle').value = book.title;
                document.getElementById('worldBookContent').value = book.content;
                // 删除原世界书，后续保存时会创建新的
                relationshipData.worldBooks = relationshipData.worldBooks.filter(b => b.id !== id);
                saveData();
            }
        }

        function deleteWorldBook(id) {
            if (confirm('确定要删除这本书吗？')) {
                relationshipData.worldBooks = relationshipData.worldBooks.filter(b => b.id !== id);
                saveData().then(() => {
                    renderWorldBookCards();
                });
            }
        }

        // 打开外观设置页面
        function openTheme() {
            document.getElementById('themePage').style.display = 'block';
            loadThemeSettings();
        }

        // 关闭外观设置页面
        function closeThemePage() {
            document.getElementById('themePage').style.display = 'none';
        }

        // 预览主屏幕背景
        async function previewMainBg(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = async function(e) {
                    try {
                        // 【防闪退】压缩背景图片
                        const compressedData = await compressImage(e.target.result, 1024, 1024, 0.85);
                        console.log('🖼️ 背景图片压缩完成');
                        
                        const previewImg = document.getElementById('mainBgPreviewImg');
                        if (previewImg) {
                            previewImg.src = compressedData;
                        }
                        relationshipData.theme.mainBg = compressedData;
                    } catch (err) {
                        console.error('❌ 背景图片压缩失败:', err);
                        // 压缩失败时使用原图
                        const previewImg = document.getElementById('mainBgPreviewImg');
                        if (previewImg) {
                            previewImg.src = e.target.result;
                        }
                        relationshipData.theme.mainBg = e.target.result;
                    }
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        // 重置主屏幕背景
        function resetMainBg() {
            const previewImg = document.getElementById('mainBgPreviewImg');
            const bgInput = document.getElementById('mainBgInput');
            if (previewImg) previewImg.src = '';
            if (bgInput) bgInput.value = '';
            relationshipData.theme.mainBg = '';
        }

        // 预览应用图标
        async function previewAppIcon(input) {
            const app = input.dataset.app;
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = async function(e) {
                    try {
                        // 【防闪退】压缩图标图片，类似微信头像压缩
                        const compressedData = await compressImage(e.target.result, 256, 256, 0.85);
                        console.log(`📱 图标 ${app} 压缩完成`);
                        
                        relationshipData.theme.appIcons[app] = compressedData;
                        // 即时更新第二屏幕图标
                        updateScreen2AppIcon(app, compressedData);
                        // 即时更新主屏幕图标
                        updateMainScreenAppIcon(app, compressedData);
                    } catch (err) {
                        console.error(`❌ 图标 ${app} 压缩失败:`, err);
                        // 压缩失败时使用原图
                        relationshipData.theme.appIcons[app] = e.target.result;
                        updateScreen2AppIcon(app, e.target.result);
                        updateMainScreenAppIcon(app, e.target.result);
                    }
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        // 即时更新主屏幕应用图标
        function updateMainScreenAppIcon(app, iconData) {
            try {
                // 更新主屏幕应用图标
                const appIconElements = document.querySelectorAll(`.app-icon[data-app="${app}"]`);
                appIconElements.forEach(icon => {
                    const img = icon.querySelector('.app-icon-img');
                    if (img && iconData) {
                        img.src = iconData;
                        icon.classList.add('has-icon');
                    }
                });

                // 更新底部导航栏图标
                const bottomBarItems = document.querySelectorAll(`.bottom-bar-item[data-app="${app}"]`);
                bottomBarItems.forEach(item => {
                    const customIcon = item.querySelector('.custom-icon');
                    if (customIcon && iconData) {
                        customIcon.src = iconData;
                        item.classList.add('has-custom-icon');
                    }
                });

                console.log(`主屏幕图标 ${app} 已更新`);
            } catch (error) {
                console.error(`更新主屏幕图标 ${app} 失败:`, error);
            }
        }

        // 即时更新第二屏幕单个图标
        function updateScreen2AppIcon(app, iconData) {
            try {
                // 更新第二屏幕功能图标（第一行）
                const featureItems = document.querySelectorAll(`.screen2-feature-item[data-app="${app}"]`);
                featureItems.forEach(item => {
                    const img = item.querySelector('.screen2-app-icon-img');
                    const emoji = item.querySelector('.screen2-app-icon-emoji');
                    if (img && iconData) {
                        img.src = iconData;
                        img.style.display = 'block';
                    }
                    if (emoji) {
                        emoji.style.display = 'none';
                    }
                });

                // 更新第二屏幕第二行图标（旧版）
                const secondItems = document.querySelectorAll(`.screen2-second-item[data-app="${app}"]`);
                secondItems.forEach(item => {
                    const img = item.querySelector('.screen2-app-icon-img');
                    const emoji = item.querySelector('.screen2-app-icon-emoji');
                    if (img && iconData) {
                        img.src = iconData;
                        img.style.display = 'block';
                    }
                    if (emoji) {
                        emoji.style.display = 'none';
                    }
                });

                // 更新第二屏幕网格图标（新版 - 第一行和第二行）
                const gridItems = document.querySelectorAll(`.screen2-grid-item[data-app="${app}"]`);
                gridItems.forEach(item => {
                    const img = item.querySelector('.screen2-app-icon-img');
                    const emoji = item.querySelector('.screen2-app-icon-emoji');
                    if (img && iconData) {
                        img.src = iconData;
                        img.style.display = 'block';
                    }
                    if (emoji) {
                        emoji.style.display = 'none';
                    }
                });

                // 更新决策币正面
                if (app === 'coinFront') {
                    const coinFront = document.querySelector('.coin-front');
                    if (coinFront && iconData) {
                        coinFront.innerHTML = `<img src="${iconData}" style="width: 100%; height: 100%; object-fit: cover; border-radius: 50%;">`;
                    }
                }

                // 更新决策币反面
                if (app === 'coinBack') {
                    const coinBack = document.querySelector('.coin-back');
                    if (coinBack && iconData) {
                        coinBack.innerHTML = `<img src="${iconData}" style="width: 100%; height: 100%; object-fit: cover; border-radius: 50%; transform: rotateY(180deg);">`;
                    }
                }

                console.log(`第二屏幕图标 ${app} 已更新`);
            } catch (error) {
                console.error(`更新第二屏幕图标 ${app} 失败:`, error);
            }
        }

        // 保存外观设置
        async function saveThemeSettings() {
            try {
                console.log('保存外观设置');
                alert('开始保存...');
                
                // 【简化版】逐个保存，避免复杂逻辑导致闪退
                const iconsToSave = [];
                
                // 收集需要保存的图标
                if (relationshipData.theme.mainBg) {
                    iconsToSave.push({ id: 'mainBg', data: relationshipData.theme.mainBg });
                }
                
                for (const [app, icon] of Object.entries(relationshipData.theme.appIcons)) {
                    if (icon) {
                        iconsToSave.push({ id: `appIcon_${app}`, data: icon });
                    }
                }
                
                console.log(`需要保存 ${iconsToSave.length} 个图片`);
                
                // 逐个保存
                for (let i = 0; i < iconsToSave.length; i++) {
                    const { id, data } = iconsToSave[i];
                    try {
                        console.log(`保存 ${id}...`);
                        await saveImageToDB(id, data);
                        console.log(`${id} 保存成功`);
                    } catch (err) {
                        console.error(`${id} 保存失败:`, err);
                    }
                    // 每个保存后等待一下
                    await new Promise(resolve => setTimeout(resolve, 100));
                }
                
                // 【性能优化】使用轻量级保存，避免遍历整个聊天列表
                console.log('保存配置...');
                await saveCardDataOnly();
                
                alert('保存成功！');
                
                // 延迟应用设置
                setTimeout(() => {
                    applyThemeSettings();
                }, 200);
                
                closeThemePage();
            } catch (error) {
                console.error('保存外观设置失败:', error);
                alert('保存失败: ' + error.message);
            }
        }

        // ========== 全局 CSS 美化功能 ==========
        
        // 应用全局 CSS（实时预览，不保存）
        function applyGlobalCss() {
            const cssCode = document.getElementById('globalCssInput').value.trim();
            
            // 移除旧的自定义样式标签
            let oldStyle = document.getElementById('global-custom-css');
            if (oldStyle) {
                oldStyle.remove();
            }
            
            // 如果输入了 CSS 代码，创建新的样式标签
            if (cssCode) {
                const styleTag = document.createElement('style');
                styleTag.id = 'global-custom-css';
                // 添加更高的优先级，确保覆盖其他样式
                const enhancedCss = cssCode.replace(/!important/g, '') // 先移除已有的 !important
                    .replace(/;/g, ' !important;') // 给所有属性添加 !important
                    .replace(/!important;\s*}/g, ';}'); // 修复末尾的 !important
                styleTag.textContent = enhancedCss;
                document.head.appendChild(styleTag);
                
                // 显示成功提示
                showToast('✨ CSS 美化已应用！');
            } else {
                showToast('请输入 CSS 代码后再应用');
            }
        }
        
        // 保存全局 CSS 到数据库（显示预设名称输入框）
        function saveGlobalCss() {
            const cssCode = document.getElementById('globalCssInput').value.trim();
            if (!cssCode) {
                showToast('请先输入 CSS 代码');
                return;
            }
            
            // 显示预设名称输入框
            const container = document.getElementById('presetNameContainer');
            container.style.display = 'block';
            document.getElementById('presetNameInput').focus();
        }
        
        // 确认保存预设
        async function confirmSavePreset() {
            try {
                const cssCode = document.getElementById('globalCssInput').value.trim();
                const presetName = document.getElementById('presetNameInput').value.trim();
                
                if (!presetName) {
                    showToast('请输入预设名称');
                    return;
                }
                
                // 获取现有预设
                let presets = await loadCssPresetsUnified([]);
                
                // 检查是否已存在同名预设
                const existingIndex = presets.findIndex(p => p.name === presetName);
                if (existingIndex >= 0) {
                    if (!confirm(`预设 "${presetName}" 已存在，是否覆盖？`)) {
                        return;
                    }
                    presets[existingIndex] = { name: presetName, css: cssCode, time: Date.now() };
                } else {
                    presets.push({ name: presetName, css: cssCode, time: Date.now() });
                }
                
                // 保存预设列表
                await saveCssPresetsUnified(presets);
                
                // 同时保存为当前使用的 CSS
                if (!relationshipData.theme) {
                    relationshipData.theme = {};
                }
                relationshipData.theme.globalCss = cssCode;
                await saveApiSettingUnified('global_custom_css', cssCode);
                
                // 应用 CSS
                applyGlobalCss();
                
                // 刷新预设列表显示
                renderCssPresets();
                
                // 隐藏输入框
                document.getElementById('presetNameContainer').style.display = 'none';
                document.getElementById('presetNameInput').value = '';
                
                showToast(`💾 预设 "${presetName}" 已保存！`);
            } catch (error) {
                console.error('保存预设失败:', error);
                showToast('保存失败，请重试');
            }
        }
        
        // 取消保存预设
        function cancelSavePreset() {
            document.getElementById('presetNameContainer').style.display = 'none';
            document.getElementById('presetNameInput').value = '';
        }
        
        // 渲染 CSS 预设列表
        async function renderCssPresets() {
            try {
                const presets = await loadCssPresetsUnified([]);
                const container = document.getElementById('presetsContainer');
                
                if (presets.length === 0) {
                    container.innerHTML = '<span style="color: #aaa; font-size: 12px; padding: 8px;">还没有保存的预设哦~</span>';
                    return;
                }
                
                container.innerHTML = presets.map(preset => `
                    <div class="css-preset-tag" onclick="loadCssPreset('${preset.name}')" style="background: linear-gradient(135deg, #ffe4e1 0%, #fff0f5 100%); border: 1px solid #ffd1dc; border-radius: 20px; padding: 8px 15px; cursor: pointer; font-size: 13px; color: #ff85a2; transition: all 0.3s; display: flex; align-items: center; gap: 8px;" onmouseover="this.style.transform='scale(1.05)'; this.style.boxShadow='0 3px 10px rgba(255,182,193,0.3)'" onmouseout="this.style.transform='scale(1)'; this.style.boxShadow='none'">
                        <span>🎨</span>
                        <span>${preset.name}</span>
                        <span onclick="event.stopPropagation(); deleteCssPreset('${preset.name}')" style="color: #ff9999; cursor: pointer; font-size: 12px; margin-left: 5px;">✕</span>
                    </div>
                `).join('');
            } catch (error) {
                console.error('渲染预设列表失败:', error);
            }
        }
        
        // 加载 CSS 预设
        async function loadCssPreset(name) {
            try {
                const presets = await loadCssPresetsUnified([]);
                const preset = presets.find(p => p.name === name);
                
                if (preset) {
                    document.getElementById('globalCssInput').value = preset.css;
                    applyGlobalCss();
                    showToast(`✨ 已应用预设 "${name}"`);
                }
            } catch (error) {
                console.error('加载预设失败:', error);
                showToast('加载失败，请重试');
            }
        }
        
        // 删除 CSS 预设
        async function deleteCssPreset(name) {
            if (!confirm(`确定要删除预设 "${name}" 吗？`)) {
                return;
            }
            
            try {
                let presets = await loadCssPresetsUnified([]);
                presets = presets.filter(p => p.name !== name);
                await saveCssPresetsUnified(presets);
                renderCssPresets();
                showToast(`🗑️ 预设 "${name}" 已删除`);
            } catch (error) {
                console.error('删除预设失败:', error);
                showToast('删除失败，请重试');
            }
        }
        
        // 重置全局 CSS
        async function resetGlobalCss() {
            if (confirm('确定要重置为默认样式吗？这将清除所有自定义 CSS 美化。')) {
                // 清空输入框
                document.getElementById('globalCssInput').value = '';
                
                // 移除样式标签
                let oldStyle = document.getElementById('global-custom-css');
                if (oldStyle) {
                    oldStyle.remove();
                }
                
                // 清除保存的数据
                if (relationshipData.theme) {
                    relationshipData.theme.globalCss = '';
                }
                await localforage.removeItem('global_custom_css');
                
                showToast('🔄 已重置为默认样式');
            }
        }
        
        // 加载全局 CSS（启动时调用）
        async function loadGlobalCss() {
            try {
                // 从数据库加载
                const savedCss = await loadApiSettingUnified('global_custom_css');
                
                if (savedCss) {
                    // 填充输入框
                    const input = document.getElementById('globalCssInput');
                    if (input) {
                        input.value = savedCss;
                    }
                    
                    // 应用到页面
                    if (savedCss.trim()) {
                        const styleTag = document.createElement('style');
                        styleTag.id = 'global-custom-css';
                        styleTag.textContent = savedCss;
                        document.head.appendChild(styleTag);
                    }
                    
                    console.log('全局 CSS 已加载');
                }
                
                // 渲染预设列表
                renderCssPresets();
            } catch (error) {
                console.error('加载全局 CSS 失败:', error);
            }
        }
        
        // 简单的提示函数
        function showToast(message) {
            // 创建提示元素
            const toast = document.createElement('div');
            toast.style.cssText = `
                position: fixed;
                top: 50%;
                left: 50%;
                transform: translate(-50%, -50%);
                background: rgba(0, 0, 0, 0.8);
                color: white;
                padding: 15px 25px;
                border-radius: 10px;
                font-size: 14px;
                z-index: 10000;
                animation: fadeInOut 2s ease;
                pointer-events: none;
            `;
            toast.textContent = message;
            document.body.appendChild(toast);
            
            // 2秒后移除
            setTimeout(() => {
                toast.remove();
            }, 2000);
        }

        // 【修复】手动修复头像数据函数
        async function fixAvatarData() {
            console.log('【修复】开始修复头像数据...');

            try {
                // 从 IndexedDB 加载头像
                const [loadedAvatar1, loadedAvatar2] = await Promise.all([
                    loadImageFromDB('avatar1'),
                    loadImageFromDB('avatar2')
                ]);

                console.log('【修复】从 IndexedDB 加载的头像:', {
                    avatar1: loadedAvatar1 ? '有数据 (长度: ' + loadedAvatar1.length + ')' : '无数据',
                    avatar2: loadedAvatar2 ? '有数据 (长度: ' + loadedAvatar2.length + ')' : '无数据'
                });

                // 检查当前数据
                console.log('【修复】当前 relationshipData 中的头像:', {
                    avatar1: relationshipData.avatar1 ? '有数据 (长度: ' + relationshipData.avatar1.length + ')' : '无数据',
                    avatar2: relationshipData.avatar2 ? '有数据 (长度: ' + relationshipData.avatar2.length + ')' : '无数据'
                });

                // 检查是否相同
                if (relationshipData.avatar1 === relationshipData.avatar2 && relationshipData.avatar1) {
                    console.warn('【修复】检测到 avatar1 和 avatar2 相同！');

                    // 尝试从 IndexedDB 恢复
                    if (loadedAvatar1 && loadedAvatar2 && loadedAvatar1 !== loadedAvatar2) {
                        console.log('【修复】IndexedDB 中有不同的头像，正在恢复...');
                        relationshipData.avatar1 = loadedAvatar1;
                        relationshipData.avatar2 = loadedAvatar2;
                        await saveData();
                        showToast('头像数据已修复！');

                        // 更新界面
                        const avatarElements = document.querySelectorAll('.avatar img');
                        if (avatarElements[0]) avatarElements[0].src = loadedAvatar1;
                        if (avatarElements[1]) avatarElements[1].src = loadedAvatar2;

                        return true;
                    } else {
                        console.warn('【修复】IndexedDB 中的头像也相同或不存在，无法自动修复');
                        showToast('无法自动修复，请手动重新设置头像');
                        return false;
                    }
                } else {
                    console.log('【修复】头像数据正常，无需修复');
                    showToast('头像数据正常');
                    return true;
                }
            } catch (error) {
                console.error('【修复】修复头像数据失败:', error);
                showToast('修复失败: ' + error.message);
                return false;
            }
        }

        // 添加淡入淡出动画
        const toastAnimation = document.createElement('style');
        toastAnimation.textContent = `
            @keyframes fadeInOut {
                0% { opacity: 0; transform: translate(-50%, -50%) scale(0.9); }
                20% { opacity: 1; transform: translate(-50%, -50%) scale(1); }
                80% { opacity: 1; transform: translate(-50%, -50%) scale(1); }
                100% { opacity: 0; transform: translate(-50%, -50%) scale(0.9); }
            }
        `;
        document.head.appendChild(toastAnimation);

        // 加载外观设置
        async function loadThemeSettings() {
            try {
                console.log('加载外观设置');

                // 确保theme结构存在
                if (!relationshipData.theme) {
                    relationshipData.theme = {};
                }
                if (!relationshipData.theme.appIcons) {
                    relationshipData.theme.appIcons = {};
                }

                // 确保所有应用图标字段存在
                const allAppIcons = ['wechat', 'worldbook', 'note', 'study', 'couple', 'diary', 
                                     'theme', 'settings', 'accounting', 'health',
                                     'admin', 'body', 'postoffice', 'games', 
                                     'weibo', 'ball', 'library', 'luckgate',
                                     'railway', 'beauty', 'declutter', 'pet',
                                     'coinFront', 'coinBack'];
                for (const app of allAppIcons) {
                    if (relationshipData.theme.appIcons[app] === undefined) {
                        relationshipData.theme.appIcons[app] = '';
                    }
                }

                // 加载主屏幕背景
                const mainBg = await loadImageFromDB('mainBg');
                if (mainBg) {
                    relationshipData.theme.mainBg = mainBg;
                    const previewImg = document.getElementById('mainBgPreviewImg');
                    if (previewImg) previewImg.src = mainBg;
                }

                // 【防闪退】分批加载应用图标
                const appIcons = ['wechat', 'worldbook', 'note', 'study', 'couple', 'diary', 'theme', 'settings', 'accounting', 'health'];
                for (let i = 0; i < appIcons.length; i++) {
                    const app = appIcons[i];
                    try {
                        const icon = await loadImageFromDB(`appIcon_${app}`);
                        if (icon) {
                            relationshipData.theme.appIcons[app] = icon;
                        }
                    } catch (err) {
                        console.warn(`加载图标 ${app} 失败:`, err);
                    }
                    // 每加载2个图标让出主线程
                    if (i % 2 === 1) {
                        await new Promise(resolve => setTimeout(resolve, 10));
                    }
                }

                // 【防闪退】分批加载第二屏幕应用图标
                const screen2AppIcons = ['admin', 'body', 'postoffice', 'games', 'weibo', 'ball', 'library', 'luckgate',
                                         'railway', 'beauty', 'declutter', 'pet', 'coinFront', 'coinBack'];
                for (let i = 0; i < screen2AppIcons.length; i++) {
                    const app = screen2AppIcons[i];
                    try {
                        const icon = await loadImageFromDB(`appIcon_${app}`);
                        if (icon) {
                            relationshipData.theme.appIcons[app] = icon;
                        }
                    } catch (err) {
                        console.warn(`加载第二屏幕图标 ${app} 失败:`, err);
                    }
                    // 每加载2个图标让出主线程
                    if (i % 2 === 1) {
                        await new Promise(resolve => setTimeout(resolve, 10));
                    }
                }
                
                console.log('外观设置加载完成，图标数量:', Object.keys(relationshipData.theme.appIcons).filter(k => relationshipData.theme.appIcons[k]).length);

                // 【修复】加载全局CSS到输入框
                await loadGlobalCss();
            } catch (error) {
                console.error('加载外观设置失败:', error);
            }
        }

        // 应用外观设置
        function applyThemeSettings() {
            try {
                console.log('应用外观设置...');
                
                // 【防闪退】使用 requestAnimationFrame 分批应用设置
                requestAnimationFrame(() => {
                    // 应用主屏幕背景
                    try {
                        if (relationshipData.theme.mainBg) {
                            document.body.style.background = `url('${relationshipData.theme.mainBg}') no-repeat center center fixed`;
                            document.body.style.backgroundSize = 'cover';
                        } else {
                            document.body.style.background = 'linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%)';
                        }
                    } catch (err) {
                        console.error('应用背景失败:', err);
                    }
                    
                    // 延迟应用图标，避免阻塞
                    setTimeout(() => {
                        try {
                            // 应用应用图标（主屏幕上的）
                            const appIcons = document.querySelectorAll('.app-icon');
                            appIcons.forEach(icon => {
                                const app = icon.dataset.app;
                                if (app && relationshipData.theme.appIcons[app]) {
                                    const img = icon.querySelector('.app-icon-img');
                                    if (img) {
                                        img.src = relationshipData.theme.appIcons[app];
                                        icon.classList.add('has-icon');
                                    }
                                } else {
                                    const img = icon.querySelector('.app-icon-img');
                                    if (img) {
                                        img.src = '';
                                        icon.classList.remove('has-icon');
                                    }
                                }
                            });
                        } catch (err) {
                            console.error('应用主屏幕图标失败:', err);
                        }
                        
                        // 再延迟应用底部导航栏和第二屏幕图标
                        setTimeout(() => {
                            try {
                                // 应用底部导航栏图标
                                const bottomBarItems = document.querySelectorAll('.bottom-bar-item');
                                bottomBarItems.forEach(item => {
                                    const app = item.dataset.app;
                                    if (app && relationshipData.theme.appIcons[app]) {
                                        const customIcon = item.querySelector('.custom-icon');
                                        if (customIcon) {
                                            customIcon.src = relationshipData.theme.appIcons[app];
                                            item.classList.add('has-custom-icon');
                                        }
                                    } else {
                                        item.classList.remove('has-custom-icon');
                                        const customIcon = item.querySelector('.custom-icon');
                                        if (customIcon) {
                                            customIcon.src = '';
                                        }
                                    }
                                });
                                
                                // 应用第二屏幕图标
                                applyScreen2AppIcons();
                                
                                console.log('外观设置应用完成');
                            } catch (err) {
                                console.error('应用底部导航栏和第二屏幕图标失败:', err);
                            }
                        }, 50);
                    }, 50);
                });
            } catch (error) {
                console.error('应用外观设置失败:', error);
            }
        }

        // 应用第二屏幕应用图标
        function applyScreen2AppIcons() {
            try {
                if (!relationshipData.theme || !relationshipData.theme.appIcons) return;

                // 【防闪退】分批应用第二屏幕图标
                const screen2FeatureItems = document.querySelectorAll('.screen2-feature-item[data-app]');
                const screen2SecondItems = document.querySelectorAll('.screen2-second-item[data-app]');
                const screen2GridItems = document.querySelectorAll('.screen2-grid-item[data-app]');
                
                // 先应用所有图标
                let index = 0;
                const allItems = [...screen2FeatureItems, ...screen2SecondItems, ...screen2GridItems];
                
                function applyNextBatch() {
                    const batch = allItems.slice(index, index + 2);
                    if (batch.length === 0) {
                        console.log('第二屏幕图标已应用');
                        return;
                    }
                    
                    batch.forEach(item => {
                        try {
                            const app = item.dataset.app;
                            const img = item.querySelector('.screen2-app-icon-img');
                            const emoji = item.querySelector('.screen2-app-icon-emoji');
                            
                            if (app && relationshipData.theme.appIcons[app]) {
                                if (img) {
                                    img.src = relationshipData.theme.appIcons[app];
                                    img.style.display = 'block';
                                }
                                if (emoji) emoji.style.display = 'none';
                            } else {
                                if (img) {
                                    img.src = '';
                                    img.style.display = 'none';
                                }
                                if (emoji) emoji.style.display = 'block';
                            }
                        } catch (err) {
                            console.error('应用单个图标失败:', err);
                        }
                    });
                    
                    index += 2;
                    // 延迟应用下一批
                    setTimeout(applyNextBatch, 10);
                }
                
                // 应用决策币正面
                if (relationshipData.theme.appIcons['coinFront']) {
                    const coinFront = document.querySelector('.coin-front');
                    const coinIcon = relationshipData.theme.appIcons['coinFront'];
                    if (coinFront) {
                        coinFront.innerHTML = `<img src="${coinIcon}" style="width: 100%; height: 100%; object-fit: cover; border-radius: 50%;">`;
                    }
                }

                // 应用决策币反面
                if (relationshipData.theme.appIcons['coinBack']) {
                    const coinBack = document.querySelector('.coin-back');
                    const coinIcon = relationshipData.theme.appIcons['coinBack'];
                    if (coinBack) {
                        coinBack.innerHTML = `<img src="${coinIcon}" style="width: 100%; height: 100%; object-fit: cover; border-radius: 50%; transform: rotateY(180deg);">`;
                    }
                }

                applyNextBatch();
            } catch (error) {
                console.error('应用第二屏幕图标失败:', error);
            }
        }

        // 【防闪退】打开设置页面
        async function openSettings() {
            try {
                // 【内存优化】打开设置前清理消息缓存，防止OOM
                cleanupMessageCache();
                
                // 【内存优化】如果当前在聊天界面，先清理聊天内容
                const chatInterface = document.getElementById('chatInterface');
                if (chatInterface && chatInterface.style.display !== 'none') {
                    const chatContent = document.getElementById('chatContent');
                    if (chatContent) {
                        chatContent.innerHTML = '';
                    }
                    currentChatMessagesCache = [];
                    currentChatMessageIndex.clear(); // 【性能优化】清空索引
                    console.log('【内存优化】打开设置前已清理聊天内存');
                }
                
                // 【修复】加载当前聊天的自动总结记忆频率设置
                if (currentChatId) {
                    const chatItem = relationshipData.wechatChatList.find(item => item.id == currentChatId);
                    if (chatItem && chatItem.memorySummaryFrequency) {
                        const frequencyInput = document.getElementById('memorySummaryFrequency');
                        if (frequencyInput) {
                            frequencyInput.value = chatItem.memorySummaryFrequency;
                            console.log('【设置】加载自动总结频率:', chatItem.memorySummaryFrequency);
                        }
                    }
                }
                
                // 【修复】重新加载保存的模型列表到选择器中
                await loadSavedModelsToSelect();
                
                // 【修复】重新加载所有设置，确保显示的是最新保存的值
                await loadSettings();
                
                const settingsPage = document.getElementById('settingsPage');
                if (settingsPage) {
                    settingsPage.style.display = 'flex';
                }
            } catch (error) {
                console.error('【防闪退】打开设置失败:', error);
            }
        }
        
        // 【新增】加载保存的模型列表到选择器
        async function loadSavedModelsToSelect() {
            try {
                // 加载主API模型列表
                const savedModels = await loadApiSettingUnified('apiModels');
                if (savedModels && Array.isArray(savedModels) && savedModels.length > 0) {
                    const select = document.getElementById('apiModel');
                    if (select) {
                        // 保存当前选中的值
                        const currentValue = select.value;
                        
                        // 清空并重新填充
                        select.innerHTML = '';
                        const models = savedModels.slice(0, 100);
                        models.forEach(model => {
                            const option = document.createElement('option');
                            option.value = model.id || 'unknown';
                            option.textContent = model.id || 'unknown';
                            select.appendChild(option);
                        });
                        
                        // 【修复】恢复之前选中的值（如果该值在新的模型列表中存在）
                        if (currentValue) {
                            const modelExists = models.some(m => m.id === currentValue);
                            if (modelExists) {
                                select.value = currentValue;
                            } else if (models.length > 0) {
                                // 如果之前的模型不在列表中，默认选中第一个
                                select.value = models[0].id;
                            }
                        }
                    }
                }
                
                // 加载副API模型列表
                let secondaryModelListLoaded = false;
                const savedSecondaryModels = await loadApiSettingUnified('secondaryApiModels');
                if (savedSecondaryModels && Array.isArray(savedSecondaryModels) && savedSecondaryModels.length > 0) {
                    const select = document.getElementById('secondaryApiModel');
                    if (select) {
                        select.innerHTML = '';
                        const models = savedSecondaryModels.slice(0, 100);
                        models.forEach(model => {
                            const option = document.createElement('option');
                            option.value = model.id || 'unknown';
                            option.textContent = model.id || 'unknown';
                            select.appendChild(option);
                        });
                        secondaryModelListLoaded = true;
                        console.log('✅ 已加载副API模型列表，共', models.length, '个模型');
                    }
                }

                // 【修复】无论是否加载了副API模型列表，都重新设置选中的模型
                const secondaryApiModelSelect = document.getElementById('secondaryApiModel');
                if (secondaryApiModelSelect && savedSettings && savedSettings.api && savedSettings.api.secondary && savedSettings.api.secondary.model) {
                    const savedModel = savedSettings.api.secondary.model;
                    // 检查选项是否存在，如果不存在则添加它
                    let optionExists = false;
                    for (let i = 0; i < secondaryApiModelSelect.options.length; i++) {
                        if (secondaryApiModelSelect.options[i].value === savedModel) {
                            optionExists = true;
                            break;
                        }
                    }
                    // 如果选项不存在，添加它
                    if (!optionExists) {
                        const option = document.createElement('option');
                        option.value = savedModel;
                        option.textContent = savedModel;
                        secondaryApiModelSelect.appendChild(option);
                        console.log('✅ 已添加保存的副API模型到列表:', savedModel);
                    }
                    // 设置选中的值
                    secondaryApiModelSelect.value = savedModel;
                    console.log('✅ 已恢复选中的副API模型:', savedModel);
                }
            } catch (error) {
                console.error('【防闪退】加载模型列表到选择器失败:', error);
            }
        }
        
        // 【修复】将函数暴露到全局作用域
        window.loadSavedModelsToSelect = loadSavedModelsToSelect;

        // 【防闪退】关闭设置页面
        function closeSettings() {
            try {
                const settingsPage = document.getElementById('settingsPage');
                if (settingsPage) {
                    settingsPage.style.display = 'none';
                }
            } catch (error) {
                console.error('【防闪退】关闭设置失败:', error);
            }
        }

        // 【防闪退】保存设置
        async function saveSettings() {
            // 【防闪退】添加try-catch包裹整个函数
            try {
                // 【防闪退】检查localforage是否可用
                if (typeof localforage === 'undefined') {
                    alert('错误：存储服务未初始化');
                    return;
                }

                // 【防闪退】安全地读取旧设置
                let savedSettings = {};
                try {
                    savedSettings = await loadAppSettings({});
                } catch (e) {
                    console.warn('【防闪退】读取旧设置失败:', e);
                    savedSettings = {};
                }

                // 【防闪退】安全地获取各个输入框的值
                const safeGetValue = (id, defaultValue = '') => {
                    const element = document.getElementById(id);
                    if (element) {
                        const value = element.value;
                        console.log(`【设置保存】${id} = ${value ? '有值' : '空值'}`);
                        return value !== undefined && value !== null ? value : defaultValue;
                    }
                    console.warn(`【设置保存】元素 ${id} 未找到，使用默认值`);
                    return defaultValue;
                };

                // 【防闪退】获取工具调用轮数（默认2）
                const maxToolRoundsInput = document.getElementById('maxToolRounds');
                const maxToolRounds = maxToolRoundsInput ? parseInt(maxToolRoundsInput.value) || 2 : 2;

                // 【防闪退】获取温度设置（默认0.7）
                const temperatureInput = document.getElementById('apiTemperature');
                const temperature = temperatureInput ? (parseInt(temperatureInput.value) || 7) / 10 : 0.7;

                // 【防闪退】获取副API设置
                const enableSecondaryApi = document.getElementById('enableSecondaryApi')?.checked || false;

                // 【防闪退】保存所有设置到localforage
                const settings = {
                    api: {
                        baseUrl: safeGetValue('apiBaseUrl', 'https://api.openai.com/v1'),
                        apiKey: safeGetValue('apiKey'),
                        model: safeGetValue('apiModel', 'gpt-3.5-turbo'),
                        maxToolRounds: Math.max(1, Math.min(5, maxToolRounds)),
                        temperature: Math.max(0, Math.min(2, temperature)),
                        mapApiKey: safeGetValue('mapApiKey'),
                        amapSecurityConfig: safeGetValue('amapSecurityConfig'),
                        // 【新增】副API设置
                        secondary: {
                            enabled: enableSecondaryApi,
                            baseUrl: safeGetValue('secondaryApiBaseUrl', 'https://api.openai.com/v1'),
                            apiKey: safeGetValue('secondaryApiKey'),
                            model: safeGetValue('secondaryApiModel', 'gpt-4o-mini')
                        }
                    },
                    blackRoomCode: safeGetValue('blackRoomCode', 'love_husband'),
                    minimax: {
                        groupId: safeGetValue('minimaxGroupId'),
                        apiKey: safeGetValue('minimaxApiKey'),
                        model: safeGetValue('minimaxModel', 'speech-01'),
                        apiDomain: safeGetValue('minimaxApiDomain', 'https://api.minimax.chat')
                    },
                    compress: {
                        quality: safeGetValue('compressQuality', '80')
                    }
                };

                // 【防闪退】保存设置，使用统一的保存函数
                const savePromise = saveAppSettings(settings);
                const timeoutPromise = new Promise((_, reject) => {
                    setTimeout(() => reject(new Error('保存超时')), 10000); // 10秒超时
                });

                await Promise.race([savePromise, timeoutPromise]);

                // 【防闪退】如果修改了高德地图配置，在后台重新加载（不阻塞）
                const newAmapKey = settings.api.mapApiKey;
                const newSecurityConfig = settings.api.amapSecurityConfig;
                const oldAmapKey = savedSettings?.api?.mapApiKey;
                const oldSecurityConfig = savedSettings?.api?.amapSecurityConfig;

                if (newAmapKey !== oldAmapKey || newSecurityConfig !== oldSecurityConfig) {
                    // 【防闪退】在后台异步加载，不阻塞设置保存
                    setTimeout(() => {
                        try {
                            if (window.AMap) {
                                window.AMap = undefined;
                            }
                            if (typeof loadAmapScript === 'function') {
                                loadAmapScript().catch(e => {
                                    console.warn('【防闪退】高德地图加载失败:', e);
                                });
                            }
                        } catch (e) {
                            console.warn('【防闪退】重新加载高德地图失败:', e);
                        }
                    }, 100);
                }

                // 【防闪退】显示成功提示
                alert('设置已保存');

                // 【修复】保存当前聊天的自动总结记忆频率设置
                if (currentChatId) {
                    const chatItem = relationshipData.wechatChatList.find(item => item.id == currentChatId);
                    if (chatItem) {
                        const frequencyInput = document.getElementById('memorySummaryFrequency');
                        if (frequencyInput) {
                            chatItem.memorySummaryFrequency = parseInt(frequencyInput.value) || 20;
                            console.log('【设置】保存自动总结频率:', chatItem.memorySummaryFrequency);
                        }
                    }
                    // 保存到localStorage
                    await saveData();
                }

                // 【防闪退】关闭设置页面
                closeSettings();

            } catch (error) {
                console.error('【防闪退】保存设置失败:', error);
                alert('保存设置失败: ' + (error.message || '未知错误'));
            }
        }

        function saveSettingsWrapper() {
            saveSettings();
        }

        // 【修复】测试 MiniMax 语音合成
        async function testMiniMaxVoice() {
            console.log('=== 测试 MiniMax 语音合成 ===');
            
            const groupId = document.getElementById('minimaxGroupId')?.value;
            const apiKey = document.getElementById('minimaxApiKey')?.value;
            const model = document.getElementById('minimaxModel')?.value || 'speech-01';
            const apiDomain = document.getElementById('minimaxApiDomain')?.value || 'https://api.minimax.chat';
            
            if (!groupId || !apiKey) {
                alert('请先填写 Group ID 和 API Key');
                return;
            }
            
            console.log('测试配置:', { groupId, model, apiDomain });
            const isCordova = typeof window.cordova !== 'undefined';
            console.log('【调试】运行环境:', isCordova ? 'Cordova/APK' : '浏览器');
            
            const testText = '你好，这是 MiniMax 语音合成测试。';
            
            // 【优化】使用MiniMax T2A API，添加高质量音频参数
            const voiceId = document.getElementById('voiceSettingsVoiceId')?.value || 'female-tianmei';
            const isNewModel = model.includes('speech-2.6') || model.includes('speech-2.8');

            // 根据模型版本构建请求体
            let requestBody;
            if (isNewModel) {
                // 新版模型使用简化参数
                requestBody = {
                    model: model || 'speech-01',
                    text: testText,
                    voice_id: voiceId,
                    speed: 1.0
                };
            } else {
                // 旧版模型使用完整参数
                requestBody = {
                    model: model || 'speech-01',
                    text: testText,
                    voice_id: voiceId,
                    speed: 1.0,
                    sample_rate: 32000,
                    bitrate: 128000,
                    volume: 1.0
                };
            }
            console.log('【调试】请求体:', JSON.stringify(requestBody, null, 2));
            
            try {
                console.log('【调试】开始发送请求...');
                const url = `${apiDomain}/v1/text_to_speech?GroupId=${groupId}`;
                console.log('【调试】请求URL:', url);
                
                let response;
                let responseData;
                
                // 【修复】在APK中使用 XMLHttpRequest，浏览器中使用 fetch
                if (isCordova) {
                    // 尝试使用 Capacitor HTTP 插件
                    if (window.Capacitor && window.Capacitor.Plugins && window.Capacitor.Plugins.Http) {
                        try {
                            const capResponse = await window.Capacitor.Plugins.Http.request({
                                url: url,
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/json',
                                    'Authorization': `Bearer ${apiKey}`
                                },
                                data: requestBody
                            });
                            
                            // 处理响应
                            let audioBlob;
                            if (typeof capResponse.data === 'string') {
                                // JSON 响应
                                const jsonData = JSON.parse(capResponse.data);
                                let audioBase64 = null;
                                if (jsonData.audio_base64) {
                                    audioBase64 = jsonData.audio_base64;
                                } else if (jsonData.data && jsonData.data.audio) {
                                    audioBase64 = jsonData.data.audio;
                                } else if (jsonData.result && jsonData.result.audio) {
                                    audioBase64 = jsonData.result.audio;
                                }
                                
                                if (audioBase64) {
                                    const byteCharacters = atob(audioBase64);
                                    const byteNumbers = new Array(byteCharacters.length);
                                    for (let i = 0; i < byteCharacters.length; i++) {
                                        byteNumbers[i] = byteCharacters.charCodeAt(i);
                                    }
                                    const byteArray = new Uint8Array(byteNumbers);
                                    let mimeType = model.includes('speech-02') || model.includes('speech-2.6') || model.includes('speech-2.8') ? 'audio/mpeg' : 'audio/wav';
                                    audioBlob = new Blob([byteArray], { type: mimeType });
                                } else {
                                    throw new Error('响应中没有音频数据');
                                }
                            } else {
                                audioBlob = new Blob([capResponse.data], { type: 'audio/mpeg' });
                            }
                            
                            // 播放音频
                            const objectURL = URL.createObjectURL(audioBlob);
                            const audio = new Audio(objectURL);
                            audio.volume = 1.0;
                            audio.preload = 'auto';
                            audio.play().catch(e => {
                                console.error('播放失败:', e);
                            });
                            showToast('✅ 语音合成测试成功！正在播放...');
                            return;
                        } catch (capError) {
                            console.error('Capacitor HTTP 失败:', capError);
                        }
                    }
                    
                    // 使用 XMLHttpRequest
                    const result = await new Promise((resolve, reject) => {
                        const xhr = new XMLHttpRequest();
                        
                        try {
                            xhr.open('POST', url, true);
                        } catch (e) {
                            console.error('【调试】XHR open 失败:', e);
                            reject(new Error('无法创建请求: ' + e.message));
                            return;
                        }
                        
                        xhr.setRequestHeader('Content-Type', 'application/json');
                        xhr.setRequestHeader('Authorization', `Bearer ${apiKey}`);
                        xhr.responseType = 'arraybuffer';
                        xhr.timeout = 300000; // 【统一】300秒超时

                        xhr.onload = function() {
                            console.log('【调试】XHR 响应:', xhr.status, xhr.statusText);
                            
                            if (xhr.status >= 200 && xhr.status < 300) {
                                const contentType = xhr.getResponseHeader('Content-Type') || 'audio/mpeg';
                                
                                if (contentType.includes('application/json')) {
                                    const decoder = new TextDecoder('utf-8');
                                    const jsonStr = decoder.decode(xhr.response);
                                    resolve({ type: 'json', data: jsonStr });
                                } else {
                                    const blob = new Blob([xhr.response], { type: contentType });
                                    resolve({ type: 'audio', data: blob });
                                }
                            } else {
                                reject(new Error(`HTTP ${xhr.status}: ${xhr.statusText}`));
                            }
                        };
                        
                        xhr.onerror = () => {
                            console.error('【调试】XHR onerror 触发');
                            console.error('【调试】xhr.status:', xhr.status);
                            console.error('【调试】xhr.statusText:', xhr.statusText);
                            console.error('【调试】xhr.readyState:', xhr.readyState);
                            console.error('【调试】请求URL:', url);
                            
                            // 根据状态码给出具体错误信息
                            let errorMsg = 'XHR 请求失败';
                            if (xhr.status === 0) {
                                errorMsg = '无法连接到服务器。可能原因：\n1. 网络连接问题\n2. 服务器拒绝访问\n3. 域名解析失败\n4. 防火墙阻止';
                                
                                // 【修复】尝试使用 Android 原生 HTTP 请求
                                if (window.AndroidShell && window.AndroidShell.httpPost) {
                                    console.log('【调试】尝试使用原生 HTTP 请求');
                                    // 定义回调函数
                                    window.handleNativeHttpResponse = function(statusCode, responseText) {
                                        console.log('【调试】原生 HTTP 响应:', statusCode, responseText);
                                        if (statusCode >= 200 && statusCode < 300) {
                                            resolve({ type: 'json', data: responseText });
                                        } else {
                                            reject(new Error('原生 HTTP 请求失败: ' + statusCode + ' ' + responseText));
                                        }
                                    };
                                    // 调用原生方法
                                    window.AndroidShell.httpPost(url, JSON.stringify(requestBody), apiKey, 'handleNativeHttpResponse');
                                    return; // 不 reject，等待原生请求结果
                                }
                            } else if (xhr.status >= 400 && xhr.status < 500) {
                                errorMsg = `客户端错误 ${xhr.status}：请求参数有误或权限不足`;
                            } else if (xhr.status >= 500) {
                                errorMsg = `服务器错误 ${xhr.status}：Minimax 服务器内部错误`;
                            }
                            reject(new Error(errorMsg));
                        };
                        xhr.ontimeout = () => reject(new Error('请求超时（30秒）'));
                        xhr.onabort = () => reject(new Error('请求被中止'));
                        
                        // 添加状态变化监听
                        xhr.onreadystatechange = function() {
                            console.log('【调试】XHR readyState:', xhr.readyState);
                        };
                        
                        try {
                            xhr.send(JSON.stringify(requestBody));
                            console.log('【调试】XHR send 成功');
                        } catch (e) {
                            console.error('【调试】XHR send 失败:', e);
                            reject(new Error('发送请求失败: ' + e.message));
                        }
                    });
                    
                    // 处理 XHR 结果
                    let audioBlob;
                    
                    if (result.type === 'json') {
                        const jsonData = JSON.parse(result.data);
                        console.log('【调试】JSON响应:', jsonData);
                        
                        let audioBase64 = null;
                        if (jsonData.audio_base64) {
                            audioBase64 = jsonData.audio_base64;
                        } else if (jsonData.data && jsonData.data.audio) {
                            audioBase64 = jsonData.data.audio;
                        } else if (jsonData.result && jsonData.result.audio) {
                            audioBase64 = jsonData.result.audio;
                        }
                        
                        if (audioBase64) {
                            const byteCharacters = atob(audioBase64);
                            const byteNumbers = new Array(byteCharacters.length);
                            for (let i = 0; i < byteCharacters.length; i++) {
                                byteNumbers[i] = byteCharacters.charCodeAt(i);
                            }
                            const byteArray = new Uint8Array(byteNumbers);
                            let mimeType = model.includes('speech-02') || model.includes('speech-2.6') || model.includes('speech-2.8') ? 'audio/mpeg' : 'audio/wav';
                            audioBlob = new Blob([byteArray], { type: mimeType });
                        } else {
                            throw new Error('响应中没有音频数据');
                        }
                    } else {
                        audioBlob = result.data;
                    }

                    // 播放音频
                    const objectURL = URL.createObjectURL(audioBlob);
                    const audio = new Audio(objectURL);
                    audio.volume = 1.0;
                    audio.preload = 'auto';
                    audio.play().catch(e => {
                        console.error('播放失败:', e);
                    });
                    showToast('✅ 语音合成测试成功！正在播放...');
                    return;
                }

                // 浏览器环境使用 fetch
                console.log('【调试】浏览器环境使用 fetch API');
                console.log('【调试】注意：浏览器可能有跨域限制');
                
                const controller = new AbortController();
                const timeoutId = setTimeout(() => controller.abort(), 300000); // 【修改】300秒超时
                
                response = await fetch(url, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${apiKey}`
                    },
                    body: JSON.stringify(requestBody),
                    signal: controller.signal
                });
                
                clearTimeout(timeoutId);
                
                console.log('【调试】收到响应:', response.status, response.statusText || '');
                
                if (response.ok) {
                    const contentType = response.headers.get('content-type');
                    console.log('【测试】响应Content-Type:', contentType);
                    
                    // 【修复】MiniMax API返回的是JSON格式，需要解析
                    if (contentType && contentType.includes('application/json')) {
                        const jsonData = await response.json();
                        const jsonStr = JSON.stringify(jsonData, null, 2);
                        console.log('JSON响应:', jsonStr);

                        // 检查是否有音频数据字段 - 支持多种可能的字段名
                        let audioBase64 = null;
                        let audioHex = null;

                        // 尝试各种可能的音频数据字段
                        if (jsonData.audio_base64) {
                            audioBase64 = jsonData.audio_base64;
                            console.log('【测试】找到音频数据字段: audio_base64');
                        } else if (jsonData.data && jsonData.data.audio) {
                            audioBase64 = jsonData.data.audio;
                            console.log('【测试】找到音频数据字段: data.audio');
                        } else if (jsonData.data && jsonData.data.audio_base64) {
                            audioBase64 = jsonData.data.audio_base64;
                            console.log('【测试】找到音频数据字段: data.audio_base64');
                        } else if (jsonData.result && jsonData.result.audio) {
                            audioBase64 = jsonData.result.audio;
                            console.log('【测试】找到音频数据字段: result.audio');
                        } else if (jsonData.audio) {
                            audioBase64 = jsonData.audio;
                            console.log('【测试】找到音频数据字段: audio');
                        } else if (jsonData.audio_hex) {
                            audioHex = jsonData.audio_hex;
                            console.log('【测试】找到音频数据字段: audio_hex');
                        } else if (jsonData.data && jsonData.data.audio_hex) {
                            audioHex = jsonData.data.audio_hex;
                            console.log('【测试】找到音频数据字段: data.audio_hex');
                        }

                        // 如果找到hex格式，转换为base64
                        if (audioHex && !audioBase64) {
                            console.log('【测试】将hex格式转换为base64');
                            const hexToBase64 = (hex) => {
                                const bytes = new Uint8Array(hex.match(/.{1,2}/g).map(byte => parseInt(byte, 16)));
                                let binary = '';
                                bytes.forEach(byte => binary += String.fromCharCode(byte));
                                return btoa(binary);
                            };
                            audioBase64 = hexToBase64(audioHex);
                        }

                        if (audioBase64) {
                            // 将base64转换为blob
                            const byteCharacters = atob(audioBase64);
                            const byteNumbers = new Array(byteCharacters.length);
                            for (let i = 0; i < byteCharacters.length; i++) {
                                byteNumbers[i] = byteCharacters.charCodeAt(i);
                            }
                            const byteArray = new Uint8Array(byteNumbers);

                            // 根据模型推断格式
                            let mimeType = 'audio/wav';
                            if (model.includes('speech-02') || model.includes('speech-2.6') || model.includes('speech-2.8')) {
                                mimeType = 'audio/mpeg';
                            }

                            const audioBlob = new Blob([byteArray], { type: mimeType });
                            const objectURL = URL.createObjectURL(audioBlob);

                            const audio = new Audio(objectURL);
                            audio.volume = 1.0;
                            audio.preload = 'auto';
                            audio.play().catch(e => console.error('【测试】播放失败:', e));
                            showToast('✅ 语音合成测试成功！正在播放...');
                        } else {
                            console.error('JSON响应中没有找到音频数据');

                            // 尝试重新获取响应作为blob
                            try {
                                const blobResponse = await fetch(url, {
                                    method: 'POST',
                                    headers: {
                                        'Content-Type': 'application/json',
                                        'Authorization': `Bearer ${apiKey}`
                                    },
                                    body: JSON.stringify(requestBody)
                                });

                                if (blobResponse.ok) {
                                    const audioBlob = await blobResponse.blob();

                                    if (audioBlob.size > 0) {
                                        let mimeType = audioBlob.type || 'audio/mpeg';
                                        const audioBlobWithType = new Blob([audioBlob], { type: mimeType });
                                        const objectURL = URL.createObjectURL(audioBlobWithType);

                                        const audio = new Audio(objectURL);
                                        audio.volume = 1.0;
                                        audio.preload = 'auto';
                                        audio.play().catch(e => console.error('播放失败:', e));
                                        showToast('✅ 语音合成测试成功！正在播放...');
                                        return;
                                    }
                                }
                            } catch (blobError) {
                                console.error('获取blob失败:', blobError);
                            }

                            showToast('语音合成失败：响应中没有音频数据');
                        }
                    } else {
                        // 直接返回音频数据
                        const audioBlob = await response.blob();
                        console.log('【测试】音频blob类型:', audioBlob.type, '大小:', audioBlob.size);

                        let mimeType = audioBlob.type;
                        if (!mimeType || mimeType === 'application/octet-stream') {
                            if (model.includes('speech-02') || model.includes('speech-2.6') || model.includes('speech-2.8')) {
                                mimeType = 'audio/mpeg';
                            } else {
                                mimeType = 'audio/wav';
                            }
                        }

                        const audioBlobWithType = new Blob([audioBlob], { type: mimeType });
                        const objectURL = URL.createObjectURL(audioBlobWithType);

                        const audio = new Audio(objectURL);
                        audio.volume = 1.0;
                        audio.preload = 'auto';
                        audio.play().catch(e => console.error('播放失败:', e));
                        showToast('✅ 语音合成测试成功！正在播放...');
                    }
                } else {
                    const errorText = await response.text();
                    console.error('❌ 语音合成测试失败:', response.status, response.statusText);
                    console.error('❌ 错误详情:', errorText);
                    console.error('❌ 请求体:', JSON.stringify(requestBody, null, 2));

                    // 构建详细错误信息
                    let errorDetails = '';
                    try {
                        const errorJson = JSON.parse(errorText);
                        console.error('❌ 解析后的错误:', errorJson);
                        errorDetails = JSON.stringify(errorJson, null, 2);
                    } catch (e) {
                        errorDetails = errorText;
                    }

                    // 尝试解析错误信息
                    try {
                        const errorJson = JSON.parse(errorText);

                        if (errorJson.base_resp) {
                            const statusCode = errorJson.base_resp.status_code;
                            const statusMsg = errorJson.base_resp.status_msg;

                            // 根据错误码给出具体提示
                            let suggestion = '';
                            if (statusCode === 2013) {
                                suggestion = '\n\n可能的原因:\n1. voice_id 格式不正确\n2. 缺少必填字段\n3. 参数值为空\n\n请检查控制台输出的请求体';
                            } else if (statusCode === 401 || statusCode === 403) {
                                suggestion = '\n\nAPI Key 无效或已过期，请检查 API Key';
                            } else if (statusCode === 400) {
                                suggestion = '\n\n请求参数错误，请检查 Group ID 和模型名称';
                            }

                            // 【新增】创建带有详细信息的弹窗
                            showToast(`语音合成测试失败: ${statusMsg}`);
                        } else {
                            showToast(`语音合成测试失败: ${errorText}`);
                        }
                    } catch (e) {
                        showToast(`语音合成测试失败: ${errorText}`);
                    }
                }
            } catch (error) {
                console.error('语音合成测试出错:', error);
                showToast(`语音合成测试出错: ${error.message}`);
            }
        }

        // 更新温度显示
        function updateTemperatureDisplay(value) {
            const temperatureValue = document.getElementById('temperatureValue');
            if (temperatureValue) {
                const temp = (parseInt(value) || 0) / 10;
                temperatureValue.textContent = temp.toFixed(1);
            }
        }

        // 【新增】切换副API设置显示
        async function toggleSecondaryApi() {
            const checkbox = document.getElementById('enableSecondaryApi');
            const settingsDiv = document.getElementById('secondaryApiSettings');
            if (checkbox && settingsDiv) {
                const isEnabled = checkbox.checked;
                settingsDiv.style.display = isEnabled ? 'block' : 'none';
                
                // 【修复】当显示副API设置时，从保存的设置中加载值
                if (isEnabled) {
                    try {
                        const savedSettings = await loadAppSettings({});
                        if (savedSettings && savedSettings.api && savedSettings.api.secondary) {
                            // 使用setTimeout确保DOM已经更新
                            setTimeout(() => {
                                const secondary = savedSettings.api.secondary;
                                const baseUrlInput = document.getElementById('secondaryApiBaseUrl');
                                const apiKeyInput = document.getElementById('secondaryApiKey');
                                const modelInput = document.getElementById('secondaryApiModel');
                                
                                if (baseUrlInput && secondary.baseUrl) {
                                    baseUrlInput.value = secondary.baseUrl;
                                }
                                if (apiKeyInput && secondary.apiKey) {
                                    apiKeyInput.value = secondary.apiKey;
                                }
                                if (modelInput && secondary.model) {
                                    modelInput.value = secondary.model;
                                }
                                console.log('【修复】已加载副API设置:', secondary);
                            }, 50);
                        }
                    } catch (error) {
                        console.error('【修复】加载副API设置失败:', error);
                    }
                }
            }
        }

        // 【防闪退】加载设置
        async function loadSettings() {
            // 【防闪退】添加try-catch包裹
            try {
                // 【防闪退】检查localforage是否可用
                if (typeof localforage === 'undefined') {
                    console.warn('【防闪退】localforage未定义');
                    return;
                }

                // 【防闪退】安全地读取设置
                let savedSettings = null;
                try {
                    savedSettings = await loadAppSettings({});
                } catch (e) {
                    console.warn('【防闪退】读取设置失败:', e);
                    return;
                }

                // 【防闪退】安全设置值的辅助函数
                const safeSetValue = (id, value) => {
                    const element = document.getElementById(id);
                    if (element) {
                        // 【修复】确保即使是空字符串也设置值，以清空输入框
                        // 对于密码字段，undefined/null/空字符串都应该设置为空
                        element.value = value !== undefined && value !== null ? value : '';
                        console.log(`【设置加载】${id} = ${value ? '已设置值' : '空值'}`);
                    } else {
                        console.warn(`【设置加载】元素 ${id} 未找到`);
                    }
                };

                if (savedSettings) {
                    // 【防闪退】加载API设置
                    if (savedSettings.api) {
                        safeSetValue('apiBaseUrl', savedSettings.api.baseUrl || 'https://api.openai.com/v1');
                        safeSetValue('apiKey', savedSettings.api.apiKey);
                        safeSetValue('apiModel', savedSettings.api.model || 'gpt-3.5-turbo');

                        // 加载温度设置（默认0.7，对应slider值7）
                        const temperatureInput = document.getElementById('apiTemperature');
                        const temperatureValue = document.getElementById('temperatureValue');
                        if (temperatureInput) {
                            const savedTemp = savedSettings.api.temperature || 0.7;
                            const sliderValue = Math.round(savedTemp * 10);
                            temperatureInput.value = sliderValue;
                            if (temperatureValue) {
                                temperatureValue.textContent = savedTemp.toFixed(1);
                            }
                        }

                        // 加载工具调用轮数（默认2）
                        const maxToolRoundsInput = document.getElementById('maxToolRounds');
                        if (maxToolRoundsInput) {
                            maxToolRoundsInput.value = savedSettings.api.maxToolRounds || 2;
                        }

                        safeSetValue('mapApiKey', savedSettings.api.mapApiKey);
                        safeSetValue('amapSecurityConfig', savedSettings.api.amapSecurityConfig);

                        // 【新增】加载副API设置
                        if (savedSettings.api.secondary) {
                            const enableSecondaryCheckbox = document.getElementById('enableSecondaryApi');
                            if (enableSecondaryCheckbox) {
                                enableSecondaryCheckbox.checked = savedSettings.api.secondary.enabled || false;
                                console.log('【设置加载】enableSecondaryApi =', enableSecondaryCheckbox.checked);
                            }
                            
                            // 【修复】立即加载副API设置，不依赖toggleSecondaryApi
                            const baseUrlInput = document.getElementById('secondaryApiBaseUrl');
                            const apiKeyInput = document.getElementById('secondaryApiKey');
                            const modelInput = document.getElementById('secondaryApiModel');
                            const settingsDiv = document.getElementById('secondaryApiSettings');
                            
                            if (baseUrlInput) {
                                baseUrlInput.value = savedSettings.api.secondary.baseUrl || 'https://api.openai.com/v1';
                                console.log('【设置加载】secondaryApiBaseUrl =', baseUrlInput.value ? '已设置' : '空值');
                            }
                            if (apiKeyInput) {
                                apiKeyInput.value = savedSettings.api.secondary.apiKey || '';
                                console.log('【设置加载】secondaryApiKey =', apiKeyInput.value ? '已设置' : '空值');
                            }
                            if (modelInput) {
                                modelInput.value = savedSettings.api.secondary.model || 'gpt-4o-mini';
                                console.log('【设置加载】secondaryApiModel =', modelInput.value);
                            }
                            if (settingsDiv) {
                                settingsDiv.style.display = savedSettings.api.secondary.enabled ? 'block' : 'none';
                            }
                        }
                    }

                    // 【防闪退】加载minimax设置
                    if (savedSettings.minimax) {
                        safeSetValue('minimaxGroupId', savedSettings.minimax.groupId);
                        safeSetValue('minimaxApiKey', savedSettings.minimax.apiKey);
                        safeSetValue('minimaxModel', savedSettings.minimax.model || 'speech-01');
                        safeSetValue('minimaxApiDomain', savedSettings.minimax.apiDomain || 'https://api.minimax.chat');
                    }

                    // 【防闪退】加载压缩设置
                    if (savedSettings.compress) {
                        safeSetValue('compressQuality', savedSettings.compress.quality || '80');
                        const compressQualityValue = document.getElementById('compressQualityValue');
                        if (compressQualityValue) {
                            compressQualityValue.textContent = `${savedSettings.compress.quality || '80'}%`;
                        }
                    }

                    // 【防闪退】加载小黑屋暗号
                    if (savedSettings.blackRoomCode) {
                        safeSetValue('blackRoomCode', savedSettings.blackRoomCode);
                    }
                }

                // 【防闪退】加载铃声状态（不阻塞）
                if (typeof updateRingtoneStatus === 'function') {
                    updateRingtoneStatus().catch(e => console.warn('【防闪退】加载铃声状态失败:', e));
                }

                // 【防闪退】加载API预设列表（不阻塞）
                if (typeof updatePresetSelect === 'function') {
                    updatePresetSelect().catch(e => console.warn('【防闪退】加载预设列表失败:', e));
                }

                // 【防闪退】加载保存的模型列表
                let modelListLoaded = false;
                try {
                    const savedModels = await loadApiSettingUnified('apiModels');
                    if (savedModels && Array.isArray(savedModels) && savedModels.length > 0) {
                        const select = document.getElementById('apiModel');
                        if (select) {
                            select.innerHTML = '';
                            // 【防闪退】限制模型数量
                            const models = savedModels.slice(0, 100);
                            models.forEach(model => {
                                const option = document.createElement('option');
                                option.value = model.id || 'unknown';
                                option.textContent = model.id || 'unknown';
                                select.appendChild(option);
                            });
                            modelListLoaded = true;
                            console.log('✅ 已加载保存的模型列表，共', models.length, '个模型');
                        }
                    }
                } catch (error) {
                    console.error('【防闪退】加载模型列表失败:', error);
                }

                // 【修复】无论是否加载了模型列表，都重新设置选中的模型
                // 这确保即使模型列表加载失败，用户之前选择的模型也能正确显示
                const apiModelSelect = document.getElementById('apiModel');
                if (apiModelSelect && savedSettings && savedSettings.api && savedSettings.api.model) {
                    const savedModel = savedSettings.api.model;
                    // 检查选项是否存在，如果不存在则添加它
                    let optionExists = false;
                    for (let i = 0; i < apiModelSelect.options.length; i++) {
                        if (apiModelSelect.options[i].value === savedModel) {
                            optionExists = true;
                            break;
                        }
                    }
                    // 如果选项不存在，添加它
                    if (!optionExists) {
                        const option = document.createElement('option');
                        option.value = savedModel;
                        option.textContent = savedModel;
                        apiModelSelect.appendChild(option);
                        console.log('✅ 已添加保存的模型到列表:', savedModel);
                    }
                    // 设置选中的值
                    apiModelSelect.value = savedModel;
                    console.log('✅ 已恢复选中的模型:', savedModel);
                }

            } catch (error) {
                console.error('【防闪退】loadSettings 发生错误:', error);
            }
        }

        // 压缩质量滑块事件 - 使用标记防止重复绑定
        let settingsPageEventsBound = false;
        
        document.addEventListener('DOMContentLoaded', function() {
            // 防止重复绑定
            if (settingsPageEventsBound) return;
            settingsPageEventsBound = true;
            
            const compressQuality = document.getElementById('compressQuality');
            const compressQualityValue = document.getElementById('compressQualityValue');
            if (compressQuality && compressQualityValue) {
                compressQuality.addEventListener('input', function() {
                    compressQualityValue.textContent = `${this.value}%`;
                });
            }
            
            // 预设选择事件监听器
            const apiPresetSelect = document.getElementById('apiPresetSelect');
            if (apiPresetSelect) {
                apiPresetSelect.addEventListener('change', async function() {
                    const selectedPresetName = this.value;
                    console.log('预设选择改变:', selectedPresetName);
                    
                    if (selectedPresetName && selectedPresetName !== 'default') {
                        const presets = await loadApiSettingUnified('apiPresets') || [];
                        console.log('加载的预设列表:', presets);
                        
                        const selectedPreset = presets.find(preset => preset.name === selectedPresetName);
                        console.log('找到的预设:', selectedPreset);
                        
                        if (selectedPreset) {
                            // 加载预设配置
                            document.getElementById('apiBaseUrl').value = selectedPreset.api.baseUrl || 'https://api.openai.com/v1';
                            document.getElementById('apiKey').value = selectedPreset.api.apiKey || '';
                            document.getElementById('apiModel').value = selectedPreset.api.model || 'gpt-3.5-turbo';
                            console.log('预设配置已加载');
                        } else {
                            console.warn('未找到预设:', selectedPresetName);
                        }
                    }
                });
            }

            // 【修复】主API模型选择改变时自动保存
            const apiModelSelect = document.getElementById('apiModel');
            if (apiModelSelect) {
                apiModelSelect.addEventListener('change', async function() {
                    const selectedModel = this.value;
                    console.log('主API模型选择改变:', selectedModel);
                    
                    try {
                        // 读取现有设置
                        let savedSettings = await loadAppSettings({});
                        if (!savedSettings.api) {
                            savedSettings.api = {};
                        }
                        // 更新模型设置
                        savedSettings.api.model = selectedModel;
                        // 保存设置
                        await saveAppSettings(savedSettings);
                        console.log('✅ 主API模型选择已自动保存:', selectedModel);
                    } catch (error) {
                        console.warn('【防闪退】自动保存主API模型选择失败:', error);
                    }
                });
            }

            // 【修复】副API模型选择改变时自动保存
            const secondaryApiModelSelect = document.getElementById('secondaryApiModel');
            if (secondaryApiModelSelect) {
                secondaryApiModelSelect.addEventListener('change', async function() {
                    const selectedModel = this.value;
                    console.log('副API模型选择改变:', selectedModel);
                    
                    try {
                        // 读取现有设置
                        let savedSettings = await loadAppSettings({});
                        if (!savedSettings.api) {
                            savedSettings.api = {};
                        }
                        if (!savedSettings.api.secondary) {
                            savedSettings.api.secondary = {};
                        }
                        // 更新副API模型设置
                        savedSettings.api.secondary.model = selectedModel;
                        // 保存设置
                        await saveAppSettings(savedSettings);
                        console.log('✅ 副API模型选择已自动保存:', selectedModel);
                    } catch (error) {
                        console.warn('【防闪退】自动保存副API模型选择失败:', error);
                    }
                });
            }

            // 【修复】MiniMax模型选择改变时自动保存
            const minimaxModelSelect = document.getElementById('minimaxModel');
            if (minimaxModelSelect) {
                minimaxModelSelect.addEventListener('change', async function() {
                    const selectedModel = this.value;
                    console.log('MiniMax模型选择改变:', selectedModel);
                    
                    try {
                        // 读取现有设置
                        let savedSettings = await loadAppSettings({});
                        if (!savedSettings.minimax) {
                            savedSettings.minimax = {};
                        }
                        // 更新MiniMax模型设置
                        savedSettings.minimax.model = selectedModel;
                        // 保存设置
                        await saveAppSettings(savedSettings);
                        console.log('✅ MiniMax模型选择已自动保存:', selectedModel);
                    } catch (error) {
                        console.warn('【防闪退】自动保存MiniMax模型选择失败:', error);
                    }
                });
            }
            
            loadSettings();
        });

        // API预设管理功能
        async function saveCurrentAsPreset() {
            const presetName = prompt('请输入预设名称:');
            if (presetName) {
                const preset = {
                    name: presetName,
                    api: {
                        baseUrl: document.getElementById('apiBaseUrl').value,
                        apiKey: document.getElementById('apiKey').value,
                        model: document.getElementById('apiModel').value
                    }
                };
                
                let presets = await loadApiSettingUnified('apiPresets') || [];
                presets.push(preset);
                await saveApiSettingUnified('apiPresets', presets);
                
                updatePresetSelect();
                alert('预设保存成功');
            }
        }

        async function deleteCurrentPreset() {
            const select = document.getElementById('apiPresetSelect');
            const selectedValue = select.value;
            
            if (selectedValue !== 'default') {
                let presets = await loadApiSettingUnified('apiPresets') || [];
                presets = presets.filter(preset => preset.name !== selectedValue);
                await saveApiSettingUnified('apiPresets', presets);
                
                updatePresetSelect();
                alert('预设删除成功');
            }
        }

        async function updatePresetSelect() {
            const select = document.getElementById('apiPresetSelect');
            const presets = await loadApiSettingUnified('apiPresets') || [];
            
            // 清空除默认选项外的所有选项
            while (select.options.length > 1) {
                select.remove(1);
            }
            
            // 添加所有预设
            presets.forEach(preset => {
                const option = document.createElement('option');
                option.value = preset.name;
                option.textContent = preset.name;
                select.appendChild(option);
            });
        }

        // 拉取模型列表
        // 【防闪退】拉取模型列表
        async function fetchModels() {
            // 【防闪退】添加try-catch包裹
            try {
                // 【防闪退】检查元素是否存在
                const baseUrlInput = document.getElementById('apiBaseUrl');
                const apiKeyInput = document.getElementById('apiKey');
                const select = document.getElementById('apiModel');

                if (!baseUrlInput || !apiKeyInput || !select) {
                    alert('错误：页面元素未找到');
                    return;
                }

                const baseUrl = baseUrlInput.value.trim();
                const apiKey = apiKeyInput.value.trim();

                if (!apiKey) {
                    alert('请先输入API密钥');
                    return;
                }

                // 【低版本安卓兼容】检查 fetch 是否可用
                if (typeof fetch === 'undefined') {
                    alert('您的设备浏览器版本过低，不支持 fetch API\n请尝试使用 XMLHttpRequest 方式或升级系统');
                    return;
                }

                // 【荣耀/华为手机兼容】检测是否为荣耀/华为/鸿蒙系统
                const isHonor = /Honor|HONOR/i.test(navigator.userAgent);
                const isHuawei = /Huawei|HUAWEI/i.test(navigator.userAgent);
                const isHarmonyOS = /HarmonyOS|OpenHarmony/i.test(navigator.userAgent);
                const needsSpecialHandling = isHonor || isHuawei || isHarmonyOS;
                
                if (needsSpecialHandling) {
                    console.log('【荣耀/华为兼容】检测到荣耀/华为/鸿蒙设备:', {
                        isHonor,
                        isHuawei,
                        isHarmonyOS,
                        userAgent: navigator.userAgent
                    });
                }

                // 【低版本安卓兼容】使用 XMLHttpRequest 作为备选
                // 【荣耀/华为兼容】荣耀/华为手机优先使用 XMLHttpRequest
                let models;
                try {
                    if (needsSpecialHandling) {
                        // 荣耀/华为手机优先使用 XMLHttpRequest
                        console.log('【荣耀/华为兼容】优先使用 XMLHttpRequest');
                        models = await fetchModelsWithXHR(baseUrl, apiKey);
                    } else {
                        // 其他设备先尝试使用 fetch
                        models = await fetchModelsWithFetch(baseUrl, apiKey);
                    }
                } catch (fetchError) {
                    console.warn('【低版本安卓兼容】fetch 失败，尝试 XMLHttpRequest:', fetchError);
                    // 如果 fetch 失败，尝试 XMLHttpRequest
                    try {
                        models = await fetchModelsWithXHR(baseUrl, apiKey);
                    } catch (xhrError) {
                        // 【荣耀/华为兼容】如果 XMLHttpRequest 也失败，尝试特殊处理
                        if (needsSpecialHandling) {
                            console.warn('【荣耀/华为兼容】XMLHttpRequest 失败，尝试特殊处理:', xhrError);
                            models = await fetchModelsWithHarmonyOS(baseUrl, apiKey);
                        } else {
                            throw xhrError;
                        }
                    }
                }

                // 【防闪退】检查models是否为数组
                if (!Array.isArray(models)) {
                    throw new Error('返回的模型数据格式不正确');
                }

                // 【防闪退】限制模型数量，防止DOM操作过多
                const maxModels = 100;
                const modelsToShow = models.slice(0, maxModels);

                // 【修复】保存当前选中的模型值
                const currentSelectedModel = select.value;
                
                // 更新模型选择
                select.innerHTML = '';

                modelsToShow.forEach(model => {
                    const option = document.createElement('option');
                    option.value = model.id || 'unknown';
                    option.textContent = model.id || 'unknown';
                    select.appendChild(option);
                });

                // 【修复】如果之前选中的模型在新列表中存在，则保持选中
                if (currentSelectedModel) {
                    const modelExists = modelsToShow.some(m => m.id === currentSelectedModel);
                    if (modelExists) {
                        select.value = currentSelectedModel;
                    } else if (modelsToShow.length > 0) {
                        // 如果之前的模型不在新列表中，默认选中第一个
                        select.value = modelsToShow[0].id;
                    }
                }

                alert(`模型拉取成功，共 ${modelsToShow.length} 个模型`);

                // 【防闪退】保存模型列表到localforage（不阻塞）
                if (typeof localforage !== 'undefined') {
                    await localforage.setItem('apiModels', models);
                }

                // 注意：模型选择现在通过 change 事件监听器自动保存，当用户手动选择模型时才会保存
            } catch (error) {
                if (error.name === 'AbortError') {
                    console.error('【防闪退】拉取模型超时');
                    alert('拉取模型超时，请检查网络连接');
                } else {
                    console.error('【防闪退】拉取模型失败:', error);
                    // 【增强调试】打印详细环境信息到控制台
                    const isCapacitor = typeof window !== 'undefined' && window.Capacitor && window.Capacitor.isNative;
                    console.log('【调试信息】', {
                        userAgent: navigator.userAgent,
                        isCapacitor: isCapacitor,
                        baseUrl: baseUrlInput?.value,
                        errorName: error.name,
                        errorMessage: error.message,
                        errorStack: error.stack
                    });
                    
                    // 【修复】显示更详细的错误信息
                    let errorMsg = '拉取模型失败';
                    if (error.message) {
                        errorMsg += `\n错误信息: ${error.message}`;
                    }
                    if (error.name && error.name !== 'Error') {
                        errorMsg += `\n错误类型: ${error.name}`;
                    }
                    // 【增强】添加 Capacitor 环境提示
                    if (isCapacitor) {
                        errorMsg += '\n\n【Capacitor 环境】检测到原生应用环境';
                    }
                    // 尝试解析更多错误信息
                    if (error.message && error.message.includes('Failed to fetch')) {
                        errorMsg += '\n\n可能原因:\n1. 网络连接问题\n2. 反代地址无法访问\n3. CORS 跨域问题\n4. 请求被拦截\n5. 低版本安卓 SSL/TLS 不兼容';
                    }
                    // 【低版本安卓】添加特殊提示
                    const isLowAndroid = /Android\s(\d+)/.test(navigator.userAgent) && 
                                         parseInt(navigator.userAgent.match(/Android\s(\d+)/)[1]) <= 7;
                    if (isLowAndroid || error.message?.includes('SSL') || error.message?.includes('TLS')) {
                        errorMsg += '\n\n【低版本安卓提示】\n您的安卓版本较低，可能存在 SSL/TLS 兼容性问题。\n建议:\n1. 升级安卓系统到 8.0 以上\n2. 更新 WebView 到最新版本\n3. 使用 HTTP 而非 HTTPS（不推荐）';
                    }
                    
                    // 【荣耀/华为兼容】添加特殊提示
                    const isHonor = /Honor|HONOR/i.test(navigator.userAgent);
                    const isHuawei = /Huawei|HUAWEI/i.test(navigator.userAgent);
                    const isHarmonyOS = /HarmonyOS|OpenHarmony/i.test(navigator.userAgent);
                    if (isHonor || isHuawei || isHarmonyOS) {
                        errorMsg += '\n\n【荣耀/华为手机提示】\n检测到荣耀/华为/鸿蒙设备，可能存在网络请求限制。\n建议:\n1. 检查手机管家是否拦截了应用网络请求\n2. 在设置中允许应用访问网络\n3. 尝试关闭"智能省流量"功能\n4. 检查是否开启了"纯净模式"\n5. 尝试使用移动数据而非WiFi';
                    }
                    
                    alert(errorMsg);
                }
            }
        }

        // 【低版本安卓兼容】使用 fetch 拉取模型
        async function fetchModelsWithFetch(baseUrl, apiKey) {
            const url = `${baseUrl}/models`;

            // 【优化】优先检测并使用 Capacitor HTTP 插件（绕过CORS限制）
            const isCapacitor = typeof window !== 'undefined' && window.Capacitor && window.Capacitor.isNative;
            if (isCapacitor && window.Capacitor.Plugins && window.Capacitor.Plugins.Http) {
                console.log('【拉取模型】使用 Capacitor HTTP 插件（绕过CORS）');
                try {
                    const response = await window.Capacitor.Plugins.Http.get({
                        url: url,
                        headers: {
                            'Authorization': `Bearer ${apiKey}`,
                            'Content-Type': 'application/json',
                            'Accept': 'application/json'
                        },
                        connectTimeout: 300000,
                        readTimeout: 300000
                    });

                    console.log('【拉取模型】Capacitor HTTP 响应状态:', response.status);

                    if (response.status >= 200 && response.status < 300) {
                        const data = typeof response.data === 'string' ? JSON.parse(response.data) : response.data;
                        console.log('【拉取模型】成功，模型数量:', data.data?.length || 0);
                        return data.data;
                    } else {
                        throw new Error(`HTTP ${response.status}`);
                    }
                } catch (capacitorError) {
                    console.warn('【拉取模型】Capacitor HTTP 失败，回退到 fetch:', capacitorError.message);
                    // 继续执行下面的 fetch 逻辑
                }
            }

            // 【防闪退】添加超时处理
            const controller = new AbortController();
            const timeoutId = setTimeout(() => controller.abort(), 300000); // 【统一】300秒超时

            try {
                console.log('【拉取模型】使用 fetch 请求:', {
                    url: url,
                    isCapacitor: isCapacitor,
                    mode: 'cors',
                    userAgent: navigator.userAgent.substring(0, 50) + '...'
                });

                const response = await fetch(url, {
                    method: 'GET',
                    headers: {
                        'Authorization': `Bearer ${apiKey}`,
                        'Content-Type': 'application/json',
                        'Accept': 'application/json'
                    },
                    signal: controller.signal,
                    // 【修复】统一使用 cors 模式
                    mode: 'cors',
                    // 【低版本安卓兼容】允许发送凭据
                    credentials: 'omit'
                });

                clearTimeout(timeoutId);

                console.log('【拉取模型】响应状态:', {
                    status: response.status,
                    statusText: response.statusText,
                    ok: response.ok
                });

                if (!response.ok) {
                    throw new Error(`HTTP ${response.status}: ${response.statusText}`);
                }

                const data = await response.json();
                console.log('【拉取模型】成功，模型数量:', data.data?.length || 0);
                return data.data;
            } catch (error) {
                clearTimeout(timeoutId);
                console.error('【拉取模型】fetch 失败:', {
                    error: error.message,
                    name: error.name,
                    baseUrl: baseUrl
                });
                throw error;
            }
        }

        // 【低版本安卓兼容】使用 XMLHttpRequest 拉取模型
        function fetchModelsWithXHR(baseUrl, apiKey) {
            return new Promise((resolve, reject) => {
                const xhr = new XMLHttpRequest();
                const url = `${baseUrl}/models`;
                
                xhr.open('GET', url, true);
                xhr.setRequestHeader('Authorization', `Bearer ${apiKey}`);
                xhr.setRequestHeader('Content-Type', 'application/json');
                xhr.setRequestHeader('Accept', 'application/json');
                
                // 【荣耀/华为兼容】添加额外的请求头，避免被系统拦截
                xhr.setRequestHeader('X-Requested-With', 'XMLHttpRequest');
                
                // 【统一】设置超时为300秒
                xhr.timeout = 300000;
                
                xhr.onload = function() {
                    if (xhr.status >= 200 && xhr.status < 300) {
                        try {
                            const data = JSON.parse(xhr.responseText);
                            resolve(data.data);
                        } catch (e) {
                            reject(new Error('解析响应数据失败: ' + e.message));
                        }
                    } else {
                        reject(new Error(`HTTP ${xhr.status}: ${xhr.statusText}`));
                    }
                };
                
                xhr.onerror = () => reject(new Error('网络请求失败，可能是 SSL/TLS 不兼容'));
                xhr.ontimeout = () => reject(new Error('请求超时'));
                xhr.onabort = () => reject(new Error('请求被取消'));
                
                xhr.send();
            });
        }

        // 【荣耀/华为/鸿蒙兼容】特殊处理函数 - 使用 Capacitor HTTP 插件或 fetch with no-cors
        async function fetchModelsWithHarmonyOS(baseUrl, apiKey) {
            console.log('【荣耀/华为兼容】使用 HarmonyOS 特殊处理');
            
            // 尝试使用 Capacitor 的 HTTP 插件（如果在原生环境中）
            if (typeof window !== 'undefined' && window.Capacitor && window.Capacitor.Plugins && window.Capacitor.Plugins.Http) {
                console.log('【荣耀/华为兼容】尝试使用 Capacitor HTTP 插件');
                try {
                    const response = await window.Capacitor.Plugins.Http.get({
                        url: `${baseUrl}/models`,
                        headers: {
                            'Authorization': `Bearer ${apiKey}`,
                            'Content-Type': 'application/json',
                            'Accept': 'application/json'
                        },
                        connectTimeout: 300000,
                        readTimeout: 300000
                    });
                    
                    if (response.status >= 200 && response.status < 300) {
                        const data = typeof response.data === 'string' ? JSON.parse(response.data) : response.data;
                        console.log('【荣耀/华为兼容】Capacitor HTTP 成功');
                        return data.data;
                    } else {
                        throw new Error(`HTTP ${response.status}`);
                    }
                } catch (capacitorError) {
                    console.warn('【荣耀/华为兼容】Capacitor HTTP 失败:', capacitorError);
                }
            }
            
            // 尝试使用 fetch with no-cors 模式（可能返回 opaque 响应）
            console.log('【荣耀/华为兼容】尝试使用 fetch with no-cors');
            try {
                const response = await fetch(`${baseUrl}/models`, {
                    method: 'GET',
                    headers: {
                        'Authorization': `Bearer ${apiKey}`,
                        'Content-Type': 'application/json',
                        'Accept': 'application/json'
                    },
                    mode: 'no-cors', // 【关键】使用 no-cors 模式绕过 CORS 限制
                    credentials: 'omit'
                });
                
                // no-cors 模式下无法读取响应内容，这是一个备选方案
                // 如果服务器支持，可能会成功
                console.log('【荣耀/华为兼容】fetch no-cors 完成，状态:', response.type);
                
                // 如果响应类型是 opaque，说明请求已发送但无法读取内容
                // 这种情况下我们返回一个默认模型列表
                if (response.type === 'opaque') {
                    console.log('【荣耀/华为兼容】收到 opaque 响应，返回默认模型列表');
                    return getDefaultModels();
                }
                
                // 如果能读取响应，尝试解析
                const data = await response.json();
                return data.data;
            } catch (fetchError) {
                console.warn('【荣耀/华为兼容】fetch no-cors 失败:', fetchError);
            }
            
            // 所有方法都失败，返回默认模型列表
            console.log('【荣耀/华为兼容】所有方法都失败，返回默认模型列表');
            return getDefaultModels();
        }
        
        // 【荣耀/华为兼容】获取默认模型列表
        function getDefaultModels() {
            return [
                { id: 'gpt-3.5-turbo', object: 'model', created: 1677649963, owned_by: 'openai' },
                { id: 'gpt-4', object: 'model', created: 1687882411, owned_by: 'openai' },
                { id: 'gpt-4o', object: 'model', created: 1715367049, owned_by: 'openai' },
                { id: 'gpt-4o-mini', object: 'model', created: 1721172741, owned_by: 'openai' },
                { id: 'gpt-4-turbo', object: 'model', created: 1712368641, owned_by: 'openai' },
                { id: 'claude-3-opus-20240229', object: 'model', created: 1708905600, owned_by: 'anthropic' },
                { id: 'claude-3-sonnet-20240229', object: 'model', created: 1708905600, owned_by: 'anthropic' },
                { id: 'claude-3-haiku-20240307', object: 'model', created: 1708905600, owned_by: 'anthropic' }
            ];
        }

        // 【新增】测试主API连接 - 用于手机端诊断
        async function testMainAPIConnection() {
            const resultDiv = document.getElementById('apiTestResult');
            const baseUrl = document.getElementById('apiBaseUrl')?.value || '';
            const apiKey = document.getElementById('apiKey')?.value || '';
            const model = document.getElementById('apiModel')?.value || 'gpt-3.5-turbo';

            if (!baseUrl || !apiKey) {
                resultDiv.style.display = 'block';
                resultDiv.style.background = '#ffebee';
                resultDiv.style.color = '#c62828';
                resultDiv.textContent = '❌ 请先填写API地址和密钥';
                return;
            }

            resultDiv.style.display = 'block';
            resultDiv.style.background = '#fff3e0';
            resultDiv.style.color = '#e65100';
            resultDiv.textContent = '🧪 正在测试API连接，请稍候...';

            try {
                const results = await SQLiteManager.testAPIConnection(baseUrl, apiKey, model);

                // 格式化结果显示
                let resultText = `📱 设备信息:\n`;
                resultText += `   Capacitor环境: ${results.isCapacitor ? '是' : '否'}\n`;
                resultText += `   用户代理: ${results.userAgent.substring(0, 50)}...\n\n`;

                resultText += `🧪 测试结果:\n`;
                let allSuccess = true;

                results.tests.forEach(test => {
                    const icon = test.status === 'success' ? '✅' : (test.status === 'warning' ? '⚠️' : '❌');
                    resultText += `\n${icon} ${test.name}: ${test.message}`;
                    if (test.duration) {
                        resultText += ` (${test.duration}ms)`;
                    }
                    if (test.error) {
                        resultText += `\n   错误: ${test.error.substring(0, 100)}`;
                    }
                    if (test.status !== 'success' && test.status !== 'warning' && test.status !== 'skipped') {
                        allSuccess = false;
                    }
                });

                // 添加建议
                resultText += `\n\n💡 诊断建议:\n`;
                const apiTest = results.tests.find(t => t.name === 'API调用');
                if (apiTest?.status === 'failed') {
                    if (apiTest.errorName === 'TypeError' && apiTest.error?.includes('Failed to fetch')) {
                        resultText += `   • 可能是跨域(CORS)问题\n`;
                        resultText += `   • 尝试使用不同的网络(4G/5G/WiFi)\n`;
                        resultText += `   • 检查API地址是否正确\n`;
                        resultText += `   • 如果是自托管API，确保配置了CORS\n`;
                    } else if (apiTest.httpStatus === 401) {
                        resultText += `   • API密钥无效或已过期\n`;
                        resultText += `   • 请检查密钥是否正确复制\n`;
                    } else if (apiTest.httpStatus === 403) {
                        resultText += `   • API密钥没有权限访问该模型\n`;
                        resultText += `   • 请检查账户余额或权限设置\n`;
                    } else if (apiTest.errorName === 'AbortError') {
                        resultText += `   • 请求超时，API响应太慢\n`;
                        resultText += `   • 检查网络连接稳定性\n`;
                    } else {
                        resultText += `   • 未知错误，请查看控制台日志\n`;
                    }
                } else if (apiTest?.status === 'success') {
                    resultText += `   • API连接正常，可以正常使用\n`;
                }

                resultDiv.textContent = resultText;
                resultDiv.style.background = allSuccess ? '#e8f5e9' : '#fff3e0';
                resultDiv.style.color = allSuccess ? '#2e7d32' : '#e65100';

            } catch (error) {
                resultDiv.style.background = '#ffebee';
                resultDiv.style.color = '#c62828';
                resultDiv.textContent = `❌ 测试失败: ${error.message}`;
            }
        }

        // 【新增】拉取副API模型列表
        async function fetchSecondaryModels() {
            try {
                const baseUrlInput = document.getElementById('secondaryApiBaseUrl');
                const apiKeyInput = document.getElementById('secondaryApiKey');
                const select = document.getElementById('secondaryApiModel');

                if (!baseUrlInput || !apiKeyInput || !select) {
                    alert('错误：页面元素未找到');
                    return;
                }

                const baseUrl = baseUrlInput.value.trim();
                const apiKey = apiKeyInput.value.trim();

                if (!apiKey) {
                    alert('请先输入副API密钥');
                    return;
                }

                // 【荣耀/华为兼容】检测是否为荣耀/华为/鸿蒙系统
                const isHonor = /Honor|HONOR/i.test(navigator.userAgent);
                const isHuawei = /Huawei|HUAWEI/i.test(navigator.userAgent);
                const isHarmonyOS = /HarmonyOS|OpenHarmony/i.test(navigator.userAgent);
                const needsSpecialHandling = isHonor || isHuawei || isHarmonyOS;

                let models;
                try {
                    if (needsSpecialHandling) {
                        // 荣耀/华为手机优先使用 XMLHttpRequest
                        console.log('【荣耀/华为兼容】副API优先使用 XMLHttpRequest');
                        models = await fetchModelsWithXHR(baseUrl, apiKey);
                    } else {
                        // 其他设备使用 fetch
                        const controller = new AbortController();
                        const timeoutId = setTimeout(() => controller.abort(), 300000); // 【统一】300秒超时

                        const response = await fetch(`${baseUrl}/models`, {
                            headers: {
                                'Authorization': `Bearer ${apiKey}`
                            },
                            signal: controller.signal
                        });
                        
                        clearTimeout(timeoutId);
                        
                        if (!response.ok) {
                            throw new Error(`拉取模型失败: ${response.statusText}`);
                        }
                        
                        const data = await response.json();
                        models = data.data;
                    }
                } catch (fetchError) {
                    console.warn('【副API】fetch 失败，尝试 XMLHttpRequest:', fetchError);
                    try {
                        models = await fetchModelsWithXHR(baseUrl, apiKey);
                    } catch (xhrError) {
                        // 【荣耀/华为兼容】如果 XMLHttpRequest 也失败，尝试特殊处理
                        if (needsSpecialHandling) {
                            console.warn('【荣耀/华为兼容】副API XMLHttpRequest 失败，尝试特殊处理:', xhrError);
                            models = await fetchModelsWithHarmonyOS(baseUrl, apiKey);
                        } else {
                            throw xhrError;
                        }
                    }
                }

                if (!Array.isArray(models)) {
                    throw new Error('返回的模型数据格式不正确');
                }

                // 限制模型数量
                const maxModels = 100;
                const modelsToShow = models.slice(0, maxModels);

                // 【修复】保存当前选中的模型值
                const currentSelectedModel = select.value;

                // 更新模型选择
                select.innerHTML = '';

                modelsToShow.forEach(model => {
                    const option = document.createElement('option');
                    option.value = model.id || 'unknown';
                    option.textContent = model.id || 'unknown';
                    select.appendChild(option);
                });

                // 【修复】如果之前选中的模型在新列表中存在，则保持选中
                if (currentSelectedModel) {
                    const modelExists = modelsToShow.some(m => m.id === currentSelectedModel);
                    if (modelExists) {
                        select.value = currentSelectedModel;
                    } else if (modelsToShow.length > 0) {
                        select.value = modelsToShow[0].id;
                    }
                }

                alert(`副API模型拉取成功，共 ${modelsToShow.length} 个模型`);

                // 保存模型列表到localforage
                if (typeof localforage !== 'undefined') {
                    await localforage.setItem('secondaryApiModels', models);
                }

                // 注意：副API模型选择现在通过 change 事件监听器自动保存，当用户手动选择模型时才会保存
            } catch (error) {
                if (error.name === 'AbortError') {
                    console.error('拉取副API模型超时');
                    alert('拉取模型超时，请检查网络连接');
                } else {
                    console.error('拉取副API模型失败:', error);
                    // 【修复】显示更详细的错误信息
                    let errorMsg = '拉取副API模型失败';
                    if (error.message) {
                        errorMsg += `\n错误信息: ${error.message}`;
                    }
                    if (error.name && error.name !== 'Error') {
                        errorMsg += `\n错误类型: ${error.name}`;
                    }
                    if (error.message && error.message.includes('Failed to fetch')) {
                        errorMsg += '\n\n可能原因:\n1. 网络连接问题\n2. 反代地址无法访问\n3. CORS 跨域问题\n4. 请求被拦截';
                    }
                    
                    // 【荣耀/华为兼容】添加特殊提示
                    const isHonor = /Honor|HONOR/i.test(navigator.userAgent);
                    const isHuawei = /Huawei|HUAWEI/i.test(navigator.userAgent);
                    const isHarmonyOS = /HarmonyOS|OpenHarmony/i.test(navigator.userAgent);
                    if (isHonor || isHuawei || isHarmonyOS) {
                        errorMsg += '\n\n【荣耀/华为手机提示】\n检测到荣耀/华为/鸿蒙设备，可能存在网络请求限制。\n建议:\n1. 检查手机管家是否拦截了应用网络请求\n2. 在设置中允许应用访问网络\n3. 尝试关闭"智能省流量"功能\n4. 检查是否开启了"纯净模式"\n5. 尝试使用移动数据而非WiFi';
                    }
                    
                    alert(errorMsg);
                }
            }
        }

        // 【修复】将函数暴露到全局作用域，供HTML中的onclick调用
        window.fetchModels = fetchModels;
        window.fetchSecondaryModels = fetchSecondaryModels;
        window.fetchModelsWithFetch = fetchModelsWithFetch;
        window.fetchModelsWithXHR = fetchModelsWithXHR;

        // 辅助函数：保存到下载目录（简化版 - 仅显示数据）
        async function saveToDownloadFolder(dataStr, fileName) {
            // 移动端无法直接访问文件系统，显示数据供用户复制
            showDataForCopy(dataStr, fileName);
        }

        // 测试弹窗功能的函数
        function testExportPopup() {
            console.log('测试弹窗功能');

            try {
                const testData = JSON.stringify({test: "这是一个测试数据", timestamp: new Date().toISOString()}, null, 2);
                console.log('测试数据:', testData);
                showDataForCopy(testData, "test-export.json");
                console.log('测试弹窗已调用');
            } catch (err) {
                console.error('测试弹窗失败:', err);
                showToast('测试弹窗失败: ' + err.message);
            }
        }

        // 辅助函数：显示数据供复制（超简化版）
        function showDataForCopy(dataStr, fileName) {
            console.log('显示数据复制窗口，数据长度:', dataStr.length);
            
            // 创建超简单的弹窗，避免样式冲突
            const overlay = document.createElement('div');
            overlay.style.cssText = 'position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.8);z-index:999999;';
            
            const content = document.createElement('div');
            content.style.cssText = 'position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);background:white;padding:20px;border-radius:10px;width:90%;max-width:500px;max-height:80%;overflow:auto;';
            
            content.innerHTML = `
                <h2 style="margin-top:0;">数据导出成功！</h2>
                <p>文件名: ${fileName}</p>
                <p>数据大小: ${(dataStr.length / 1024).toFixed(2)} KB</p>
                <button onclick="this.parentElement.parentElement.parentElement.remove(); alert('数据已复制到剪贴板！');" 
                        style="background:#007AFF;color:white;border:none;padding:10px 20px;border-radius:5px;margin:10px 0;">
                    📋 复制数据到剪贴板
                </button>
                <textarea readonly style="width:100%;height:200px;margin:10px 0;padding:10px;border:1px solid #ddd;border-radius:5px;font-family:monospace;font-size:12px;">${dataStr}</textarea>
                <br>
                <button onclick="this.parentElement.parentElement.parentElement.remove();" 
                        style="background:#ccc;border:none;padding:10px 20px;border-radius:5px;">
                    关闭
                </button>
            `;
            
            overlay.appendChild(content);
            document.body.appendChild(overlay);
            
            console.log('数据弹窗已创建');
            
            // 延迟选中文本避免冲突
            setTimeout(() => {
                const textarea = content.querySelector('textarea');
                if (textarea) {
                    textarea.focus();
                    textarea.select();
                    console.log('文本框已选中');
                }
            }, 500);
        }

        // 【新增】检查数据库大小（轻量版，不加载所有消息）
        async function checkDatabaseSize() {
            const infoDiv = document.getElementById('dbSizeInfo');
            if (!infoDiv) return;
            
            infoDiv.innerHTML = '<span style="color: #17a2b8;">正在检查数据库...</span>';
            
            try {
                let messageCount = 0;
                let totalSize = 0;
                
                // 检查 SQLite（轻量查询）
                if (SQLiteManager.isAvailable) {
                    const dbSize = await SQLiteManager.getDatabaseSize();
                    if (dbSize) {
                        messageCount = dbSize.messageCount;
                        totalSize = dbSize.totalContentSize;
                    }
                } else {
                    // 【修复】IndexedDB 使用轻量查询，不加载所有消息
                    const db = await openDB();
                    const transaction = db.transaction('chatMessages', 'readonly');
                    const store = transaction.objectStore('chatMessages');
                    
                    // 只获取计数，不获取内容
                    const countRequest = store.count();
                    messageCount = await new Promise((resolve, reject) => {
                        countRequest.onsuccess = () => resolve(countRequest.result);
                        countRequest.onerror = () => reject(countRequest.error);
                    });
                    
                    // 估算大小：只采样前100条消息
                    const cursorRequest = store.openCursor();
                    let sampleSize = 0;
                    let sampleCount = 0;
                    const MAX_SAMPLES = 100;
                    
                    await new Promise((resolve, reject) => {
                        cursorRequest.onsuccess = (event) => {
                            const cursor = event.target.result;
                            if (cursor && sampleCount < MAX_SAMPLES) {
                                const msg = cursor.value;
                                sampleSize += (msg.content?.length || 0);
                                sampleCount++;
                                cursor.continue();
                            } else {
                                resolve();
                            }
                        };
                        cursorRequest.onerror = () => reject(cursorRequest.error);
                    });
                    
                    // 估算总大小
                    if (sampleCount > 0) {
                        const avgSize = sampleSize / sampleCount;
                        totalSize = avgSize * messageCount;
                    }
                }
                
                const sizeMB = (totalSize / 1024 / 1024).toFixed(2);
                const displayCount = messageCount > 1000000 ? 
                    (messageCount / 1000000).toFixed(2) + 'M' : 
                    messageCount.toLocaleString();
                
                infoDiv.innerHTML = `
                    <div style="background: #f8f9fa; padding: 10px; border-radius: 5px; margin-top: 5px;">
                        <div>📊 消息总数: <b>${displayCount}</b> 条</div>
                        <div>💾 估算大小: <b>${sizeMB}</b> MB</div>
                        <div style="font-size: 11px; color: #666; margin-top: 5px;">
                            ${messageCount > 100000 ? '💡 消息数量较多，但所有回忆都已安全保存' : '✅ 数据库状态正常'}
                        </div>
                    </div>
                `;
            } catch (error) {
                console.error('检查数据库失败:', error);
                infoDiv.innerHTML = '<span style="color: #dc3545;">检查失败: ' + (error.message || '未知错误') + '</span>';
            }
        }
        
        // 【新增】详细分析存储情况
        async function analyzeStorageDetail() {
            const infoDiv = document.getElementById('dbSizeInfo');
            if (!infoDiv) return;
            
            infoDiv.innerHTML = '<span style="color: #6c757d;">正在详细分析存储...</span>';
            
            try {
                let analysis = {
                    sqlite: { messages: 0, size: 0 },
                    indexedDB: { messages: 0, size: 0, stores: [] },
                    localforage: { keys: 0, size: 0 },
                    localStorage: { keys: 0, size: 0 },
                    images: { count: 0, size: 0 }
                };
                
                // 1. 检查 SQLite
                if (SQLiteManager.isAvailable) {
                    try {
                        const dbSize = await SQLiteManager.getDatabaseSize();
                        if (dbSize) {
                            analysis.sqlite.messages = dbSize.messageCount;
                            analysis.sqlite.size = dbSize.totalContentSize;
                        }
                    } catch (e) {
                        console.log('SQLite 检查失败:', e);
                    }
                }
                
                // 2. 检查 IndexedDB 各个存储
                try {
                    const db = await openDB();
                    const storeNames = Array.from(db.objectStoreNames);
                    
                    for (const storeName of storeNames) {
                        try {
                            const transaction = db.transaction(storeName, 'readonly');
                            const store = transaction.objectStore(storeName);
                            const count = await new Promise((resolve, reject) => {
                                const request = store.count();
                                request.onsuccess = () => resolve(request.result);
                                request.onerror = () => reject(request.error);
                            });
                            
                            analysis.indexedDB.stores.push({
                                name: storeName,
                                count: count
                            });
                            analysis.indexedDB.messages += count;
                        } catch (e) {
                            console.log(`IndexedDB ${storeName} 检查失败:`, e);
                        }
                    }
                } catch (e) {
                    console.log('IndexedDB 检查失败:', e);
                }
                
                // 3. 检查 localforage
                try {
                    if (typeof localforage !== 'undefined') {
                        const keys = await localforage.keys();
                        analysis.localforage.keys = keys.length;
                        
                        // 估算大小
                        for (const key of keys) {
                            try {
                                const value = await localforage.getItem(key);
                                if (typeof value === 'string') {
                                    analysis.localforage.size += value.length;
                                } else if (value) {
                                    analysis.localforage.size += JSON.stringify(value).length;
                                }
                            } catch (e) {}
                        }
                    }
                } catch (e) {
                    console.log('localforage 检查失败:', e);
                }
                
                // 4. 检查 localStorage
                try {
                    analysis.localStorage.keys = localStorage.length;
                    for (let i = 0; i < localStorage.length; i++) {
                        const key = localStorage.key(i);
                        const value = localStorage.getItem(key);
                        analysis.localStorage.size += (key.length + value.length);
                    }
                } catch (e) {
                    console.log('localStorage 检查失败:', e);
                }
                
                // 5. 检查图片数据
                try {
                    const imageKeys = ['avatar1', 'avatar2', 'cardBg', 'topCardBg', 'dynamicImage', 'polaroidImage', 'vinylRecordImage', 'vinylLabelImage'];
                    for (const key of imageKeys) {
                        try {
                            const imageData = await getImageFromDB(key);
                            if (imageData) {
                                analysis.images.count++;
                                analysis.images.size += imageData.length;
                            }
                        } catch (e) {}
                    }
                    
                    // 检查聊天头像和背景
                    if (relationshipData.wechatChatList) {
                        for (const chat of relationshipData.wechatChatList) {
                            if (chat.avatar && chat.avatar.startsWith('data:')) {
                                analysis.images.size += chat.avatar.length;
                                analysis.images.count++;
                            }
                            if (chat.background && chat.background.startsWith('data:')) {
                                analysis.images.size += chat.background.length;
                                analysis.images.count++;
                            }
                        }
                    }
                } catch (e) {
                    console.log('图片检查失败:', e);
                }
                
                // 显示结果
                const formatSize = (bytes) => {
                    if (bytes === 0) return '0 B';
                    const k = 1024;
                    const sizes = ['B', 'KB', 'MB', 'GB'];
                    const i = Math.floor(Math.log(bytes) / Math.log(k));
                    return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
                };
                
                infoDiv.innerHTML = `
                    <div style="background: #f8f9fa; padding: 10px; border-radius: 5px; margin-top: 5px; font-size: 12px; line-height: 1.6;">
                        <div style="font-weight: bold; margin-bottom: 8px; color: #333;">📊 存储详细分析</div>
                        
                        <div style="margin-bottom: 6px;">
                            <b>🗄️ SQLite 数据库:</b><br>
                            消息数: ${analysis.sqlite.messages.toLocaleString()} 条<br>
                            内容大小: ${formatSize(analysis.sqlite.size)}
                        </div>
                        
                        <div style="margin-bottom: 6px;">
                            <b>💾 IndexedDB:</b><br>
                            ${analysis.indexedDB.stores.map(s => `${s.name}: ${s.count} 条`).join('<br>')}
                        </div>
                        
                        <div style="margin-bottom: 6px;">
                            <b>📦 LocalForage:</b><br>
                            键数量: ${analysis.localforage.keys}<br>
                            估算大小: ${formatSize(analysis.localforage.size)}
                        </div>
                        
                        <div style="margin-bottom: 6px;">
                            <b>🗃️ LocalStorage:</b><br>
                            键数量: ${analysis.localStorage.keys}<br>
                            估算大小: ${formatSize(analysis.localStorage.size)}
                        </div>
                        
                        <div style="margin-bottom: 6px;">
                            <b>🖼️ 图片数据:</b><br>
                            图片数量: ${analysis.images.count}<br>
                            图片大小: ${formatSize(analysis.images.size)}
                        </div>
                        
                        <div style="margin-top: 8px; padding-top: 8px; border-top: 1px solid #ddd; color: #666;">
                            <b>💡 分析:</b><br>
                            ${analysis.sqlite.size > 0 && analysis.indexedDB.messages > analysis.sqlite.messages ? 
                                '⚠️ 发现 IndexedDB 和 SQLite 都有消息数据，可能存在重复存储' : 
                                '✅ 消息数据存储正常'}
                            <br>
                            ${analysis.images.size > 10 * 1024 * 1024 ? 
                                '💡 图片数据较大，建议检查是否有重复保存的头像' : 
                                '✅ 图片数据正常'}
                        </div>
                        
                        <!-- 【新增】重新迁移按钮 -->
                        ${analysis.sqlite.messages === 0 && (analysis.indexedDB.messages > 0 || analysis.localforage.keys > 0) ? `
                        <div style="margin-top: 10px; padding-top: 10px; border-top: 1px solid #ddd;">
                            <div style="color: #ff6b6b; margin-bottom: 8px;">
                                ⚠️ SQLite 中没有消息数据，但其他存储中有数据
                            </div>
                            <button onclick="showMigrationDebugPanel()" 
                                style="background: linear-gradient(135deg, #ff6b6b 0%, #ee5a6f 100%); 
                                       color: white; border: none; padding: 8px 16px; 
                                       border-radius: 15px; cursor: pointer; font-size: 12px;">
                                🔧 打开调试面板
                            </button>
                        </div>
                        ` : ''}
                    </div>
                `;
                
                console.log('存储详细分析:', analysis);
                
            } catch (error) {
                console.error('详细分析失败:', error);
                infoDiv.innerHTML = '<span style="color: #dc3545;">分析失败: ' + (error.message || '未知错误') + '</span>';
            }
        }

        // 【新增】检查 WebView 缓存和总存储
        async function checkWebViewCache() {
            const infoDiv = document.getElementById('dbSizeInfo');
            if (!infoDiv) return;
            
            infoDiv.innerHTML = '<span style="color: #6c757d;">正在检查 WebView 缓存...</span>';
            
            try {
                let cacheInfo = {
                    webviewCache: '未知',
                    appCache: '未知',
                    totalStorage: '未知',
                    usageDetails: null
                };
                
                // 1. 检查 Storage API
                if ('storage' in navigator && 'estimate' in navigator.storage) {
                    try {
                        const estimate = await navigator.storage.estimate();
                        cacheInfo.usageDetails = estimate;
                        
                        if (estimate.usage) {
                            cacheInfo.totalStorage = formatBytes(estimate.usage);
                        }
                        if (estimate.quota) {
                            cacheInfo.quota = formatBytes(estimate.quota);
                        }
                    } catch (e) {
                        console.log('Storage estimate 失败:', e);
                    }
                }
                
                // 2. 检查 caches API
                let cacheSize = 0;
                if ('caches' in window) {
                    try {
                        const cacheNames = await caches.keys();
                        for (const cacheName of cacheNames) {
                            const cache = await caches.open(cacheName);
                            const requests = await cache.keys();
                            cacheSize += requests.length;
                        }
                    } catch (e) {
                        console.log('Cache 检查失败:', e);
                    }
                }
                
                // 3. 检查 Application Cache (已弃用但可能还有数据)
                let appCacheStatus = '不支持';
                if (window.applicationCache) {
                    const statusMap = ['未缓存', '空闲', '检查中', '下载中', '更新就绪', '已过时'];
                    appCacheStatus = statusMap[window.applicationCache.status] || '未知';
                }
                
                // 4. 检查 IndexedDB 详细大小
                let idbDetails = [];
                try {
                    const dbs = await indexedDB.databases ? await indexedDB.databases() : [];
                    for (const dbInfo of dbs) {
                        idbDetails.push(`${dbInfo.name}: 版本 ${dbInfo.version}`);
                    }
                } catch (e) {
                    console.log('IndexedDB 数据库列表获取失败:', e);
                }
                
                // 格式化函数
                function formatBytes(bytes) {
                    if (bytes === 0) return '0 B';
                    const k = 1024;
                    const sizes = ['B', 'KB', 'MB', 'GB', 'TB'];
                    const i = Math.floor(Math.log(bytes) / Math.log(k));
                    return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
                }
                
                // 显示结果
                infoDiv.innerHTML = `
                    <div style="background: #fff3cd; padding: 10px; border-radius: 5px; margin-top: 5px; font-size: 12px; line-height: 1.6;">
                        <div style="font-weight: bold; margin-bottom: 8px; color: #856404;">🌐 WebView 存储分析</div>
                        
                        <div style="margin-bottom: 6px;">
                            <b>💾 总存储使用:</b> ${cacheInfo.totalStorage}
                            ${cacheInfo.quota ? `<br>配额限制: ${cacheInfo.quota}` : ''}
                        </div>
                        
                        <div style="margin-bottom: 6px;">
                            <b>📦 Cache API:</b> ${cacheSize} 个缓存对象
                        </div>
                        
                        <div style="margin-bottom: 6px;">
                            <b>🗄️ Application Cache:</b> ${appCacheStatus}
                        </div>
                        
                        <div style="margin-bottom: 6px;">
                            <b>💾 IndexedDB 数据库:</b><br>
                            ${idbDetails.length > 0 ? idbDetails.join('<br>') : '无法获取列表'}
                        </div>
                        
                        ${cacheInfo.usageDetails ? `
                        <div style="margin-top: 8px; padding-top: 8px; border-top: 1px solid #ffc107;">
                            <b>📊 详细分解:</b><br>
                            ${cacheInfo.usageDetails.usageDetails ? `
                                indexedDB: ${formatBytes(cacheInfo.usageDetails.usageDetails.indexedDB || 0)}<br>
                                caches: ${formatBytes(cacheInfo.usageDetails.usageDetails.caches || 0)}<br>
                                serviceWorker: ${formatBytes(cacheInfo.usageDetails.usageDetails.serviceWorkerRegistrations || 0)}
                            ` : '详细信息不可用'}
                        </div>
                        ` : ''}
                        
                        <div style="margin-top: 8px; padding-top: 8px; border-top: 1px solid #ffc107; color: #856404;">
                            <b>💡 说明:</b><br>
                            如果这里显示的大小远小于系统显示的 4.73GB，<br>
                            可能是 WebView 的底层缓存或系统统计方式问题。<br>
                            尝试点击"✨ 优化空间"或清理应用缓存。
                        </div>
                    </div>
                `;
                
                console.log('WebView 缓存分析:', cacheInfo);
                
            } catch (error) {
                console.error('检查 WebView 缓存失败:', error);
                infoDiv.innerHTML = '<span style="color: #dc3545;">检查失败: ' + (error.message || '未知错误') + '</span>';
            }
        }

        // 【新增】检查 localforage 中 relationshipData 的实际大小
        async function checkLocalforageDataSize() {
            const infoDiv = document.getElementById('dbSizeInfo');
            if (!infoDiv) return;
            
            infoDiv.innerHTML = '<span style="color: #6c757d;">正在检查 localforage 数据大小...</span>';
            
            try {
                let result = {
                    relationshipDataSize: 0,
                    hasBase64Images: false,
                    chatListItemCount: 0,
                    totalKeys: 0
                };
                
                // 获取所有键
                const keys = await localforage.keys();
                result.totalKeys = keys.length;
                
                // 检查 relationshipData
                if (keys.includes('relationshipData')) {
                    const data = await localforage.getItem('relationshipData');
                    if (data) {
                        result.relationshipDataSize = typeof data === 'string' ? data.length : JSON.stringify(data).length;
                        
                        // 尝试解析并检查是否包含 base64 图片
                        try {
                            const parsed = typeof data === 'string' ? JSON.parse(data) : data;
                            if (parsed.wechatChatList && Array.isArray(parsed.wechatChatList)) {
                                result.chatListItemCount = parsed.wechatChatList.length;
                                
                                // 检查每个聊天项
                                for (const chat of parsed.wechatChatList) {
                                    if (chat.avatar && chat.avatar.length > 1000 && chat.avatar.startsWith('data:')) {
                                        result.hasBase64Images = true;
                                        console.warn(`发现 base64 头像: ${chat.name}, 大小: ${(chat.avatar.length / 1024).toFixed(2)} KB`);
                                    }
                                    if (chat.background && chat.background.length > 1000 && chat.background.startsWith('data:')) {
                                        result.hasBase64Images = true;
                                        console.warn(`发现 base64 背景: ${chat.name}, 大小: ${(chat.background.length / 1024).toFixed(2)} KB`);
                                    }
                                }
                            }
                        } catch (e) {
                            console.log('解析 relationshipData 失败:', e);
                        }
                    }
                }
                
                // 格式化大小
                const formatSize = (bytes) => {
                    if (bytes === 0) return '0 B';
                    const k = 1024;
                    const sizes = ['B', 'KB', 'MB', 'GB'];
                    const i = Math.floor(Math.log(bytes) / Math.log(k));
                    return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
                };
                
                infoDiv.innerHTML = `
                    <div style="background: #f8d7da; padding: 10px; border-radius: 5px; margin-top: 5px; font-size: 12px; line-height: 1.6;">
                        <div style="font-weight: bold; margin-bottom: 8px; color: #721c24;">💾 LocalForage 数据检查</div>
                        
                        <div style="margin-bottom: 6px;">
                            <b>📦 总键数量:</b> ${result.totalKeys}
                        </div>
                        
                        <div style="margin-bottom: 6px;">
                            <b>💾 relationshipData 大小:</b> ${formatSize(result.relationshipDataSize)}
                        </div>
                        
                        <div style="margin-bottom: 6px;">
                            <b>👥 聊天列表项数:</b> ${result.chatListItemCount}
                        </div>
                        
                        <div style="margin-bottom: 6px;">
                            <b>🖼️ 包含 base64 图片:</b> ${result.hasBase64Images ? '⚠️ 是（可能导致数据膨胀）' : '✅ 否'}
                        </div>
                        
                        ${result.hasBase64Images ? `
                        <div style="margin-top: 8px; padding-top: 8px; border-top: 1px solid #f5c6cb; color: #721c24;">
                            <b>⚠️ 警告:</b><br>
                            发现 base64 图片数据保存在 localforage 中！<br>
                            这会导致每次保存时数据量急剧增加。<br>
                            建议立即导出数据，重新导入以修复此问题。
                        </div>
                        ` : ''}
                    </div>
                `;
                
                console.log('LocalForage 数据检查:', result);
                
            } catch (error) {
                console.error('检查 localforage 失败:', error);
                infoDiv.innerHTML = '<span style="color: #dc3545;">检查失败: ' + (error.message || '未知错误') + '</span>';
            }
        }

        // 【新增】检查 SQLite 状态
        async function checkSQLiteStatus() {
            const infoDiv = document.getElementById('dbSizeInfo');
            if (!infoDiv) return;
            
            infoDiv.innerHTML = '<span style="color: #9c27b0;">正在检查 SQLite 状态...</span>';
            
            try {
                let status = {
                    capacitorAvailable: false,
                    pluginsAvailable: false,
                    sqlitePluginAvailable: false,
                    sqliteInitialized: false,
                    databaseConnected: false,
                    messageCount: 0
                };
                
                // 1. 检查 Capacitor
                if (window.Capacitor) {
                    status.capacitorAvailable = true;
                    
                    // 2. 检查 Plugins
                    if (window.Capacitor.Plugins) {
                        status.pluginsAvailable = true;
                        
                        // 3. 检查 SQLite 插件
                        if (window.Capacitor.Plugins.CapacitorSQLite) {
                            status.sqlitePluginAvailable = true;
                        }
                    }
                }
                
                // 4. 检查 SQLiteManager 状态
                status.sqliteInitialized = SQLiteManager.isAvailable;
                status.databaseConnected = SQLiteManager.db !== null;
                
                // 5. 如果已连接，检查消息数
                if (status.databaseConnected) {
                    try {
                        const dbSize = await SQLiteManager.getDatabaseSize();
                        if (dbSize) {
                            status.messageCount = dbSize.messageCount;
                        }
                    } catch (e) {
                        console.log('获取 SQLite 消息数失败:', e);
                    }
                }
                
                // 显示结果
                infoDiv.innerHTML = `
                    <div style="background: #f3e5f5; padding: 10px; border-radius: 5px; margin-top: 5px; font-size: 12px; line-height: 1.6;">
                        <div style="font-weight: bold; margin-bottom: 8px; color: #4a148c;">🗄️ SQLite 状态诊断</div>
                        
                        <div style="margin-bottom: 6px;">
                            <b>📱 Capacitor 环境:</b> ${status.capacitorAvailable ? '✅ 可用' : '❌ 不可用'}
                        </div>
                        
                        <div style="margin-bottom: 6px;">
                            <b>🔌 Plugins 加载:</b> ${status.pluginsAvailable ? '✅ 已加载' : '❌ 未加载'}
                        </div>
                        
                        <div style="margin-bottom: 6px;">
                            <b>💾 SQLite 插件:</b> ${status.sqlitePluginAvailable ? '✅ 已安装' : '❌ 未安装'}
                        </div>
                        
                        <div style="margin-bottom: 6px;">
                            <b>🚀 SQLite 初始化:</b> ${status.sqliteInitialized ? '✅ 已初始化' : '❌ 未初始化'}
                        </div>
                        
                        <div style="margin-bottom: 6px;">
                            <b>🔗 数据库连接:</b> ${status.databaseConnected ? '✅ 已连接' : '❌ 未连接'}
                        </div>
                        
                        <div style="margin-bottom: 6px;">
                            <b>📝 消息数量:</b> ${status.messageCount.toLocaleString()} 条
                        </div>
                        
                        <div style="margin-top: 8px; padding-top: 8px; border-top: 1px solid #ce93d8; color: #4a148c;">
                            <b>💡 诊断结果:</b><br>
                            ${!status.capacitorAvailable ? 
                                '❌ 不在 Capacitor 环境中（可能是在浏览器中运行）<br>SQLite 只在 APK 环境中可用' : 
                                !status.sqlitePluginAvailable ? 
                                '❌ SQLite 插件未安装<br>需要重新构建 APK 并安装 SQLite 插件' :
                                !status.sqliteInitialized ? 
                                '⚠️ SQLite 插件已安装但未初始化<br>尝试重启应用' :
                                status.messageCount === 0 ? 
                                '⚠️ SQLite 已连接但没有消息<br>消息可能只保存在 IndexedDB 中' :
                                '✅ SQLite 工作正常'
                            }
                        </div>
                    </div>
                `;
                
                console.log('SQLite 状态诊断:', status);
                
            } catch (error) {
                console.error('检查 SQLite 状态失败:', error);
                infoDiv.innerHTML = '<span style="color: #dc3545;">检查失败: ' + (error.message || '未知错误') + '</span>';
            }
        }

        // 【新增】优化数据库（不删除数据，只回收空间）
        async function optimizeDatabase() {
            if (!confirm('确定要优化数据库吗？\n\n这将整理数据库文件结构，释放被占用的空白空间。\n不会删除任何消息记录，请放心使用！')) {
                return;
            }
            
            const infoDiv = document.getElementById('dbSizeInfo');
            if (infoDiv) {
                infoDiv.innerHTML = '<span style="color: #28a745;">正在优化数据库，请稍候...</span>';
            }
            
            try {
                let success = false;
                
                // 优化 SQLite
                if (SQLiteManager.isAvailable) {
                    // 先获取优化前的大小
                    const beforeSize = await SQLiteManager.getDatabaseSize();
                    
                    // 执行 VACUUM 回收空间
                    success = await SQLiteManager.vacuumDatabase();
                    
                    if (success) {
                        // 获取优化后的大小
                        const afterSize = await SQLiteManager.getDatabaseSize();
                        const savedMB = beforeSize && afterSize ? 
                            ((beforeSize.totalContentSize - afterSize.totalContentSize) / 1024 / 1024).toFixed(2) : 0;
                        
                        showToast('数据库优化完成！', 'success');
                        
                        if (infoDiv) {
                            infoDiv.innerHTML = `
                                <div style="background: #d4edda; padding: 10px; border-radius: 5px; margin-top: 5px;">
                                    <div>✅ 优化完成！</div>
                                    <div style="font-size: 11px; color: #155724; margin-top: 5px;">
                                        所有 ${afterSize?.messageCount || 0} 条消息记录都已保留<br>
                                        数据库文件已整理，空间使用更高效
                                    </div>
                                </div>
                            `;
                        }
                    }
                } else {
                    // IndexedDB 优化（简化版）
                    showToast('IndexedDB 优化功能开发中，请使用 SQLite 版本', 'warning');
                    return;
                }
                
                if (!success) {
                    showToast('优化失败，请查看控制台日志', 'error');
                }
            } catch (error) {
                console.error('优化数据库失败:', error);
                showToast('优化失败: ' + error.message, 'error');
            }
        }

        // 【新增】WCDB 状态检测
        async function testWCDBStatus() {
            const infoDiv = document.getElementById('wcdbStatusInfo');
            if (infoDiv) {
                infoDiv.innerHTML = '<span style="color: #4CAF50;">正在检测 WCDB 状态...</span>';
            }
            
            try {
                let result = '<div style="background: #e8f5e9; padding: 10px; border-radius: 5px;">';
                result += '<div style="font-weight: bold; color: #2e7d32; margin-bottom: 8px;">🚀 WCDB 状态报告</div>';
                
                // 1. 检查 Capacitor 环境
                const hasCapacitor = !!(window.Capacitor);
                const hasPlugins = !!(window.Capacitor && window.Capacitor.Plugins);
                const hasWCDBPlugin = !!(window.Capacitor && window.Capacitor.Plugins && window.Capacitor.Plugins.WCDB);
                
                result += `<div style="font-size: 11px; margin: 4px 0;">📱 Capacitor: ${hasCapacitor ? '✅' : '❌'}</div>`;
                result += `<div style="font-size: 11px; margin: 4px 0;">🔌 Plugins: ${hasPlugins ? '✅' : '❌'}</div>`;
                result += `<div style="font-size: 11px; margin: 4px 0;">🗄️ WCDB Plugin: ${hasWCDBPlugin ? '✅' : '❌'}</div>`;
                
                // 2. 检查当前使用的数据库类型
                const dbType = SQLiteManager.getCurrentDatabaseType ? SQLiteManager.getCurrentDatabaseType() : 'unknown';
                result += `<div style="font-size: 11px; margin: 4px 0; font-weight: bold;">💾 当前数据库: <span style="color: ${dbType === 'wcdb' ? '#4CAF50' : '#ff9800'}">${dbType.toUpperCase()}</span></div>`;
                
                // 3. 检查 WCDBManager
                const hasWCDBManager = !!(window.WCDBManager);
                result += `<div style="font-size: 11px; margin: 4px 0;">⚙️ WCDBManager: ${hasWCDBManager ? '✅' : '❌'}</div>`;
                
                // 4. 尝试调用 WCDB 插件
                if (hasWCDBPlugin) {
                    try {
                        const wcdbAvailable = await window.Capacitor.Plugins.WCDB.isAvailable();
                        result += `<div style="font-size: 11px; margin: 4px 0;">🔍 WCDB Available: ${wcdbAvailable.available ? '✅' : '❌'}</div>`;
                        
                        if (wcdbAvailable.available) {
                            const dbInfo = await window.Capacitor.Plugins.WCDB.getDatabaseInfo();
                            result += `<div style="font-size: 11px; margin: 4px 0;">📂 数据库路径: ${dbInfo.path || 'N/A'}</div>`;
                            result += `<div style="font-size: 11px; margin: 4px 0;">🔢 版本: ${dbInfo.version || 'N/A'}</div>`;
                        }
                    } catch (e) {
                        result += `<div style="font-size: 11px; margin: 4px 0; color: #f44336;">❌ 调用失败: ${e.message}</div>`;
                    }
                }
                
                // 5. 检查迁移状态
                if (window.WCDBMigration) {
                    const migrationStatus = await window.WCDBMigration.getMigrationStatus();
                    result += `<div style="font-size: 11px; margin: 4px 0;">🔄 迁移状态: ${migrationStatus.completed ? '✅ 已完成' : '⏳ 未迁移'}</div>`;
                    if (migrationStatus.time) {
                        result += `<div style="font-size: 11px; margin: 4px 0;">📅 迁移时间: ${new Date(migrationStatus.time).toLocaleString()}</div>`;
                    }
                }
                
                result += '</div>';
                
                if (infoDiv) {
                    infoDiv.innerHTML = result;
                }
                
                console.log('【WCDB测试】状态检测结果:', { hasCapacitor, hasPlugins, hasWCDBPlugin, dbType });
                
            } catch (error) {
                console.error('【WCDB测试】检测失败:', error);
                if (infoDiv) {
                    infoDiv.innerHTML = `<span style="color: #f44336;">检测失败: ${error.message}</span>`;
                }
            }
        }
        
        // 【新增】WCDB 迁移测试
        async function testWCDBMigration() {
            const infoDiv = document.getElementById('wcdbStatusInfo');
            if (infoDiv) {
                infoDiv.innerHTML = '<span style="color: #2196F3;">正在测试 WCDB 迁移...</span>';
            }
            
            try {
                if (!window.WCDBMigration) {
                    throw new Error('WCDBMigration 未加载');
                }
                
                // 检查是否需要迁移
                const needMigration = await window.WCDBMigration.checkNeedMigration();
                
                if (!needMigration) {
                    if (infoDiv) {
                        infoDiv.innerHTML = '<div style="background: #e3f2fd; padding: 10px; border-radius: 5px;">✅ 不需要迁移，数据已是最新</div>';
                    }
                    return;
                }
                
                if (infoDiv) {
                    infoDiv.innerHTML = '<span style="color: #2196F3;">正在执行数据迁移，请稍候...</span>';
                }
                
                // 执行迁移
                const result = await window.WCDBMigration.migrate();
                
                if (result.success) {
                    let html = '<div style="background: #e8f5e9; padding: 10px; border-radius: 5px;">';
                    html += '<div style="font-weight: bold; color: #2e7d32; margin-bottom: 8px;">✅ 迁移成功！</div>';
                    html += `<div style="font-size: 11px;">聊天数: ${result.results.chatList}</div>`;
                    html += `<div style="font-size: 11px;">消息数: ${result.results.messages}</div>`;
                    html += `<div style="font-size: 11px;">设置: ${result.results.settings ? '✅' : '❌'}</div>`;
                    html += `<div style="font-size: 11px;">个人资料: ${result.results.profile ? '✅' : '❌'}</div>`;
                    html += '</div>';
                    
                    if (infoDiv) {
                        infoDiv.innerHTML = html;
                    }
                    
                    showToast('WCDB 数据迁移成功！', 'success');
                } else {
                    throw new Error(result.message || '迁移失败');
                }
                
            } catch (error) {
                console.error('【WCDB测试】迁移失败:', error);
                if (infoDiv) {
                    infoDiv.innerHTML = `<span style="color: #f44336;">迁移失败: ${error.message}</span>`;
                }
                showToast('迁移失败: ' + error.message, 'error');
            }
        }
        
        // 【新增】强制使用 WCDB
        async function forceUseWCDB() {
            const infoDiv = document.getElementById('wcdbStatusInfo');
            if (infoDiv) {
                infoDiv.innerHTML = '<span style="color: #FF9800;">正在强制切换到 WCDB...</span>';
            }
            
            try {
                // 直接调用 window.WCDBManager 的方法
                if (window.WCDBManager && window.Capacitor && window.Capacitor.Plugins && window.Capacitor.Plugins.WCDB) {
                    const available = await window.Capacitor.Plugins.WCDB.isAvailable();
                    if (available.available) {
                        // 初始化 WCDB
                        await window.Capacitor.Plugins.WCDB.initDatabase();
                        
                        // 更新 SQLiteManager 状态
                        if (SQLiteManager) {
                            SQLiteManager._useWCDB = true;
                            SQLiteManager._wcdbAvailable = true;
                        }
                        
                        if (infoDiv) {
                            infoDiv.innerHTML = '<div style="background: #fff3e0; padding: 10px; border-radius: 5px; color: #e65100;">✅ 已强制切换到 WCDB</div>';
                        }
                        showToast('已切换到 WCDB 数据库', 'success');
                    } else {
                        throw new Error('WCDB 插件不可用');
                    }
                } else {
                    throw new Error('WCDB 环境未就绪');
                }
            } catch (error) {
                console.error('【WCDB测试】强制切换失败:', error);
                if (infoDiv) {
                    infoDiv.innerHTML = `<span style="color: #f44336;">切换失败: ${error.message}</span>`;
                }
                showToast('切换失败: ' + error.message, 'error');
            }
        }
        
        // 【新增】强制使用 SQLite
        function forceUseSQLite() {
            const infoDiv = document.getElementById('wcdbStatusInfo');
            
            try {
                if (SQLiteManager.forceUseSQLite) {
                    const success = SQLiteManager.forceUseSQLite();
                    if (success) {
                        if (infoDiv) {
                            infoDiv.innerHTML = '<div style="background: #f5f5f5; padding: 10px; border-radius: 5px; color: #616161;">✅ 已强制切换到 SQLite</div>';
                        }
                        showToast('已切换到 SQLite 数据库', 'success');
                    } else {
                        throw new Error('SQLite 不可用');
                    }
                } else {
                    throw new Error('forceUseSQLite 方法不存在');
                }
            } catch (error) {
                console.error('【WCDB测试】强制切换失败:', error);
                if (infoDiv) {
                    infoDiv.innerHTML = `<span style="color: #f44336;">切换失败: ${error.message}</span>`;
                }
                showToast('切换失败: ' + error.message, 'error');
            }
        }

        // 【新增】检测当前存储状态
        async function checkStorageStatus() {
            const infoDiv = document.getElementById('storageStatusInfo');
            if (infoDiv) {
                infoDiv.innerHTML = '<span style="color: #17a2b8;">正在检测存储状态...</span>';
            }
            
            try {
                const status = {
                    sqlite: {
                        available: SQLiteManager.isAvailable,
                        plugin: !!(window.Capacitor && window.Capacitor.Plugins && window.Capacitor.Plugins.CapacitorSQLite),
                        disabled: localStorage.getItem('__sqlite_disabled') === 'true'
                    },
                    storage: {
                        type: 'unknown',
                        messageCount: 0,
                        chatCount: 0
                    }
                };
                
                // 检测实际使用的存储
                if (SQLiteManager.isAvailable) {
                    status.storage.type = 'SQLite';
                    try {
                        const chatList = await SQLiteManager.getChatList();
                        status.storage.chatCount = chatList.length;
                        
                        // 获取消息总数
                        let totalMessages = 0;
                        for (const chat of chatList) {
                            const count = await SQLiteManager.getMessageCount(chat.id);
                            totalMessages += count;
                        }
                        status.storage.messageCount = totalMessages;
                    } catch (e) {
                        console.warn('获取SQLite统计失败:', e);
                    }
                } else {
                    status.storage.type = 'IndexedDB (localforage)';
                    try {
                        // 从IndexedDB获取统计
                        const chatList = relationshipData.wechatChatList || [];
                        status.storage.chatCount = chatList.length;
                        
                        // 尝试从ChatMessageManager获取消息数
                        if (ChatMessageManager && ChatMessageManager.db) {
                            const db = await ChatMessageManager.db;
                            const transaction = db.transaction('chatMessages', 'readonly');
                            const store = transaction.objectStore('chatMessages');
                            const countRequest = store.count();
                            
                            await new Promise((resolve, reject) => {
                                countRequest.onsuccess = () => {
                                    status.storage.messageCount = countRequest.result;
                                    resolve();
                                };
                                countRequest.onerror = () => reject(countRequest.error);
                            });
                        } else {
                            // 降级：使用内存中的数据
                            status.storage.messageCount = relationshipData.chatMessages?.length || 0;
                        }
                    } catch (e) {
                        console.warn('获取IndexedDB统计失败:', e);
                        status.storage.messageCount = relationshipData.chatMessages?.length || 0;
                    }
                }
                
                // 显示结果
                const statusColor = status.sqlite.available ? '#28a745' : '#ffc107';
                const statusText = status.sqlite.available ? '✅ SQLite（高性能模式）' : '⚠️ IndexedDB（降级模式）';
                
                if (infoDiv) {
                    infoDiv.innerHTML = `
                        <div style="background: ${status.sqlite.available ? '#d4edda' : '#fff3cd'}; padding: 10px; border-radius: 5px;">
                            <div style="font-weight: bold; color: ${statusColor}; margin-bottom: 5px;">
                                ${statusText}
                            </div>
                            <div style="font-size: 11px; color: #666;">
                                <div>💾 存储类型: ${status.storage.type}</div>
                                <div>💬 聊天记录: ${status.storage.messageCount} 条</div>
                                <div>👥 聊天对象: ${status.storage.chatCount} 个</div>
                                <div>🔌 SQLite插件: ${status.sqlite.plugin ? '可用' : '不可用'}</div>
                                <div>🚫 禁用标记: ${status.sqlite.disabled ? '已禁用' : '未禁用'}</div>
                            </div>
                        </div>
                    `;
                }
                
                console.log('【存储状态】', status);
                
                // 显示重新启用按钮（只要插件可用就显示）
                if (status.sqlite.plugin) {
                    const buttonText = status.sqlite.available ? '重启 SQLite' : '重新启用 SQLite';
                    const hintText = status.sqlite.available 
                        ? 'SQLite已启用，点击可重新初始化' 
                        : (status.sqlite.disabled ? 'SQLite被禁用，点击重新启用' : 'SQLite插件可用但未初始化');
                    
                    if (infoDiv) {
                        infoDiv.innerHTML += `
                            <div style="margin-top: 10px; padding: 10px; background: #e7f3ff; border-radius: 5px; border-left: 3px solid #0066cc;">
                                <div style="font-size: 11px; color: #0066cc; margin-bottom: 5px;">
                                    💡 ${hintText}
                                </div>
                                <button onclick="reEnableSQLite()" style="background: linear-gradient(135deg, #0066cc 0%, #0052a3 100%); color: white; border: none; padding: 6px 12px; border-radius: 4px; font-size: 11px; cursor: pointer;">
                                    🚀 ${buttonText}
                                </button>
                            </div>
                        `;
                    }
                } else {
                    if (infoDiv) {
                        infoDiv.innerHTML += `
                            <div style="margin-top: 10px; padding: 10px; background: #f8d7da; border-radius: 5px; border-left: 3px solid #dc3545;">
                                <div style="font-size: 11px; color: #721c24;">
                                    ❌ SQLite插件不可用（可能不是APK环境）
                                </div>
                            </div>
                        `;
                    }
                }
                
            } catch (error) {
                console.error('检测存储状态失败:', error);
                if (infoDiv) {
                    infoDiv.innerHTML = '<span style="color: #dc3545;">检测失败: ' + error.message + '</span>';
                }
            }
        }
        
        // 【新增】重新启用 SQLite
        async function reEnableSQLite() {
            const infoDiv = document.getElementById('storageStatusInfo');
            if (infoDiv) {
                infoDiv.innerHTML = '<span style="color: #17a2b8;">正在重新启用 SQLite...</span>';
            }
            
            try {
                console.log('【重新启用SQLite】开始...');
                
                // 1. 清除禁用标记
                localStorage.removeItem('__sqlite_disabled');
                localStorage.removeItem('__sqlite_corrupted');
                localStorage.removeItem('__sqlite_force_reset');
                console.log('【重新启用SQLite】已清除禁用标记');
                
                // 2. 检查插件是否可用
                if (!window.Capacitor || !window.Capacitor.Plugins || !window.Capacitor.Plugins.CapacitorSQLite) {
                    throw new Error('SQLite插件不可用');
                }
                
                // 3. 设置 SQLite 为可用
                SQLiteManager.setAvailable(true);
                console.log('【重新启用SQLite】已设置SQLiteManager为可用');
                
                // 4. 初始化数据库
                let initResult;
                try {
                    initResult = await SQLiteManager.initDatabase();
                } catch (initError) {
                    console.error('【重新启用SQLite】初始化数据库出错:', initError);
                    alert('数据库初始化失败:\n' + initError.message + '\n\n详细错误:\n' + (initError.stack || '无堆栈信息'));
                    throw new Error('数据库初始化失败: ' + initError.message);
                }
                if (!initResult) {
                    alert('数据库初始化返回false，请检查控制台日志');
                    throw new Error('数据库初始化失败');
                }
                console.log('【重新启用SQLite】数据库初始化成功');
                
                // 5. 迁移数据（如果localforage中有数据）
                const chatList = relationshipData.wechatChatList || [];
                if (chatList.length > 0) {
                    console.log('【重新启用SQLite】开始迁移聊天列表...');
                    await SQLiteManager.saveChatList(chatList);
                }
                
                // 6. 尝试迁移消息
                if (ChatMessageManager && ChatMessageManager.db) {
                    try {
                        console.log('【重新启用SQLite】开始迁移消息...');
                        const db = await ChatMessageManager.db;
                        const transaction = db.transaction('chatMessages', 'readonly');
                        const store = transaction.objectStore('chatMessages');
                        const getAllRequest = store.getAll();
                        
                        const messages = await new Promise((resolve, reject) => {
                            getAllRequest.onsuccess = () => resolve(getAllRequest.result);
                            getAllRequest.onerror = () => reject(getAllRequest.error);
                        });
                        
                        if (messages.length > 0) {
                            console.log(`【重新启用SQLite】迁移 ${messages.length} 条消息...`);
                            await SQLiteManager.saveMessages(messages);
                        }
                    } catch (e) {
                        console.warn('【重新启用SQLite】迁移消息失败:', e);
                    }
                }
                
                showToast('SQLite 已重新启用！请刷新页面', 'success');
                if (infoDiv) {
                    infoDiv.innerHTML = `
                        <div style="background: #d4edda; padding: 10px; border-radius: 5px;">
                            <div style="font-weight: bold; color: #28a745; margin-bottom: 5px;">
                                ✅ SQLite 重新启用成功！
                            </div>
                            <div style="font-size: 11px; color: #666;">
                                数据已迁移到 SQLite<br>
                                请刷新页面以应用更改
                            </div>
                        </div>
                    `;
                }
                
                // 显示刷新提示
                setTimeout(() => {
                    if (confirm('SQLite 已重新启用！是否立即刷新页面？')) {
                        location.reload();
                    }
                }, 1500);
                
            } catch (error) {
                console.error('【重新启用SQLite】失败:', error);
                showToast('重新启用失败: ' + error.message, 'error');
                if (infoDiv) {
                    infoDiv.innerHTML = '<span style="color: #dc3545;">重新启用失败: ' + error.message + '</span>';
                }
            }
        }

        // 【新增】修复数据库（解决 [object Object] 等错误）
        async function repairDatabase() {
            if (!confirm('确定要修复数据库吗？\n\n这将自动备份数据、重置数据库并尝试恢复数据。\n修复后请刷新页面或重新启动应用。')) {
                return;
            }
            
            const infoDiv = document.getElementById('dbSizeInfo');
            if (infoDiv) {
                infoDiv.innerHTML = '<span style="color: #dc3545;">正在修复数据库，请稍候...</span>';
            }
            
            try {
                console.log('【数据库修复】开始修复流程...');
                
                // 【紧急修复】设置强制重置标记
                localStorage.setItem('__sqlite_force_reset', 'true');
                
                // 检查 SQLite 是否可用
                if (!SQLiteManager.isAvailable) {
                    showToast('SQLite 不可用，尝试强制重置...', 'warning');
                }
                
                // 立即强制删除数据库
                if (window.Capacitor && window.Capacitor.Plugins && window.Capacitor.Plugins.CapacitorSQLite) {
                    try {
                        const { CapacitorSQLite } = window.Capacitor.Plugins;
                        await CapacitorSQLite.deleteDatabase({ database: 'chat_messages.db' });
                        console.log('【数据库修复】已强制删除数据库');
                    } catch (e) {
                        console.log('【数据库修复】删除数据库失败（可能不存在）:', e.message);
                    }
                }
                
                // 重新初始化数据库
                SQLiteManager.setAvailable(true);
                const initResult = await SQLiteManager.initDatabase();
                
                if (initResult) {
                    console.log('【数据库修复】数据库重新初始化成功');
                    showToast('数据库已修复！请刷新页面', 'success');
                    if (infoDiv) {
                        infoDiv.innerHTML = `
                            <div style="background: #d4edda; padding: 10px; border-radius: 5px; margin-top: 5px;">
                                <div>✅ 数据库修复成功！</div>
                                <div style="font-size: 11px; color: #155724; margin-top: 5px;">
                                    数据库已完全重置<br>
                                    请立即刷新页面或重新启动应用
                                </div>
                            </div>
                        `;
                    }
                    
                    // 显示刷新提示
                    setTimeout(() => {
                        if (confirm('数据库已修复！是否立即刷新页面？')) {
                            location.reload();
                        }
                    }, 1500);
                } else {
                    throw new Error('数据库初始化失败');
                }
                
                return;
                
                if (resetResult) {
                    showToast('数据库修复成功！请刷新页面', 'success');
                    if (infoDiv) {
                        infoDiv.innerHTML = `
                            <div style="background: #d4edda; padding: 10px; border-radius: 5px; margin-top: 5px;">
                                <div>✅ 数据库修复成功！</div>
                                <div style="font-size: 11px; color: #155724; margin-top: 5px;">
                                    数据已自动备份并恢复<br>
                                    请刷新页面或重新启动应用以完成修复
                                </div>
                            </div>
                        `;
                    }
                    
                    // 显示刷新提示
                    setTimeout(() => {
                        if (confirm('数据库已修复！是否立即刷新页面？')) {
                            location.reload();
                        }
                    }, 1500);
                } else {
                    showToast('数据库修复失败，请查看控制台日志', 'error');
                    if (infoDiv) {
                        infoDiv.innerHTML = '<span style="color: #dc3545;">修复失败，请查看控制台日志获取详细信息</span>';
                    }
                }
            } catch (error) {
                console.error('【数据库修复】失败:', error);
                showToast('修复失败: ' + error.message, 'error');
                if (infoDiv) {
                    infoDiv.innerHTML = '<span style="color: #dc3545;">修复失败: ' + error.message + '</span>';
                }
            }
        }
        
        // 【新增】紧急禁用 SQLite（降级到 localforage）
        async function emergencyDisableSQLite() {
            if (!confirm('确定要紧急降级吗？\n\n这将完全禁用 SQLite，所有数据将保存到本地存储（localforage）。\n你的数据不会丢失，应用会继续正常工作。\n\n建议在降级前先导出备份。')) {
                return;
            }
            
            const infoDiv = document.getElementById('dbSizeInfo');
            if (infoDiv) {
                infoDiv.innerHTML = '<span style="color: #dc3545;">正在执行紧急降级...</span>';
            }
            
            try {
                console.log('【紧急降级】开始禁用 SQLite...');
                
                // 1. 先备份 SQLite 中的数据
                let backupData = null;
                if (SQLiteManager.isAvailable) {
                    try {
                        console.log('【紧急降级】正在备份 SQLite 数据...');
                        const chatList = await SQLiteManager.getChatList();
                        const allMessages = [];
                        
                        for (const chat of chatList) {
                            // 【修复】使用备份专用函数获取所有消息（包括不可见消息）
                            const messages = await SQLiteManager.getAllMessagesForBackup(chat.id);
                            if (messages) {
                                allMessages.push(...messages);
                            }
                        }
                        
                        backupData = {
                            chatList: chatList,
                            messages: allMessages,
                            settings: await SQLiteManager.getSetting('appSettings', null),
                            profile: await SQLiteManager.getPersonalProfile(),
                            worldBooks: await SQLiteManager.getWorldBooks(),
                            backupTime: new Date().toISOString()
                        };
                        
                        // 保存到 localforage
                        await localforage.setItem('__sqlite_emergency_backup', backupData);
                        console.log('【紧急降级】数据备份完成');
                    } catch (backupError) {
                        console.warn('【紧急降级】备份失败（继续禁用）:', backupError);
                    }
                }
                
                // 2. 强制禁用 SQLite
                SQLiteManager.isAvailable = false;
                localStorage.setItem('__sqlite_disabled', 'true');
                
                // 3. 尝试恢复数据到 localforage
                if (backupData) {
                    try {
                        console.log('【紧急降级】正在恢复数据到 localforage...');
                        
                        // 恢复聊天记录
                        if (backupData.messages && backupData.messages.length > 0) {
                            // 使用 ChatMessageManager 的降级存储（IndexedDB）
                            await ChatMessageManager.saveMessages(backupData.messages);
                            console.log('【紧急降级】已恢复', backupData.messages.length, '条消息');
                        }
                        
                        // 恢复设置
                        if (backupData.settings) {
                            await localforage.setItem('appSettings', backupData.settings);
                        }
                        
                        console.log('【紧急降级】数据恢复完成');
                    } catch (restoreError) {
                        console.error('【紧急降级】数据恢复失败:', restoreError);
                    }
                }
                
                showToast('SQLite 已禁用，应用将使用本地存储', 'success');
                if (infoDiv) {
                    infoDiv.innerHTML = `
                        <div style="background: #d4edda; padding: 10px; border-radius: 5px; margin-top: 5px;">
                            <div>✅ 紧急降级完成！</div>
                            <div style="font-size: 11px; color: #155724; margin-top: 5px;">
                                SQLite 已完全禁用<br>
                                所有数据将保存到本地存储<br>
                                请刷新页面以应用更改
                            </div>
                        </div>
                    `;
                }
                
                // 显示刷新提示
                setTimeout(() => {
                    if (confirm('降级完成！是否立即刷新页面？')) {
                        location.reload();
                    }
                }, 1500);
                
            } catch (error) {
                console.error('【紧急降级】失败:', error);
                showToast('降级失败: ' + error.message, 'error');
                if (infoDiv) {
                    infoDiv.innerHTML = '<span style="color: #dc3545;">降级失败: ' + error.message + '</span>';
                }
            }
        }

        // 【新增】检查数据库健康状态
        async function checkDatabaseHealth() {
            const infoDiv = document.getElementById('dbSizeInfo');
            if (infoDiv) {
                infoDiv.innerHTML = '<span style="color: #17a2b8;">正在检查数据库健康状态...</span>';
            }
            
            try {
                const health = {
                    sqlite: {
                        available: SQLiteManager.isAvailable,
                        status: 'unknown'
                    },
                    tables: {},
                    errors: []
                };
                
                if (!SQLiteManager.isAvailable) {
                    health.sqlite.status = 'unavailable';
                    health.errors.push('SQLite 不可用');
                } else {
                    // 检查各个表的状态
                    try {
                        const chatList = await SQLiteManager.getChatList();
                        health.tables.chatList = {
                            status: 'ok',
                            count: chatList.length
                        };
                    } catch (e) {
                        health.tables.chatList = { status: 'error', error: e.message };
                        health.errors.push('chat_list 表错误: ' + e.message);
                    }
                    
                    try {
                        const messages = await SQLiteManager.getMessages('test', 0, 1);
                        health.tables.messages = {
                            status: 'ok',
                            accessible: messages !== null
                        };
                    } catch (e) {
                        health.tables.messages = { status: 'error', error: e.message };
                        health.errors.push('messages 表错误: ' + e.message);
                    }
                    
                    try {
                        const settings = await SQLiteManager.getSetting('appSettings', null);
                        health.tables.settings = {
                            status: 'ok',
                            accessible: true
                        };
                    } catch (e) {
                        health.tables.settings = { status: 'error', error: e.message };
                        health.errors.push('settings 表错误: ' + e.message);
                    }
                    
                    if (health.errors.length === 0) {
                        health.sqlite.status = 'healthy';
                    } else {
                        health.sqlite.status = 'corrupted';
                    }
                }
                
                // 显示结果
                let statusColor = health.sqlite.status === 'healthy' ? '#28a745' : 
                                 health.sqlite.status === 'unavailable' ? '#ffc107' : '#dc3545';
                let statusText = health.sqlite.status === 'healthy' ? '健康' : 
                                health.sqlite.status === 'unavailable' ? '不可用' : '需要修复';
                
                if (infoDiv) {
                    infoDiv.innerHTML = `
                        <div style="background: ${health.sqlite.status === 'healthy' ? '#d4edda' : '#f8d7da'}; padding: 10px; border-radius: 5px; margin-top: 5px;">
                            <div style="color: ${statusColor}; font-weight: bold;">
                                ${health.sqlite.status === 'healthy' ? '✅' : '⚠️'} 数据库状态: ${statusText}
                            </div>
                            ${health.errors.length > 0 ? `
                                <div style="font-size: 11px; color: #721c24; margin-top: 5px;">
                                    <b>检测到的问题:</b><br>
                                    ${health.errors.map(e => '• ' + e).join('<br>')}
                                </div>
                            ` : `
                                <div style="font-size: 11px; color: #155724; margin-top: 5px;">
                                    所有表都正常工作
                                </div>
                            `}
                        </div>
                    `;
                }
                
                if (health.sqlite.status === 'healthy') {
                    showToast('数据库健康状态良好', 'success');
                } else {
                    showToast('数据库需要修复，请点击"修复数据库"按钮', 'warning');
                }
                
                console.log('【数据库健康检查】结果:', health);
                
            } catch (error) {
                console.error('检查数据库健康状态失败:', error);
                showToast('检查失败: ' + error.message, 'error');
                if (infoDiv) {
                    infoDiv.innerHTML = '<span style="color: #dc3545;">检查失败: ' + error.message + '</span>';
                }
            }
        }

        // 数据导出功能 - 包含所有图片数据
        async function exportData() {
            // 【防闪退】添加更完善的错误处理
            try {
                console.log('开始导出数据...');
                
                // 【防闪退】显示加载提示
                const loadingToast = document.createElement('div');
                loadingToast.style.cssText = 'position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);background:rgba(0,0,0,0.8);color:white;padding:20px;border-radius:10px;z-index:99999;font-size:16px;';
                loadingToast.textContent = '正在准备导出数据，请稍候...';
                document.body.appendChild(loadingToast);
                
                // 【防闪退】从IndexedDB加载所有图片数据，分批处理
                const imageData = {};
                const imageKeys = [
                    'avatar1', 'avatar2', 'cardBg', 'topCardBg', 'dynamicImage',
                    'leftBubbleAvatar', 'rightBubbleAvatar', 'mainBg'
                ];
                
                // 【防闪退】分批加载基本图片，每批处理后让出主线程
                for (let i = 0; i < imageKeys.length; i++) {
                    const key = imageKeys[i];
                    try {
                        const imgData = await loadImageFromDB(key);
                        if (imgData) {
                            imageData[key] = imgData;
                            console.log(`加载图片 ${key} 成功`);
                        }
                    } catch (err) {
                        console.warn(`加载图片 ${key} 失败:`, err);
                    }
                    
                    // 【防闪退】每处理3个图片后让出主线程，防止阻塞
                    if (i % 3 === 0) {
                        await new Promise(resolve => setTimeout(resolve, 0));
                    }
                }
                
                // 【防闪退】分批加载应用图标
                const appIconKeys = ['wechat', 'worldbook', 'note', 'study', 'couple', 
                                    'diary', 'theme', 'settings', 'accounting', 'footprint', 'health'];
                for (let i = 0; i < appIconKeys.length; i++) {
                    const app = appIconKeys[i];
                    try {
                        const iconData = await loadImageFromDB(`appIcon_${app}`);
                        if (iconData) {
                            if (!imageData.appIcons) imageData.appIcons = {};
                            imageData.appIcons[app] = iconData;
                            console.log(`加载应用图标 ${app} 成功`);
                        }
                    } catch (err) {
                        console.warn(`加载应用图标 ${app} 失败:`, err);
                    }
                }

                // 【防闪退】分批加载第二屏幕应用图标
                const screen2AppIconKeys = ['admin', 'body', 'postoffice', 'games', 
                                           'weibo', 'ball', 'library', 'luckgate'];
                for (let i = 0; i < screen2AppIconKeys.length; i++) {
                    const app = screen2AppIconKeys[i];
                    try {
                        const iconData = await loadImageFromDB(`appIcon_${app}`);
                        if (iconData) {
                            if (!imageData.appIcons) imageData.appIcons = {};
                            imageData.appIcons[app] = iconData;
                            console.log(`加载第二屏幕图标 ${app} 成功`);
                        }
                    } catch (err) {
                        console.warn(`加载第二屏幕图标 ${app} 失败:`, err);
                    }
                    
                    // 【防闪退】每处理3个图标后让出主线程
                    if (i % 3 === 0) {
                        await new Promise(resolve => setTimeout(resolve, 0));
                    }
                }
                
                // 【防闪退】分批加载微信聊天图片
                if (relationshipData.wechatChatList && relationshipData.wechatChatList.length > 0) {
                    imageData.chatImages = {};
                    for (let i = 0; i < relationshipData.wechatChatList.length; i++) {
                        const chat = relationshipData.wechatChatList[i];
                        if (chat.avatar) {
                            try {
                                const avatarData = await loadImageFromDB(chat.avatar);
                                if (avatarData) {
                                    imageData.chatImages[`chat_${chat.id}_avatar`] = avatarData;
                                }
                            } catch (err) {
                                console.warn(`加载聊天 ${chat.id} 头像失败:`, err);
                            }
                        }
                        if (chat.background) {
                            try {
                                const bgData = await loadImageFromDB(chat.background);
                                if (bgData) {
                                    imageData.chatImages[`chat_${chat.id}_bg`] = bgData;
                                }
                            } catch (err) {
                                console.warn(`加载聊天 ${chat.id} 背景失败:`, err);
                            }
                        }
                        
                        // 【防闪退】每处理2个聊天后让出主线程
                        if (i % 2 === 0) {
                            await new Promise(resolve => setTimeout(resolve, 0));
                        }
                    }
                }
                
                // 【防闪退】复制当前数据并替换图片引用，分批处理
                loadingToast.textContent = '正在处理数据...';
                
                // 【防闪退】询问用户是否使用轻量导出（不包含图片数据）
                const useLightExport = confirm('是否使用轻量导出模式？\n\n轻量导出：不包含图片数据，文件更小，导出更快\n完整导出：包含所有图片数据，文件较大\n\n点击"确定"使用轻量导出，点击"取消"使用完整导出');
                
                let exportData;
                try {
                    if (useLightExport) {
                        // 【轻量导出】只导出基本数据，不包含大图片
                        // 【修复】先深拷贝再清理，避免修改原始数据
                        exportData = JSON.parse(JSON.stringify({
                            ...relationshipData,
                            avatar1: null,
                            avatar2: null,
                            cardBg: null,
                            topCardBg: null,
                            dynamicImage: null,
                            leftBubbleAvatar: null,
                            rightBubbleAvatar: null,
                            mainBg: null
                        }));
                        
                        // 【修复】确保关键字段存在且有有效值
                        const ensureField = (obj, field, defaultValue) => {
                            if (obj[field] === undefined || obj[field] === null) {
                                obj[field] = defaultValue;
                            }
                        };
                        
                        // 修复 polaroid 相关字段
                        ensureField(exportData, 'polaroidText', '');
                        ensureField(exportData, 'polaroidRotation', null);
                        ensureField(exportData, 'polaroidImage', null);
                        ensureField(exportData, 'description', '');
                        
                        // 清理聊天列表中的大图片数据
                        if (exportData.wechatChatList) {
                            exportData.wechatChatList = exportData.wechatChatList.map(chat => ({
                                ...chat,
                                avatar: chat.avatar && chat.avatar.length > 1000 ? '[图片数据省略]' : chat.avatar,
                                background: chat.background && chat.background.length > 1000 ? '[图片数据省略]' : chat.background
                            }));
                        }
                        
                        // 【调试】检查消息数据
                        console.log('【轻量导出】消息总数:', exportData.chatMessages?.length || 0);
                        console.log('【轻量导出】第一条消息:', exportData.chatMessages?.[0]);
                        console.log('【轻量导出】最后一条消息:', exportData.chatMessages?.[exportData.chatMessages?.length - 1]);
                        console.log('【轻量导出】已清理大图片数据');
                    } else {
                        // 【完整导出】【重构】排除chatMessages，使用流式方式处理
                        loadingToast.textContent = '正在处理核心数据（完整导出）...';
                        await new Promise(resolve => setTimeout(resolve, 50));

                        // 【重构】创建不包含chatMessages的数据副本
                        const { chatMessages, ...dataWithoutMessages } = relationshipData;

                        // 【修复】先预处理数据，确保所有字段都有有效值
                        const preprocessedData = JSON.parse(JSON.stringify(dataWithoutMessages, (key, value) => {
                            // 【修复】处理undefined - 必须返回null，不能返回undefined
                            if (value === undefined) {
                                return null;
                            }
                            // 处理函数
                            if (typeof value === 'function') {
                                return null;
                            }
                            // 处理Symbol
                            if (typeof value === 'symbol') {
                                return null;
                            }
                            // 处理Infinity和NaN
                            if (typeof value === 'number' && (!isFinite(value) || isNaN(value))) {
                                return null;
                            }
                            // 【修复】处理字符串中的特殊控制字符
                            if (typeof value === 'string') {
                                // 移除控制字符（保留换行符、制表符等常用字符）
                                return value.replace(/[\x00-\x08\x0B\x0C\x0E-\x1F\x7F-\x9F]/g, '');
                            }
                            return value;
                        }));

                        // 【修复】确保关键字段存在且有有效值，避免JSON格式错误
                        const ensureField = (obj, field, defaultValue) => {
                            if (obj[field] === undefined || obj[field] === null) {
                                obj[field] = defaultValue;
                            }
                        };

                        // 修复 polaroid 相关字段
                        ensureField(preprocessedData, 'polaroidText', '');
                        ensureField(preprocessedData, 'polaroidRotation', null);
                        ensureField(preprocessedData, 'polaroidImage', null);

                        // 修复其他可能缺失的字段
                        ensureField(preprocessedData, 'description', '');

                        // 【重构】标记有消息数据，但不包含在exportData中
                        preprocessedData._hasMessages = true;

                        exportData = preprocessedData;
                        console.log('【完整导出】核心数据处理完成，chatMessages将流式处理');
                    }
                } catch (e) {
                    console.error('【防闪退】复制数据失败:', e);
                    throw new Error('数据复制失败，可能是数据过大，请尝试使用轻量导出');
                }
                
                // 【防闪退】替换基本图片引用
                for (const [key, imgData] of Object.entries(imageData)) {
                    if (key !== 'appIcons' && key !== 'chatImages' && exportData[key]) {
                        exportData[key] = imgData;
                    }
                }
                
                // 【防闪退】替换应用图标
                if (imageData.appIcons) {
                    for (const [app, iconData] of Object.entries(imageData.appIcons)) {
                        if (exportData.theme && exportData.theme.appIcons) {
                            exportData.theme.appIcons[app] = iconData;
                        }
                    }
                }
                
                // 【防闪退】替换聊天图片
                if (imageData.chatImages) {
                    for (const chat of exportData.wechatChatList) {
                        if (imageData.chatImages[`chat_${chat.id}_avatar`]) {
                            chat.avatar = imageData.chatImages[`chat_${chat.id}_avatar`];
                        }
                        if (imageData.chatImages[`chat_${chat.id}_bg`]) {
                            chat.background = imageData.chatImages[`chat_${chat.id}_bg`];
                        }
                    }
                }
                
                // 【防闪退】分批加载其他独立存储的数据
                loadingToast.textContent = '正在加载其他数据...';
                console.log('加载其他数据...');
                
                const otherData = {};
                
                // 【防闪退】分批加载，每批之间让出主线程
                try {
                    // 【修复】加载角色日记数据
                    otherData.diaryData = await loadDiaryDataUnified([]);
                    await new Promise(resolve => setTimeout(resolve, 0));
                    
                    otherData.diaryCoverSettings = await loadDiaryCoverSettingsUnified({});
                    await new Promise(resolve => setTimeout(resolve, 0));
                    
                    // 【修复】加载"我的日记"数据（simpleDiaryData_v1）
                    otherData.myDiaryData = await loadMyDiaryContentsUnified({});
                    await new Promise(resolve => setTimeout(resolve, 0));
                    
                    otherData.memo_houseRules = await loadMemoDataUnified('memo_houseRules') || [];
                    await new Promise(resolve => setTimeout(resolve, 0));
                    
                    otherData.memo_bg = await loadMemoDataUnified('memo_bg') || null;
                    otherData.memo_bg_image = await loadMemoDataUnified('memo_bg_image') || null;
                    otherData.memo_media = await loadMemoDataUnified('memo_media') || null;
                    otherData.memo_media_type = await loadMemoDataUnified('memo_media_type') || 'image';
                    await new Promise(resolve => setTimeout(resolve, 0));
                    
                    otherData.memo_violations = await loadMemoDataUnified('memo_violations') || [];
                    otherData.memo_todayMemos = await loadMemoDataUnified('memo_todayMemos') || [];
                    otherData.memo_lastDate = await loadMemoDataUnified('memo_lastDate') || null;
                    otherData.memo_guardian = await loadMemoDataUnified('memo_guardian') || null;
                    await new Promise(resolve => setTimeout(resolve, 0));
                    
                    otherData.periodData = await loadHealthDataUnified('periodData') || null;
                    otherData.waterData = await loadHealthDataUnified('waterData') || null;
                    otherData.sleepData = await loadHealthDataUnified('sleepData') || null;
                    otherData.diseaseData = await loadHealthDataUnified('diseaseData') || null;
                    await new Promise(resolve => setTimeout(resolve, 0));
                    
                    // 【修复】使用 SQLite 优先的方式读取数据
                    otherData.callRecords = await SQLiteManager.getCallRecordsForChat('default') || {};
                    otherData.personalProfile = await SQLiteManager.getPersonalProfile() || {};
                    otherData.useLocalServer = await loadApiSettingUnified('useLocalServer') || false;
                    
                    // 导出恶魔测验数据
                    otherData.demonQuizzes = await loadDemonQuizzesUnified([]);
                    otherData.demonQuizData = await loadDemonQuizStateUnified('demonQuizData');
                    
                    console.log('【导出】日记数据加载完成:', {
                        diaryData: otherData.diaryData.length,
                        myDiaryData: Object.keys(otherData.myDiaryData).length
                    });
                } catch (e) {
                    console.error('【防闪退】加载其他数据失败:', e);
                }
                
                // 【防闪退】对于大数据量，跳过消息导出，使用单独的消息导出功能
                loadingToast.textContent = '正在检查数据大小...';
                
                // 先估算消息数据大小
                let totalMessageCount = 0;
                let skipMessages = false;
                
                try {
                    if (SQLiteManager.isAvailable) {
                        const dbSize = await SQLiteManager.getDatabaseSize();
                        if (dbSize && dbSize.messageCount > 10000) {
                            console.log(`【导出】消息数量 ${dbSize.messageCount} 较多，使用安全导出模式`);
                            skipMessages = true;
                        }
                        totalMessageCount = dbSize?.messageCount || 0;
                    } else {
                        // 检查 IndexedDB
                        const db = await openDB();
                        const transaction = db.transaction('chatMessages', 'readonly');
                        const store = transaction.objectStore('chatMessages');
                        const count = await new Promise((resolve, reject) => {
                            const request = store.count();
                            request.onsuccess = () => resolve(request.result);
                            request.onerror = () => reject(request.error);
                        });
                        totalMessageCount = count;
                        if (count > 10000) {
                            console.log(`【导出】消息数量 ${count} 较多，使用安全导出模式`);
                            skipMessages = true;
                        }
                    }
                } catch (e) {
                    console.warn('【导出】无法估算消息数量:', e);
                }
                
                // 【关键修复】如果消息太多，询问用户是否跳过消息导出
                if (skipMessages) {
                    const userChoice = confirm(
                        `检测到 ${totalMessageCount} 条消息，数据量较大。\n\n` +
                        `选择导出方式：\n` +
                        `• 点击"确定"：导出完整数据（包含所有消息），但可能需要几分钟且可能闪退\n` +
                        `• 点击"取消"：导出安全版本（不包含消息），消息可单独导出\n\n` +
                        `建议：先导出安全版本，再使用"导出聊天记录"功能单独导出消息。`
                    );
                    
                    if (!userChoice) {
                        skipMessages = true;
                        console.log('【导出】用户选择跳过消息导出');
                    } else {
                        skipMessages = false;
                        console.log('【导出】用户选择完整导出，尝试分批处理');
                    }
                }
                
                // 【防闪退】加载聊天消息（分批处理，避免内存溢出）
                const chatMessagesData = {};
                
                if (!skipMessages) {
                    loadingToast.textContent = '正在加载聊天消息...';
                    
                    try {
                        if (relationshipData.wechatChatList && relationshipData.wechatChatList.length > 0) {
                            for (let i = 0; i < relationshipData.wechatChatList.length; i++) {
                                const chat = relationshipData.wechatChatList[i];
                                const chatId = chat.id;
                                
                                // 【优化】分批获取消息，每批1000条
                                let offset = 0;
                                const batchSize = 1000;
                                let allMessages = [];
                                
                                while (true) {
                                    const messages = await ChatMessageManager.getMessages(chatId, offset, batchSize);
                                    if (!messages || messages.length === 0) break;
                                    
                                    allMessages = allMessages.concat(messages);
                                    offset += messages.length;
                                    
                                    // 如果已经获取了超过5000条，停止获取（防止内存溢出）
                                    if (allMessages.length > 5000) {
                                        console.warn(`【导出】聊天 ${chatId} 消息过多，只导出前5000条`);
                                        break;
                                    }
                                    
                                    // 让出主线程
                                    await new Promise(resolve => setTimeout(resolve, 0));
                                }
                                
                                if (allMessages.length > 0) {
                                    chatMessagesData[chatId] = allMessages;
                                    console.log(`【导出】聊天 ${chatId} 加载了 ${allMessages.length} 条消息`);
                                }
                                
                                // 【防闪退】每处理1个聊天让出主线程
                                await new Promise(resolve => setTimeout(resolve, 10));
                                
                                // 更新进度
                                if (i % 2 === 0) {
                                    loadingToast.textContent = `正在加载聊天消息 (${i + 1}/${relationshipData.wechatChatList.length})...`;
                                }
                            }
                        }
                        
                        console.log('【导出】聊天消息加载完成，共', Object.keys(chatMessagesData).length, '个聊天');
                    } catch (e) {
                        console.error('【防闪退】加载聊天消息失败:', e);
                        showToast('消息加载失败，将导出不含消息的版本', 'warning');
                    }
                } else {
                    // 跳过消息导出，添加提示信息
                    exportData._messageExportSkipped = true;
                    exportData._messageCount = totalMessageCount;
                    console.log('【导出】跳过消息导出，将在导出文件中添加提示');
                }
                
                // 【防闪退】准备最终导出数据
                loadingToast.textContent = '正在生成导出文件...';
                
                const data = {
                    relationshipData: exportData,
                    settings: await loadAppSettings({}),
                    presets: await loadApiSettingUnified('apiPresets') || [],
                    models: await loadApiSettingUnified('apiModels') || [],
                    images: imageData,
                    otherData: otherData,
                    chatMessages: skipMessages ? {} : chatMessagesData, // 【修复】如果跳过则返回空对象
                    _exportInfo: {
                        skippedMessages: skipMessages,
                        totalMessageCount: totalMessageCount,
                        exportedAt: new Date().toISOString()
                    },
                    timestamp: Date.now()
                };
                
                console.log('数据准备完成，开始生成文件...');
                
                // 【优化】检查数据大小，如果过大则给出警告
                let dataStr;
                
                try {
                    loadingToast.textContent = '正在序列化数据，请耐心等待...';
                    
                    // 【优化】使用更健壮的replacer函数处理各种特殊值
                    dataStr = JSON.stringify(data, (key, value) => {
                        // 处理undefined
                        if (value === undefined) {
                            return null;
                        }
                        // 处理函数
                        if (typeof value === 'function') {
                            return null;
                        }
                        // 处理Symbol
                        if (typeof value === 'symbol') {
                            return null;
                        }
                        // 处理Infinity和NaN
                        if (typeof value === 'number' && (!isFinite(value) || isNaN(value))) {
                            return null;
                        }
                        // 处理循环引用（简单的循环引用检测）
                        if (value !== null && typeof value === 'object') {
                            // 如果对象有特殊的toJSON方法，使用它
                            if (value.toJSON && typeof value.toJSON === 'function') {
                                return value.toJSON();
                            }
                        }
                        return value;
                    });
                    
                    console.log('【导出】数据序列化完成');
                } catch (e) {
                    console.error('【防闪退】JSON序列化失败:', e);
                    throw new Error('数据序列化失败: ' + e.message);
                }
                
                const dataSizeMB = (dataStr.length / 1024 / 1024).toFixed(2);
                console.log('数据大小:', dataSizeMB, 'MB');
                
                // 【优化】如果数据超过100MB，提示用户但允许继续
                if (parseFloat(dataSizeMB) > 100) {
                    const shouldContinue = confirm(`数据大小为 ${dataSizeMB} MB，比较大，导出可能需要一些时间。\n\n请确保：\n1. 手机电量充足（建议50%以上）\n2. 不要切换应用或锁屏\n3. 耐心等待导出完成（可能需要几分钟）\n\n是否继续导出？`);
                    if (!shouldContinue) {
                        document.body.removeChild(loadingToast);
                        return;
                    }
                }
                
                const fileName = `relationship-backup-${new Date().toISOString().split('T')[0]}.json`;
                const dataSizeKB = (dataStr.length / 1024).toFixed(2);
                
                // 移除加载提示
                document.body.removeChild(loadingToast);

                // 检查是否在Capacitor环境中
                const isCapacitor = window.Capacitor && window.Capacitor.isNativePlatform();

                // 【新功能】统一导出方式选择（支持二维码/下载链接）
                const exportChoice = prompt(
                    `数据已准备好！\n\n文件名: ${fileName}\n大小: ${dataSizeKB} KB\n\n请选择导出方式：\n\n1 - 系统分享（微信、QQ等）\n2 - 生成二维码/下载链接 ⭐推荐\n3 - 复制到剪贴板\n4 - 浏览器下载\n\n请输入数字 (1-4):`,
                    '2'
                );

                if (exportChoice === '1') {
                    // 系统分享
                    if (isCapacitor) {
                        try {
                            const { Share } = window.Capacitor.Plugins;
                            const { Filesystem } = window.Capacitor.Plugins;

                            // 【关键修复】保存到公共下载目录，用户可以在文件管理器中访问
                            const blob = new Blob([dataStr], { type: 'application/json' });
                            const reader = new FileReader();
                            reader.readAsDataURL(blob);

                            let fileUri;
                            let savedToDownload = false;
                            await new Promise((resolve, reject) => {
                                reader.onload = async () => {
                                    try {
                                        const base64Data = reader.result.split(',')[1];
                                        
                                        // 尝试保存到 Downloads 目录（Android 10+ 需要权限）
                                        try {
                                            await Filesystem.writeFile({
                                                path: `Download/守护备份/${fileName}`,
                                                data: base64Data,
                                                directory: 'External',
                                                encoding: 'base64',
                                                recursive: true
                                            });
                                            fileUri = await Filesystem.getUri({ 
                                                path: `Download/守护备份/${fileName}`, 
                                                directory: 'External' 
                                            });
                                            savedToDownload = true;
                                            console.log('【导出】文件已保存到下载目录:', fileUri.uri);
                                        } catch (downloadErr) {
                                            console.warn('【导出】保存到下载目录失败，尝试Cache目录:', downloadErr);
                                            // 降级到 Cache 目录
                                            await Filesystem.writeFile({
                                                path: fileName,
                                                data: base64Data,
                                                directory: 'Cache',
                                                encoding: 'base64'
                                            });
                                            fileUri = await Filesystem.getUri({ 
                                                path: fileName, 
                                                directory: 'Cache' 
                                            });
                                        }
                                        resolve();
                                    } catch (err) {
                                        reject(err);
                                    }
                                };
                                reader.onerror = reject;
                            });

                            // 分享文件
                            await Share.share({
                                title: '守护应用数据备份',
                                text: `数据备份 - ${new Date().toLocaleDateString()}`,
                                url: fileUri.uri,
                                dialogTitle: '分享数据备份'
                            });
                            
                            if (savedToDownload) {
                                showToast('✅ 导出成功！文件已保存到手机存储/Download/守护备份/');
                            } else {
                                showToast('分享成功！');
                            }
                        } catch (err) {
                            console.error('分享失败:', err);
                            alert('分享失败，请尝试其他方式');
                        }
                    } else {
                        alert('浏览器环境不支持系统分享，请使用二维码或下载方式');
                    }
                } else if (exportChoice === '2') {
                    // ⭐ 生成二维码/下载链接
                    await showQRCodeAndDownloadLink(dataStr, fileName, dataSizeKB);
                } else if (exportChoice === '3') {
                    // 复制到剪贴板
                    await copyToClipboard(dataStr);
                    showToast('✅ 数据已复制到剪贴板！');
                } else if (exportChoice === '4') {
                    // 浏览器下载
                    await downloadFile(dataStr, fileName);
                }
                
            } catch (error) {
                console.error('导出数据失败:', error);
                alert('导出数据失败: ' + (error.message || '未知错误'));
                
                // 【防闪退】确保移除加载提示
                const loadingToast = document.querySelector('div[style*="z-index:99999"]');
                if (loadingToast && loadingToast.parentNode) {
                    loadingToast.parentNode.removeChild(loadingToast);
                }
            }
        }
        
        // 备用导出方案（浏览器或插件失败时使用）
        async function showBackupExport(dataStr, fileName, dataSizeKB) {
            const choice = await showExportOptions(dataStr, fileName, dataSizeKB);
            
            if (choice === 'copy') {
                await copyToClipboard(dataStr);
                alert('数据已复制到剪贴板！\n\n请粘贴到文本编辑器并保存为 .json 文件');
            } else if (choice === 'download') {
                await downloadFile(dataStr, fileName);
            }
        }
        
        // 显示导出选项
        function showExportOptions(dataStr, fileName, dataSizeKB) {
            return new Promise((resolve) => {
                const message = `数据导出成功！\n\n数据大小: ${dataSizeKB} KB\n\n请选择导出方式：\n\n1. 复制到剪贴板（推荐）\n2. 尝试下载文件`;
                
                if (confirm(message)) {
                    resolve('copy');
                } else {
                    resolve('download');
                }
            });
        }
        
        // 复制到剪贴板
        async function copyToClipboard(text) {
            try {
                if (navigator.clipboard && navigator.clipboard.writeText) {
                    await navigator.clipboard.writeText(text);
                } else {
                    // 降级方案
                    const textarea = document.createElement('textarea');
                    textarea.value = text;
                    textarea.style.position = 'absolute';
                    textarea.style.left = '-9999px';
                    document.body.appendChild(textarea);
                    textarea.select();
                    document.execCommand('copy');
                    document.body.removeChild(textarea);
                }
            } catch (err) {
                console.error('复制到剪贴板失败:', err);
                throw err;
            }
        }

        // 【新功能】生成下载页面（在当前页面直接下载）
        async function showQRCodeAndDownloadLink(dataStr, fileName, dataSizeKB) {
            try {
                // 创建弹窗容器
                const modal = document.createElement('div');
                modal.style.cssText = `
                    position: fixed;
                    top: 0;
                    left: 0;
                    width: 100%;
                    height: 100%;
                    background: rgba(0,0,0,0.8);
                    z-index: 100000;
                    display: flex;
                    flex-direction: column;
                    align-items: center;
                    justify-content: center;
                    padding: 20px;
                    box-sizing: border-box;
                `;

                // 创建内容容器
                const content = document.createElement('div');
                content.style.cssText = `
                    background: white;
                    border-radius: 16px;
                    padding: 24px;
                    max-width: 90%;
                    max-height: 90%;
                    overflow-y: auto;
                    text-align: center;
                `;

                // 添加标题
                const title = document.createElement('h2');
                title.textContent = '📦 数据导出成功';
                title.style.cssText = 'margin: 0 0 16px 0; color: #333; font-size: 20px;';
                content.appendChild(title);

                // 添加文件信息
                const info = document.createElement('div');
                info.style.cssText = 'background: #f0f0f0; padding: 12px; border-radius: 8px; margin-bottom: 20px; font-size: 14px; color: #666;';
                info.innerHTML = `<strong>文件名:</strong> ${fileName}<br><strong>大小:</strong> ${dataSizeKB} KB`;
                content.appendChild(info);

                // 添加直接下载按钮
                const downloadBtn = document.createElement('button');
                downloadBtn.textContent = '⬇️ 直接下载文件';
                downloadBtn.style.cssText = `
                    display: block;
                    width: 100%;
                    background: #667eea;
                    color: white;
                    padding: 16px 24px;
                    border-radius: 8px;
                    border: none;
                    font-size: 16px;
                    margin-bottom: 12px;
                    font-weight: bold;
                    cursor: pointer;
                `;
                downloadBtn.onclick = () => {
                    // 创建 Blob 并下载
                    const blob = new Blob([dataStr], { type: 'application/json' });
                    const url = URL.createObjectURL(blob);
                    const a = document.createElement('a');
                    a.href = url;
                    a.download = fileName;
                    document.body.appendChild(a);
                    a.click();
                    document.body.removeChild(a);
                    URL.revokeObjectURL(url);

                    showToast('✅ 下载已开始！');
                };
                content.appendChild(downloadBtn);

                // 添加说明
                const instructions = document.createElement('div');
                instructions.style.cssText = 'text-align: left; background: #f8f9fa; padding: 16px; border-radius: 8px; margin-bottom: 16px; font-size: 13px; color: #555;';
                instructions.innerHTML = `
                    <strong>💡 下载说明：</strong><br><br>
                    1. <strong>点击下载：</strong>点击上方蓝色按钮直接下载<br>
                    2. <strong>保存位置：</strong>文件会保存到手机的"下载"文件夹<br>
                    3. <strong>查找文件：</strong>使用文件管理器找到下载的文件<br>
                    4. <strong>备份建议：</strong>将文件复制到云盘或电脑保存
                `;
                content.appendChild(instructions);

                // 添加提示
                const tip = document.createElement('div');
                tip.style.cssText = 'background: #fff3cd; border: 1px solid #ffeaa7; padding: 12px; border-radius: 8px; margin-bottom: 16px; font-size: 12px; color: #856404;';
                tip.innerHTML = '⚠️ <strong>提示：</strong>如果下载失败，请尝试使用"系统分享"或"复制到剪贴板"方式';
                content.appendChild(tip);

                // 添加关闭按钮
                const closeBtn = document.createElement('button');
                closeBtn.textContent = '关闭';
                closeBtn.style.cssText = `
                    background: #dc3545;
                    color: white;
                    padding: 12px 32px;
                    border-radius: 8px;
                    border: none;
                    font-size: 16px;
                    cursor: pointer;
                `;
                closeBtn.onclick = () => {
                    document.body.removeChild(modal);
                };
                content.appendChild(closeBtn);

                modal.appendChild(content);
                document.body.appendChild(modal);

            } catch (err) {
                console.error('生成下载页面失败:', err);
                alert('生成下载页面失败，请使用其他导出方式');
            }
        }

        // 使用插件导出数据（新功能 - 使用分块写入避免OOM）
        async function exportWithPlugin() {
            // 【防闪退】显示加载提示
            const loadingToast = document.createElement('div');
            loadingToast.style.cssText = 'position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);background:rgba(0,0,0,0.8);color:white;padding:20px;border-radius:10px;z-index:99999;font-size:16px;';
            loadingToast.textContent = '正在准备简化导出，请稍候...';
            document.body.appendChild(loadingToast);
            
            // 【调试】记录开始时间和内存状态
            const startTime = Date.now();
            console.log('【导出调试】开始导出，时间:', new Date().toISOString());
            
            try {
                console.log('开始使用插件导出数据...');
                
                const { Filesystem } = window.Capacitor.Plugins;
                const { Share } = window.Capacitor.Plugins;
                
                if (!Filesystem || !Share) {
                    document.body.removeChild(loadingToast);
                    alert('Filesystem或Share插件未安装');
                    return;
                }
                
                // 【调试】检查数据量
                console.log('【导出调试】聊天列表数量:', relationshipData.wechatChatList?.length || 0);
                console.log('【导出调试】消息总数:', relationshipData.chatMessages?.length || 0);
                
                const fileName = `relationship-backup-${new Date().toISOString().split('T')[0]}.json`;
                console.log('准备导出到文件:', fileName);
                
                let totalBytesWritten = 0;
                
                // 【防闪退】分批构建 relationshipData，避免深拷贝
                loadingToast.textContent = '正在处理数据（第1/5步）...';
                await new Promise(resolve => setTimeout(resolve, 100));
                
                // 构建基础数据对象（不包含大字段）
                // 【修复】添加所有必要字段，避免数据丢失
                const baseData = {
                    title: relationshipData.title,
                    startDate: relationshipData.startDate,
                    description: relationshipData.description,
                    mood: relationshipData.mood,
                    selectedCharacterId: relationshipData.selectedCharacterId,
                    characterRelationships: relationshipData.characterRelationships,
                    coupleSpaceEnabled: relationshipData.coupleSpaceEnabled,
                    couplePartnerId: relationshipData.couplePartnerId,
                    coupleStartDate: relationshipData.coupleStartDate,
                    couplePartnerName: relationshipData.couplePartnerName,
                    coupleAvatars: { top: '', left: '', right: '' }, // 清空头像
                    coupleCarouselVisible: relationshipData.coupleCarouselVisible,
                    coupleHeaderColor: relationshipData.coupleHeaderColor,
                    coupleFooterColor: relationshipData.coupleFooterColor,
                    coupleHeaderTextStroke: relationshipData.coupleHeaderTextStroke,
                    footprintTextColor: relationshipData.footprintTextColor,
                    blackroomTextColor: relationshipData.blackroomTextColor,
                    coupleWallBackground: '', // 清空大图片
                    coupleCardBackground: '', // 清空大图片
                    coupleCardHeaderBg: relationshipData.coupleCardHeaderBg,
                    coupleCardHeaderStroke: relationshipData.coupleCardHeaderStroke,
                    coupleCardFooterBg: relationshipData.coupleCardFooterBg,
                    coupleActivityLogs: relationshipData.coupleActivityLogs || [],
                    theme: relationshipData.theme ? {
                        ...relationshipData.theme,
                        mainBg: '', // 清空壁纸背景
                        appIcons: {} // 清空图标
                    } : {},
                    // 清空大图片字段
                    avatar1: null,
                    avatar2: null,
                    cardBg: null,
                    topCardBg: null,
                    dynamicImage: null,
                    leftBubbleAvatar: null,
                    rightBubbleAvatar: null,
                    mainBg: null,
                    leftBubbleText: relationshipData.leftBubbleText || '',
                    rightBubbleText: relationshipData.rightBubbleText || '',
                    polaroidImage: null,
                    polaroidText: relationshipData.polaroidText || '',
                    polaroidRotation: relationshipData.polaroidRotation || null,
                    // 【修复】添加遗漏的重要数据字段
                    worldBooks: relationshipData.worldBooks || [],
                    mountedWorldBooks: relationshipData.mountedWorldBooks || [],
                    innerThoughts: relationshipData.innerThoughts || {},
                    npcList: relationshipData.npcList || [],
                    moments: relationshipData.moments || [],
                    momentsCover: '', // 清空大图片
                    // 【关键修复】不再导出输入框内容
                    // wechatInputText: relationshipData.wechatInputText || ''
                    wechatInputText: ''
                };
                
                // 【防闪退】分批处理 wechatChatList
                loadingToast.textContent = '正在处理聊天列表（第2/5步）...';
                await new Promise(resolve => setTimeout(resolve, 100));
                
                baseData.wechatChatList = relationshipData.wechatChatList.map(chat => ({
                    ...chat,
                    avatar: null, // 清空头像
                    background: null, // 清空背景
                    memories: chat.memories || [] // 保留记忆
                }));
                
                // 【调试】验证数据完整性
                console.log('【简化导出】数据完整性检查:');
                console.log('  - 聊天列表数量:', baseData.wechatChatList.length);
                console.log('  - 世界书数量:', baseData.worldBooks?.length || 0);
                console.log('  - 挂载世界书数量:', baseData.mountedWorldBooks?.length || 0);
                console.log('  - 心声数量:', Object.keys(baseData.innerThoughts || {}).length);
                console.log('  - NPC数量:', baseData.npcList?.length || 0);
                console.log('  - 朋友圈数量:', baseData.moments?.length || 0);
                
                // 【重构】流式处理消息，不占用大量内存
                loadingToast.textContent = '正在准备导出消息（第3/5步）...';
                await new Promise(resolve => setTimeout(resolve, 100));

                // 【重构】先统计总消息数，不加载到内存
                let totalMessages = 0;
                const chatMessageCounts = [];
                try {
                    for (const chat of relationshipData.wechatChatList) {
                        const count = await ChatMessageManager.getMessageCount(chat.id);
                        totalMessages += count;
                        chatMessageCounts.push({ chatId: chat.id, count });
                    }
                    console.log(`【重构】统计到${totalMessages}条消息用于导出`);
                } catch (error) {
                    console.error('【重构】统计消息失败:', error);
                    totalMessages = relationshipData.chatMessages.length;
                }

                // 【重构】在baseData中标记有消息，但不存储实际数据
                baseData._hasMessages = totalMessages > 0;
                baseData._totalMessageCount = totalMessages;
                
                // 开始写入文件
                loadingToast.textContent = '正在写入文件（第4/5步）...';
                await new Promise(resolve => setTimeout(resolve, 50));
                
                await Filesystem.writeFile({
                    path: fileName,
                    data: '{',
                    directory: 'Cache',
                    encoding: 'utf8'
                });
                totalBytesWritten += 1;
                
                // 【防闪退】分批写入 relationshipData，避免一次性序列化大数据
                loadingToast.textContent = '正在写入核心数据...';
                await new Promise(resolve => setTimeout(resolve, 50));
                
                await Filesystem.appendFile({
                    path: fileName,
                    data: '"relationshipData":{',
                    directory: 'Cache',
                    encoding: 'utf8'
                });
                totalBytesWritten += 19;
                
                // 分批写入 baseData 的各个字段
                const baseDataKeys = Object.keys(baseData).filter(k => k !== 'chatMessages' && k !== 'wechatChatList');
                for (let i = 0; i < baseDataKeys.length; i++) {
                    const key = baseDataKeys[i];
                    const value = baseData[key];
                    const isLast = i === baseDataKeys.length - 1 && !baseData.chatMessages && !baseData.wechatChatList;
                    
                    try {
                        // 【修复】使用replacer函数处理undefined值
                        const valueStr = JSON.stringify(value, (k, v) => v === undefined ? null : v);
                        await Filesystem.appendFile({
                            path: fileName,
                            data: `"${key}":${valueStr}${isLast ? '' : ','}`,
                            directory: 'Cache',
                            encoding: 'utf8'
                        });
                        totalBytesWritten += key.length + 3 + valueStr.length + (isLast ? 0 : 1);
                    } catch (e) {
                        console.warn(`导出 ${key} 失败:`, e);
                        await Filesystem.appendFile({
                            path: fileName,
                            data: `"${key}":null${isLast ? '' : ','}`,
                            directory: 'Cache',
                            encoding: 'utf8'
                        });
                    }
                    
                    if (i % 5 === 0) {
                        await new Promise(resolve => setTimeout(resolve, 10));
                    }
                }
                
                // 分批写入 wechatChatList
                if (baseData.wechatChatList && baseData.wechatChatList.length > 0) {
                    loadingToast.textContent = `正在写入聊天列表 (${baseData.wechatChatList.length})...`;
                    await new Promise(resolve => setTimeout(resolve, 30));
                    
                    await Filesystem.appendFile({
                        path: fileName,
                        data: ',"wechatChatList":[',
                        directory: 'Cache',
                        encoding: 'utf8'
                    });
                    totalBytesWritten += 18;
                    
                    for (let i = 0; i < baseData.wechatChatList.length; i++) {
                        const chat = baseData.wechatChatList[i];
                        const isLast = i === baseData.wechatChatList.length - 1;
                        // 【修复】使用replacer函数处理undefined值
                        const chatStr = JSON.stringify(chat, (k, v) => v === undefined ? null : v);
                        
                        await Filesystem.appendFile({
                            path: fileName,
                            data: chatStr + (isLast ? '' : ','),
                            directory: 'Cache',
                            encoding: 'utf8'
                        });
                        totalBytesWritten += chatStr.length + (isLast ? 0 : 1);
                        
                        if (i % 50 === 0 && i > 0) {
                            loadingToast.textContent = `正在写入聊天列表... ${i}/${baseData.wechatChatList.length}`;
                            await new Promise(resolve => setTimeout(resolve, 10));
                        }
                    }
                    
                    await Filesystem.appendFile({
                        path: fileName,
                        data: ']',
                        directory: 'Cache',
                        encoding: 'utf8'
                    });
                    totalBytesWritten += 1;
                }
                
                // 【防闪退优化】分批写入 chatMessages，合并多条消息后一次性写入
                // 【关键修复】使用 totalMessages 而不是 baseData.chatMessages 来判断是否有消息
                if (totalMessages > 0) {
                    loadingToast.textContent = `正在写入消息记录 (${totalMessages})...`;
                    await new Promise(resolve => setTimeout(resolve, 30));
                    
                    await Filesystem.appendFile({
                        path: fileName,
                        data: ',"chatMessages":[',
                        directory: 'Cache',
                        encoding: 'utf8'
                    });
                    totalBytesWritten += 17;
                    
                    // 【重构】直接从IndexedDB流式读取并写入，不占用内存
                    const MSG_BATCH = 100; // 每批处理100条
                    let processedCount = 0;
                    let isFirstMessage = true;

                    for (const { chatId, count } of chatMessageCounts) {
                        if (count === 0) continue;

                        // 分页获取消息
                        for (let offset = 0; offset < count; offset += MSG_BATCH) {
                            const limit = Math.min(MSG_BATCH, count - offset);
                            const messages = await ChatMessageManager.getMessages(chatId, offset, limit);

                            // 【修复】确保 messages 是数组
                            if (!messages || !Array.isArray(messages)) {
                                console.warn(`【简化导出】获取消息失败，跳过 chatId=${chatId}, offset=${offset}`);
                                continue;
                            }

                            // 处理并写入这批消息
                            let batchData = '';
                            for (let j = 0; j < messages.length; j++) {
                                const msg = messages[j];
                                const isLast = processedCount + j + 1 >= totalMessages;

                                // 过滤消息字段
                                const filteredMsg = {
                                    chatId: msg.chatId,
                                    sender: msg.sender,
                                    content: msg.content,
                                    timestamp: msg.timestamp,
                                    isTeaching: msg.isTeaching,
                                    senderName: msg.senderName,
                                    senderAvatar: msg.senderAvatar,
                                    avatar: msg.avatar,
                                    quote: msg.quote,
                                    isGroupChat: msg.isGroupChat,
                                    thought: msg.thought,
                                    type: msg.type,
                                    isRead: msg.isRead
                                };

                                // 过滤图片内容
                                if (filteredMsg.content && (
                                    filteredMsg.content.includes('<img') ||
                                    filteredMsg.content.includes('data:image') ||
                                    filteredMsg.content.includes('blob:') ||
                                    msg.imageData
                                )) {
                                    filteredMsg.content = '[图片消息]';
                                }

                                // 序列化
                                const msgStr = JSON.stringify(filteredMsg, (k, v) => v === undefined ? null : v);
                                batchData += (isFirstMessage ? '' : ',') + msgStr;
                                isFirstMessage = false;
                            }

                            // 写入批次
                            if (batchData) {
                                await Filesystem.appendFile({
                                    path: fileName,
                                    data: batchData,
                                    directory: 'Cache',
                                    encoding: 'utf8'
                                });
                                totalBytesWritten += batchData.length;
                            }

                            processedCount += messages.length;

                            // 更新进度
                            if (processedCount % 500 === 0 || processedCount >= totalMessages) {
                                loadingToast.textContent = `正在写入消息记录... ${processedCount}/${totalMessages}`;
                                await new Promise(resolve => setTimeout(resolve, 10));
                            }
                        }
                    }
                    
                    await Filesystem.appendFile({
                        path: fileName,
                        data: ']',
                        directory: 'Cache',
                        encoding: 'utf8'
                    });
                    totalBytesWritten += 1;
                }
                
                await Filesystem.appendFile({
                    path: fileName,
                    data: '}',
                    directory: 'Cache',
                    encoding: 'utf8'
                });
                totalBytesWritten += 1;
                
                console.log('relationshipData导出完成，大小:', (totalBytesWritten / 1024).toFixed(2), 'KB');

                // 【重构】清理内存 - chatMessages已经不存在于baseData中
                baseData.wechatChatList = null;
                await new Promise(resolve => setTimeout(resolve, 100));
                
                // 【修复】直接从 localforage 读取设置，避免依赖包装函数
                const appSettings = await localforage.getItem('appSettings') || {};
                // 【修复】使用replacer函数处理undefined值
                const appSettingsStr = JSON.stringify(appSettings, (k, v) => v === undefined ? null : v);
                await Filesystem.appendFile({
                    path: fileName,
                    data: ',"settings":' + appSettingsStr,
                    directory: 'Cache',
                    encoding: 'utf8'
                });
                totalBytesWritten += 12 + appSettingsStr.length;
                console.log('settings导出完成，总大小:', (totalBytesWritten / 1024).toFixed(2), 'KB');
                
                const apiPresets = await localforage.getItem('apiPresets') || [];
                // 【修复】使用replacer函数处理undefined值
                const apiPresetsStr = JSON.stringify(apiPresets, (k, v) => v === undefined ? null : v);
                await Filesystem.appendFile({
                    path: fileName,
                    data: ',"presets":' + apiPresetsStr,
                    directory: 'Cache',
                    encoding: 'utf8'
                });
                totalBytesWritten += 11 + apiPresetsStr.length;
                console.log('presets导出完成，总大小:', (totalBytesWritten / 1024).toFixed(2), 'KB');
                
                // 【修复】直接从 localforage 读取 API 模型
                const apiModels = await localforage.getItem('apiModels') || [];
                // 【修复】使用replacer函数处理undefined值
                const apiModelsStr = JSON.stringify(apiModels, (k, v) => v === undefined ? null : v);
                await Filesystem.appendFile({
                    path: fileName,
                    data: ',"models":' + apiModelsStr,
                    directory: 'Cache',
                    encoding: 'utf8'
                });
                totalBytesWritten += 10 + apiModelsStr.length;
                console.log('models导出完成，总大小:', (totalBytesWritten / 1024).toFixed(2), 'KB');
                
                const imageData = {};
                console.log('已过滤所有图片数据，仅保留文字记录');
                
                // 【修复】使用replacer函数处理undefined值
                const imagesStr = JSON.stringify(imageData, (k, v) => v === undefined ? null : v);
                await Filesystem.appendFile({
                    path: fileName,
                    data: ',"images":' + imagesStr,
                    directory: 'Cache',
                    encoding: 'utf8'
                });
                totalBytesWritten += 10 + imagesStr.length;
                console.log('images导出完成，当前大小:', (totalBytesWritten / 1024).toFixed(2), 'KB');
                
                // 【新增】导出其他应用的文字数据（不包含图片）
                loadingToast.textContent = '正在导出其他应用数据（第5/5步）...';
                await new Promise(resolve => setTimeout(resolve, 100));
                
                const otherData = {};
                
                // 【防闪退】分批读取数据，每读取一项让出主线程
                
                // 日记数据（过滤图片）
                try {
                    loadingToast.textContent = '正在导出日记数据（第5/5步-1）...';
                    await new Promise(resolve => setTimeout(resolve, 50));

                    // 【修复】使用统一接口读取日记数据，确保从 SQLite 获取
                    let diaryData = await loadDiaryDataUnified([]);

                    // 【修复】确保 diaryData 是数组格式
                    if (typeof diaryData === 'string') {
                        try {
                            diaryData = JSON.parse(diaryData);
                        } catch (e) {
                            console.warn('日记数据解析失败，使用空数组');
                            diaryData = [];
                        }
                    }
                    if (!Array.isArray(diaryData)) {
                        console.warn('日记数据不是数组格式，转换为数组:', typeof diaryData);
                        // 如果是对象格式，转换为空数组（旧格式不兼容）
                        diaryData = [];
                    }
                    
                    // 【防闪退】分批处理日记条目
                    otherData.diaryData = [];
                    const DIARY_BATCH = 100;
                    for (let i = 0; i < diaryData.length; i += DIARY_BATCH) {
                        const batch = diaryData.slice(i, i + DIARY_BATCH);
                        const processed = batch.map(entry => ({
                            id: entry?.id || '',
                            title: entry?.title || '',
                            content: entry?.content || '',
                            date: entry?.date || '',
                            mood: entry?.mood || '',
                            weather: entry?.weather || '',
                            location: entry?.location || '',
                            tags: entry?.tags || [],
                            coverImage: null,
                            images: []
                        }));
                        otherData.diaryData.push(...processed);
                        
                        if (i % 200 === 0 && i > 0) {
                            loadingToast.textContent = `正在导出日记数据（第5/5步-1）... ${Math.min(i + DIARY_BATCH, diaryData.length)}/${diaryData.length}`;
                            await new Promise(resolve => setTimeout(resolve, 10));
                        }
                    }
                    
                    await new Promise(resolve => setTimeout(resolve, 50));
                    // 【修复】直接从 localforage 读取日记封面设置
                    otherData.diaryCoverSettings = await localforage.getItem('diaryCoverSettings') || {};
                } catch (e) {
                    console.log('日记数据导出失败:', e);
                    otherData.diaryData = [];
                    otherData.diaryCoverSettings = {};
                }
                
                // 备忘录数据（小黑屋）
                try {
                    loadingToast.textContent = '正在导出备忘录数据（第5/5步-2）...';
                    await new Promise(resolve => setTimeout(resolve, 50));
                    
                    // 【修复】直接从 localforage 读取备忘录数据
                    otherData.memo_houseRules = await localforage.getItem('memo_houseRules') || [];
                    await new Promise(resolve => setTimeout(resolve, 30));
                    otherData.memo_violations = await localforage.getItem('memo_violations') || [];
                    await new Promise(resolve => setTimeout(resolve, 30));
                    otherData.memo_todayMemos = await localforage.getItem('memo_todayMemos') || [];
                    await new Promise(resolve => setTimeout(resolve, 30));
                    otherData.memo_lastDate = await localforage.getItem('memo_lastDate') || null;
                    await new Promise(resolve => setTimeout(resolve, 30));
                    otherData.memo_media_type = await localforage.getItem('memo_media_type') || 'image';
                    await new Promise(resolve => setTimeout(resolve, 30));
                    otherData.memo_guardian = await localforage.getItem('memo_guardian') || null;
                    await new Promise(resolve => setTimeout(resolve, 30));
                    otherData.memo_guardian_id = await localforage.getItem('memo_guardian_id') || null;
                    await new Promise(resolve => setTimeout(resolve, 30));
                    otherData.memo_guardian_name = await localforage.getItem('memo_guardian_name') || '';
                    await new Promise(resolve => setTimeout(resolve, 30));
                    otherData.memo_guardian_avatar = await localforage.getItem('memo_guardian_avatar') || '';
                    // 图片字段清空
                    otherData.memo_bg = null;
                    otherData.memo_bg_image = null;
                    otherData.memo_media = null;
                } catch (e) {
                    console.log('备忘录数据导出失败:', e);
                }
                
                // 学习课桌数据
                try {
                    loadingToast.textContent = '正在导出学习课桌数据（第5/5步-3）...';
                    await new Promise(resolve => setTimeout(resolve, 50));
                    
                    const studyDeskData = await localforage.getItem('studyDeskData') || {};
                    await new Promise(resolve => setTimeout(resolve, 30));
                    otherData.studyDeskData = {
                        todos: studyDeskData.todos || [],
                        records: studyDeskData.records || [],
                        totalStudyTime: studyDeskData.totalStudyTime || 0,
                        totalRestTime: studyDeskData.totalRestTime || 0,
                        background: null
                    };
                } catch (e) {
                    console.log('学习课桌数据导出失败:', e);
                }
                
                // 足迹数据
                try {
                    loadingToast.textContent = '正在导出足迹数据（第5/5步-4）...';
                    await new Promise(resolve => setTimeout(resolve, 50));
                    
                    const footprints = await localforage.getItem('footprints') || [];
                    // 【防闪退】分批处理足迹数据
                    otherData.footprints = [];
                    const FP_BATCH = 100;
                    for (let i = 0; i < footprints.length; i += FP_BATCH) {
                        const batch = footprints.slice(i, i + FP_BATCH);
                        const processed = batch.map(fp => ({
                            id: fp.id,
                            title: fp.title,
                            content: fp.content,
                            date: fp.date,
                            location: fp.location,
                            image: null
                        }));
                        otherData.footprints.push(...processed);
                        
                        if (i % 200 === 0 && i > 0) {
                            await new Promise(resolve => setTimeout(resolve, 10));
                        }
                    }
                } catch (e) {
                    console.log('足迹数据导出失败:', e);
                }
                
                // 其他数据
                try {
                    loadingToast.textContent = '正在导出其他数据（第5/5步-5）...';
                    await new Promise(resolve => setTimeout(resolve, 50));
                    
                    // 【修复】使用统一接口读取健康数据，确保从 SQLite 获取
                    otherData.periodData = await loadHealthDataUnified('periodData', null);
                    await new Promise(resolve => setTimeout(resolve, 30));
                    otherData.waterData = await loadHealthDataUnified('waterData', null);
                    await new Promise(resolve => setTimeout(resolve, 30));
                    otherData.sleepData = await loadHealthDataUnified('sleepData', null);
                    await new Promise(resolve => setTimeout(resolve, 30));
                    otherData.diseaseData = await localforage.getItem('diseaseData') || null;
                    await new Promise(resolve => setTimeout(resolve, 30));
                    // 【修复】使用 localforage 读取通话记录和个人资料
                    otherData.callRecords = await localforage.getItem('callRecords') || {};
                    await new Promise(resolve => setTimeout(resolve, 30));
                    // 【简化导出】清空个人资料中的头像
                    const personalProfile = await localforage.getItem('personalProfile') || {};
                    otherData.personalProfile = {
                        ...personalProfile,
                        avatar: '' // 清空头像
                    };
                } catch (e) {
                    console.log('其他数据导出失败:', e);
                }
                
                // 【防闪退】分批写入 otherData，避免一次性序列化大数据
                loadingToast.textContent = '正在写入其他应用数据...';
                await new Promise(resolve => setTimeout(resolve, 50));
                
                await Filesystem.appendFile({
                    path: fileName,
                    data: ',"otherData":{',
                    directory: 'Cache',
                    encoding: 'utf8'
                });
                totalBytesWritten += 14;
                
                // 分批写入各个数据项
                const otherDataKeys = Object.keys(otherData);
                for (let i = 0; i < otherDataKeys.length; i++) {
                    const key = otherDataKeys[i];
                    const value = otherData[key];
                    const isLast = i === otherDataKeys.length - 1;
                    
                    try {
                        // 【修复】使用replacer函数处理undefined值
                        const valueStr = JSON.stringify(value, (k, v) => v === undefined ? null : v);
                        await Filesystem.appendFile({
                            path: fileName,
                            data: `"${key}":${valueStr}${isLast ? '' : ','}`,
                            directory: 'Cache',
                            encoding: 'utf8'
                        });
                        totalBytesWritten += key.length + 3 + valueStr.length + (isLast ? 0 : 1);
                    } catch (e) {
                        console.warn(`导出 ${key} 失败:`, e);
                        // 写入空值
                        await Filesystem.appendFile({
                            path: fileName,
                            data: `"${key}":null${isLast ? '' : ','}`,
                            directory: 'Cache',
                            encoding: 'utf8'
                        });
                    }
                    
                    // 每5项让出主线程
                    if (i % 5 === 0) {
                        await new Promise(resolve => setTimeout(resolve, 10));
                    }
                }
                
                await Filesystem.appendFile({
                    path: fileName,
                    data: '}',
                    directory: 'Cache',
                    encoding: 'utf8'
                });
                totalBytesWritten += 1;
                console.log('otherData导出完成，当前大小:', (totalBytesWritten / 1024).toFixed(2), 'KB');
                
                await Filesystem.appendFile({
                    path: fileName,
                    data: ',"timestamp":' + Date.now() + '}',
                    directory: 'Cache',
                    encoding: 'utf8'
                });
                totalBytesWritten += 22;
                
                console.log('文件写入完成，总大小:', (totalBytesWritten / 1024).toFixed(2), 'KB');
                
                const fileUri = await Filesystem.getUri({
                    path: fileName,
                    directory: 'Cache'
                });

                console.log('文件URI:', fileUri.uri);

                await Share.share({
                    title: '守护应用数据备份',
                    text: `数据备份 - ${new Date().toLocaleDateString()}\n大小: ${(totalBytesWritten / 1024).toFixed(2)} KB`,
                    url: fileUri.uri,
                    dialogTitle: '分享数据备份'
                });

                console.log('分享成功');
                
                // 移除加载提示
                if (loadingToast && loadingToast.parentNode) {
                    document.body.removeChild(loadingToast);
                }
                
                alert(`数据导出成功！\n\n文件已准备好分享：\n${fileName}\n\n大小: ${(totalBytesWritten / 1024).toFixed(2)} KB\n\n请通过分享功能保存到微信、QQ或云盘。`);
                
            } catch (error) {
                const elapsed = Date.now() - startTime;
                console.error('【导出调试】导出失败，耗时:', elapsed, 'ms');
                console.error('插件导出失败:', error);
                console.error('错误堆栈:', error.stack);
                
                // 【调试】记录详细的错误信息
                let errorDetails = '';
                if (error.message) errorDetails += `错误信息: ${error.message}\n`;
                if (error.name) errorDetails += `错误类型: ${error.name}\n`;
                if (error.code) errorDetails += `错误代码: ${error.code}\n`;
                errorDetails += `耗时: ${elapsed}ms\n`;
                
                // 确保移除加载提示
                if (loadingToast && loadingToast.parentNode) {
                    try {
                        document.body.removeChild(loadingToast);
                    } catch (e) {
                        console.warn('移除加载提示失败:', e);
                    }
                }
                
                alert('导出失败!\n\n' + errorDetails + '\n请确保在APK中使用此功能，或尝试"超轻量导出"');
            }
        }
        
        // 下载文件
        async function downloadFile(dataStr, fileName) {
            try {
                const blob = new Blob([dataStr], { type: 'application/json' });
                const url = URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = fileName;
                a.style.display = 'none';
                document.body.appendChild(a);
                a.click();
                
                setTimeout(() => {
                    document.body.removeChild(a);
                    URL.revokeObjectURL(url);
                }, 100);
                
                alert('文件下载已开始，请检查下载文件夹');
            } catch (err) {
                console.error('下载失败:', err);
                throw err;
            }
        }
        
        // 【超轻量导出】仅导出最核心的数据，避免任何可能导致闪退的操作
        async function exportUltraLight() {
            const loadingToast = document.createElement('div');
            loadingToast.style.cssText = 'position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);background:rgba(0,0,0,0.8);color:white;padding:20px;border-radius:10px;z-index:99999;font-size:16px;';
            loadingToast.textContent = '正在准备超轻量导出...';
            document.body.appendChild(loadingToast);
            
            try {
                const { Filesystem } = window.Capacitor.Plugins;
                const { Share } = window.Capacitor.Plugins;
                
                if (!Filesystem || !Share) {
                    document.body.removeChild(loadingToast);
                    alert('Filesystem或Share插件未安装');
                    return;
                }
                
                const fileName = `relationship-ultra-light-${new Date().toISOString().split('T')[0]}.json`;
                
                // 第一步：只导出最核心的字段
                loadingToast.textContent = '正在导出核心数据（1/3）...';
                await new Promise(resolve => setTimeout(resolve, 50));
                
                // 只保留最基本的聊天列表信息
                const minimalChatList = relationshipData.wechatChatList.map(chat => ({
                    id: chat.id,
                    name: chat.name,
                    remark: chat.remark,
                    myNickname: chat.myNickname,
                    personality: chat.personality,
                    worldbooks: chat.worldbooks,
                    contextLength: chat.contextLength,
                    memoryMountCount: chat.memoryMountCount,
                    memories: (chat.memories || []).map(m => ({
                        id: m.id,
                        timeText: m.timeText,
                        content: m.content,
                        summary: m.summary,
                        startTime: m.startTime,
                        endTime: m.endTime
                    }))
                }));
                
                // 第二步：分批处理消息，每批100条
                loadingToast.textContent = '正在导出消息记录（2/3）...';
                await new Promise(resolve => setTimeout(resolve, 50));
                
                const minimalMessages = [];
                const BATCH_SIZE = 100;
                const totalMsgs = relationshipData.chatMessages.length;
                
                for (let i = 0; i < totalMsgs; i += BATCH_SIZE) {
                    const batch = relationshipData.chatMessages.slice(i, i + BATCH_SIZE);
                    for (const msg of batch) {
                        // 只保留纯文本内容
                        let content = msg.content || '';
                        if (content.includes('<img') || content.includes('data:image') || content.includes('blob:')) {
                            content = '[图片]';
                        }
                        
                        minimalMessages.push({
                            chatId: msg.chatId,
                            sender: msg.sender,
                            senderName: msg.senderName,
                            content: content,
                            timestamp: msg.timestamp,
                            isTeaching: msg.isTeaching
                        });
                    }
                    
                    // 更新进度
                    if (i % 500 === 0) {
                        loadingToast.textContent = `正在导出消息记录（2/3）... ${Math.min(i + BATCH_SIZE, totalMsgs)}/${totalMsgs}`;
                        await new Promise(resolve => setTimeout(resolve, 10));
                    }
                }
                
                // 第三步：构建最小化数据对象
                loadingToast.textContent = '正在生成文件（3/3）...';
                await new Promise(resolve => setTimeout(resolve, 50));
                
                const ultraLightData = {
                    title: relationshipData.title,
                    startDate: relationshipData.startDate,
                    description: relationshipData.description,
                    mood: relationshipData.mood,
                    selectedCharacterId: relationshipData.selectedCharacterId,
                    characterRelationships: relationshipData.characterRelationships,
                    coupleSpaceEnabled: relationshipData.coupleSpaceEnabled,
                    couplePartnerId: relationshipData.couplePartnerId,
                    coupleStartDate: relationshipData.coupleStartDate,
                    wechatChatList: minimalChatList,
                    chatMessages: minimalMessages,
                    // 不包含任何图片字段
                    avatar1: null, avatar2: null, cardBg: null, topCardBg: null,
                    dynamicImage: null, leftBubbleAvatar: null, rightBubbleAvatar: null,
                    mainBg: null, polaroidImage: null
                };
                
                // 直接写入文件，不经过 JSON.stringify 中间步骤
                // 【修复】使用replacer函数处理undefined值
                const dataStr = JSON.stringify(ultraLightData, (key, value) => value === undefined ? null : value);
                
                await Filesystem.writeFile({
                    path: fileName,
                    data: dataStr,
                    directory: 'Cache',
                    encoding: 'utf8'
                });
                
                const fileUri = await Filesystem.getUri({
                    path: fileName,
                    directory: 'Cache'
                });
                
                const sizeKB = (dataStr.length / 1024).toFixed(2);
                
                // 清理内存
                ultraLightData.chatMessages = null;
                ultraLightData.wechatChatList = null;
                
                document.body.removeChild(loadingToast);
                
                await Share.share({
                    title: '守护应用数据备份（超轻量）',
                    text: `数据备份 - ${new Date().toLocaleDateString()}\n大小: ${sizeKB} KB`,
                    url: fileUri.uri,
                    dialogTitle: '分享数据备份'
                });
                
                alert(`超轻量导出成功！\n\n文件大小: ${sizeKB} KB\n消息数量: ${minimalMessages.length} 条\n\n请通过分享功能保存到微信、QQ或云盘。`);
                
            } catch (error) {
                console.error('超轻量导出失败:', error);
                if (loadingToast && loadingToast.parentNode) {
                    document.body.removeChild(loadingToast);
                }
                alert('导出失败: ' + error.message);
            }
        }

        // 【修复】请求文件读取权限（Android 12+ 需要特殊处理）
        async function requestFilePermission() {
            if (!window.Capacitor || !window.Capacitor.Plugins) {
                console.log('非 Capacitor 环境，无需请求权限');
                return true;
            }
            
            try {
                const { Permissions } = window.Capacitor.Plugins;
                if (!Permissions) {
                    console.log('Permissions 插件不可用');
                    return true;
                }
                
                // 检查当前平台
                const platform = window.Capacitor.getPlatform();
                console.log('当前平台:', platform);
                
                if (platform !== 'android') {
                    console.log('非 Android 平台，无需请求存储权限');
                    return true;
                }
                
                // 获取 Android 版本
                const sdkVersion = await getAndroidSDKVersion();
                console.log('Android SDK 版本:', sdkVersion);
                
                // Android 13+ (API 33+) 使用新的媒体权限
                if (sdkVersion >= 33) {
                    console.log('Android 13+，请求 READ_MEDIA_IMAGES 权限');
                    try {
                        const mediaResult = await Permissions.requestPermission({
                            permission: 'READ_MEDIA_IMAGES'
                        });
                        console.log('READ_MEDIA_IMAGES 权限请求结果:', mediaResult);
                        
                        if (mediaResult.granted) {
                            return true;
                        }
                    } catch (mediaError) {
                        console.log('READ_MEDIA_IMAGES 权限请求失败:', mediaError);
                    }
                }
                
                // Android 12 (API 31-32) 和 Android 11 (API 30) 特殊处理
                // 在 Android 11+ 上，READ_EXTERNAL_STORAGE 只能访问媒体文件
                // 对于 JSON 文件，需要使用其他方式
                if (sdkVersion >= 30 && sdkVersion <= 32) {
                    console.log('Android 11-12，尝试请求所有文件访问权限');
                    
                    // 首先尝试请求 READ_EXTERNAL_STORAGE
                    try {
                        const storageResult = await Permissions.requestPermission({
                            permission: 'READ_EXTERNAL_STORAGE'
                        });
                        console.log('READ_EXTERNAL_STORAGE 权限请求结果:', storageResult);
                        
                        if (storageResult.granted) {
                            // 在 Android 11-12 上，即使有这个权限，也可能无法访问所有文件
                            // 但我们仍然返回 true，让系统文件选择器来处理
                            console.log('已获得 READ_EXTERNAL_STORAGE 权限，继续尝试打开文件选择器');
                            return true;
                        }
                    } catch (storageError) {
                        console.log('READ_EXTERNAL_STORAGE 权限请求失败:', storageError);
                    }
                    
                    // 尝试请求 MANAGE_EXTERNAL_STORAGE（可能需要特殊权限）
                    try {
                        const manageResult = await Permissions.requestPermission({
                            permission: 'MANAGE_EXTERNAL_STORAGE'
                        });
                        console.log('MANAGE_EXTERNAL_STORAGE 权限请求结果:', manageResult);
                        
                        if (manageResult.granted) {
                            return true;
                        }
                    } catch (manageError) {
                        console.log('MANAGE_EXTERNAL_STORAGE 权限请求失败:', manageError);
                    }
                    
                    // 如果权限请求失败，仍然返回 true
                    // 因为 Android 12 的系统文件选择器可能不需要显式权限
                    console.log('Android 11-12：权限请求可能受限，尝试直接打开文件选择器');
                    return true;
                }
                
                // Android 10 及以下使用 READ_EXTERNAL_STORAGE
                console.log('请求 READ_EXTERNAL_STORAGE 权限');
                let result = await Permissions.requestPermission({
                    permission: 'READ_EXTERNAL_STORAGE'
                });
                
                console.log('READ_EXTERNAL_STORAGE 权限请求结果:', result);
                
                if (result.granted) {
                    return true;
                }
                
                // 如果权限被拒绝，提示用户
                if (result.denied) {
                    alert('需要存储权限才能导入文件。请在设置中授予权限。');
                    return false;
                }
                
                return result.granted;
            } catch (error) {
                console.error('请求文件权限失败:', error);
                // 即使请求失败，也尝试继续（某些设备可能不需要显式权限）
                return true;
            }
        }
        
        // 【修复】获取 Android SDK 版本
        async function getAndroidSDKVersion() {
            try {
                // 尝试使用 Device 插件
                if (window.Capacitor && window.Capacitor.Plugins && window.Capacitor.Plugins.Device) {
                    const deviceInfo = await window.Capacitor.Plugins.Device.getInfo();
                    console.log('设备信息:', deviceInfo);
                    // 从 osVersion 中提取版本号
                    if (deviceInfo.osVersion) {
                        const version = parseInt(deviceInfo.osVersion.split('.')[0]);
                        if (!isNaN(version)) {
                            // 将 Android 版本转换为 SDK 版本
                            const versionMap = {
                                14: 34,  // Android 14
                                13: 33,  // Android 13
                                12: 31,  // Android 12
                                11: 30,  // Android 11
                                10: 29,  // Android 10
                                9: 28,   // Android 9
                                8: 26    // Android 8
                            };
                            return versionMap[version] || version;
                        }
                    }
                }
                
                // 备选方案：通过 User Agent 检测
                const userAgent = navigator.userAgent || navigator.vendor || window.opera;
                console.log('User Agent:', userAgent);
                
                // 尝试从 User Agent 中提取 Android 版本
                const androidMatch = userAgent.match(/Android\s(\d+)(?:\.(\d+))?/i);
                if (androidMatch) {
                    const majorVersion = parseInt(androidMatch[1]);
                    console.log('从 User Agent 检测到 Android 版本:', majorVersion);
                    
                    const versionMap = {
                        14: 34,  // Android 14
                        13: 33,  // Android 13
                        12: 31,  // Android 12
                        11: 30,  // Android 11
                        10: 29,  // Android 10
                        9: 28,   // Android 9
                        8: 26    // Android 8
                    };
                    return versionMap[majorVersion] || 29;
                }
            } catch (error) {
                console.error('获取 Android SDK 版本失败:', error);
            }
            // 默认返回 29 (Android 10)
            return 29;
        }
        
        // 【修复】打开文件选择器（带权限检查）
        async function openFilePicker() {
            console.log('打开文件选择器...');
            
            try {
                const platform = window.Capacitor?.getPlatform?.() || 'web';
                
                // 【修复】Android 使用原生文件选择器插件
                if (platform === 'android' || platform === 'ios') {
                    console.log('使用原生文件选择器插件');
                    
                    // 检查 FilePicker 插件是否可用
                    if (window.Capacitor?.Plugins?.FilePicker) {
                        try {
                            const result = await window.Capacitor.Plugins.FilePicker.pickFiles({
                                types: ['application/json'],
                                multiple: false,
                                readData: true  // 直接读取文件内容
                            });
                            
                            console.log('文件选择结果:', result);
                            
                            if (result.files && result.files.length > 0) {
                                const file = result.files[0];
                                console.log('选择的文件:', file.name);
                                
                                // 处理文件数据
                                if (file.data) {
                                    // 将 base64 数据转换为文件对象
                                    const base64Data = file.data;
                                    const byteCharacters = atob(base64Data);
                                    const byteNumbers = new Array(byteCharacters.length);
                                    for (let i = 0; i < byteCharacters.length; i++) {
                                        byteNumbers[i] = byteCharacters.charCodeAt(i);
                                    }
                                    const byteArray = new Uint8Array(byteNumbers);
                                    const blob = new Blob([byteArray], { type: 'application/json' });
                                    
                                    const fileObj = new File([blob], file.name, { type: 'application/json' });
                                    const filesList = [fileObj];
                                    
                                    // 调用导入函数
                                    await importData(filesList);
                                }
                            }
                            return;
                        } catch (pickerError) {
                            console.error('原生文件选择器错误:', pickerError);
                            // 如果插件失败，回退到 HTML 文件选择器
                        }
                    } else {
                        console.warn('FilePicker 插件不可用，回退到 HTML 文件选择器');
                    }
                }
                
                // 回退到 HTML 文件选择器（Web 或插件不可用时）
                console.log('使用 HTML 文件选择器');
                const importFile = document.getElementById('importFile');
                if (importFile) {
                    importFile.click();
                } else {
                    console.error('找不到 importFile 元素');
                    alert('错误：找不到文件输入元素');
                }
            } catch (error) {
                console.error('打开文件选择器时出错:', error);
                alert('打开文件选择器失败: ' + error.message);
            }
        }
        
        // 【修复】打开铃声文件选择器（带权限检查）
        async function openRingtoneFilePicker(type) {
            console.log('打开铃声文件选择器，类型:', type);
            
            try {
                const platform = window.Capacitor?.getPlatform?.() || 'web';
                
                // 【修复】Android/iOS 使用原生文件选择器插件
                if (platform === 'android' || platform === 'ios') {
                    if (window.Capacitor?.Plugins?.FilePicker) {
                        try {
                            const result = await window.Capacitor.Plugins.FilePicker.pickFiles({
                                types: ['audio/*'],
                                multiple: false,
                                readData: true
                            });
                            
                            if (result.files && result.files.length > 0) {
                                const file = result.files[0];
                                // 处理铃声文件导入
                                if (file.data) {
                                    const base64Data = file.data;
                                    const byteCharacters = atob(base64Data);
                                    const byteNumbers = new Array(byteCharacters.length);
                                    for (let i = 0; i < byteCharacters.length; i++) {
                                        byteNumbers[i] = byteCharacters.charCodeAt(i);
                                    }
                                    const byteArray = new Uint8Array(byteNumbers);
                                    const blob = new Blob([byteArray], { type: file.mimeType || 'audio/mp3' });
                                    const fileObj = new File([blob], file.name, { type: file.mimeType || 'audio/mp3' });
                                    
                                    // 调用导入铃声函数
                                    await importRingtone(type, [fileObj]);
                                }
                            }
                            return;
                        } catch (pickerError) {
                            console.error('原生文件选择器错误:', pickerError);
                        }
                    }
                }
                
                // 回退到 HTML 文件选择器
                const fileInput = document.getElementById(type + 'RingtoneFile');
                if (fileInput) {
                    fileInput.click();
                }
            } catch (error) {
                console.error('打开铃声文件选择器失败:', error);
                alert('打开文件选择器失败: ' + error.message);
            }
        }
        
        // 【修复】打开回忆备份文件选择器（带权限检查）
        async function openMemoryFilePicker() {
            console.log('打开回忆备份文件选择器...');
            
            try {
                const platform = window.Capacitor?.getPlatform?.() || 'web';
                
                // 【修复】Android/iOS 使用原生文件选择器插件
                if (platform === 'android' || platform === 'ios') {
                    if (window.Capacitor?.Plugins?.FilePicker) {
                        try {
                            const result = await window.Capacitor.Plugins.FilePicker.pickFiles({
                                types: ['application/json', 'text/plain'],
                                multiple: false,
                                readData: true
                            });
                            
                            if (result.files && result.files.length > 0) {
                                const file = result.files[0];
                                if (file.data) {
                                    // 将 base64 转换为 File 对象
                                    const base64Data = file.data;
                                    const byteCharacters = atob(base64Data);
                                    const byteNumbers = new Array(byteCharacters.length);
                                    for (let i = 0; i < byteCharacters.length; i++) {
                                        byteNumbers[i] = byteCharacters.charCodeAt(i);
                                    }
                                    const byteArray = new Uint8Array(byteNumbers);
                                    const blob = new Blob([byteArray], { type: file.mimeType || 'application/json' });
                                    const fileObj = new File([blob], file.name, { type: file.mimeType || 'application/json' });
                                    
                                    // 创建模拟的事件对象
                                    const mockEvent = { target: { files: [fileObj] } };
                                    await handleImportMemoryFile(mockEvent);
                                }
                            }
                            return;
                        } catch (pickerError) {
                            console.error('原生文件选择器错误:', pickerError);
                        }
                    }
                }
                
                // 回退到 HTML 文件选择器
                const fileInput = document.getElementById('importMemoryFile');
                if (fileInput) {
                    fileInput.click();
                } else {
                    console.error('找不到 importMemoryFile 元素');
                }
            } catch (error) {
                console.error('打开回忆备份文件选择器失败:', error);
                alert('打开文件选择器失败: ' + error.message);
            }
        }

        // 数据导入功能 - 支持新格式（包含图片数据）
        async function importData(files) {
            // 【防闪退】添加更完善的错误处理
            if (!files || files.length === 0) {
                console.warn('【防闪退】没有选择文件');
                return;
            }
            
            const file = files[0];
            
            // 【防闪退】显示加载提示
            const loadingToast = document.createElement('div');
            loadingToast.style.cssText = 'position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);background:rgba(0,0,0,0.8);color:white;padding:20px;border-radius:10px;z-index:99999;font-size:16px;';
            loadingToast.textContent = '正在读取文件，请稍候...';
            document.body.appendChild(loadingToast);
            
            const reader = new FileReader();
            
            reader.onload = async function(e) {
                try {
                    loadingToast.textContent = '正在解析数据...';
                    
                    // 【优化】检查文件大小
                    const fileSizeMB = (file.size / 1024 / 1024).toFixed(2);
                    console.log('文件大小:', fileSizeMB, 'MB');
                    
                    // 【优化】调整大文件阈值到200MB，并优化提示
                    if (parseFloat(fileSizeMB) > 200) {
                        const shouldContinue = confirm(`文件大小为 ${fileSizeMB} MB，比较大，导入可能需要一些时间。\n\n请确保：\n1. 手机电量充足\n2. 不要切换应用\n3. 耐心等待导入完成\n\n是否继续导入？`);
                        if (!shouldContinue) {
                            document.body.removeChild(loadingToast);
                            return;
                        }
                    }
                    
                    let data;
                    let autoFixed = false;
                    
                    try {
                        // 【修复】先清理文件内容，移除可能的BOM标记和前后空白
                        let cleanContent = e.target.result.replace(/^\uFEFF/, '').trim();
                        
                        // 【修复】检查清理后的内容是否为空
                        if (!cleanContent) {
                            throw new Error('文件内容为空');
                        }
                        
                        // 【自动修复】尝试自动修复常见的JSON问题
                        const originalContent = cleanContent;
                        
                        // 1. 移除控制字符（保留换行符、制表符等常用字符）
                        cleanContent = cleanContent.replace(/[\x00-\x08\x0B\x0C\x0E-\x1F\x7F-\x9F]/g, '');
                        
                        // 2. 修复尾随逗号（对象和数组中的尾随逗号）
                        cleanContent = cleanContent.replace(/,(\s*[}\]])/g, '$1');

                        // 【修复】修复 "key":, 这种缺失值的情况（如 "polaroidText":,）
                        // 修复 "key":, 后面跟逗号的情况
                        cleanContent = cleanContent.replace(/"([^"]+)":\s*,/g, '"$1":null,');
                        // 修复 "key":} 或 "key":] 在行尾或对象/数组结尾的情况
                        cleanContent = cleanContent.replace(/"([^"]+)":\s*([}\]])/g, '"$1":null$2');
                        // 【增强修复】修复 "key":, 后面跟属性名的情况（如 "polaroidText":,"wechatChatList"）
                        cleanContent = cleanContent.replace(/"([^"]+)":\s*(?=,\s*")/g, '"$1":null');
                        
                        // 【特殊修复】针对 polaroidText 等常见问题的额外修复
                        // 修复 "polaroidText":, 后面直接跟属性名的情况
                        cleanContent = cleanContent.replace(/"polaroidText":,(?="\w+")/g, '"polaroidText":null,');
                        cleanContent = cleanContent.replace(/"polaroidRotation":,(?="\w+")/g, '"polaroidRotation":null,');
                        cleanContent = cleanContent.replace(/"polaroidImage":,(?="\w+")/g, '"polaroidImage":null,');
                        
                        // 3. 修复未转义的换行符在字符串中
                        // 先找到所有字符串，然后处理其中的换行符
                        cleanContent = cleanContent.replace(/"([^"\\]*(?:\\.[^"\\]*)*)"/g, (match, p1) => {
                            // 将字符串中的实际换行符转为\n
                            const fixed = p1.replace(/\n/g, '\\n').replace(/\r/g, '\\r');
                            return '"' + fixed + '"';
                        });
                        
                        // 4. 修复单引号（JSON标准要求双引号）
                        // 这个比较复杂，可能误伤，暂时不处理
                        
                        // 检查是否进行了修复
                        if (cleanContent !== originalContent) {
                            console.log('【导入】自动修复了文件中的特殊字符');
                            autoFixed = true;
                        }
                        
                        // 【修复】尝试解析JSON
                        try {
                            data = JSON.parse(cleanContent);
                            console.log('【导入】JSON解析成功');
                            if (autoFixed) {
                                console.log('【导入】使用了自动修复后的内容');
                            }
                        } catch (firstError) {
                            // 如果第一次解析失败，尝试更激进的修复
                            console.warn('【导入】第一次解析失败，尝试激进修复:', firstError.message);

                            // 【关键修复】尝试修复文件截断问题
                            let truncationFixed = cleanContent;

                            // 1. 尝试补全截断的JSON（如果文件在字符串中间截断）
                            // 找到最后一个完整的属性，然后补全
                            const lastCompleteProp = truncationFixed.lastIndexOf('"', truncationFixed.length - 2);
                            if (lastCompleteProp > 0) {
                                const afterLastQuote = truncationFixed.substring(lastCompleteProp + 1);
                                // 如果在引号后面没有冒号，可能是截断了
                                if (!afterLastQuote.includes(':') && !afterLastQuote.includes('}') && !afterLastQuote.includes(']')) {
                                    // 截断了，尝试补全
                                    truncationFixed = truncationFixed.substring(0, lastCompleteProp) + '""}';
                                    console.log('【导入】尝试修复截断的JSON');
                                }
                            }

                            // 2. 尝试补全不完整的对象或数组
                            const openBraces = (truncationFixed.match(/{/g) || []).length;
                            const closeBraces = (truncationFixed.match(/}/g) || []).length;
                            const openBrackets = (truncationFixed.match(/\[/g) || []).length;
                            const closeBrackets = (truncationFixed.match(/\]/g) || []).length;

                            if (openBraces > closeBraces) {
                                truncationFixed += '}'.repeat(openBraces - closeBraces);
                                console.log('【导入】补全', openBraces - closeBraces, '个缺失的 }');
                            }
                            if (openBrackets > closeBrackets) {
                                truncationFixed += ']'.repeat(openBrackets - closeBrackets);
                                console.log('【导入】补全', openBrackets - closeBrackets, '个缺失的 ]');
                            }

                            // 3. 尝试移除所有非打印字符
                            const aggressiveClean = truncationFixed.replace(/[^\x20-\x7E\x0A\x0D\x09\u4E00-\u9FA5\u3000-\u303F\uFF00-\uFFEF]/g, '');

                            try {
                                data = JSON.parse(aggressiveClean);
                                console.log('【导入】激进修复后解析成功');
                                autoFixed = true;
                            } catch (secondError) {
                                // 激进修复也失败，抛出原始错误
                                throw firstError;
                            }
                        }
                    } catch (parseError) {
                        console.error('【防闪退】JSON解析失败:', parseError);
                        
                        // 【修复】显示更多调试信息
                        const content = e.target.result || '';
                        const previewLength = Math.min(500, content.length);
                        const preview = content.substring(0, previewLength);
                        const errorPosition = parseError.message.match(/position (\d+)/);
                        const position = errorPosition ? parseInt(errorPosition[1]) : '未知';
                        
                        console.error('【防闪退】文件内容前500字符:', preview);
                        console.error('【防闪退】错误位置:', position);
                        
                        // 【修复】尝试定位并显示错误位置附近的内容
                        let errorContext = '';
                        if (typeof position === 'number' && position > 0) {
                            const start = Math.max(0, position - 50);
                            const end = Math.min(content.length, position + 50);
                            errorContext = '\n\n错误位置附近的内容:\n' + content.substring(start, end);
                        }
                        
                        // 检查文件是否为空或太小
                        if (!content || content.trim().length === 0) {
                            alert('文件解析失败：文件为空');
                        } else if (content.trim().startsWith('<')) {
                            alert('文件解析失败：文件内容似乎是HTML而不是JSON，请检查文件是否被浏览器或微信修改过');
                        } else if (content.trim().startsWith('{') || content.trim().startsWith('[')) {
                            // 【修复】JSON格式但解析失败，显示详细错误
                            alert('文件解析失败：JSON格式不正确。\n\n错误信息：' + parseError.message + '\n错误位置：' + position + errorContext + '\n\n可能的原因：\n1. 文件在传输过程中损坏\n2. 文件包含特殊字符\n3. 文件编码不正确（请使用UTF-8编码）\n\n建议：尝试重新导出数据');
                        } else {
                            alert('文件解析失败：文件格式不正确或已损坏。\n\n错误信息：' + parseError.message + '\n\n文件内容预览：' + preview.substring(0, 100));
                        }
                        document.body.removeChild(loadingToast);
                        return;
                    }

                    // 【自动修复】如果文件被自动修复，显示提示
                    if (autoFixed) {
                        console.log('【导入】文件已自动修复并解析成功');
                        // 使用toast提示用户
                        showToast('文件已自动修复并导入', 'success');
                    }
                    
                    // 检测数据格式版本
                    console.log('【导入调试】数据字段检查:', {
                        hasRelationshipData: !!data.relationshipData,
                        hasSettings: !!data.settings,
                        hasImages: !!data.images,
                        hasOtherData: !!data.otherData,
                        hasTimestamp: !!data.timestamp,
                        dataKeys: Object.keys(data).slice(0, 10)
                    });
                    
                    if (data.otherData) {
                        console.log('检测到新格式数据（包含日记、备忘录、健康等数据）');
                    } else {
                        console.log('检测到旧格式数据（仅包含基础数据）');
                    }

                    // 【修复】清理导入数据中的 [object Object]
                    function cleanImportedData(obj, path = '') {
                        if (obj === null || obj === undefined) return obj;
                        
                        if (typeof obj === 'string') {
                            if (obj === '[object Object]' || obj.includes('[object Object]')) {
                                console.warn(`【导入清理】发现无效值 "[object Object]" 在路径: ${path}，已清空`);
                                return '';
                            }
                            return obj;
                        }
                        
                        if (Array.isArray(obj)) {
                            return obj.map((item, index) => cleanImportedData(item, `${path}[${index}]`));
                        }
                        
                        if (typeof obj === 'object') {
                            const cleaned = {};
                            for (const [key, value] of Object.entries(obj)) {
                                cleaned[key] = cleanImportedData(value, `${path}.${key}`);
                            }
                            return cleaned;
                        }
                        
                        return obj;
                    }
                    
                    // 清理 relationshipData
                    if (data.relationshipData) {
                        console.log('【导入】开始清理数据中的 [object Object]...');
                        data.relationshipData = cleanImportedData(data.relationshipData, 'relationshipData');
                        console.log('【导入】数据清理完成');
                    }
                    
                    if (data.relationshipData) {
                        loadingToast.textContent = '正在导入图片数据...';
                        
                        // 如果有图片数据，处理图片导入
                        if (data.images) {
                            console.log('检测到新格式数据，开始导入图片...');
                            
                            // 【防闪退】分批保存基本图片到IndexedDB
                            const basicImages = ['avatar1', 'avatar2', 'cardBg', 'topCardBg',
                                               'dynamicImage', 'leftBubbleAvatar', 'rightBubbleAvatar', 'mainBg'];
                            
                            for (let i = 0; i < basicImages.length; i++) {
                                const key = basicImages[i];
                                if (data.images[key]) {
                                    try {
                                        await saveImageToDB(key, data.images[key]);
                                        console.log(`导入图片 ${key} 成功`);
                                    } catch (err) {
                                        console.warn(`导入图片 ${key} 失败:`, err);
                                    }
                                }
                                
                                // 【防闪退】每处理3个图片后让出主线程
                                if (i % 3 === 0) {
                                    await new Promise(resolve => setTimeout(resolve, 0));
                                }
                            }
                            
                            // 【防闪退】分批保存应用图标
                            if (data.images.appIcons) {
                                const appIconEntries = Object.entries(data.images.appIcons);
                                for (let i = 0; i < appIconEntries.length; i++) {
                                    const [app, iconData] = appIconEntries[i];
                                    try {
                                        await saveImageToDB(`appIcon_${app}`, iconData);
                                        console.log(`导入应用图标 ${app} 成功`);
                                    } catch (err) {
                                        console.warn(`导入应用图标 ${app} 失败:`, err);
                                    }
                                    
                                    // 【防闪退】每处理3个图标后让出主线程
                                    if (i % 3 === 0) {
                                        await new Promise(resolve => setTimeout(resolve, 0));
                                    }
                                }
                            }
                            
                            // 【防闪退】分批保存聊天图片
                            if (data.images.chatImages) {
                                const chatImageEntries = Object.entries(data.images.chatImages);
                                for (let i = 0; i < chatImageEntries.length; i++) {
                                    const [imageKey, imageData] = chatImageEntries[i];
                                    try {
                                        await saveImageToDB(imageKey, imageData);
                                        console.log(`导入聊天图片 ${imageKey} 成功`);
                                    } catch (err) {
                                        console.warn(`导入聊天图片 ${imageKey} 失败:`, err);
                                    }
                                    
                                    // 【防闪退】每处理2个图片后让出主线程
                                    if (i % 2 === 0) {
                                        await new Promise(resolve => setTimeout(resolve, 0));
                                    }
                                }
                            }
                            
                            console.log('图片导入完成');
                        }
                        
                        loadingToast.textContent = '正在导入基本数据...';
                        
                        // 导入基本数据
                        relationshipData = data.relationshipData;
                        
                        // 安全处理startDate
                        if (relationshipData.startDate) {
                            if (typeof relationshipData.startDate === 'string') {
                                relationshipData.startDate = new Date(relationshipData.startDate);
                            } else if (typeof relationshipData.startDate === 'number') {
                                relationshipData.startDate = new Date(relationshipData.startDate);
                            } else if (!(relationshipData.startDate instanceof Date)) {
                                relationshipData.startDate = new Date('2024-01-01');
                            }
                        } else {
                            relationshipData.startDate = new Date('2024-01-01');
                        }
                        
                        // 确保数据结构完整
                        if (!Array.isArray(relationshipData.wechatChatList)) relationshipData.wechatChatList = [];
                        if (!Array.isArray(relationshipData.chatMessages)) relationshipData.chatMessages = [];
                        if (!Array.isArray(relationshipData.worldBooks)) relationshipData.worldBooks = [];
                        if (!Array.isArray(relationshipData.mountedWorldBooks)) relationshipData.mountedWorldBooks = [];
                        if (!Array.isArray(relationshipData.aiActions)) relationshipData.aiActions = [];
                        if (!Array.isArray(relationshipData.undoMessages)) relationshipData.undoMessages = [];

                        // 【修复】导入聊天记录到 ChatMessageManager（支持新旧两种格式）
                        let messagesToImport = [];
                        
                        // 【关键修复】检查所有可能的位置
                        // 1. 顶层 data.chatMessages（新格式导出）
                        if (data.chatMessages && typeof data.chatMessages === 'object') {
                            if (Array.isArray(data.chatMessages)) {
                                // 顶层是数组
                                messagesToImport = messagesToImport.concat(data.chatMessages);
                                console.log('【导入】检测到顶层数组格式聊天消息，共', data.chatMessages.length, '条');
                            } else {
                                // 顶层是对象（按chatId分组）
                                for (const [chatId, messages] of Object.entries(data.chatMessages)) {
                                    if (Array.isArray(messages)) {
                                        const messagesWithChatId = messages.map(msg => ({
                                            ...msg,
                                            chatId: msg.chatId || chatId
                                        }));
                                        messagesToImport = messagesToImport.concat(messagesWithChatId);
                                    }
                                }
                                console.log('【导入】检测到顶层对象格式聊天消息，共', messagesToImport.length, '条');
                            }
                        }
                        
                        // 2. relationshipData.chatMessages（旧格式或混合格式）
                        if (relationshipData.chatMessages) {
                            if (Array.isArray(relationshipData.chatMessages)) {
                                // 是数组
                                const existingIds = new Set(messagesToImport.map(m => m.id || `${m.chatId}_${m.timestamp}`));
                                const newMessages = relationshipData.chatMessages.filter(m => {
                                    const msgId = m.id || `${m.chatId}_${m.timestamp}`;
                                    return !existingIds.has(msgId);
                                });
                                messagesToImport = messagesToImport.concat(newMessages);
                                console.log('【导入】检测到 relationshipData.chatMessages 数组格式，新增', newMessages.length, '条');
                            } else if (typeof relationshipData.chatMessages === 'object') {
                                // 是按chatId分组的对象
                                for (const [chatId, messages] of Object.entries(relationshipData.chatMessages)) {
                                    if (Array.isArray(messages)) {
                                        const messagesWithChatId = messages.map(msg => ({
                                            ...msg,
                                            chatId: msg.chatId || chatId
                                        }));
                                        messagesToImport = messagesToImport.concat(messagesWithChatId);
                                    }
                                }
                                console.log('【导入】检测到 relationshipData.chatMessages 对象格式，共', messagesToImport.length, '条');
                            }
                        }
                        
                        // 去重（根据id）
                        const uniqueMessages = [];
                        const seenIds = new Set();
                        for (const msg of messagesToImport) {
                            const msgId = msg.id || `${msg.chatId}_${msg.timestamp}`;
                            if (!seenIds.has(msgId)) {
                                seenIds.add(msgId);
                                uniqueMessages.push(msg);
                            }
                        }
                        
                        if (uniqueMessages.length > 0) {
                            try {
                                console.log('【导入】正在导入聊天记录，共', uniqueMessages.length, '条（去重后）');
                                loadingToast.textContent = `正在导入聊天记录 (${uniqueMessages.length}条)...`;
                                
                                // 【修复】临时禁用SQLite，强制使用IndexedDB导入，避免SQLite错误导致导入失败
                                const sqliteWasAvailable = SQLiteManager.isAvailable;
                                if (SQLiteManager.isAvailable) {
                                    console.log('【导入】临时禁用SQLite，使用IndexedDB导入消息');
                                    SQLiteManager.isAvailable = false;
                                }
                                
                                // 【防闪退】分批导入，每100条让出主线程
                                const batchSize = 100;
                                let importedCount = 0;
                                for (let i = 0; i < uniqueMessages.length; i += batchSize) {
                                    const batch = uniqueMessages.slice(i, i + batchSize);
                                    try {
                                        const success = await ChatMessageManager.saveMessages(batch);
                                        if (success) {
                                            importedCount += batch.length;
                                            console.log(`【导入】已导入 ${Math.min(i + batchSize, uniqueMessages.length)}/${uniqueMessages.length} 条消息`);
                                        } else {
                                            console.warn(`【导入】批次 ${i/batchSize + 1} 导入失败`);
                                        }
                                    } catch (batchError) {
                                        console.error(`【导入】批次 ${i/batchSize + 1} 导入出错:`, batchError);
                                    }
                                    
                                    // 更新进度
                                    loadingToast.textContent = `正在导入聊天记录 (${Math.min(i + batchSize, uniqueMessages.length)}/${uniqueMessages.length})...`;
                                    
                                    // 让出主线程
                                    await new Promise(resolve => setTimeout(resolve, 0));
                                }
                                
                                // 恢复SQLite状态
                                SQLiteManager.isAvailable = sqliteWasAvailable;
                                
                                console.log(`【导入】聊天记录导入完成，成功导入 ${importedCount}/${uniqueMessages.length} 条`);
                                
                                if (importedCount < uniqueMessages.length) {
                                    console.warn(`【导入】部分消息导入失败: ${uniqueMessages.length - importedCount} 条`);
                                }
                            } catch (chatError) {
                                console.error('【导入】聊天记录导入失败:', chatError);
                                // 恢复SQLite状态
                                SQLiteManager.isAvailable = true;
                            }
                        }
                        if (!relationshipData.mood) {
                            relationshipData.mood = {
                                type: 'happy',
                                emoji: '😊',
                                text: '开心',
                                customImage: '',
                                timestamp: Date.now()
                            };
                        }
                        if (!relationshipData.theme) {
                            relationshipData.theme = {
                                mainBg: '',
                                appIcons: {
                                    wechat: '',
                                    worldbook: '',
                                    note: '',
                                    study: '',
                                    couple: '',
                                    diary: '',
                                    theme: '',
                                    settings: '',
                                    accounting: '',
                                    health: '',
