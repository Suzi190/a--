            } catch (error) {
                console.error('【防闪退】playAIVoice 发生错误:', error);
                return null;
            }
        }

        // 切换文字输入
        function toggleTextInput() {
            const textArea = document.getElementById('textInputArea');
            voiceCallState.isTextInputVisible = !voiceCallState.isTextInputVisible;
            
            if (voiceCallState.isTextInputVisible) {
                textArea.style.display = 'flex';
                if (voiceCallState.isMicOn) {
                    stopRecording();
                    voiceCallState.isMicOn = false;
                    const micBtn = document.getElementById('micBtn');
                    if (micBtn) {
                        micBtn.classList.remove('active');
                    }
                }
            } else {
                textArea.style.display = 'none';
            }
        }

        // 发送文字消息
        async function sendCallTextMessage() {
            const input = document.getElementById('callTextInput');
            const text = input.value.trim();
            
            if (!text) return;
            
            input.value = '';
            
            // 【修复】只显示用户消息，不播放语音（用户的话不需要语音）
            showUserMessageInCall(text);
            
            // 发送给AI
            await sendToAI(text);
        }
        
        // 【新增】在通话界面显示用户消息（不播放语音）
        function showUserMessageInCall(text) {
            const overlay = document.getElementById('aiResponseOverlay');
            const responseText = document.getElementById('aiResponseText');
            
            // 清除之前的定时器
            if (voiceCallState.responseTimer) {
                clearTimeout(voiceCallState.responseTimer);
            }
            
            responseText.textContent = text;
            overlay.classList.add('show');
            
            // 【关键】用户消息不播放语音，只显示文字
            // 3秒后自动隐藏
            voiceCallState.responseTimer = setTimeout(() => {
                clearAIResponse();
            }, 3000);
        }

        // 切换麦克风
        async function toggleMicrophone() {
            const micBtn = document.getElementById('micBtn');
            
            if (voiceCallState.isMicOn) {
                stopRecording();
                voiceCallState.isMicOn = false;
                micBtn.classList.remove('active');
            } else {
                try {
                    await startRecording();
                    voiceCallState.isMicOn = true;
                    micBtn.classList.add('active');
                    if (voiceCallState.isTextInputVisible) {
                        const textArea = document.getElementById('textInputArea');
                        textArea.style.display = 'none';
                        voiceCallState.isTextInputVisible = false;
                    }
                } catch (error) {
                    console.error('无法访问麦克风:', error);
                    alert('无法访问麦克风，请检查权限设置');
                }
            }
        }

        // 开始录音
        async function startRecording() {
            try {
                const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
                
                voiceCallState.audioContext = new (window.AudioContext || window.webkitAudioContext)();
                voiceCallState.analyser = voiceCallState.audioContext.createAnalyser();
                voiceCallState.source = voiceCallState.audioContext.createMediaStreamSource(stream);
                voiceCallState.source.connect(voiceCallState.analyser);
                
                voiceCallState.mediaRecorder = new MediaRecorder(stream);
                voiceCallState.audioChunks = [];
                
                voiceCallState.mediaRecorder.ondataavailable = (event) => {
                    voiceCallState.audioChunks.push(event.data);
                };
                
                voiceCallState.mediaRecorder.onstop = async () => {
                    const audioBlob = new Blob(voiceCallState.audioChunks, { type: 'audio/wav' });
                    await transcribeAudio(audioBlob);
                };
                
                voiceCallState.mediaRecorder.start();
                
                // 监测静音
                detectSilence();
                
            } catch (error) {
                console.error('启动录音失败:', error);
                throw error;
            }
        }

        // 停止录音
        async function stopRecording() {
            if (voiceCallState.mediaRecorder && voiceCallState.mediaRecorder.state !== 'inactive') {
                voiceCallState.mediaRecorder.stop();
                voiceCallState.mediaRecorder.stream.getTracks().forEach(track => track.stop());
            }

            // 【防闪退】断开音频节点连接
            if (voiceCallState.source) {
                try {
                    voiceCallState.source.disconnect();
                    voiceCallState.source = null;
                } catch (e) {}
            }

            if (voiceCallState.analyser) {
                try {
                    voiceCallState.analyser.disconnect();
                    voiceCallState.analyser = null;
                } catch (e) {}
            }

            // 【防闪退】等待 AudioContext 完全关闭
            if (voiceCallState.audioContext) {
                try {
                    await voiceCallState.audioContext.close();
                    voiceCallState.audioContext = null;
                } catch (e) {}
            }

            // 【防闪退】清理 RAF
            if (voiceCallState.rafId) {
                cancelAnimationFrame(voiceCallState.rafId);
                voiceCallState.rafId = null;
            }

            clearTimeout(voiceCallState.silenceTimer);
            voiceCallState.silenceTimer = null;
        }

        // 检测静音
        function detectSilence() {
            const dataArray = new Uint8Array(voiceCallState.analyser.frequencyBinCount);
            const threshold = 30;
            const silenceDuration = 5000;
            
            function checkVolume() {
                if (!voiceCallState.isMicOn) {
                    voiceCallState.rafId = null;
                    return;
                }

                voiceCallState.analyser.getByteFrequencyData(dataArray);

                let sum = 0;
                for (let i = 0; i < dataArray.length; i++) {
                    sum += dataArray[i];
                }
                const average = sum / dataArray.length;

                if (average > threshold) {
                    // 检测到声音
                    voiceCallState.lastSpeechTime = Date.now();
                    clearTimeout(voiceCallState.silenceTimer);
                } else {
                    // 检测到静音
                    if (Date.now() - voiceCallState.lastSpeechTime > silenceDuration) {
                        // 停止说话2秒后发送
                        voiceCallState.rafId = null;
                        stopRecording();
                        return;
                    }
                }

                voiceCallState.rafId = requestAnimationFrame(checkVolume);
            }

            voiceCallState.lastSpeechTime = Date.now();
            voiceCallState.rafId = requestAnimationFrame(checkVolume);
        }

        // 转录音频（已移除百度AI语音识别，改为手动输入）
        async function transcribeAudio(audioBlob) {
            // 弹出输入框让用户手动输入
            const transcript = prompt('请输入您刚才说的话：');
            
            if (transcript && transcript.trim()) {
                await sendToAI(transcript);
            }
        }

        // 发送给AI
        async function sendToAI(text) {
            const chatItem = relationshipData.wechatChatList.find(item => item.id == currentChatId);
            if (!chatItem) return;
            
            try {
                // 记录用户消息
                voiceCallState.callMessages.push({
                    sender: 'user',
                    content: text,
                    timestamp: Date.now()
                });
                
                // 清除之前的AI回复显示
                clearAIResponse();
                
                // 【优化】获取用户的个人资料
                const personalProfile = await localforage.getItem('personalProfile') || {};
                const userNickname = chatItem.myNickname || personalProfile.nickname || '我';
                const aiName = chatItem.remark || chatItem.name || 'AI';
                
                // 【优化】构建完整的系统提示词，包含人设和世界书
                let systemPrompt = `本次是线上语音通话，和你交流时请注意以下要求：
1. 全程不用描述任何动作语句，不使用括号，不添加任何动作描述
2. 尽量简单易懂，表达清晰直接，围绕话题沟通
3. 只说你想说的话，保持自然、真实的对话语气
4. 记住对方的昵称是"${userNickname}"，在对话中可以自然地称呼对方

你是${aiName}，现在正在和用户进行语音通话。请以自然、亲切的语气回应，就像真实的电话通话一样。`;
                
                // 【优化】添加人设信息
                if (chatItem.personality) {
                    systemPrompt += `\n\n【你的人设】\n${chatItem.personality}`;
                }
                
                // 【优化】添加世界书内容
                if (chatItem.worldbooks && Array.isArray(chatItem.worldbooks) && chatItem.worldbooks.length > 0) {
                    let worldbookContent = '';
                    chatItem.worldbooks.forEach(id => {
                        const worldbook = relationshipData.worldBooks.find(book => book.id == id);
                        if (worldbook && worldbook.content) {
                            worldbookContent += worldbook.content + '\n\n';
                        }
                    });
                    if (worldbookContent) {
                        systemPrompt += `\n\n【世界书设定】\n${worldbookContent.trim()}`;
                    }
                }
                
                // 构建用户提示词
                let prompt = '';
                
                // 【修复】使用聊天设置中的memoryMountCount（默认5条，与聊天页面一致）
                const memoryMountCount = chatItem.memoryMountCount || 5;
                if (chatItem.memories && Array.isArray(chatItem.memories) && chatItem.memories.length > 0) {
                    prompt += `【长期记忆 - 共${chatItem.memories.length}条，挂载最近${memoryMountCount}条】\n`;
                    const recentMemories = chatItem.memories.slice(-memoryMountCount);
                    recentMemories.forEach((memory, index) => {
                        prompt += `${index + 1}. ${memory.content}\n`;
                    });
                    prompt += '\n';
                }
                
                // 【修复】使用聊天设置中的contextLength（默认20条，与聊天页面一致）
                const contextLength = chatItem.contextLength || 20;
                const allChatMessages = relationshipData.chatMessages
                    .filter(msg => msg.chatId == currentChatId);
                
                // 【改进】分离历史消息和当前消息
                const historyLength = Math.min(allChatMessages.length, contextLength);
                const historyMessages = allChatMessages.slice(-historyLength);
                
                if (historyMessages.length > 0) {
                    prompt += `【历史聊天记录 - 要结合上下文回复】\n`;
                    prompt += `==============================\n`;
                    prompt += `以下是你和用户的完整对话历史，回复时必须结合这些上下文：\n`;
                    prompt += `- 理解对话的连贯性和话题发展\n`;
                    prompt += `- 参考之前的讨论内容做出相关回应\n`;
                    prompt += `- 不要重复回复已经回复过的内容\n\n`;
                    historyMessages.forEach(msg => {
                        let contentStr = ensureStringContent(msg.content);
                        // 【关键修复】移除HTML标签
                        contentStr = contentStr.replace(/<[^>]*>/g, '');
                        // 【关键修复】移除音频数据（data:audio/...）
                        contentStr = contentStr.replace(/data:audio\/[^\s]+/g, '[语音消息]');
                        // 【关键修复】如果是语音消息类型，显示转文字内容或占位符
                        if (msg.type === 'voice' || contentStr.includes('transcript=')) {
                            const transcriptMatch = contentStr.match(/transcript=([^&]+)/);
                            if (transcriptMatch) {
                                contentStr = `[语音消息：${decodeURIComponent(transcriptMatch[1])}]`;
                            } else {
                                contentStr = '[语音消息]';
                            }
                        }
                        const sender = msg.sender === 'user' ? userNickname : aiName;
                        const msgTime = msg.timestamp ? new Date(msg.timestamp).toLocaleTimeString('zh-CN', {hour: '2-digit', minute: '2-digit'}) : '';
                        
                        // 【修复】处理引用信息，如果消息包含引用，显示引用内容
                        let quoteText = '';
                        if (msg.quote && msg.quote.content) {
                            // 【修复】支持没有发送者名称的引用
                            quoteText = msg.quote.senderName ? 
                                `[引用 ${msg.quote.senderName}: ${msg.quote.content}] ` :
                                `[引用 ${msg.quote.content}] `;
                        }
                        
                        prompt += `${sender} [${msgTime}]：${quoteText}${contentStr}\n`;
                    });
                    prompt += `==============================\n\n`;
                }
                
                // 【优化】添加本次通话记录（作为历史上下文）
                if (voiceCallState.callMessages && voiceCallState.callMessages.length > 1) {
                    prompt += `【本次通话记录 - 历史上下文】\n`;
                    prompt += `==============================\n`;
                    // 获取除最后一条（刚添加的用户消息）之外的所有消息
                    const callHistory = voiceCallState.callMessages.slice(0, -1);
                    callHistory.forEach(msg => {
                        let content = msg.content || '';
                        // 【关键修复】移除音频数据（data:audio/...）
                        if (content.includes('data:audio/')) {
                            content = content.replace(/data:audio\/[^\s]+/g, '[语音消息]');
                        }
                        const sender = msg.sender === 'user' ? userNickname : aiName;
                        const msgTime = msg.timestamp ? new Date(msg.timestamp).toLocaleTimeString('zh-CN', {hour: '2-digit', minute: '2-digit'}) : '';
                        prompt += `${sender} [${msgTime}]：${content}\n`;
                    });
                    prompt += `==============================\n\n`;
                }
                
                // 【改进】明确标记当前需要回复的消息
                prompt += `>>> 当前需要回复的新消息 <<<\n`;
                prompt += `${userNickname}：${text}\n\n`;
                
                prompt += `【当前时间】${new Date().toLocaleString('zh-CN')}\n\n`;
                
                prompt += `请回复"当前需要回复的新消息"部分的内容。要求：
1. 回复要自然、亲切，就像真实电话通话一样
2. 记住对方昵称是"${userNickname}"，可以自然地称呼对方
3. 不用感到拘束，你是绝对自由的，可以表达爱意和关怀
4. 直接说出回复内容，不要加任何前缀或格式
5. 不要重复回复已经回复过的内容`;

                // 【新增】显示思考状态
                showThinkingStatus();
                
                // 【优化】使用带system prompt的API调用
                const aiResponse = await callAIDirectlyWithSystemPrompt(systemPrompt, prompt);
                
                console.log('【语音通话】AI完整回复:', aiResponse);
                console.log('【语音通话】AI回复长度:', aiResponse.length);
                
                // 【调试】检查是否包含音频数据
                if (aiResponse.includes('data:audio/')) {
                    console.warn('【语音通话】AI回复包含data:audio/！');
                    console.warn('【语音通话】音频数据位置:', aiResponse.indexOf('data:audio/'));
                }
                
                // 【新增】隐藏思考状态
                hideThinkingStatus();
                
                // 记录AI回复
                voiceCallState.callMessages.push({
                    sender: 'ai',
                    content: aiResponse,
                    timestamp: Date.now()
                });
                
                // 显示AI回复在通话界面
                showAIResponse(aiResponse);
                
                // 语音通话的消息不保存到聊天记录，只在通话界面显示
                
            } catch (error) {
                console.error('发送给AI失败:', error);
            }
        }

        // 结束语音通话
        function endVoiceCall() {
            // 停止录音
            if (voiceCallState.isMicOn) {
                stopRecording();
            }
            
            // 停止计时
            stopCallTimer();
            
            // 获取通话时长
            const duration = getCallDuration();
            
            // 发送通话状态消息
            if (voiceCallState.callType === 'outgoing') {
                // 我打过去的
                if (voiceCallState.isWaiting) {
                    // 还在等待中，取消通话
                    displayCallStatusMessage('user', '已取消通话', 'cancel');
                } else {
                    // 已接通，显示通话时长
                    displayCallStatusMessage('user', `通话时长 ${duration}`, 'duration');
                    // 已接通的通话需要总结
                    summarizeCallContent(duration);
                }
            } else {
                // AI打过来的
                if (voiceCallState.isWaiting) {
                    // AI拒绝通话
                    displayCallStatusMessage('ai', '已拒绝通话', 'reject');
                } else {
                    // 已接通，显示通话时长
                    displayCallStatusMessage('ai', `通话时长 ${duration}`, 'duration');
                    // 已接通的通话需要总结
                    summarizeCallContent(duration);
                }
            }
            
            // 重置状态
            voiceCallState.isActive = false;
            voiceCallState.isWaiting = false;
            voiceCallState.isConnected = false;
            voiceCallState.isMicOn = false;
            voiceCallState.isTextInputVisible = false;
            voiceCallState.startTime = null;
            
            // 隐藏页面
            document.getElementById('voiceCallPage').style.display = 'none';
        }

        // 总结通话内容
        async function summarizeCallContent(duration) {
            // 检查是否有通话内容
            if (voiceCallState.callMessages.length === 0) {
                console.log('没有通话内容需要总结');
                return;
            }
            
            // 显示正在总结的弹窗
            showSummarizingDialog();
            
            try {
                // 【修复】获取当前角色信息
                const chatItem = relationshipData.wechatChatList.find(item => item.id == currentChatId);
                const aiName = chatItem ? (chatItem.remark || chatItem.name || 'AI') : 'AI';
                const userName = '我';
                
                // 构建通话内容
                const callContent = voiceCallState.callMessages.map(msg => {
                    const sender = msg.sender === 'user' ? userName : aiName;
                    const time = new Date(msg.timestamp).toLocaleTimeString('zh-CN', { hour: '2-digit', minute: '2-digit' });
                    // 确保 content 是字符串
                    const contentStr = ensureStringContent(msg.content);
                    return `[${time}] ${sender}: ${contentStr}`;
                }).join('\n');
                
                // 构建总结提示词
                const prompt = `你是${aiName}，请从你自己的第一人称视角总结这次语音通话的内容。

要求：
1. 以"我"（${aiName}）的口吻来总结，就像你在写日记或回忆录一样
2. 记录${userName}和你聊了什么话题
3. 描述你的感受和想法
4. 记录重要的约定或决定
5. 用自然、亲切的语气，不要太正式
6. 字数控制在200字左右

通话时长：${duration}

通话内容：
${callContent}

请以第一人称总结这次通话：`;
                
                // 调用API进行总结
                const summary = await callAIDirectlyWithoutDisplay(prompt);
                
                // 隐藏正在总结的弹窗
                hideSummarizingDialog();
                
                // 【新增】将通话总结保存为隐藏的AI消息（AI能看到，用户看不到）
                const summaryMessage = {
                    sender: 'ai',
                    content: `[通话总结] ${summary}`,
                    timestamp: Date.now(),
                    chatId: currentChatId,
                    type: 'hidden', // 标记为隐藏消息，不在界面显示
                    isCallSummary: true // 标记为通话总结
                };
                
                // 保存到消息记录（用于AI上下文）
                try {
                    await ChatMessageManager.saveMessage(summaryMessage);
                    console.log('【通话总结】已保存为隐藏消息');
                } catch (error) {
                    console.error('【通话总结】保存失败:', error);
                    // 降级到内存
                    relationshipData.chatMessages.push(summaryMessage);
                }
                
                // 保存通话记录（用于通话记录页面显示）
                saveCallRecord(duration, summary);
                
            } catch (error) {
                console.error('总结通话内容失败:', error);
                
                // 隐藏正在总结的弹窗
                hideSummarizingDialog();
                
                // 询问用户是否重新总结
                if (confirm('总结通话内容失败，是否重新总结？')) {
                    summarizeCallContent(duration);
                }
            }
        }

        // 显示正在总结的弹窗
        function showSummarizingDialog() {
            const dialog = document.createElement('div');
            dialog.id = 'summarizingDialog';
            dialog.style.cssText = `
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background: rgba(0, 0, 0, 0.5);
                display: flex;
                align-items: center;
                justify-content: center;
                z-index: 100000;
            `;
            
            dialog.innerHTML = `
                <div style="background: white; padding: 30px; border-radius: 10px; text-align: center; max-width: 300px;">
                    <div style="font-size: 18px; margin-bottom: 20px;">正在总结语音通话内容...</div>
                    <div style="width: 40px; height: 40px; border: 4px solid #f3f3f3; border-top: 4px solid #3498db; border-radius: 50%; animation: spin 1s linear infinite; margin: 0 auto;"></div>
                </div>
                <style>
                    @keyframes spin {
                        0% { transform: rotate(0deg); }
                        100% { transform: rotate(360deg); }
                    }
                </style>
            `;
            
            document.body.appendChild(dialog);
        }

        // 隐藏正在总结的弹窗
        function hideSummarizingDialog() {
            const dialog = document.getElementById('summarizingDialog');
            if (dialog) {
                document.body.removeChild(dialog);
            }
        }

        // 保存通话记录
        async function saveCallRecord(duration, summary) {
            const chatItem = relationshipData.wechatChatList.find(item => item.id == currentChatId);
            if (!chatItem) return;
            
            // 获取现有通话记录（每个AI角色独立存储）
            let callRecords = [];
            try {
                // 【优先使用 SQLite】
                if (SQLiteManager.isAvailable) {
                    callRecords = await SQLiteManager.getCallRecordsForChat(currentChatId) || [];
                    console.log('✅ 使用 SQLite 获取通话记录');
                } else {
                    const callRecordsKey = `callRecords_${currentChatId}`;
                    callRecords = await localforage.getItem(callRecordsKey) || [];
                    console.log('✅ 使用 localforage 获取通话记录（降级方案）');
                }
            } catch (e) {
                console.error('解析通话记录失败:', e);
                callRecords = [];
            }
            
            // 创建通话记录
            const record = {
                id: Date.now(),
                chatId: currentChatId,
                chatName: chatItem.remark || chatItem.name || 'AI',
                chatAvatar: chatItem.avatar || '',
                duration: duration,
                summary: summary,
                callDate: new Date().toLocaleDateString('zh-CN'),
                callTime: new Date().toLocaleTimeString('zh-CN', { hour: '2-digit', minute: '2-digit' }),
                timestamp: Date.now()
            };
            
            // 添加到记录列表
            callRecords.unshift(record);
            
            // 【优先使用 SQLite】保存通话记录
            let saveSuccess = false;
            if (SQLiteManager.isAvailable) {
                saveSuccess = await SQLiteManager.saveCallRecordsForChat(currentChatId, callRecords);
                if (saveSuccess) {
                    console.log('✅ 使用 SQLite 保存通话记录成功');
                }
            }
            
            // 降级到 localforage
            if (!saveSuccess) {
                const callRecordsKey = `callRecords_${currentChatId}`;
                await localforage.setItem(callRecordsKey, callRecords);
                console.log('✅ 使用 localforage 保存通话记录成功（降级方案）');
            }
            
            console.log('通话记录已保存:', record);
        }

        // 打开通话记录页面
        function openCallRecordsPage() {
            const callRecordsPage = document.getElementById('callRecordsPage');
            callRecordsPage.style.display = 'flex';
            
            // 加载通话记录
            loadCallRecords();
        }

        // 关闭通话记录页面
        function closeCallRecordsPage() {
            const callRecordsPage = document.getElementById('callRecordsPage');
            callRecordsPage.style.display = 'none';
        }

        // 打开长期记忆页面
        function openMemoryPage() {
            const memoryPage = document.getElementById('memoryPage');
            memoryPage.style.display = 'flex';

            // 【性能优化】先显示页面，再异步加载记忆数据
            requestAnimationFrame(() => {
                // 加载长期记忆（异步）
                loadMemoriesAsync();
                // 更新消息计数器
                updateMemoryMessageCounter();
            });
        }

        // 更新消息计数器显示
        function updateMemoryMessageCounter() {
            console.log('=== 更新消息计数器 ===');

            if (!currentChatId) {
                console.log('❌ 没有当前聊天ID');
                return;
            }

            const chatItem = relationshipData.wechatChatList.find(item => item.id == currentChatId);
            if (!chatItem) {
                console.log('❌ 未找到当前聊天项');
                return;
            }

            // 确保计数器字段存在
            if (typeof chatItem.totalMessageCount !== 'number') {
                chatItem.totalMessageCount = 0;
            }
            if (typeof chatItem.summarizedMessageCount !== 'number') {
                chatItem.summarizedMessageCount = 0;
            }

            const total = chatItem.totalMessageCount;
            const summarized = chatItem.summarizedMessageCount;
            // 【修复】确保待总结消息数不会小于0
            const pending = Math.max(0, total - summarized);

            // 更新显示
            document.getElementById('counterTotal').textContent = total;
            document.getElementById('counterSummarized').textContent = summarized;
            document.getElementById('counterPending').textContent = pending;

            console.log('消息统计 - 总消息:', total, '已总结:', summarized, '待总结:', pending);
        }

        // 关闭长期记忆页面
        function closeMemoryPage() {
            const memoryPage = document.getElementById('memoryPage');
            memoryPage.style.display = 'none';
        }

        // 当前查看的记忆ID
        let currentViewingMemoryId = null;

        // 打开记忆详情
        function openMemoryDetail(memoryId) {
            const modal = document.getElementById('memoryDetailModal');
            const title = document.getElementById('memoryDetailTitle');
            const content = document.getElementById('memoryDetailContent');
            const summaryText = document.getElementById('memoryDetailSummaryText');

            // 保存当前查看的记忆ID
            currentViewingMemoryId = memoryId;

            // 获取记忆详情
            if (currentChatId) {
                const chatItem = relationshipData.wechatChatList.find(item => item.id == currentChatId);
                if (chatItem && chatItem.memories && Array.isArray(chatItem.memories)) {
                    const memory = chatItem.memories.find(m => m.id == memoryId);
                    if (memory) {
                        title.textContent = '记忆详情';
                        content.innerHTML = memory.content;

                        // 显示摘要（用于AI索引）
                        if (summaryText) {
                            summaryText.textContent = memory.summary || '暂无摘要';
                        }

                        console.log('打开记忆详情:', {
                            id: memory.id,
                            summary: memory.summary,
                            content: memory.content.substring(0, 50) + '...'
                        });

                        modal.style.display = 'block';
                    }
                }
            }
        }

        // 删除记忆
        async function deleteMemory() {
            if (!currentViewingMemoryId || !currentChatId) {
                alert('无法删除：未找到记忆信息');
                return;
            }

            // 确认删除
            if (!confirm('确定要删除这条记忆吗？此操作不可恢复。')) {
                return;
            }

            const chatItem = relationshipData.wechatChatList.find(item => item.id == currentChatId);
            if (!chatItem || !chatItem.memories) {
                alert('无法删除：未找到聊天数据');
                return;
            }

            // 找到要删除的记忆
            const memoryIndex = chatItem.memories.findIndex(m => m.id == currentViewingMemoryId);
            if (memoryIndex === -1) {
                alert('无法删除：未找到记忆');
                return;
            }

            // 获取记忆的消息数量
            const deletedMemory = chatItem.memories[memoryIndex];

            // 删除记忆
            chatItem.memories.splice(memoryIndex, 1);

            // 【修复】删除记忆时不减少summarizedMessageCount
            // 因为消息本身还存在，只是记忆被删除了
            // 如果减少计数，会导致这些消息被重新总结

            // 保存数据
            await saveData();

            // 关闭弹窗
            closeMemoryDetail();

            // 刷新记忆列表
            loadMemories();

            // 更新消息计数器
            updateMemoryMessageCounter();

            console.log('记忆已删除:', currentViewingMemoryId);
            alert('记忆已删除');
        }

        // 关闭记忆详情
        function closeMemoryDetail() {
            const modal = document.getElementById('memoryDetailModal');
            modal.style.display = 'none';
            // 重置当前查看的记忆ID
            currentViewingMemoryId = null;
        }

        // 打开添加记忆弹窗
        function openAddMemoryModal() {
            const modal = document.getElementById('addMemoryModal');
            modal.style.display = 'block';
            
            // 设置默认时间为当前时间
            const now = new Date();
            const year = now.getFullYear();
            const month = String(now.getMonth() + 1).padStart(2, '0');
            const day = String(now.getDate()).padStart(2, '0');
            const hours = String(now.getHours()).padStart(2, '0');
            const minutes = String(now.getMinutes()).padStart(2, '0');
            
            const startTime = `${year}-${month}-${day}T${hours}:${minutes}`;
            document.getElementById('memoryStartTime').value = startTime;
            
            // 结束时间默认为开始时间后1小时
            const endTime = new Date(now.getTime() + 60 * 60 * 1000);
            const endHours = String(endTime.getHours()).padStart(2, '0');
            const endMinutes = String(endTime.getMinutes()).padStart(2, '0');
            const endTimeStr = `${year}-${month}-${day}T${endHours}:${endMinutes}`;
            document.getElementById('memoryEndTime').value = endTimeStr;
        }

        // 关闭添加记忆弹窗
        function closeAddMemoryModal() {
            const modal = document.getElementById('addMemoryModal');
            modal.style.display = 'none';
            
            // 清空表单
            document.getElementById('memoryStartTime').value = '';
            document.getElementById('memoryEndTime').value = '';
            document.getElementById('memoryDescription').value = '';
            document.getElementById('memorySummary').value = '';
        }

        // 保存记忆
        function saveMemory() {
            const startTime = document.getElementById('memoryStartTime').value;
            const endTime = document.getElementById('memoryEndTime').value;
            const description = document.getElementById('memoryDescription').value.trim();
            const summary = document.getElementById('memorySummary').value.trim();
            
            // 验证输入
            if (!startTime) {
                alert('请选择开始时间');
                return;
            }
            if (!endTime) {
                alert('请选择结束时间');
                return;
            }
            if (!description) {
                alert('请输入记忆内容');
                return;
            }
            if (new Date(startTime) > new Date(endTime)) {
                alert('结束时间不能早于开始时间');
                return;
            }
            
            // 格式化时间显示
            const startDate = new Date(startTime);
            const endDate = new Date(endTime);
            const timeText = `${formatDateTime(startDate)} - ${formatDateTime(endDate)}`;
            
            // 创建记忆对象
            const memory = {
                id: Date.now(),
                startTime: new Date(startTime).getTime(), // 【修复】统一使用数字时间戳
                endTime: new Date(endTime).getTime(), // 【修复】统一使用数字时间戳
                timeText: timeText,
                content: description,
                summary: summary || description.substring(0, 30) // 摘要字段，用于AI索引搜索
            };
            
            // 保存到当前聊天的记忆列表
            if (currentChatId) {
                const chatItem = relationshipData.wechatChatList.find(item => item.id == currentChatId);
                if (chatItem) {
                    if (!chatItem.memories) {
                        chatItem.memories = [];
                    }
                    chatItem.memories.push(memory);
                    
                    // 保存到本地存储
                    localforage.setItem('relationshipData', relationshipData).then(() => {
                        console.log('记忆保存成功');
                        
                        // 重新加载记忆列表
                        loadMemories();
                        
                        // 关闭弹窗
                        closeAddMemoryModal();
                    }).catch(err => {
                        console.error('保存记忆失败:', err);
                        alert('保存失败，请重试');
                    });
                }
            } else {
                alert('请先选择一个聊天');
            }
        }

        // 格式化日期时间
        function formatDateTime(date) {
            const year = date.getFullYear();
            const month = String(date.getMonth() + 1).padStart(2, '0');
            const day = String(date.getDate()).padStart(2, '0');
            const hours = String(date.getHours()).padStart(2, '0');
            const minutes = String(date.getMinutes()).padStart(2, '0');
            return `${year}年${month}月${day}日 ${hours}:${minutes}`;
        }

        // 立即总结记忆
        async function immediateSummarizeMemory() {
            if (!currentChatId) {
                alert('请先选择一个聊天');
                return;
            }
            
            const chatItem = relationshipData.wechatChatList.find(item => item.id == currentChatId);
            if (!chatItem) {
                alert('未找到当前聊天');
                return;
            }
            
            // 【修复】获取设置的总结频率（优先从chatItem读取，如果没有则从DOM读取）
            let frequency = chatItem.memorySummaryFrequency;
            if (!frequency || frequency < 1) {
                frequency = parseInt(document.getElementById('memorySummaryFrequency')?.value || 20);
            }
            
            // 确保totalMessageCount存在
            if (typeof chatItem.totalMessageCount !== 'number') {
                chatItem.totalMessageCount = 0;
            }
            
            // 确保summarizedMessageCount存在
            if (typeof chatItem.summarizedMessageCount !== 'number') {
                chatItem.summarizedMessageCount = 0;
            }
            
            // 如果没有memories数组，初始化它
            if (!chatItem.memories) {
                chatItem.memories = [];
            }
            
            // 【关键修复】使用 ChatMessageManager 获取所有聊天消息（从SQLite/IndexedDB读取，而不是内存中的Proxy数组）
            let allChatMessages = [];
            try {
                allChatMessages = await ChatMessageManager.getAllMessages(currentChatId);
                console.log('【修复】从存储获取消息数:', allChatMessages.length);
            } catch (e) {
                console.warn('【修复】从存储获取消息失败，使用内存数据:', e);
                allChatMessages = relationshipData.chatMessages.filter(msg => msg.chatId == currentChatId);
            }
            
            // 【修复】确保summarizedMessageCount不会大于实际消息数量
            if (chatItem.summarizedMessageCount > allChatMessages.length) {
                console.log('【修复】summarizedMessageCount 大于实际消息数量，重置为:', allChatMessages.length);
                chatItem.summarizedMessageCount = allChatMessages.length;
            }
            
            // 【修复】计算未总结的消息数量
            const unsummarizedCount = chatItem.totalMessageCount - chatItem.summarizedMessageCount;
            
            // 【修复】只总结未总结的消息，一次性总结所有累积的未总结消息
            const startIndex = chatItem.summarizedMessageCount;
            const maxMessagesToSummarize = Math.min(unsummarizedCount, frequency * 2); // 最多总结frequency*2条
            const endIndex = Math.min(startIndex + maxMessagesToSummarize, allChatMessages.length);
            const messagesToSummarize = allChatMessages.slice(startIndex, endIndex);
            
            // 检查是否有消息需要总结
            if (messagesToSummarize.length === 0) {
                alert('当前没有需要总结的新消息');
                return;
            }
            
            // 确认是否总结
            const confirmMsg = `即将总结 ${messagesToSummarize.length} 条未总结的消息，是否继续？`;
            if (!confirm(confirmMsg)) {
                return;
            }
            
            // 调用总结函数
            try {
                await summarizeMemory(messagesToSummarize, chatItem);
                
                // 总结成功后，重新加载记忆列表
                loadMemories();
                
                alert('记忆总结成功！');
            } catch (error) {
                console.error('立即总结记忆失败:', error);
                alert('记忆总结失败：' + error.message);
            }
        }

        // 加载长期记忆
        function loadMemories() {
            const content = document.getElementById('memoryContent');
            content.innerHTML = '';
            
            console.log('【调试】loadMemories 被调用，currentChatId:', currentChatId);
            
            if (currentChatId) {
                const chatItem = relationshipData.wechatChatList.find(item => item.id == currentChatId);
                console.log('【调试】找到聊天项:', chatItem ? chatItem.name : '未找到');
                console.log('【调试】memories:', chatItem?.memories);
                
                if (chatItem && chatItem.memories && Array.isArray(chatItem.memories) && chatItem.memories.length > 0) {
                    console.log('【调试】原始记忆数量:', chatItem.memories.length);
                    console.log('【调试】原始记忆:', chatItem.memories.map(m => ({ id: m.id, startTime: m.startTime, timeText: m.timeText })));
                    
                    // 【修复】按时间倒序排序（新的在上面），使用startTime字段
                    const sortedMemories = [...chatItem.memories].sort((a, b) => {
                        // 【兼容性处理】统一转换为数字时间戳
                        let timeA = a.startTime || a.id || 0;
                        let timeB = b.startTime || b.id || 0;
                        
                        // 如果是字符串（旧数据格式），转换为数字
                        if (typeof timeA === 'string') {
                            timeA = new Date(timeA).getTime() || 0;
                        }
                        if (typeof timeB === 'string') {
                            timeB = new Date(timeB).getTime() || 0;
                        }
                        
                        console.log('【调试】排序比较:', { a: timeA, b: timeB, result: timeB - timeA });
                        return timeB - timeA; // 倒序：新的在前
                    });
                    
                    console.log('【调试】排序后记忆:', sortedMemories.map(m => ({ id: m.id, startTime: m.startTime, timeText: m.timeText })));
                    
                    sortedMemories.forEach(memory => {
                        const card = document.createElement('div');
                        card.className = 'memory-card';
                        card.onclick = () => openMemoryDetail(memory.id);
                        
                        const timeText = document.createElement('div');
                        timeText.className = 'memory-card-time';
                        timeText.textContent = memory.timeText;
                        
                        card.appendChild(timeText);
                        
                        // 添加摘要显示
                        if (memory.summary) {
                            const summaryText = document.createElement('div');
                            summaryText.className = 'memory-card-summary';
                            summaryText.textContent = memory.summary;
                            card.appendChild(summaryText);
                        }
                        
                        content.appendChild(card);
                    });
                } else {
                    content.innerHTML = '<div style="grid-column: 1/-1; text-align: center; color: #999; padding: 40px;">暂无美好记忆</div>';
                }
            } else {
                content.innerHTML = '<div style="grid-column: 1/-1; text-align: center; color: #999; padding: 40px;">请先选择一个聊天</div>';
            }
        }

        // 【性能优化】异步加载长期记忆，避免阻塞主线程
        async function loadMemoriesAsync() {
            const content = document.getElementById('memoryContent');
            content.innerHTML = '';
            
            console.log('【调试】loadMemoriesAsync 被调用，currentChatId:', currentChatId);
            
            if (currentChatId) {
                const chatItem = relationshipData.wechatChatList.find(item => item.id == currentChatId);
                console.log('【调试】找到聊天项:', chatItem ? chatItem.name : '未找到');
                
                if (chatItem && chatItem.memories && Array.isArray(chatItem.memories) && chatItem.memories.length > 0) {
                    console.log('【调试】原始记忆数量:', chatItem.memories.length);
                    
                    // 【修复】按时间倒序排序（新的在上面），使用startTime字段
                    const sortedMemories = [...chatItem.memories].sort((a, b) => {
                        let timeA = a.startTime || a.id || 0;
                        let timeB = b.startTime || b.id || 0;
                        
                        if (typeof timeA === 'string') {
                            timeA = new Date(timeA).getTime() || 0;
                        }
                        if (typeof timeB === 'string') {
                            timeB = new Date(timeB).getTime() || 0;
                        }
                        
                        return timeB - timeA;
                    });
                    
                    // 【性能优化】分批渲染记忆卡片，每批5个
                    const batchSize = 5;
                    for (let i = 0; i < sortedMemories.length; i += batchSize) {
                        const batch = sortedMemories.slice(i, i + batchSize);
                        
                        batch.forEach(memory => {
                            const card = document.createElement('div');
                            card.className = 'memory-card';
                            card.onclick = () => openMemoryDetail(memory.id);
                            
                            const timeText = document.createElement('div');
                            timeText.className = 'memory-card-time';
                            timeText.textContent = memory.timeText;
                            
                            card.appendChild(timeText);
                            
                            // 添加摘要显示
                            if (memory.summary) {
                                const summaryText = document.createElement('div');
                                summaryText.className = 'memory-card-summary';
                                summaryText.textContent = memory.summary;
                                card.appendChild(summaryText);
                            }
                            
                            content.appendChild(card);
                        });
                        
                        // 【关键】让出主线程，让浏览器有时间渲染
                        if (i + batchSize < sortedMemories.length) {
                            await new Promise(resolve => setTimeout(resolve, 0));
                        }
                    }
                } else {
                    content.innerHTML = '<div style="grid-column: 1/-1; text-align: center; color: #999; padding: 40px;">暂无美好记忆</div>';
                }
            } else {
                content.innerHTML = '<div style="grid-column: 1/-1; text-align: center; color: #999; padding: 40px;">请先选择一个聊天</div>';
            }
        }

        // 加载通话记录
        async function loadCallRecords() {
            const content = document.getElementById('callRecordsContent');
            content.innerHTML = '';
            
            // 获取当前AI角色的通话记录
            let callRecords = [];
            try {
                // 【优先使用 SQLite】
                if (SQLiteManager.isAvailable) {
                    callRecords = await SQLiteManager.getCallRecordsForChat(currentChatId) || [];
                    console.log('✅ 使用 SQLite 加载通话记录');
                } else {
                    const callRecordsKey = `callRecords_${currentChatId}`;
                    callRecords = await localforage.getItem(callRecordsKey) || [];
                    console.log('✅ 使用 localforage 加载通话记录（降级方案）');
                }
            } catch (e) {
                console.error('解析通话记录失败:', e);
                callRecords = [];
            }
            
            if (callRecords.length === 0) {
                content.innerHTML = `
                    <div style="text-align: center; color: rgba(255, 255, 255, 0.7); padding: 50px 20px;">
                        <div style="margin-bottom: 20px;">
                            <img src="https://img.58sb.cn/file/img/khfRtYaF.jpg" alt="电话" style="width: 60px; height: 60px;">
                        </div>
                        <div style="font-size: 18px;">暂无通话记录</div>
                    </div>
                `;
                
                // 更新通话统计
                updateCallStatistics(0, 0);
                return;
            }
            
            // 生成通话记录卡片
            callRecords.forEach(record => {
                const card = document.createElement('div');
                card.className = 'call-record-card';
                card.onclick = (e) => {
                    if (!e.target.classList.contains('call-record-share-btn')) {
                        showCallRecordDetail(record);
                    }
                };
                
                card.innerHTML = `
                    <button class="call-record-share-btn" onclick="shareCallRecord(${record.id}, event)">📤</button>
                    <div class="call-record-card-header">
                        <div class="call-record-avatar">
                            ${record.chatAvatar ? `<img src="${record.chatAvatar}" style="width: 100%; height: 100%; border-radius: 10px; object-fit: cover;">` : '🤖'}
                        </div>
                        <div class="call-record-info">
                            <div class="call-record-name">${record.chatName}</div>
                            <div class="call-record-time">
                                ${record.callDate} ${record.callTime}
                                <span class="call-record-duration">通话时长 ${record.duration}</span>
                            </div>
                        </div>
                    </div>
                `;
                
                content.appendChild(card);
            });
            
            // 更新通话统计
            updateCallStatistics(callRecords.length, callRecords);
        }

        // 更新通话统计
        function updateCallStatistics(count, records) {
            const totalCallCount = document.getElementById('totalCallCount');
            const totalCallDuration = document.getElementById('totalCallDuration');
            
            if (totalCallCount) {
                totalCallCount.textContent = count;
            }
            
            if (totalCallDuration && records.length > 0) {
                // 计算总通话时长
                let totalSeconds = 0;
                records.forEach(record => {
                    const durationParts = record.duration.split(':');
                    if (durationParts.length === 2) {
                        totalSeconds += parseInt(durationParts[0]) * 60 + parseInt(durationParts[1]);
                    } else if (durationParts.length === 3) {
                        totalSeconds += parseInt(durationParts[0]) * 3600 + parseInt(durationParts[1]) * 60 + parseInt(durationParts[2]);
                    }
                });
                
                // 格式化总时长
                const hours = Math.floor(totalSeconds / 3600);
                const minutes = Math.floor((totalSeconds % 3600) / 60);
                const seconds = totalSeconds % 60;
                
                let durationText = '';
                if (hours > 0) {
                    durationText += `${hours}小时`;
                }
                if (minutes > 0) {
                    durationText += `${minutes}分钟`;
                }
                if (seconds > 0 || durationText === '') {
                    durationText += `${seconds}秒`;
                }
                
                totalCallDuration.textContent = durationText;
            } else if (totalCallDuration) {
                totalCallDuration.textContent = '0秒';
            }
        }

        // 显示通话记录详情
        function showCallRecordDetail(record) {
            const modal = document.getElementById('callRecordDetailModal');
            const title = document.getElementById('callRecordDetailTitle');
            const content = document.getElementById('callRecordDetailContent');
            
            title.textContent = `通话记录 - ${record.chatName}`;
            
            content.innerHTML = `
                <div style="margin-bottom: 20px;">
                    <div style="font-weight: bold; margin-bottom: 10px; color: #333;">通话信息</div>
                    <div style="color: #666; line-height: 1.8;">
                        <div><strong>联系人：</strong>${record.chatName}</div>
                        <div><strong>通话时间：</strong>${record.callDate} ${record.callTime}</div>
                        <div><strong>通话时长：</strong>${record.duration}</div>
                    </div>
                </div>
                <div>
                    <div style="font-weight: bold; margin-bottom: 10px; color: #333;">通话总结</div>
                    <div style="color: #333; line-height: 1.8; white-space: pre-wrap;">${record.summary}</div>
                </div>
            `;
            
            modal.style.display = 'flex';
        }

        // 关闭通话记录详情
        function closeCallRecordDetail() {
            const modal = document.getElementById('callRecordDetailModal');
            modal.style.display = 'none';
        }

        // 分享通话记录
        async function shareCallRecord(recordId, event) {
            event.stopPropagation();
            
            // 获取通话记录
            let callRecords = [];
            try {
                const callRecordsKey = `callRecords_${currentChatId}`;
                callRecords = await localforage.getItem(callRecordsKey) || [];
            } catch (e) {
                console.error('解析通话记录失败:', e);
                return;
            }
            
            const record = callRecords.find(r => r.id === recordId);
            if (!record) return;
            
            // 构建分享内容
            const shareContent = `【通话记录分享】
联系人：${record.chatName}
通话时间：${record.callDate} ${record.callTime}
通话时长：${record.duration}

通话总结：
${record.summary}`;
            
            // 在聊天界面中显示分享提示框
            showShareNotification(record);
        }

        // 显示分享提示框
        function showShareNotification(record) {
            const chatContent = document.getElementById('chatContent');
            if (!chatContent) return;
            
            // 创建分享提示容器
            const shareContainer = document.createElement('div');
            shareContainer.className = 'share-notification-container';
            
            // 设置样式：居中，类似撤回消息的样式
            shareContainer.style.cssText = `
                display: flex;
                justify-content: center;
                margin: 10px 0;
            `;
            
            // 创建分享提示框
            const shareBox = document.createElement('div');
            shareBox.className = 'share-notification-box';
            shareBox.style.cssText = `
                background-color: rgba(255, 255, 255, 0.3);
                color: #999;
                padding: 8px 16px;
                border-radius: 12px;
                font-size: 13px;
                cursor: pointer;
                user-select: none;
                transition: background-color 0.2s;
            `;
            
            // 设置提示文字
            const messageText = `我已将${record.callDate} ${record.callTime}的通话记录分享给AI ${record.chatName}`;
            shareBox.textContent = messageText;
            
            // 存储分享信息到dataset
            shareContainer.dataset.recordId = record.id;
            shareContainer.dataset.chatName = record.chatName;
            shareContainer.dataset.callDate = record.callDate;
            shareContainer.dataset.callTime = record.callTime;
            shareContainer.dataset.duration = record.duration;
            shareContainer.dataset.summary = record.summary;
            
            // 添加点击事件，显示通话记录详情
            shareBox.addEventListener('click', function() {
                // 创建弹窗显示通话记录详情
                const contentPopup = document.createElement('div');
                contentPopup.style.cssText = `
                    position: fixed;
                    top: 50%;
                    left: 50%;
                    transform: translate(-50%, -50%);
                    background-color: white;
                    border-radius: 12px;
                    padding: 20px;
                    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
                    z-index: 10000;
                    max-width: 80%;
                    max-height: 80%;
                    overflow-y: auto;
                `;
                
                contentPopup.innerHTML = `
                    <div style="font-weight: 500; margin-bottom: 10px; color: #333;">通话记录详情：</div>
                    <div style="color: #666; line-height: 1.8;">
                        <div><strong>联系人：</strong>${record.chatName}</div>
                        <div><strong>通话时间：</strong>${record.callDate} ${record.callTime}</div>
                        <div><strong>通话时长：</strong>${record.duration}</div>
                        <div style="margin-top: 10px;"><strong>通话总结：</strong></div>
                        <div style="margin-top: 5px; word-break: break-word;">${record.summary}</div>
                    </div>
                    <button id="closeSharePopup" style="
                        margin-top: 15px;
                        padding: 8px 20px;
                        background-color: #007AFF;
                        color: white;
                        border: none;
                        border-radius: 6px;
                        cursor: pointer;
                        font-size: 14px;
                    ">关闭</button>
                `;
                
                document.body.appendChild(contentPopup);
                
                // 关闭按钮事件
                document.getElementById('closeSharePopup').addEventListener('click', function() {
                    contentPopup.remove();
                });
                
                // 点击背景关闭
                contentPopup.addEventListener('click', function(e) {
                    if (e.target === contentPopup) {
                        contentPopup.remove();
                    }
                });
            });
            
            shareContainer.appendChild(shareBox);
            chatContent.appendChild(shareContainer);
            
            // 滚动到底部
            chatContent.scrollTop = chatContent.scrollHeight;
            
            // 保存到聊天记录
            relationshipData.chatMessages.push({
                sender: 'user',
                content: `我已将${record.callDate} ${record.callTime}的通话记录分享给AI ${record.chatName}`,
                timestamp: Date.now(),
                chatId: currentChatId,
                shareRecord: {
                    recordId: record.id,
                    chatName: record.chatName,
                    callDate: record.callDate,
                    callTime: record.callTime,
                    duration: record.duration,
                    summary: record.summary
                }
            });
            
            saveData();
        }

